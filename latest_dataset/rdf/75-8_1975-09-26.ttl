    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "عقد التسيير هو العقد الذي يلتزم بموجبه متعامل يتمتع بشهرة معترف بها، يسمى مسيرا، إزاء مؤسسة عمومية اقتصادية أو شركة مختلطة الاقتصاد، بتسيير كل أملاكها أو بعضها باسمها ولحسابها مقابل أجر فيضفي عليها علامته حسب مقایسه ومعاييره، ويجعلها تستفيد من شبكاته الخاصة بالترويج والبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى> ;
    dzdoc:position 0 ;
    dzdoc:text "عقد التسيير هو العقد الذي يلتزم بموجبه متعامل يتمتع بشهرة معترف بها، يسمى مسيرا، إزاء مؤسسة عمومية اقتصادية أو شركة مختلطة الاقتصاد، بتسيير كل أملاكها أو بعضها باسمها ولحسابها مقابل أجر فيضفي عليها علامته حسب مقایسه ومعاييره، ويجعلها تستفيد من شبكاته الخاصة بالترويج والبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6_obligation_0_9e5e3ba3> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6_obligation_0_9e5e3ba3_role_617929542a> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6_obligation_0_9e5e3ba3_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "تسري القوانين المتعلقة بالأهلية على جميع الأشخاص الذين تتوفر فيهم الشروط المنصوص عليها"@ar ;
    dznorm:sourceArticle "book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6" .

<https://legal.dz/resource/order/1975-09-26/75-58#preamble_segment_0> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#preamble> ;
    dzdoc:position 0 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "بناء على تقرير وزير العدل، حامل الأختام،"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#preamble_segment_1> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#preamble> ;
    dzdoc:position 1 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبعد استطلاع رأي مجلس الوزراء،"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1000_19750926_OpEnact_b8bef587e6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1000> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_1000> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_1000> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "المبالغ المستحقة للمقاولين والمهندسين المعماريين الذين عهد إليهم بتشييد أبنية أو منشآت أخرى في إعادة تشييدها أو في ترميمها أو في صيانتها، يكون لها امتياز على هذه المنشآت، ولكن بقدر ما يكون زائدا بسبب هذه الأعمال في قيمة العقار وقت بيعه. ويجب أن يقيد الامتياز ، وتكون مرتبته من وقت القيد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1001_19750926_OpEnact_755ded89ed> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1001> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_1001> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_1001> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "أن للشركاء الذين اقتسموا عقارا، حق امتياز عليه تأمينا لما تخوله القسمة من حق في رجوع كل منهم على الآخرين ، بما في ذلك حق المطالبة بمعدل القسمة، و يجب أن يقيد هذا الامتياز وتكون مرتبته مماثلة لشروط امتياز البائع المشار إليه في المادة 999 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1002_19750926_OpEnact_14fa8f077b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1002> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_1002> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_1002> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تطبق مدة التقادم المحددة في هذا القانون إلا على الوقائع التي ترد بعد نشر هذا الأمر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1003_19750926_OpEnact_19a3c8e65a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1003> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_1003> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_1003> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري مفعول هذا الأمر ابتداء من تاريخ 25 جمادى الثانية عام 1395 الموافق 5 يوليو 1975 وينشر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. وحرر بالجزائر في 20 رمضان عام 1395 الموافق 26 سبتمبر سنة 1975. هواري بومدين"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_100_19750926_OpEnact_85a17340f9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_100> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_100> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_100> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يزول حق إبطال العقد بالاجازة الصريحة أو الضمنية وتستند الاجازة إلى التاريخ الذي تم فيه العقد، دون إخلال بحقوق الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_101_19750926_OpEnact_6337935ea1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_101> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_101> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_101> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسقط الحق في إبطال العقد إذا لم يتمسك به صاحبه خلال خمس (5) سنوات . ويبدأ سريان هذه المدة، في حالة نقص الأهلية من اليوم الذي يزول فيه هذا السبب، وفي حالة الغلط أو التدليس من اليوم الذي يكشف فيه، وفي حالة الإكراه من يوم انقطاعه، غير أنه لا يجوز التمسك بحق الإبطال لغلط أو تدليس أو إكراه إذا انقضت عشرة (10) سنوات من وقت تمام العقد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_102_19750926_OpEnact_ba6c06cedb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_102> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_102> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_102> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان العقد باطلا بطلانا مطلقا جاز لكل ذي مصلحة أن يتمسك بهذا البطلان، وللمحكمة أن تقضي به من تلقاء نفسها ولا يزول البطلان بالاجازة. وتسقط دعوى البطلان بمضي خمسة عشرة سنة من وقت إبرام العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_103_19750926_OpEnact_22206f3f97> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_103> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعاد المتعاقدان إلى الحالة التي كانا عليها قبل العقد في حالة بطلان العقد أو إبطاله، فإن كان هذا مستحيلا جاز الحكم بتعويض معادل. غير أنه لا يلزم ناقص الأهلية، إذا أبطل العقد لنقص أهليته، إلا برد ما عاد عليه من منفعة بسبب تنفيذ العقد . يحرم من الاسترداد في حالة بطلان العقد من تسبب في عدم مشروعيته أو كان عالما به."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_104_19750926_OpEnact_1b8e15635f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_104> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_104> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_104> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان العقد في شق منه باطلا أو قابلا للابطال ، فهذا الشق وحده هو الذي يبطل، الا إذا تبين أن العقد ما كان ليتم بغير الشق الذي وقع باطلا، أو قابلا للابطال فيبطل العقد كله."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_105_19750926_OpEnact_f2fe7a2a4f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_105> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_105> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_105> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان العقد باطلا أو قابلا للابطال وتوفرت فيه أركان عقد آخر فإن العقد يكون صحيحا باعتباره العقد الذي توفرت أركانه، إذا تبين أن نية المتعاقدين كانت تنصرف إلى إبرام هذا العقد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_106_19750926_OpEnact_049253c5cd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_106> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_106> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_106> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "العقد شريعة المتعاقدين، فلا يجوز نقضه ولا تعديله الا باتفاق الطرفين، أو للاسباب التي يقررها القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_107_19750926_OpEnact_62687f4b74> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_107> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_107> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_107> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب تنفيذ العقد طبقا لما اشتمل عليه وبحسن نية . ولا يقتصر العقد على الزام المتعاقد بما ورد فيه فحسب، بل يتناول أيضا ما هو من مستلزماته وفقا للقانون، والعرف، والعدالة، بحسب طبيعة الالتزام. غير أنه إذا طرأت حوادث استثنائية عامة لم يكن في الوسع توقعها وترتب على حدوثها أن تنفيذ الالتزام التعاقدي، وإن لم يصبح مستحيلا، صار مرهقا للمدين بحيث يهدده بخسارة فادحة جاز للقاضي تبعا للظروف وبعد مراعاة لمصلحة الطرفين أن يرد الالتزام المرهق إلى الحد المعقول ، ويقع باطلا كل اتفاق على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_108_19750926_OpEnact_a172869897> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_108> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_108> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_108> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينصرف العقد إلى المتعاقدين والخلف العام، ما لم يتبين من طبيعة التعامل، أو من نص القانون، أن هذا الأثر لا ينصرف إلى الخلف العام كل ذلك مع مراعاة القواعد المتعلقة بالميراث."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_109_19750926_OpEnact_2aef1cf8b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_109> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_109> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_109> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أنشأ العقد التزامات، وحقوقا، شخصية تتصل بشيء انتقل بعد ذلك إلى خلف خاص ، فإن هذه الالتزامات والحقوق تنتقل إلى هذا الخلف في الوقت الذي ينتقل فيه الشيء، إذا كانت من مستلزماته وكان الخلف الخاص يعلم بها وقت انتقال الشيء إليه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_10_19750926_OpEnact_f432c86489> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_10> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_10> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_10> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يمكن أحد الطرفين أن يفسخ العقد في أي وقت شريطة أن يعوض المتعامل معه الضرر الناجم عن هذا الفسخ ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_110_19750926_OpEnact_2e64817b30> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_110> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_110> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_110> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تم العقد بطريقة الاذعان ، وكان قد تضمن شروطا تعسفية ، جاز للقاضي أن يعدل هذه الشروط أو أن يعفي الطرف المذعن منها ، وذلك وفقا لما تقضي به العدالة ويقع باطلا كل اتفاق على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_111_19750926_OpEnact_ad1eaed392> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_111> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_111> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_111> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت عبارة العقد واضحة فلا يجوز الانحراف عنها من طريق تأويلها للتعرف على إرادة المتعاقدين. أما إذا كان هناك محل لتأويل العقد ، فيجب البحث عن النية المشتركة للمتعاقدين دون الوقوف عند المعنى الحرفي للالفاظ ، مع الاستهداء في ذلك بطبيعة التعامل، وبما ينبغي أن يتوافر من أمانة وثقة بين المتعاقدين، وفقا للعرف الجاري في المعاملات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_112_19750926_OpEnact_e531b5f165> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_112> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_112> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_112> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يؤول الشك في مصلحة المدين. غير أنه لا يجوز أن يكون تأويل العبارات الغامضة في عقود الاذعان ضارا بمصلحة الطرف المذعن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_113_19750926_OpEnact_3f095855ba> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_113> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_113> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_113> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يرتب العقد التزاما في ذمة الغير، و لكن يجوز أن يكسبه حقا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_114_19750926_OpEnact_5b3209907f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_114> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_114> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_114> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعهد شخص عن الغير فلا يتقيد الغير بتعهده، فإن رفض الغير أن يلتزم ، وجب على المتعهد أن يعوض من تعاقد معه و يجوز له مع ذلك أن يتخلص من التعويض بأن يقوم هو نفسه بتنفيذ ما التزم به . أما إذا قبل الغير هذا التعهد ، فإن قبوله لا ينتج أثرا إلا من وقت صدوره، ما لم يتبين أنه قصد صراحة أو ضمنا أن يستند أثر هذا القبول إلى الوقت الذي صدر فيه التعهد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_115_19750926_OpEnact_04236a4399> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_115> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_115> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_115> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_116_19750926_OpEnact_314e5906d7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_116> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_116> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_116> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للشخص أن يتعاقد باسمه على التزامات يشترطها لمصلحة الغير إذا كان له في تنفيذ هذه الالتزامات مصلحة شخصية مادية كانت أو أدبية . ويترتب على هذا الاشتراط أن يكسب الغير حقا مباشرا قبل المتعهد بتنفيذ الاشتراط يستطيع أن يطالبه بوفائه ، ما لم يتفق على خلاف ذلك ، ويكون لهذا المدين أن يحتج ضد المنتفع بما يعارض مضمون العقد. ويجوز كذلك للمشترط أن يطالب بتنفيذ ما اشترط لمصلحة المنتفع ، الا إذا تبين من العقد أن المنتفع وحده هو الذي يجوز له ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_117_19750926_OpEnact_6cc8d0d252> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_117> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_117> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_117> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمشترط دون دائنيه أو وارثيه أن ينقص المشارطة قبل أن يعلن المنتفع إلى المتعهد أو إلى المشترط رغبته في الاستفادة منها ، ما لم يكن ذلك مخالفا لما يقتضيه العقد . ولا يترتب على نقض المشارطة أن تبرأ ذمة المتعهد قبل المشترط إلا إذا اتفق صراحة أو ضمنا على خلاف ذلك ، وللمشترط، إحلال منتفع آخر محل المنتفع الأول، كما له أن يستأثر لنفسه بالانتفاع من عملية الاشتراط."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_118_19750926_OpEnact_97884d9656> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_118> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_118> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_118> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز في الاشتراط لمصلحة الغير أن يكون المنتفع شخصا مستقبلا أو هيئة مستقبلة كما يجوز أن يكون شخصا أو هيئة لم يعينا وقت العقد متى كان تعيينهما مستطاعا في الوقت الذي يجب أن ينتج العقد فيه أثره طبقا للمشارطة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_119_19750926_OpEnact_d14087e7ae> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_119> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_119> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_119> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في العقود الملزمة للجانبين ، إذا لم يوف أحد المتعاقدين بالتزامه جاز للمتعاقد الآخر بعد اعذاره المدين أن يطالب بتنفيذ العقد أو فسخه، مع التعويض في الحالتين إذا اقتضى الحال ذلك . ويجوز للقاضي أن يمنح المدين أجلا حسب الظروف، كما يجوز له أن يرفض الفسخ إذا كان ما لم يوف به المدين قليل الأهمية بالنسبة إلى كامل الالتزامات ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_11_19750926_OpEnact_43a692cccc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_11> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_11> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_11> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على الشروط الموضوعية الخاصة بصحة الزواج القانون الوطني لكل من الزوجين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_120_19750926_OpEnact_32d8ce2da8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_120> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_120> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_120> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز الاتفاق على أن يعتبر العقد مفسوخا بحكم القانون عند عدم الوفاء بالالتزامات الناشئة عنه بمجرد تحقيق الشروط المتفق عليها وبدون حاجة إلى حكم قضائي . وهذا الشرط لا يعفي من الاعذار ، الذي يحدد حسب العرف عند عدم تحديده من طرف المتعاقدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_121_19750926_OpEnact_c14342d6ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_121> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_121> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_121> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في العقود الملزمة للجانبين إذا انقضى التزام بسبب استحالة تنفيذه انقضت معه الالتزامات المقابلة له وينفسخ العقد بحكم القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_122_19750926_OpEnact_96a568c5e8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_122> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_122> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_122> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا فسخ العقد أعيد المتعاقدان إلى الحالة التي كانا عليها قبل العقد، فإذا استحال ذلك جاز للمحكمة أن تحكم بالتعويض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_19750926_OpEnact_667a266bf8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_123> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_123> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في العقود الملزمة للجانبين إذا كانت الالتزامات المتقابلة مستحقة الوفاء جاز لكل من المتعاقدين أن يمتنع عن تنفيذ التزامه إذا لم يقم المتعاقد الآخر بتنفيذ ما التزم به ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_19750926_OpEnact_d388708a57> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "( جديدة) يجوز أن يتم التصرف بالإرادة المنفردة للمتصرف ما لم يلزم الغير. ويسري على التصرف بالإرادة المنفردة ما يسري على العقد من الأحكام باستثناء أحكام القبول."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_1_19750926_OpEnact_2478d2837f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "( جديدة) من وعد الجمهور بجائزة يعطيها عن عمل معين يلزم بإعطائها لمن قام بالعمل ، ولو قام به دون نظر إلى الوعد بالجائزة أو دون علم بها. وإذا لم يعين الواعد أجلا لإنجاز العمل جاز له الرجوع في وعده بإعلان الجمهور، على ألا يؤثر ذلك في حق من أتم العمل قبل الرجوع في الوعد . يمارس حق المطالبة بالجائزة تحت طائلة السقوط في أجل ستة (6) أشهر من تاريخ إعلان العدول للجمهور ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_124_19750926_OpEnact_7f8b6e2097> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_124> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_124> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_124> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل فعل أيا كان يرتكبه الشخص بخطئه، ويسبب ضررا للغير يلزم من كان سببا في حدوثه بالتعويض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_124_bis_19750926_OpEnact_9af3a2d784> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_124_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يشكل الاستعمال التعسفي للحق خطأ لاسيما في الحالات الآتية : إذا وقع بقصد الاضرار بالغير ، إذا كان يرمي للحصول على فائدة قليلة بالنسبة إلى الضرر الناشئ للغير ، إذا كان الغرض منه الحصول على فائدة غير مشروعة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_125_19750926_OpEnact_ae292247c2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_125> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_125> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_125> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يسأل المتسبب في الضرر الذي يحدثه بفعله أو امتناعه أو بإهمال منه أو عدم حيطته إلا إذا كان مميزا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_126_19750926_OpEnact_48e7249dbc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_126> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_126> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_126> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعدد المسؤولون عن فعل ضار كانوا متضامنين في التزامهم بتعويض الضرر ، وتكون المسؤولية فيما بينهم بالتساوي إلا إذا عين القاضي نصيب كل منهم في الالتزام بالتعويض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_127_19750926_OpEnact_c0852e901b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_127> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_127> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_127> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أثبت الشخص أن الضرر قد نشأ عن سبب لا يد له فيه كحادث مفاجئ، أو قوة قاهرة، أو خطأ صدر من المضرور أو خطأ من الغير كان غير ملزم بتعويض هذا الضرر، ما لم يوجد نص قانوني أو اتفاق يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_128_19750926_OpEnact_9f078f53c6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_128> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_128> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_128> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من أحدث ضررا وهو في حالة دفاع شرعي عن نفسه، أو عن ماله، أو عن نفس الغير، أو عن ماله ، كان غير مسؤول، على أن لا يجاوز في دفاعه القدر الضروري، وعند الاقتضاء يلزم بتعويض يحدده القاضي ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_129_19750926_OpEnact_0d322d4e09> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_129> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_129> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_129> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يكون الموظفون والأعوان العموميون مسؤولين شخصيا عن أفعالهم التي أضرت بالغير إذا قاموا بها تنفيذا لأوامر صدرت إليهم من رئيس متى كانت إطاعة هذه الأوامر واجبة عليهم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_12_19750926_OpEnact_15b67c7372> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_12> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري قانون الدولة التي ينتمي إليها الزوج وقت انعقاد الزواج على الآثار الشخصية والمالية التي يرتبها عقد الزواج. ويسري على انحلال الزواج والانفصال الجسماني القانون الوطني الذي ينتمي إليه الزوج وقت رفع الدعوى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_130_19750926_OpEnact_e222cf20c7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_130> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_130> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_130> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من سبب ضررا للغير ليتفادى ضررا أكبر ، محدقا به أو بغيره، لا يكون ملزما إلا بالتعويض الذي يراه القاضي مناسبا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_131_19750926_OpEnact_4a7b24fa3e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_131> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_131> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_131> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يقدر القاضي مدى التعويض عن الضرر الذي لحق المصاب طبقا لأحكام المادتين 182 و 182 مكرر مع مراعاة الظروف الملابسة، فإن لم يتيسر له وقت الحكم أن يقدر مدى التعويض بصفة نهائية، فله أن يحتفظ للمضرور بـ الحق في أن يطالب خلال مدة معينة بالنظر من جديد في التقدير ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_132_19750926_OpEnact_85faddd370> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_132> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_132> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_132> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعين القاضي طريقة التعويض تبعا للظروف، ويصح أن يكون التعويض مقسطا، كما يصح أن يكون إيرادا مرتبا، ويجوز في هاتين الحالتين إلزام المدين بأن يقدر تأمينا. ويقدر التعويض بالنقد، على أنه يجوز للقاضي ، تبعا للظروف وبناء على طلب المضرور، أن يأمر بإعادة الحالة إلى ما كانت عليه، أو أن يحكم وذلك على سبيل التعويض، بأداء بعض الإعانات تتصل بالفعل غير المشروع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_133_19750926_OpEnact_80781998b6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_133> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_133> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_133> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسقط دعوى التعويض بانقضاء خمس عشرة (15) سنة من يوم وقوع الفعل الضار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_134_19750926_OpEnact_bf5c50a398> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_134> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_134> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_134> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل من يجب عليه قانونا أو اتفاقا رقابة شخص في حاجة إلى الرقابة بسبب قصره أو بسبب حالته العقلية أو الجسمية، يكون ملزما بتعويض الضرر الذي يحدثه ذلك الشخص للغير بفعله الضار . ويستطيع المكلف بالرقابة أن يتخلص من المسؤولية إذا أثبت أنه قام بواجب الرقابة أو أثبت أن الضرر كان لابد من حدوثه ولو قام بهذا الواجب بما ينبغي من العناية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_135_19750926_OpEnact_2b190920ea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_135> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_135> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_135> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_136_19750926_OpEnact_1ad169f33b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_136> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_136> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_136> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون المتبوع مسؤولا عن الضرر الذي يحدثه تابعه بفعله الضار متى كان واقعا منه في حالة تأدية وظيفته أو بسببها أو بمناسبتها . وتتحقق علاقة التبعية ولو لم يكن المتبوع حرا في اختيار تابعه متى كان هذا الأخير يعمل لحساب المتبوع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_137_19750926_OpEnact_10e32fe8b1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_137> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_137> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_137> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للمتبوع حق الرجوع على تابعه في حالة ارتكابه خطأ جسيما ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_138_19750926_OpEnact_c70ec20960> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_138> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_138> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_138> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل من تولى حراسة شيء وكانت له قدرة الاستعمال والتسيير، والرقابة ، يعتبر مسؤولا عن الضرر الذي يحدثه ذلك الشيء . ويعفي من هذه المسؤولية الحارس للشيء إذا أثبت أن ذلك الضرر حدث بسبب لم يكن يتوقعه مثل عمل الضحية، أو عمل الغير ، أو الحالة الطارئة، أو القوة القاهرة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_139_19750926_OpEnact_435a26a436> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_139> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_139> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_139> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "حارس الحيوان ، ولو لم يكن مالكا له، مسؤول عما يحدثه الحيوان من ضرر . ولو ضل الحيوان أو تسرب، ما لم يثبت الحارس أن وقوع الحادث كان بسبب لا ينسب إليه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_19750926_OpEnact_4ddf7f2a01> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_13> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_13> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري القانون الجزائري وحده في الأحوال المنصوص عليها في المادتين 11 و 12 إذا كان أحد الزوجين جزائريا وقت انعقاد الزواج ، إلا فيما يخص أهلية الزواج."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis_19750926_OpEnact_7df791fb19> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على النسب والإعتراف به وإنكاره قانون جنسية الأب وقت ميلاد الطفل. وفي حالة وفاة الأب قبل ميلاد الطفل يطبق قانون جنسية الأب وقت الوفاة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis_1_19750926_OpEnact_d9cdbf0aee> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على صحة الكفالة قانون جنسية كل من الكفيل والمكفول وقت إجرائها، ويسري على آثارها قانون جنسية الكفيل. وتطبق نفس الأحكام على التبني."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_19750926_OpEnact_8b0fbf862a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_140> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_140> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_140> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من كان حائزا بأي وجه كان لعقار أو جزء منه، أو منقولات، حدث فيها حريق لا يكون مسؤولا نحو الغير عن الاضرار التي سببها هذا الحريق إلا إذا ثبت أن الحريق ينسب إلى خطئه أو خطأ من هو مسؤول عنهم . مالك البناء مسؤول عما يحدثه انهدام البناء من ضرر ولو كان انهداما جزئيا ، ما لم يثبت أن الحادث لا يرجع سببه إلى إهمال في الصيانة، أو قدم في البناء، أو عيب فيه . ويجوز لمن كان مهددا بضرر يصيبه من البناء أن يطالب المالك باتخاذ ما يلزم من التدابير الضرورية للوقاية من الخطر فإن لم يقم المالك بذلك ، جاز الحصول على إذن من المحكمة في اتخاذ هذه التدابير على حسابه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis_19750926_OpEnact_104c48b337> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون المنتج مسؤول عن الضرر الناتج عن عيب في منتوجه حتى ولو لم تربطه بالمتضرر علاقة تعاقدية. يعتبر منتوجا كل مال منقول ولو كان متصلا بعقار ، لاسيما المنتوج الزراعي والمنتوج الصناعي وتربية الحيوانات والصناعة الغذائية والصيد البري والبحري والطاقة الكهربائية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis_1_19750926_OpEnact_863804cc63> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا انعدم المسؤول عن الضرر الجسماني ولم تكن للمتضرر يد فيه ، تتكفل الدولة بالتعويض عن هذا الضرر ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_141_19750926_OpEnact_fd2413b192> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_141> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_141> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_141> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل من نال عن حسن نية من عمل الغير أو من شيء له منفعة ليس لها ما يبررها يلزم بتعويض من وقع الاثراء على حسابه بقدر ما استفاد من العمل أو الشيء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_142_19750926_OpEnact_78de6815b2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_142> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_142> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_142> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسقط دعوى التعويض عن الاثراء بلا سبب بانقضاء عشر (10) سنوات من اليوم الذي يعلم فيه من لحقته الخسارة بحقه في التعويض ، وتسقط الدعوى في جميع الأحوال بانقضاء خمسة عشرة سنة من اليوم الذي ينشأ فيه هذا الحق ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_143_19750926_OpEnact_354ddc4408> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_143> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_143> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_143> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل من تسلم على سبيل الوفاء ما ليس مستحقا له وجب عليه رده . غير أنه لا محل للرد إذا كان من قام بالوفاء يعلم أنه غير ملزم بما دفعه ، الا أن يكون ناقص الأهلية ، أو يكون قد أكره على هذا الوفاء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_144_19750926_OpEnact_3093340a47> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_144> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_144> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_144> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يصح استرداد غير المستحق إذا كان الوفاء قد تم تنفيذا لالتزام لم يتحقق سببه أو لالتزام زال سببه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_145_19750926_OpEnact_5b6aa50710> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_145> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_145> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_145> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يمكن لـ الدائن أن يطالب بحق مؤجل قبل حلول أجله أما إذا تم الوفاء معجلا فلا يجوز استرداد ما دفع حتى ولو كان المدين يجهل الأجل. وفي هذه الحالة يجوز للمدين أن يطالب في حدود الضرر اللاحق به برد مبلغ الاثراء الذي حصل عليه الدائن بسبب هذا الوفاء المعجل ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_146_19750926_OpEnact_75f1e76aa6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_146> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_146> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_146> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا محل لاسترداد غير المستحق إذا حصل الوفاء من غير المدين وترتب عليه أن الدائن، وهو حسن النية، قد تجرد من سند الدين أو مما حصل عليه من التأمينات أو ترك دعواه تسقط بالتقادم قبل المدين الحقيقي و يلتزم المدين الحقيقي في هذه الحالة بتعويض الغير الذي قام بالوفاء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_147_19750926_OpEnact_632c41a67d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_147> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_147> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_147> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان من تسلم غير مستحق حسن النية فلا يلزم أن يرد إلا ما تسلم . أما إذا كان سيئ النية فإنه يلزم أيضا برد الأرباح التي جناها، أو التي قصر في جنيها من الشيء الذي تسلمه بغير حق ، وذلك من يوم الوفاء، أو من اليوم الذي أصبح فيه سيئ النية. وعلى أي حال يلزم من تسلم غير المستحق برد الثمرات من يوم رفع الدعوى ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_148_19750926_OpEnact_0eb923f1df> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_148> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_148> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_148> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم تتوافر أهلية التعاقد فيمن تسلم غير المستحق فلا يكون ملزما إلا بالقدر الذي أثرى به."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_149_19750926_OpEnact_47c522d1a1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_149> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_149> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_149> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسقط دعوى استرداد ما دفع بغير حق بانقضاء عشر (10) سنوات من اليوم الذي يعلم فيه من دفع غير المستحق بحقه في الاسترداد وتسقط الدعوى في جميع الأحوال بانقضاء خمسة عشرة (15) سنة من اليوم الذي ينشأ فيه هذا الحق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_14_19750926_OpEnact_55df36e0a9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_14> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_14> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_14> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يطبق القانون الوطني على الالتزام بالنفقة بين الأقارب للمدين بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_150_19750926_OpEnact_e7d02364ea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_150> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_150> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_150> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الفضالة هي أن يتولى شخص عن قصد القيام بالشأن لحساب شخص آخر، دون أن يكون ملزما بذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_151_19750926_OpEnact_22596c6fca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_151> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_151> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_151> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتحقق الفضالة ولو كان الفضولي ، أثناء توليه شأنا لنفسه، قد تولى شأن غيره لما بين الأمرين من ارتباط لا يمكن معه القيام بأحدهما منفصلا عن الآخر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_152_19750926_OpEnact_027b90c16f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_152> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_152> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_152> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري قواعد الوكالة إذا أجاز رب العمل ما قام به الفضولي ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_153_19750926_OpEnact_222cd12b2b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_153> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_153> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_153> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على الفضولي أن يمضي في العمل الذي بدأه إلى أن يتمكن رب العمل من مباشرته بنفسه كما يجب عليه أن يخطر بتدخله رب العمل متى استطاع ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_154_19750926_OpEnact_03f5e8911a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_154> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_154> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_154> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على الفضولي أن يبذل في القيام بالعمل عناية الشخص العادي ، ويكون مسؤولا عن خطئه. ومع ذلك فللقاضي أن ينقص مبلغ التعويض المترتب على هذا الخطأ، إذا كانت الظروف تبرر ذلك . وإذا عهد الفضولي إلى غيره، بكل العمل الذي تكلف به أو ببعضه كان مسؤولا عن تصرفات نائبه، دون إخلال بما لرب العمل من الرجوع مباشرة على هذا النائب . وإذا تعدد الفضوليون في القيام بعمل واحد كانوا متضامنين في المسؤولية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_155_19750926_OpEnact_146d3836ee> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_155> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_155> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_155> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يلزم الفضولي بما يلزم به الوكيل من رد ما تسلمه بسبب الفضالة ، وتقديم حساب ما قام به ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_156_19750926_OpEnact_730306a1b0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_156> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_156> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_156> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا مات الفضولي التزم ورثته بما يلزم به ورثة الوكيل طبقا لاحكام المادة 589 فقرة 2 . وإذا مات رب العمل بقي الفضولي ملتزما نحو الورثة بما كان ملزما به نحو مورثهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_157_19750926_OpEnact_213191a1e5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_157> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_157> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_157> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر الفضولي نائبا عن رب العمل، متى كان قد بذل في إدارته عناية الشخص العادي، ولو لم تتحقق النتيجة المقصودة وفي هذه الحالة يكون رب العمل ملزما بتنفيذ التعهدات التي عقدها الفضولي لحسابه، وبتعويضه عن التعهدات التي التزم بها، وبرد النفقات الضرورية أو النافعة التي سوغتها الظروف، وبتعويضه عن الضرر الذي لحقه بسبب قيامه بالعمل ، ولا يستحق الفضولي أجرا على عمله إلا إذا كان هذا العمل من أعمال مهنته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_158_19750926_OpEnact_e0473755c1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_158> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_158> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_158> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم تتوافر في الفضولي أهلية التعاقد فلا يكون مسؤولا عن ادارته الا بالقدر الذي أثرى به، ما لم تكن مسئوليته ناشئة عن عمل غير مشروع. أما رب العمل فتبقى مسئوليته كاملة، ولو لم تتوافر فيه أهلية التعاقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_159_19750926_OpEnact_eddf2a29e9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_159> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_159> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_159> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسقط الدعوى الناشئة عن الفضالة بانقضاء عشر (10) سنوات من اليوم الذي يعلم فيه كل طرف بحقه، وتسقط في جميع الأحوال بانقضاء خمسة عشرة (15) سنة من اليوم الذي ينشأ فيه هذا الحق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_15_19750926_OpEnact_b0d51ab310> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_15> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_15> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_15> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على الشروط الموضوعية الخاصة بالولاية والوصاية والقوامة وغيرها من النظم المقررة لحماية القصر وعديمي الأهلية والغائبين قانون الشخص الذي تجب حمايته. غير أنه يطبق القانون الجزائري بالنسبة للتدابير المستعجلة إذا كان القصر وعديمو الأهلية والغائبون موجودين في الجزائر وقت اتخاذ هذه التدابير ، أو تعلقت بأموالهم الموجودة في الجزائر ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_160_19750926_OpEnact_733cc0551e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_160> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_160> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_160> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "المدين ملزم بتنفيذ ما تعهد به . غير أنه لا يجبر على التنفيذ إذا كان الالتزام طبيعيا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_161_19750926_OpEnact_871da7a97e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_161> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_161> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_161> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يقدر القاضي، عند عدم النص ما إذا كان هناك التزام طبيعي وعلى أي حال فإنه لا يجوز أن يخالف الالتزام الطبيعي النظام العام ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_162_19750926_OpEnact_123a578ce6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_162> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_162> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_162> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يسترد المدين ما أداه باختياره، بقصد تنفيذ التزام طبيعي ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_163_19750926_OpEnact_d6277ad046> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_163> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_163> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_163> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يمكن أن يكون الالتزام الطبيعي سببا لالتزام مدني."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_164_19750926_OpEnact_6986df8f91> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_164> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_164> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_164> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجبر المدين بعد اعذاره طبقا للمادتين 180 و 181 على تنفيذ التزامه تنفيذا عينيا، متى كان ذلك ممكنا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_165_19750926_OpEnact_4347a8a7b4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_165> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_165> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_165> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الالتزام بنقل الملكية، أو أي حق عيني آخر من شأنه أن ينقل بحكم القانون الملكية أو الحق العيني، إذا كان محل الالتزام شيئا معينا بالذات يملكه الملتزم ، وذلك مع مراعاة الأحكام المتعلقة بالاشهار العقاري ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_166_19750926_OpEnact_73c338f4ae> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_166> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_166> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_166> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ورد الالتزام بنقل حق عيني على شيء لم يعين إلا بنوعه فلا ينتقل الحق إلا بإفراز هذا الشيء. فإذا لم يقم المدين بتنفيذ التزامه ، جاز للدائن أن يحصل على شيء من النوع ذاته على نفقة المدين بعد استئذان القاضي كما يجوز له أن يطالب بقيمة الشيء من غير إخلال بحقه في التعويض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_167_19750926_OpEnact_8965687a7f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_167> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_167> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_167> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الالتزام بنقل حق عيني يتضمن الالتزام بتسليم الشيء والمحافظة عليه حتى التسليم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_168_19750926_OpEnact_d0dc29ff3b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_168> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_168> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_168> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان المدين الملزم بالقيام بعمل يقتضي تسليم شيء ولم يسلمه بعد الاعذار فإن الاخطار تكون على حسابه ولو كانت قبل الاعذار على حساب الدائن. غير أن هذه الاخطار لا تتعدى إلى المدين رغم الاعذار إذا أثبت المدين أن الشيء قد يضيع عند الدائن لو سلم له، ما لم يكن المدين قد قبل أن يتحمل تبعية الحوادث المفاجئة . على أن الشيء المسروق إذا هلك أو ضاع بأية صورة كانت فإن تبعية الهلاك تقع على السارق ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_169_19750926_OpEnact_a7837fe9e1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_169> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_169> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_169> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في الالتزام بعمل، إذا نص الاتفاق، أو استوجبت طبيعة الدين أن ينفذ المدين الالتزام بنفسه جاز للدائن أن يرفض الوفاء من غير المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_16_19750926_OpEnact_f080af1e73> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_16> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_16> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_16> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على الميراث والوصية وسائر التصرفات التي تنفذ بعد الموت قانون جنسية الهالك أو الموصي أو من صدر منه التصرف وقت موته. ويسري على الهبة والوقف قانون جنسية الواهب أو الواقف وقت إجرائهما."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_170_19750926_OpEnact_0a87b09bfb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_170> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_170> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_170> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في الالتزام بعمل، إذا لم يقم المدين بتنفيذ التزامه جاز للدائن أن يطلب ترخيصا من القاضي في تنفيذ الالتزام على نفقة المدين إذا كان هذا التنفيذ ممكنا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_171_19750926_OpEnact_5de405dfbd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_171> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_171> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_171> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في الالتزام بعمل، قد يكون حكم القاضي بمثابة سند التنفيذ، إذا سمحت بهذا طبيعة الالتزام مع مراعاة المقتضيات القانونية والتنظيمية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_172_19750926_OpEnact_3bfef056b9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_172> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_172> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_172> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في الالتزام بعمل، إذا كان المطلوب من المدين أن يحافظ على الشيء، أو أن يقوم بإدارته أو أن يتوخى الحيطة في تنفيذ التزامه فإن المدين يكون قد وفى بالالتزام إذا بذل في تنفيذه من العناية كل ما يبذله الشخص العادي، ولو لم يتحقق الغرض المقصود . هذا ما لم ينص القانون أو الاتفاق على خلاف ذلك. وعلى كل حال يبقى المدين مسؤولا عن غشه، أو خطئه الجسيم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_173_19750926_OpEnact_42e3d5099e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_173> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_173> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_173> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا التزم المدين بالامتناع عن عمل وأخل بهذا الالتزام جاز للدائن أن يطالب إزالة ما وقع مخالفا للالتزام و يمكنه أن يحصل من القضاء على ترخيص للقيام بهذه الازالة على نفقة المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_174_19750926_OpEnact_c088d1e3aa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_174> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_174> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_174> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان تنفيذ الالتزام عينا غير ممكن أو غير ملائم الا إذا قام به المدين نفسه ، جاز للدائن أن يحصل على حكم بالزام المدين بهذا التنفيذ وبدفع غرامة اجبارية إن امتنع عن ذلك . وإذا رأى القاضي أن مقدار الغرامة ليس كافيا لاكراه المدين الممتنع عن التنفيذ جاز له أن يزيد في الغرامة كلما رأى داعيا للزيادة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_175_19750926_OpEnact_9ec2788a42> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_175> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_175> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_175> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تم التنفيذ العيني، أو أصر المدين على رفض التنفيذ حدد القاضي مقدار التعويض الذي يلزم به المدين مراعيا في ذلك الضرر الذي أصاب الدائن والعنت الذي بدأ من المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_176_19750926_OpEnact_522b15e0db> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_176> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_176> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_176> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا استحال على المدين أن ينفذ الالتزام عينا حكم عليه بتعويض الضرر الناجم عن عدم تنفيذ التزامه، ما لم يثبت أن استحالة التنفيذ نشأت عن سبب لا يد له فيه ، ويكون الحكم كذلك إذا تأخر المدين في تنفيذ التزامه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_177_19750926_OpEnact_f6bb7d149e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_177> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_177> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_177> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للقاضي أن ينقص مقدار التعويض، أو لا يحكم بالتعويض إذا كان الدائن بخطئه قد اشترك في إحداث الضرر أو زاد فيه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_178_19750926_OpEnact_c0917ddc59> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_178> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_178> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_178> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز الاتفاق على أن يتحمل المدين تبعية الحادث المفاجئ أو القوة القاهرة. وكذلك يجوز الاتفاق على إعفاء المدين من أية مسؤولية تترتب على عدم تنفيذ التزامه التعاقدي، إلا ما ينشأ عن غشه، أو عن خطئه الجسيم غير أنه يجوز للمدين أن يشترط إعفاءه من المسؤولية الناجمة عن الغش، أو الخطأ الجسيم الذي يقع من أشخاص يستخدمهم في تنفيذ التزامه. ويبطل كل شرط يقضي بالاعفاء من المسؤولية الناجمة عن العمل الاجرامي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_179_19750926_OpEnact_a05d25392a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_179> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_179> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_179> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يستحق التعويض إلا بعد اعذار المدين ما لم يوجد نص مخالف لذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_17_19750926_OpEnact_14c1ae0df5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_17> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_17> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_17> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يخضع تكييف المال سواء كان عقارا أو منقولا إلى قانون الدولة التي يوجد فيها . يسري على الحيازة والملكية والحقوق العينية الأخرى قانون موقع العقار . ويسري على المنقول المادي قانون الجهة التي يوجد فيها وقت تحقق السبب الذي ترتب عليه كسب الحيازة أو الملكية أو الحقوق العينية الأخرى، أو فقدها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_17_bis_19750926_OpEnact_3186fbd392> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_17_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_17_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_17_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على الأموال المعنوية قانون محل وجودها وقت تحقق السبب الذي ترتب عليه كسب الحيازة أو الملكية أو الحقوق العينية الأخرى أو فقدها . يعد محل وجود الملكية الأدبية والفنية مكان النشر الأول للمصنف أو إنجازه . ويعد محل وجود براءة الاختراع البلد الذي منحها . ويعد محل وجود الرسم والنموذج الصناعيين البلد الذي سجلا أو أودعا فيه . ويعد محل وجود العلامة التجارية منشأة الاستغلال . ويعد محل وجود الاسم التجاري بلد المقر الرئيسي للمحل التجاري ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_180_19750926_OpEnact_42126504b4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_180> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_180> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_180> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون اعذار المدين بانذاره، أو بما يقوم مقام الانذار، ويجوز أن يتم الاعذار عن طريق البريد على الوجه المبين في هذا القانون، كما يجوز أن يكون مترتبا على اتفاق يقضي بأن يكون المدين معذرا بمجرد حلول الأجل دون حاجة إلى أي إجراء آخر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_181_19750926_OpEnact_6a5b0739d7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_181> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_181> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_181> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا ضرورة لاعذار المدين في الحالات الآتية : إذا تعذر تنفيذ الالتزام أو أصبح غير مجد بفعل المدين ، إذا كان محل الالتزام تعويضا ترتب عن عمل مضر، إذا كان محل الالتزام رد شيء يعلم المدين انه مسروق، أو شيء تسلمه دون حق وهو عالم بذلك، إذا صرح المدين كتابة أنه لا ينوي تنفيذ التزامه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_182_19750926_OpEnact_145470e017> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_182> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_182> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_182> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يكن التعويض مقدرا في العقد، أو في القانون فالقاضي هو الذي يقدره، ويشمل التعويض ما لحق الدائن من خسارة وما فاته من كسب، بشرط أن يكون هذا نتيجة طبيعية لعدم الوفاء بالالتزام أو للتأخر في الوفاء به. ويعتبر الضرر نتيجة طبيعية إذا لم يكن في استطاعة الدائن أن يتوقاه ببذل جهد معقول . غير أنه إذا كان الالتزام مصدره العقد ، فلا يلتزم المدين الذي لم يرتكب غشا أو خطأ جسيما إلا بتعويض الضرر الذي كان يمكن توقعه عادة وقت التعاقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_182_bis_19750926_OpEnact_70ea744bec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_182_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_182_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_182_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يشمل التعويض عن الضرر المعنوي كل مساس بالحرية أو الشرف أو السمعة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_183_19750926_OpEnact_5b42bc1ece> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_183> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_183> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_183> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمتعاقدين أن يحددا مقدما قيمة التعويض بالنص عليها في العقد، أو في اتفاق لاحق. وتطبق في هذه الحالة أحكام المواد 176 إلى 181 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_184_19750926_OpEnact_29e0866ed5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_184> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_184> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_184> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يكون التعويض المحدد في الاتفاق مستحقا إذا اثبت المدين أن الدائن لم يلحقه أي ضرر . ويجوز للقاضي أن يخفض مبلغ التعويض إذا اثبت المدين أن التقدير كان مفرطا أو أن الالتزام الأصلي قد نفذ في جزء منه . ويكون باطلا كل اتفاق يخالف أحكام الفقرتين أعلاه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_185_19750926_OpEnact_9ef5b97a4b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_185> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_185> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_185> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا جاوز الضرر قيمة التعويض المحدد في الاتفاق فلا يجوز للدائن أن يطالب بأكثر من هذه القيمة إلا إذا أثبت أن المدين قد ارتكب غشا، أو خطأ جسيما ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_186_19750926_OpEnact_990b8a5195> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_186> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_186> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_186> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان محل الالتزام بين أفراد مبلغا من النقود عين مقداره وقت رفع الدعوى وتأخر المدين في الوفاء به ، فيجب عليه أن يعوض للدائن الضرر اللاحق من هذا التأخير ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_187_19750926_OpEnact_55a91043e3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_187> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_187> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_187> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تسبب الدائن بسوء نيته، وهو يطالب بحقه، في إطالة أمد النزاع فللقاضي أن يخفض مبلغ التعويض المحدد في الاتفاق أو لا يقضي به إطلاقا عن المدة التي طال فيها النزاع بلا مبرر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_188_19750926_OpEnact_1618bfb2a2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_188> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_188> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_188> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "أموال المدين جميعها ضامنة لوفاء ديونه . وفي حالة عدم وجود حق أفضلية مكتسب طبقا للقانون فإن جميع الدائنين متساوون تجاه هذا الضمان ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_189_19750926_OpEnact_e727fd13cd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_189> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_189> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_189> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لكل دائن ولو لم يحل أجل دينه أن يستعمل باسم مدينه جميع حقوق هذا المدين ، إلا ما كان منها خاصا بشخص أو غير قابل للحجز ولا يكون استعمال الدائن لحقوق مدينه مقبولا إلا إذا أثبت أن المدين أمسك عن استعمال هذه الحقوق، وأن هذا الامساك من شأنه أن يسبب عسره، أو أن يزيد فيه . ولا يجب على الدائن أن يكلف مدينه بمطالبة حقه غير أنه لا بد أن يدخله في الخصام."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_18_19750926_OpEnact_740efb6520> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_18> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_18> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_18> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على الالتزامات التعاقدية القانون المختار من المتعاقدين إذا كانت له صلة حقيقية بالمتعاقدين أو بالعقد . وفي حالة عدم إمكان ذلك ، يطبق قانون الموطن المشترك أو الجنسية المشتركة . وفي حالة إمكان ذلك ، يطبق قانون محل إبرام العقد . غير أنه يسري على العقود المتعلقة بالعقار قانون موقعة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_190_19750926_OpEnact_ddd6e358ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_190> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_190> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_190> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر الدائن في استعماله حقوق مدينه نائبا عن هذا المدين، وكل ما ينتج عن استعمال هذه الحقوق يدخل في أموال المدين ويكون ضمانا لجميع دائنيه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_191_19750926_OpEnact_180b77eb8d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_191> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_191> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_191> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لكل دائن حل دينه، وصدر من مدينه تصرف ضار به أن يطلب عدم نفاذ هذا التصرف في حقه ، إذا كان التصرف قد انقص من حقوق المدين أو زاد في التزاماته وترتب عسر المدين أو الزيادة في عسره ، وذلك متى توافر أحد الشروط المنصوص عليها في المادة التالية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_192_19750926_OpEnact_3474a19e15> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_192> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان تصرف المدين بعوض ، فإنه لا يكون حجة على الدائن إذا كان هناك غش صدر من المدين، وإذا كان الطرف الآخر قد علم بذلك الغش يكفي لاعتبار التصرف منطويا على الغش أن يكون قد صدر من المدين وهو عالم بعسره. كما يعتبر من صدر له التصرف عالما بغش المدين إذا كان قد علم أن هذا المدين في حالة عسر . أما إذا كان التصرف الذي قام به المدين تبرعا فإنه لا يحتج به على الدائن ، ولو كان المتبرع له حسن النية. إذا كان المتبرع له حول بعوض المال الذي نقل إليه فليس للدائن أن يتمسك بعدم الاحتجاج عليه بتصرف مدينه إلا إذا كان المحال إليه والمتبرع له قد علما بغش المدين هذا في حالة ما إذا تصرف المدين بعوض وكذلك الحال إذا كان تصرف المدين بدون عوض وعلم المحال إليه بعسر المدين وقت صدور التصرف لصالح المتبرع له ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_193_19750926_OpEnact_b334889b89> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_193> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_193> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_193> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ادعى الدائن عسر المدين فليس عليه إلا أن يثبت مقدار ما في ذمته من ديون. و على المدين نفسه أن يثبت أن له مالا يساوي قيمة الديون أو يزيد عليها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_194_19750926_OpEnact_8df4b0f98a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_194> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_194> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_194> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "متى تقرر عدم معارضة التصرف للدائن استفاد من ذلك جميع الدائنين الذين صدر هذا التصرف إجحافا بحقهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_195_19750926_OpEnact_537cc79855> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_195> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_195> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_195> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان من تلقى حقا من المدين المعسر لم يدفع ثمنه فإنه يتخلص مما ينتج عن دعوى الدائن متى كان هذا الثمن هو ثمن المثل، وقام بإيداعه الخزانة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_196_19750926_OpEnact_c5881548f3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_196> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_196> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_196> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يقصد بالغش إلا تفضيل دائن على آخر دون حق فلا يترتب عليه إلا حرمان الدائن من هذه الميزة. وإذا وفي المدين المعسر أحد دائنيه قبل حلول الأجل المضروب أصلا للوفاء ، فلا يسري هذا الوفاء في حق باقي الدائنين وكذلك لا يسري في حقهم الوفاء ولو حصل بعد حلول هذا الأجل، إذا كان قد تم نتيجة تواطؤ بين المدين والدائن الذي استوفي حقه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_19750926_OpEnact_7ea5fc81df> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_الاولى> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "عقد التسيير هو العقد الذي يلتزم بموجبه متعامل يتمتع بشهرة معترف بها، يسمى مسيرا ، إزاء مؤسسة عمومية اقتصادية أو شركة مختلطة الاقتصاد ، بتسيير كل أملاكها أو بعضها باسمها ولحسابها مقابل أجر فيضفي عليها علامته حسب مقایسه ومعاييره، ويجعلها تستفيد من شبكاته الخاصة بالترويج والبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_197_19750926_OpEnact_22a33797d0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_197> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_197> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_197> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسقط بالتقادم دعوى عدم نفاذ التصرف بانقضاء ثلاث (3) سنوات من اليوم الذي يعلم فيه الدائن بسبب عدم نفاذ التصرف وتسقط في جميع الأحوال بانقضاء خمسة عشرة (15) سنة من الوقت الذي صدر فيه التصرف المطعون فيه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_198_19750926_OpEnact_fd7401bb49> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_198> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_198> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_198> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أبرم عقد صوري فلـ دائني المتعاقدين ولـ لخلف الخاص ، متى كانوا حسنى النية ، أن يتمسكوا بالعقد الصوري ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_199_19750926_OpEnact_832c456bf7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_199> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_199> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_199> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أخفي المتعاقدان عقدا حقيقيا بعقد ظاهر فـ العقد النافذ فيما بين المتعاقدين ، و الخلف العام هو العقد الحقيقي ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_19_19750926_OpEnact_aee9df7bb6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_19> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_19> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_19> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تخضع التصرفات القانونية في جانبها الشكلي لقانون المكان الذي تمت فيه . ويجوز أيضا أن تخضع لقانون الموطن المشترك للمتقاعدين أو لقانونهما الوطني المشترك أو للقانون الذي يسري على أحكامها الموضوعية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1_19750926_OpEnact_162f1e2801> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري القانون على جميع المسائل التي تتناولها نصوصه في لفظها أو في فحواها . وإذا لم يوجد نص تشريعي ، حكم القاضي بمقتضى مبادئ الشريعة الإسلامية ، فإذا لم يوجد فبمقتضى العرف . فإذا لم يوجد فبمقتضى مبادئ القانون الطبيعي وقواعد العدالة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_200_19750926_OpEnact_3a116136b8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_200> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_200> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_200> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لكل من التزم بأداء شيء أن يمتنع عن الوفاء به ما دام الدائن لم يعرض الوفاء بالتزام ترتب عليه وله علاقة سببية وارتباط بالتزام المدين . أو مادام الدائن لم يقم بتقديم تأمين كاف للوفاء بالتزامه هذا . ويكون ذلك بوجه خاص لحائز الشيء أو محرزه ، إذا هو انفق عليه مصروفات ضرورية أو نافعة ، فإن له أن يمتنع عن رد هذا الشيء حتى يستوفي ما هو مستحق له ، الا أن يكون الالتزام بالرد ناشئا عن عمل غير مشروع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_201_19750926_OpEnact_a3bd607294> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_201> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_201> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_201> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "مجرد الحق في حبس الشيء لا يثبت حق امتياز عليه. وعلى الحابس أن يحافظ على الشيء وفقا لأحكام رهن الحيازة ، وعليه أن يقدم حسابا عن غلته . وإذا كان الشيء المحبوس يخشى عليه الهلاك أو التلف ، فللحابس أن يحصل على إذن من القضاء في بيعه وفقا للاحكام المنصوص عليها في المادة 971 ، وينتقل الحق في الحبس من الشيء إلى ثمنه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_202_19750926_OpEnact_a84471a8e3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_202> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_202> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_202> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينقضي الحق في الحبس بخروج الشيء من يد حائزه أو محرزه. غير انه لحابس الشيء إذا خرج من يده بغير علمه أو بالرغم من معارضته أن يطلب استرداده ، إذا هو قام بهذا الطلب خلال ثلاثين يوما من الوقت الذي علم فيه بخروج الشيء من يده ما لم تنقض سنة من وقت خروجه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_203_19750926_OpEnact_03aed9be42> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_203> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_203> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_203> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الالتزام معلقا إذا كان وجوده أو زواله مترتبا على أمر مستقبل وممكن وقوعه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_204_19750926_OpEnact_c23729b8fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_204> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_204> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_204> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يكون الالتزام قائما إذا علق على شرط غير ممكن، أو على شرط مخالف للآداب أو النظام العام ، هذا إذا كان الشرط واقفا اما إذا كان الشرط فاسخا فهو نفسه الذي يعتبر غير قائم. غير أنه لا يقوم الالتزام الذي علق على شرط فاسخ مخالف للآداب أو النظام العام، إذا كان هذا الشرط هو السبب الموجب للالتزام ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_205_19750926_OpEnact_166bc8ce50> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_205> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_205> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_205> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يكون الالتزام قائما إذا علق على شرط واقف يجعل وجود الالتزام متوقفا على محض ارادة الملتزم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_206_19750926_OpEnact_1ea4792386> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_206> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_206> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_206> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الالتزام معلقا على شرط واقف ، فلا يكون نافذا الا إذا تحقق الشرط اما قبل تحقق الشرط، فلا يكون الالتزام قابلا للتنفيذ الجبري، ولا للتنفيذ الاختياري، على انه يجوز للدائن أن يتخذ من الاجراءات ما يحافظ به على حقه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_207_19750926_OpEnact_abf53e6bf9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_207> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_207> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_207> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يزول الالتزام إذا تحقق الشرط الفاسخ ، و يكون الدائن ملزما برد ما أخذه فإذا استحال الرد لسبب هو مسؤول عنه وجب عليه تعويض الضرر . غير أن أعمال الادارة التي تصدر من الدائن تبقى نافذة رغم تحقق الشرط."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_208_19750926_OpEnact_4b00d4d931> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_208> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_208> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_208> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تحقق الشرط يرجع أثره إلى اليوم الذي نشأ فيه الالتزام ، الا إذا تبين من ارادة المتعاقدين أو من طبيعة العقد أن وجود الالتزام، أو زواله، انما يكون في الوقت الذي تحقق فيه الشرط. غير أنه لا يكون للشرط أثر رجعي، إذا أصبح تنفيذ الالتزام قبل تحقق الشرط غير ممكن لسبب لا يد للمدين فيه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_209_19750926_OpEnact_b335f8a2d9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_209> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_209> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_209> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الالتزام لاجل إذا كان نفاذه أو انقضاؤه مترتبا على أمر مستقبل محقق الوقوع. ويعتبر الأمر محقق الوقوع متى كان وقوعه محتما، ولو لم يعرف الوقت الذي يقع فيه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_20_19750926_OpEnact_01e885fb7f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_20> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_20> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_20> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على الالتزامات غير التعاقدية، قانون البلد الذي وقع فيه الفعل المنشئ للالتزام . غير أنه فيما يتعلق بالالتزامات الناشئة عن الفعل الضار ، لا تسري أحكام الفقرة السابقة على الوقائع التي تحدث في الخارج وتكون مشروعة في الجزائر وإن كانت تعد غير مشروعة في البلد الذي وقعت فيه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_210_19750926_OpEnact_b8d0e78872> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_210> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_210> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_210> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تبين من الالتزام أن المدين لا يقوم بوفائه الا عند المقدرة أو الميسرة ، عين القاضي ميعادا مناسبا لحلول الأجل، مراعيا في ذلك موارد المدين الحالية والمستقبلة مع اشتراط عناية الرجل الحريص على الوفاء بالتزامه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_211_19750926_OpEnact_d9d9cb9358> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_211> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_211> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_211> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسقط حق المدين في الأجل : إذا شهر افلاسه وفقا لنصوص القانون ، إذا انقص بفعله إلى حد كبير ما أعطى الدائن من تأمين خاص ، ولو كان هذا التأمين قد أعطي بعقد لاحق أو بمقتضى القانون، هذا ما لم يفضل الدائن أن يطالب بتكملة التأمين، اما إذا كان انقاص التأمين يرجع إلى سبب لا دخل للمدين فيه فإن الأجل يسقط ما لم يقدم المدين للدائن ضمانا كافيا ، إذا لم يقدم للدائن ما وعد في العقد بتقديمه من تأمينات ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_212_19750926_OpEnact_ffa98b0a33> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_212> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_212> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_212> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الالتزام مقترنا بأجل واقف ، فإنه لا يكون نافذا الا في الوقت الذي ينقضي فيه الأجل على انه يجوز للدائن، حتى قبل انقضاء الأجل، أن يتخذ من الاجراءات ما يحافظ به على حقوقه ، وله بوجه خاص أن يطالب بتأمين إذا خشى افلاس المدين، أو عسره واستند في ذلك إلى سبب معقول . ويترتب على انقضاء الأجل الفاسخ زوال الالتزام ، دون أن يكون لهذا الزوال أثر رجعي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_213_19750926_OpEnact_ca01e9223c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_213> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_213> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_213> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الالتزام تخييريا إذا شمل محله أشياء متعددة تبرأ ذمة المدين براءة تامة إذا أدى واحد منها ، ويكون الخيار لـ المدين ما لم ينص القانون أو يتفق المتعاقدان على غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_214_19750926_OpEnact_400f285411> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_214> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_214> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_214> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الخيار للمدين وامتنع عن الاختيار، أو تعدد المدينون ولم يتفقوا فيما بينهم ، جاز للدائن أن يطلب من القاضي تعيين أجل يختار فيه المدين أو يتفق فيه المدينون ، فإذا لم يتم ذلك تولى القاضي بنفسه تعيين محل الالتزام . أما إذا كان الخيار للدائن وامتنع عن الاختيار أو تعدد الدائنون ولم يتفقوا فيما بينهم عين القاضي أجلا إن طلب المدين ذلك، فإذا انقضى الأجل انتقل الخيار إلى المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_215_19750926_OpEnact_f7e687df73> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_215> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_215> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_215> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الخيار للمدين، ثم استحال تنفيذ كل من الأشياء المتعددة التي اشتمل عليها محل الالتزام، وكان المدين مسؤولا عن هذه الاستحالة ولو فيما يتعلق بواحد من هذه الأشياء ، كان ملزما بدفع آخر شيء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_216_19750926_OpEnact_c0d538757a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_216> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_216> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_216> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الالتزام اختياريا إذا لم يشمل محله الا شيئا واحدا ، ولكن تبرأ ذمة المدين إذا أدى بدلا منه شيئا آخر . والشيء الذي يشمله محل الالتزام هو وحده محل الالتزام وهو الذي يعين طبيعته، لا البديل الذي تبرأ ذمة المدين بأدائه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_217_19750926_OpEnact_23f082239b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_217> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_217> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_217> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "التضامن بين الدائنين أو بين المدينين لا يفترض، وانما يكون بناء على اتفاق أو نص في القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_218_19750926_OpEnact_51415c037b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_218> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_218> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_218> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان التضامن بين الدائنين جاز للمدين الوفاء بالدين لأي منهم ما لم يمانع أحدهم في ذلك. غير أن التضامن لا يجوز دون انقسام الدين بين ورثة أحد الدائنين المتضامنين، الا إذا كان الدين غير قابل للانقسام ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_219_19750926_OpEnact_fba46244d4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_219> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_219> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_219> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للدائنين المتضامنين، مجتمعين أو منفردين، مطالبة المدين بالوفاء على أن يراعى في ذلك ما يلحق رابطة كل دائن من وصف. ولا يجوز للمدين إذا طالبه أحد الدائنين المتضامنين بالوفاء أن يعارضه بأوجه الدفع الخاصة بغيره من الدائنين، ولكن يجوز له أن يعارض الدائن المطالب بأوجه الدفع الخاصة به ، وبالتالي يشترك فيها جميع الدائنين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_21_19750926_OpEnact_a0d7e966b7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_21> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_21> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_21> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تسري أحكام المواد السابقة الا حيث لا يوجد نص على خلاف ذلك، في قانون خاص، أو معاهدة دولية نافذة في الجزائر ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_21_bis_19750926_OpEnact_0c6decb2a9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_21_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_21_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_21_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على قواعد الاختصاص والاجراءات قانون الدولة التي ترفع فيها الدعوى أو تباشر فيها الاجراءات ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_220_19750926_OpEnact_c1e81cef33> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_220> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_220> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_220> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا برئت ذمة الدائن قبل أحد الدائنين المتضامنين لسبب غير الوفاء فلا تبرأ ذمته قبل الدائنين الآخرين إلا بقدر حصة الدائن التي برئت ذمته من أجله. لا يجوز لأحد الدائنين المتضامنين أن يقوم بعمل من شأنه الاضرار بالآخرين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_221_19750926_OpEnact_93e98e9814> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_221> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_221> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_221> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل ما يستوفيه أحد الدائنين المتضامنين من الدين يصير ملكا لجميع الدائنين وتقسم بينهم حسب وتكون القسمة : بينهم بالتساوي ما لم يوجد اتفاق أو نص قانوني يقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_222_19750926_OpEnact_069216d6dd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_222> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_222> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_222> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان التضامن بين المدينين فإن وفاء أحدهم للدين مبرئ ذمة الباقين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_223_19750926_OpEnact_6ed775bfa2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_223> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_223> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_223> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للدائن مطالبة المدينين المتضامنين مجتمعين أو منفردين على أن يراعى في ذلك ما يلحق رابطة كل مدين من وصف. ولا يجوز للمدين إذا طالبه أحد الدائنين بالوفاء أن يعارض بأوجه الدفع الخاصة بغيره من المدينين ولكن يجوز له أن يعارض بأوجه الدفع الخاصة به وبالتي يشترك فيها جميع المدينين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_224_19750926_OpEnact_0fe19cce29> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_224> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_224> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_224> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يترتب على تجديد الدين بين الدائن وأحد المدينين المتضامنين تبرئة ذمة باقي المدينين إلا إذا احتفظ الدائن بحقه قبلهم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_225_19750926_OpEnact_c2b8a583e7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_225> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_225> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_225> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للمدين المتضامن التمسك بـ المقاصة التي تقع بين الدائن ومدين متضامن آخر الا بقدر حصة هذا المدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_226_19750926_OpEnact_dad76331bd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_226> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_226> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_226> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا اتحدت الذمة بين شخص الدائن وأحد مدينيه المتضامنين ، فإن الدين لا ينقضي بالنسبة إلى باقي المدينين الا بقدر حصة المدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_227_19750926_OpEnact_b84ffa5b0b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_227> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_227> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_227> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ابرأ الدائن أحد مدينيه المتضامنين فلا تبرأ ذمة الباقين الا إذا صرح الدائن بذلك . فإن لم يصدر منه هذا التصريح لا يجوز له مطالبة باقي المدينين المتضامنين الا بما يبقى من الدين بعد خصم حصة المدين الذي ابرأه الا أن يكون قد احتفظ بحقه في الرجوع عليهم بكل الدين وفي هذه الحالة يكون لهم الحق في الرجوع على المدين الذي أبرئت ذمته بحصته في الدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_228_19750926_OpEnact_e21b65c0b7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_228> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_228> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_228> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ابرأ الدائن أحد المدينين المتضامنين من التضامن بقي حقه في الرجوع على الباقين بكل الدين ما لم يكن هناك اتفاق على غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_229_19750926_OpEnact_47ad454b9b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_229> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_229> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_229> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في جميع الأحوال التي يحصل فيها الابراء سواء من الدين ، أو من التضامن يرجع فيها باقي المدينين على المدين المبرأ بنصيبه في حصة المعسر منهم وفقا ل المادة 235 غير أن الدائن إذا اخلى المدين المبرأ من كل مسؤولية الدين يتحمل نصيب هذا المدين في حصة المعسر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_22_19750926_OpEnact_7189a506d4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_22> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_22> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_22> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في حالة تعدد الجنسيات يطبق القاضي الجنسية الحقيقية . غير أن القانون الجزائري هو الذي يطبق إذا كانت للشخص في وقت واحد، بالنسبة إلى الجزائر الجنسية الجزائرية، وبالنسبة إلى دولة أو عدة دول أجنبية جنسية تلك الدول . وفي حالة انعدام الجنسية يطبق القاضي قانون المواطن أو قانون محل الإقامة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_230_19750926_OpEnact_b7e8db8235> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_230> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_230> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_230> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا انقضى الدين بالتقادم بالنسبة إلى أحد المدينين المتضامنين فلا يستفيد من ذلك باقي المدينين الا بقدر حصة هذا المدين. إذا انقطعت مدة التقادم أو وقف سريانه بالنسبة لأحد المدينين المتضامنين ، فلا يجوز للدائن أن يتمسك بذلك قبل باقي المدينين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_231_19750926_OpEnact_c128df4732> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_231> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_231> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_231> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يكون المدين المتضامن مسؤولا في تنفيذ الالتزام الا عن فعله. إذا أعذر الدائن أحد المدينين المتضامنين، أو قاضاه فلا يكون لذلك أثر بالنسبة إلى باقي المدينين، اما إذا أعذر أحد المدينين المتضامنين الدائن فيستفيد باقي المدينين من هذا الاعذار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_232_19750926_OpEnact_fdbbf8a1e0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_232> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_232> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_232> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يسري اقرار أحد المدينين المتضامنين بالدين في حق الباقين. وإذا نكل أحد المدينين المتضامنين عن اليمين الموجهة إليه، أو إذا وجه هذه اليمين إلى الدائن وأداها هذا الأخير فلا يضار بذلك باقي المدينين. وإذا اقتصر الدائن على توجيه اليمين إلى أحد المدينين المتضامنين وحلفها المدين فيستفيد منها الباقون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_233_19750926_OpEnact_05963c97db> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_233> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_233> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_233> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا صدر حكم على أحد المدينين المتضامنين فلا تكون لهذا الحكم سلطة على الآخرين. أما إذا صدر حكم لصالح أحدهم فيستفيد منه الآخرون، الا إذا كان هذا الحكم مبنيا على فعل خاص بالمدين المعني ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_234_19750926_OpEnact_8c6e6d2bc8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_234> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_234> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_234> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وفي أحد المدينين المتضامنين كل الدين ، فلا يرجع على أي من الباقين الا بقدر حصته في الدين، ولو كان بدعوى الحلول على الدائن. ويقسم الدين بالتساوي بين المدينين ما لم يكن هناك اتفاق أو نص يقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_235_19750926_OpEnact_dd50f4bb9c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_235> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_235> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_235> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أعسر أحد المدينين المتضامنين تحمل هذا الاعسار من وفي الدين وسائر المدينين الموسرين كل بقدر حصته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_236_19750926_OpEnact_87283d9ff3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_236> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_236> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_236> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يقبل الالتزام الانقسام : إذا ورد على محل لا يقبل الانقسام بطبيعته ، إذا تبين من غرض الطرفين أن تنفيذ الالتزام لا ينقسم، أو إذا انصرفت نيتهم إلى ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_237_19750926_OpEnact_d2f732d6d3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_237> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_237> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_237> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يلزم كل مدين متضامن بوفاء الدين كاملا إذا كان الالتزام لا يقبل الانقسام . ويرجع المدين الذي وفي الدين على باقي المدينين كل بقدر حصته الا إذا تبين من الظروف غير ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_238_19750926_OpEnact_50676241a8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_238> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_238> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_238> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعدد الدائنون، أو ورثة الدائن في الالتزام غير القابل للانقسام جاز لكل واحد من هؤلاء أن يطالب باداء الالتزام كاملا ، فإذا اعترض أحدهم على الوفاء كان المدين ملزما به لهم مجتمعين، أو بايداع الشيء محل الالتزام . ويرجع الدائنون على الدائن الذي استوفي الالتزام كل بقدر حصته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_239_19750926_OpEnact_ea56f0c701> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_239> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_239> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_239> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للدائن أن يحول حقه إلى شخص آخر الا إذا منع ذلك نص القانون، أو اتفاق المتعاقدين، أو طبيعة الالتزام وتتم الحوالة دون حاجة إلى رضا المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_19750926_OpEnact_c5f34008cd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_23> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "متى ظهر من الأحكام الواردة في المواد المتقدمة أن القانون الواجب التطبيق هو قانون دولة معينة تتعدد فيها التشريعات ، فإن القانون الداخلي لتلك الدولة هو الذي يقرر أي تشريع منها يجب تطبيقه . إذا لم يوجد في القانون المختص نص في هذا الشأن ، طبق التشريع الغالب في البلد في حالة التعدد الطائفي، أو التشريع المطبق في عاصمة ذلك البلد في حالة التعدد الإقليمي ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_19750926_OpEnact_73db096ca0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يطبق القانون الجزائري إذا تعذر إثبات القانون الأجنبي الواجب تطبيقه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_1_19750926_OpEnact_b3b6c5cb5f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تقرر أن قانونا أجنبيا هو الواجب التطبيق فلا تطبق منه إلا أحكامه الداخلية دون تلك الخاصة بتنازع القوانين من حيث المكان. غير أنه يطبق القانون الجزائري إذا أحالت عليه قواعد تنازع القوانين في القانون الأجنبي المختص ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_2_19750926_OpEnact_2cbf7ddc1f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تطبق المبادئ العامة للقانون الدولي الخاص فيما لم يرد بشأنه نص في المواد الخاصة بتنازع القوانين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_240_19750926_OpEnact_1d0824bacc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_240> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_240> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_240> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تجوز حوالة الحق الا إذا كان الحق قابلا للحجز ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_241_19750926_OpEnact_51db567c04> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_241> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_241> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_241> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يحتج بالحوالة قبل المدين ، أو قبل الغير الا إذا رضي بها المدين، أو أخبر بها بعقد غير قضائي ، غير أن قبول المدين لا يجعلها نافذة قبل الغير الا إذا كان هذا القبول ثابت التاريخ ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_242_19750926_OpEnact_5fd9f3f519> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_242> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_242> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_242> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للدائن المحال له قبل إعلان الحوالة أو قبولها أن يتخذ كل الاجراءات التحفظية ليحافظ بها على الحق المنتقل إليه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_243_19750926_OpEnact_85d7bdf80a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_243> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_243> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_243> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تشمل حوالة الحق ضماناته كالكفالة، والامتياز والرهون، ورهن الحيازة، كما تشمل ما حل من أقساط."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_244_19750926_OpEnact_1784f76eb8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_244> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_244> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_244> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت الحوالة بعوض فلا يضمن المحيل الا وجود الحق المحال به وقت الحوالة ، ما لم يكن هناك اتفاق يقضي بغير ذلك . أما إذا كانت الحوالة بغير عوض فلا يكون المحيل ضامنا لوجود الحق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_245_19750926_OpEnact_bdbd1948cf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_245> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_245> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_245> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يضمن المحيل يسار المدين الا إذا وجد اتفاق خاص بهذا الضمان . وإذا ضمن المحيل يسار المدين فلا ينصرف هذا الضمان الآلي يسار المدين وقت الحوالة ما لم يتفق على غير"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_246_19750926_OpEnact_7e5045edc1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_246> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_246> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_246> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا رجع المحال له بالضمان على المحيل طبقا للمادتين 244 و 245 فلا يلزم المحيل الا برد ما قبضه بالاضافة إلى المصاريف ولو وجد اتفاق يقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_247_19750926_OpEnact_d3c3dadb51> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_247> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_247> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_247> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسأل المحيل عن أفعاله الشخصية ولو كانت الحوالة مجانية أو بغير ضمان."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_248_19750926_OpEnact_a8e52ee238> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_248> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_248> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_248> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتمسك المدين قبل المحال له بالدفوع التي يعترض بها قبل المحيل وقت نفاذ الحوالة في حقه كما يجوز له أن يتمسك بالدفوع المستمدة من عقد الحوالة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_249_19750926_OpEnact_c5e889398d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_249> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_249> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_249> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في حالة وقوع خلاف بين عدة حوالات تخص حقا واحدا فضلت الحوالة التي تصبح قبل غيرها نافذة في حق الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_24_19750926_OpEnact_f03ec52853> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز تطبيق القانون الأجنبي بموجب النصوص السابقة إذا كان مخالفا للنظام العام أو الآداب العامة في الجزائر، أو ثبت له الاختصاص بواسطة الغش نحو القانون . يطبق القانون الجزائري محل القانون الأجنبي المخالف للنظام العام أو الآداب العامة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_250_19750926_OpEnact_e89a6b4c52> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_250> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_250> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_250> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا حجز ما تحت يد المحال عليه قبل نفاذ الحوالة في حق الغير كانت الحوالة بالنسبة إلى الحاجز بمثابة حجز آخر. وفي هذه الحالة، إذا وقع حجز آخر بعد أن أصبحت الحوالة نافذة في حق الغير ، فإن الدين يقسم بين الحاجز المتقدم والمحال له والحاجز المتأخر قسمة غرماء، على أن يؤخذ من حصة الحاجز المتأخر المبلغ الضروري لتكملة قيمة الحوالة لصالح المحال له."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_251_19750926_OpEnact_ae187c7f74> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_251> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_251> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_251> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتم حوالة الدين باتفاق بين المدين وشخص آخر يتحمل عنه الدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_252_19750926_OpEnact_2746476525> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_252> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_252> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_252> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تكون الحوالة نافذة في حق الدائن الا إذا أقرها. وإذا قام المحال عليه أو المدين الأصلي باعلان الحوالة إلى الدائن وعين له أجلا معقولا ليقر الحوالة ثم انقضى الأجل دون صدور الاقرار ، اعتبر سكوت الدائن رفضا للحوالة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_253_19750926_OpEnact_4ca49f23fa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_253> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_253> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_253> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ما دام الدائن لم يحدد موقفه من الحوالة اقرارا أو رفضا ، كان المحال عليه ملزما قبل المدين الأصلي بالوفاء للدائن في الوقت المناسب ما لم يكن هناك اتفاق يقضي بغير ذلك، ويسري هذا الحكم ولو رفض الدائن الحوالة. غير أنه لا يجوز للمدين الأصلي أن يطالب المحال عليه بالوفاء للدائن ما دام لم يقم هو بما التزم به قبل المحال عليه بمقتضى عقد الحوالة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_254_19750926_OpEnact_b5a3a09884> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_254> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_254> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_254> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يحال الدين بكامل ضماناته. غير انه لا يبقى للكفيل عينيا كان أو شخصيا، التزام تجاه الدائن الا إذا رضي بالحوالة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_255_19750926_OpEnact_81446fe3f0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_255> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_255> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_255> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يضمن المدين الأصلي يسار المحال عليه وقت اقرار الدائن للحوالة ما لم يتفق على غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_256_19750926_OpEnact_d7b72ce380> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_256> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_256> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_256> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتمسك المحال عليه قبل الدائن بالدفوع التي كان للمدين الأصلي أن يتمسك بها ، كما يجوز له أن يتمسك بالدفوع المستمدة من عقد الحوالة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_257_19750926_OpEnact_6be4f694a7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_257> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_257> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_257> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتم حوالة الدين باتفاق بين الدائن والمحال عليه على أن يتقرر فيه أن هذا الأخير يحل محل المدين الأصلي في التزامه، وفي هذه الحالة تسري أحكام المادتين 254 و 256 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_258_19750926_OpEnact_f439279761> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_258> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_258> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_258> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يصح الوفاء من المدين أو من نائبه أو من أي شخص له مصلحة في الوفاء وذلك مع مراعاة ما جاء في المادة 170 . كما يصح الوفاء أيضا مع التحفظ السابق ممن ليست له مصلحة في الوفاء ولو كان ذلك دون علم المدين أو رغم إرادته غير انه يجوز للدائن رفض الوفاء من الغير إذا اعترض المدين على ذلك وأبلغ الدائن بهذا الاعتراض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_259_19750926_OpEnact_4e3a74fa84> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_259> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_259> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_259> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا قام الغير بوفاء الدين ، كان له حق الرجوع على المدين بقدر ما دفع . غير أنه يجوز للمدين الذي حصل الوفاء بغير إرادته، منع رجوع الموفي بما وفاه عنه كلا أو بعضا إذا أثبت أنله أية مصلحة في الاعتراض على الوفاء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_25_19750926_OpEnact_02f62f6753> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_25> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_25> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_25> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تبدأ شخصية الإنسان بتمام ولادته حيا وتنتهي بموته. على أن الجنين يتمتع بالحقوق التي يحددها القانون بشرط أن يولد حيا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_260_19750926_OpEnact_5dd487eb16> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_260> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_260> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_260> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يشترط لصحة الوفاء أن يكون الموفي مالكا للشيء الذي وفي به، وان يكون ذا أهلية للتصرف فيه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_261_19750926_OpEnact_75d1d1157a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_261> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_261> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_261> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا قام بالوفاء شخص غير المدين ، حل الموفي محل الدائن الذي استوفي حقه في الأحوال الآتية : إذا كان الموفي ملزما بالدين مع المدين، أو ملزما بوفائه عنه، إذا كان الموفي دائنا ووفي دائنا آخر مقدما عليه بما له من تأمين عيني ولو لم يكن للموفي أي تأمين، إذا كان الموفي اشترى عقارا ودفع ثمنه وفاء لدائنين، خصص العقار لضمان حقوقهم، إذا كان هناك نص خاص يقرر للموفي حق الحلول."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_262_19750926_OpEnact_6440ff990f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_262> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_262> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_262> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتفق الدائن الذي استوفي حقه من غير المدين مع هذا الغير على أن يحل محله ولو لم يقبل المدين ذلك، و لا يصح أن يتأخر هذا الاتفاق عن وقت الوفاء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_263_19750926_OpEnact_ac26ae835e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_263> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_263> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_263> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز أيضا للمدين إذا اقترض مالا وفي به الدين أن يحل المقرض محل الدائن الذي استوفي حقه ، ولو دون رضا هذا الأخير، على أن يذكر في عقد القرض أن المال قد خصص للوفاء، وفي المخالصة أن الوفاء كان من هذا المال الذي اقرضه الدائن الجديد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_264_19750926_OpEnact_1942d01f9f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_264> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_264> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_264> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من حل محل الدائن قانونا أو اتفاقا كان له حقه بما لهذا الحق من خصائص وما يلحقه من توابع، وما يكلفه من تأمينات وما يرد عليه من دفوع ويكون هذا الحلول بالقدر الذي أداه من ماله من حل محل الدائن ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_265_19750926_OpEnact_42a5554425> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_265> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_265> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_265> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وفي الغير الدائن جزءا من حقه وحل محله فيه ، فلا يضار الدائن بهذا الوفاء، ويكون في استيفاء ما بقي له من حق مقدما على من وفاه، ما لم يوجد اتفاق يقضي بغير ذلك. فإذا حل شخص آخر محل الدائن فيما بقي له من حق رجع من حل أخيرا هو ومن تقدمه في الحلول كل بقدر ما هو مستحق له وتقاسما قسمة الغرماء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_266_19750926_OpEnact_fd5e6cadcb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_266> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_266> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_266> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وفي الغير الحائز للعقار المرهون كل الدين وحل محل الدائنين فلا يكون له بمقتضى هذا الحلول الرجوع على حائز لعقار آخر مرهون في ذات الدين الا بقدر حصة هذا الحائز بحسب قيمة العقار المحوز."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_267_19750926_OpEnact_56a1db9674> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_267> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_267> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_267> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الوفاء ل لدائن ، أو لنائبه، ويعتبر ذا صفة في استيفاء الدين من يقدم ل لمدين مخالصة صادرة من الدائن ، الا إذا كان متفقا على أن الوفاء يكون للدائن شخصيا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_268_19750926_OpEnact_aca84301eb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_268> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_268> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_268> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الوفاء لشخص غير الدائن ، أو نائبه لا يبرئ ذمة المدين الا إذا أقر الدائن هذا الوفاء، أو عادت عليه منفعة منه، وبقدر هذه المنفعة، أو تم الوفاء بحسن نية للشخص كان الدين في حيازته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_269_19750926_OpEnact_9089fd0903> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_269> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_269> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_269> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا رفض الدائن دون مبرر قبول الوفاء المعروض عليه عرضا صحيحا أو رفض القيام بالاعمال التي لا يتم الوفاء الا بها، أو أعلن انه لن يقبل الوفاء ، اعتبر انه قد تم اعذاره من الوقت الذي يسجل المدين عليه هذا الرفض باعلان رسمي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_26_19750926_OpEnact_ed4ea28aa2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تثبت الولادة والوفاة بالسجلات المعدة لذلك. وإذا لم يوجد هذا الدليل، أو تبين عدم صحة ما أدرج بالسجلات ، يجوز الاثبات بأية طريقة حسب الاجراءات التي ينص عليها قانون الحالة المدنية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_270_19750926_OpEnact_ecaa8b4763> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_270> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_270> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_270> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تم اعذار الدائن فإنه يتحمل تبعة هلاك الشيء، أو تلفه ويصبح للمدين الحق في ايداع الشيء على نفقة الدائن ، والمطالبة بتعويض، ما أصابه من ضرر ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_271_19750926_OpEnact_9242e3470d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_271> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_271> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_271> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان محل الوفاء شيئا معينا بالذات جاز للمدين أن يحصل على ترخيص من القضاء في ايداعه ، فإذا كان هذا الشيء عقارا أو ما هو معد للبقاء حيث وجد جاز للمدين أن يطلب وضعه تحت الحراسة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_272_19750926_OpEnact_ac74ae00aa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_272> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_272> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_272> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمدين بعد استئذان القضاء أن يبيع بالمزاد العلني الأشياء التي يسرع إليها التلف، أو التي تكلف نفقات باهظة في ايداعها أو حراستها وايداع ثمن البيع بالخزينة العمومية . فإذا كان للاشياء سعر معروف في السوق فلا تباع بالمزاد العلني الا إذا تعذر بيعها بالتراضي وبالسعر المتداول عرفا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_273_19750926_OpEnact_3227647dfa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_273> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_273> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_273> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز القيام بالإيداع أو بكل إجراء مماثل : إذا كان المدين يجهل شخصية أو موطن الدائن ، أو كان الدائن عديم الأهلية، أو ناقصها ، ولم يكن له نائب يقبل عنه الوفاء ، أو كان الدين محل نزاع بين عدة أشخاص ، أو كانت هناك أسباب أخرى جدية تبرر هذا الاجراء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_274_19750926_OpEnact_b33daa80d8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_274> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_274> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_274> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يقوم العرض الحقيقي بالنسبة إلى المدين مقام الوفاء، إذا تلاه ايداع وفقا لاحكام قانون الاجراءات المدنية، أو تلاه أي إجراء مماثل يشترط قبول الدائن أو صحته بحكم له قوة الشيء المقضى به ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_275_19750926_OpEnact_21dd65bc92> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_275> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_275> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_275> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا عرض المدين على الدائن وأتبع هذا العرض بايداع أو باجراء مماثل جاز له الرجوع في عرضه ما دام الدائن لم يقبله أو لم يصدر حكم نهائي بصحته ، وفي هذه الحالة لا تبرأ ذمة الشركاء في الدين ولا ذمة الضامنين. ولكن إذا رجع المدين في عرضه بعد قبوله من الدائن أو بعد صحته بعد الحكم، وقبل الدائن منه هذا الرجوع ، لم يكن لهذا الدائن أن يتمسك بما يكفل حظه من تأمينات وتبرأ ذمة الشركاء في الدين، وذمة الضامنين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_276_19750926_OpEnact_de7f29c4af> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_276> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_276> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_276> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الشيء المستحق أصلا هو الذي يكون به الوفاء ، فلا يجبر الدائن على قبول شيء غيره ولو كان هذا الشيء مساويا له في القيمة أو كانت له قيمة أعلى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_277_19750926_OpEnact_e049cfd426> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_277> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_277> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_277> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجبر المدين الدائن على قبول وفاء جزئى لحقه ما لم يوجد اتفاق أو نص يقضي بغير ذلك . فإذا كان الدين متنازعا في جزء منه وقبل الدائن استيفاء الجزء المعترف به فليس للمدين رفض الوفاء بهذا الجزء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_278_19750926_OpEnact_38492000e5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_278> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_278> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_278> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان المدين ملزما بالوفاء بالمصاريف زيادة على الدائن الأصلي وكان ما أداه لا يفي بالدين مع هذه الملحقات، خصم ما أدى من حساب المصاريف ثم من أصل الدين ما لم يتفق على غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_279_19750926_OpEnact_2aa4a943cb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_279> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_279> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_279> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعددت الديون في ذمة المدين ، وكانت لدائن واحد ومن جنس واحد وكان ما أداه لا يفي بهذه الديون جميعا، جاز للمدين عند الوفاء تعيين الدين الذي يريد الوفاء به ما لم يوجد مانع قانوني، أو تعاقدي يحول دون هذا التعيين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_27_19750926_OpEnact_51b1cdaea3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "مسك دفاتر المواليد والوفيات، والتبليغات المتعلقة بها ينظمها القانون الخاص بالحالة المدنية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_280_19750926_OpEnact_f1a267055f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_280> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_280> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_280> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يعين الدين على الوجه المبين في المادة 279 ، كان الخصم من حساب الدين الذي حل أجله، أو من الدين الاشد كلفة، وذلك إذا حل أجل ديون متعددة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_281_19750926_OpEnact_42ad8d4e0a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_281> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_281> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_281> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن يتم الوفاء فور ترتيب الالتزام نهائيا في ذمة المدين ما لم يوجد اتفاق أو نص يقضي بغير ذلك . غير أنه يجوز للقضاء نظرا لمركز المدين، ومراعاة للحالة الاقتصادية أن يمنحوا آجالا ملائمة للظروف دون أن تتجاوز هذه مدة سنة وان يوقفوا التنفيذ مع إبقاء جميع الأمور على حالها . وفي حالة الاستعجال يكون منح الاجال من اختصاص قاضي الأمور المستعجلة. وفي حالة ايقاف التنفيذ فإن الاجال المنصوص عليها في قانون الاجراءات المدنية، بصحة إجراءات التنفيذ تبقى موقوفة إلى انقضاء الأجل الذي منحه القاضي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_282_19750926_OpEnact_25417ad4ca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_282> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_282> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_282> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان محل الالتزام شيئا معينا بالذات، وجب تسليمه في المكان الذي كان موجودا فيه وقت نشوء الالتزام ما لم يوجد اتفاق أو نص يقضي بغير ذلك . أما في الالتزامات الأخرى فيكون الوفاء في المكان الذي يوجد فيه موطن المدين وقت الوفاء ، أو في المكان الذي يوجد فيه مركز مؤسسته إذا كان الالتزام متعلقا بهذه المؤسسة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_283_19750926_OpEnact_22d1641305> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_283> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_283> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_283> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تكون نفقات الوفاء على المدين ، ما لم يوجد اتفاق أو نص يقضي بغير ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_284_19750926_OpEnact_360885dec3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_284> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_284> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_284> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون لمن قام بالوفاء بجزء من الدين الحق في مطالبة مخالصة بما وفاه مع التأشير على سند الدين بحصول هذا الوفاء وله أيضا الحق في مطالبة رد السند أو إلغائه إذا وفي بكل الدين وإذا ضاع السند كان له أن يطلب من الدائن اشهادا على ضياع هذا السند فإذا رفض الدائن القيام بما فرضته عليه الفقرة السابقة جاز للمدين إيداع الشيء المستحق ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_285_19750926_OpEnact_c76793675e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_285> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_285> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_285> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا قبل الدائن في استيفاء حقه مقابلا استعاض به عن الشيء المستحق قام هذا مقام الوفاء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_286_19750926_OpEnact_68e9e0e346> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_286> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_286> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_286> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري أحكام البيع وخصوصا ما يتعلق منها بأهلية الطرفين، وبضمان الاستحقاق، وبضمان العيوب الخفية على الوفاء بمقابل فيما إذا كان ينقل ملكية شيء أعطى في مقابلة الدين ويسري عليه من حيث انه يقضى الدين احكام الوفاء وبالاخص ما تعلق منها بتعيين جهة الدفع وانقضاء التأمينات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_287_19750926_OpEnact_f6a3a98fca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_287> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_287> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_287> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتجدد الالتزام : بتغيير الدين إذا اتفق الطرفان على استبدال الالتزام الأصلي بالتزام جديد يختلف عنه في محله أو في مصدره بتغيير المدين إذا اتفق الدائن والغير على أن يكون هذا الأخير مدينا مكان المدين الأصلي على أن تبرأ ذمة المدين الأصلي دون حاجة لرضائه، أو إذا حصل المدين على رضا الدائن بشخص أجنبي قبل أن يكون هو المدين الجديد، بتغيير الدائن إذا اتفق الدائن والمدين والغير على أن يكون هذا الأخير هو الدائن الجديد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_288_19750926_OpEnact_e0846f662c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_288> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_288> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_288> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يتم التجديد الا إذا كان الالتزامان القديم والجديد قد خلا كل منهما من اسباب البطلان. أما إذا كان الالتزام القديم ناشئا عن عقد قابل للبطلان فلا يكون التجديد صحيحا الا إذا فقد الالتزام الجديد اجازة العقد واحلاله محل الالتزام القديم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_289_19750926_OpEnact_19e64c0dae> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_289> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_289> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_289> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يفترض التجديد بل يجب الاتفاق عليه صراحة، أو استخلاصه بوضوح من الظروف. وبوجه خاص لا ينتج التجديد من كتابة سند بدين موجود قبل ذلك، ولو مما يحدث في الالتزام من تغييرات لا تتناول الا زمان الوفاء، أو مكانه، أو كيفية الوفاء به، ولا مما يدخل على الالتزام من تعديلات لا تتناول الا التأمينات، ما لم يكن هناك اتفاق يقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_28_19750926_OpEnact_ab1c324a09> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_28> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_28> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_28> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن يكون لكل شخص لقب واسم فأكثر ولقب الشخص يلحق أولاده. يجب أن تكون الأسماء جزائرية وقد يكون خلاف ذلك بالنسبة للاطفال المولودين من أبوين غير مسلمين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_290_19750926_OpEnact_1ba43949c1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_290> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_290> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_290> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يعد مجرد تقييد الالتزام في حساب جار تجديدا. وإنما يتجدد الالتزام إذا قطع رصيد الحساب، وتم اقراره على انه إذا كان الدين مكفولا بتأمين خاص فإن هذا التأمين يبقى ما لم يتفق على غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_291_19750926_OpEnact_0435d4a041> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_291> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_291> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_291> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يترتب على التجديد انقضاء الالتزام الأصلي بتوابعه، وانشاء التزام جديد مكانه. ولا تنتقل التأمينات التي تكفل تنفيذ الالتزام الأصلي الا بنص في القانون أو الا إذا تبين من الاتفاق أو من الظروف أن نية المتعاقدين انصرفت إلى غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_292_19750926_OpEnact_61c3549c6a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_292> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_292> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_292> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا قدم المدين تأمينات حقيقية لكفالة الالتزام القديم فإن الاتفاق على نقل هذه التأمينات إلى الالتزام الجديد تراعى فيه الأحكام الآتية : إذا كان التجديد بتغيير الدين جاز للدائن وللمدين الاتفاق على انتقال التأمينات للالتزام الجديد، في الحدود التي لا تلحق ضررا بالغير، إذا كان التجديد بتغيير المدين جاز للدائن وللمدين الجديد الاتفاق على استبقاء التأمينات العينية دون حاجة إلى رضا المدين القديم، إذا كان التجديد بتغيير الدائن جاز للاطراف الثلاثة المتعاقدين الاتفاق على استبقاء التأمينات. ولا يكون الاتفاق على انتقال التأمينات العينية نافذا في حق الغير، الا إذا تم مع التجديد في وقت واحد، مع مراعاة الأحكام المتعلقة بالتسجيل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_293_19750926_OpEnact_a67f22ef67> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_293> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_293> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_293> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تنتقل الكفالة العينية، أو الشخصية، ولا التضامن إلى الالتزام الجديد الا إذا رضي بذلك الكفلاء والمدينون المتضامنون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_294_19750926_OpEnact_2f03b2d278> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_294> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_294> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_294> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتم الانابة إذا حصل المدين على رضاء الدائن بشخص أجنبي يلتزم بوفاء الدين مكان المدين. ولا تقتضي الانابة أن تكون هناك حتما مديونية سابقة بين المدين والغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_295_19750926_OpEnact_73a25510e0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_295> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_295> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_295> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا اتفق المتعاقدون في الانابة أن يستبدلوا بالتزام سابق التزاما جديدا كانت هذه الانابة تجديدا للالتزام بتغيير المدين ويترتب عليها ابراء ذمة المنيب قبل المناب لديه على أن يكون الالتزام الجديد الذي ارتضاه المناب صحيحا والا يكون هذا الأخير معسرا وقت الانابة . غير أنه لا يفترض التجديد في الانابة ، فإن لم يكن هناك اتفاق على التجديد بقى الالتزام القديم إلى جانب الالتزام الجديد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_296_19750926_OpEnact_220a7ce971> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_296> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_296> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_296> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون التزام المناب تجاه المناب لديه صحيحا ولو كان التزامه تجاه المنيب باطلا أو كان خاضعا لدفع من الدفوع ما لم يرجع المناب على المنيب ، وما لم يوجد اتفاق يقضي بغير ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_297_19750926_OpEnact_5dd808c8b8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_297> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_297> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_297> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للمدين حق المقاصة بين ما هو مستحق عليه لدائنه وما هو مستحق له تجاهه ولو اختلف سبب الدينين إذا كان موضوع كل منهما نقودا أو مثليات متحدة النوع والجودة وكان كل منها ثابتا وخاليا من النزاع ومستحق الاداء صالحا للمطالبة به قضاء . ولا يمنع المقاصة تأخر ميعاد الوفاء لمهلة منحها القاضي أو تبرع بها الدائن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_298_19750926_OpEnact_90b55d6b24> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_298> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_298> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_298> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمدين التمسك بالمقاصة ولو اختلف مكان الوفاء في الدينين ولكن يجب عليه في هذه الحالة تعويض الدائن ما لحقه من ضرر لعدم تمكنه بسبب المقاصة من استيفاء ما له من حق أو الوفاء بما عليه من دين في المكان الذي عين لذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_299_19750926_OpEnact_7782db1a23> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_299> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_299> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_299> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تقع المقاصة مهما اختلفت مصادر الديون فيما عدا الحالات التالية : إذا كان أحد الدينين شيئا نزع دون حق من يد مالكه وكان مطلوبا رده، إذا كان أحد الدينين شيئا مودعا أو معارا للاستعمال وكان مطلوبا رده، إذا كان أحد الدينين حقا غير قابل للحجز."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_29_19750926_OpEnact_a3e218d9cb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_29> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_29> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_29> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على اكتساب الألقاب وتبديلها القانون المتعلق بالحالة المدنية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_2_19750926_OpEnact_1955567f09> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تلتزم المؤسسة العمومية الاقتصادية أو الشركة المختلطة الاقتصاد بالمحافظة على الملك المسير في حالة جيدة طوال مدة الاستعمال، وبقاء هذا الملك حرا من أي التزام ماعدا الالتزامات التي لا تضر بحسن سيره ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_300_19750926_OpEnact_681c5892ac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_300> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_300> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_300> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تقع المقاصة الا إذا تمسك بها من له مصلحة فيها ، ولا يجوز النزول عنها قبل ثبوت الحق فيها. ويترتب عليها انقضاء الدينين بقدر الاقل منهما منذ الوقت الذي يصبحان فيه صالحين للمقاصة ويكون تعيين جهة الدفع في المقاصة كتعيينها في الوفاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_301_19750926_OpEnact_a8d25e2f69> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_301> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_301> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_301> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا مضت على الدين مدة التقادم وقت التمسك بالمقاصة فلا يمنع ذلك من وقوعها رغم التمسك بالتقادم ما دامت المدة لم تكن قد تمت في الوقت الذي أصبحت فيه تلك المقاصة ممكنة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_302_19750926_OpEnact_6548ee8115> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_302> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_302> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_302> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تقع المقاصة اضرارا بحقوق كسبها الغير. فإذا اوقع الغير حجزا تحت يد المدين ثم أصبح هذا الأخير دائنا لدائنه فلا يجوز له أن يتمسك بالمقاصة اضرارا للحاجز."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_303_19750926_OpEnact_3498524af0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_303> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_303> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_303> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا حول الدائن حقه للغير وقبل المدين الحوالة دون تحفظ فلا يجوز لهذا الأخير أن يتمسك قبل المحال له بالمقاصة التي كان تمسك بها قبل قبوله للحوالة وليس له الا الرجوع بحقه على المحيل. أما إذا كان المدين لم يقبل الحوالة ولكن أعلن بها فلا تمنعه هذه الحوالة من أن يتمسك بالمقاصة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_304_19750926_OpEnact_0a205a2850> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_304> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_304> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_304> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا اجتمع في شخص واحد صفتا الدائن و المدين بالنسبة إلى دين واحد انقضى هذا الدين بالقدر الذي اتحدت فيه الذمة. وإذا زال السبب الذي أدى لاتحاد الذمة وكان لزواله أثر رجعي عاد الدين إلى الوجود بملحقاته بالنسبة إلى المعنيين بالأمر ويعتبر اتحاد الذمة كانه لم يكن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_305_19750926_OpEnact_9fe2b50717> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_305> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_305> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_305> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينقضي الالتزام إذا برأ الدائن مدينه اختياريا ويتم الابراء متى وصل إلى علم المدين ولكن يصبح باطلا إذا رفضه المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_306_19750926_OpEnact_e450736309> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_306> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_306> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_306> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري على الابراء الأحكام الموضوعية التي تسري على كل تبرع. ولا يشترط فيه شكل خاص ولو وقع على التزام يشترط لقيامه توافر شكل فرضه القانون أو اتفق عليه المتعاقدان ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_307_19750926_OpEnact_a87c542ff3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_307> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_307> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_307> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينقضي الالتزام إذا اثبت المدين أن الوفاء به أصبح مستحيلا عليه لسبب أجنبي عن إرادته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_308_19750926_OpEnact_3377a7fb4d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_308> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_308> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_308> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتقادم الالتزام بانقضاء خمسة عشرة (15) سنة فيما عدا الحالات التي ورد فيها نص خاص في القانون وفيما عدا الاستثناءات الآتية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_309_19750926_OpEnact_660ef95573> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_309> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_309> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_309> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتقادم بخمس (5) سنوات كل حق دوري متجدد ولو أقر به المدين كأجرة المباني، والديون المتأخرة، والمرتبات والاجور، والمعاشات. غير أنه لا يسقط الريع المستحق في ذمة الحائز سيئ النية، ولا الريع الواجب أداؤه على متصرف المال المشاع للمستحقين الا بانقضاء خمسة عشرة (15) سنة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_30_19750926_OpEnact_f4369e89fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_30> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_30> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_30> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينظم الجنسية الجزائرية قانون الجنسية الخاص بها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_310_19750926_OpEnact_e31f996a8a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_310> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_310> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_310> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتقادم بسنتين حقوق الاطباء والصيادلة، والمحامين والمهندسين والخبراء، ووكلاء التفليسة، والسماسرة، والاساتذة والمعلمين بشرط أن تكون هذه الحقوق واجبة لهم جزاء عما أدوه من عمل مهنتهم وعما تكبدوه من مصاريف ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_311_19750926_OpEnact_ecf86181c7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_311> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_311> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_311> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتقادم بأربع (4) سنوات الضرائب والرسوم المستحقة للدولة ويبدأ سريان التقادم والرسوم السنوية من نهاية السنة التي تستحق عنها وفي الرسوم المستحقة عن الأوراق القضائية من تاريخ انتهاء المرافعة في الدعوى أو من تاريخ تحريرها إذا لم تحصل مرافعة. ويتقادم بأربع (4) سنوات أيضا الحق في المطالبة برد الضرائب والرسوم التي دفعت بغير حق ويبدأ سريان التقادم من يوم دفعها. ولا تخل الأحكام السابقة باحكام النصوص الواردة في القوانين الخاصة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_312_19750926_OpEnact_4454c48b24> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_312> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_312> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_312> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتقادم بسنة (1) واحدة الحقوق الآتية : حقوق التجار، والصناع عن أشياء وردوها لاشخاص لا يتجرون فيها، وحقوق أصحاب الفنادق والمطاعم عن أجر الاقامة، وثمن الطعام وكل ما صرفوه لحساب عملائهم، المبالغ المستحقة للعمال والاجراء الآخرون مقابل عملهم. يجب على من يتمسك بالتقادم السنة، أن يحلف اليمين على انه أدى الدين فعلا وهذه اليمين توجه تلقائيا من القاضي إلى ورثة المدين أو إلى أوصيائهم أن كان الورثة قاصرين على انهم لا يعلمون بوجود الدين أو يعلمون بحصول الوفاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_313_19750926_OpEnact_bf67a54aea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_313> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_313> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_313> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يبدأ سريان التقادم في الحقوق المذكورة في المادتين 309 و 311 من الوقت الذي يتم فيه الدائنون تقديم خدماتهم ولو استمروا في أداء خدمات أخرى. وإذا حرر سند بحق من هذه الحقوق فلا يتقادم الحق الا بانقضاء خمسة (15) عشرة سنة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_314_19750926_OpEnact_ea3ca662d2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_314> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_314> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_314> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تحسب مدة التقادم بالايام لا بالساعات، ولا يحسب اليوم الأول وتكمل المدة بانقضاء آخر يوم منها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_315_19750926_OpEnact_cb36f4f318> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_315> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_315> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_315> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يبدأ سريان التقادم فيما لم يرد فيه نص خاص الا من اليوم الذي يصبح فيه الدين مستحق الأداء. وخصوصا لا يسري التقادم بالنسبة إلى دين معلق على شرط واقف الا من اليوم الذي يتحقق فيه الشرط وبالنسبة إلى ضمان الاستحقاق الا من الوقت الذي يثبت فيه الاستحقاق، وبالنسبة إلى الدين المؤجل الا من الوقت الذي ينقضي فيه الأجل. وإذا كان تحديد ميعاد الوفاء متوقفا على إرادة الدائن سرى التقادم من الوقت الذي يتمكن فيه الدائن من إعلان إرادته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_316_19750926_OpEnact_376788a0eb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_316> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_316> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_316> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يسري التقادم كلما وجد مانع مبررا شرعا يمنع الدائن من المطالبة بحقه كما لا يسري فيما بين الأصيل و النائب . ولا يسري التقادم الذي تنقضي مدته عن خمس (5) سنوات في حق عديمي الأهلية و الغائبين و المحكوم عليهم بعقوبات جنائية إذا لم يكن لهم نائب قانوني . ولا يسري التقادم الذي تزيد مدته على خمس (5) سنوات في حق الأشخاص المذكورين في الفقرة السابقة ولو كان لهم نائب قانوني طيلة مدة عدم أهليتهم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_317_19750926_OpEnact_83d1b89d7e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_317> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_317> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_317> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينقطع التقادم بالمطالبة القضائية ولو رفعت الدعوى إلى محكمة غير مختصة بالتنبيه أو بالحجز، وبالطلب الذي يتقدم به الدائن لقبول حقه في تفليسة المدين أو في توزيع أو بأي عمل يقوم به الدائن أثناء مرافعة لاثبات حقه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_318_19750926_OpEnact_0c4dfe6f4d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_318> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_318> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_318> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينقطع التقادم إذا أقر المدين بحق الدائن اقرارا صريحا أو ضمنيا ويعتبر اقرارا ضمنيا أن يترك المدين تحت يد الدائن مالا له مرهونا رهنا حيازيا تأمينا لوفاء الدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_319_19750926_OpEnact_7559d6d327> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_319> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_319> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_319> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا انقطع التقادم بدأ تقادم جديد يسري من وقت انتهاء الاثر المترتب على سبب الانقطاع وتكون مدته هي مدة التقادم الأول . غير أنه إذا حكم بالدين وحاز الحكم قوة الشيء المقضي به أو إذا كان الدين يتقادم بسنة وانقطع تقادمه بإقرار المدين ، كانت مدة التقادم الجديد خمسة عشرة (15) سنة الا أن يكون الدين المحكوم به متضمنا لالتزامات دورية متجددة لا تستحق الاداء الا بعد صدور الحكم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_31_19750926_OpEnact_06beacab63> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_31> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_31> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_31> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تجري على المفقود والغائب الأحكام المقررة في التشريع العائلي ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_320_19750926_OpEnact_0283945f74> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_320> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_320> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_320> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يترتب على التقادم انقضاء الالتزام ، ولكن يتخلف في ذمة المدين التزام طبيعي و إذا سقط الحق بالتقادم تسقط معه ملحقاته ولو لم تكتمل مدة التقادم الخاصة بهذه الملحقات ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_321_19750926_OpEnact_3330a1b388> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_321> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_321> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_321> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للمحكمة أن تقتضي تلقائيا بالتقادم بل يجب أن يكون ذلك بناء على طلب المدين أو من أحد دائنيه، أو أي شخص له مصلحة فيه ولو لم يتمسك المدين به . ويجوز التمسك بالتقادم في أية حالة من حالات الدعوى ولو امام المحكمة الاستئنافية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_322_19750926_OpEnact_1300b8fef0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_322> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_322> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_322> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز التنازل عن التقادم قبل ثبوت الحق فيه ، كما لا يجوز الاتفاق على أن يتم التقادم في مدة تختلف عن المدة التي عينها القانون . وإنما يجوز لكل شخص يملك التصرف في حقوقه أن يتنازل ولو ضمنا عن التقادم بعد ثبوت الحق فيه غير أن هذا التنازل لا ينفذ في حق الدائنين إذا صدر اضرارا بهم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_19750926_OpEnact_c5cd6b6395> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_323> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_323> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "على الدائن اثبات الالتزام و على المدين اثبات التخلص منه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis_19750926_OpEnact_b34956746b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتج الإثبات بالكتابة من تسلسل حروف أو أوصاف أو أرقام أو أية علامات أو رموز ذات معنی مفهوم، مهما كانت الوسيلة التي تتضمنها ، وكذا طرق إرسالها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis_1_19750926_OpEnact_5dc8cedff7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر الإثبات بالكتابة في الشكل الإلكتروني كالإثبات بالكتابة على الورق، بشرط إمكانية التأكد من هوية الشخص الذي أصدرها وأن تكون معدة ومحفوظة في ظروف تضمن سلامتها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_19750926_OpEnact_298d5fbaf3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "العقد الرسمي عقد يثبت فيه موظف أو ضابط عمومي أو شخص مكلف بخدمة عامة، ما تم لديه أو ما تلقاه من ذوي الشأن وذلك طبقا للاشكال القانونية وفي حدود سلطته واختصاصه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_1_19750926_OpEnact_d4f25447e8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "زيادة عن العقود التي يأمر القانون باخضاعها إلى شكل رسمي يجب، تحت طائلة البطلان، تحرير العقود التي تتضمن نقل ملكية عقار أو حقوق عقارية أو محلات تجارية أو صناعية أو كل عنصر من عناصرها، أو التنازل عن أسهم من شركة أو حصص فيها، أو عقود إيجار زراعية أو تجارية أو عقود تسيير محلات تجارية أو مؤسسات صناعية في شكل رسمي ، و يجب دفع الثمن لدى الضابط العمومي الذي حرر العقد . كما يجب، تحت طائلة البطلان، اثبات العقود المؤسسة أو المعدلة للشركة بعقد رسمي . وتودع الأموال الناتجة عن هذه العمليات لدى الضابط العمومي المحرر للعقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_2_19750926_OpEnact_7060804cc1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "توقع العقود الرسمية من قبل الاطراف والشهود عند الاقتضاء ، و يؤشر الضابط العمومي على ذلك في آخر العقد . وإذا كان بين الاطراف أو الشهود من لا يعرف أو لا يستطيع التوقيع يبين الضابط العمومي في آخر العقد تصريحاتهم في هذا الشأن ويضعون بصماتهم ما لم يكن هناك مانع قاهر . وفضلا عن ذلك، إذا كان الضابط العمومي يجهل الاسم والحالة والسكن والاهلية المدنية الاطراف ، يشهد على ذلك شاهدان بالغان تحت مسئوليتهما."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_3_19750926_OpEnact_c7ccb74b9e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_3> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتلقى الضابط العمومي، تحت طائلة البطلان العقود الاحتفائية، بحضور شاهدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_4_19750926_OpEnact_47790b7a6d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_4> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يبين الضابط العمومي في العقود الناقلة أو المعلنة عن ملكية عقارية، طبيعة وحالات ومضمون، وحدود العقارات وأسماء المالكين السابقين، وعند الامكان صفة وتاريخ التحويلات المتتالية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_5_19750926_OpEnact_fdd06ce4df> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_5> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر ما ورد في العقد الرسمي حجة حتى يثبت تزويره ويعتبر نافذا في كامل التراب الوطني."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_6_19750926_OpEnact_19a7021693> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_6> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر العقد الرسمي حجة لمحتوى الاتفاق المبرم بين الاطراف المتعاقدة وورثتهم وذوي الشأن. غير أنه في حالة شكوى بسبب تزوير في الأصل ، يوقف تنفيذ العقد محل الاحتجاج بتوجيه الاتهام، و عند رفع دعوى فرعية بالتزوير ، يمكن للمحاكم، حسب الظروف، ايقاف تنفيذ العقد مؤقتا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_7_19750926_OpEnact_c48cd0b10d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_7> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_7> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر العقد الرسمي حجة بين الاطراف حتى ولو لم يعبر فيه الا ببيانات على سبيل الاشارة، شريطة أن يكون لذلك علاقة مباشرة مع الاجراء . ولا يمكن استعمال البيانات التي ليست لها صلة بالاجراء سوى كبداية للثبوت."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_325_19750926_OpEnact_bdc71faf67> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_325> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_325> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_325> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان أصل الورقة الرسمية موجودا ، فإن صورتها الرسمية خطية كانت أو فوتوغرافية تكون حجة بالقدر الذي تكون فيه مطابقة للأصل. وتعتبر الصورة مطابقة للأصل ما لم ينازع في ذلك أحد الطرفين، فإن وقع تنازع ففي هذه الحالة تراجع الصورة على الأصل ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_19750926_OpEnact_38143fbcea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_326> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_326> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يوجد أصل الورقة الرسمية كانت الصورة حجة على الوجه الآتي : يكون للصور الرسمية الاصلية تنفيذية كانت أو غير تنفيذية حجية الأصل متى كان مظهرها الخارجي لا يسمح بالشك في مطابقتها للأصل. ويكون للصور الرسمية المأخوذة من الصور الاصلية الحجية ذاتها ولكن يجوز في هذه الحالة لكل من الطرفين أن يطلب مراجعتها على الصورة الاصلية التي أخذت منها. أما ما يؤخذ من صور رسمية للصورة المأخوذة من النسخ الأولى فلا يعتد به الا لمجرد الاستئناس تبعا للظروف."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_1_19750926_OpEnact_e91f91df18> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر تقييد العقد الوارد في السجلات العمومية الا كبداية للاثبات بالكتابة ويجب لذلك : أن يثبت انه تم فقد جميع أصول الموثق للسنة التي يبدو انه تم تحرير العقد خلالها، أو أن يثبت أن فقدان أصل هذا العقد قد كان نتيجة حادث خاص. أن يكون فهرس قانوني لدى الموثق، يبين فيه أن العقد قد حرر في نفس التاريخ. وعندما يقبل الاثبات بالبينة باقتران هاتين الحالتين يصبح من الضروري الاستماع لمن كان شاهدا على العقد أن كان على قيد الحياة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_2_19750926_OpEnact_9d800f6700> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر العقد غير رسمي بسبب عدم كفاءة أو أهلية الضابط العمومي أو انعدام الشكل، كمحرر عرفي إذا كان موقعا من قبل الاطراف ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_327_19750926_OpEnact_7a8fcf3ba8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_327> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_327> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_327> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر العقد العرفي صادرا ممن كتبه أو وقعه أو وضع عليه بصمة إصبعه ما لم ينكر صراحة ما هو منسوب إليه، أما ورثته أو خلفه فلا يطلب منهم الإنكار ويكفي أن يحلفوا يمينا بأنهم لا يعلمون أن الخط أو الإمضاء أو البصمة هو لمن تلقوا منه هذا الحق. ويعتد بـ التوقيع الإلكتروني وفق الشروط المذكورة في المادة 323 مكرر 1 أعلاه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_328_19750926_OpEnact_3c5ad6ef72> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_328> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_328> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_328> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يكون العقد العرفي حجة على الغير في تاريخه إلا منذ أن يكون له تاريخ ثابت، ويكون تاريخ العقد ثابتا ابتداء : من يوم تسجيله، من يوم ثبوت مضمونه في عقد آخر حرره موظف عام، من يوم التأشير عليه على يد ضابط عام مختص، من يوم وفاة أحد الذين لهم على العقد خط و امضاء. غير أنه يجوز للقاضي تبعا للظروف، رفض تطبيق هذه الأحكام فيما يتعلق بالمخالصة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_329_19750926_OpEnact_c605cb74ff> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_329> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_329> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_329> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تكون للرسائل الموقع عليها قيمة الاوراق العرفية من حيث الاثبات. وتكون للبرقيات هذه القيمة أيضا إذا كان أصلها المودع في مكتب التصدير موقعا عليه من مرسلها ، وتعتبر البرقية مطابقة لأصلها حتى يقوم الدليل على عكس ذلك. وإذا تلف أصل البرقية فلا تعتبر نسختها الا لمجرد الاستئناس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_32_19750926_OpEnact_d3e2076e46> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_32> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_32> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_32> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتكون أسرة الشخص من ذوي قرباه ويعتبر من ذوي القربى كل من يجمعهم أصل واحد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_330_19750926_OpEnact_cdbf24fec4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_330> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_330> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_330> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "دفاتر التجار لا تكون حجة على غير التجار غير أن هذه الدفاتر عندما تتضمن بيانات تتعلق بتوريدات قام بها التجار، يجوز للقاضي توجيه اليمين المتممة إلى أحد الطرفين فيما يكون اثباته بالبينة . وتكون دفاتر التجار حجة على هؤلاء التجار. ولكن إذا كانت هذه الدفاتر منتظمة فلا يجوز لمن يريد استخلاص دليل لنفسه أن يجزئ ما ورد فيها واستبعاد منه ما هو مناقض لدعواه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_331_19750926_OpEnact_cb0fdfe256> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_331> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_331> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_331> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تكون الدفاتر والأوراق المنزلية حجة على من صدرت منه الا في الحالتين الآتيتين: إذا ذكر فيها صراحة أنه استوفي دينا ، إذا ذكر فيها صراحة أنه قصد بما دونه في هذه الدفاتر والأوراق أن تقوم مقام السند لمن أثبتت حقا لمصلحته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_332_19750926_OpEnact_5a13162b91> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_332> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_332> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_332> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "التأشير على سند بما يستفاد منه براءة ذمة المدين حجة على الدائن إلى أن يثبت العكس ولو لم يكن التأشير موقعا منه ما دام السند لم يخرج قط من حيازته. وكذلك يكون الحكم إذا اثبت الدائن بخطه دون توقيع ما يستفاد منه براءة ذمة المدين في نسخة أصلية أخرى، أو في مخالصة وكانت النسخة أو المخالصة في يد المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_333_19750926_OpEnact_bd3aa4f7ac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_333> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_333> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_333> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في غير المواد التجارية إذا كان التصرف القانوني تزيد قيمته على 100.000 دينار جزائري أو كان غير محدد القيمة فلا يجوز الإثبات بالشهود في وجوده أو انقضائه ما لم يوجد نص يقضي بغير ذلك. ويقدر الالتزام باعتبار قيمته وقت صدور التصرف القانوني ويجوز الإثبات بالشهود إذا كانت زيادة الإلتزام على 100.000 دينار جزائري لم تأت إلا من ضم الملحقات إلى الأصل . وإذا اشتملت الدعوى على طلبات متعددة ناشئة عن مصادر متعددة جاز الإثبات بالشهود في كل طلب لا تزيد قيمته على 100.000 دينار جزائري ولو كانت هذه الطلبات في مجموعها تزيد على هذه القيمة، ولو كان منشؤها علاقات بين الخصوم أنفسهم أو تصرفات قانونية من طبيعة واحدة، وكذلك الحكم في كل وفاء لا تزيد قيمته على 100.000 دينار جزائري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_334_19750926_OpEnact_1a50e1217b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_334> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_334> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_334> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز الإثبات بالشهود ولو لم تزد القيمة على 100.000 دينار جزائري : فيما يخالف أو يجاوز ما اشتمل عليه مضمون عقد رسمي، إذا كان المطلوب هو الباقي، أو هو جزء من حق لا يجوز إثباته إلا بالكتابة، إذا طلب أحد الخصوم في الدعوى بما تزيد قيمته على 100.000 دينار جزائري ثم عدل عن طلبه إلى ما لا يزيد على هذه القيمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_335_19750926_OpEnact_eb6bd6aa46> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_335> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_335> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_335> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز الإثبات بالشهود فيما كان يجب إثباته بالكتابة إذا وجد مبدأ ثبوت بالكتابة . وكل كتابة تصدر من الخصم ويكون من شأنها أن تجعل وجود التصرف المدعى به قريب الاحتمال، تعتبر مبدأ ثبوت بالكتابة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_336_19750926_OpEnact_7ff2b866f7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_336> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_336> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_336> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز الإثبات بالشهود أيضا فيما كان يجب إثباته بالكتابة : إذا وجد مانع مادي أو أدبي يحول دون الحصول على دليل كتابي، إذا فقد الدائن سنده الكتابي لسبب أجنبي خارج عن إرادته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_337_19750926_OpEnact_902bb46c8c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_337> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_337> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_337> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "القرينة القانونية تغني من تقررت لمصلحته عن أية طريقة أخرى من طرف الاثبات، على انه يجوز نقض هذه القرينة بالدليل العكسي ما لم يوجد نص يقضي بغير ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_338_19750926_OpEnact_b3678a1140> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_338> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_338> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_338> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الأحكام التي حازت قوة الشيء المقضي به تكون حجة بما فصلت فيه من الحقوق، و لا يجوز قبول أي دليل ينقض هذه القرينة ولكن لا تكون لتلك الأحكام هذه الحجية الا في نزاع قام بين الخصوم انفسهم، دون أن تتغير صفاتهم وتتعلق بحقوق لها نفس المحل والسبب . ولا يجوز للمحكمة أن تأخذ بهذه القرينة تلقائيا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_339_19750926_OpEnact_28dcd229a2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_339> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_339> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_339> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يرتبط القاضي المدني بالحكم الجنائي الا في الوقائع التي فصل فيها هذا الحكم وكان فصله فيها ضروريا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_33_19750926_OpEnact_45c519188d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_33> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_33> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_33> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "القرابة المباشرة هي الصلة ما بين الأصول والفروع . وقرابة الحواشي هي الرابطة ما بين أشخاص يجمعهم أصل واحد دون أن يكون أحدهم فرعا للآخر ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_340_19750926_OpEnact_fd1d671e0a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_340> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_340> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_340> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يترك لتقدير القاضي استنباط كل قرينة لم يقررها القانون و لا يجوز الاثبات بهذه القرائن الا في الأحوال التي يجيز فيها القانون الاثبات بالبينة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_341_19750926_OpEnact_db06dec092> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_341> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_341> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_341> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الاقرار هو اعتراف الخصم أمام القضاء بواقعة قانونية مدعى بها عليه ذلك أثناء السير في الدعوى المتعلقة بها الواقعة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_342_19750926_OpEnact_a59bcf19d4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_342> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_342> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_342> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الاقرار حجة قاطعة على المقر. ولا يتجزأ الاقرار على صاحبه الا إذا قام على وقائع متعددة وكان وجود واقعة منها لا يستلزم حتما وجود الوقائع الأخرى ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_343_19750926_OpEnact_6f8278b2fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_343> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_343> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_343> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لكل من الخصمين أن يوجه اليمين الحاسمة إلى الخصم الآخر على انه يجوز للقاضي منع توجيه هذه اليمين إذا كان الخصم متعسفا في ذلك . ولمن وجهت إليه اليمين أن يردها على خصمه غير انه لا يجوز ردها إذا قامت اليمين على واقعة لا يشترك فيها الخصمان بل يستقل بها شخص من وجهت إليه اليمين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_344_19750926_OpEnact_85479e581f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_344> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_344> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_344> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز توجيه اليمين الحاسمة في واقعة مخالفة للنظام العام . ويجب أن تكون الواقعة التي تقوم عليها اليمين متعلقة بشخص وجهت إليه اليمين فإن كانت غير شخصية له قامت اليمين على مجرد علمه بها. ويجوز أن توجه اليمين الحاسمة في أية حالة كانت عليها الدعوى ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_345_19750926_OpEnact_ccfd5e0f6d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_345> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_345> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_345> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز لمن وجه اليمين أو ردها أن يرجع في ذلك متى قبل خصمه حلف تلك اليمين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_346_19750926_OpEnact_6b4a7bd4fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_346> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_346> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_346> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للخصم اثبات كذب اليمين بعد تأديتها من الخصم الذي وجهت إليه أو ردت عليه على انه إذا اثبت كذب اليمين بحكم جنائي فإن للخصم الذي أصابه ضرر منها أن يطالب بالتعويض دون إخلال بما قد يكون له من حق في الطعن على الحكم الذي صدر ضده."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_347_19750926_OpEnact_4b07300b6f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_347> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_347> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_347> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل من وجهت إليه اليمين فنكل عنها دون ردها على خصمه وكل من ردت عليه اليمين فنكل عنها ، خسر دعواه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_348_19750926_OpEnact_b5123f5d21> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_348> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_348> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_348> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للقاضي أن يوجه اليمين تلقائيا إلى أي من الخصمين ليبني على ذلك حكمه في موضوع الدعوى أو في ما يحكم به . ويشترط في توجيه هذه اليمين الا يكون في الدعوى دليل كامل، والا تكون الدعوى خالية من أي دليل ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_349_19750926_OpEnact_d83dc200a1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_349> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_349> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_349> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للخصم الذي وجه إليه القاضي اليمين المتممة أن يردها على خصمه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_34_19750926_OpEnact_2ac0cdcc81> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_34> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_34> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_34> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يراعى في ترتيب درجة القرابة المباشرة، اعتبار كل فرع درجة عند الصعود للأصل ما عدا هذا الأصل، وعند ترتيب درجة الحواشي تعد الدرجات صعودا من الفرع للأصل المشترك، ثم نزولا منه إلى الفرع الآخر، وكل فرع فيما عدا الأصل المشترك يعتبر درجة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_350_19750926_OpEnact_88d896bb1a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_350> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_350> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_350> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للقاضي أن يوجه إلى المدعي اليمين المتممة لتحديد قيمة المدعى به إلا إذا استحال تحديد هذه القيمة بطريقة أخرى . ويحدد القاضي حتى في هذه الحالة حدا أقصى للقيمة التي يصدق فيه المدعي بيمينه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_351_19750926_OpEnact_dc7009f466> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_351> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_351> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_351> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "البيع عقد يلتزم بمقتضاه البائع أن ينقل للمشتري ملكية شيء أو حقا ماليا آخر في مقابل ثمن نقدي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_352_19750926_OpEnact_ec58b3e5bf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_352> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_352> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_352> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن يكون المشتري عالما بالمبيع علما كافيا ويعتبر العلم كافيا إذا اشتمل العقد على بيان المبيع وأوصافه الاساسية بحيث يمكن التعرف عليه . وإذا ذكر في عقد البيع أن المشتري عالم بالمبيع سقط حق هذا الأخير في طلب إبطال البيع بدعوى عدم العلم به الا إذا أثبت غش البائع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_353_19750926_OpEnact_5eff0fcbc3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_353> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_353> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_353> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا انعقد البيع بالعينة يجب أن يكون المبيع مطابقا لها وإذا تلفت العينة أو هلكت في يد أحد المتعاقدين ولو دون خطا كان على المتعاقد بائعا أو مشتريا، أن يثبت أن الشيء مطابق أو غير مطابق للعينة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_354_19750926_OpEnact_a9b327e351> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_354> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_354> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_354> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتعين على المشتري في البيع بشرط المذاق أن يقبل المبيع كيفما شاء غير انه يجب عليه أن يعلن بقبوله في الأجل المحدد بعقد الاتفاق أو العرف ، ولا ينعقد البيع الا من يوم هذا الاعلان."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_355_19750926_OpEnact_0b37a62cff> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_355> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_355> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_355> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في البيع على شرط التجربة يجوز للمشتري أن يقبل المبيع أو يرفضه وعلى البائع أن يمكنه من التجربة فإذا رفض المشتري المبيع يجب عليه أن يعلن الرفض في المدة المتفق عليها فإن لم يكن هناك اتفاق على المدة ففي مدة معقولة يعينها البائع ، فإذا انقضت هذه المدة وسكت المشتري مع تمكنه من تجربة المبيع اعتبر سكوته قبولا. يعتبر البيع على شرط التجربة بيعا موقوفا على شرط القبول الا إذا تبين من الاتفاق أو الظروف أن البيع معلق على شرط فاسخ ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_356_19750926_OpEnact_6eae72f5b2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_356> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_356> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_356> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز أن يقتصر تقدير ثمن البيع على بيان الاسس التي يحدد بمقتضاها فيما بعد . وإذا وقع الاتفاق على أن الثمن هو سعر السوق وجب عند الشك الرجوع إلى سعر السوق الذي يقع فيه تسليم المبيع للمشتري في الزمان والمكان ، فإذا لم يكن في مكان التسليم سوق وجب الرجوع إلى سعر السوق في المكان الذي يقضي العرف أن تكون أسعاره هي السارية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_357_19750926_OpEnact_6f93880288> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_357> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_357> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_357> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يحدد المتعاقدان ثمن البيع ، فلا يترتب على ذلك بطلان البيع متى تبين من أن المتعاقدين قد نويا الاعتماد على السعر المتداول في التجارة، أو السعر الذي جرى عليه التعامل بينهما ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_358_19750926_OpEnact_add36b0ba6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_358> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_358> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_358> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا بيع عقار بغبن يزيد عن (1/5) الخمس فللبائع الحق في طلب تكملة الثمن إلى أربعة أخماس(4/5) ثمن المثل . ويجب لتقدير ما إذا كان الغبن يزيد عن الخمس (1/5) أن يقوم العقار بحسب قيمته وقت البيع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_359_19750926_OpEnact_42e215f065> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_359> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_359> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_359> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسقط بالتقادم دعوى تكملة الثمن بسبب الغبن إذا انقضت ثلاث سنوات من يوم وبالنسبة لعديمي الأهلية فمن يوم انقطاع سبب العجز . ولا تلحق هذه الدعوى ضررا بالغير الحسن النية إذا كسب حقا عينيا على العقار المبيع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_35_19750926_OpEnact_527e4ac86e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_35> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_35> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_35> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر أقارب أحد الزوجين في نفس القرابة والدرجة بالنسبة إلى الزوج الآخر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_360_19750926_OpEnact_66ad74e5ae> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_360> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_360> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_360> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز الطعن بالغبن في بيع تم بطريق المزاد العلني بمقتضى القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_361_19750926_OpEnact_0b0c6a9fd9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_361> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_361> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_361> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "البائع أن يقوم بما هو لازم لنقل الحق المبيع إلى المشتري وان يمتنع عن كل عمل من شأنه أن يجعل نقل الحق عسيرا أو مستحيلا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_362_19750926_OpEnact_ab61d05eee> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_362> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_362> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_362> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتقل الملكية في البيع الجزاف إلى المشتري بنفس الطريق التي تنتقل بها ملكية الشيء المعين. ويعتبر البيع جزافا ولو كان تعيين الثمن موقوفا على تحديد قدر الشيء المبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_363_19750926_OpEnact_f8546b4b1d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_363> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان ثمن البيع مؤجلا جاز للبائع أن يشترط أن يكون نقل الملكية إلى المشتري موقوفا على دفع الثمن كله ولو تم تسليم الشيء المبيع . فإذا كان الثمن يدفع أقساطا جاز للمتعاقدين أن يتفقا على أن يستبقي البائع جزءا منه على سبيل التعويض في حالة ما إذا وقع فسخ البيع بسبب عدم استيفاء جميع الاقساط. ومع ذلك يجوز للقاضي تبعا للظروف أن يخفض التعويض المتفق عليه وفقا للفقرة الثانية من المادة 184 . وإذا وفي المشتري جميع الاقساط يعتبر انه تملك الشيء المبيع من يوم البيع. تسري أحكام الفقرات الثلاثة السابقة حتى ولو أعطى المتعاقدان للبيع صفة الإيجار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_364_19750926_OpEnact_25b4d415fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_364> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_364> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_364> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يلتزم البائع بتسليم الشيء المبيع للمشتري في الحالة التي كان عليها وقت البيع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_365_19750926_OpEnact_64aabfcd62> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_365> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_365> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_365> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا عين في عقد البيع مقدار المبيع كان البائع مسؤولا عما نقص منه بحسب ما يقضي به العرف غير انه لا يجوز للمشتري أن يطلب فسخ العقد لنقص في البيع الا إذا اثبت أن النقص يبلغ من الاهمية درجة لو كان يعلمها المشتري لما أتم البيع . وبالعكس إذا تبين أن قدر الشيء المبيع يزيد على ما ذكر بالعقد، وكان الثمن مقدرا بحسب الوحدة وجب على المشتري إذا كان المبيع غير قابل للتقسيم أن يدفع ثمنا زائدا الا إذا كانت الزيادة فاحشة ففي هذه الحالة يجوز له أن يطلب فسخ العقد كل هذا ما لم يوجد اتفاق يخالفه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_366_19750926_OpEnact_5e54507cb6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_366> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_366> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_366> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وجد في قدر المبيع نقص أو زيادة فإن حق المشتري في طلب انقاص الثمن، أو فسخ العقد وحق البائع في طلب تكملة الثمن يسقطان بالتقادم بعد مضي سنة من وقت تسليم المبيع تسليما فعليا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_367_19750926_OpEnact_6e493deabf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_367> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_367> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_367> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتم التسليم بوضع المبيع تحت تصرف المشتري بحيث يتمكن من حيازته والانتفاع به دون عائق ولو لم يتسلمه تسلما ماديا ما دام البائع قد أخبره بانه مستعد لتسليمه بذلك ويحصل التسليم على النحو الذي يتفق مع طبيعة الشيء المبيع. وقد يتم التسليم بمجرد تراضي الطرفين على البيع إذا كان المبيع موجودا تحت يد المشتري قبل البيع أو كان البائع قد استبقى المبيع في حيازته بعد البيع لسبب آخر لا علاقة له بالملكية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_368_19750926_OpEnact_d18d928533> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_368> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_368> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_368> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وجب تصدير المبيع إلى المشتري فلا يتم التسليم الا إذا وصل إليه ما لم يوجد اتفاق يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_369_19750926_OpEnact_b5dae113f7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_369> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_369> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_369> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا هلك المبيع قبل تسليمه بسبب لا يد للبائع فيه سقط البيع واسترد المشتري الثمن الا إذا وقع الهلاك بعد اعدار المشتري بتسليم المبيع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_36_19750926_OpEnact_a9fec6dde3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_36> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_36> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_36> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "موطن كل جزائري هو المحل الذي يوجد فيه سكناه الرئيسي ، وعند عدم وجود سكنى يقوم محل الإقامة العادي مقام المواطن. ولا يجوز أن يكون للشخص أكثر من موطن واحد في نفس الوقت."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_370_19750926_OpEnact_b1684311d2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_370> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_370> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_370> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا نقصت قيمة المبيع قبل التسليم لتلف أصابه جاز للمشتري اما أن يطلب فسخ البيع إذا كان النقص جسيما بحيث لو طرأ قبل العقد لما أتم البيع واما أن يبقي البيع مع انقاص الثمن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_371_19750926_OpEnact_d13c43b10f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_371> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_371> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_371> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يضمن البائع عدم التعرض للمشتري في الانتفاع بالمبيع كله أو بعضه سواء كان التعرض من فعله أو من فعل الغير يكون له وقت البيع حق على المبيع يعارض به المشتري. ويكون البائع مطالبا بالضمان ولو كان حق ذلك الغير قد ثبت بعد البيع وقد آل إليه هذا الحق من البائع نفسه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_372_19750926_OpEnact_e5159f003c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_372> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_372> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_372> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا رفعت على المشتري دعوى استحقاق المبيع كان على البائع حسب الأحوال ووفقا لقانون الاجراءات المدنية أن يتدخل في الخصومة إلى جانب المشتري أو أن يحل فيها محله إذا أعلم البائع في الوقت المناسب ولم يتدخل في الخصام وجب عليه الضمان الا إذا اثبت أن الحكم الصادر في الدعوى كان نتيجة تدليس، أو خطأ. جسیم صادر من المشتري. فإذا لم يخبر المشتري البائع بدعوى الاستحقاق من الوقت المناسب وصدر عليه حكم حاز قوة الشيء المقضي به فإنه يفقد حق الرجوع بالضمان إذا اثبت البائع أن التدخل في الدعوى كان يؤدي إلى رفض دعوى الاستحقاق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_373_19750926_OpEnact_be4b04f46c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_373> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_373> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_373> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "أن الرجوع بالضمان هو حق يثبت للمشتري ولو اعترف عن حسن نية بحق الغير أو تصالح معه دون أن ينتظر حكما قضائيا متى أخبر البائع بالدعوى في الوقت المناسب ودعاه يحل محله فيها دون جدوى ، كل ذلك ما لم يثبت البائع أن الغير لم يكن على حق في دعواه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_374_19750926_OpEnact_c77034d1dc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_374> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_374> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_374> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "عندما يتجنب المشتري نزع اليد عن الشيء المبيع كله أو بعضه بدفع مبلغ من النقود أو باداء شيء آخر ، فعلى البائع أن يتخلص من نتائج الضمان بأن يرد للمشتري ما دفعه من النقود أو قيمة ما أداه من شيء آخر مع مصاريف الخصام ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_375_19750926_OpEnact_3c0be1e335> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_375> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_375> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_375> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في حالة نزع اليد الكلي عن المبيع فللمشتري أن يطلب من البائع : قيمة المبيع وقت نزع اليد، قيمة الثمار التي ألزم المشتري بردها إلى الملاك الذي نزع يد المشتري عن المبيع، المصاريف النافعة التي يمكنه أن يطلبها من صاحب المبيع وكذلك المصاريف الكمالية إذا كان البائع سيئ النية، جميع مصاريف دعوى الضمان ودعوى الاستحقاق باستثناء ما كان المشتري يستطيع أن يتقيه منها لو أعلم البائع بهذه الدعوى الاخيرة طبقا للمادة 373 ، وبوجه عام تعويضه عما لحقه من الخسائر وما فاته من كسب بسبب نزع اليد عن المبيع. كل ذلك ما لم يقم المشتري دعواه على طلب فسخ البيع أو ابطاله."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_376_19750926_OpEnact_3ca7d7193c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_376> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_376> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_376> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في حالة نزع اليد الجزئي عن البيع وفي حالة وجود تكاليف عنه وكانت خسارة المشتري قد بلغت قدرا لو علمه المشتري لما أتم العقد كان له أن يطالب البائع بالمبالغ المبينة بالمادة 375 مقابل رد المبيع مع الانتفاع الذي حصل عليه منه. وإذا اختار المشتري: استبقاء المبيع، أو كانت الخسارة التي لحقته لم تبلغ القدر المشار إليه في الفقرة السابقة لم يكن له سوى المطالبة بحق التعويض عن الضرر الذي لحقه بسبب نزع اليد عن المبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_377_19750926_OpEnact_854b4dc885> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_377> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_377> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_377> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمتعاقدين بمقتضى اتفاق خاص أن يزيدا في ضمان نزع اليد ، أو ينقصا منه، أو يسقطاه . ويفترض في حق الارتفاق أن البائع قد اشترط عدم الضمان إذا كان هذا حقا ظاهرا أو كان البائع قد أعلم به المشتري . ويكون باطلا كل شرط يسقط الضمان أو ينقصه إذا تعمد البائع اخفاء حق الغير ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_378_19750926_OpEnact_c062d71b23> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_378> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_378> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_378> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يبقى البائع مسؤولا عن كل نزع يد ينشأ عن فعله ولو وقع الاتفاق على عدم الضمان ويقع باطلا كل اتفاق يقضي بغير ذلك. وإذا كان نزع اليد عن المبيع من فعل الغير فإن البائع يبقى مطالبا قبل المشتري برد قيمة المبيع وقت نزع اليد الا إذا اثبت أن المشتري كان يعلم وقت البيع سبب نزع اليد، أو انه اشتری تحت مسؤولیته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_379_19750926_OpEnact_ba04b1af80> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_379> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_379> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_379> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون البائع ملزما للضمان إذا لم يشتمل المبيع على الصفات التي تعهد بوجودها وقت التسليم إلى المشتري أو إذا كان بالمبيع عيب ينقص من قيمته، أو من الانتفاع به بحسب الغاية المقصودة منه حسبما هو مذكور بعقد البيع، أو حسبما يظهر من طبيعته أو استعماله فيكون البائع ضامنا لهذه العيوب ولو لم يكن عالما بوجودها. غير أن البائع لا يكون ضامنا للعيوب التي كان المشتري على علم بها وقت البيع، أو كان في استطاعته أن يطلع عليها لو انه فحص المبيع بعناية الرجل العادي ، الا إذا اثبت المشتري أن البائع أكد له خلو المبيع من تلك العيوب أو أنه أخفاها غشا عنه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_37_19750926_OpEnact_fca5114331> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_37> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_37> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_37> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر المكان الذي يمارس فيه الشخص تجارة أو حرفة موطنا صا بالنسبة إلى المعاملات المتعلقة بهذه التجارة أو المهنة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_380_19750926_OpEnact_f375fce722> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_380> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_380> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_380> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تسلم المشتري المبيع وجب عليه التحقق من حالته عندما يتمكن من ذلك حسب قواعد التعامل الجارية ، فإذا كشف عيبا يضمنه البائع وجب عليه أن يخبر هذا الأخير في أجل مقبول عادة فإن لم يفعل اعتبر راضيا بالبيع. غير أنه إذا كان العيب مما لا يظهر بطريق الاستعمال العادي وجب على المشتري بمجرد ظهور العيب أن يخبر البائع بذلك والا اعتبر راضيا بالمبيع بما فيه من عيوب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_381_19750926_OpEnact_b92387047b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_381> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_381> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_381> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أخبر المشتري البائع بالعيب الموجود في المبيع في الوقت الملائم كان له الحق في المطالبة بالضمان وفقا ل المادة 376 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_382_19750926_OpEnact_b306034c26> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_382> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_382> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_382> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تبقى دعوى الضمان مستمرة ولو هلك الشيء المبيع وبأي سبب كان."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_383_19750926_OpEnact_097cdcc50b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_383> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_383> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_383> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسقط بالتقادم دعوى الضمان بعد انقضاء سنة من يوم تسليم المبيع حتى ولو لم يكتشف المشتري العيب الا بعد انقضاء هذا الأجل ما لم يلتزم البائع بالضمان لمدة أطول . غير أنه لا يجوز ل لبائع أن يتمسك بسنة التقادم متى تبين انه أخفي العيب غشا منه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_384_19750926_OpEnact_7f9e4affb1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_384> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_384> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_384> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمتعاقدين بمقتضى اتفاق خاص أن يزيدا في الضمان أو أن ينقصا منه وان يسقطا هذا الضمان غير أن كل شرط يسقط الضمان أو ينقصه يقع باطلا إذا تعمد البائع اخفاء العيب في المبيع غشا منه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_385_19750926_OpEnact_1337f44e00> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_385> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_385> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_385> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا ضمان للعيب في البيوع القضائية ، ولا في البيوع الادارية إذا كانت بالمزاد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_386_19750926_OpEnact_4aa66386f2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_386> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_386> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_386> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ضمن البائع صلاحية المبيع للعمل لمدة معلومة ثم ظهر خلل فيها فعلى المشتري أن يعلم البائع في أجل شهر من يوم ظهوره وان يرفع دعواه في مدة ستة (6) أشهر من يوم الاعلام ، كل هذا ما لم يتفق الطرفان على خلافه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_387_19750926_OpEnact_aa81667975> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_387> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_387> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_387> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يدفع ثمن البيع من مكان تسليم المبيع ما لم يوجد اتفاق أو عرف يقضي بغير ذلك. فإذا لم يكن ثمن المبيع مستحقا وقت تسلم المبيع وجب الوفاء به في المكان الذي يوجد فيه موطن للمشتري وقت استحقاقه الثمن ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_388_19750926_OpEnact_1955d048d1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_388> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_388> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_388> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون ثمن المبيع مستحقا في الوقت الذي يقع فيه تسليم المبيع، ما لم يوجد اتفاق أو عرف يقضي بخلاف ذلك. فإذا تعرض أحد للمشتري مستندا إلى حق سابق أو آل من البائع ، أو إذا خيف على المبيع أن ينزع من يد المشتري جاز له أن لم يمنعه شرط في العقد أن يمسك الثمن إلى أن ينقطع التعرض أو يزول الخطر ، ومع ذلك يجوز للبائع أن يطالب باستيفاء الثمن إذا ظهر للمشتري عيب في الشيء المبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_389_19750926_OpEnact_c0ad1888b5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_389> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_389> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_389> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يستحق المشتري انتفاع وايراد الشيء المبيع ، كما يتحمل تكاليفه من يوم انعقاد البيع ، هذا ما لم يوجد اتفاق أو عرف يقضيان بخلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_38_19750926_OpEnact_7186e808ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_38> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_38> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_38> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "موطن القاصر والمحجور عليه والمفقود والغائب هو موطن من ينوب عن هؤلاء قانونا. غير أنه يكون للقاصر المرشد موطن خاص بالنسبة للتصرفات التي يعتبره القانون أهلا لمباشرتها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_390_19750926_OpEnact_08f7693460> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_390> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_390> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_390> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان تعجيل الثمن كله أو بعضه مستحق الدفع في الحال جاز للبائع أن يمسك المبيع إلى أن يقبض الثمن المستحق ولو قدم له المشتري رهنا أو كفالة هذا ما لم يمنحه البائع أجلا بعد انعقاد البيع. يجوز كذلك للبائع أن يمسك المبيع ولو لم يحل الأجل المتفق عليه لدفع الثمن إذا سقط حق المشتري في الأجل طبقا لمقتضيات المادة 212"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_391_19750926_OpEnact_6fb6ccadd8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_391> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_391> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_391> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تلف المبلغ في يد البائع وهو ماسك له كان تلفه على المشتري ما لم يكن التلف قد وقع من فعل البائع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_392_19750926_OpEnact_a304c272fe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_392> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_392> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_392> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في بيع العروض وغيرها من المنقولات إذا عين أجل لدفع الثمن وتسلم المبيع يكون البيع مفسوخا وجوبا في صالح البائع ودون سابق انذار إذا لم يدفع الثمن عند حلول الأجل وهذا ما لم يوجد اتفاق على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_393_19750926_OpEnact_2bb20e671e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_393> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_393> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_393> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "أن نفقات التسجيل، والطابع ورسوم الاعلان العقاري، والتوثيق وغيرها تكون على المشتري ما لم تكن هناك نصوص قانونية تقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_394_19750926_OpEnact_17fda9d94c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_394> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_394> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_394> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يعين الاتفاق أو العرف مكانا أو زمانا لتسلم المبيع وجب على المشتري أن يتسلمه في المكان الذي يوجد فيه المبيع وقت البيع وان يتسلمه دون تأخير باستثناء الوقت الذي تتطلبه عملية التسلم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_395_19750926_OpEnact_6afd3b0a19> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_395> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_395> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_395> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "أن نفقات تسلم المبيع تكون على المشتري ما لم يوجد عرف أو اتفاق يقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_396_19750926_OpEnact_653c0b196d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_396> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_396> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_396> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون البيع باطلا إذا احتفظ البائع يوم البيع بحق استرداد الشيء المبيع في أجل معين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_397_19750926_OpEnact_738fffe3bb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_397> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_397> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_397> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا باع شخص شيئا معينا بالذات وهو لا يملكه فللمشتري الحق في طلب إبطال البيع ويكون الأمر كذلك ولو وقع البيع على عقار أعلن أو لم يعلن ببيعه. وفي كل حالة لا يكون هذا البيع ناجزا في حق مالك الشيء المبيع ولو أجازه المشتري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_398_19750926_OpEnact_6ede28f9d7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_398> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_398> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_398> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أقر المالك البيع سرى مفعوله عليه وصار ناجزا في حق المشتري. وكذلك يعتبر البيع صحيحا في حق المشتري إذا أكتسب البائع ملكية المبيع بعد انعقاد البيع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_399_19750926_OpEnact_aa073e57e9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_399> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_399> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_399> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أبطل البيع في صالح المشتري بمقتضى حكم وكان المشتري يجهل أن البائع كان لا يملك المبيع فله أن يطالب بالتعويض ولو كان البائع حسن النية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_39_19750926_OpEnact_43c3347789> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_39> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_39> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_39> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز اختيار موطن خاص لتنفيذ تصرف قانوني معين. يجب اثبات اختيار الموطن كتابة . الموطن المختار لتنفيذ تصرف قانوني يعد موطنا بالنسبة إلى كل ما يتعلق بهذا التصرف بما في ذلك اجراءات التنفيذ الجبري ما لم يشترط صراحة هذا الموطن على تصرفات معينة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_3_19750926_OpEnact_2292328b0e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تضع المؤسسة العمومية الاقتصادية أو الشركة المختلطة الاقتصاد تحت تصرف المسير الوسائل اللازمة لأداء مهمته ، و تعقد جميع التأمينات التي تحفظ وتصون الملك المسير ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_400_19750926_OpEnact_6f769114ef> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_400> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_400> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_400> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تنازل شخص عن حق متنازع فيه فللمتنازل ضده أن يتخلص من هذا الشخص برد ثمن البيع الحقيقي له والمصاريف الواجبة . ويعتبر الحق متنازعا فيه إذا رفعت من أجله دعوى أو كان محل نزاع جوهري ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_401_19750926_OpEnact_fcb9a272f7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_401> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_401> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_401> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تسري أحكام المادة 400 في الأموال الآتية : إذا كان الحق المتنازع فيه داخلا ضمن مجموعة أموال بيعت جزافا بثمن واحد، إذا كان الحق المتنازع فيه مشاعا بين ورثة أو شركاء وباع أحدهم نصيبه للآخر، إذا تنازل المدين لدائنه عن حق متنازع فيه وفاء للدين الثابت في ذمته، إذا كان الحق المتنازع فيه يكون دينا مترتبا على عقار وبيع الحق لحائز العقار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_402_19750926_OpEnact_2c02e5563f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_402> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_402> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_402> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للقضاة، ولا للمدافعين القضائيين، ولا للمحامين ولا للموثقين ولا لكتاب الضبط، أن يشتروا بانفسهم مباشرة ولا بواسطة اسم مستعار الحق المتنازع فيه كله أو بعضه إذا كان النظر في النزاع يدخل في اختصاص المحكمة التي يباشرون أعمالهم في دائرتها والا كان البيع باطلا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_403_19750926_OpEnact_9030115532> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_403> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_403> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_403> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للمحامين ولا للمدافعين القضائيين أن يتعاملوا مع موكليهم في الحقوق المتنازع فيها سواء كان التعامل بأسمائهم أو بأسماء مستعارة إذا كانوا هم الذين تولوا الدفاع عنها والا كانت المعاملة باطلة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_404_19750926_OpEnact_345328b081> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_404> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_404> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_404> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من باع تركة دون أن يفصل مشتملاتها، لا يضمن الا صفته كوارث ما لم يقع اتفاق يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_405_19750926_OpEnact_68ebb73694> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_405> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_405> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_405> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا بيعت تركة فلا يسري البيع في حق الغير الا إذا قام المشتري بالاجراءات الواجبة لنقل كل حق اشتملت عليه التركة فإذا نص القانون على اجراءات لنقل الحقوق المذكورة بين المتعاقدين وجب أيضا أن تتم هذه الاجراءات ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_406_19750926_OpEnact_68f99df5b5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_406> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_406> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_406> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان البائع قد استوفي ما للتركة من ديون أو باع شيئا منها وجب أن يرد للمشتري ماقبضه ، ما لم يكن قد اشترط صراحة عدم الرد وقت انعقاد البيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_407_19750926_OpEnact_ed4a8dd985> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_407> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_407> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_407> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يرد المشتري للبائع وقت انعقاد البيع ما قد وفاه هذا الأخير من ديون التركة ويحسب للبائع كل ما يكون دائنا به للتركة ما لم يوجد اتفاق يقضي بخلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_408_19750926_OpEnact_8be4c3609a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_408> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_408> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_408> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا باع المريض مرض الموت لوارث فإن البيع لا يكون ناجزا الا إذا أقره باقي الورثة . أما إذا تم البيع للغير في نفس الظروف فإنه يعتبر غير مصادق عليه ومن أجل ذلك يكون قابلا للابطال."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_409_19750926_OpEnact_337e013dbe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_409> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_409> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_409> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تسري أحكام المادة 408 على الغير الحسن النية إذا كان الغير قد كسب بعوض حقا عينيا على الشيء المبيع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_40_19750926_OpEnact_063d4761f2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_40> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_40> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_40> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل شخص بلغ سن الرشد متمتعا بقواه العقلية، ولم يحجر عليه ، يكون كامل الأهلية لمباشرة حقوقه المدنية . وسن الرشد تسعة عشر (19) سنة كاملة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_410_19750926_OpEnact_504f8bf7ef> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_410> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_410> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_410> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز لمن ينوب عن غيره بمقتضى اتفاق أو نص قانوني أو أمر من السلطة المختصة أن يشتري باسمه مباشرة أو باسم مستعار ولو بطريق المزاد العلني ما كلف ببيعه بموجب النيابة كل ذلك ما لم تاذن به السلطة القضائية مع مراعاة الأحكام الخاصة والواردة في نصوص قانونية أخرى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_411_19750926_OpEnact_d990ac276e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_411> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_411> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_411> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للسماسرة، ولا للخبراء أن يشتروا الأموال المعهودة إليهم ببيعها أو تقدير قيمتها، سواء بانفسهم مباشرة أو باسم مستعار ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_412_19750926_OpEnact_b6065b4143> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_412> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_412> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_412> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يصح البيع في الأحوال المشار إليها في المادتين 410 و 411 إذا أجازه من تم البيع لحسابه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_413_19750926_OpEnact_f4be9d4d0e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_413> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_413> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_413> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "المقايضة عقد يلتزم به كل من المتعاقدين أن ينقل إلى الآخر على سبيل التبادل ملكية مال غير النقود ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_414_19750926_OpEnact_94a1ec91de> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_414> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_414> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_414> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت الأشياء المتقايض فيها مختلفة القيم في تقدير المتعاقدين جاز تعويض الفرق بمبلغ من النقود."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_415_19750926_OpEnact_bc5b4a4293> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_415> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_415> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_415> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري على المقايضة أحكام البيع بالقدر الذي تسمح به طبيعة المقايضة ، ويعتبر كل من المتقايضين بائعا للشيء ومشتريا للشيء الذي قايض عليه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_416_19750926_OpEnact_59735c9455> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_416> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_416> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_416> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الشركة عقد بمقضاه يلتزم شخصان طبيعيان أو اعتباريان أو أكثر على المساهمة في نشاط مشترك بتقديم حصة من عمل أو مال أو نقد ، بهدف اقتسام الربح الذي قد ينتج أو تحقيق اقتصاد أو بلوغ هدف اقتصادي ذي منفعة مشتركة. كما يتحملون الخسائر التي قد تنجر عن ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_417_19750926_OpEnact_dcdd9d1a66> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_417> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_417> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_417> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تعتبر الشركة بمجرد تكوينها شخصا معنويا غير أن هذه الشخصية لا تكون حجة على الغير الا بعد استيفاء اجراءات الشهر التي ينص عليها القانون ومع ذلك إذا لم تقم الشركة بالاجراءات المنصوص عليها في القانون فإنه يجوز للغير بأن يتمسك بتلك الشخصية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_418_19750926_OpEnact_fa145fc2d5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_418> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_418> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_418> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن يكون عقد الشركة مكتوبا وإلا كان باطلا، وكذلك يكون باطلا كل ما يدخل على العقد من تعديلات إذا لم يكن له نفس الشكل الذي يكتسبه ذلك العقد . غير أنه لا يجوز أن يحتج الشركاء بهذا البطلان قبل الغير ولا يكون له أثر فيما بينهم إلا من اليوم الذي يقوم فيه أحدهم بطلب البطلان."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_419_19750926_OpEnact_f0507e5bde> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_419> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_419> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_419> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تعتبر حصص الشركاء متساوية القيمة وأنها تخص ملكية المال لا مجرد الانتفاع به، ما لم يوجد اتفاق أو عرف يخالف ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_41_19750926_OpEnact_6f97cfe1b1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_41> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_41> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_41> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "(4)"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_420_19750926_OpEnact_5d708d0608> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_420> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_420> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_420> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز أن تقتصر حصة الشريك على ما يكون له من نفوذ، أو على ما يتمتع به من ثقة مالية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_421_19750926_OpEnact_133b3ae0a7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_421> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_421> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_421> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت حصة الشريك مبلغا من النقود يقدمها للشركة ولم يقدم هذا المبلغ ففي هذه الحالة يلزمه التعويض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_422_19750926_OpEnact_9b86d6dc74> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_422> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_422> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_422> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت حصة الشريك حق ملكية أو حق منفعة أو أي حق عيني آخر فإن أحكام البيع هي التي تسري فيما يخص ضمان الحصة إذا هلكت أو استحقت أو ظهر فيها عيب أو نقص أما إذا كانت الحصة مجرد انتفاع بالمال فإن أحكام الإيجار هي التي تسري في ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_423_19750926_OpEnact_08d8c56f1a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_423> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_423> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_423> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت حصة الشريك عملا يقدمه للشركة وجب عليه أن يقوم بالخدمات التي تعهد بها و أن يقدم حسابا عما يكون قد كسبه من وقت قيام الشركة بمزاولته العمل الذي قدم كحصة لها . غير أنه لا يكون ملزما بأن يقدم للشركة ما يكون قد حصل عليه من حق اختراع إلا إذا وجد اتفاق يقضي بخلاف ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_424_19750926_OpEnact_8003d478d9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_424> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_424> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_424> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت الحصة التي قدمها الشريك هي ديون له في ذمة الغير فلا ينقض التزامه للشركة إلا إذا استوفيت هذه الديون ومع ذلك يبقى الشريك مسؤولا عن تعويض الضرر إذا لم توف الديون عند حلول أجلها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_425_19750926_OpEnact_e0a65db478> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_425> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_425> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_425> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يبين عقد الشركة نصيب كل واحد من الشركاء في الأرباح والخسائر كان نصيب كل واحد منهم بنسبة حصته في رأس المال. فإذا اقتصر العقد على تعيين نصيب الشركاء في الأرباح وجب اعتبار هذا النصيب في الخسارة أيضا، وكذلك الحال إذا اقتصر العقد على تعيين النصيب في الخسارة . وإذا كانت حصة أحد الشركاء مقصورة على عمله وجب أن يقدر نصيبه في الربح والخسارة حسب ما تفيده الشركة من هذا العمل فإذا قدم فوق عمله نقودا أو شيئا آخر كان له نصيب عن العمل وآخر عما قدمه فوقه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_426_19750926_OpEnact_573915a1ea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_426> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_426> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_426> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وقع الاتفاق على أن أحد الشركاء لا يسهم في أرباح الشركة ولا في خسائرها كان عقد الشركة باطلا. ويجوز الاتفاق على إعفاء الشريك الذي لم يقدم سوى عمله من كل مساهمة في الخسائر على شرط ألا يكون قد قررت له أجرة ثمن عمله ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_427_19750926_OpEnact_7b51cbeb7c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_427> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_427> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_427> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للشريك المنتدب للادارة بنص خاص في عقد الشركة أن يقوم بالرغم من معارضة الشركاء الآخرين بأعمال الادارة، وبالتصرفات التي تدخل في نطاق نشاط الشركة العادي على شرط أن تكون أعمال الادارة والتصرفات خالية من الغش ، و لا يجوز عزل هذا الشريك من وظيف المتصرف بدون مبرر مادامت الشركة قائمة . وإذا كان انتداب الشريك للادارة قد وقع بعد عقد الشركة جاز الرجوع فيه، كما يجوز في التوكيل العادي . أما المتصرفون من غير الشركاء فيمكن عزلهم في كل وقت."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_428_19750926_OpEnact_05eaedeeb4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_428> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_428> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_428> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعدد الشركاء المكلفون بالادارة دون أن يعين اختصاص كل منهم، ودون أن ينص على عدم جواز تصرفاتهم بالانفراد يجوز لكل واحد أن ينفرد بعمله في التصرف على أن يكون لكل واحد من باقي الشركاء الحق في الاعتراض على ذلك العمل قبل انجازه وان يكون الحق لاغلبية الشركاء المنتدبين أن يرفضوا هذا الاعتراض فإذا تساوى الجانبان كان الرفض من حق أغلبية الشركاء جميعا . أما إذا وقع الاتفاق على أن تكون قرارات الشركاء المنتدبين بالإجماع، أو بالأغلبية ، فلا يجوز الخروج على ذلك الا أن يكون لأمر عاجل يترتب على اغفاله خسارة جسيمة لا تعوض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_429_19750926_OpEnact_b84ddea21a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_429> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_429> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_429> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كلما وجب أن يؤخذ القرار بالاغلبية تعين الاخذ بالاغلبية العددية على حسب الافراد ما لم يوجد نص يخالف ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_42_19750926_OpEnact_2d558e5f6e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يكون أهلا لمباشرة حقوقه المدنية من كان فاقد التمييز لصغر في السن، أو عته، أو جنون . يعتبر غير مميز من لم يبلغ ثلاث عشرة سنة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_430_19750926_OpEnact_3c4886805c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_430> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_430> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_430> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يمنع الشركاء غير المديرين من الادارة ولكن يجوز لهم أن يطلعوا بانفسهم على دفاتر ووثائق الشركة ويقع باطلا كل اتفاق يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_431_19750926_OpEnact_ad47cbb74f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_431> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_431> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_431> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يوجد نص خاص على طريقة الادارة اعتبر كل شريك مفوضا من طرف الآخرين لادارة الشركة و يسوغ له أن يباشر أعمال الشركة دون الرجوع إلى غيره على أن يكون للشركاء الحق في رفض هذا الاعتراض على أي عمل قبل انجازه و لا غلبية الشركاء الحق في رفض هذا الاعتراض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_432_19750926_OpEnact_13c72fe48e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_432> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_432> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_432> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "على الشريك أن يمتنع من أي نشاط يلحق ضررا بـ الشركة أو يعاكس الغاية التي انشئت لاجلها . وعليه أن يسهر ويحافظ على مصالح الشركة مثلما يفعله في تدبير مصالحه الخاصة ، الا إذا كان منتدبا للادارة مقابل أجرة وفي هذه الحالة يجب أن لا يقل حرصه عن عناية الرجل المعتاد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_433_19750926_OpEnact_3360b16adc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_433> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_433> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_433> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أخذ الشريك أو احتجز مبلغا من مال الشركة وجب عليه إذا اقتضى الحال ذلك تعويض الشركة عن الضرر الذي لحقها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_434_19750926_OpEnact_0899fa3bdf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_434> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_434> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_434> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا استغرقت الديون أموال الشركة ، كان الشركاء مسؤولين عن هذه الديون في أموالهم الخاصة، كل منهم بنسبة نصيبه في خسائر الشركة ، ما لم يوجد اتفاق يقضي بنسبة أخرى ويقع باطلا كل اتفاق يعفي الشريك من المسؤولية عن ديون الشركة . وعلى كل حال يكون لدائني الشركة الحق في مطالبة الشركاء كل بقدر الحصة التي تخصصت له في أرباح الشركة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_435_19750926_OpEnact_a9bd6652a3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_435> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_435> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_435> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تضامن بين الشركاء فيما هم مسؤولون عنه من ديون الشركة ، الا إذا وجد اتفاق يقضي بخلاف ذلك . غير انه إذا أعسر أحد الشركاء ، وزعت حصته في الدين على الآخرين كل بقدر نصيبه في تحمل الخسارة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_436_19750926_OpEnact_be79dd543a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_436> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_436> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_436> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان لأحد الشركاء دائنون شخصيون ، فليس لهم أثناء قيام الشركة أن يتقاضوا ديونهم الا من نصيب ذلك الشريك في الارباح دون نصيبه في رأس المال، ولكن لهم أن يتقاضوا ديونهم من نصيب مدينهم في أموال الشركة بعد تصفيتها وطرح ديونها على انه يجوز لهم قبل التصفية توقيع الحجز التحفظي على نصيب مدينهم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_437_19750926_OpEnact_e4ca466587> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_437> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_437> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_437> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتهي الشركة بانقضاء الميعاد الذي عين لها أو بتحقيق الغاية التي انشئت لأجلها. فإذا انقضت المدة المعينة أو تحققت الغاية التي انشئت لأجلها ثم استمر الشركاء يقومون بعمل من نوع الأعمال التي تكونت من أجلها الشركة أمتد العقد سنة فسنة بالشروط ذاتها. ويجوز لدائن أحد الشركاء أن يعترض على هذا الامتداد ويترتب على اعتراضه وقف أثره في حقه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_438_19750926_OpEnact_354de4d73c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_438> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_438> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_438> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتهي الشركة بهلاك جميع مالها أو جزء كبير منه بحيث لا تبقى فائدة في استمرارها. وإذا كان أحد الشركاء قد تعهد بأن يقدم حصته شيئا معينا بالذات وهلك هذا الشيء قبل تقديمه أصبحت الشركة منحلة في حق جميع الشركاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_439_19750926_OpEnact_2c6dc5037b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_439> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_439> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_439> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتهي الشركة بموت أحد الشركاء أو الحجر عليه أو باعساره أو بافلاسه. إلا أنه يجوز الاتفاق في حالة ما إذا مات أحد الشركاء أن تستمر الشركة مع ورثته ولو كانوا قصرا. ويجوز أيضا الاتفاق على انه إذا مات أحد الشركاء أو حجر عليه أو أفلس أو انسحب من الشركة وفقا ل المادة 440 ، أن تستمر الشركة بين الشركاء الباقين وفي هذه الحالة لا يكون لهذا الشريك أو لورثته الا نصيبه في أموال الشركة، ويقدر هذا النصيب بحسب قيمته يوم وقوع الحادث الذي أدى إلى خروجه من الشركة ويدفع له نقدا ولا يكون له نصيب فيما يستجد بعد ذلك من حقوق الا بقدر الحقوق الناتجة من أعمال سابقة على ذلك الحادث."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_43_19750926_OpEnact_0017d454a6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_43> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_43> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل من بلغ سن التمييز ولم يبلغ سن الرشد وكل من بلغ سن الرشد وكان سفيها أو ذا غفلة ، يكون ناقص الأهلية وفقا لما يقرره القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_440_19750926_OpEnact_911be29dce> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_440> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_440> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_440> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتهي الشركة بانسحاب أحد الشركاء، إذا كانت مدتها غير معينة، على شرط أن يعلن الشريك سلفا عن إرادته في الانسحاب قبل حصوله إلى جميع الشركاء وان لا يكون صادرا عن غش أو في وقت غير لائق. وتنتهي الشركة أيضا بإجماع الشركاء على حلها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_441_19750926_OpEnact_0cec68b82b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_441> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_441> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_441> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز أن تحل الشركة بحكم قضائي بناء على طلب أحد الشركاء، لعدم وفاء شريك بما تعهد به أو بأي سبب آخر ليس هو من فعل الشركاء ، ويقدر القاضي خطورة السبب المبرر لحل الشركة. ويكون باطلا كل اتفاق يقضي بخلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_442_19750926_OpEnact_24a675e421> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_442> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_442> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_442> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لكل شريك أن يطلب من السلطة القضائية فصل أي شريك يكون وجوده سببا أثار اعتراضا على مد أجلها أو تكون تصرفاته سببا مقبولا لحل الشركة على شرط أن تستمر الشركة قائمة بين الشركاء الباقين. ويجوز أيضا لأي شريك إذا كانت الشركة معينة لأجل أن يطلب من السلطة القضائية إخراجه من الشركة متى استند في ذلك إلى أسباب معقولة ، وفي هذه الحالة تنحل الشركة ما لم يتفق الشركاء على استمرارها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_443_19750926_OpEnact_6e8754f77a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_443> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_443> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_443> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتم تصفية أموال الشركة وقسمتها بالطريقة المبينة في العقد ، فإن خلا من حكم خاص تتبع الأحكام التالية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_444_19750926_OpEnact_0d9a1f0d2c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_444> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_444> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_444> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتهي مهام المتصرفين عند انحلال الشركة اما شخصية الشركة فتبقى مستمرة إلى أن تنتهي التصفية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_445_19750926_OpEnact_6cf0cd071b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_445> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_445> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_445> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتم التصفية عند الحاجة اما على يد جميع الشركاء، واما على يد مصف واحد أو أكثر تعينهم أغلبية الشركاء. وإذا لم يتفق الشركاء على تعيين المصفي ، فيعينه القاضي بناء على طلب أحدهم. وفي الحالات التي تكون فيها الشركة باطلة فإن المحكمة تعين المصفي وتحدد طريقة التصفية بناء على طلب كل من يهمه الأمر. وحتى يتم تعيين المصفي يعتبر المتصرفون بالنسبة إلى الغير في حكم المصفين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_446_19750926_OpEnact_3a0fa64114> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_446> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_446> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_446> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ليس للمصفي أن يباشر أعمالا جديدة للشركة الا إذا كانت لازمة لاتمام أعمال سابقة . ويجوز له أن يبيع مال الشركة منقولا أو عقارا اما بالمزاد، واما بالتراضي ما لم يقيد قرار تعيينه هذه السلطة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_447_19750926_OpEnact_94f0c6a307> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_447> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_447> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_447> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تقسم أموال الشركة بين سائر الشركاء بعد استيفاء الدائنين لدينهم، وبعد طرح المبالغ اللازمة لقضاء الديون التي لم يحل أجلها أو الديون المتنازع فيها، وبعد رد المصاريف أو القروض التي يكون أحد الشركاء قيد باشرها في مصلحة الشركة . ويسترد كل واحد من الشركاء مبلغا يعادل قيمة الحصة التي قدمها في رأس المال ، كما هي مبينة في العقد أو يعادل قيمة هذه الحصة وقت تسليمها إذا لم تبين تلك القيمة في العقد، ما لم يكن الشريك قد اقتصر على تقديم عمله أو اقتصر فيما قدمه من شيء على حق المنفعة فيه أو على مجرد الانتفاع به . إذا بقي شيء وجبت قسمته بين الشركاء بنسبة نصيب كل واحد في الارباح. وإذا لم يف رأس المال الصافي للوفاء بحصص الشركاء فإن الخسارة توزع على الشركاء جميعا بحسب النسبة المتفق عليها في توزيع الخسائر والا كان ذلك حسب أحكام المادة 425 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_448_19750926_OpEnact_f002754f72> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_448> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_448> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_448> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تطبق في قسمة الشركات القواعد المتعلقة بقسمة المال المشاع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_449_19750926_OpEnact_c4ab563063> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_449> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_449> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_449> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تطبق مقتضيات هذا الفصل على الشركات التجارية الا فيما يخالف القوانين التجارية والعرف التجاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_44_19750926_OpEnact_4e50bd13b3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يخضع فاقد الأهلية، وناقصوها، بحسب الأحوال لأحكام الولاية، أو الوصاية، أو القوامة ، ضمن الشروط ووفقا للقواعد المقررة في القانون ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_450_19750926_OpEnact_2c2a92a2de> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_450> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_450> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_450> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "قرض الاستهلاك هو عقد يلتزم به المقرض أن ينقل إلى المقترض ملكية مبلغ من النقود أو أي شيء مثلي آخر ، على أن يرد إليه المقترض عند نهاية القرض نظيره في النوع، والقدر، والصفة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_451_19750926_OpEnact_b77e38748c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_451> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_451> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_451> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على المقرض أن يسلم إلى المقترض الشيء الذي يشتمل عليه العقد و لا يجوز له أن يطالبه برد نظيره الا عند انتهاء القرض . وإذا تلف الشيء قبل تسليمه إلى المقترض كان الاتلاف على المقرض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_452_19750926_OpEnact_0d8928dc6f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_452> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_452> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_452> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا استحق الشيء فإن أحكام المادة 538 وما بعدها والخاصة بالعارية هي التي تطبق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_453_19750926_OpEnact_0a7662ed47> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_453> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_453> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_453> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ظهر في الشيء عيب خفي واختار المقترض استيفاء الشيء فلا يلزمه أن يرد الا قيمة الشيء المعيب. أما إذا كان المقرض قد تعمد اخفاء العيب ، فللمقترض أن يطلب إما اصلاح العيب واما استبدال الشيء المعيب بشيء خال من العيوب ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_454_19750926_OpEnact_73629a13d0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_454> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_454> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_454> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "القرض بين الافراد يكون دائما بدون أجر ويقع باطلا كل نص يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_455_19750926_OpEnact_a934ebe01a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_455> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_455> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_455> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لمؤسسات القرض في حالة إيداع أموال لديها أن تمنح فائدة يحدد قدرها بموجب قرار من الوزير المكلف بالمالية لتشجيع الادخار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_456_19750926_OpEnact_a698efaffa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_456> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_456> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_456> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لمؤسسات القرض التي تمنح قروضا قصد تشجيع النشاط الاقتصادي الوطني أن تأخذ فائدة يحدد قدرها بموجب قرار من الوزير المكلف بالمالية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_457_19750926_OpEnact_da65302b3f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_457> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_457> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_457> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتهي قرض الاستهلاك بانتهاء الأجل المتفق عليه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_458_19750926_OpEnact_40ca2021cb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_458> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_458> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_458> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمدين إذا انقضت ستة (6) أشهر على القرض أن يعلن رغبته في إلغاء العقد، ورد ما اقترضه على أن يتم ذلك في أجل لا يجاوز ستة (6) أشهر من تاريخ الاعلان. أما حق المقترض في الرد فإنه لا يجوز اسقاطه أو تحديده بمقتضى الاتفاق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_459_19750926_OpEnact_104b4142c6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_459> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_459> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_459> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الصلح عقد ينهي به الطرفان نزاعا قائما أو يتوقيان به نزاعا محتملا، وذلك بأن يتنازل كل منهما على وجه التبادل عن حقه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_45_19750926_OpEnact_7f0537b83d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_45> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_45> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ليس لأحد التنازل عن أهليته ولا لتغيير أحكامها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_460_19750926_OpEnact_cd8d52a143> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_460> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_460> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_460> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يشترط فيمن يصالح أن يكون أهلا للتصرف بعوض في الحقوق التي يشملها عقد الصلح ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_461_19750926_OpEnact_8ddbf50821> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_461> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_461> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_461> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز الصلح في المسائل المتعلقة بالحالة الشخصية أو بالنظام العام ولكن يجوز الصلح على المصالح المالية الناجمة عن الحالة الشخصية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_462_19750926_OpEnact_d55aa1cd5e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_462> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_462> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_462> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينهي الصلح النزاعات التي يتناولها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_463_19750926_OpEnact_6449f8cec0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_463> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_463> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_463> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لل صلح أثر كاشف بالنسبة لما اشتمل عليه من الحقوق ويقتصر هذا الاثر على الحقوق المتنازع فيها دون غيرها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_464_19750926_OpEnact_de2ebeab90> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_464> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_464> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_464> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن تفسر عبارات التنازل التي يتضمنها الصلح تفسيرا ضيقا أيا كانت تلك العبارات فإن التنازل لا يشمل الا الحقوق التي كانت بصفة جلية محلا للنزاع الذي حسمه الصلح ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_465_19750926_OpEnact_95aa88b388> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_465> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_465> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_465> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز الطعن في الصلح بسبب غلط في القانون ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_466_19750926_OpEnact_81499c1846> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_466> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_466> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_466> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الصلح لا يتجزأ فبطلان جزء منه يقتضي بطلان العقد كله. على أن هذا الحكم لا يسري إذا تبين من عبارات العقد أو من قرائن الأحوال أن المتعاقدين قد اتفقا على أن أجزاء العقد مستقلة بعضها عن بعض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_467_19750926_OpEnact_1df69d094e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_467> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_467> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_467> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الإيجار عقد يمكن المؤجر بمقتضاه المستأجر من الانتفاع بشيء لمدة محددة مقابل بدل إيجار معلوم. يجوز أن يحدد بدل الإيجار نقدا أو بتقديم أي عمل آخر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_467_bis_19750926_OpEnact_cc1dea211f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_467_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_467_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_467_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينعقد الإيجار كتابة ويكون له تاريخ ثابت وإلا كان باطلا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_468_19750926_OpEnact_8cbb46213a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_468> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_468> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_468> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز لمن لا يملك الا حق القيام بأعمال الإدارة أن يعقد ايجارا تزيد مدته على ثلاث (3) سنوات ما لم يوجد نص يقضي بخلاف ذلك. إذا عقد الإيجار لمدة أطول من ذلك تخفض المدة إلى ثلاث (3) سنوات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_19750926_OpEnact_292afc41e2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_469> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتهي بقوة القانون الإيجار الصادر من المنتفع بانقضاء الانتفاع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_19750926_OpEnact_c4ca9b589d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز لصاحب حق الاستعمال وحق السكن أن يعقد إيجارا ما لم ينص العقد المنشئ لحقه صراحة على ذلك . ينتهي الإيجار بقوة القانون بانقضاء حق الاستعمال وحق السكن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_1_19750926_OpEnact_42a1f12dac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتهي الإيجار بانقضاء المدة المتفق عليها دون حاجة إلى تنبيه بالإخلاء. يجوز للمستأجر إنهاء عقد الإيجار قبل ذلك لسبب عائلي أو مهني . و يجب عليه إخطار المؤجر بموجب محرر غیر قضائي يتضمن إشعارا لمدة شهرين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_2_19750926_OpEnact_6b92509a90> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا ينتقل الإيجار إلى الورثة. غير أنه في حالة وفاة المستأجر، ما لم يوجد اتفاق على خلاف ذلك ، يستمر العقد إلى انتهاء مدته، وفي هذه الحالة، يجوز للورثة الذين كانوا يعيشون عادة معه منذ ستة (6) أشهر إنهاء العقد إذا أصبحت تكاليفه باهظة بالنسبة إلى مواردهم أو أصبح الإيجار يزيد عن حاجتهم . تجب ممارسة حق إنهاء الإيجار خلال ستة (6) أشهر من يوم وفاة المستأجر . ويجب إخطار المؤجر بموجب محرر غير قضائي يتضمن إشعارا لمدة شهرين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_3_19750926_OpEnact_1064ed01c7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_3> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا انتقلت ملكية العين المؤجرة إراديا أو جبرا يكون الإيجار نافذا في حق من انتقلت إليه الملكية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_4_19750926_OpEnact_7d417e14a4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_4> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للمستأجر أن يحتج على من انتقلت إليه الملكية بما دفعه مقدما من بدل الإيجار إذا أثبت هذا الأخير أن المستأجر كان يعلم وقت الدفع بانتقال الملكية أو كان من المفروض حتما أن يعلم ذلك . وفي حالة عدم إثبات ذلك فلا يكون لمن انتقلت إليه الملكية إلا الرجوع على المؤجر السابق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_46_19750926_OpEnact_69f618e5af> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_46> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_46> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_46> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ليس لأحد التنازل عن حريته الشخصية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_470_19750926_OpEnact_653c88de11> a dzdoc:ArticleVersion ;
