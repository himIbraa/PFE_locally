    dzdoc:position 0 ;
    dzdoc:text "تسقط دعوى التعويض بانقضاء خمس عشرة (15) سنة من يوم وقوع الفعل الضار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_134_condition_0_8b8e6ce3> a dznorm:Condition ;
