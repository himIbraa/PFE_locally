<https://legal.dz/resource/order/1975-09-26/75-58#art_287_defocc_f1e5b789735a> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 14 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:تجديد_الالتزام ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_287> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_287_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يتجدد الالتزام :
                
                
                بتغيير الدين إذا اتفق الطرفان على استبدال الالتزام الأصلي بالتزام جديد يختلف عنه في محله أو في مصدره
                
                
                بتغيير المدين إذا اتفق الدائن والغير على أن يكون هذا الأخير مدينا مكان المدين الأصلي على أن تبرأ ذمة المدين الأصلي دون حاجة لرضائه، أو إذا حصل المدين على رضا الدائن بشخص أجنبي قبل أن يكون هو المدين الجديد،
                
                
                بتغيير الدائن إذا اتفق الدائن والمدين والغير على أن يكون هذا الأخير هو الدائن الجديد."""@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_287_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_287> ;
    dzdoc:position 0 ;
    dzdoc:text "يتجدد الالتزام : بتغيير الدين إذا اتفق الطرفان على استبدال الالتزام الأصلي بالتزام جديد يختلف عنه في محله أو في مصدره بتغيير المدين إذا اتفق الدائن والغير على أن يكون هذا الأخير مدينا مكان المدين الأصلي على أن تبرأ ذمة المدين الأصلي دون حاجة لرضائه، أو إذا حصل المدين على رضا الدائن بشخص أجنبي قبل أن يكون هو المدين الجديد، بتغيير الدائن إذا اتفق الدائن والمدين والغير على أن يكون هذا الأخير هو الدائن الجديد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_294_defocc_2619a85b591d> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 11 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:إنابة ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_294> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_294_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تتم الانابة إذا حصل المدين على رضاء الدائن بشخص أجنبي يلتزم بوفاء الدين مكان المدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_294_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_294> ;
    dzdoc:position 0 ;
    dzdoc:text "تتم الانابة إذا حصل المدين على رضاء الدائن بشخص أجنبي يلتزم بوفاء الدين مكان المدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_295_defocc_65befe66ab0b> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 116 ;
    dzdoc:charStart 87 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:novation ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_295> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_295_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "إذا اتفق المتعاقدون في الانابة أن يستبدلوا بالتزام سابق التزاما جديدا كانت هذه الانابة تجديدا للالتزام بتغيير المدين ويترتب عليها ابراء ذمة المنيب قبل المناب لديه على أن يكون الالتزام الجديد الذي ارتضاه المناب صحيحا والا يكون هذا الأخير معسرا وقت الانابة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_295_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_295> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا اتفق المتعاقدون في الانابة أن يستبدلوا بالتزام سابق التزاما جديدا كانت هذه الانابة تجديدا للالتزام بتغيير المدين ويترتب عليها ابراء ذمة المنيب قبل المناب لديه على أن يكون الالتزام الجديد الذي ارتضاه المناب صحيحا والا يكون هذا الأخير معسرا وقت الانابة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_305_defocc_a17b75d314e6> a dzdoc:DefinitionOccurrence ;
