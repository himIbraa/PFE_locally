<https://legal.dz/resource/order/1975-09-26/75-58#version_art_538> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "العارية عقد يلتزم بمقتضاه المعير أن يسلم المستعير شيئا غير قابل للاستهلاك ليستعمله بلا عوض لمدة معينة أو في غرض معين على أن يرده بعد الاستعمال ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
