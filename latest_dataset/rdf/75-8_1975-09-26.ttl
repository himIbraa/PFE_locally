    dznorm:conditionText "لا يكون رهن الدين نافذا في حق المدين إلا باعلان هذا الرهن إليه أو بقبوله له وفقا لالمادة 241"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_975> ;
    dznorm:position 0 .

