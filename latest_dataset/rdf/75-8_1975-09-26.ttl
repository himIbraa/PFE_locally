    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الشيء المستحق أصلا هو الذي يكون به الوفاء ، فلا يجبر الدائن على قبول شيء غيره ولو كان هذا الشيء مساويا له في القيمة أو كانت له قيمة أعلى."@ar ;
