<https://legal.dz/resource/order/1975-09-26/75-58#version_art_208> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تحقق الشرط يرجع أثره إلى اليوم الذي نشأ فيه الالتزام ، الا إذا تبين من ارادة المتعاقدين أو من طبيعة العقد أن وجود الالتزام، أو زواله، انما يكون في الوقت الذي تحقق فيه الشرط. غير أنه لا يكون للشرط أثر رجعي، إذا أصبح تنفيذ الالتزام قبل تحقق الشرط غير ممكن لسبب لا يد للمدين فيه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_208_19750926_OpEnact_4b00d4d931> ;
    dzdoc:replacementText "إذا تحقق الشرط يرجع أثره إلى اليوم الذي نشأ فيه الالتزام ، الا إذا تبين من ارادة المتعاقدين أو من طبيعة العقد أن وجود الالتزام، أو زواله، انما يكون في الوقت الذي تحقق فيه الشرط. غير أنه لا يكون للشرط أثر رجعي، إذا أصبح تنفيذ الالتزام قبل تحقق الشرط غير ممكن لسبب لا يد للمدين فيه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
