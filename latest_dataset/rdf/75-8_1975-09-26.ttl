<https://legal.dz/resource/order/1975-09-26/75-58#version_art_804> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحل الشفيع بالنسبة إلى البائع محل المشتري في جميع حقوقه والتزاماته الا أنه لا يمكن له الانتفاع بالأجل المضروب للمشتري عن دفع الثمن الا برضاء البائع ، ولا يرجع الشفيع على البائع إذا ما استرد الغير العقار بعد الشفعة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_804_19750926_OpEnact_b88f720c65> ;
    dzdoc:replacementText "يحل الشفيع بالنسبة إلى البائع محل المشتري في جميع حقوقه والتزاماته الا أنه لا يمكن له الانتفاع بالأجل المضروب للمشتري عن دفع الثمن الا برضاء البائع ، ولا يرجع الشفيع على البائع إذا ما استرد الغير العقار بعد الشفعة."@ar ;
