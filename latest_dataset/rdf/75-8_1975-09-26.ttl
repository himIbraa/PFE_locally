<https://legal.dz/resource/order/1975-09-26/75-58#art_427> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_2> ;
    dzdoc:eId "art_427" ;
    dzdoc:fullText "للشريك المنتدب للادارة بنص خاص في عقد الشركة أن يقوم بالرغم من معارضة الشركاء الآخرين بأعمال الادارة، وبالتصرفات التي تدخل في نطاق نشاط الشركة العادي على شرط أن تكون أعمال الادارة والتصرفات خالية من الغش ، و لا يجوز عزل هذا الشريك من وظيف المتصرف بدون مبرر مادامت الشركة قائمة . وإذا كان انتداب الشريك للادارة قد وقع بعد عقد الشركة جاز الرجوع فيه، كما يجوز في التوكيل العادي . أما المتصرفون من غير الشركاء فيمكن عزلهم في كل وقت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_427_permission_0_d25ccc19>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_427_permission_1_ed565260> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_427_right_0_7292413f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_427_right_1_85977ee8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_427> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_427_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_427_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_427_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_427_19750926_OpEnact_7b51cbeb7c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_427_obligation_0_06333203> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "427" ;
    dzdoc:position 451 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_427_condition_0_d9690995>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_427_condition_1_589ecd57> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_660> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_660" ;
    dzdoc:fullText "لا يجوز للدائن أن يرجع على الكفيل وحده الا بعد رجوعه على المدين . ولا يجوز له أن ينفذ على أموال الكفيل الا بعد أن يجرد المدين من أمواله، و يجب على الكفيل في هذه الحالة أن يتمسك بهذا الحق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_660_permission_0_eab6b73c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_660_permission_1_091529c7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_660> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_660_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_660_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_660_19750926_OpEnact_46a97d0443> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_660_obligation_0_04e32869> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_660_prohibition_0_eab6b73c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 660" ;
    dzdoc:position 697 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_679> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_679" ;
    dzdoc:fullText "يتم الحصول على الأموال والخدمات لضمان سير المرافق العمومية باتفاق رضائي وفق الحالات والشروط المنصوص عليها في القانون. إلا أنه يمكن في الحالات الاستثنائية والاستعجالية وضمانا لاستمرارية المرفق العمومي ، الحصول على الأموال والخدمات عن طريق الاستيلاء. ولا يجوز الاستيلاء بأي حال على المحلات المخصصة فعلا للسكن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_679_permission_0_ca6439e7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_679_permission_1_001a89c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_679> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_679_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_679_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_679_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_679_19750926_OpEnact_f073680cf1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_679_obligation_0_ef55ca91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 679" ;
    dzdoc:position 716 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_679_condition_0_14f461fd> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_739> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_739" ;
    dzdoc:fullText "يجوز الاتفاق على انشاء ملكية لمدة لا تزيد على خمسة عشرة (15) سنة ، غير أنه يجوز لكل شريك أن يطلب من المحكمة الإذن له في إخراج نصيبه من هذه الملكية قبل انقضاء الأجل المتفق عليه إذا وجد مبرر قوي لذلك . وإذا لم يكن للملكية المذكورة أجل معين ، كان لكل شريك أن يخرج نصيبه منها بعد ستة (6) أشهر من يوم أن يعلن إلى الشركاء الآخرين عن رغبته في ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_739_permission_0_5e7f085d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_739_right_0_5bf8428a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_739_right_1_ca3e1fff> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_739> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_739_para_0>,
