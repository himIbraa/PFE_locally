<https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_defocc_18226a21ac57> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 162 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
