<https://legal.dz/resource/order/1975-09-26/75-58#version_art_397> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا باع شخص شيئا معينا بالذات وهو لا يملكه فللمشتري الحق في طلب إبطال البيع ويكون الأمر كذلك ولو وقع البيع على عقار أعلن أو لم يعلن ببيعه. وفي كل حالة لا يكون هذا البيع ناجزا في حق مالك الشيء المبيع ولو أجازه المشتري."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_397_19750926_OpEnact_738fffe3bb> ;
