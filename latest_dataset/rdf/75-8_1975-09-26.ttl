<https://legal.dz/resource/order/1975-09-26/75-58#version_art_437> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي الشركة بانقضاء الميعاد الذي عين لها أو بتحقيق الغاية التي انشئت لأجلها. فإذا انقضت المدة المعينة أو تحققت الغاية التي انشئت لأجلها ثم استمر الشركاء يقومون بعمل من نوع الأعمال التي تكونت من أجلها الشركة أمتد العقد سنة فسنة بالشروط ذاتها. ويجوز لدائن أحد الشركاء أن يعترض على هذا الامتداد ويترتب على اعتراضه وقف أثره في حقه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_437_19750926_OpEnact_e4ca466587> ;
    dzdoc:replacementText "تنتهي الشركة بانقضاء الميعاد الذي عين لها أو بتحقيق الغاية التي انشئت لأجلها. فإذا انقضت المدة المعينة أو تحققت الغاية التي انشئت لأجلها ثم استمر الشركاء يقومون بعمل من نوع الأعمال التي تكونت من أجلها الشركة أمتد العقد سنة فسنة بالشروط ذاتها. ويجوز لدائن أحد الشركاء أن يعترض على هذا الامتداد ويترتب على اعتراضه وقف أثره في حقه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_437> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
