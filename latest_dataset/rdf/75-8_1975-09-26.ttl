<https://legal.dz/resource/order/1975-09-26/75-58#art_553> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_553" ;
    dzdoc:fullText "إذا ثبت أثناء سير العمل أن المقاول يقوم به على وجه معيب أو مناف لشروط العقد جاز لرب العمل أن ينذره بأن يصحح من طريقة التنفيذ خلال أجل معقول يعينه له ، فإذا انقضى هذا الأجل دون أن يرجع المقاول إلى الطريقة الصحيحة جاز لرب العمل أن يطلب إما فسخ العقد وإما أن يعهد إلى مقاول آخر بإنجاز العمل على نفقة المقاول الأول طبقا لأحكام المادة 170 أعلاه. غير أنه يجوز طلب فسخ العقد في الحال دون حاجة إلى تعيين أجل إذا كان إصلاح ما في طريقة التنفيذ من عيب مستحيلا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_553_permission_0_3339fd65> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_553_right_0_bc0a2df4>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_553_right_1_ec2e2c16> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_553> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_553_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_553_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_553_19750926_OpEnact_17c0d51f87> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_553_obligation_0_c869636c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "553" ;
    dzdoc:position 580 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_170> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_170> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_553_condition_0_78b714f3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_553_condition_1_b4e31f2f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_553_condition_2_d45fa10c> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_566> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_4> ;
    dzdoc:eId "art_566" ;
    dzdoc:fullText "يمكن ل رب العمل أن يتحلل من العقد ويوقف التنفيذ في أي وقت قبل إتمامه . على أن يعوض المقاول عن جميع ما أنفقه من المصروفات، وما أنجزه من الأعمال وما كان يستطيع كسبه لو أنه أتم العمل . غير أنه يجوز للمحكمة أن تخفض مبلغ التعويض المستحق عما فات المقاول من كسب إذا كانت الظروف تجعل هذا التخفيض عادلا ، و يتعين عليها بوجه خاص أن ينقص منه ما يكون المقاول قد اقتصده من جراء تحلل رب العمل من العقد وما يكون قد كسبه باستخدام وقته في أمر آخر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_566_permission_0_b3f55401>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_566_permission_1_30cbc7c3> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_566_right_0_183ce988>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_566_right_1_efd19da6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_566> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_566_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_566_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_566_19750926_OpEnact_514c77a83b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_566_obligation_0_b33e5824>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_566_obligation_1_edb5cfa4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 566" ;
    dzdoc:position 593 ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_695> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_695" ;
    dzdoc:fullText "لا يجوز لمالك الأرض المحصورة أو التي لها ممر كاف على الطريق العام أن يطلب حق المرور على أرض الغير إذا كان الحصر ناتجا عن إرادته هو . وليس له أن يطالب بـ حق المرور إذا كان يتمتع إما بحق المرور على وجه الاتفاق وإما بحق المرور على وجه الاباحة ما دام المرور الاتفاقي لم ينقض بعد، وحق الاباحة لم يزل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_695_permission_0_c00b9d4b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_695> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_695_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_695_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_695_19750926_OpEnact_fe3435a645> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_695_prohibition_0_c00b9d4b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "695" ;
    dzdoc:position 735 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_695_condition_0_024d054d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_695_condition_1_2f91d591> ;
    dzdoc:usesTerm dzterm:land_locked_property,
        dzterm:right_of_way .

<https://legal.dz/resource/order/1975-09-26/75-58#art_700> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_700" ;
    dzdoc:fullText "لا يجوز لمالك العقار المرتفق به أن يطلب التعويض إذا سكت حتى حصل صاحب الأرض المحصورة بالاستعمال والحيازة على حق المرور بالتقادم لمدة خمسة عشرة (15) سنة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_700_permission_0_d7976b8f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_700> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_700_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_700_19750926_OpEnact_662c77abfd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_700_obligation_0_e7774fb5> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_700_prohibition_0_d7976b8f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 700" ;
    dzdoc:position 740 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_700_condition_0_966c07c0> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_764_bis_1" ;
    dzdoc:fullText "يجوز أن يمثل الشركاء في الملكية أو الشاغلين لها وكيل يختارونه باستثناء المتصرف أو زوجه. ولا يمكن لأي وكيل أن يتلقى أكثر من تفويض لإجراء التصويت . في حالة شيوع قسمة، وعند غياب الممثل المشترك الذي فوضه المعنيون يعين رئيس المحكمة وكيلا وذلك بطلب من أحد الشركاء على الشيوع أو من المتصرف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_permission_0_53506e65>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_permission_1_a764a67f> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_right_0_f6ca42cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_bis_1_19750926_OpEnact_ae93d7575d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_obligation_0_923a61c5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_obligation_1_cab6452e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "764 مكرر 1" ;
    dzdoc:position 814 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_1_condition_0_72f5e6ac> ;
    dzdoc:usesTerm dzterm:administrator .

<https://legal.dz/resource/order/1975-09-26/75-58#art_891> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_891" ;
    dzdoc:fullText "يجوز أن يترتب الرهن ضمانا لدين معلق على شرط أو دين مستقبل أو دين احتمالي كما يجوز أن يترتب ضمانا لاعتماد مفتوح أو لفتح حساب جار على أن يتحدد في عقد الرهن مبلغ الدين المضمون أو الحد الاقصى الذي ينتهي إليه هذا الدين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_891_permission_0_f542812a> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_891_right_0_d97287b9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_891_right_1_7ee6c23a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_891> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_891_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_891_19750926_OpEnact_00e211721c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_891_obligation_0_6476acd2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 891" ;
    dzdoc:position 942 ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_937> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_937" ;
    dzdoc:fullText "يجوز لكل دائن بيده حكم واجب التنفيذ صادر في أصل الدعوى يلزم المدين بشيء معين، أن يحصل على حق تخصيص بعقارات مدينة ضمانا لأصل الدين والمصاريف . ولا يجوز للدائن بعد موت المدين أخذ تخصيص على عقار في التركة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_937_permission_0_94579bb3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_937_permission_1_9638e993> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_937_right_0_02547719> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_937> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_937_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_937_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_937_19750926_OpEnact_afe11bc661> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_937_obligation_0_93fc7aa9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 937" ;
    dzdoc:position 988 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:right_of_allocation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_970> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_970" ;
    dzdoc:fullText "تسري على الرهن المنقول ، الأحكام المتعلقة بالآثار التي تترتب على حيازة المنقولات المادية والسندات لحاملها. وبوجه خاص يكون للمرتهن حسن النية أن يتمسك بحقه في الرهن ولو كان الراهن لا يملك التصرف في الشيء المرهون . كما يجوز من جهة أخرى لكل حائز حسن النية أن يتمسك بالحق الذي كسبه على الشيء المرهون ولو كان ذلك لاحقا لتاريخ الرهن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_970_permission_0_e4d20a75> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_970_right_0_16d232ab>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_970_right_1_c22d5a55> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_970> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_970_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_970_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_970_19750926_OpEnact_afb1ac7c6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 970" ;
    dzdoc:position 1021 ;
    dzdoc:usesTerm dzterm:pledge_creditor,
        dzterm:pledge_movable .

<https://legal.dz/resource/order/1975-09-26/75-58#art_995> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_995" ;
    dzdoc:fullText "يكون لأجرة المباني، والأراضي الزراعية لسنتين أو لكامل مدة الإيجار أن قلت عن ذلك، وكل حق آخر للمؤجر بمقتضى عقد الإيجار امتياز على ما يكون موجودا بالعين المؤجرة ومملوكا للمستأجر من منقول قابل للحجز ومن محصول زراعي. يثبت هذا الامتياز ولو كانت المنقولات مملوكة لزوجة المستأجر أو كانت مملوكة للغير ولم يثبت المؤجر أن كان يعلم وقت وضعها في العين المؤجرة بوجود حق للغير عليها، وذلك دون إخلال بالأحكام المتعلقة بالمنقولات المسروقة أو الضائعة. ويقع الامتياز أيضا على المنقولات والمحصولات المملوكة للمستأجر الفرعي إذا كان المؤجر قد اشترط صراحة عدم الإيجار الفرعي ، فإذا لم يشترط ذلك فلا يثبت الامتياز إلا للمبالغ المستحقة للمستأجر الأصلي في ذمة المستأجر الفرعي في الوقت الذي ينذره فيه المؤجر . وتستوفى هذه المبالغ الممتازة من ثمن الأموال الواقع عليها الامتياز بعد الحقوق المتقدمة الذكر إلا ما كان من هذه الحقوق غير نافذ في المؤجر باعتباره حائزا حسن النية. وإذا نقلت الأموال المثقلة بالامتياز من العين المؤجرة، على الرغم من معارضة المؤجر أو على غير علم منه ولم يبق في العين أموال كافية لضمان الحقوق الممتازة ، بقي الامتياز قائما على الأموال التي نقلت دون أن يضر ذلك الحق الذي كسبه الغير حسن النية على هذه الأموال، ويبقى الامتياز قائما ولو أضر بحق الغير لمدة ثلاث (3) سنوات من يوم نقلها إذا أوقع المؤجر عليها حجزا استحقاقيا في الأجل القانوني . غير أنه إذا بيعت هذه الأموال إلى مشتر حسن النية في سوق عام أو بالمزاد العلني أو ممن يتجر في مثلها ، وجب على المؤجر أن يرد الثمن إلى هذا المشتري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_995> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_995_para_0>,
