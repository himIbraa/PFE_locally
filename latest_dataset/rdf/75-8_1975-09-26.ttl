<https://legal.dz/resource/order/1975-09-26/75-58#version_art_580> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أناب الوكيل عنه غيره في تنفيذ الوكالة دون أن يكون مرخصا له في ذلك كان مسؤولا عما فعل النائب كما لو كان هذا العمل قد صدر منه هو ، ويكون الوكيل ونائبه في هذه الحالة متضامنين في المسؤولية. أما إذا رخص للوكيل في إقامة نائب عنه دون أن يعين شخص النائب فإن الوكيل لا يكون مسؤولا الا عن خطئه في اختيار نائبه أو عن خطئه فيما أصدره له من تعليمات. ويجوز في الحالتين السابقتين للموكل والنائب الوكيل أن يرجع كل منهما مباشرة على الآخر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_580_19750926_OpEnact_00f1007663> ;
    dzdoc:replacementText "إذا أناب الوكيل عنه غيره في تنفيذ الوكالة دون أن يكون مرخصا له في ذلك كان مسؤولا عما فعل النائب كما لو كان هذا العمل قد صدر منه هو ، ويكون الوكيل ونائبه في هذه الحالة متضامنين في المسؤولية. أما إذا رخص للوكيل في إقامة نائب عنه دون أن يعين شخص النائب فإن الوكيل لا يكون مسؤولا الا عن خطئه في اختيار نائبه أو عن خطئه فيما أصدره له من تعليمات. ويجوز في الحالتين السابقتين للموكل والنائب الوكيل أن يرجع كل منهما مباشرة على الآخر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_580> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
