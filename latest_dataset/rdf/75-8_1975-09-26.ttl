<https://legal.dz/resource/order/1975-09-26/75-58#art_64_condition_1_c046a34e> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يصدر القبول فورا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_64> ;
