<https://legal.dz/resource/order/1975-09-26/75-58#art_101_condition_1_0227c513> a dznorm:Condition ;
    dznorm:conditionText "إذا انقضت عشرة (10) سنوات من وقت تمام العقد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_101> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_101_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_101> ;
    dzdoc:position 0 ;
    dzdoc:text "يسقط الحق في إبطال العقد إذا لم يتمسك به صاحبه خلال خمس (5) سنوات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_101_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_101> ;
    dzdoc:position 1 ;
    dzdoc:text "ويبدأ سريان هذه المدة، في حالة نقص الأهلية من اليوم الذي يزول فيه هذا السبب، وفي حالة الغلط أو التدليس من اليوم الذي يكشف فيه، وفي حالة الإكراه من يوم انقطاعه، غير أنه لا يجوز التمسك بحق الإبطال لغلط أو تدليس أو إكراه إذا انقضت عشرة (10) سنوات من وقت تمام العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_101_permission_0_0ee74bdd> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_101_permission_0_0ee74bdd_action_6971d9d7b9> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_101> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويبدأ سريان هذه المدة، في حالة نقص الأهلية من اليوم الذي يزول فيه هذا السبب، وفي حالة الغلط أو التدليس من اليوم الذي يكشف فيه، وفي حالة الإكراه من يوم انقطاعه، غير أنه لا يجوز التمسك بحق الإبطال لغلط أو تدليس أو إكراه إذا انقضت عشرة (10) سنوات من وقت تمام العقد."@ar ;
    dznorm:sourceArticle "art_101" .

