    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_481> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا هلكت العين المؤجرة أثناء مدة الإيجار هلاكا كليا يفسخ الإيجار بحكم القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_481_para_1> a dzdoc:Paragraph ;
