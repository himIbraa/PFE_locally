<https://legal.dz/resource/order/1975-09-26/75-58#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تطبق النصوص الجديدة المتعلقة ب الاجراءات حالا غير أن النصوص القديمة هي التي تسري على المسائل الخاصة ببدء التقادم ووقفه وانقطاعة فيما يخص المدة السابقة على العمل بالنصوص الجديدة . إذا قررت الأحكام الجديدة مدة تقادم أقصر مما قرره النص القديم تسري المدة الجديدة من وقت العمل بالأحكام الجديدة، ولو كانت المدة القديمة قد بدأت قبل ذلك . أما إذا كان الباقي من المدة التي نصت عليها الأحكام القديمة أقصر من المدة التي تقررها الأحكام الجديدة فإن التقادم يتم بانقضاء هذا الباقي . وكذلك الحال فيما يخص أجال الاجر"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_7_19750926_OpEnact_cb1aaec17e> ;
    dzdoc:replacementText "تطبق النصوص الجديدة المتعلقة ب الاجراءات حالا غير أن النصوص القديمة هي التي تسري على المسائل الخاصة ببدء التقادم ووقفه وانقطاعة فيما يخص المدة السابقة على العمل بالنصوص الجديدة . إذا قررت الأحكام الجديدة مدة تقادم أقصر مما قرره النص القديم تسري المدة الجديدة من وقت العمل بالأحكام الجديدة، ولو كانت المدة القديمة قد بدأت قبل ذلك . أما إذا كان الباقي من المدة التي نصت عليها الأحكام القديمة أقصر من المدة التي تقررها الأحكام الجديدة فإن التقادم يتم بانقضاء هذا الباقي . وكذلك الحال فيما يخص أجال الاجراءات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_7> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
