<https://legal.dz/resource/order/1975-09-26/75-58#version_art_818> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يكن من فقد الحيازة قد مضت على حيازته سنة على فقدها فلا يجوز له أن يسترد الحيازة الا ممن لا يستند إلى حيازة أحق بالتفضيل والحيازة الأحق بالتفضيل هي الحيازة القائمة على سند قانوني . فإذا لم يكن لدى أي من الحائزين سند أو تعادلت سنداتهما كانت الحيازة الأحق هي الأسبق في التاريخ. للحائز في جميع الأحوال إذا فقد حيازته بالقوة أن يستردها خلال السنة التالية لفقدها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_818_19750926_OpEnact_ab63bf3849> ;
    dzdoc:replacementText "إذا لم يكن من فقد الحيازة قد مضت على حيازته سنة على فقدها فلا يجوز له أن يسترد الحيازة الا ممن لا يستند إلى حيازة أحق بالتفضيل والحيازة الأحق بالتفضيل هي الحيازة القائمة على سند قانوني . فإذا لم يكن لدى أي من الحائزين سند أو تعادلت سنداتهما كانت الحيازة الأحق هي الأسبق في التاريخ. للحائز في جميع الأحوال إذا فقد حيازته بالقوة أن يستردها خلال السنة التالية لفقدها ."@ar ;
