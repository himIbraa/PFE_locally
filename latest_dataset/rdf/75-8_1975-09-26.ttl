<https://legal.dz/resource/order/1975-09-26/75-58#art_697_condition_0_7896c7f7> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت الأرض المحصورة ناتجة عن تجزئة عقار، بسبب بيع أو مبادلة، أو قسمة، أو من أي معاملة أخرى"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_697> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_697_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_697> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كانت الأرض المحصورة ناتجة عن تجزئة عقار، بسبب بيع أو مبادلة، أو قسمة، أو من أي معاملة أخرى فلا يطلب حق المرور الا على الأراضي التي تشملها تلك المعاملات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_698_condition_0_bae26756> a dznorm:Condition ;
    dznorm:conditionText "تقادم خمسة عشرة (15) سنة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_698> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_698_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_698> ;
    dzdoc:position 0 ;
    dzdoc:text "إن القاعدة والكيفية التي يتم بهما ارتفاق حق المرور بسبب الحصر تحددان بـ تقادم خمسة عشرة (15) سنة فإذا اكتملت هذه المدة فلا يجوز لصاحب العقار المحصور تغيير قاعدة الارتفاق، ولا تحويلها أو نقلها من طرف صاحب العقار المرتفق به دون إذن من صاحب العقار المحصور."@ar .

