<https://legal.dz/resource/order/1975-09-26/75-58#version_art_957> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يعين الطرفان أجلا لحلول الدين المضمون فلا يجوز للدائن أن يطالب باستيفاء حقه إلا عن طريق استنزاله من قيمة الثمار، دون إخلال بحق المدين في الوفاء بالدين في أي وقت أراد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_957_19750926_OpEnact_1b445f75f5> ;
    dzdoc:replacementText "إذا لم يعين الطرفان أجلا لحلول الدين المضمون فلا يجوز للدائن أن يطالب باستيفاء حقه إلا عن طريق استنزاله من قيمة الثمار، دون إخلال بحق المدين في الوفاء بالدين في أي وقت أراد."@ar ;
