<https://legal.dz/resource/order/1975-09-26/75-58#version_art_85_19750926_OpEnact_7330cd995b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_85> ;
