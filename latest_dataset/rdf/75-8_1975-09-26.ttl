<https://legal.dz/resource/order/1975-09-26/75-58#version_art_212> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الالتزام مقترنا بأجل واقف ، فإنه لا يكون نافذا الا في الوقت الذي ينقضي فيه الأجل على انه يجوز للدائن، حتى قبل انقضاء الأجل، أن يتخذ من الاجراءات ما يحافظ به على حقوقه ، وله بوجه خاص أن يطالب بتأمين إذا خشى افلاس المدين، أو عسره واستند في ذلك إلى سبب معقول . ويترتب على انقضاء الأجل الفاسخ زوال الالتزام ، دون أن يكون لهذا الزوال أثر رجعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_212_19750926_OpEnact_ffa98b0a33> ;
    dzdoc:replacementText "إذا كان الالتزام مقترنا بأجل واقف ، فإنه لا يكون نافذا الا في الوقت الذي ينقضي فيه الأجل على انه يجوز للدائن، حتى قبل انقضاء الأجل، أن يتخذ من الاجراءات ما يحافظ به على حقوقه ، وله بوجه خاص أن يطالب بتأمين إذا خشى افلاس المدين، أو عسره واستند في ذلك إلى سبب معقول . ويترتب على انقضاء الأجل الفاسخ زوال الالتزام ، دون أن يكون لهذا الزوال أثر رجعي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_212> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_212> ;
