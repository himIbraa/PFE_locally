<https://legal.dz/resource/order/1975-09-26/75-58#art_580_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_580> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أناب الوكيل عنه غيره في تنفيذ الوكالة دون أن يكون مرخصا له في ذلك كان مسؤولا عما فعل النائب كما لو كان هذا العمل قد صدر منه هو، ويكون الوكيل ونائبه في هذه الحالة متضامنين في المسؤولية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_580_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_580> ;
