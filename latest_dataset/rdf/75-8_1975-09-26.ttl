<https://legal.dz/resource/order/1975-09-26/75-58#art_839> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_839" ;
    dzdoc:fullText "على المالك الذي يرد إليه ملكه أن يدفع إلى الحائز جميع ما أنفقه من المصروفات اللازمة . وفيما يرجع إلى المصروفات النافعة تطبق المادتان 784 و 785 . وإذا كانت المصروفات كمالية فليس للحائز أن يطالب بشيء منها غير أنه يجوز له أن يزيل ما أحدثه من المنشآت بشرط أن يرد الشيء بحالته الأولى الا إذا اختار المالك أن يستبقيها مقابل دفع قيمتها في حالة الهدم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_839_permission_0_8fcbf8ab> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_839_right_0_9bda40a9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_839> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_839_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_839_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_839_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_839_19750926_OpEnact_9a61a54948> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_839_obligation_0_62f1a2ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "839" ;
    dzdoc:position 890 ;
