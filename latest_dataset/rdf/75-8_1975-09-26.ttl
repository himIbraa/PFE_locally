<https://legal.dz/resource/order/1975-09-26/75-58#version_art_492> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للمستأجر أن يحدث بالعين المؤجرة أي تغيير بدون إذن مكتوب من المؤجر . إذا أحدث المستأجر تغييرا في العين المؤجرة يلزم بإرجاعها إلى الحالة التي كانت عليها ويعوض الضرر عند الاقتضاء . وإذا أحدث المستأجر ، بإذن المؤجر ، تغييرات في العين المؤجرة زادت في قيمتها ، وجب على المؤجر عند انتهاء الإيجار، أن يرد للمستأجر المصاريف التي أنفقها أو قيمة ما زاد في العين المؤجرة ، ما لم يوجد اتفاق يقضي بخلاف ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_492_19750926_OpEnact_5081d935f5> ;
    dzdoc:replacementText "لا يجوز للمستأجر أن يحدث بالعين المؤجرة أي تغيير بدون إذن مكتوب من المؤجر . إذا أحدث المستأجر تغييرا في العين المؤجرة يلزم بإرجاعها إلى الحالة التي كانت عليها ويعوض الضرر عند الاقتضاء . وإذا أحدث المستأجر ، بإذن المؤجر ، تغييرات في العين المؤجرة زادت في قيمتها ، وجب على المؤجر عند انتهاء الإيجار، أن يرد للمستأجر المصاريف التي أنفقها أو قيمة ما زاد في العين المؤجرة ، ما لم يوجد اتفاق يقضي بخلاف ذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_492> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_492> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_493> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمستأجر أن يضع بالعين المؤجرة أجهزة لتوصيل المياه والكهرباء والغاز، والتلفون وما يشبه ذلك على شرط أن لا تخالف طريقة وضع هذه الاجهزة القواعد المعمول بها ، الا إذا أثبت المؤجر أن وضع هذه الاجهزة تهدد سلامة العقار . فإذا كان تدخل المؤجر لازما لذلك جاز للمستأجر أن يطلب منه هذا التدخل على أن يتكفل المستأجر برد ما ينفقه المؤجر من مصاريف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_493_19750926_OpEnact_f3aff5cea5> ;
    dzdoc:replacementText "يجوز للمستأجر أن يضع بالعين المؤجرة أجهزة لتوصيل المياه والكهرباء والغاز، والتلفون وما يشبه ذلك على شرط أن لا تخالف طريقة وضع هذه الاجهزة القواعد المعمول بها ، الا إذا أثبت المؤجر أن وضع هذه الاجهزة تهدد سلامة العقار . فإذا كان تدخل المؤجر لازما لذلك جاز للمستأجر أن يطلب منه هذا التدخل على أن يتكفل المستأجر برد ما ينفقه المؤجر من مصاريف ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_493> ;
