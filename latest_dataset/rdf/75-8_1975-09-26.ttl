    dzdoc:position 0 ;
    dzdoc:text "إذا صدر الايجاب في مجلس العقد لشخص حاضر دون تحديد أجل القبول فإن الموجب يتحلل من ايجابه إذا لم يصدر القبول فورا وكذلك إذا صدر الايجاب من شخص إلى آخر بطريق الهاتف أو بأي طريق مماثل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_64_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_64> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أن العقد يتم، ولو لم يصدر القبول فورا، إذا لم يوجد ما يدل على أن الموجب قد عدل عن ايجابه في الفترة ما بين الايجاب والقبول، وكان القبول صدر قبل أن ينفض مجلس العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_650_condition_0_f1f1a915> a dznorm:Condition ;
    dznorm:conditionText "إذا حدد مقدما المبلغ المكفول"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_650> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_650_condition_1_3a896677> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الكفيل في الدين المستقبل لم يعين مدة الكفالة"@ar ;
