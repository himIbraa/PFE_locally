<https://legal.dz/resource/order/1975-09-26/75-58#version_art_979> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمدين في الدين المرهون أن يتمسك تجاه الدائن المرتهن بأوجه الدفع المتعلقة بصحة الحق المضمون بالرهن، وكذلك بأوجه الدفع التي تكون له هو تجاه دائنه الأصلي ، كل ذلك بالقدر الذي يجوز فيه للمدين في حالة الحوالة أن يمسك بهذه الدفوع تجاه المحال إليه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_979_19750926_OpEnact_86dc839349> ;
    dzdoc:replacementText "يجوز للمدين في الدين المرهون أن يتمسك تجاه الدائن المرتهن بأوجه الدفع المتعلقة بصحة الحق المضمون بالرهن، وكذلك بأوجه الدفع التي تكون له هو تجاه دائنه الأصلي ، كل ذلك بالقدر الذي يجوز فيه للمدين في حالة الحوالة أن يمسك بهذه الدفوع تجاه المحال إليه ."@ar ;
