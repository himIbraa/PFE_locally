<https://legal.dz/resource/order/1975-09-26/75-58#version_art_265> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وفي الغير الدائن جزءا من حقه وحل محله فيه ، فلا يضار الدائن بهذا الوفاء، ويكون في استيفاء ما بقي له من حق مقدما على من وفاه، ما لم يوجد اتفاق يقضي بغير ذلك. فإذا حل شخص آخر محل الدائن فيما بقي له من حق رجع من حل أخيرا هو ومن تقدمه في الحلول كل بقدر ما هو مستحق له وتقاسما قسمة الغرماء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_265_19750926_OpEnact_42a5554425> ;
