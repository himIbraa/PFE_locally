<https://legal.dz/resource/order/1975-09-26/75-58#version_art_916> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أراد الحائز تطهير العقار وجب عليه أن يوجه إلى الدائنين المقيدة حقوقهم في مواطنهم المختارة المذكورة في القيد إعلانات تشتمل على البيانات الآتية : خلاصة من سند ملكية الحائز تقتصر على بيان نوع التصرف وتاريخه واسم المالك السابق للعقار مع تعيين هذا المالك تعيينا دقيقا ومحل العقار مع تعيينه وتحديده بالدقة، وإذا كان التصرف بيعا يذكر أيضا الثمن وما عسى أن يوجد من تكاليف تعتبر جزءا من هذا الثمن، تاريخ تسجيل ملكية الحائز ورقم التسجيل، المبلغ الذي يقدره الحائز قيمة للعقار ولو كان التصرف بيعا ويجب ألا يق"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_916_19750926_OpEnact_56d6dfa7da> ;
    dzdoc:replacementText "إذا أراد الحائز تطهير العقار وجب عليه أن يوجه إلى الدائنين المقيدة حقوقهم في مواطنهم المختارة المذكورة في القيد إعلانات تشتمل على البيانات الآتية : خلاصة من سند ملكية الحائز تقتصر على بيان نوع التصرف وتاريخه واسم المالك السابق للعقار مع تعيين هذا المالك تعيينا دقيقا ومحل العقار مع تعيينه وتحديده بالدقة، وإذا كان التصرف بيعا يذكر أيضا الثمن وما عسى أن يوجد من تكاليف تعتبر جزءا من هذا الثمن، تاريخ تسجيل ملكية الحائز ورقم التسجيل، المبلغ الذي يقدره الحائز قيمة للعقار ولو كان التصرف بيعا ويجب ألا يقل هذا المبلغ عن السعر الذي يتخذ أساسا لتقدير الثمن في حالة نزع الملكية، ولا أن يقل في أي حال عن الباقي في ذمة الحائز من ثمن العقار إذا كان التصرف بيعا، وإذا كانت أجزاء العقار مثقلة برهون مختلفة و وجب تقدير قيمة كل جزء على حدة، قائمة بالحقوق التي تم قيدها على العقار قبل تسجيل سند الحائز تشتمل على بيان تاريخ هذه القيود ومقدار هذه الحقوق وأسماء الدائنين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_916> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_916> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_917> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الحائز أن يذكر في نفس الاعلان أنه مستعد أو يوفي الديون المقيدة إلى القدر الذي قوم به العقار . وليس عليه أن يصحب العرض بالمبلغ نقدا بل ينحصر العرض في إظهار استعداده للوفاء بمبلغ واجب الدفع في الحال أيا كان أجل استحقاق الديون المقيدة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_917_19750926_OpEnact_e212eacf08> ;
