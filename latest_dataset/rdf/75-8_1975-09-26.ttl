    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_440> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_440_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_440> ;
    dzdoc:position 0 ;
    dzdoc:text "تنتهي الشركة بانسحاب أحد الشركاء، إذا كانت مدتها غير معينة، على شرط أن يعلن الشريك سلفا عن إرادته في الانسحاب قبل حصوله إلى جميع الشركاء وان لا يكون صادرا عن غش أو في وقت غير لائق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_440_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_440> ;
    dzdoc:position 1 ;
    dzdoc:text "وتنتهي الشركة أيضا بإجماع الشركاء على حلها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_441_obligation_0_e0d93105> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
