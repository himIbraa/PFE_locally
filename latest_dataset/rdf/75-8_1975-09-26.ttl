    dzdoc:text "ينتج التعبير عن الارادة أثره في الوقت الذي يتصل فيه، بعلم من وجه إليه، ويعتبر وصول التعبير قرينة على العلم به ما لم يقم الدليل على عكس ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_620_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_620> ;
    dzdoc:position 0 ;
    dzdoc:text "تنظم القوانين الخاصة عقد التأمين بالاضافة إلى الأحكام التي يتضمنها هذا القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_621_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_621> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون محلا للتأمين كل مصلحة اقتصادية مشروعة تعود على الشخص من دون وقوع خطر"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_622_condition_0_ca05c2da> a dznorm:Condition ;
    dznorm:conditionText "إذا كان ذلك الخرق جناية أو جنحة عمدية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_622> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_622_condition_1_49685096> a dznorm:Condition ;
    dznorm:conditionText "إذا تبين من الظروف أن التأخر كان لعذر مقبول"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_622> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_622_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_622> ;
    dzdoc:position 0 ;
    dzdoc:text "يكون باطلا ما يرد في وثيقة التأمين من الشروط الآتية : الشرط الذي يقضي بسقوط الحق في التعويض بسبب خرق القوانين أو النظم الا إذا كان ذلك الخرق جناية أو جنحة عمدية، الشرط الذي يقضي بسقوط حق المؤمن له بسبب تأخره في إعلان الحادث المؤمن منه إلى السلطات أو تقديم المستند إذا تبين من الظروف أن التأخر كان لعذر مقبول، كل شرط مطبوع لم يبرز بشكل ظاهر وكان متعلقا بحالة من الأحوال التي تؤدي إلى البطلان أو السقوط، شرط التحكيم إذا ورد في الوثيقة بين شروطها العامة المطبوعة لا في صورة اتفاق خاص منفصل عن الشروط العامة، كل شرط تعسفي آخر يتبين أنه لم يكن لمخالفته أثر في وقوع الحادث المؤمن منه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_622_right_0_9613cb6a> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_622> ;
    dznorm:position 0 ;
    dznorm:provisionText "الحق في التعويض"@ar ;
    dznorm:sourceArticle "art_622" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_623_condition_0_606302af> a dznorm:Condition ;
    dznorm:conditionText "بشرط الا يجاوز ذلك قيمة التأمين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_623> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_623_obligation_0_37d5931b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_623_obligation_0_37d5931b_action_d4f5dc0750> ;
