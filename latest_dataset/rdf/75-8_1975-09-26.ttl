    dznorm:provisionText "وجب عليه أن يقوم بالخدمات التي تعهد بها"@ar ;
    dznorm:sourceArticle "art_423" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_423_obligation_1_ba603ac5> a dznorm:Obligation ;
