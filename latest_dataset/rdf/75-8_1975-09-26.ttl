<https://legal.dz/resource/order/1975-09-26/75-58#version_art_691> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المالك الا يتعسف في استعمال حقه إلى حد يضر بملك الجار . وليس للجار أن يرجع على جاره في مضار الجوار المألوفة غير أنه يجوز له أن يطلب إزالة هذه المضار إذا تجاوزت الحد المألوف وعلى القاضي أن يراعي في ذلك العرف وطبيعة العقارات وموقع كل منها بالنسبة إلى الآخرين والغرض الذي خصصت له."@ar ;
