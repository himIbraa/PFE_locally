<https://legal.dz/resource/order/1975-09-26/75-58#art_1000> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_1000" ;
    dzdoc:fullText "المبالغ المستحقة للمقاولين والمهندسين المعماريين الذين عهد إليهم بتشييد أبنية أو منشآت أخرى في إعادة تشييدها أو في ترميمها أو في صيانتها، يكون لها امتياز على هذه المنشآت، ولكن بقدر ما يكون زائدا بسبب هذه الأعمال في قيمة العقار وقت بيعه. ويجب أن يقيد الامتياز ، وتكون مرتبته من وقت القيد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1000> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_1000_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_1000_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1000_19750926_OpEnact_b8bef587e6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_1000_obligation_0_5dde0a28> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "1000" ;
    dzdoc:position 1051 ;
    dzdoc:usesTerm dzterm:contractor_dues,
        dzterm:privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1003> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_1003" ;
    dzdoc:fullText "يسري مفعول هذا الأمر ابتداء من تاريخ 25 جمادى الثانية عام 1395 الموافق 5 يوليو 1975 وينشر في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. وحرر بالجزائر في 20 رمضان عام 1395 الموافق 26 سبتمبر سنة 1975. هواري بومدين"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1003> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_1003_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1003_19750926_OpEnact_19a3c8e65a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "1003" ;
    dzdoc:position 1054 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "يسري قانون الدولة التي ينتمي إليها الزوج وقت انعقاد الزواج على الآثار الشخصية والمالية التي يرتبها عقد الزواج. ويسري على انحلال الزواج والانفصال الجسماني القانون الوطني الذي ينتمي إليه الزوج وقت رفع الدعوى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_12_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_12_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_12_19750926_OpEnact_15b67c7372> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "12" ;
    dzdoc:position 11 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_bis> ;
    dzdoc:eId "art_123_bis" ;
    dzdoc:fullText "( جديدة) يجوز أن يتم التصرف بالإرادة المنفردة للمتصرف ما لم يلزم الغير. ويسري على التصرف بالإرادة المنفردة ما يسري على العقد من الأحكام باستثناء أحكام القبول."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_permission_0_15382783> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_bis_19750926_OpEnact_d388708a57> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 123 مكرر" ;
    dzdoc:position 131 ;
    dzdoc:usesTerm dzterm:contract,
        dzterm:disposition .

<https://legal.dz/resource/order/1975-09-26/75-58#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_2> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "للمتبوع حق الرجوع على تابعه في حالة ارتكابه خطأ جسيما ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_137_right_0_41625dae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_137_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_137_19750926_OpEnact_10e32fe8b1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "137" ;
    dzdoc:position 147 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_137_condition_0_964c8b4a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:product ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_140_bis" ;
    dzdoc:fullText "يكون المنتج مسؤول عن الضرر الناتج عن عيب في منتوجه حتى ولو لم تربطه بالمتضرر علاقة تعاقدية. يعتبر منتوجا كل مال منقول ولو كان متصلا بعقار ، لاسيما المنتوج الزراعي والمنتوج الصناعي وتربية الحيوانات والصناعة الغذائية والصيد البري والبحري والطاقة الكهربائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_defocc_18226a21ac57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis_19750926_OpEnact_104c48b337> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_obligation_0_db498484> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "140 مكرر" ;
    dzdoc:position 151 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "كل من نال عن حسن نية من عمل الغير أو من شيء له منفعة ليس لها ما يبررها يلزم بتعويض من وقع الاثراء على حسابه بقدر ما استفاد من العمل أو الشيء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_141_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_141_19750926_OpEnact_fd2413b192> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_141_obligation_0_8d87af55> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 141" ;
    dzdoc:position 153 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_141_condition_0_4785f700> ;
    dzdoc:usesTerm dzterm:unjust_enrichment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يعتبر الفضولي نائبا عن رب العمل، متى كان قد بذل في إدارته عناية الشخص العادي، ولو لم تتحقق النتيجة المقصودة وفي هذه الحالة يكون رب العمل ملزما بتنفيذ التعهدات التي عقدها الفضولي لحسابه، وبتعويضه عن التعهدات التي التزم بها، وبرد النفقات الضرورية أو النافعة التي سوغتها الظروف، وبتعويضه عن الضرر الذي لحقه بسبب قيامه بالعمل ، ولا يستحق الفضولي أجرا على عمله إلا إذا كان هذا العمل من أعمال مهنته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_157_19750926_OpEnact_213191a1e5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_157_obligation_0_0d9231d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 169 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_157_condition_0_24970088>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_157_condition_1_c5b2e2ce> ;
    dzdoc:usesTerm dzterm:فضولي .

<https://legal.dz/resource/order/1975-09-26/75-58#art_175> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_175" ;
    dzdoc:fullText "إذا تم التنفيذ العيني، أو أصر المدين على رفض التنفيذ حدد القاضي مقدار التعويض الذي يلزم به المدين مراعيا في ذلك الضرر الذي أصاب الدائن والعنت الذي بدأ من المدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_175> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_175_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_175_19750926_OpEnact_9ec2788a42> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_175_obligation_0_fee6cdbd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 175" ;
    dzdoc:position 187 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_175_condition_0_55c603a1> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_177> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_177" ;
    dzdoc:fullText "يجوز للقاضي أن ينقص مقدار التعويض، أو لا يحكم بالتعويض إذا كان الدائن بخطئه قد اشترك في إحداث الضرر أو زاد فيه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_177_permission_0_bf99c998> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_177> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_177_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_177_19750926_OpEnact_f6bb7d149e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "177" ;
    dzdoc:position 189 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_177_condition_0_023e4a07> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_186> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_186" ;
    dzdoc:fullText "إذا كان محل الالتزام بين أفراد مبلغا من النقود عين مقداره وقت رفع الدعوى وتأخر المدين في الوفاء به ، فيجب عليه أن يعوض للدائن الضرر اللاحق من هذا التأخير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_186> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_186_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_186_19750926_OpEnact_990b8a5195> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_186_obligation_0_f8ff4f41> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 186" ;
    dzdoc:position 199 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_186_condition_0_b4860f1d> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_189> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_189" ;
    dzdoc:fullText "لكل دائن ولو لم يحل أجل دينه أن يستعمل باسم مدينه جميع حقوق هذا المدين ، إلا ما كان منها خاصا بشخص أو غير قابل للحجز ولا يكون استعمال الدائن لحقوق مدينه مقبولا إلا إذا أثبت أن المدين أمسك عن استعمال هذه الحقوق، وأن هذا الامساك من شأنه أن يسبب عسره، أو أن يزيد فيه . ولا يجب على الدائن أن يكلف مدينه بمطالبة حقه غير أنه لا بد أن يدخله في الخصام."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_189_right_0_552d955d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_189> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_189_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_189_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_189_19750926_OpEnact_e727fd13cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 189" ;
    dzdoc:position 202 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_189_condition_0_f26f277f> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "إذا ادعى الدائن عسر المدين فليس عليه إلا أن يثبت مقدار ما في ذمته من ديون. و على المدين نفسه أن يثبت أن له مالا يساوي قيمة الديون أو يزيد عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_193_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_193_19750926_OpEnact_b334889b89> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_193_obligation_0_d00cd67a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 193" ;
    dzdoc:position 206 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_193_condition_0_3b9c4ecd> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_198> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_198" ;
    dzdoc:fullText "إذا أبرم عقد صوري فلـ دائني المتعاقدين ولـ لخلف الخاص ، متى كانوا حسنى النية ، أن يتمسكوا بالعقد الصوري ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_198_right_0_76317e6b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_198> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_198_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_198_19750926_OpEnact_fd7401bb49> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 198" ;
    dzdoc:position 211 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_198_condition_0_909e6b78>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_198_condition_1_971e8156> ;
    dzdoc:usesTerm dzterm:creditors,
        dzterm:particular_successor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_205> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_205" ;
    dzdoc:fullText "لا يكون الالتزام قائما إذا علق على شرط واقف يجعل وجود الالتزام متوقفا على محض ارادة الملتزم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_205> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_205_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_205_19750926_OpEnact_166bc8ce50> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "205" ;
    dzdoc:position 218 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_205_condition_0_7978709e> ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_208> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_208" ;
    dzdoc:fullText "إذا تحقق الشرط يرجع أثره إلى اليوم الذي نشأ فيه الالتزام ، الا إذا تبين من ارادة المتعاقدين أو من طبيعة العقد أن وجود الالتزام، أو زواله، انما يكون في الوقت الذي تحقق فيه الشرط. غير أنه لا يكون للشرط أثر رجعي، إذا أصبح تنفيذ الالتزام قبل تحقق الشرط غير ممكن لسبب لا يد للمدين فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_208> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_208_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_208_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_208_19750926_OpEnact_4b00d4d931> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "208" ;
    dzdoc:position 221 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_208_condition_0_ec36cfc9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_208_condition_1_29c8f42c> ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_210> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_210" ;
    dzdoc:fullText "إذا تبين من الالتزام أن المدين لا يقوم بوفائه الا عند المقدرة أو الميسرة ، عين القاضي ميعادا مناسبا لحلول الأجل، مراعيا في ذلك موارد المدين الحالية والمستقبلة مع اشتراط عناية الرجل الحريص على الوفاء بالتزامه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_210> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_210_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_210_19750926_OpEnact_b8d0e78872> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_210_obligation_0_ccae5695> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "210" ;
    dzdoc:position 223 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_210_condition_0_c8cb2b0c> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_216> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_216" ;
    dzdoc:fullText "يكون الالتزام اختياريا إذا لم يشمل محله الا شيئا واحدا ، ولكن تبرأ ذمة المدين إذا أدى بدلا منه شيئا آخر . والشيء الذي يشمله محل الالتزام هو وحده محل الالتزام وهو الذي يعين طبيعته، لا البديل الذي تبرأ ذمة المدين بأدائه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_216_right_0_545d3097> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_216> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_216_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_216_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_216_19750926_OpEnact_c0d538757a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "216" ;
    dzdoc:position 229 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_216_condition_0_41913b12> ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "لا يكون المدين المتضامن مسؤولا في تنفيذ الالتزام الا عن فعله. إذا أعذر الدائن أحد المدينين المتضامنين، أو قاضاه فلا يكون لذلك أثر بالنسبة إلى باقي المدينين، اما إذا أعذر أحد المدينين المتضامنين الدائن فيستفيد باقي المدينين من هذا الاعذار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_231> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_231_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_231_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_231_19750926_OpEnact_c128df4732> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 231" ;
    dzdoc:position 244 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_231_condition_0_2e88211a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_231_condition_1_db5986fd> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_246> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_246" ;
    dzdoc:fullText "إذا رجع المحال له بالضمان على المحيل طبقا للمادتين 244 و 245 فلا يلزم المحيل الا برد ما قبضه بالاضافة إلى المصاريف ولو وجد اتفاق يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_246> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_246_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_246_19750926_OpEnact_7e5045edc1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_246_obligation_0_b71e4bb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 246" ;
    dzdoc:position 259 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_244>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_245> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_244>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_245> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_246_condition_0_5e4e207f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "تبدأ شخصية الإنسان بتمام ولادته حيا وتنتهي بموته. على أن الجنين يتمتع بالحقوق التي يحددها القانون بشرط أن يولد حيا ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_25_right_0_dfb414b1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_25_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_25_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_25_19750926_OpEnact_02f62f6753> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 31 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_25_condition_0_8586c8f0> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_250> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_250" ;
    dzdoc:fullText "إذا حجز ما تحت يد المحال عليه قبل نفاذ الحوالة في حق الغير كانت الحوالة بالنسبة إلى الحاجز بمثابة حجز آخر. وفي هذه الحالة، إذا وقع حجز آخر بعد أن أصبحت الحوالة نافذة في حق الغير ، فإن الدين يقسم بين الحاجز المتقدم والمحال له والحاجز المتأخر قسمة غرماء، على أن يؤخذ من حصة الحاجز المتأخر المبلغ الضروري لتكملة قيمة الحوالة لصالح المحال له."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_250> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_250_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_250_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_250_19750926_OpEnact_e89a6b4c52> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 250" ;
    dzdoc:position 263 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_250_condition_0_336b4512>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_250_condition_1_08ffe695> ;
    dzdoc:usesTerm dzterm:assignment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_252> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_252" ;
    dzdoc:fullText "لا تكون الحوالة نافذة في حق الدائن الا إذا أقرها. وإذا قام المحال عليه أو المدين الأصلي باعلان الحوالة إلى الدائن وعين له أجلا معقولا ليقر الحوالة ثم انقضى الأجل دون صدور الاقرار ، اعتبر سكوت الدائن رفضا للحوالة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_252> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_252_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_252_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_252_19750926_OpEnact_2746476525> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "252" ;
    dzdoc:position 265 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_252_condition_0_f3877e93>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_252_condition_1_8ea04ae8> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_262> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_262" ;
    dzdoc:fullText "يتفق الدائن الذي استوفي حقه من غير المدين مع هذا الغير على أن يحل محله ولو لم يقبل المدين ذلك، و لا يصح أن يتأخر هذا الاتفاق عن وقت الوفاء ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_262_right_0_55f35360> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_262> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_262_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_262_19750926_OpEnact_6440ff990f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_262_obligation_0_611497a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 262" ;
    dzdoc:position 275 ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_265> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_265" ;
    dzdoc:fullText "إذا وفي الغير الدائن جزءا من حقه وحل محله فيه ، فلا يضار الدائن بهذا الوفاء، ويكون في استيفاء ما بقي له من حق مقدما على من وفاه، ما لم يوجد اتفاق يقضي بغير ذلك. فإذا حل شخص آخر محل الدائن فيما بقي له من حق رجع من حل أخيرا هو ومن تقدمه في الحلول كل بقدر ما هو مستحق له وتقاسما قسمة الغرماء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_265> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_265_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_265_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_265_19750926_OpEnact_42a5554425> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 265" ;
    dzdoc:position 278 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_265_condition_0_c8f421e5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_265_condition_1_9ae299b3> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_283> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_283" ;
    dzdoc:fullText "تكون نفقات الوفاء على المدين ، ما لم يوجد اتفاق أو نص يقضي بغير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_283> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_283_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_283_19750926_OpEnact_22d1641305> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_283_obligation_0_9f9a7bda> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 283" ;
    dzdoc:position 296 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_283_condition_0_adbefe40> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_288> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_288" ;
    dzdoc:fullText "لا يتم التجديد الا إذا كان الالتزامان القديم والجديد قد خلا كل منهما من اسباب البطلان. أما إذا كان الالتزام القديم ناشئا عن عقد قابل للبطلان فلا يكون التجديد صحيحا الا إذا فقد الالتزام الجديد اجازة العقد واحلاله محل الالتزام القديم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_288> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_288_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_288_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_288_19750926_OpEnact_e0846f662c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 288" ;
    dzdoc:position 301 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_288_condition_0_c0601c4a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_288_condition_1_49d3f2e9> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_289> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_289" ;
    dzdoc:fullText "لا يفترض التجديد بل يجب الاتفاق عليه صراحة، أو استخلاصه بوضوح من الظروف. وبوجه خاص لا ينتج التجديد من كتابة سند بدين موجود قبل ذلك، ولو مما يحدث في الالتزام من تغييرات لا تتناول الا زمان الوفاء، أو مكانه، أو كيفية الوفاء به، ولا مما يدخل على الالتزام من تعديلات لا تتناول الا التأمينات، ما لم يكن هناك اتفاق يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_289> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_289_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_289_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_289_19750926_OpEnact_19e64c0dae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_289_obligation_0_aa5b26e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 289" ;
    dzdoc:position 302 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_304> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_4> ;
    dzdoc:eId "art_304" ;
    dzdoc:fullText "إذا اجتمع في شخص واحد صفتا الدائن و المدين بالنسبة إلى دين واحد انقضى هذا الدين بالقدر الذي اتحدت فيه الذمة. وإذا زال السبب الذي أدى لاتحاد الذمة وكان لزواله أثر رجعي عاد الدين إلى الوجود بملحقاته بالنسبة إلى المعنيين بالأمر ويعتبر اتحاد الذمة كانه لم يكن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_304> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_304_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_304_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_304_19750926_OpEnact_0a205a2850> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "304" ;
    dzdoc:position 317 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_304_condition_0_85937863>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_304_condition_1_92e307ba> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_320> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_320" ;
    dzdoc:fullText "يترتب على التقادم انقضاء الالتزام ، ولكن يتخلف في ذمة المدين التزام طبيعي و إذا سقط الحق بالتقادم تسقط معه ملحقاته ولو لم تكتمل مدة التقادم الخاصة بهذه الملحقات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_320> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_320_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_320_19750926_OpEnact_0283945f74> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_320_obligation_0_74e465aa>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_320_obligation_1_b91186a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "320" ;
    dzdoc:position 333 ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:limitation_period .

<https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_323_bis_1" ;
    dzdoc:fullText "يعتبر الإثبات بالكتابة في الشكل الإلكتروني كالإثبات بالكتابة على الورق، بشرط إمكانية التأكد من هوية الشخص الذي أصدرها وأن تكون معدة ومحفوظة في ظروف تضمن سلامتها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis_1_19750926_OpEnact_5dc8cedff7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 323 مكرر 1" ;
    dzdoc:position 338 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_1_condition_0_4953febd> ;
    dzdoc:usesTerm dzterm:electronic_proof .

<https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_326_bis_1" ;
    dzdoc:fullText "يعتبر تقييد العقد الوارد في السجلات العمومية الا كبداية للاثبات بالكتابة ويجب لذلك : أن يثبت انه تم فقد جميع أصول الموثق للسنة التي يبدو انه تم تحرير العقد خلالها، أو أن يثبت أن فقدان أصل هذا العقد قد كان نتيجة حادث خاص. أن يكون فهرس قانوني لدى الموثق، يبين فيه أن العقد قد حرر في نفس التاريخ. وعندما يقبل الاثبات بالبينة باقتران هاتين الحالتين يصبح من الضروري الاستماع لمن كان شاهدا على العقد أن كان على قيد الحياة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_1_19750926_OpEnact_e91f91df18> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "326 مكرر 1" ;
    dzdoc:position 349 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_1_condition_0_2b8edbfa> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_328> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_328" ;
    dzdoc:fullText "لا يكون العقد العرفي حجة على الغير في تاريخه إلا منذ أن يكون له تاريخ ثابت، ويكون تاريخ العقد ثابتا ابتداء : من يوم تسجيله، من يوم ثبوت مضمونه في عقد آخر حرره موظف عام، من يوم التأشير عليه على يد ضابط عام مختص، من يوم وفاة أحد الذين لهم على العقد خط و امضاء. غير أنه يجوز للقاضي تبعا للظروف، رفض تطبيق هذه الأحكام فيما يتعلق بالمخالصة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_328_permission_0_ce7716ab> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_328> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_328_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_328_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_328_19750926_OpEnact_3c5ad6ef72> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "328" ;
    dzdoc:position 352 ;
    dzdoc:usesTerm dzterm:private_act .

<https://legal.dz/resource/order/1975-09-26/75-58#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:collateral_kinship,
        dzterm:direct_kinship ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "القرابة المباشرة هي الصلة ما بين الأصول والفروع . وقرابة الحواشي هي الرابطة ما بين أشخاص يجمعهم أصل واحد دون أن يكون أحدهم فرعا للآخر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_33> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_33_defocc_313896c1c73a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_33_defocc_fd384e2d5a02> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_33_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_33_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_33_19750926_OpEnact_45c519188d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 39 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_342> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_4> ;
    dzdoc:eId "art_342" ;
    dzdoc:fullText "الاقرار حجة قاطعة على المقر. ولا يتجزأ الاقرار على صاحبه الا إذا قام على وقائع متعددة وكان وجود واقعة منها لا يستلزم حتما وجود الوقائع الأخرى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_342> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_342_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_342_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_342_19750926_OpEnact_a59bcf19d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "342" ;
    dzdoc:position 366 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_342_condition_0_adccc686> ;
    dzdoc:usesTerm dzterm:الاقرار .

<https://legal.dz/resource/order/1975-09-26/75-58#art_357> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_357" ;
    dzdoc:fullText "إذا لم يحدد المتعاقدان ثمن البيع ، فلا يترتب على ذلك بطلان البيع متى تبين من أن المتعاقدين قد نويا الاعتماد على السعر المتداول في التجارة، أو السعر الذي جرى عليه التعامل بينهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_357> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_357_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_357_19750926_OpEnact_6f93880288> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 357" ;
    dzdoc:position 381 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_357_condition_0_9abca991>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_357_condition_1_ce975cac> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_364> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_364" ;
    dzdoc:fullText "يلتزم البائع بتسليم الشيء المبيع للمشتري في الحالة التي كان عليها وقت البيع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_364> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_364_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_364_19750926_OpEnact_25b4d415fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_364_obligation_0_d3006bb4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 364" ;
    dzdoc:position 388 ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_394> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_394" ;
    dzdoc:fullText "إذا لم يعين الاتفاق أو العرف مكانا أو زمانا لتسلم المبيع وجب على المشتري أن يتسلمه في المكان الذي يوجد فيه المبيع وقت البيع وان يتسلمه دون تأخير باستثناء الوقت الذي تتطلبه عملية التسلم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_394> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_394_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_394_19750926_OpEnact_17fda9d94c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_394_obligation_0_996b1081> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 394" ;
    dzdoc:position 418 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_394_condition_0_57845cd6> ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_396> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_396" ;
    dzdoc:fullText "يكون البيع باطلا إذا احتفظ البائع يوم البيع بحق استرداد الشيء المبيع في أجل معين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_396> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_396_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_396_19750926_OpEnact_653c0b196d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_396_obligation_0_a481d1df> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 396" ;
    dzdoc:position 420 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_396_condition_0_c0ece886> ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_397> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_397" ;
    dzdoc:fullText "إذا باع شخص شيئا معينا بالذات وهو لا يملكه فللمشتري الحق في طلب إبطال البيع ويكون الأمر كذلك ولو وقع البيع على عقار أعلن أو لم يعلن ببيعه. وفي كل حالة لا يكون هذا البيع ناجزا في حق مالك الشيء المبيع ولو أجازه المشتري."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_397_right_0_c91ebf08> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_397> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_397_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_397_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_397_19750926_OpEnact_738fffe3bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 397" ;
    dzdoc:position 421 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_397_condition_0_6b26b422> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_398> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_398" ;
    dzdoc:fullText "إذا أقر المالك البيع سرى مفعوله عليه وصار ناجزا في حق المشتري. وكذلك يعتبر البيع صحيحا في حق المشتري إذا أكتسب البائع ملكية المبيع بعد انعقاد البيع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_398> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_398_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_398_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_398_19750926_OpEnact_6ede28f9d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 398" ;
    dzdoc:position 422 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_398_condition_0_797850cd>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_398_condition_1_50b2b7db> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "تطبق القوانين في تراب الجمهورية الجزائرية الديمقراطية الشعبية ابتداء من يوم نشرها في الجريدة الرسمية . تكون نافذة المفعول بالجزائر العاصمة بعد مضي يوم كامل من تاريخ نشرها وفي النواحي الأخرى في نطاق كل دائرة بعد مضي يوم كامل من تاريخ وصول الجريدة الرسمية إلى مقر الدائرة ويشهد على ذلك تاريخ ختم الدائرة الموضوع على الجريدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_4_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_4_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_4_19750926_OpEnact_d520051425> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_4_obligation_0_a57034e6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_4_obligation_1_9df0c1a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_429> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_2> ;
    dzdoc:eId "art_429" ;
    dzdoc:fullText "كلما وجب أن يؤخذ القرار بالاغلبية تعين الاخذ بالاغلبية العددية على حسب الافراد ما لم يوجد نص يخالف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_429> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_429_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_429_19750926_OpEnact_b84ddea21a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_429_obligation_0_73a46e97> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "429" ;
    dzdoc:position 453 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_429_condition_0_f73d1e59> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_438> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_4> ;
    dzdoc:eId "art_438" ;
    dzdoc:fullText "تنتهي الشركة بهلاك جميع مالها أو جزء كبير منه بحيث لا تبقى فائدة في استمرارها. وإذا كان أحد الشركاء قد تعهد بأن يقدم حصته شيئا معينا بالذات وهلك هذا الشيء قبل تقديمه أصبحت الشركة منحلة في حق جميع الشركاء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_438> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_438_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_438_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_438_19750926_OpEnact_354de4d73c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_438_obligation_0_c7acee91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "438" ;
    dzdoc:position 462 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_438_condition_0_e8bf3874> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-58#art_466> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_5_subsec_3> ;
    dzdoc:eId "art_466" ;
    dzdoc:fullText "الصلح لا يتجزأ فبطلان جزء منه يقتضي بطلان العقد كله. على أن هذا الحكم لا يسري إذا تبين من عبارات العقد أو من قرائن الأحوال أن المتعاقدين قد اتفقا على أن أجزاء العقد مستقلة بعضها عن بعض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_466> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_466_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_466_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_466_19750926_OpEnact_81499c1846> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 466" ;
    dzdoc:position 490 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_466_condition_0_d713c626> ;
    dzdoc:usesTerm dzterm:settlement .

<https://legal.dz/resource/order/1975-09-26/75-58#art_477> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_477" ;
    dzdoc:fullText "إذا سلمت العين المؤجرة في حالة لا تكون فيها صالحة للاستعمال الذي أجرت من أجله أو طرأ على هذا الاستعمال نقص معتبر ، جاز للمستأجر أن يطلب فسخ الإيجار أو إنقاص بدل الإيجار بقدر ما نقص من الاستعمال مع التعويض عن الضرر في الحالتين إذا اقتضى الأمر ذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_477_right_0_08156e52> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_477> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_477_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_477_19750926_OpEnact_2c99be8dd5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 477" ;
    dzdoc:position 507 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_477_condition_0_b8c88716> ;
    dzdoc:usesTerm dzterm:leased_property,
        dzterm:lessee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_497> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_497" ;
    dzdoc:fullText "يجب على المستأجر أن يخبر ، فورا ، المؤجر بكل أمر يستوجب تدخله كأن تحتاج العين المؤجرة إلى ترميمات مستعجلة أو يظهر عيب فيها أو يقع اغتصاب عليها، أو يتعدى الغير بالتعرض، أو الإضرار بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_497> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_497_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_497_19750926_OpEnact_13927c308b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_497_obligation_0_995c140a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 497" ;
    dzdoc:position 527 ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_507_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_507_bis" ;
    dzdoc:fullText "تبقى الإيجارات المبرمة في ظل التشريع السابق خاضعة له مدة عشر (10) سنوات، ابتداء من تاريخ نشر هذا القانون في الجريدة الرسمية. غير أن الأشخاص الطبيعيين البالغين ستين (60) سنة كاملة عند نشر هذا القانون والذين لهم الحق في البقاء في الأمكنة المعدة للسكن وفقا للتشريع السابق، يبقون يتمتعون بهذا الحق إلى حين وفاتهم. لا يستفيد من هذا الحق الورثة ولا الأشخاص الذين يعيشون معهم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_507_bis_right_0_335f3b02> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_507_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_507_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_507_bis_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_507_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_507_bis_19750926_OpEnact_1bfea6d641> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 507 مكرر" ;
    dzdoc:position 538 ;
    dzdoc:usesTerm dzterm:lease .

<https://legal.dz/resource/order/1975-09-26/75-58#art_539> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_1> ;
    dzdoc:eId "art_539" ;
    dzdoc:fullText "يلتزم المعير أن يسلم المستعير الشيء المعار بالحالة التي يكون عليها وقت انعقاد العارية وأن يتركه للمستعير طول مدة العارية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_539> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_539_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_539_19750926_OpEnact_45bf8af6a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_539_obligation_0_10a5743b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 539" ;
    dzdoc:position 566 ;
    dzdoc:usesTerm dzterm:bailee,
        dzterm:bailor,
        dzterm:loan_for_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_555> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_555" ;
    dzdoc:fullText "إذا اقتصر المهندس المعماري على وضع التصميم دون أن يكلف بالرقابة على التنفيذ لم يكن مسؤولا إلا عن العيوب التي أتت من التصميم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_555> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_555_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_555_19750926_OpEnact_ec8e38320c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "555" ;
    dzdoc:position 582 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_555_condition_0_2ce2dbbb> ;
    dzdoc:usesTerm dzterm:architect .

<https://legal.dz/resource/order/1975-09-26/75-58#art_572> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_1> ;
    dzdoc:eId "art_572" ;
    dzdoc:fullText "يجب أن يتوفر في الوكالة الشكل الواجب توفره في العمل القانوني الذي يكون محل الوكالة ما لم يوجد نص يقضي بخلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_572> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_572_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_572_19750926_OpEnact_aad49a2808> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_572_obligation_0_b8b6cb04> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "572" ;
    dzdoc:position 609 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_572_condition_0_82c9f422> ;
    dzdoc:usesTerm dzterm:agency .

<https://legal.dz/resource/order/1975-09-26/75-58#art_576> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_576" ;
    dzdoc:fullText "يجب دائما على الوكيل أن يبذل في تنفيذه للوكالة عناية الرجل العادي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_576> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_576_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_576_19750926_OpEnact_4dc2d092f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_576_obligation_0_2b5caa83> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 576" ;
    dzdoc:position 613 ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent .

<https://legal.dz/resource/order/1975-09-26/75-58#art_577> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_577" ;
    dzdoc:fullText "على الوكيل أن يوافي الموكل بالمعلومات الضرورية عما وصل إليه في تنفيذ الوكالة و أن يقدم له حسابا عنها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_577> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_577_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_577_19750926_OpEnact_314bc32297> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_577_obligation_0_a5612997>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_577_obligation_1_eb83395e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 577" ;
    dzdoc:position 614 ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:العقد_بعوض ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "العقد بعوض هو الذي يلزم كل واحد من الطرفين إعطاء، أو فعل شيء ما . 1 - الرضاء"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_58> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_58_defocc_f883f71fe3a9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_58_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_58_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_58_19750926_OpEnact_9a7989f698> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_58_obligation_0_0a14f890> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "58" ;
    dzdoc:position 64 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_581> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_581" ;
    dzdoc:fullText "الوكالة تبرعية ما لم يتفق على غير ذلك صراحة أو يستخلص ضمنيا من حالة الوكيل . فإذا اتفق على أجر للوكالة كان هذا الأجر خاضعا لتقدير القاضي الا إذا دفع طوعا بعد تنفيذ الوكالة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_581> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_581_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_581_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_581_19750926_OpEnact_c211cc2169> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 581" ;
    dzdoc:position 618 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_581_condition_0_045cea9a> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent .

<https://legal.dz/resource/order/1975-09-26/75-58#art_584> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_584" ;
    dzdoc:fullText "إذا وكل أشخاص متعددون وكيلا واحدا في عمل مشترك كان جميع الموكلين متضامنين تجاه الوكيل في تنفيذ الوكالة ما لم يتفق على غير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_584> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_584_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_584_19750926_OpEnact_b0013a19c1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_584_obligation_0_b1fbf452> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 584" ;
    dzdoc:position 621 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_584_condition_0_b3102813> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent .

<https://legal.dz/resource/order/1975-09-26/75-58#art_590> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:deposit_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3> ;
    dzdoc:eId "art_590" ;
    dzdoc:fullText "الوديعة عقد يسلم بمقتضاه المودع شيئا منقولا إلى المودع لديه على أن يحافظ عليه لمدة وعلى أن يرده عينا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_590> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_590_defocc_a53354fb05b3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_590_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_590_19750926_OpEnact_c44568d4c8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_590_obligation_0_f72b75d1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_590_obligation_1_f0de0183> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 590" ;
    dzdoc:position 627 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_597> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_2> ;
    dzdoc:eId "art_597" ;
    dzdoc:fullText "على المودع أن يرد إلى المودع لديه ما أنفقه في حفظ الشيء و عليه أن يعوضه عن كل ما لحقه من خسارة بسبب الوديعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_597> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_597_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_597_19750926_OpEnact_28ff6b36c2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_597_obligation_0_06122836>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_597_obligation_1_0059445b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 597" ;
    dzdoc:position 634 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "التعبير عن الارادة يكون باللفظ وبالكتابة، أو بالاشارة المتداولة عرفا كما يكون باتخاذ موقف لا يدع أي شك في دلالته على مقصود صاحبه. ويجوز أن يكون التعبير عن الارادة ضمنيا إذا لم ينص القانون أو يتفق الطرفان على أن يكون صريحا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_60_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_60_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_60_19750926_OpEnact_4b6faa11d1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 66 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_60_condition_0_c024d8c7> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_602> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:حراسة_اتفاقية ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_602" ;
    dzdoc:fullText "الحراسة الاتفاقية هو إيداع شيء متنازع فيه من طرف شخص أو عدة أشخاص بين أيدي شخص آخر يلتزم بإعادته بعد فض المنازعة إلى الشخص الذي يثبت له الحق فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_602> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_602_defocc_deb761953f40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_602_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_602_19750926_OpEnact_67da150464> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "602" ;
    dzdoc:position 639 ;
    dzdoc:usesTerm dzterm:حراسة_اتفاقية .

<https://legal.dz/resource/order/1975-09-26/75-58#art_604> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_604" ;
    dzdoc:fullText "تجوز الحراسة القضائية على الأموال المشتركة في حالة شغور الادارة أو قيام نزاع بين الشركاء، إذا تبين أن الحراسة هي الوسيلة الضرورية لحفظ حقوق ذوي الشأن . تنتهي الحراسة في هذه الأحوال إذا عين مسؤول إداري بصفة مؤقتة أو نهائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_604> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_604_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_604_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_604_19750926_OpEnact_4b2a591250> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "604" ;
    dzdoc:position 641 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_604_condition_0_977aff59>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_604_condition_1_7dbbb390> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "إذا مات من صدر منه التعبير عن الارادة أو فقد أهليته قبل أن ينتج التعبير أثره ، فإن ذلك لا يمنع من ترتب هذا الأثر عند اتصال التعبير بعلم من وجه اليه، هذا ما لم يتبين العكس من التعبير أو من طبيعة التعامل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_62_19750926_OpEnact_921a7e563b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_62_prohibition_0_7e7f95f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 68 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_62_condition_0_41e0c65c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_622> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_3_subsec_1> ;
    dzdoc:eId "art_622" ;
    dzdoc:fullText "يكون باطلا ما يرد في وثيقة التأمين من الشروط الآتية : الشرط الذي يقضي بسقوط الحق في التعويض بسبب خرق القوانين أو النظم الا إذا كان ذلك الخرق جناية أو جنحة عمدية ، الشرط الذي يقضي بسقوط حق المؤمن له بسبب تأخره في إعلان الحادث المؤمن منه إلى السلطات أو تقديم المستند إذا تبين من الظروف أن التأخر كان لعذر مقبول ، كل شرط مطبوع لم يبرز بشكل ظاهر وكان متعلقا بحالة من الأحوال التي تؤدي إلى البطلان أو السقوط، شرط التحكيم إذا ورد في الوثيقة بين شروطها العامة المطبوعة لا في صورة اتفاق خاص منفصل عن الشروط العامة، كل شرط تعسفي آخر يتبين أنه لم يكن لمخالفته أثر في وقوع الحادث المؤمن منه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_622_right_0_9613cb6a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_622> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_622_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_622_19750926_OpEnact_8fefa6cbd5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "622" ;
    dzdoc:position 659 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_622_condition_0_ca05c2da>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_622_condition_1_49685096> ;
    dzdoc:usesTerm dzterm:insurance_policy,
        dzterm:insured .

<https://legal.dz/resource/order/1975-09-26/75-58#art_652> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_652" ;
    dzdoc:fullText "لا تجوز الكفالة في مبلغ أكبر مما هو مستحق على المدين ولا بشرط أشد من شروط الدين المكفول . ولكن تجوز الكفالة في مبلغ أقل وبشرط أهون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_652> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_652_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_652_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_652_19750926_OpEnact_f2ff4f49c1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_652_obligation_0_e452dce5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "652" ;
    dzdoc:position 689 ;
    dzdoc:usesTerm dzterm:كفالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_658> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_658" ;
    dzdoc:fullText "إذا أفلس المدين وجب على الدائن أن يتقدم بدينه في التفليسة ، والا سقط حقه في الرجوع على الكفيل بقدر ما أصاب هذا الأخير من ضرر سبب إهمال الدائن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_658> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_658_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_658_19750926_OpEnact_07de411c01> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_658_obligation_0_c46c89b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 658" ;
    dzdoc:position 695 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_658_condition_0_f54ff03e> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_671> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_2> ;
    dzdoc:eId "art_671" ;
    dzdoc:fullText "إذا وفي الكفيل الدين ، كان له أن يحل محل الدائن في جميع ما له من حقوق تجاه المدين . ولكن إذا لم يوف الا بعض الدين ، فلا يرجع بما وفاه الا بعد أن يستوفي الدائن كل حقه من المدين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_671_right_0_fb0fdc44> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_671> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_671_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_671_19750926_OpEnact_1ddb2c07ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "671" ;
    dzdoc:position 708 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_671_condition_0_f0f9abbb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_671_condition_1_a7cd444a> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_673> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_2> ;
    dzdoc:eId "art_673" ;
    dzdoc:fullText "إذا تعدد المدينون في دين واحد وكانوا متضامنين فللكفيل الذي ضمنهم جميعا أن يرجع على أي منهم بجميع ما وفاه من الدين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_673_right_0_2682514a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_673> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_673_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_673_19750926_OpEnact_12f753a45f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "673" ;
    dzdoc:position 710 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_673_condition_0_8f9be3b0> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_681_bis_1" ;
    dzdoc:fullText "في حالة وجود حيازة من طرف المستفيد من الاستيلاء ، يكون هذا الاستيلاء مسبوقا بجرد . وبنفس الطريقة يترتب عن استعادة الحيازة من طرف المستفيد إعداد جرد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_1_19750926_OpEnact_c7ada99335> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_obligation_0_7f3aefac> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 681 مكرر 1" ;
    dzdoc:position 719 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_condition_0_75c0fe5f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_681_bis_3" ;
    dzdoc:fullText "يعد تعسفيا كل استيلاء تم خارج نطاق الحالات والشروط المحددة قانونا وأحكام المادة 679 وما يليها أعلاه ، ويمكن أن يترتب عليه، زيادة على العقوبات الأخرى المنصوص عليها في التشريع المعمول به دفع تعويض يصدر عن طريق القضاء . يتعلق هذا التعويض بإصلاح الضرر المتسبب ومكافأة العمل والرأسمال وكذا بتعويض كل نقص في الربح."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3_right_0_769b6eb3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_3_19750926_OpEnact_1c3865818d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3_obligation_0_2ee50704> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "681 مكرر 3" ;
    dzdoc:position 721 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_679> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_679> ;
    dzdoc:usesTerm dzterm:compensation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_688> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:state_property ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_688" ;
    dzdoc:fullText "تعتبر أموالا للدولة العقارات والمنقولات التي تخصص بالفعل أو بمقتضى نص قانوني لمصلحة عامة، أو لادارة، أو لمؤسسة عمومية أو لهيئة لها طابع إداري، أو لمؤسسة اشتراكية، أو لوحدة مسيرة ذاتيا أو لتعاونية داخلة في نطاق الثورة الزراعية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_688> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_688_defocc_83300e30f944> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_688_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_688_19750926_OpEnact_b4d43e169f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "688" ;
    dzdoc:position 728 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_697> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_697" ;
    dzdoc:fullText "إذا كانت الأرض المحصورة ناتجة عن تجزئة عقار، بسبب بيع أو مبادلة، أو قسمة، أو من أي معاملة أخرى فلا يطلب حق المرور الا على الأراضي التي تشملها تلك المعاملات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_697> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_697_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_697_19750926_OpEnact_4326bb8fb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "697" ;
    dzdoc:position 737 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_697_condition_0_7896c7f7> ;
    dzdoc:usesTerm dzterm:right_of_way .

<https://legal.dz/resource/order/1975-09-26/75-58#art_703> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_703" ;
    dzdoc:fullText "لكل مالك أن يجبر جاره على وضع حدود لأملاكهما المتلاصقة ، و تكون نفقات التحديد مشتركة بينهما ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_703_right_0_62ee0f76> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_703> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_703_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_703_19750926_OpEnact_8a9a8b8339> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_703_obligation_0_2c062422> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 703" ;
    dzdoc:position 743 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_712> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_712" ;
    dzdoc:fullText "يجب أن تنشأ المصانع، والآبار، والآلات البخارية وجميع المؤسسات المضرة بالجيران على المسافات المبينة في اللوائح وبالشروط التي تفرضها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_712> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_712_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_712_19750926_OpEnact_00d0451942> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_712_obligation_0_0dc94552> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "712" ;
    dzdoc:position 752 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_719> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_719" ;
    dzdoc:fullText "يتحمل جميع الشركاء، كل بقدر حصته نفقات إدارة المال الشائع، وحفظه، والضرائب المفروضة عليه، وسائر التكاليف الناتجة عن الشيوع أو المقررة على المال ، كل ذلك ما لم يوجد نص يقضي بغير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_719> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_719_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_719_19750926_OpEnact_eb320aebe9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_719_obligation_0_e877d8a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 719" ;
    dzdoc:position 759 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_719_condition_0_08da5154> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "إذا تم العقد بطريق النيابة ، كان شخص النائب لا شخص الأصيل هو محل الاعتبار عند النظر في عيوب الرضاء، أو في أثر العلم ببعض الظروف الخاصة، أو افتراض العلم بها حتما. غير أنه إذا كان النائب وكيلا ويتصرف وفقا لتعليمات معينة صادرة من موكله ، فليس للموكل أن يتمسك بجهل النائب لظروف كان يعلمها هو ، أو كان من المفروض حتما أن يعلمها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_73_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_73_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_73_19750926_OpEnact_25ee0ca425> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "73" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_73_condition_0_1f64a78a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_73_condition_1_6447012f> ;
    dzdoc:usesTerm dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "إذا ابرم النائب في حدود نيابته عقدا باسم الأصيل فإن ما ينشأ عن هذا العقد من حقوق، والتزامات يضاف إلى الأصيل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_74_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_74_19750926_OpEnact_6fcf901efa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "74" ;
    dzdoc:position 81 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_74_condition_0_06984950> ;
    dzdoc:usesTerm dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_750_bis_2" ;
    dzdoc:fullText "في حالة ما إذا كان الشريك في الملكية أو الشاغل لهيئة أو مصلحة عمومية أو مجموعة محلية ولم يدفع التكاليف المستحقة بعد الانذار بالتنفيذ ، يتم تحصيل هذه التكاليف عن طريق الخصم التلقائي من الاعتمادات المقررة لهذا الغرض، وذلك على يد المحاسب العمومي بناء على إحالة من المتصرف الذي يتعين عليه تقديم جميع الاثباتات، لا سيما منها الفاتورات وقرارات الجمعية وكل مستند آخر . يتم الخصم في أجل شهر بعد الاحالة على المحاسب المختص."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_2_19750926_OpEnact_4e784be7b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_2_obligation_0_b9a91ab7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 750 مكرر 2" ;
    dzdoc:position 793 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_2_condition_0_0123f2a6> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_756> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_756" ;
    dzdoc:fullText "تضمن جميع الديون المستحقة للجمعية على كل شريك في الملكية برهن قانوني على قسمته وتستفيد هذه الديون بالاضافة إلى ذلك من الامتيازات الخاصة بمؤجر العقار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_756_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_19750926_OpEnact_6a0f4c2b9e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_756_obligation_0_55f16cc4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 756" ;
    dzdoc:position 799 ;
    dzdoc:usesTerm dzterm:association,
        dzterm:partner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_756_bis" ;
    dzdoc:fullText "للشركاء الحق في طلب التعويض إذا حصل لهم ضرر بسبب القيام بالبناءات سواء كان القيام بهذه الأعمال قد أدى إلى نقصان من قيمة أملاكهم أو أدت هذه الأعمال إلى منعهم من الانتفاع بأملاكهم منعا بليغا ولو مؤقتا أو حصل لهم من جراء هذه الأعمال إصابات فيما يملكون . وهذا التعويض يترتب على جميع الشركاء في الملكية و يوزع بقدر حقوق كل واحد في الأجزاء المشتركة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_right_0_d80f64fc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_19750926_OpEnact_3c7c3761aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 756 مكرر" ;
    dzdoc:position 800 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_condition_0_bb26497c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:association ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_756_bis_2" ;
    dzdoc:fullText "تشكل جماعة الشركاء في الملكية أو الشاغلين لها جمعية تتمتع بالشخصية المدنية . تتولى الجمعية إدارة العقار والمحافظة عليه وكذا تسيير الأجزاء المشتركة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_2> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_2_defocc_e8708707dad1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_756_bis_2_19750926_OpEnact_0ee2cf6a73> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_756_bis_2_obligation_0_0c0fa176> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 756 مكرر 2" ;
    dzdoc:position 802 ;
    dzdoc:usesTerm dzterm:association .

<https://legal.dz/resource/order/1975-09-26/75-58#art_763_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_763_bis" ;
    dzdoc:fullText "تعين الجمعية في مستهل كل اجتماع لها رئيسا للجلسة عن طريق التصويت برفع اليد ، وإن تعذر ذلك ، يعين تلقائيا الشريك في الملكية أو الشاغل، لها، الأكبر سنا. يقوم المتصرف بدور كاتب الجلسة، غير أنه لا يسوغ للمتصرف أو زوجه ولو كانا مالكين أن يرأسا الجلسة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_763_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_763_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_763_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_763_bis_19750926_OpEnact_28b576feac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_763_bis_obligation_0_a8f1c1b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 763 مكرر" ;
    dzdoc:position 811 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_763_bis_condition_0_6caa2291> ;
    dzdoc:usesTerm dzterm:administrator,
        dzterm:association .

<https://legal.dz/resource/order/1975-09-26/75-58#art_788> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_788" ;
    dzdoc:fullText "إذا كان مالك الأرض وهو يقيم بناء بها قد تعدى بحسن نية على جزء من الأرض الملاصقة جاز للمحكمة إذا رأت محلا لذلك أن تجبر صاحب الأرض الملاصقة على أن يتنازل لجاره عن ملكية الجزء المشغول بالبناء مقابل تعويض عادل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_788> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_788_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_788_19750926_OpEnact_5f13573c46> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 788" ;
    dzdoc:position 839 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_788_condition_0_1216a809>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_788_condition_1_ac23246e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_795> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_795" ;
    dzdoc:fullText "يثبت حق الشفعة وذلك مع مراعاة الأحكام التي ينص عليها الأمر المتعلق بالثورة الزراعية : لمالك الرقبة إذا بيع الكل أو البعض من حق الانتفاع المناسب للرقبة، للشريك في الشيوع إذا بيع جزء من العقار المشاع إلى أجنبي، لصاحب حق الانتفاع إذا بيعت الرقبة كلها أو بعضها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_795_right_0_11d1ea9c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_795> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_795_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_795_19750926_OpEnact_6e12796ec6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 795" ;
    dzdoc:position 846 ;
    dzdoc:referencesExternal <https://legal.dz/resource/order/1975-09-26/75-58#art_795_extref_93812849> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_797> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_797" ;
    dzdoc:fullText "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801 فلا يجوز الأخذ بالشفعة الا من المشتري الثاني وحسب الشروط التي اشترى بها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_797_permission_0_842a33b9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_797> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_797_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_797_19750926_OpEnact_e207e0e647> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 797" ;
    dzdoc:position 848 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_797_condition_0_1675f1db> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "إذا كان الشخص أصم أبكم، أو أعمى أصم، أو أعمى أبكم، وتعذر عليه بسبب تلك العاهة التعبير عن إرادته ، جاز للمحكمة أن تعين له مساعدا قضائيا يعاونه في التصرفات التي تقتضيها مصلحته . ويكون قابلا للإبطال كل تصرف عين من أجله مساعد قضائي إذا صدر من الشخص الذي تقررت مساعدته بدون حضور المساعد بعد تسجيل قرار المساعدة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_80_right_0_205fcfac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_80_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_80_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_80_19750926_OpEnact_1f1616b6e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "80" ;
    dzdoc:position 87 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_80_condition_0_9651fe45> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_800> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_800" ;
    dzdoc:fullText "يجب أن يشتمل الانذار المنصوص عليه في المادة 799 على البيانات التالية والا كان باطلا : بيان العقار الجائز أخذه بالشفعة بيانا كافيا، بيان الثمن والمصاريف الرسمية وشروط البيع واسم كل من البائع والمشتري ولقبه ومهنته وموطنه والأجل الذي قدره ثلاثون (30) يوما للإعلان المنصوص عليه في المادة 799 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_800> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_800_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_800_19750926_OpEnact_fc37b77ae2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_800_obligation_0_cdb019fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 800" ;
    dzdoc:position 851 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_799> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_799> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_811> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_811" ;
    dzdoc:fullText "تنتقل الحيازة من الحائز إلى غيره إذا اتفقا على ذلك وكان في استطاعة من انتقلت إليه الحيازة أن يسيطر على الحق ولو دون تسلم مادي للشيء موضوع هذا الحق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_811> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_811_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_811_19750926_OpEnact_501e931209> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 811" ;
    dzdoc:position 862 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_811_condition_0_3265e224> ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_820> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_820" ;
    dzdoc:fullText "من حاز عقارا واستمر حائزا له مدة سنة كاملة ثم وقع له تعرض في حيازته جاز له أن يرفع خلال السنة دعوى بمنع التعرض ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_820_right_0_f8ed09b8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_820> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_820_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_820_19750926_OpEnact_e17746de76> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "820" ;
    dzdoc:position 871 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_820_condition_0_9fdbff34> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_842> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_842" ;
    dzdoc:fullText "إذا كان الحائز حسن النية وانتفع بالشيء وفقا لما يحسبه من حقه فلا يكون مسؤولا تجاه من هو ملزم برد الشيء إليه عن أي تعويض بسبب هذا الانتفاع. ولا يكون الحائز مسؤولا عما يصيب الشيء من هلاك أو تلف الا بقدر ما عاد عليه من فائدة ترتبت عن هذا الهلاك أو التلف"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_842> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_842_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_842_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_842_19750926_OpEnact_c74df7f5ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "842" ;
    dzdoc:position 893 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_842_condition_0_96fa78fa>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_842_condition_1_7b59535d> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_843> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_843" ;
    dzdoc:fullText "إذا كان الحائز سيئ النية فإنه يكون مسؤولا عن هلاك الشيء أو تلفه ولو كان ذلك ناشئا عن حادث مفاجئ الا إذا ثبت أن الشيء كان يهلك أو يتلف ولو بقي في يد من يستحقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_843> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_843_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_843_19750926_OpEnact_303e7c3f57> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_843_obligation_0_0005ebf3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "843" ;
    dzdoc:position 894 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_843_condition_0_9fa5a476>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_843_condition_1_8d3f0942> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_852> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_852" ;
    dzdoc:fullText "ينتهي حق الانتفاع بانقضاء الأجل المعين، فإن لم يعين أجل عد مقرر ا لحياة المنتفع، وهو ينتهي على أي حال بموت المنتفع حتى قبل انقضاء الأجل المعين، وإذا كانت الأرض المنتفع بها مشغولة عند انقضاء الأجل أو عند موت المنتفع بزرع قائم أبقيت للمنتفع أو لورثته إلى حين إدراك الزرع بشرط أن يدفعوا أجرة إيجار الأرض عن هذه الفترة من الزمن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_852> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_852_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_852_19750926_OpEnact_b81ae4622f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 852" ;
    dzdoc:position 903 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_852_condition_0_6c48539a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_852_condition_1_394261f6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_852_condition_2_602fc447> ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_853> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_853" ;
    dzdoc:fullText "ينتهي حق الانتفاع بهلاك الشيء الا أنه ينتقل من شيء الهالك إلى ما قد يقابل قيمته، و إذا لم يكن الهلاك راجعا إلى خطأ المالك فلا يجبر المالك على إعادة الشيء إلى أصله ولكنه إذا أعاده رجع حق الانتفاع إلى المنتفع إذا لم يكن الهلاك بسببه وفي هذه الحالة تطبق الفقرة الثانية من المادة 848 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_853> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_853_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_853_19750926_OpEnact_1f5962131b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 853" ;
    dzdoc:position 904 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_848> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_848> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_853_condition_0_608c0f8c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_853_condition_1_deaa396a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_853_condition_2_a92bc313> ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_883> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_883" ;
    dzdoc:fullText "لا ينعقد الرهن إلا بعقد رسمي أو حكم أو بمقتضى القانون . وتكون مصاريف العقد على الراهن إلا إذا اتفق على غير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_883> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_883_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_883_19750926_OpEnact_9c4e4074bd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_883_obligation_0_ccf405a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 883" ;
    dzdoc:position 934 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_883_condition_0_29f7e3f0> ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_906> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_906" ;
    dzdoc:fullText "تكون مصاريف القيد وتجديده وشطبه على الراهن ما لم يتفق على غير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_906> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_906_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_906_19750926_OpEnact_0008357ad6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_906_obligation_0_47574776> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 906" ;
    dzdoc:position 957 ;
    dzdoc:usesTerm dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_913> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_913" ;
    dzdoc:fullText "يجب على الحائز أن يحتفظ بقيد الرهن الذي حل فيه محل الدائن وأن يجدده عند الاقتضاء ، وذلك إلى أن تشطب القيود التي كانت موجودة على العقار وقت تسجيل سند هذا الحائز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_913> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_913_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_913_19750926_OpEnact_6444cd8862> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_913_obligation_0_a8fde008> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 913" ;
    dzdoc:position 964 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_916> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_916" ;
    dzdoc:fullText "إذا أراد الحائز تطهير العقار وجب عليه أن يوجه إلى الدائنين المقيدة حقوقهم في مواطنهم المختارة المذكورة في القيد إعلانات تشتمل على البيانات الآتية : خلاصة من سند ملكية الحائز تقتصر على بيان نوع التصرف وتاريخه واسم المالك السابق للعقار مع تعيين هذا المالك تعيينا دقيقا ومحل العقار مع تعيينه وتحديده بالدقة، وإذا كان التصرف بيعا يذكر أيضا الثمن وما عسى أن يوجد من تكاليف تعتبر جزءا من هذا الثمن، تاريخ تسجيل ملكية الحائز ورقم التسجيل، المبلغ الذي يقدره الحائز قيمة للعقار ولو كان التصرف بيعا ويجب ألا يقل هذا المبلغ عن السعر الذي يتخذ أساسا لتقدير الثمن في حالة نزع الملكية، ولا أن يقل في أي حال عن الباقي في ذمة الحائز من ثمن العقار إذا كان التصرف بيعا، وإذا كانت أجزاء العقار مثقلة برهون مختلفة و وجب تقدير قيمة كل جزء على حدة، قائمة بالحقوق التي تم قيدها على العقار قبل تسجيل سند الحائز تشتمل على بيان تاريخ هذه القيود ومقدار هذه الحقوق وأسماء الدائنين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_916> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_916_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_916_19750926_OpEnact_56d6dfa7da> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_916_obligation_0_112d23b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "916" ;
    dzdoc:position 967 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_916_condition_0_60607e66> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_917> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_917" ;
    dzdoc:fullText "يجب على الحائز أن يذكر في نفس الاعلان أنه مستعد أو يوفي الديون المقيدة إلى القدر الذي قوم به العقار . وليس عليه أن يصحب العرض بالمبلغ نقدا بل ينحصر العرض في إظهار استعداده للوفاء بمبلغ واجب الدفع في الحال أيا كان أجل استحقاق الديون المقيدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_917> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_917_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_917_19750926_OpEnact_e212eacf08> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_917_obligation_0_692a6845> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "917" ;
    dzdoc:position 968 ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "يجوز أن يكون محل الالتزام شيئا مستقبلا ومحققا. غير أن التعامل في تركة إنسان على قيد الحياة باطل ولو كان برضاه، إلا في الأحوال المنصوص عليها في القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_92_permission_0_5530680c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_92_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_92_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_92_19750926_OpEnact_58d069f682> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 92" ;
    dzdoc:position 99 ;
    dzdoc:usesTerm dzterm:subject_matter .

<https://legal.dz/resource/order/1975-09-26/75-58#art_925> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_925" ;
    dzdoc:fullText "يحق للحائز أن يدخل في المزاد على شرط ألا يعرض فيه ثمنا أقل من الباقي في ذمته من ثمن العقار الجاري بيعه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_925_right_0_52f6313c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_925> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_925_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_925_19750926_OpEnact_34ca3fbd4a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "925" ;
    dzdoc:position 976 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_925_condition_0_90fef13d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_926> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_926" ;
    dzdoc:fullText "إذا نزعت ملكية العقار المرهون ولو كان ذلك بعد اتخاذ اجراءات التطهير أو التخلية ورسا المزاد على الحائز نفسه ، أعتبر هذا مالكا للعقار بمقتضى سند ملكيته الأصلي. ويتطهر العقار من كل حق مقيد إذا دفع الحائز الثمن الذي رسا به المزاد أو أودعه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_926> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_926_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_926_19750926_OpEnact_69c0701804> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "926" ;
    dzdoc:position 977 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_926_condition_0_81eaf822>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_926_condition_1_1cf2b78f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_928> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_928" ;
    dzdoc:fullText "إذا زاد الثمن الذي رسا به المزاد على ما هو مستحق للدائنين المقيدة حقوقهم ، كانت الزيادة للحائز و كان للدائنين المرتهنين من الحائز أن يستوفوا حقوقهم من هذه الزيادة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_928_right_0_7d9f54e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_928> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_928_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_928_19750926_OpEnact_df45a345a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "928" ;
    dzdoc:position 979 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_928_condition_0_2cd464c4> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_936> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_3> ;
    dzdoc:eId "art_936" ;
    dzdoc:fullText "إذا بيع العقار المرهون بيعا جبريا بالمزاد العلني سواء كان ذلك في مواجهة مالك العقار أو الحائز أو الحارس الذي سلم إليه العقار عند التخلية ، فإن حقوق الرهن على هذا العقار تنقضي بإيداع الثمن الذي رسا به المزاد، أو بدفعه إلى الدائنين المقيدين الذين تسمح مرتبتهم باستيفاء حقوقهم من هذا الثمن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_936> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_936_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_936_19750926_OpEnact_f70c3223d0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_936_obligation_0_22eb6bed> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "936" ;
    dzdoc:position 987 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_936_condition_0_594318f6> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_943> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_943" ;
    dzdoc:fullText "يجب على قلم الكتاب إعلان المدين بالأمر الصادر بالاختصاص في نفس اليوم الذي يصدر فيه هذا الأمر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_943> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_943_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_943_19750926_OpEnact_508d1956d4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_943_obligation_0_444055a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 943" ;
    dzdoc:position 994 ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_951> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_951" ;
    dzdoc:fullText "ينبغي على الراهن تسليم الشيء المرهون إلى الدائن أو إلى الشخص الذي عينه المتعاقدان لتسليمه . ويسري على الالتزام بتسليم الشيء المرهون أحكام الالتزام بتسليم الشيء المبيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_951> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_951_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_951_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_951_19750926_OpEnact_7efb4708a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_951_obligation_0_11ef07af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "951" ;
    dzdoc:position 1002 ;
    dzdoc:usesTerm dzterm:دائن,
        dzterm:راهن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_959> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_959" ;
    dzdoc:fullText "يجب على الدائن أن يرد الشيء المرهون إلى الراهن بعد استيفاء كامل حقه وما يتصل بالحق من ملحقات ومصاريف وتعويضات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_959> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_959_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_959_19750926_OpEnact_d7da95fe86> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_959_obligation_0_3435d5ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "959" ;
    dzdoc:position 1010 ;
    dzdoc:usesTerm dzterm:دائن,
        dzterm:راهن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_961> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_961" ;
    dzdoc:fullText "يجب لنفاذ الرهن في حق الغير أن يكون الشيء المرهون في يد الدائن أو الأجنبي الذي ارتضاه المتعاقدان . ويجوز أن يكون الشيء المرهون ضامنا لعدة ديون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_961> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_961_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_961_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_961_19750926_OpEnact_a78f78535d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_961_obligation_0_60024f5a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 961" ;
    dzdoc:position 1012 ;
    dzdoc:usesTerm dzterm:pledge,
        dzterm:pledged_item,
        dzterm:pledgee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_975> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_975" ;
    dzdoc:fullText "لا يكون رهن الدين نافذا في حق المدين إلا باعلان هذا الرهن إليه أو بقبوله له وفقا ل المادة 241 . ولا يكون نافذا في حق الغير إلا بتسليم سند الدين المرهون إلى المرتهن ، وتحسب للرهن مرتبته من التاريخ الثابت للاعلان أو القبول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_975> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_975_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_975_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_975_19750926_OpEnact_fc0c7240fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 975" ;
    dzdoc:position 1026 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_241> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_241> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_975_condition_0_f293db87>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_975_condition_1_1147acfd> ;
    dzdoc:usesTerm dzterm:pledge_creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "كل التزام مفترض أن له سببا مشروعا، ما لم يقم الدليل على غير ذلك. ويعتبر السبب المذكور في العقد هو السبب الحقيقي حتى يقوم الدليل على ما يخالف ذلك، فاذا قام الدليل على صورية السبب فعلى من يدعي أن للالتزام سببا آخر مشروعا أن يثبت ما يدعيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_98> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_98_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_98_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_98_19750926_OpEnact_8127028907> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 98" ;
    dzdoc:position 105 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_98_condition_0_9cad773a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_982> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:privilege ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_982" ;
    dzdoc:fullText "الامتياز أولوية يقررها القانون لدين معين مراعاة منه لصفته. ولا يكون للدين امتياز الا بمقتضى نص قانوني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_982> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_982_defocc_86e6d39c80b6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_982_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_982_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_982_19750926_OpEnact_f57aaab7c2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "982" ;
    dzdoc:position 1033 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_982_condition_0_e5992e4f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_993> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_993" ;
    dzdoc:fullText "يكون للديون التالية امتياز على جميع أموال المدين من منقول وعقار : المبالغ المستحقة للخدم والكتبة، والعمال وكل أجير آخر ، من أجرهم ورواتبهم من أي نوع كان عن الاثني عشر (12) شهرا الاخيرة، المبالغ المستحقة عما تم توريده للمدين ولمن يعوله من مأكل وملبس في الستة (6) الأشهر الأخيرة، النفقة المستحقة في ذمة المدين لأقاربه عن الاشهر (6) الستة الاخيرة. وتستوفى هذه المبالغ مباشرة بعد المصاريف القضائية والمبالغ المستحقة للخزينة العامة ومصاريف الحفظ والترميم، أما فيما بينها فتستوفى بنسبة كل منها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_993_right_0_7d0c0910> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_993> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_993_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_993_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_993_19750926_OpEnact_cacee88605> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "993" ;
    dzdoc:position 1044 ;
    dzdoc:usesTerm dzterm:judicial_expenses .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_bis_subsec_3> ;
    dzdoc:eId "book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4" ;
    dzdoc:fullText "تطبق القوانين في تراب الجمهورية الجزائرية الديمقراطية الشعبية ابتداء من يوم نشرها في الجريدة الرسمية . تكون نافذة المفعول بالجزائر العاصمة بعد مضي يوم كامل من تاريخ نشرها وفي النواحي الأخرى في نطاق كل دائرة بعد مضي يوم كامل من تاريخ وصول الجريدة الرسمية إلى مقر الدائرة ويشهد على ذلك تاريخ ختم الدائرة الموضوع على الجريدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4_19750926_OpEnact_36bb4b0854> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4_obligation_0_a57034e6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_4_obligation_1_9df0c1a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 601 .

