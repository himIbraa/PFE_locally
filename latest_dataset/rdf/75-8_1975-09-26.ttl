<https://legal.dz/resource/order/1975-09-26/75-58#art_974_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_974> ;
    dzdoc:position 0 ;
    dzdoc:text "تسري الأحكام السابقة إذا لم تتعارض مع أحكام القوانين التجارية والأحكام الخاصة بالمنشآت المرخص لها بالتسليف على الرهن وأحكام القوانين واللوائح المتعلقة بأحوال خاصة في رهن المنقول."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_975_condition_0_f293db87> a dznorm:Condition ;
