<https://legal.dz/resource/order/1975-09-26/75-58#version_art_335> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز الإثبات بالشهود فيما كان يجب إثباته بالكتابة إذا وجد مبدأ ثبوت بالكتابة . وكل كتابة تصدر من الخصم ويكون من شأنها أن تجعل وجود التصرف المدعى به قريب الاحتمال، تعتبر مبدأ ثبوت بالكتابة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_335_19750926_OpEnact_eb6bd6aa46> ;
    dzdoc:replacementText "يجوز الإثبات بالشهود فيما كان يجب إثباته بالكتابة إذا وجد مبدأ ثبوت بالكتابة . وكل كتابة تصدر من الخصم ويكون من شأنها أن تجعل وجود التصرف المدعى به قريب الاحتمال، تعتبر مبدأ ثبوت بالكتابة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_335> ;
