<https://legal.dz/resource/order/1975-09-26/75-58#art_923_condition_0_6de3f766> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يختر الحائز أن يقضي الديون المقيدة أو يطهر العقار من الرهن أو يتخلى عن هذا العقار"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_923> ;
