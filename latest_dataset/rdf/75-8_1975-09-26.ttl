<https://legal.dz/resource/order/1975-09-26/75-58#version_art_797> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801 فلا يجوز الأخذ بالشفعة الا من المشتري الثاني وحسب الشروط التي اشترى بها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
