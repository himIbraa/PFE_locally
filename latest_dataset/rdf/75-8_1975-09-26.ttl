<https://legal.dz/resource/order/1975-09-26/75-58#art_589> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_589" ;
    dzdoc:fullText "يجب على الوكيل أن يصل بالأعمال التي بدأها بحيث لا تتعرض للتلف وذلك على أي وجه وتنتهي به الوكالة . وفي حالة انتهاء الوكالة بموت الوكيل يجب على ورثته، إذا توفرت فيهم الأهلية وكانوا على علم بالوكالة ، أن يبادروا إلى إخطار الموكل بموت مورثه وان يتخذوا من التدابير ما تقتضيه الحال لصالح الموكل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_589> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_589_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_589_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_589_19750926_OpEnact_66b18c8d3f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_589_obligation_0_f1b020c2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_589_obligation_1_3874e5fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "589" ;
    dzdoc:position 626 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_589_condition_0_264f12ae> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "لا يجوز لشخص أن يتعاقد مع نفسه باسم من ينوب عنه سواء أكان التعاقد لحسابه هو أم لحساب شخص آخر، دون ترخيص من الأصيل على أنه يجوز للأصيل في هذه الحالة أن يجيز التعاقد كل ذلك مع مراعاة ما يخالفه، مما يقضي به القانون وقواعد التجارة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_77_permission_0_558b4ffe> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_77_right_0_8d22d3be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_77_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_77_19750926_OpEnact_96a960678d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_77_obligation_0_0f3d7186> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_77_prohibition_0_558b4ffe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 84 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "إذا كانت التزامات أحد المتعاقدين متفاوتة كثيرا في النسبة مع ما حصل عليه هذا المتعاقد من فائدة بموجب العقد أو مع التزامات المتعاقد الآخر، وتبين أن المتعاقد المغبون لم يبرم العقد إلا لأن المتعاقد الآخر قد استغل فيه طيشا بينا أو هوى جامحا ، جاز للقاضي بناء على طلب المتعاقد المغبون، أن يبطل العقد أو أن ينقص التزامات هذا المتعاقد . ويجب أن ترفع الدعوى بذلك خلال سنة من تاريخ العقد ، وإلا كانت غير مقبولة. ويجوز في عقود المعاوضة أن يتوقى الطرف الآخر دعوى الإبطال، إذا عرض ما يراه القاضي كافيا لرفع الغبن ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_90_right_0_edcf6256> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_90_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_90_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_90_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_90_19750926_OpEnact_dfe8a0a217> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_90_obligation_0_be659e09> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 90" ;
    dzdoc:position 97 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_90_condition_0_366aa119>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_90_condition_1_b62cb997> .

