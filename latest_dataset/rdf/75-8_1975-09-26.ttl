<https://legal.dz/resource/order/1975-09-26/75-58#art_85_condition_0_5e48924f> a dznorm:Condition ;
    dznorm:conditionText "إذا أظهر الطرف الآخر استعداده لتنفيذ هذا العقد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_85> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_85_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_85> ;
    dzdoc:position 0 ;
    dzdoc:text "ليس لمن وقع في غلط أن يتمسك به على وجه يتعارض مع ما يقضي به حسن النية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_85_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_85> ;
    dzdoc:position 1 ;
    dzdoc:text "ويبقى بالأخص ملزما بالعقد قصد إبرامه إذا أظهر الطرف الآخر استعداده لتنفيذ هذا العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_860_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_860> ;
