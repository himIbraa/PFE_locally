<https://legal.dz/resource/order/1975-09-26/75-58#version_art_68> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كانت طبيعة المعاملة، أو العرف التجاري، أو غير ذلك من الظروف، تدل على أن الموجب لم يكن لينتظر تصريحا بالقبول فإن العقد يعتبر قد تم إذا لم يرفض الايجاب في وقت مناسب . ويعتبر السكوت في الرد قبولا ، إذا اتصل الايجاب بتعامل سابق بين المتعاقدين، أو إذا كان الايجاب لمصلحة من وجه إليه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_68_19750926_OpEnact_12b4917e2a> ;
    dzdoc:replacementText "إذا كانت طبيعة المعاملة، أو العرف التجاري، أو غير ذلك من الظروف، تدل على أن الموجب لم يكن لينتظر تصريحا بالقبول فإن العقد يعتبر قد تم إذا لم يرفض الايجاب في وقت مناسب . ويعتبر السكوت في الرد قبولا ، إذا اتصل الايجاب بتعامل سابق بين المتعاقدين، أو إذا كان الايجاب لمصلحة من وجه إليه ."@ar ;
