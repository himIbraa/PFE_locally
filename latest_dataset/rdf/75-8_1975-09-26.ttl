<https://legal.dz/resource/order/1975-09-26/75-58#version_art_423> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كانت حصة الشريك عملا يقدمه للشركة وجب عليه أن يقوم بالخدمات التي تعهد بها و أن يقدم حسابا عما يكون قد كسبه من وقت قيام الشركة بمزاولته العمل الذي قدم كحصة لها . غير أنه لا يكون ملزما بأن يقدم للشركة ما يكون قد حصل عليه من حق اختراع إلا إذا وجد اتفاق يقضي بخلاف ذلك ."@ar ;
