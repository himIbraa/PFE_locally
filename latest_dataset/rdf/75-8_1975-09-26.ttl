<https://legal.dz/resource/order/1975-09-26/75-58#version_art_290> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يعد مجرد تقييد الالتزام في حساب جار تجديدا. وإنما يتجدد الالتزام إذا قطع رصيد الحساب، وتم اقراره على انه إذا كان الدين مكفولا بتأمين خاص فإن هذا التأمين يبقى ما لم يتفق على غير ذلك."@ar ;
    dzdoc:isAuthoritative true ;
