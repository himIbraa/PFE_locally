<https://legal.dz/resource/order/1975-09-26/75-58#version_art_714> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شريك في الشيوع يملك حصته ملكا تاما، وله أن يتصرف فيها وأن يستولي على ثمارها وأن يستعملها بحيث لا يلحق الضرر بحقوق سائر الشركاء . وإذا كان التصرف منصبا على جزء مفرز من المال الشائع ولم يقع هذا الجزء عند القسمة في نصيب المتصرف انتقل حق المتصرف إليه من وقت التصرف إلى الجزء الذي آل إلى المتصرف بطريق القسمة. وللمتصرف إليه الحق في إبطال التصرف إذا كان يجهل أن المتصرف لا يملك العين المتصرف فيها مفرزة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_714_19750926_OpEnact_afbeae614c> ;
    dzdoc:replacementText "كل شريك في الشيوع يملك حصته ملكا تاما، وله أن يتصرف فيها وأن يستولي على ثمارها وأن يستعملها بحيث لا يلحق الضرر بحقوق سائر الشركاء . وإذا كان التصرف منصبا على جزء مفرز من المال الشائع ولم يقع هذا الجزء عند القسمة في نصيب المتصرف انتقل حق المتصرف إليه من وقت التصرف إلى الجزء الذي آل إلى المتصرف بطريق القسمة. وللمتصرف إليه الحق في إبطال التصرف إذا كان يجهل أن المتصرف لا يملك العين المتصرف فيها مفرزة ."@ar ;
