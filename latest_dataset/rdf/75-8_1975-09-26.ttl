<https://legal.dz/resource/order/1975-09-26/75-58#version_art_297> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمدين حق المقاصة بين ما هو مستحق عليه لدائنه وما هو مستحق له تجاهه ولو اختلف سبب الدينين إذا كان موضوع كل منهما نقودا أو مثليات متحدة النوع والجودة وكان كل منها ثابتا وخاليا من النزاع ومستحق الاداء صالحا للمطالبة به قضاء . ولا يمنع المقاصة تأخر ميعاد الوفاء لمهلة منحها القاضي أو تبرع بها الدائن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_297_19750926_OpEnact_5dd808c8b8> ;
    dzdoc:replacementText "للمدين حق المقاصة بين ما هو مستحق عليه لدائنه وما هو مستحق له تجاهه ولو اختلف سبب الدينين إذا كان موضوع كل منهما نقودا أو مثليات متحدة النوع والجودة وكان كل منها ثابتا وخاليا من النزاع ومستحق الاداء صالحا للمطالبة به قضاء . ولا يمنع المقاصة تأخر ميعاد الوفاء لمهلة منحها القاضي أو تبرع بها الدائن."@ar ;
