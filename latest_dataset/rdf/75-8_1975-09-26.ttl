    dzdoc:evidenceText "تسري القوانين المتعلقة ب الأهلية على جميع الأشخاص الذين تتوفر فيهم الشروط المنصوص عليها . وإذا صار شخص توفرت فيه الأهلية بحسب النص القديم ناقص الأهلية طبقا للنص الجديد ، فلا يؤثر ذلك على تصرفاته السابقة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6_19750926_OpEnact_0b8a4b45c2> ;
    dzdoc:replacementText "تسري القوانين المتعلقة ب الأهلية على جميع الأشخاص الذين تتوفر فيهم الشروط المنصوص عليها . وإذا صار شخص توفرت فيه الأهلية بحسب النص القديم ناقص الأهلية طبقا للنص الجديد ، فلا يؤثر ذلك على تصرفاته السابقة."@ar ;
