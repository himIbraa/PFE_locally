    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_453_condition_1_a76e68d9> a dznorm:Condition ;
    dznorm:conditionText "إذا كان المقرض قد تعمد اخفاء العيب"@ar ;
