<https://legal.dz/resource/order/1975-09-26/75-58#art_404_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_404> ;
    dzdoc:position 0 ;
    dzdoc:text "من باع تركة دون أن يفصل مشتملاتها، لا يضمن الا صفته كوارث ما لم يقع اتفاق يخالف ذلك."@ar .

