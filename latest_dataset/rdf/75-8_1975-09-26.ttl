    dzdoc:position 739 ;
    dzdoc:usesTerm dzterm:easement,
        dzterm:passage,
        dzterm:title_deed .

<https://legal.dz/resource/order/1975-09-26/75-58#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "يحصل القبول في عقد الاذعان بمجرد التسليم لشروط مقررة يضعها الموجب ولا يقبل المناقشة فيها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_70_19750926_OpEnact_e02ffe15b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:adhesion_contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_726> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_726" ;
    dzdoc:fullText "تفصل المحكمة في كل المنازعات وخاصة منها ما يتعلق بتكوين الحصص."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_726> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_726_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_726_19750926_OpEnact_bbcbbf5504> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 726" ;
    dzdoc:position 766 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_727> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_727" ;
    dzdoc:fullText "تجري القسمة بطريق الاقتراع، و تثبت المحكمة ذلك في محضرها وتصدر حكما باعطاء كل شريك نصيبه المفرز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_727> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_727_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_727_19750926_OpEnact_c8f5de1b5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 727" ;
    dzdoc:position 767 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_730> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_730" ;
    dzdoc:fullText "يعتبر المتقاسم مالكا للحصة التي آلت إليه منذ أن أصبح مالكا في الشيوع، وأنه لم يكن مالكا على الاطلاق لباقي الحصص الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_730> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_730_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_730_19750926_OpEnact_db3fb46940> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 730" ;
    dzdoc:position 770 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_746> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_746" ;
    dzdoc:fullText "تتناسب الحصة في الأجزاء المشتركة الخاصة لكل قسمة مع المساحة النافعة بالنسبة للمساحة الاجمالية النافعة لمجموع القسمات التي تشكل الوحدة العقارية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_746> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_746_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_746_19750926_OpEnact_710f04687c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 746" ;
    dzdoc:position 786 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_748> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_748" ;
    dzdoc:fullText "يحدد نظام الملكية المشتركة مصير الأجزاء المشتركة والأجزاء الخاصة وكيفيات الانتفاع بها وكذا القواعد المتعلقة بإدارة هذه الأجزاء وتسييرها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_748> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_748_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_748_19750926_OpEnact_2c3846bfec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 748" ;
    dzdoc:position 788 ;
    dzdoc:usesTerm dzterm:coownership_rules .

