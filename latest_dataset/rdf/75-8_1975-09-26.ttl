<https://legal.dz/resource/order/1975-09-26/75-58#art_560> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_2> ;
    dzdoc:eId "art_560" ;
    dzdoc:fullText "إذا أبرم عقد بمقتضى مقايسة على أساس الوحدة وتبين في أثناء العمل أنه من الضروري لتنفيذ التصميم المتفق عليه مجاوزة المقايسة المقدرة مجاوزة محسوسة وجب على المقاول أن يخطر في الحال رب العمل بذلك مبينا مقدار ما يتوقعه من زيادة في الثمن . فإن لم يفعل سقط حقه في استرداد ما جاوز به قيمة المقايسة من نفقات. فإذا اقتضت الضرورة مجاوزة المقايسة لتنفيذ التصميم المتفق عليه مجاوزة جسيمة جاز لرب العمل أن يتحلل من العقد ويوقف التنفيذ على أن يكون ذلك دون إبطاء، مع إيفاء المقاول قيمة ما أنجزه من الأعمال، مقدرة وفقا لشروط العقد ، دون أن يعوضه عما كان يستطيع كسبه لو أنه أتم العمل."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_560_right_0_cea127b3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_560> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_560_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_560_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_560_19750926_OpEnact_9f328c9510> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_560_obligation_0_afd4bc85>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_560_obligation_1_afee6fd2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "560" ;
    dzdoc:position 587 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_560_condition_0_85447041>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_560_condition_1_876f0aff> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_570> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_4> ;
    dzdoc:eId "art_570" ;
    dzdoc:fullText "إذا انقضى العقد بموت المقاول وجب على رب العمل أن يدفع للتركة قيمة ما تم من الأعمال وما انفق لتنفيذ ما لم يتم . وذلك بقدر النفع الذي يعود عليه من هذه الأعمال والنفقات. ويجوز ل رب العمل في نظير ذلك أن يطالب بتسلم المواد التي تم إعدادها والرسوم التي بدئ في تنفيذها ، على أن يدفع عنها تعويضا عادلا. وتسري هذه الأحكام أيضا إذا بدأ المقاول في تنفيذ العمل ثم أصبح عاجزا عن إتمامه لسبب خارج عن إرادته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_570_right_0_b5933643> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_570> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_570_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_570_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_570_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_570_19750926_OpEnact_5cf5b519ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_570_obligation_0_04d89b33> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 570" ;
    dzdoc:position 597 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_570_condition_0_c3d20bbe>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_570_condition_1_9e5dccb3> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_580> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_580" ;
    dzdoc:fullText "إذا أناب الوكيل عنه غيره في تنفيذ الوكالة دون أن يكون مرخصا له في ذلك كان مسؤولا عما فعل النائب كما لو كان هذا العمل قد صدر منه هو ، ويكون الوكيل ونائبه في هذه الحالة متضامنين في المسؤولية. أما إذا رخص للوكيل في إقامة نائب عنه دون أن يعين شخص النائب فإن الوكيل لا يكون مسؤولا الا عن خطئه في اختيار نائبه أو عن خطئه فيما أصدره له من تعليمات. ويجوز في الحالتين السابقتين للموكل والنائب الوكيل أن يرجع كل منهما مباشرة على الآخر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_580_right_0_3090bb7f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_580> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_580_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_580_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_580_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_580_19750926_OpEnact_00f1007663> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_580_obligation_0_9c41866a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 580" ;
    dzdoc:position 617 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_580_condition_0_0aa087cd>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_580_condition_1_b35ce127> ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_599> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_3> ;
    dzdoc:eId "art_599" ;
    dzdoc:fullText "يكون أصحاب الفنادق والنزل ومن يماثلهم من الأشخاص مسؤولين عن الأشياء التي يودعها عندهم المسافرون والنزلاء الذين ينزلون عندهم مع وجوب المحافظة عليها ، الا إذا أثبتوا أن أسباب الضياع كانت طارئة، أو حصلت في ظروف قاهرة أو بسبب خطأ المودع ، أو لعيب في الشيء المودع . وكذلك يكونون مسؤولين سواء عن السرقة أو الضرر الذي لحق أمتعة المسافرين والنزلاء أو السرقة التي تقع بسبب تابعيهم أو بسبب المترددين على الفندق . غير أنهم لا يكونون مسؤولين فيما يتعلق بالنقود والأوراق المالية والأشياء الثمينة عن تعويض يجاوز خمسمائة دينار جزائري، ما لم يكونوا قد أخذوا على عاتقهم حفظ هذه الأشياء وهم يعرفون قيمتها أو يكونوا قد رفضوا دون مسوغ أن يتسلموها عهدة في ذمتهم أو يكونوا قد تسببوا في وقوع ضرر بخطا جسيم أو من أحد تابعيهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_599> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_599_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_599_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_599_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_599_19750926_OpEnact_1329baaa8d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_599_obligation_0_de6ac63a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_599_obligation_1_67bdf718> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 599" ;
    dzdoc:position 636 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_599_condition_0_0e4e601c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_599_condition_1_6e1cf4ad> ;
    dzdoc:usesTerm dzterm:hotel_owners .

<https://legal.dz/resource/order/1975-09-26/75-58#art_669> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_669" ;
    dzdoc:fullText "تجوز كفالة الكفيل ، وفي هذه الحالة لا يجوز للدائن أن يرجع على كفيل قبل رجوعه على الكفيل الا إذا كان كفيل الكفيل متضامنا مع الكفيل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_669_permission_0_e0e4210d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_669_right_0_ed36ac81> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_669> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_669_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_669_19750926_OpEnact_6f59fe38ec> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_669_prohibition_0_e0e4210d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 669" ;
    dzdoc:position 706 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_669_condition_0_e02effa5> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_678> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_678" ;
    dzdoc:fullText "لا يجوز إصدار حكم التأميم الا بنص قانوني على أن الشروط وإجراءات نقل الملكية والكيفية التي يتم بها التعويض يحددها القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_678_permission_0_624f4bce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_678> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_678_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_678_19750926_OpEnact_97586efb05> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_678_obligation_0_e9a35e24> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_678_prohibition_0_624f4bce> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 678" ;
    dzdoc:position 715 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_693> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_693" ;
    dzdoc:fullText "يجوز لمالك الأرض المحصورة التي ليس لها أي ممر يصلها بالطريق العام أو كان لها ممر ولكنه غير كاف للمرور، أن يطلب حق المرور على الأملاك المجاورة مقابل تعويض يتناسب مع الاضرار التي يمكن أن تحدث من جراء ذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_693_permission_0_3ce4585e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_693_right_0_c795ace5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_693> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_693_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_693_19750926_OpEnact_323651fc31> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "693" ;
    dzdoc:position 733 ;
    dzdoc:usesTerm dzterm:land_locked_property,
        dzterm:right_of_way .

<https://legal.dz/resource/order/1975-09-26/75-58#art_711> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_711" ;
    dzdoc:fullText "لا تشترك أية مسافة لفتح المناور ، التي تقام من ارتفاع مترين من أرض الغرفة التي يراد إنارتها . ولا يقصد بها الا مرور الهواء ونفاذ النور، دون أن يمكن الاطلاع منها على العقار المجاور ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_711_permission_0_dda69d6c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_711> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_711_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_711_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_711_19750926_OpEnact_3c895f09d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_711_obligation_0_4c3b964f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "711" ;
    dzdoc:position 751 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_711_condition_0_f5145709> ;
    dzdoc:usesTerm dzterm:skylight .

<https://legal.dz/resource/order/1975-09-26/75-58#art_714> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_714" ;
    dzdoc:fullText "كل شريك في الشيوع يملك حصته ملكا تاما، وله أن يتصرف فيها وأن يستولي على ثمارها وأن يستعملها بحيث لا يلحق الضرر بحقوق سائر الشركاء . وإذا كان التصرف منصبا على جزء مفرز من المال الشائع ولم يقع هذا الجزء عند القسمة في نصيب المتصرف انتقل حق المتصرف إليه من وقت التصرف إلى الجزء الذي آل إلى المتصرف بطريق القسمة. وللمتصرف إليه الحق في إبطال التصرف إذا كان يجهل أن المتصرف لا يملك العين المتصرف فيها مفرزة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_714_right_0_0a7ab6d4>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_714_right_1_3d2c20c8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_714> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_714_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_714_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_714_19750926_OpEnact_afbeae614c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_714_obligation_0_551e79c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 714" ;
    dzdoc:position 754 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_714_condition_0_0239852b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_714_condition_1_c5bf4972> ;
    dzdoc:usesTerm dzterm:partner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_734> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_734" ;
    dzdoc:fullText "يجوز أن تكون قسمة المهايأة أيضا بأن يتفق الشركاء على أن يتناولوا الانتفاع بجميع المال المشترك، كل منهم لمدة تتناسب مع حصته ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_734_permission_0_c37928f4> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_734_right_0_1bb147f9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_734> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_734_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_734_19750926_OpEnact_e6dcd85999> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "734" ;
    dzdoc:position 774 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_740> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_740" ;
    dzdoc:fullText "ليس للشركاء أن يطلبوا القسمة ما دامت ملكية الأسرة قائمة ، و لا يجوز لأي شريك أن يتصرف في نصيبه لأجنبي عن الأسرة الا بموافقة الشركاء جميعا . وإذا تملك أجنبي عن الأسرة حصة أحد الشركاء برضاء هذا الشريك أو جبرا عليه ، فلا يكون الأجنبي شريكا في ملكية الأسرة الا برضاء باقي الشركاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_740_permission_0_5801cdc7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_740> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_740_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_740_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_740_19750926_OpEnact_049a1e832a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_740_obligation_0_fa5034dc>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_740_obligation_1_664a484d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_740_obligation_2_1c342fad> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "740" ;
    dzdoc:position 780 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_740_condition_0_8e1bf213> ;
    dzdoc:usesTerm dzterm:family_property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_799> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_799" ;
    dzdoc:fullText "على من يريد الأخذ بالشفعة أن يعلن رغبته فيها إلى كل من البائع والمشتري في أجل ثلاثين (30) يوما من تاريخ الانذار الذي يوجهه إليه البائع أو المشتري والا سقط حقه ، ويزاد على ذلك الأجل مدة المسافة أن اقتضى الأمر ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_799> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_799_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_799_19750926_OpEnact_90dbf38e7b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_799_obligation_0_b0c65ffa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 799" ;
    dzdoc:position 850 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_828> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:valid_title ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_828" ;
    dzdoc:fullText "إذا وقعت الحيازة على عقار أو على حق عيني عقاري وكانت مقترنة بحسن النية ومستندة في الوقت نفسه إلى سند صحيح فإن مدة التقادم المكسب تكون عشر(10) سنوات. ولا يشترط توافر حسن النية الا وقت تلقي الحق. والسند الصحيح هو تصرف يصدر عن شخص لا يكون مالكا للشيء أو صاحبا للحق المراد كسبه بالتقادم. ويجب إشهار السند."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_828> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_828_defocc_c9dffb62cd7b> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_828_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_828_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_828_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_828_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_828_19750926_OpEnact_2d8046e220> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_828_obligation_0_3f29984b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 828" ;
    dzdoc:position 879 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_828_condition_0_810c7645> ;
    dzdoc:usesTerm dzterm:possession,
        dzterm:prescription_period .

<https://legal.dz/resource/order/1975-09-26/75-58#art_844> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_844" ;
    dzdoc:fullText "يكسب حق الانتفاع بالتعاقد وبالشفعة وبالتقادم أو بمقتضى القانون . يجوز أن يوصى ب حق الانتفاع لأشخاص متعاقدين إذا كانوا موجودين على قيد الحياة وقت الوصية كما يجوز أن یوصی به للحمل المستكن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_844_permission_0_3032f827> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_844_right_0_96466d7e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_844> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_844_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_844_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_844_19750926_OpEnact_767336191e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 844" ;
    dzdoc:position 895 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_844_condition_0_88fff433> ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_874> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_874" ;
    dzdoc:fullText "تكون نفقة المنشآت اللازمة لاستعمال حق الارتفاق والمحافظة عليه على مالك العقار المرتفق ، ما لم يشترط خلاف ذلك. وإذا كان مالك العقار المرتفق به هو المكلف بأن يقوم بتلك المنشآت على نفقته جاز له دائما أن يتخلص من هذا التكليف بالتخلي عن العقار المرتفق به كله أو بعضه لمالك العقار المرتفق . وإذا كانت المنشآت نافعة أيضا لمالك العقار المرتفق به كانت نفقة الصيانة على الطرفين بنسبة ما يعود على كل منهما من الفائدة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_874_right_0_74122716> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_874> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_874_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_874_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_874_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_874_19750926_OpEnact_4164d3af2c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_874_obligation_0_cc9f7695> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "874" ;
    dzdoc:position 925 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_874_condition_0_7e046de3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_874_condition_1_4aea49fc> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يجوز إبطال العقد للاكراه إذا تعاقد شخص تحت سلطان رهبة بينة بعثها المتعاقد الآخر في نفسه دون حق . وتعتبر الرهبة قائمة على بينة إذا كانت ظروف الحال تصور للطرف الذي يدعيها أن خطرا جسيما محدقا يهدده هو، أو أحد أقاربه، في النفس، أو الجسم، أو الشرف، أو المال . ويراعى في تقدير الاكراه جنس من وقع عليه هذا الاكراه ، وسنه وحالته الاجتماعية، والصحية، وجميع الظروف الأخرى التي من شأنها أن تؤثر في جسامة الاكراه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_88_permission_0_2add5229> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_88_right_0_4c642474> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_88_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_88_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_88_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_88_19750926_OpEnact_52b52f1fb8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_88_obligation_0_a038ee11> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 88" ;
    dzdoc:position 95 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_88_condition_0_d4fb6fb6> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_880> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_880" ;
    dzdoc:fullText "ينتهي حق الارتفاق إذا تغير وضع الأشياء بحيث تصبح في حالة لا يمكن فيها استعمال هذا الحق ، و يعود إذا عادت الأشياء إلى وضع يمكن معه استعمال الحق إلا أن يكون قد انتهى بعدم الاستعمال ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_880_permission_0_70088991> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_880_right_0_75a85c1f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_880> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_880_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_880_19750926_OpEnact_645b932a69> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_880_obligation_0_f627378b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "880" ;
    dzdoc:position 931 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_880_condition_0_d2651cd1> ;
    dzdoc:usesTerm dzterm:easement .

<https://legal.dz/resource/order/1975-09-26/75-58#art_889> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_889" ;
    dzdoc:fullText "يجوز لمالك المباني القائمة على أرض الغير أن يرهنها وفي هذه الحالة يكون للدائن حق التقدم في استيفاء الدين من ثمن الانقاض إذا هدمت المباني ، ومن التعويض الذي يدفعه مالك الأرض إذا استبقى المباني وفقا للأحكام الخاصة بالالتصاق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_889_permission_0_ceef460e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_889_right_0_db4b5bb7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_889> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_889_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_889_19750926_OpEnact_b37c0d0ef3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 889" ;
    dzdoc:position 940 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_889_condition_0_e057e3f6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_889_condition_1_6bf1141a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_896> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_896" ;
    dzdoc:fullText "الإيجار الصادر من الراهن لا ينفذ في حق الدائن المرتهن إلا إذا كان ثابت التاريخ قبل تسجيل تنبيه نزع الملكية ، أما إذا لم يكن الإيجار ثابت التاريخ على هذا الوجه، أو كان قد عقد بعد تسجيل التنبيه ولم تعجل فيه الأجرة ، فلا يكون نافذا إلا إذا أمكن اعتباره داخلا في أعمال الادارة الحسنة . وإذا كان الإيجار السابق على تسجيل التنبيه تزيد مدته على تسع (9) سنوات ، فلا يكون نافذا في حق الدائن المرتهن الا لمدة تسع (9) سنوات، ما لم يكن قد سجل قبل قيد الرهن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_896> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_896_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_896_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_896_19750926_OpEnact_fbb0b85757> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 896" ;
    dzdoc:position 947 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_896_condition_0_9cc102b7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_896_condition_1_7e2118ca>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_896_condition_2_a9ea3d62>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_896_condition_3_1bd5806b> ;
    dzdoc:usesTerm dzterm:lease,
        dzterm:mortgage,
        dzterm:mortgagee,
        dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_912> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_912" ;
    dzdoc:fullText "يجوز للحائز عند حلول الدين المضمون بالرهن أن يقضيه هو وملحقاته بما في ذلك مصاريف الاجراءات من وقت انذاره . ويبقى حقه هذا قائما إلى رسو المزاد. وله في هذه الحالة أن يرجع بكل ما يوفيه على المدين وعلى المالك السابق للعقار المرهون، كما يجوز له أن يحل محل الدائن الذي استوفي الدين فيما له من حقوق إلا ما كان منها متعلقا بتأمينات قدمها شخص آخر غير المدين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_912_permission_0_18275d99> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_912_right_0_74075a8d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_912_right_1_307b4a70> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_912> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_912_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_912_19750926_OpEnact_06e6ac4b59> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 912" ;
    dzdoc:position 963 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_922> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_922" ;
    dzdoc:fullText "تكون تخلية العقار المرهون بتقرير يقدمه الحائز إلى قلم كتاب المحكمة المختصة، و يجب عليه أن يطلب التأشير بذلك في هامش تسجيل التنبيه بنزع الملكية، وأن يعلن الدائن المباشر للإجراءات بهذه التخلية في خلال خمسة (5) أيام من وقت التقرير بها . يجوز لمن له مصلحة في التعجيل أن يطلب إلى قاضي الأمور المستعجلة تعيين حارس تتخذ في مواجهته إجراءات نزع الملكية . ويعين الطالب حارسا إذا طلب ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_922_permission_0_f003a0ef> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_922_right_0_0c761469> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_922> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_922_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_922_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_922_19750926_OpEnact_49df971975> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_922_obligation_0_566f1f8b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "922" ;
    dzdoc:position 973 ;
    dzdoc:usesTerm dzterm:abandonment,
        dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_931> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_931" ;
    dzdoc:fullText "يرجع الحائز بدعوى الضمان على المالك السابق في الحدود التي يرجع بها الخلف على من تلقى منه الملكية معاوضة أو تبرعا . ويرجع الحائز أيضا على المدين بما دفعه زيادة على ما هو مستحق في ذمته بمقتضى سند ملكية أيا كان السبب في دفع هذه الزيادة ، و يحل محل الدائنين الذين وفاهم حقوقهم ، وبوجه خاص فيما لهم من تأمينات قدمها المدين دون التأمينات التي قدمها شخص آخر غير المدين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_931_right_0_d0a3b693>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_931_right_1_8f183d36>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_931_right_2_507d362f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_931> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_931_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_931_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_931_19750926_OpEnact_cfdcce8d53> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 931" ;
    dzdoc:position 982 ;
    dzdoc:usesTerm dzterm:creditors,
        dzterm:debtor,
        dzterm:owner,
        dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_944> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_944" ;
    dzdoc:fullText "يجوز للمدين أن يتظلم من الأمر الصادر بالتخصيص أمام القاضي الذي أصدره، والقائم بفصل الأمور المستعجلة . ويجب التأشير على هامش القيد بكل أمر أو حكم قضى بإلغاء الأمر الصادر بالتخصيص ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_944_permission_0_de2ea21b> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_944_right_0_22286465> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_944> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_944_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_944_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_944_19750926_OpEnact_bc1b9af66f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_944_obligation_0_9c68107b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 944" ;
    dzdoc:position 995 ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_965> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_3> ;
    dzdoc:eId "art_965" ;
    dzdoc:fullText "ينقضي أيضا حق الرهن الحيازي بأحد الأسباب الآتية : إذا تنازل الدائن المرتهن عن هذا الحق على أنه يجوز أن يحصل التنازل ضمنا بتخلي الدائن باختياره عن الشيء المرهون أو من موافقته على التصرف فيه دون تحفظ غير أنه إذا كان الشيء مثقلا بحق تقرر لمصلحة الغير ، فإن تنازل الدائن لا ينفذ في حق هذا الغير إلا برضائه، إذا اجتمع حق الرهن الحيازي مع حق الملكية في يد شخص واحد ، إذا هلك الشيء أو انقضى الحق المرهون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_965_permission_0_7a239a5b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_965> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_965_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_965_19750926_OpEnact_8fcd5e271d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 965" ;
    dzdoc:position 1016 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_965_condition_0_1dd6622c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_965_condition_1_c45d2aff>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_965_condition_2_5902c2da>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_965_condition_3_80bbbaa4> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_973> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_973" ;
    dzdoc:fullText "يجوز للدائن المرتهن إذا لم يستوف حقه أن يطلب من القاضي الترخيص له في بيع الشيء المرهون بالمزاد العلني أو بسعره في السوق . ويجوز له أيضا أن يطلب من القاضي أن يأمر بتمليكه الشيء وفاء للدين على أن يحسب عليه بقيمته حسب تقدير الخبراء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_973_permission_0_ab408b06> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_973_right_0_82ad8037>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_973_right_1_f83d5b5b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_973> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_973_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_973_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_973_19750926_OpEnact_0ea0bd3123> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 973" ;
    dzdoc:position 1024 ;
    dzdoc:usesTerm dzterm:pledge_creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_978> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_978" ;
    dzdoc:fullText "يحق للدائن المرتهن أن يستوفي الاستحقاقات الدورية على أن يخصم ما يستوفيه أولا من المصاريف ثم من أصل الدين المضمون بالرهن ما لم يتفق على غير ذلك . ويلتزم الدائن المرتهن بالمحافظة على الدين المرهون ، فإذا كان له أن يحصل شيئا من هذا الدين دون تدخل الراهن ، وجب عليه أن يحصله في الزمان والمكان المعينين للاستيفاء وأن يبادر بإخطار الراهن بذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_978_right_0_18c184b5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_978> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_978_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_978_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_978_19750926_OpEnact_a3efe2c3f1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_978_obligation_0_9ff54a02>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_978_obligation_1_c6be9215> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 978" ;
    dzdoc:position 1029 ;
    dzdoc:usesTerm dzterm:pledge_creditor,
        dzterm:pledgor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_999> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_999" ;
    dzdoc:fullText "ما يستحق لبائع العقار من الثمن وملحقاته ، يكون له امتياز على العقار المبيع. ويجب أن يقيد الامتياز ولو كان البيع مسجلا ، وتكون مرتبته من تاريخ البيع إذا وقع التقييد في ظرف شهرين من تاريخ البيع . فإذا انقضى هذا الأجل أصبح الامتياز رهنا رسميا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_999> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_999_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_999_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_999_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_999_19750926_OpEnact_266cb2c73d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_999_obligation_0_051eee5f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "999" ;
    dzdoc:position 1050 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_999_condition_0_0d20ffa6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_999_condition_1_76374336> ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:privilege,
        dzterm:seller_dues .

