<https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يمنح دفع العربون وقت إبرام العقد لكل من المتعاقدين الحق في العدول عنه خلال المدة المتفق عليها، إلا إذا قضى الاتفاق بخلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_para_1> a dzdoc:Paragraph ;
