    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_623> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يلتزم المؤمن في تعويض المؤمن له الا عن الضرر الناتج من وقوع الخطر المؤمن منه"@ar ;
    dznorm:sourceArticle "art_623" .

