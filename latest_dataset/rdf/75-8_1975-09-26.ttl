<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسري القانون على جميع المسائل التي تتناولها نصوصه في لفظها أو في فحواها . وإذا لم يوجد نص تشريعي ، حكم القاضي بمقتضى مبادئ الشريعة الإسلامية ، فإذا لم يوجد فبمقتضى العرف . فإذا لم يوجد فبمقتضى مبادئ القانون الطبيعي وقواعد العدالة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1_19750926_OpEnact_162f1e2801> ;
    dzdoc:replacementText "يسري القانون على جميع المسائل التي تتناولها نصوصه في لفظها أو في فحواها . وإذا لم يوجد نص تشريعي ، حكم القاضي بمقتضى مبادئ الشريعة الإسلامية ، فإذا لم يوجد فبمقتضى العرف . فإذا لم يوجد فبمقتضى مبادئ القانون الطبيعي وقواعد العدالة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
