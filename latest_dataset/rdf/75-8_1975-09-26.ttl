<https://legal.dz/resource/order/1975-09-26/75-58#art_924_condition_0_36ec10b7> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الحكم بالدين لاحقا لتسجيل سند الحائز"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_924> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_924_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_924> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للحائز الذي سجل سند ملكيته ولم يكن طرفا في الدعوى التي حكم فيها على المدين بالدين، أن يتمسك بأوجه الدفع التي كان للمدين أن يتمسك بها، إذا كان الحكم بالدين لاحقا لتسجيل سند الحائز."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_924_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_924> ;
    dzdoc:position 1 ;
