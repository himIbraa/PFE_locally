<https://legal.dz/resource/order/1975-09-26/75-58#version_art_234> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وفي أحد المدينين المتضامنين كل الدين ، فلا يرجع على أي من الباقين الا بقدر حصته في الدين، ولو كان بدعوى الحلول على الدائن. ويقسم الدين بالتساوي بين المدينين ما لم يكن هناك اتفاق أو نص يقضي بغير ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_234_19750926_OpEnact_8c6e6d2bc8> ;
