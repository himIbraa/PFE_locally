<https://legal.dz/resource/order/1975-09-26/75-58#version_art_304> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اجتمع في شخص واحد صفتا الدائن و المدين بالنسبة إلى دين واحد انقضى هذا الدين بالقدر الذي اتحدت فيه الذمة. وإذا زال السبب الذي أدى لاتحاد الذمة وكان لزواله أثر رجعي عاد الدين إلى الوجود بملحقاته بالنسبة إلى المعنيين بالأمر ويعتبر اتحاد الذمة كانه لم يكن."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
