<https://legal.dz/resource/order/1975-09-26/75-58#version_art_315> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يبدأ سريان التقادم فيما لم يرد فيه نص خاص الا من اليوم الذي يصبح فيه الدين مستحق الأداء. وخصوصا لا يسري التقادم بالنسبة إلى دين معلق على شرط واقف الا من اليوم الذي يتحقق فيه الشرط وبالنسبة إلى ضمان الاستحقاق الا من الوقت الذي يثبت فيه الاستحقاق، وبالنسبة إلى الدين المؤجل الا من الوقت الذي ينقضي فيه الأجل. وإذا كان تحديد ميعاد الوفاء متوقفا على إرادة الدائن سرى التقادم من الوقت الذي يتمكن فيه الدائن من إعلان إرادته."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_315_19750926_OpEnact_cb36f4f318> ;
    dzdoc:replacementText "لا يبدأ سريان التقادم فيما لم يرد فيه نص خاص الا من اليوم الذي يصبح فيه الدين مستحق الأداء. وخصوصا لا يسري التقادم بالنسبة إلى دين معلق على شرط واقف الا من اليوم الذي يتحقق فيه الشرط وبالنسبة إلى ضمان الاستحقاق الا من الوقت الذي يثبت فيه الاستحقاق، وبالنسبة إلى الدين المؤجل الا من الوقت الذي ينقضي فيه الأجل. وإذا كان تحديد ميعاد الوفاء متوقفا على إرادة الدائن سرى التقادم من الوقت الذي يتمكن فيه الدائن من إعلان إرادته."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_315> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_315> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
