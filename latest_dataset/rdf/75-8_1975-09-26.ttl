<https://legal.dz/resource/order/1975-09-26/75-58#version_art_60> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "التعبير عن الارادة يكون باللفظ وبالكتابة، أو بالاشارة المتداولة عرفا كما يكون باتخاذ موقف لا يدع أي شك في دلالته على مقصود صاحبه. ويجوز أن يكون التعبير عن الارادة ضمنيا إذا لم ينص القانون أو يتفق الطرفان على أن يكون صريحا ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_60_19750926_OpEnact_4b6faa11d1> ;
