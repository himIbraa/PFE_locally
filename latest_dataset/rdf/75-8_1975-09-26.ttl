    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_967_permission_0_8894f2c7_action_5a2c6b3d6f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_967_permission_0_8894f2c7_action_7ee6b66754> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_967_permission_0_8894f2c7_role_1f3901937d> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_967> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجوز للدائن المرتهن لعقار أن يؤجر العقار إلى الراهن دون أن يمنع ذلك من نفاذ الرهن في حق الغير. فإذا اتفق على الإيجار في عقد الرهن وجب ذكر ذلك في العقد ذاته. وإذا اتفق عليه بعد الرهن وجب أن يؤشر به في هامش القيد. ولا يكون هذا التأشير ضروريا إذا جدد الإيجار تجديدا ضمنيا."@ar ;
    dznorm:sourceArticle "art_967" .

