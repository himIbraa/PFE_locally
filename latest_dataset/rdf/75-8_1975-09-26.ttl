<https://legal.dz/resource/order/1975-09-26/75-58#version_art_343> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل من الخصمين أن يوجه اليمين الحاسمة إلى الخصم الآخر على انه يجوز للقاضي منع توجيه هذه اليمين إذا كان الخصم متعسفا في ذلك . ولمن وجهت إليه اليمين أن يردها على خصمه غير انه لا يجوز ردها إذا قامت اليمين على واقعة لا يشترك فيها الخصمان بل يستقل بها شخص من وجهت إليه اليمين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_343_19750926_OpEnact_6f8278b2fc> ;
