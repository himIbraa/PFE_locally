<https://legal.dz/resource/order/1975-09-26/75-58#version_art_565> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون للمقاولين الفرعيين والعمال الذين يشتغلون لحساب المقاول في تنفيذ العمل، حق مطالبة رب العمل مباشرة بما يجاوز القدر الذي يكون مدينا به للمقاول الأصلي وقت رفع الدعوى ، و يكون لعمال المقاول الفرعي مثل هذا الحق تجاه كل من المقاول الأصلي و رب العمل . ولهم في حالة توقيع الحجز من أحدهم على ما تحت يد رب العمل أو المقاول الأصلي امتياز على المبالغ المستحقة للمقاول الأصلي أو للمقاول الفرعي وقت توقيع الحجز . ويكون الامتياز لكل منهم بنسبة حقه، و يجوز أداء هذه المبالغ إليهم مباشرة . وحقوق المقاولين الفرعيي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_565_19750926_OpEnact_e7489648b3> ;
    dzdoc:replacementText "يكون للمقاولين الفرعيين والعمال الذين يشتغلون لحساب المقاول في تنفيذ العمل، حق مطالبة رب العمل مباشرة بما يجاوز القدر الذي يكون مدينا به للمقاول الأصلي وقت رفع الدعوى ، و يكون لعمال المقاول الفرعي مثل هذا الحق تجاه كل من المقاول الأصلي و رب العمل . ولهم في حالة توقيع الحجز من أحدهم على ما تحت يد رب العمل أو المقاول الأصلي امتياز على المبالغ المستحقة للمقاول الأصلي أو للمقاول الفرعي وقت توقيع الحجز . ويكون الامتياز لكل منهم بنسبة حقه، و يجوز أداء هذه المبالغ إليهم مباشرة . وحقوق المقاولين الفرعيين والعمال المقررة بمقتضى هذه المادة ، مقدمة على حقوق الشخص الذي تنازل له المقاول عن دينه تجاه رب العمل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_565> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_565> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_566> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ل رب العمل أن يتحلل من العقد ويوقف التنفيذ في أي وقت قبل إتمامه . على أن يعوض المقاول عن جميع ما أنفقه من المصروفات، وما أنجزه من الأعمال وما كان يستطيع كسبه لو أنه أتم العمل . غير أنه يجوز للمحكمة أن تخفض مبلغ التعويض المستحق عما فات المقاول من كسب إذا كانت الظروف تجعل هذا التخفيض عادلا ، و يتعين عليها بوجه خاص أن ينقص منه ما يكون المقاول قد اقتصده من جراء تحلل رب العمل من العقد وما يكون قد كسبه باستخدام وقته في أمر آخر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_566_19750926_OpEnact_514c77a83b> ;
    dzdoc:replacementText "يمكن ل رب العمل أن يتحلل من العقد ويوقف التنفيذ في أي وقت قبل إتمامه . على أن يعوض المقاول عن جميع ما أنفقه من المصروفات، وما أنجزه من الأعمال وما كان يستطيع كسبه لو أنه أتم العمل . غير أنه يجوز للمحكمة أن تخفض مبلغ التعويض المستحق عما فات المقاول من كسب إذا كانت الظروف تجعل هذا التخفيض عادلا ، و يتعين عليها بوجه خاص أن ينقص منه ما يكون المقاول قد اقتصده من جراء تحلل رب العمل من العقد وما يكون قد كسبه باستخدام وقته في أمر آخر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_566> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
