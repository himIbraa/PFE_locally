<https://legal.dz/resource/order/1975-09-26/75-58#version_art_367> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التسليم بوضع المبيع تحت تصرف المشتري بحيث يتمكن من حيازته والانتفاع به دون عائق ولو لم يتسلمه تسلما ماديا ما دام البائع قد أخبره بانه مستعد لتسليمه بذلك ويحصل التسليم على النحو الذي يتفق مع طبيعة الشيء المبيع. وقد يتم التسليم بمجرد تراضي الطرفين على البيع إذا كان المبيع موجودا تحت يد المشتري قبل البيع أو كان البائع قد استبقى المبيع في حيازته بعد البيع لسبب آخر لا علاقة له بالملكية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_367_19750926_OpEnact_6e493deabf> ;
    dzdoc:replacementText "يتم التسليم بوضع المبيع تحت تصرف المشتري بحيث يتمكن من حيازته والانتفاع به دون عائق ولو لم يتسلمه تسلما ماديا ما دام البائع قد أخبره بانه مستعد لتسليمه بذلك ويحصل التسليم على النحو الذي يتفق مع طبيعة الشيء المبيع. وقد يتم التسليم بمجرد تراضي الطرفين على البيع إذا كان المبيع موجودا تحت يد المشتري قبل البيع أو كان البائع قد استبقى المبيع في حيازته بعد البيع لسبب آخر لا علاقة له بالملكية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_367> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
