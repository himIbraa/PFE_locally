<https://legal.dz/resource/order/1975-09-26/75-58#version_art_106> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "العقد شريعة المتعاقدين، فلا يجوز نقضه ولا تعديله الا باتفاق الطرفين، أو للاسباب التي يقررها القانون."@ar ;
