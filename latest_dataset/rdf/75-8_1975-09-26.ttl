<https://legal.dz/resource/order/1975-09-26/75-58#version_art_560> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أبرم عقد بمقتضى مقايسة على أساس الوحدة وتبين في أثناء العمل أنه من الضروري لتنفيذ التصميم المتفق عليه مجاوزة المقايسة المقدرة مجاوزة محسوسة وجب على المقاول أن يخطر في الحال رب العمل بذلك مبينا مقدار ما يتوقعه من زيادة في الثمن . فإن لم يفعل سقط حقه في استرداد ما جاوز به قيمة المقايسة من نفقات. فإذا اقتضت الضرورة مجاوزة المقايسة لتنفيذ التصميم المتفق عليه مجاوزة جسيمة جاز لرب العمل أن يتحلل من العقد ويوقف التنفيذ على أن يكون ذلك دون إبطاء، مع إيفاء المقاول قيمة ما أنجزه من الأعمال، مقدرة وفقا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_560_19750926_OpEnact_9f328c9510> ;
    dzdoc:replacementText "إذا أبرم عقد بمقتضى مقايسة على أساس الوحدة وتبين في أثناء العمل أنه من الضروري لتنفيذ التصميم المتفق عليه مجاوزة المقايسة المقدرة مجاوزة محسوسة وجب على المقاول أن يخطر في الحال رب العمل بذلك مبينا مقدار ما يتوقعه من زيادة في الثمن . فإن لم يفعل سقط حقه في استرداد ما جاوز به قيمة المقايسة من نفقات. فإذا اقتضت الضرورة مجاوزة المقايسة لتنفيذ التصميم المتفق عليه مجاوزة جسيمة جاز لرب العمل أن يتحلل من العقد ويوقف التنفيذ على أن يكون ذلك دون إبطاء، مع إيفاء المقاول قيمة ما أنجزه من الأعمال، مقدرة وفقا لشروط العقد ، دون أن يعوضه عما كان يستطيع كسبه لو أنه أتم العمل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_560> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_560> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_561> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أبرم العقد بأجر جزافي على أساس تصميم اتفق عليه مع رب العمل فليس للمقاول أن يطالب بأية زيادة في الأجر ولو حدث في هذا التصميم تعديل أو إضافة الا أن يكون ذلك راجعا إلى خطا من رب العمل أو يكون مأذونا به منه واتفق مع المقاول على أجره . ويجب أن يحصل هذا الاتفاق كتابة ، الا إذا كان العقد الأصلي ذاته قد اتفق عليه مشافهة . على أنه إذا انهار التوازن الاقتصادي بين التزامات كل من رب العمل و المقاول بسبب حوادث استثنائية عامة لم تكن في الحسبان وقت التعاقد، وتداعى بذلك الأساس الذي قام عليه التقدير المالي ل"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_561_19750926_OpEnact_e284cb37da> ;
    dzdoc:replacementText "إذا أبرم العقد بأجر جزافي على أساس تصميم اتفق عليه مع رب العمل فليس للمقاول أن يطالب بأية زيادة في الأجر ولو حدث في هذا التصميم تعديل أو إضافة الا أن يكون ذلك راجعا إلى خطا من رب العمل أو يكون مأذونا به منه واتفق مع المقاول على أجره . ويجب أن يحصل هذا الاتفاق كتابة ، الا إذا كان العقد الأصلي ذاته قد اتفق عليه مشافهة . على أنه إذا انهار التوازن الاقتصادي بين التزامات كل من رب العمل و المقاول بسبب حوادث استثنائية عامة لم تكن في الحسبان وقت التعاقد، وتداعى بذلك الأساس الذي قام عليه التقدير المالي لعقد المقاولة ، جاز للقاضي أن يحكم بزيادة الأجرة أو بفسخ العقد ."@ar ;
