<https://legal.dz/resource/order/1975-09-26/75-58#version_art_427> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للشريك المنتدب للادارة بنص خاص في عقد الشركة أن يقوم بالرغم من معارضة الشركاء الآخرين بأعمال الادارة، وبالتصرفات التي تدخل في نطاق نشاط الشركة العادي على شرط أن تكون أعمال الادارة والتصرفات خالية من الغش ، و لا يجوز عزل هذا الشريك من وظيف المتصرف بدون مبرر مادامت الشركة قائمة . وإذا كان انتداب الشريك للادارة قد وقع بعد عقد الشركة جاز الرجوع فيه، كما يجوز في التوكيل العادي . أما المتصرفون من غير الشركاء فيمكن عزلهم في كل وقت."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_427_19750926_OpEnact_7b51cbeb7c> ;
    dzdoc:replacementText "للشريك المنتدب للادارة بنص خاص في عقد الشركة أن يقوم بالرغم من معارضة الشركاء الآخرين بأعمال الادارة، وبالتصرفات التي تدخل في نطاق نشاط الشركة العادي على شرط أن تكون أعمال الادارة والتصرفات خالية من الغش ، و لا يجوز عزل هذا الشريك من وظيف المتصرف بدون مبرر مادامت الشركة قائمة . وإذا كان انتداب الشريك للادارة قد وقع بعد عقد الشركة جاز الرجوع فيه، كما يجوز في التوكيل العادي . أما المتصرفون من غير الشركاء فيمكن عزلهم في كل وقت."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_427> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_427> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_428> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعدد الشركاء المكلفون بالادارة دون أن يعين اختصاص كل منهم، ودون أن ينص على عدم جواز تصرفاتهم بالانفراد يجوز لكل واحد أن ينفرد بعمله في التصرف على أن يكون لكل واحد من باقي الشركاء الحق في الاعتراض على ذلك العمل قبل انجازه وان يكون الحق لاغلبية الشركاء المنتدبين أن يرفضوا هذا الاعتراض فإذا تساوى الجانبان كان الرفض من حق أغلبية الشركاء جميعا . أما إذا وقع الاتفاق على أن تكون قرارات الشركاء المنتدبين بالإجماع، أو بالأغلبية ، فلا يجوز الخروج على ذلك الا أن يكون لأمر عاجل يترتب على اغفاله خسارة جس"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_428_19750926_OpEnact_05eaedeeb4> ;
    dzdoc:replacementText "إذا تعدد الشركاء المكلفون بالادارة دون أن يعين اختصاص كل منهم، ودون أن ينص على عدم جواز تصرفاتهم بالانفراد يجوز لكل واحد أن ينفرد بعمله في التصرف على أن يكون لكل واحد من باقي الشركاء الحق في الاعتراض على ذلك العمل قبل انجازه وان يكون الحق لاغلبية الشركاء المنتدبين أن يرفضوا هذا الاعتراض فإذا تساوى الجانبان كان الرفض من حق أغلبية الشركاء جميعا . أما إذا وقع الاتفاق على أن تكون قرارات الشركاء المنتدبين بالإجماع، أو بالأغلبية ، فلا يجوز الخروج على ذلك الا أن يكون لأمر عاجل يترتب على اغفاله خسارة جسيمة لا تعوض ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
