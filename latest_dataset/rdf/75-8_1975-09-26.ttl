<https://legal.dz/resource/order/1975-09-26/75-58#version_art_147> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان من تسلم غير مستحق حسن النية فلا يلزم أن يرد إلا ما تسلم . أما إذا كان سيئ النية فإنه يلزم أيضا برد الأرباح التي جناها، أو التي قصر في جنيها من الشيء الذي تسلمه بغير حق ، وذلك من يوم الوفاء، أو من اليوم الذي أصبح فيه سيئ النية. وعلى أي حال يلزم من تسلم غير المستحق برد الثمرات من يوم رفع الدعوى ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_147_19750926_OpEnact_632c41a67d> ;
    dzdoc:replacementText "إذا كان من تسلم غير مستحق حسن النية فلا يلزم أن يرد إلا ما تسلم . أما إذا كان سيئ النية فإنه يلزم أيضا برد الأرباح التي جناها، أو التي قصر في جنيها من الشيء الذي تسلمه بغير حق ، وذلك من يوم الوفاء، أو من اليوم الذي أصبح فيه سيئ النية. وعلى أي حال يلزم من تسلم غير المستحق برد الثمرات من يوم رفع الدعوى ."@ar ;
