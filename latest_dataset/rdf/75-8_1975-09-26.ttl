    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_767_19750926_OpEnact_220841dc5c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_767> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_767> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_767> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للجمعية العامة مهما كانت أغلبية الأصوات أن تلزم أحد الشركاء في الملكية بتغيير الأجزاء الخاصة فيما أعدت له أو تغيير كيفية الانتفاع بها كما هو مقرر في نظام الملكية المشتركة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_768_19750926_OpEnact_84a3c10407> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_768> ;
