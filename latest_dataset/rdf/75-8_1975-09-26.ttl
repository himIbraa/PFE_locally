<https://legal.dz/resource/order/1975-09-26/75-58#version_art_80> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الشخص أصم أبكم، أو أعمى أصم، أو أعمى أبكم، وتعذر عليه بسبب تلك العاهة التعبير عن إرادته ، جاز للمحكمة أن تعين له مساعدا قضائيا يعاونه في التصرفات التي تقتضيها مصلحته . ويكون قابلا للإبطال كل تصرف عين من أجله مساعد قضائي إذا صدر من الشخص الذي تقررت مساعدته بدون حضور المساعد بعد تسجيل قرار المساعدة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_80_19750926_OpEnact_1f1616b6e5> ;
    dzdoc:replacementText "إذا كان الشخص أصم أبكم، أو أعمى أصم، أو أعمى أبكم، وتعذر عليه بسبب تلك العاهة التعبير عن إرادته ، جاز للمحكمة أن تعين له مساعدا قضائيا يعاونه في التصرفات التي تقتضيها مصلحته . ويكون قابلا للإبطال كل تصرف عين من أجله مساعد قضائي إذا صدر من الشخص الذي تقررت مساعدته بدون حضور المساعد بعد تسجيل قرار المساعدة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_80> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
