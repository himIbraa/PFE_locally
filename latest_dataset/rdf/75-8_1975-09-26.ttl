<https://legal.dz/resource/order/1975-09-26/75-58#version_art_380> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تسلم المشتري المبيع وجب عليه التحقق من حالته عندما يتمكن من ذلك حسب قواعد التعامل الجارية ، فإذا كشف عيبا يضمنه البائع وجب عليه أن يخبر هذا الأخير في أجل مقبول عادة فإن لم يفعل اعتبر راضيا بالبيع. غير أنه إذا كان العيب مما لا يظهر بطريق الاستعمال العادي وجب على المشتري بمجرد ظهور العيب أن يخبر البائع بذلك والا اعتبر راضيا بالمبيع بما فيه من عيوب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_380_19750926_OpEnact_f375fce722> ;
    dzdoc:replacementText "إذا تسلم المشتري المبيع وجب عليه التحقق من حالته عندما يتمكن من ذلك حسب قواعد التعامل الجارية ، فإذا كشف عيبا يضمنه البائع وجب عليه أن يخبر هذا الأخير في أجل مقبول عادة فإن لم يفعل اعتبر راضيا بالبيع. غير أنه إذا كان العيب مما لا يظهر بطريق الاستعمال العادي وجب على المشتري بمجرد ظهور العيب أن يخبر البائع بذلك والا اعتبر راضيا بالمبيع بما فيه من عيوب."@ar ;
