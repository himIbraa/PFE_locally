<https://legal.dz/resource/order/1975-09-26/75-58#art_481_condition_1_987177db> a dznorm:Condition ;
    dznorm:conditionText "إذا كان هلاك العين المؤجرة جزئيا، أو إذا أصبحت في حالة لا تصلح للاستعمال الذي أعدت من أجله، أو نقص هذا الاستعمال نقصا معتبرا ولم يكن ذلك بفعل المستأجر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_481> ;
    dznorm:position 1 .

