<https://legal.dz/resource/order/1975-09-26/75-58#version_art_985> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يحتج بحق الامتياز على من حاز المنقول بحسن نية. ويعتبر حائزا بحكم هذه المادة مؤجر العقار بالنسبة إلى المنقولات الموجودة في العين المؤجرة، وصاحب الفندق بالنسبة إلى الأمتعة التي يودعها النزلاء في فندقه. وإذا خشي الدائن لأسباب معقولة، تبديد المنقول المترتب عليه حق امتياز لمصلحته جاز له أن يطلب وضعه تحت الحراسة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_985_19750926_OpEnact_451bb6a7f9> ;
    dzdoc:replacementText "لا يحتج بحق الامتياز على من حاز المنقول بحسن نية. ويعتبر حائزا بحكم هذه المادة مؤجر العقار بالنسبة إلى المنقولات الموجودة في العين المؤجرة، وصاحب الفندق بالنسبة إلى الأمتعة التي يودعها النزلاء في فندقه. وإذا خشي الدائن لأسباب معقولة، تبديد المنقول المترتب عليه حق امتياز لمصلحته جاز له أن يطلب وضعه تحت الحراسة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_985> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_985> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_986> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسري على حقوق الامتياز العقارية ، أحكام الرهن الرسمي بالقدر الذي لا تتعارض فيه مع طبيعة هذه الحقوق. وتسري بنوع خاص أحكام التطهير والقيد وما يترتب على القيد من آثار وما يتصل به من تجديد وشطب. غير أن حقوق الامتياز العامة ولو كانت مترتبة على عقار لا يجب فيها الاشهار ولا حق التتبع. ولا حاجة للإشهار أيضا في حقوق الامتياز العقارية الضامنة، بمبلغ مستحقه للخزينة العامة، وهذه الحقوق الممتازة جميعا تكون أسبق في المرتبة على أي حق امتياز عقاري آخر أو حق رهن رسمي مهما كان تاريخ قيده. أما فيما بينهما فالامتيا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_986_19750926_OpEnact_b12596dfe7> ;
    dzdoc:replacementText "تسري على حقوق الامتياز العقارية ، أحكام الرهن الرسمي بالقدر الذي لا تتعارض فيه مع طبيعة هذه الحقوق. وتسري بنوع خاص أحكام التطهير والقيد وما يترتب على القيد من آثار وما يتصل به من تجديد وشطب. غير أن حقوق الامتياز العامة ولو كانت مترتبة على عقار لا يجب فيها الاشهار ولا حق التتبع. ولا حاجة للإشهار أيضا في حقوق الامتياز العقارية الضامنة، بمبلغ مستحقه للخزينة العامة، وهذه الحقوق الممتازة جميعا تكون أسبق في المرتبة على أي حق امتياز عقاري آخر أو حق رهن رسمي مهما كان تاريخ قيده. أما فيما بينهما فالامتياز الضامن للمبالغ المستحقة للخزينة يتقدم على حقوق الامتياز العامة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_986> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_986> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

