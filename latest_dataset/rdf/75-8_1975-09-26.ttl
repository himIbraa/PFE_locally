<https://legal.dz/resource/order/1975-09-26/75-58#version_art_214> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الخيار للمدين وامتنع عن الاختيار، أو تعدد المدينون ولم يتفقوا فيما بينهم ، جاز للدائن أن يطلب من القاضي تعيين أجل يختار فيه المدين أو يتفق فيه المدينون ، فإذا لم يتم ذلك تولى القاضي بنفسه تعيين محل الالتزام . أما إذا كان الخيار للدائن وامتنع عن الاختيار أو تعدد الدائنون ولم يتفقوا فيما بينهم عين القاضي أجلا إن طلب المدين ذلك، فإذا انقضى الأجل انتقل الخيار إلى المدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_214_19750926_OpEnact_400f285411> ;
    dzdoc:replacementText "إذا كان الخيار للمدين وامتنع عن الاختيار، أو تعدد المدينون ولم يتفقوا فيما بينهم ، جاز للدائن أن يطلب من القاضي تعيين أجل يختار فيه المدين أو يتفق فيه المدينون ، فإذا لم يتم ذلك تولى القاضي بنفسه تعيين محل الالتزام . أما إذا كان الخيار للدائن وامتنع عن الاختيار أو تعدد الدائنون ولم يتفقوا فيما بينهم عين القاضي أجلا إن طلب المدين ذلك، فإذا انقضى الأجل انتقل الخيار إلى المدين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_214> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_214> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
