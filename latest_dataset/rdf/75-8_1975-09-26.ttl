<https://legal.dz/resource/order/1975-09-26/75-58#version_art_736> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للشركاء أن يتفقوا أثناء اجراءات القسمة النهائية على أن يقسم المال الشائع مهايأة بينهم ، وتظل هذه القسمة نافذة حتى تتم القسمة النهائية. فإذا تعذر اتفاق الشركاء على قسمة المهاية ، جاز للمحكمة أن تأمر بها إذا طلب منها ذلك أحد الشركاء وبعد الاستعانة، إذا اقتضى الأمر ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_736_19750926_OpEnact_a00dd92352> ;
    dzdoc:replacementText "يمكن للشركاء أن يتفقوا أثناء اجراءات القسمة النهائية على أن يقسم المال الشائع مهايأة بينهم ، وتظل هذه القسمة نافذة حتى تتم القسمة النهائية. فإذا تعذر اتفاق الشركاء على قسمة المهاية ، جاز للمحكمة أن تأمر بها إذا طلب منها ذلك أحد الشركاء وبعد الاستعانة، إذا اقتضى الأمر ذلك."@ar ;
