<https://legal.dz/resource/order/1975-09-26/75-58#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "يسري على الشروط الموضوعية الخاصة بصحة الزواج القانون الوطني لكل من الزوجين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_11_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_11_19750926_OpEnact_43a692cccc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
