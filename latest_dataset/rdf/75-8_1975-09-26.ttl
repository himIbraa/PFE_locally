<https://legal.dz/resource/order/1975-09-26/75-58#art_651_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_651> ;
    dzdoc:position 0 ;
    dzdoc:text "تعتبر كفالة الدين التجاري عملا مدنيا ولو كان الكفيل تاجرا."@ar .

