    dznorm:provisionText "تتقادم بسنتين حقوق الاطباء والصيادلة، والمحامين والمهندسين والخبراء، ووكلاء التفليسة، والسماسرة، والاساتذة والمعلمين"@ar ;
    dznorm:sourceArticle "art_310" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_310_para_0> a dzdoc:Paragraph ;
