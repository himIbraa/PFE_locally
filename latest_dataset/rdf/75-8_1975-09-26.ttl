<https://legal.dz/resource/order/1975-09-26/75-58#version_art_834> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينقطع التقادم المكسب إذا تخلى الحائز عن حيازته أو فقدها ولو بفعل الغير . غیر أن التقادم لا ينقطع بفقد الحيازة إذا استردها الحائز خلال سنة أو رفع دعوى باستردادها في هذا الميعاد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
