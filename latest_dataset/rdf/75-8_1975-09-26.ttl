    dzdoc:sourceEId "art_785" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "إذا كان من أقام المنشآت المشار إليها في المادة 784 يعتقد بحسن نية أن له الحق في إقامتها"@ar ;
    dzdoc:targetEId "art_784" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_785_condition_1_04d87e43> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت المنشآت قد بلغت حدا من الأهمية وكان تسديدها مرهقا لصاحب الأرض"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_785_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان من أقام المنشآت المشار إليها في المادة 784 يعتقد بحسن نية أن له الحق في إقامتها فليس لصاحب الأرض أن يطلب الازالة وإنما يخير بين أن يدفع قيمة المواد وأجرة العمل أو مبلغا يساوي ما زاد في قيمة الأرض بسبب هذه المنشآت هذا ما لم يطلب صاحب المنشآت نزعها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_785_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه إذا كانت المنشآت قد بلغت حدا من الأهمية وكان تسديدها مرهقا لصاحب الأرض جاز له أن يطلب تمليك الأرض لمن أقام المنشآت نظير تعويض عادل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_786_condition_0_63fa2028> a dznorm:Condition ;
    dznorm:conditionText "إذا أقام أجنبي منشآت بمواد من عنده بعد الترخيص له من مالك الأرض"@ar ;
