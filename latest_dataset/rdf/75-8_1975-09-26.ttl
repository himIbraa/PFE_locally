<https://legal.dz/resource/order/1975-09-26/75-58#art_271_condition_1_9770f2db> a dznorm:Condition ;
    dznorm:conditionText "فإذا كان هذا الشيء عقارا أو ما هو معد للبقاء حيث وجد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_271> ;
