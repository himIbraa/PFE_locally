<https://legal.dz/resource/order/1975-09-26/75-58#version_art_544> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على المستعير أن يبذل في المحافظة على الشيء العناية التي يبذلها في المحافظة على ماله بشرط أن لا يكون اهتمامه به أدنى من عناية الرجل المعتاد . وفي كل حال يكون ضامنا لهلاك الشيء إذا نشأ الهلاك عن حادث مفاجئ أو قوة قاهرة أو كان في وسعه أن يتحاشاه باستعمال شيء من ملكه الخاص، أو كان بين أن ينقذ شيئا مملوكا له أو الشيء المعار فاختار أن ينقذ ما يملكه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_544_19750926_OpEnact_21e82fc261> ;
    dzdoc:replacementText "على المستعير أن يبذل في المحافظة على الشيء العناية التي يبذلها في المحافظة على ماله بشرط أن لا يكون اهتمامه به أدنى من عناية الرجل المعتاد . وفي كل حال يكون ضامنا لهلاك الشيء إذا نشأ الهلاك عن حادث مفاجئ أو قوة قاهرة أو كان في وسعه أن يتحاشاه باستعمال شيء من ملكه الخاص، أو كان بين أن ينقذ شيئا مملوكا له أو الشيء المعار فاختار أن ينقذ ما يملكه ."@ar ;
