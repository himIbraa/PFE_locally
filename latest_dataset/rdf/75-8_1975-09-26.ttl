    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_848_obligation_0_68872b8b_role_f770c3744f> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_848> ;
    dznorm:position 0 ;
    dznorm:provisionText "يلزم المنتفع أثناء انتفاعه بكل ما يعرض على العين المنتفع بها من التكاليف المعتادة وبكل النفقات التي تقتضيها أعمال الصيانة"@ar ;
    dznorm:sourceArticle "art_848" .

