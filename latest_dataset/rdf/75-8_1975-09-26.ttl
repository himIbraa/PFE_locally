<https://legal.dz/resource/order/1975-09-26/75-58#version_art_156> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا مات الفضولي التزم ورثته بما يلزم به ورثة الوكيل طبقا لاحكام المادة 589 فقرة 2 . وإذا مات رب العمل بقي الفضولي ملتزما نحو الورثة بما كان ملزما به نحو مورثهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_156_19750926_OpEnact_730306a1b0> ;
