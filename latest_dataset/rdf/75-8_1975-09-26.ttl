    dznorm:position 0 ;
    dznorm:provisionText "ويقوم الدائن المرتهن بإجراء قيد جديد يبين فيه القدر الذي انتقل إليه الرهن خلال تسعين يوما من الوقت الذي يخطره فيه أي ذي شأن بتسجيل القسمة"@ar ;
    dznorm:sourceArticle "art_890" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_890_obligation_0_519a9495_period_68854038f5> a dznorm:Period ;
