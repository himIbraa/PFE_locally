<https://legal.dz/resource/order/1975-09-26/75-58#version_art_202> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينقضي الحق في الحبس بخروج الشيء من يد حائزه أو محرزه. غير انه لحابس الشيء إذا خرج من يده بغير علمه أو بالرغم من معارضته أن يطلب استرداده ، إذا هو قام بهذا الطلب خلال ثلاثين يوما من الوقت الذي علم فيه بخروج الشيء من يده ما لم تنقض سنة من وقت خروجه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_202_19750926_OpEnact_a84471a8e3> ;
