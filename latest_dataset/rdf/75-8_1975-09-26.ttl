<https://legal.dz/resource/order/1975-09-26/75-58#version_art_922> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون تخلية العقار المرهون بتقرير يقدمه الحائز إلى قلم كتاب المحكمة المختصة، و يجب عليه أن يطلب التأشير بذلك في هامش تسجيل التنبيه بنزع الملكية، وأن يعلن الدائن المباشر للإجراءات بهذه التخلية في خلال خمسة (5) أيام من وقت التقرير بها . يجوز لمن له مصلحة في التعجيل أن يطلب إلى قاضي الأمور المستعجلة تعيين حارس تتخذ في مواجهته إجراءات نزع الملكية . ويعين الطالب حارسا إذا طلب ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_922_19750926_OpEnact_49df971975> ;
    dzdoc:replacementText "تكون تخلية العقار المرهون بتقرير يقدمه الحائز إلى قلم كتاب المحكمة المختصة، و يجب عليه أن يطلب التأشير بذلك في هامش تسجيل التنبيه بنزع الملكية، وأن يعلن الدائن المباشر للإجراءات بهذه التخلية في خلال خمسة (5) أيام من وقت التقرير بها . يجوز لمن له مصلحة في التعجيل أن يطلب إلى قاضي الأمور المستعجلة تعيين حارس تتخذ في مواجهته إجراءات نزع الملكية . ويعين الطالب حارسا إذا طلب ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_922> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
