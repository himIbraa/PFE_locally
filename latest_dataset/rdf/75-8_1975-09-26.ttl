<https://legal.dz/resource/order/1975-09-26/75-58#version_art_795> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يثبت حق الشفعة وذلك مع مراعاة الأحكام التي ينص عليها الأمر المتعلق بالثورة الزراعية : لمالك الرقبة إذا بيع الكل أو البعض من حق الانتفاع المناسب للرقبة، للشريك في الشيوع إذا بيع جزء من العقار المشاع إلى أجنبي، لصاحب حق الانتفاع إذا بيعت الرقبة كلها أو بعضها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_795_19750926_OpEnact_6e12796ec6> ;
