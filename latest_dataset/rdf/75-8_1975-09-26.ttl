    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_402> ;
    dznorm:position 0 ;
    dznorm:provisionText "لا يجوز للقضاة، ولا للمدافعين القضائيين، ولا للمحامين ولا للموثقين ولا لكتاب الضبط، أن يشتروا بانفسهم مباشرة ولا بواسطة اسم مستعار الحق المتنازع فيه كله أو بعضه"@ar ;
    dznorm:sourceArticle "art_402" .

