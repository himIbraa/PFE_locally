<https://legal.dz/resource/order/1975-09-26/75-58#version_art_719> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتحمل جميع الشركاء، كل بقدر حصته نفقات إدارة المال الشائع، وحفظه، والضرائب المفروضة عليه، وسائر التكاليف الناتجة عن الشيوع أو المقررة على المال ، كل ذلك ما لم يوجد نص يقضي بغير ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_719_19750926_OpEnact_eb320aebe9> ;
