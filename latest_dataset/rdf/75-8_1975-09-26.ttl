<https://legal.dz/resource/order/1975-09-26/75-58#version_art_661> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا طلب الكفيل التجريد ، وجب عليه أن يقوم على نفقته بارشاد الدائن إلى أموال المدين تفي بالدين كله . ولا يؤخذ بعين الاعتبار الأموال التي يدل عليها الكفيل إذا كانت هذه الأموال تقع خارج الأراضي الجزائرية، أو كانت متنازعا فيها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
