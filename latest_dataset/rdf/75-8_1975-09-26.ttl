<https://legal.dz/resource/order/1975-09-26/75-58#version_art_680> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم الاستيلاء بصفة فردية أو جماعية ويكون كتابيا. يوقع الأمر من طرف الوالي أو كل سلطة مؤهلة قانونا ويوضح فيه إذا كان الاستيلاء بقصد الحصول على الأموال أو الخدمات، ويبين طبيعة وصفة و/أو مدة الخدمة وعند الاقتضاء مبلغ وطرق دفع التعويض و/أو الأجر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
