<https://legal.dz/resource/order/1975-09-26/75-58#version_art_371> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يضمن البائع عدم التعرض للمشتري في الانتفاع بالمبيع كله أو بعضه سواء كان التعرض من فعله أو من فعل الغير يكون له وقت البيع حق على المبيع يعارض به المشتري. ويكون البائع مطالبا بالضمان ولو كان حق ذلك الغير قد ثبت بعد البيع وقد آل إليه هذا الحق من البائع نفسه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_371_19750926_OpEnact_d13c43b10f> ;
    dzdoc:replacementText "يضمن البائع عدم التعرض للمشتري في الانتفاع بالمبيع كله أو بعضه سواء كان التعرض من فعله أو من فعل الغير يكون له وقت البيع حق على المبيع يعارض به المشتري. ويكون البائع مطالبا بالضمان ولو كان حق ذلك الغير قد ثبت بعد البيع وقد آل إليه هذا الحق من البائع نفسه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
