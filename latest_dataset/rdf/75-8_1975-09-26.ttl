<https://legal.dz/resource/order/1975-09-26/75-58#version_art_39> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز اختيار موطن خاص لتنفيذ تصرف قانوني معين. يجب اثبات اختيار الموطن كتابة . الموطن المختار لتنفيذ تصرف قانوني يعد موطنا بالنسبة إلى كل ما يتعلق بهذا التصرف بما في ذلك اجراءات التنفيذ الجبري ما لم يشترط صراحة هذا الموطن على تصرفات معينة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_39_19750926_OpEnact_43c3347789> ;
