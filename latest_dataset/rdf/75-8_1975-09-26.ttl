<https://legal.dz/resource/order/1975-09-26/75-58#version_art_884> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أن يكون الراهن هو المدين نفسه أو شخصا آخر يقدم رهنا لمصلحة المدين. وفي كلتا الحالتين يجب أن يكون الراهن مالكا للعقار المرهون وأهلا للتصرف فيه ."@ar ;
