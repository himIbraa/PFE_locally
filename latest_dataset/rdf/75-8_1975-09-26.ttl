    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_566> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_566_obligation_1_edb5cfa4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_566> ;
    dznorm:position 1 ;
    dznorm:provisionText "يتعين عليها بوجه خاص أن ينقص منه ما يكون المقاول قد اقتصده من جراء تحلل رب العمل من العقد وما يكون قد كسبه باستخدام وقته في أمر آخر"@ar ;
    dznorm:sourceArticle "art_566" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_566_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_566> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن لرب العمل أن يتحلل من العقد ويوقف التنفيذ في أي وقت قبل إتمامه. على أن يعوض المقاول عن جميع ما أنفقه من المصروفات، وما أنجزه من الأعمال وما كان يستطيع كسبه لو أنه أتم العمل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_566_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_566> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه يجوز للمحكمة أن تخفض مبلغ التعويض المستحق عما فات المقاول من كسب إذا كانت الظروف تجعل هذا التخفيض عادلا، ويتعين عليها بوجه خاص أن ينقص منه ما يكون المقاول قد اقتصده من جراء تحلل رب العمل من العقد وما يكون قد كسبه باستخدام وقته في أمر آخر."@ar .

