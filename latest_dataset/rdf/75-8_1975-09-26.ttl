<https://legal.dz/resource/order/1975-09-26/75-58#version_art_899> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تسبب الراهن بخطئه في هلاك العقار المرهون أو تلفه كان للدائن المرتهن الخيار بين أن يطلب تأمينا كافيا أو أن يستوفي حقه فورا . وإذا نشأ الهلاك أو التلف عن سبب لا ينسب إلى الدائن ولم يقبل الدائن بقاء الدين بلا تأمين ، فللمدين الخيار بين أن يقدم تأمينا كافيا أو أن يوفي الدين فورا قبل حلول الأجل . وفي جميع الأحوال إذا كان من شأن الأعمال الواقعة أن تعرض العقار المرهون للهلاك أو للتلف أو جعله غير كاف للضمان ، كان للدائن المرتهن أن يطلب من القاضي وقف هذه الأعمال والأمر باتخاذ الوسائل التي تمنع وقوع ا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_899_19750926_OpEnact_6bf4f28510> ;
    dzdoc:replacementText "إذا تسبب الراهن بخطئه في هلاك العقار المرهون أو تلفه كان للدائن المرتهن الخيار بين أن يطلب تأمينا كافيا أو أن يستوفي حقه فورا . وإذا نشأ الهلاك أو التلف عن سبب لا ينسب إلى الدائن ولم يقبل الدائن بقاء الدين بلا تأمين ، فللمدين الخيار بين أن يقدم تأمينا كافيا أو أن يوفي الدين فورا قبل حلول الأجل . وفي جميع الأحوال إذا كان من شأن الأعمال الواقعة أن تعرض العقار المرهون للهلاك أو للتلف أو جعله غير كاف للضمان ، كان للدائن المرتهن أن يطلب من القاضي وقف هذه الأعمال والأمر باتخاذ الوسائل التي تمنع وقوع الضرر ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_899> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
