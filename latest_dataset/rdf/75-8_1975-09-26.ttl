<https://legal.dz/resource/order/1975-09-26/75-58#version_art_821> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لمن حاز عقارا واستمر حائزا له مدة سنة كاملة وخشي لأسباب معقولة التعرض له من جراء أعمال جديدة تهدد حيازته أن يرفع الأمر إلى القاضي طالبا وقف هذه الأعمال بشرط أن لا تكون قد تمت ولم ينقض عام واحد على البدء في العمل الذي يكون من شأنه أن يحدث الضرر . وللقاضي أن يمنع استمرار الأعمال أو أن يأذن في استمرارها وفي كلتا الحالتين يجوز للقاضي أن يأمر بتقديم كفالة مناسبة تكون في حالة صدور الحكم بالوقف ضمانا لإصلاح الضرر الناشئ من هذا الوقف إذا تبين بحكم نهائي أن الاعتراض على استمرار الأعمال كان على غير أ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_821_19750926_OpEnact_372485e5ad> ;
    dzdoc:replacementText "يجوز لمن حاز عقارا واستمر حائزا له مدة سنة كاملة وخشي لأسباب معقولة التعرض له من جراء أعمال جديدة تهدد حيازته أن يرفع الأمر إلى القاضي طالبا وقف هذه الأعمال بشرط أن لا تكون قد تمت ولم ينقض عام واحد على البدء في العمل الذي يكون من شأنه أن يحدث الضرر . وللقاضي أن يمنع استمرار الأعمال أو أن يأذن في استمرارها وفي كلتا الحالتين يجوز للقاضي أن يأمر بتقديم كفالة مناسبة تكون في حالة صدور الحكم بالوقف ضمانا لإصلاح الضرر الناشئ من هذا الوقف إذا تبين بحكم نهائي أن الاعتراض على استمرار الأعمال كان على غير أساس وتكون في حالة الحكم باستمرار الأعمال ضمانا لازالة هذه الأعمال كلها أو بعضها للتعويض عن الضرر الذي يصيب الحائز إذا حصل على حكم نهائي في مصلحته."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_821> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_821> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_822> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تنازع أشخاص متعددون في حيازة حق واحد اعتبر بصفة مؤقتة أن حائزه هو من كانت له الحيازة المادية الا إذا كان قد اكتسب هذه الحيازة عن طريق التدليس."@ar ;
