    dznorm:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_192_condition_4_797f04a3> a dznorm:Condition ;
    dznorm:conditionText "إذا كان المتبرع له حول بعوض المال الذي نقل إليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dznorm:position 4 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_192_condition_5_f8ea8f97> a dznorm:Condition ;
    dznorm:conditionText "إذا كان المحال إليه والمتبرع له قد علما بغش المدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dznorm:position 5 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_192_condition_6_5718bc97> a dznorm:Condition ;
    dznorm:conditionText "إذا كان تصرف المدين بدون عوض وعلم المحال إليه بعسر المدين وقت صدور التصرف لصالح المتبرع له"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dznorm:position 6 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_192_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان تصرف المدين بعوض، فإنه لا يكون حجة على الدائن إذا كان هناك غش صدر من المدين، وإذا كان الطرف الآخر قد علم بذلك الغش يكفي لاعتبار التصرف منطويا على الغش أن يكون قد صدر من المدين وهو عالم بعسره."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_192_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:position 1 ;
    dzdoc:text "كما يعتبر من صدر له التصرف عالما بغش المدين إذا كان قد علم أن هذا المدين في حالة عسر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_192_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:position 2 ;
    dzdoc:text "أما إذا كان التصرف الذي قام به المدين تبرعا فإنه لا يحتج به على الدائن، ولو كان المتبرع له حسن النية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_192_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:position 3 ;
    dzdoc:text "إذا كان المتبرع له حول بعوض المال الذي نقل إليه فليس للدائن أن يتمسك بعدم الاحتجاج عليه بتصرف مدينه إلا إذا كان المحال إليه والمتبرع له قد علما بغش المدين هذا في حالة ما إذا تصرف المدين بعوض وكذلك الحال إذا كان تصرف المدين بدون عوض وعلم المحال إليه بعسر المدين وقت صدور التصرف لصالح المتبرع له."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_193_condition_0_3b9c4ecd> a dznorm:Condition ;
    dznorm:conditionText "إذا ادعى الدائن عسر المدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_193> ;
    dznorm:position 0 .

