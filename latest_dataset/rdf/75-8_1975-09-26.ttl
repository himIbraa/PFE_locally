    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_prohibition_0_81339676> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
