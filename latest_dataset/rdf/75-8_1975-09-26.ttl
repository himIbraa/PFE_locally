<https://legal.dz/resource/order/1975-09-26/75-58#version_art_610> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلتزم الحارس باتخاذ دفاتر حساب منظمة ويجوز للقاضي إلزامه باتخاذ دفاتر موقع عليها من طرفه. ويلتزم أن يقدم لذوي الشأن في كل سنة على الأقل حسابا على ما قبضه وما أنفقه مؤيدا بمستندات مثبتة له . وإذا كان الحارس قد عينه القاضي وجب عليه فوق ذلك أن يودع صورة هذا الحساب بقلم الكتاب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
