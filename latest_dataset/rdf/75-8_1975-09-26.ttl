<https://legal.dz/resource/order/1975-09-26/75-58#version_art_210> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تبين من الالتزام أن المدين لا يقوم بوفائه الا عند المقدرة أو الميسرة ، عين القاضي ميعادا مناسبا لحلول الأجل، مراعيا في ذلك موارد المدين الحالية والمستقبلة مع اشتراط عناية الرجل الحريص على الوفاء بالتزامه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_210_19750926_OpEnact_b8d0e78872> ;
    dzdoc:replacementText "إذا تبين من الالتزام أن المدين لا يقوم بوفائه الا عند المقدرة أو الميسرة ، عين القاضي ميعادا مناسبا لحلول الأجل، مراعيا في ذلك موارد المدين الحالية والمستقبلة مع اشتراط عناية الرجل الحريص على الوفاء بالتزامه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_210> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
