<https://legal.dz/resource/order/1975-09-26/75-58#art_452_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_452> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا استحق الشيء فإن أحكام المادة 538 وما بعدها والخاصة بالعارية هي التي تطبق."@ar .

