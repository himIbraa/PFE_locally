    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_936> ;
    dznorm:position 0 ;
    dznorm:provisionText "حقوق الرهن على هذا العقار تنقضي بإيداع الثمن الذي رسا به المزاد، أو بدفعه إلى الدائنين المقيدين الذين تسمح مرتبتهم باستيفاء حقوقهم من هذا الثمن"@ar ;
    dznorm:sourceArticle "art_936" .

