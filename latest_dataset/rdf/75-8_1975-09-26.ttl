<https://legal.dz/resource/order/1975-09-26/75-58#version_art_782> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل ما على الأرض أو تحتها من غراس أو بناء أو منشآت أخرى يعتبر من عمل صاحب الأرض وأقامه على نفقته ويكون مملوكا له. غير أنه يجوز أن تقام البينة على أن أجنبيا أقام المنشآت على نفقته كما يجوز أن تقام البينة على أن صاحب الأرض قد خول أجنبيا ملكية منشآت كانت قائمة من قبل أو خوله الحق في إقامة هذه المنشآت وفي تملكها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_782_19750926_OpEnact_d6c2b6e279> ;
    dzdoc:replacementText "كل ما على الأرض أو تحتها من غراس أو بناء أو منشآت أخرى يعتبر من عمل صاحب الأرض وأقامه على نفقته ويكون مملوكا له. غير أنه يجوز أن تقام البينة على أن أجنبيا أقام المنشآت على نفقته كما يجوز أن تقام البينة على أن صاحب الأرض قد خول أجنبيا ملكية منشآت كانت قائمة من قبل أو خوله الحق في إقامة هذه المنشآت وفي تملكها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_782> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_782> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
