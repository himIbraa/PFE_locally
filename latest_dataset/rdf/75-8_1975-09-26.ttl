    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_502> ;
    dznorm:position 1 ;
    dznorm:provisionText "وجب عليه أن يدفع للمؤجر تعويضا باعتبار القيمة الإيجارية للعين وباعتبار ما لحق المؤجر من ضرر"@ar ;
