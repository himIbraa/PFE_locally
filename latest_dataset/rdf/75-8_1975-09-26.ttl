    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتهي حق الارتفاق إذا تغير وضع الأشياء بحيث تصبح في حالة لا يمكن فيها استعمال هذا الحق ، و يعود إذا عادت الأشياء إلى وضع يمكن معه استعمال الحق إلا أن يكون قد انتهى بعدم الاستعمال ."@ar ;
