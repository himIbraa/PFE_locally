<https://legal.dz/resource/order/1975-09-26/75-58#version_art_336> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز الإثبات بالشهود أيضا فيما كان يجب إثباته بالكتابة : إذا وجد مانع مادي أو أدبي يحول دون الحصول على دليل كتابي، إذا فقد الدائن سنده الكتابي لسبب أجنبي خارج عن إرادته."@ar ;
