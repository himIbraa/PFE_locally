<https://legal.dz/resource/order/1975-09-26/75-58#version_art_810> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تصح الحيازة بالوساطة متى كان الوسيط يباشرها باسم الحائز وكان متصلا به اتصالا يلزمه الائتمار بأوامره فيما يتعلق بهذه الحيازة وذلك كله مع مراعاة أحكام الأمر الصادر في شأن الثورة الزراعية. وعند الشك يفترض أن مباشر الحيازة إنما يحوز لنفسه فإن كانت الحيازة استمرارا الحيازة سابقة افترض أن هذا الاستمرار هو لحساب البادئ بها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_810_19750926_OpEnact_a4645a9980> ;
    dzdoc:replacementText "تصح الحيازة بالوساطة متى كان الوسيط يباشرها باسم الحائز وكان متصلا به اتصالا يلزمه الائتمار بأوامره فيما يتعلق بهذه الحيازة وذلك كله مع مراعاة أحكام الأمر الصادر في شأن الثورة الزراعية. وعند الشك يفترض أن مباشر الحيازة إنما يحوز لنفسه فإن كانت الحيازة استمرارا الحيازة سابقة افترض أن هذا الاستمرار هو لحساب البادئ بها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_810> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
