<https://legal.dz/resource/order/1975-09-26/75-58#version_art_764> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتخذ قرارات الجمعية عن طريق الاقتراع بالأغلبية البسيطة أو الأغلبية المحددة، ويتكفل بتنفيذ هذه القرارات متصرف العقار ، الذي يوضع مباشرة تحت مراقبة الجمعية . يعد هذا المتصرف ، وكيلا للجمعية ، ويمثلها لدى القضاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_19750926_OpEnact_b79a185810> ;
    dzdoc:replacementText "تتخذ قرارات الجمعية عن طريق الاقتراع بالأغلبية البسيطة أو الأغلبية المحددة، ويتكفل بتنفيذ هذه القرارات متصرف العقار ، الذي يوضع مباشرة تحت مراقبة الجمعية . يعد هذا المتصرف ، وكيلا للجمعية ، ويمثلها لدى القضاء ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_764> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_764> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
