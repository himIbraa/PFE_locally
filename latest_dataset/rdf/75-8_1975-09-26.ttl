<https://legal.dz/resource/order/1975-09-26/75-58#version_art_281> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتم الوفاء فور ترتيب الالتزام نهائيا في ذمة المدين ما لم يوجد اتفاق أو نص يقضي بغير ذلك . غير أنه يجوز للقضاء نظرا لمركز المدين، ومراعاة للحالة الاقتصادية أن يمنحوا آجالا ملائمة للظروف دون أن تتجاوز هذه مدة سنة وان يوقفوا التنفيذ مع إبقاء جميع الأمور على حالها . وفي حالة الاستعجال يكون منح الاجال من اختصاص قاضي الأمور المستعجلة. وفي حالة ايقاف التنفيذ فإن الاجال المنصوص عليها في قانون الاجراءات المدنية، بصحة إجراءات التنفيذ تبقى موقوفة إلى انقضاء الأجل الذي منحه القاضي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_281_19750926_OpEnact_42ad8d4e0a> ;
    dzdoc:replacementText "يجب أن يتم الوفاء فور ترتيب الالتزام نهائيا في ذمة المدين ما لم يوجد اتفاق أو نص يقضي بغير ذلك . غير أنه يجوز للقضاء نظرا لمركز المدين، ومراعاة للحالة الاقتصادية أن يمنحوا آجالا ملائمة للظروف دون أن تتجاوز هذه مدة سنة وان يوقفوا التنفيذ مع إبقاء جميع الأمور على حالها . وفي حالة الاستعجال يكون منح الاجال من اختصاص قاضي الأمور المستعجلة. وفي حالة ايقاف التنفيذ فإن الاجال المنصوص عليها في قانون الاجراءات المدنية، بصحة إجراءات التنفيذ تبقى موقوفة إلى انقضاء الأجل الذي منحه القاضي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_281> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_281> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_282> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان محل الالتزام شيئا معينا بالذات، وجب تسليمه في المكان الذي كان موجودا فيه وقت نشوء الالتزام ما لم يوجد اتفاق أو نص يقضي بغير ذلك . أما في الالتزامات الأخرى فيكون الوفاء في المكان الذي يوجد فيه موطن المدين وقت الوفاء ، أو في المكان الذي يوجد فيه مركز مؤسسته إذا كان الالتزام متعلقا بهذه المؤسسة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_282_19750926_OpEnact_25417ad4ca> ;
    dzdoc:replacementText "إذا كان محل الالتزام شيئا معينا بالذات، وجب تسليمه في المكان الذي كان موجودا فيه وقت نشوء الالتزام ما لم يوجد اتفاق أو نص يقضي بغير ذلك . أما في الالتزامات الأخرى فيكون الوفاء في المكان الذي يوجد فيه موطن المدين وقت الوفاء ، أو في المكان الذي يوجد فيه مركز مؤسسته إذا كان الالتزام متعلقا بهذه المؤسسة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_282> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
