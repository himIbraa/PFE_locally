<https://legal.dz/resource/order/1975-09-26/75-58#version_art_955> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تسلم الدائن المرتهن الشيء المرهون فعليه أن يبذل في حفظه و وصيانته من العناية ما يبذله الشخص المعتاد وهو مسؤول عن هلاك الشيء أو تلفه ما لم يثبت أن ذلك يرجع لسبب لا يد له فيه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_955_19750926_OpEnact_23bf46d159> ;
