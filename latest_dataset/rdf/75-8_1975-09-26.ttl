<https://legal.dz/resource/order/1975-09-26/75-58#version_art_698> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إن القاعدة والكيفية التي يتم بهما ارتفاق حق المرور بسبب الحصر تحددان بـ تقادم خمسة عشرة (15) سنة فإذا اكتملت هذه المدة فلا يجوز لصاحب العقار المحصور تغيير قاعدة الارتفاق، ولا تحويلها أو نقلها من طرف صاحب العقار المرتفق به دون إذن من صاحب العقار المحصور."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_698_19750926_OpEnact_1346fda2d4> ;
    dzdoc:replacementText "إن القاعدة والكيفية التي يتم بهما ارتفاق حق المرور بسبب الحصر تحددان بـ تقادم خمسة عشرة (15) سنة فإذا اكتملت هذه المدة فلا يجوز لصاحب العقار المحصور تغيير قاعدة الارتفاق، ولا تحويلها أو نقلها من طرف صاحب العقار المرتفق به دون إذن من صاحب العقار المحصور."@ar ;
