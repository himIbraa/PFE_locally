<https://legal.dz/resource/order/1975-09-26/75-58#version_art_720> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للشركاء الذين يملكون على الأقل ثلاثة أرباع (3/4) المال الشائع أن يقرروا التصرف فيه إذا استندوا في ذلك إلى أسباب قوية على أن يعلنوا بعقد غير قضائي قراراتهم إلى باقي الشركاء ولمن خالف من هؤلاء حق الرجوع إلى المحكمة خلال شهرين من وقت الاعلان ، وللمحكمة عندما تكون قسمة المال الشائع ضارة بمصالح الشركاء ، أن تقدر تبعا للظروف ما إذا كان التصرف واجبا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_720_19750926_OpEnact_292805edc6> ;
    dzdoc:replacementText "للشركاء الذين يملكون على الأقل ثلاثة أرباع (3/4) المال الشائع أن يقرروا التصرف فيه إذا استندوا في ذلك إلى أسباب قوية على أن يعلنوا بعقد غير قضائي قراراتهم إلى باقي الشركاء ولمن خالف من هؤلاء حق الرجوع إلى المحكمة خلال شهرين من وقت الاعلان ، وللمحكمة عندما تكون قسمة المال الشائع ضارة بمصالح الشركاء ، أن تقدر تبعا للظروف ما إذا كان التصرف واجبا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_720> ;
