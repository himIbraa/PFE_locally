<https://legal.dz/resource/order/1975-09-26/75-58#art_304_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_304> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا زال السبب الذي أدى لاتحاد الذمة وكان لزواله أثر رجعي عاد الدين إلى الوجود بملحقاته بالنسبة إلى المعنيين بالأمر ويعتبر اتحاد الذمة كانه لم يكن."@ar .

