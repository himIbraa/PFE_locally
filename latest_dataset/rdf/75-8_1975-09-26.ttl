<https://legal.dz/resource/order/1975-09-26/75-58#version_art_378> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبقى البائع مسؤولا عن كل نزع يد ينشأ عن فعله ولو وقع الاتفاق على عدم الضمان ويقع باطلا كل اتفاق يقضي بغير ذلك. وإذا كان نزع اليد عن المبيع من فعل الغير فإن البائع يبقى مطالبا قبل المشتري برد قيمة المبيع وقت نزع اليد الا إذا اثبت أن المشتري كان يعلم وقت البيع سبب نزع اليد، أو انه اشتری تحت مسؤولیته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_378_19750926_OpEnact_c062d71b23> ;
    dzdoc:replacementText "يبقى البائع مسؤولا عن كل نزع يد ينشأ عن فعله ولو وقع الاتفاق على عدم الضمان ويقع باطلا كل اتفاق يقضي بغير ذلك. وإذا كان نزع اليد عن المبيع من فعل الغير فإن البائع يبقى مطالبا قبل المشتري برد قيمة المبيع وقت نزع اليد الا إذا اثبت أن المشتري كان يعلم وقت البيع سبب نزع اليد، أو انه اشتری تحت مسؤولیته ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
