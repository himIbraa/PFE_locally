<https://legal.dz/resource/order/1975-09-26/75-58#version_art_970> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسري على الرهن المنقول ، الأحكام المتعلقة بالآثار التي تترتب على حيازة المنقولات المادية والسندات لحاملها. وبوجه خاص يكون للمرتهن حسن النية أن يتمسك بحقه في الرهن ولو كان الراهن لا يملك التصرف في الشيء المرهون . كما يجوز من جهة أخرى لكل حائز حسن النية أن يتمسك بالحق الذي كسبه على الشيء المرهون ولو كان ذلك لاحقا لتاريخ الرهن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_970_19750926_OpEnact_afb1ac7c6f> ;
    dzdoc:replacementText "تسري على الرهن المنقول ، الأحكام المتعلقة بالآثار التي تترتب على حيازة المنقولات المادية والسندات لحاملها. وبوجه خاص يكون للمرتهن حسن النية أن يتمسك بحقه في الرهن ولو كان الراهن لا يملك التصرف في الشيء المرهون . كما يجوز من جهة أخرى لكل حائز حسن النية أن يتمسك بالحق الذي كسبه على الشيء المرهون ولو كان ذلك لاحقا لتاريخ الرهن ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_970> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
