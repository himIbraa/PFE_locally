<https://legal.dz/resource/order/1975-09-26/75-58#version_art_772_19750926_OpEnact_be936395c3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_772> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_772> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_772> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتقادم بعشرة (10) أعوام الدعاوى الشخصية التي تنشأ عن تطبيق نظام الملكية المشتركة بين الشاغلين وبين أحد الشاغلين والمتصرف . أما الدعاوى التي يكون من شأنها معارضة قرار الجمعية فيجب أن تقدم من طرف الشاغلين المعارضين منهم أو الغائبين في مدة شهرين ابتداءا من يوم إعلانها من طرف المتصرف وإلا سقطت الدعوى ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_773_19750926_OpEnact_b1413d2e67> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_773> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_773> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_773> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تعتبر ملكا من أملاك الدولة جميع الاموال الشاغرة التي ليس لها مالك، وكذلك أموال الاشخاص الذين يموتون عن غير وارث أو الذين تهمل تركتهم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_774_19750926_OpEnact_63fdd5155a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_774> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_774> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_774> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري أحكام قانون الاحوال الشخصية على تعيين الورثة وتحديد انصبتهم في الميراث وعلى انتقال أموال التركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_775_19750926_OpEnact_38edc5b695> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_775> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_775> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_775> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يسري على الوصية قانون الاحوال الشخصية والنصوص القانونية المتعلقة بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_776_19750926_OpEnact_cc21fd02d5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_776> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_776> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_776> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل تصرف قانوني يصدر عن شخص في حال مرض الموت بقصد التبرع يعتبر تبرعا مضافا إلى ما بعد الموت ، وتسري عليه أحكام الوصية أيا كانت التسمية التي تعطى إلى هذا التصرف. وعلى ورثة المتصرف أن يثبتوا ان التصرف القانوني قد صدر عن مورثهم وهو في مرض الموت ولهم إثبات بجميع الطرق، ولا يحتج على الورثة بتاريخ العقد إذا لم يكن هذا التاريخ ثابتا . إذا اثبت الورثة ان التصرف صدر عن مورثهم في مرض الموت اعتبر التصرف صادرا على سبيل التبرع ما لم يثبت من صدر له التصرف خلاف ذلك ، كل هذا ما لم توجد أحكام خاصة تخالفه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_777_19750926_OpEnact_8dd46c427b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_777> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_777> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_777> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر التصرف وصية وتجري عليه أحكامها إذا تصرف شخص لأحد ورثته واستثنى لنفسه بطريقة ما حيازة الشيء المتصرف فيه والانتفاع به مدة حياته ما لم يكن هناك دليل يخالف ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_778_19750926_OpEnact_cf022e08d2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_778> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_778> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_778> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الأرض التي تتكون من طمي يجلبه النهر بطريقة تدريجية غير محسوسة تكون ملكا للمالكين المجاورين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_779_19750926_OpEnact_eafed59827> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_779> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_779> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_779> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تكون ملكا للدولة الأرض التي ينكشف عنها البحر. لا يجوز التعدي على أرض البحر ، والأرض التي تستخلص بكيفية صناعية من مياه البحر تكون ملكا للدولة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_77_19750926_OpEnact_96a960678d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_77> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_77> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_77> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز لشخص أن يتعاقد مع نفسه باسم من ينوب عنه سواء أكان التعاقد لحسابه هو أم لحساب شخص آخر، دون ترخيص من الأصيل على أنه يجوز للأصيل في هذه الحالة أن يجيز التعاقد كل ذلك مع مراعاة ما يخالفه، مما يقضي به القانون وقواعد التجارة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_780_19750926_OpEnact_041876fd96> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_780> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_780> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_780> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "أن مالكي الأراضي الملاصقة للمياه الراكدة كمياه البحيرات والبرك لا يملكون الأراضي التي تنكشف عنها هذه المياه لا تزول ملكيتهم عن الاراضي التي طغت عليها المياه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_781_19750926_OpEnact_445af89c5b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_781> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_781> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_781> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الأراضي التي يحولها النهر من مكانها أو ينكشف عنها والجزر التي تتكون في مجراه تكون ملكيتها خاضعة للقوانين الخاصة بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_782_19750926_OpEnact_d6c2b6e279> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_782> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_782> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_782> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل ما على الأرض أو تحتها من غراس أو بناء أو منشآت أخرى يعتبر من عمل صاحب الأرض وأقامه على نفقته ويكون مملوكا له. غير أنه يجوز أن تقام البينة على أن أجنبيا أقام المنشآت على نفقته كما يجوز أن تقام البينة على أن صاحب الأرض قد خول أجنبيا ملكية منشآت كانت قائمة من قبل أو خوله الحق في إقامة هذه المنشآت وفي تملكها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_783_19750926_OpEnact_613cd409ac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_783> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_783> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_783> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون ملكا خالصا لصاحب الأرض ما يحدثه فيها من غراس أو بناء أو منشآت أخرى يقيمها بمواد مملوكة لغيره إذا لم يكن ممكنا نزع هذه المواد دون أن يلحق المنشآت ضرر جسيم أو كان ممكنا نزعها ولكن لم ترفع الدعوى بالاسترداد خلال سنة من اليوم الذي علم فيه مالك المواد أنها اندمجت في هذه المنشآت . إذا تملك صاحب الأرض المواد كان عليه أن يدفع قيمتها مع التعويض عن الضرر الحاصل إذا اقتضى الحال ذلك . وفي حالة استرداد المواد من صاحبها فإن نزعها يكون على نفقة مالك الأرض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_784_19750926_OpEnact_3a32cd128c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_784> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أقام شخص المنشآت بمواد من عنده على أرض يعلم أنها ملك لغيره دون رضاء صاحبها فلصاحب الأرض أن يطلب في أجل سنة من اليوم الذي علم فيه بإقامة المنشآت إزالة المنشآت على نفقة من أقامها مع التعويض عن الضرر إذا اقتضى الحال ذلك، أو أن يطلب استبقاءها مقابل دفع قيمتها أو قيمتها في حالة الهدم أو دفع مبلغ يساوي ما زاد في ثمن الأرض بسبب وجود المنشآت بها. ويجوز لمن أقام المنشآت أن يطلب نزعها أن كان ذلك لا يلحق بالأرض ضررا الا إذا اختار صاحب الأرض استبقاءها طبقا لأحكام الفقرة السابقة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_785_19750926_OpEnact_5e000b448a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_785> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان من أقام المنشآت المشار إليها في المادة 784 يعتقد بحسن نية أن له الحق في إقامتها فليس لصاحب الأرض أن يطلب الازالة وإنما يخير بين أن يدفع قيمة المواد وأجرة العمل أو مبلغا يساوي ما زاد في قيمة الأرض بسبب هذه المنشآت هذا ما لم يطلب صاحب المنشآت نزعها. غير أنه إذا كانت المنشآت قد بلغت حدا من الأهمية وكان تسديدها مرهقا لصاحب الأرض جاز له أن يطلب تمليك الأرض لمن أقام المنشآت نظير تعويض عادل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_786_19750926_OpEnact_ac97f50070> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_786> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_786> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_786> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أقام أجنبي منشآت بمواد من عنده بعد الترخيص له من مالك الأرض فلا يجوز لمالك الأرض أن يطلب إزالة المنشآت إذا لم يوجد اتفاق في شأنها ، و يجب عليه أن يدفع للغير إذا لم يطلب هذا الأجر نزعها إحدى القيمتين المنصوص عليهما في الفقرة الأولى من المادة 785 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_787_19750926_OpEnact_779ed61c33> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_787> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_787> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_787> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تطبق أحكام المادة 841 في أداء التعويض المنصوص عليه في المواد 784 و 785 و 786 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_788_19750926_OpEnact_5f13573c46> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_788> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_788> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_788> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان مالك الأرض وهو يقيم بناء بها قد تعدى بحسن نية على جزء من الأرض الملاصقة جاز للمحكمة إذا رأت محلا لذلك أن تجبر صاحب الأرض الملاصقة على أن يتنازل لجاره عن ملكية الجزء المشغول بالبناء مقابل تعويض عادل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_789_19750926_OpEnact_8bf9ff003c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_789> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_789> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_789> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "المنشآت الصغيرة كالأكشاك والحوانيت والمأوى التي تقام على أرض الغير من دون أن يكون مقصودا بقاؤها على الدوام تكون ملكا لمن أقامها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_78_19750926_OpEnact_e07859acf3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_78> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_78> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_78> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل شخص أهل للتعاقد ما لم يطرأ على أهليته عارض يجعله ناقص الأهلية أو فاقدها بحكم القانون ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_790_19750926_OpEnact_9dc0fd16ff> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_790> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_790> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_790> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أقام أجنبي منشآت بمواد مملوكة لغيره فليس لمالك المواد أن يطلب استردادها وإنما يكون له أن يرجع بالتعويض على هذا الاجنبي كما له أن يرجع على مالك الأرض بما لا يزيد على ما هو باق في ذمته من قيمة تلك المنشآت ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_791_19750926_OpEnact_9ba49ff9be> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_791> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_791> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_791> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا التصق منقولان لمالكين مختلفين بحيث لا يمكن فصلهما دون تلف قضت المحكمة أن لم يكن هناك اتفاق بين المالكين مسترشدة بقواعد العدالة ومراعية في ذلك الضرر الذي حدث وحالة الطرفين وحسن نية كل منهما."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_792_19750926_OpEnact_dfad596b7e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_792> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_792> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_792> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنقل الملكية وغيرها من الحقوق العينية في العقار بالعقد متى كان الشيء مملوكا للمتصرف طبقا للمادة 164 وذلك مع مراعاة النصوص التالية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_793_19750926_OpEnact_9dbff27349> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_793> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_793> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_793> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تنقل الملكية و الحقوق العينية الأخرى في العقار سواء كان ذلك بين المتعاقدين أم في حق الغير إلا إذا روعيت الاجراءات التي ينص عليها القانون وبالأخص القوانين التي تدير مصلحة شهر العقار ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_794_19750926_OpEnact_f7415b5789> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_794> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_794> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_794> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الشفعة رخصة تجيز الحلول محل المشتري في بيع العقار ضمن الأحوال والشروط المنصوص عليها في المواد التالية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_795_19750926_OpEnact_6e12796ec6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_795> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_795> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_795> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يثبت حق الشفعة وذلك مع مراعاة الأحكام التي ينص عليها الأمر المتعلق بالثورة الزراعية : لمالك الرقبة إذا بيع الكل أو البعض من حق الانتفاع المناسب للرقبة، للشريك في الشيوع إذا بيع جزء من العقار المشاع إلى أجنبي، لصاحب حق الانتفاع إذا بيعت الرقبة كلها أو بعضها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_796_19750926_OpEnact_13d936f15c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_796> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_796> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_796> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعدد الشفعاء يكون استعمال حق الشفعة حسب الترتيب المنصوص عليه في الفقرات التالية : إذا كان الشفعاء من طبقة واحدة استحق كل منهم الشفعة بقدر نصيبه، وإذا كان المشتري قد توفرت فيه الشروط التي تجعله شفيعا بمقتضى المادة 795 فإنه يفضل على الشفعاء من طبقته أو من طبقة أدنى ولكن يتقدمه الذين هم من طبقة أعلى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_797_19750926_OpEnact_e207e0e647> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_797> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_797> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_797> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801 فلا يجوز الأخذ بالشفعة الا من المشتري الثاني وحسب الشروط التي اشترى بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_798_19750926_OpEnact_835f0339f5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_798> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_798> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_798> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا شفعة : إذا حصل البيع بالمزاد العلني وفقا لإجراءات رسمها القانون، وإذا وقع البيع بين الأصول والفروع أو بين الزوجين أو بين الأقارب لغاية الدرجة الرابعة، وبين الأصهار لغاية الدرجة الثانية، إذا كان العقار قد بيع ليكون محل عبادة أو ليلحق بمحل العبادة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_799_19750926_OpEnact_90dbf38e7b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_799> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_799> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_799> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "على من يريد الأخذ بالشفعة أن يعلن رغبته فيها إلى كل من البائع والمشتري في أجل ثلاثين (30) يوما من تاريخ الانذار الذي يوجهه إليه البائع أو المشتري والا سقط حقه ، ويزاد على ذلك الأجل مدة المسافة أن اقتضى الأمر ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_79_19750926_OpEnact_5945dd4f82> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_79> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_79> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_79> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري على القصر وعلى المحجور عليهم وعلى غيرهم من عديمي الأهلية أو ناقصيها قواعد الأهلية المنصوص عليها في قانون الأسرة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_7_19750926_OpEnact_cb1aaec17e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_7> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_7> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_7> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تطبق النصوص الجديدة المتعلقة ب الاجراءات حالا غير أن النصوص القديمة هي التي تسري على المسائل الخاصة ببدء التقادم ووقفه وانقطاعة فيما يخص المدة السابقة على العمل بالنصوص الجديدة . إذا قررت الأحكام الجديدة مدة تقادم أقصر مما قرره النص القديم تسري المدة الجديدة من وقت العمل بالأحكام الجديدة، ولو كانت المدة القديمة قد بدأت قبل ذلك . أما إذا كان الباقي من المدة التي نصت عليها الأحكام القديمة أقصر من المدة التي تقررها الأحكام الجديدة فإن التقادم يتم بانقضاء هذا الباقي . وكذلك الحال فيما يخص أجال الاجراءات ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_800_19750926_OpEnact_fc37b77ae2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_800> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_800> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_800> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن يشتمل الانذار المنصوص عليه في المادة 799 على البيانات التالية والا كان باطلا : بيان العقار الجائز أخذه بالشفعة بيانا كافيا، بيان الثمن والمصاريف الرسمية وشروط البيع واسم كل من البائع والمشتري ولقبه ومهنته وموطنه والأجل الذي قدره ثلاثون (30) يوما للإعلان المنصوص عليه في المادة 799 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_801_19750926_OpEnact_6b5b75f7bc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_801> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_801> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن يكون التصريح بالرغبة في الشفعة بعقد رسمي يعلن عن طريق كتابة الضبط، والا كان هذا التصريح باطلا . ولا يحتج بالتصريح ضد الغير الا إذا كان مسجلا. يجب إيداع ثمن البيع والمصاريف بين يدي الموثق خلال ثلاثين (30) يوما على الأكثر من تاريخ التصريح بالرغبة في الشفعة بشرط أن يكون هذا الإيداع قبل رفع دعوى الشفعة . فإن لم يتم الإيداع في هذا الأجل على الوجه المتقدم سقط الحق في الشفعة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_802_19750926_OpEnact_f0e7fc0ee7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_802> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_802> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_802> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب رفع دعوى الشفعة على البائع والمشتري أمام المحكمة الواقع في دائرتها العقار في أجل ثلاثين (30) يوما من تاريخ الاعلان المنصوص عليه في المادة 801 والا سقط الحق ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_803_19750926_OpEnact_3675f9cceb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_803> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_803> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_803> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر الحكم الذي يصدر نهائيا بثبوت الشفعة سندا لملكية الشفيع وذلك دون إخلال بالقواعد المتعلقة بالاشهار العقاري ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_804_19750926_OpEnact_b88f720c65> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_804> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_804> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_804> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يحل الشفيع بالنسبة إلى البائع محل المشتري في جميع حقوقه والتزاماته الا أنه لا يمكن له الانتفاع بالأجل المضروب للمشتري عن دفع الثمن الا برضاء البائع ، ولا يرجع الشفيع على البائع إذا ما استرد الغير العقار بعد الشفعة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_805_19750926_OpEnact_d3b6463d02> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_805> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_805> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_805> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا بنى المشتري في العقار المشفوع أو غرس فيه أشجارا قبل الاعلان بالرغبة في الشفعة كان الشفيع ملزما تبعا لما يختاره المشتري أن يدفع له إما المبلغ الذي انفقه أو مقدار ما زاد في قيمة العقار بسبب البناء أو الغراس . أما إذا حصل البناء أو الغراس بعد الاعلان بالرغبة في الشفعة كان للشفيع أن يطلب الازالة وإذا اختار أن يستبقي البناء أو الغراس فلا يلزم الا بدفع قيمة أدوات البناء وأجرة العمل أو نفقات الغراس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_806_19750926_OpEnact_817f58bfc8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_806> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_806> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_806> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تكون حجة على الشفيع، الرهون والاختصاصات المأخوذة ضد المشتري وكذلك كل بيع صدر منه وكل حق عيني رتبه المشتري أو ترتب عليه إذا كان ذلك قد تم بعد تاريخ شهر الاعلان بالرغبة في الشفعة على أنه يبقى للدائنين المسجلة ديونهم مالهم من حقوق الأفضلية فيما آل للمشتري من ثمن العقار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_807_19750926_OpEnact_055d973002> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_807> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_807> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_807> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يمارس حق الشفعة في الأحوال الآتية : إذا تنازل الشفيع عن حقه في الشفعة ولو قبل البيع، إذا مرت سنة من يوم تسجيل عقد البيع، في الأحوال التي نص عليها القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_808_19750926_OpEnact_6f77e74285> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_808> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_808> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_808> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تقوم الحيازة على عمل يأتيه الغير على أنه مجرد رخصة أو على عمل يتحمله على سبيل التسامح. إذا اقترنت الحيازة بإكراه أو حصلت خفية أو كان فيها التباس فلا يكون لها أثر تجاه من وقع عليه الاكراه أو أخفيت عنه الحيازة أو إلتبس عليه أمرها الا من الوقت الذي تزول فيه هذه العيوب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_809_19750926_OpEnact_d0f55c1f3f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_809> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_809> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_809> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لغير المميز أن يكسب الحيازة عن طريق من ينوب عنه نيابة قانونية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_80_19750926_OpEnact_1f1616b6e5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_80> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_80> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_80> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الشخص أصم أبكم، أو أعمى أصم، أو أعمى أبكم، وتعذر عليه بسبب تلك العاهة التعبير عن إرادته ، جاز للمحكمة أن تعين له مساعدا قضائيا يعاونه في التصرفات التي تقتضيها مصلحته . ويكون قابلا للإبطال كل تصرف عين من أجله مساعد قضائي إذا صدر من الشخص الذي تقررت مساعدته بدون حضور المساعد بعد تسجيل قرار المساعدة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_810_19750926_OpEnact_a4645a9980> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_810> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_810> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_810> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تصح الحيازة بالوساطة متى كان الوسيط يباشرها باسم الحائز وكان متصلا به اتصالا يلزمه الائتمار بأوامره فيما يتعلق بهذه الحيازة وذلك كله مع مراعاة أحكام الأمر الصادر في شأن الثورة الزراعية. وعند الشك يفترض أن مباشر الحيازة إنما يحوز لنفسه فإن كانت الحيازة استمرارا الحيازة سابقة افترض أن هذا الاستمرار هو لحساب البادئ بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_811_19750926_OpEnact_501e931209> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_811> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_811> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_811> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتقل الحيازة من الحائز إلى غيره إذا اتفقا على ذلك وكان في استطاعة من انتقلت إليه الحيازة أن يسيطر على الحق ولو دون تسلم مادي للشيء موضوع هذا الحق ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_812_19750926_OpEnact_f1258aca8c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_812> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_812> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_812> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز نقل الحيازة دون تسليم مادي إذا استمر الحائز واضعا يده لحساب من يخلفه في الحيازة أو استمر الخلف واضعا يده ولكن لحساب نفسه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_813_19750926_OpEnact_12216fa933> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_813> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_813> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_813> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسليم السندات المعطاة عن البضائع المعهود بها إلى أمين النقل أو المودعة في المخازن يقوم مقام تسليم البضائع ذاتها. غير أنه إذا تسلم شخص السندات وتسلم آخر البضائع ذاتها وكان كلاهما حسن النية فإن الأفضلية تكون لمن تسلم البضائع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_814_19750926_OpEnact_56bfc6680f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_814> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_814> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_814> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنتقل الحيازة إلى الخلف العام بجميع صفاتها غير أنه إذا كان السلف سيئ النية وأثبت الخلف أنه كان في حيازته حسن النية جاز له أن يتمسك بحسن نيته ، و يجوز للخلف الخاص أن يضم إلى حيازته حيازة سلفه ليبلغ التقادم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_815_19750926_OpEnact_fe867ae24b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_815> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_815> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_815> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تزول الحيازة إذا تخلى الحائز عن سيطرته الفعلية على الحق أي إذا فقد هذه السيطرة بأية طريقة أخرى ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_816_19750926_OpEnact_463536c0af> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_816> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_816> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_816> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تزول الحيازة إذا حال مانع وقتي دون مباشرة الحائز للسيطرة الفعلية على الحق . غير أن الحيازة تزول إذا استمر المانع سنة كاملة وكان ناشئا عن حيازة جديدة وقعت رغم إرادة الحائز أو دون علمه وتحسب السنة من الوقت الذي بدأت فيه الحيازة الجديدة إذا بدأت علنا أو من يوم علم الحائز الأول بها إذا بدأت خفية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_817_19750926_OpEnact_0432097637> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_817> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_817> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_817> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لحائز العقار إذا فقد حيازته أن يطلب خلال السنة التالية لفقدها، ردها إليه فإذا كان فقد الحيازة خفية بدأ سريان السنة من وقت انكشاف ذلك. ويجوز أيضا أن يسترد الحيازة من كان حائزا بالنيابة من غيره ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_818_19750926_OpEnact_ab63bf3849> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_818> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_818> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_818> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يكن من فقد الحيازة قد مضت على حيازته سنة على فقدها فلا يجوز له أن يسترد الحيازة الا ممن لا يستند إلى حيازة أحق بالتفضيل والحيازة الأحق بالتفضيل هي الحيازة القائمة على سند قانوني . فإذا لم يكن لدى أي من الحائزين سند أو تعادلت سنداتهما كانت الحيازة الأحق هي الأسبق في التاريخ. للحائز في جميع الأحوال إذا فقد حيازته بالقوة أن يستردها خلال السنة التالية لفقدها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_819_19750926_OpEnact_a5202a358f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_819> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_819> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_819> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للحائز أن يرفع في الميعاد القانوني دعوى استرداد الحيازة على من انتقلت إليه حيازة الشيء المغتصب منه ولو كان هذا الأخير حسن النية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_81_19750926_OpEnact_f6d88f4ece> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_81> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_81> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_81> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للمتعاقد الذي وقع في غلط جوهري وقت إبرام العقد، أن يطلب ابطاله ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_820_19750926_OpEnact_e17746de76> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_820> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_820> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_820> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من حاز عقارا واستمر حائزا له مدة سنة كاملة ثم وقع له تعرض في حيازته جاز له أن يرفع خلال السنة دعوى بمنع التعرض ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_821_19750926_OpEnact_372485e5ad> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_821> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_821> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_821> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لمن حاز عقارا واستمر حائزا له مدة سنة كاملة وخشي لأسباب معقولة التعرض له من جراء أعمال جديدة تهدد حيازته أن يرفع الأمر إلى القاضي طالبا وقف هذه الأعمال بشرط أن لا تكون قد تمت ولم ينقض عام واحد على البدء في العمل الذي يكون من شأنه أن يحدث الضرر . وللقاضي أن يمنع استمرار الأعمال أو أن يأذن في استمرارها وفي كلتا الحالتين يجوز للقاضي أن يأمر بتقديم كفالة مناسبة تكون في حالة صدور الحكم بالوقف ضمانا لإصلاح الضرر الناشئ من هذا الوقف إذا تبين بحكم نهائي أن الاعتراض على استمرار الأعمال كان على غير أساس وتكون في حالة الحكم باستمرار الأعمال ضمانا لازالة هذه الأعمال كلها أو بعضها للتعويض عن الضرر الذي يصيب الحائز إذا حصل على حكم نهائي في مصلحته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_822_19750926_OpEnact_35e77c4d24> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_822> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_822> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_822> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تنازع أشخاص متعددون في حيازة حق واحد اعتبر بصفة مؤقتة أن حائزه هو من كانت له الحيازة المادية الا إذا كان قد اكتسب هذه الحيازة عن طريق التدليس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_823_19750926_OpEnact_0f00958cab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_823> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_823> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_823> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الحائز لحق يفرض أنه صاحب لهذا الحق حتى يتبين خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_824_19750926_OpEnact_e55b0f5c61> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_824> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_824> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_824> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يفرض حسن النية لمن يحوز حقا وهو يجهل انه يتعدى على حق الغير الا إذا كان هذا الجهل ناشئا عن خطأ جسيم . وإذا كان الحائز شخصا معنويا فالعبرة بنية من يمثله. ويفترض حسن النية دائما حتى يقوم الدليل على العكس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_825_19750926_OpEnact_0074b3394e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_825> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_825> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_825> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تزول صفة حسن النية من الحائز الا من الوقت الذي يعلم فيه أن حيازته اعتداء على حق الغير. ويزول حسن النية من وقت إعلان الحائز بعيوب حيازته بعريضة افتتاح الدعوى، و يعد سيئ النية من اغتصب حيازة الغير بالاكراه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_826_19750926_OpEnact_f04e97f424> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_826> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_826> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_826> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تبقى الحيازة محتفظة على الصفة التي كانت عليها وقت كسبها ما لم يقم الدليل على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_827_19750926_OpEnact_8f552ea892> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_827> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_827> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_827> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من حاز منقولا أو عقارا أو حقا عينيا منقولا كان أو عقارا دون أن يكون مالكا له أو خاصا به صار له ذلك ملكا إذا استمرت حيازته له مدة خمسة عشرة (15) سنة بدون انقطاع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_828_19750926_OpEnact_2d8046e220> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_828> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_828> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_828> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وقعت الحيازة على عقار أو على حق عيني عقاري وكانت مقترنة بحسن النية ومستندة في الوقت نفسه إلى سند صحيح فإن مدة التقادم المكسب تكون عشر(10) سنوات. ولا يشترط توافر حسن النية الا وقت تلقي الحق. والسند الصحيح هو تصرف يصدر عن شخص لا يكون مالكا للشيء أو صاحبا للحق المراد كسبه بالتقادم. ويجب إشهار السند."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_829_19750926_OpEnact_418dcf7bb0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_829> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_829> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_829> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تكسب بالتقادم في جميع الأحوال الحقوق الميراثية الا إذا دامت الحيازة ثلاثا وثلاثين (33) سنة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_82_19750926_OpEnact_8776c50c6c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_82> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_82> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_82> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الغلط جوهريا إذا بلغ حدا من الجسامة بحيث يمتنع معه المتعاقد عن إبرام العقد لو لم يقع في هذا الغلط . ويعتبر الغلط جوهريا على الأخص إذا وقع في صفة للشيء يراها المتعاقدان جوهرية، أو يجب اعتبارها كذلك نظرا لشروط العقد ولحسن النية . و إذا وقع في ذات المتعاقد أو في صفة من صفاته، وكانت تلك الذات أو هذه الصفة السبب الرئيسي في التعاقد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_830_19750926_OpEnact_963262b603> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_830> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_830> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_830> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ثبت قيام الحيازة في وقت سابق معين وكانت قائمة في الحال فإن ذلك يكون قرينة على قيامها في المدة ما بين الزمنين ما لم يقم دليل على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_831_19750926_OpEnact_7238e2825b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_831> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_831> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_831> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ليس لأحد أن يكسب بالتقادم على خلاف سنده على أنه لا يستطيع أحد أن يغير بنفسه لنفسه سبب حيازته ولا الأصل الذي تقوم عليه. غیر أنه يستطيع أن يكسب بالتقادم إذا تغيرت صفة حيازته إما بفعل الغير أو بفعل منه يعتبر معارضة لحق المالك ولكن في هذه الحالة لا تسري مدة التقادم إلا من تاريخ هذا التغيير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_832_19750926_OpEnact_b810ff7fc2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_832> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_832> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_832> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري قواعد التقادم المسقط على التقادم المكسب فيما يتعلق بحساب المدة ووقف التقادم وانقطاعه والتمسك به أمام القضاء والتنازل عنه والاتفاق على تعديل المدة وذلك بالقدر الذي لا تتعارض فيه هذه القواعد مع طبيعة التقادم المكسب ومع مراعاة الأحكام التالية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_833_19750926_OpEnact_c5024389db> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_833> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_833> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_833> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يوقف التقادم المكسب أيا كانت مدته إذا وجد سبب لوقفه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_834_19750926_OpEnact_f2f349edec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_834> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_834> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_834> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينقطع التقادم المكسب إذا تخلى الحائز عن حيازته أو فقدها ولو بفعل الغير . غیر أن التقادم لا ينقطع بفقد الحيازة إذا استردها الحائز خلال سنة أو رفع دعوى باستردادها في هذا الميعاد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_835_19750926_OpEnact_0c1becead8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_835> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_835> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_835> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من حاز بسند صحيح منقولا أو حقا عينيا على المنقول أو سندا لحامله فإنه يصبح مالكا له إذا كان حسن النية وقت حيازته . إذا كان حسن النية والسند الصحيح قد توافر لدى الحائز في اعتباره الشيء خاليا من التكاليف والقيود العينية فإنه يكسب ملكية الشيء خالية من هذه التكاليف والقيود العينية . والحيازة في ذاتها قرينة على وجود السند الصحيح وحسن النية ما لم يقم دليل على خلاف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_836_19750926_OpEnact_e39d97a7fb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_836> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_836> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_836> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لمالك المنقول أو السند الحامله إذا فقده أو سرق منه أن يسترده ممن يكون حائزا له بحسن النية وذلك في أجل ثلاث (3) سنوات من وقت الضياع أو السرقة. إذا كان الشيء الضائع أو المسروق قد وجد في حيازة من اشتراه بحسن النية في السوق بالمزاد العلني أو اشتراه ممن يتجر في مثله فإن له أن يطالب ممن يسترد الشيء أن يرد الثمن الذي دفعه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_837_19750926_OpEnact_70cf6d9575> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_837> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_837> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_837> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكسب الحائز ما يقبضه من الثمار ما دام حسن النية . وتعتبر الثمار الطبيعية أو الصناعية مقبوضة من يوم فصلها. أما الثمار المدنية فتعتبر مقبوضة يوما فيوما."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_838_19750926_OpEnact_63b27de7c1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_838> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_838> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_838> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الحائز سيئ النية مسؤولا عن جميع الثمار التي قبضها أو قصر في قبضها من الوقت الذي أصبح فيه سيئ النية . غير أنه يجوز له أن يسترد ما أنفقه في انتاجها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_839_19750926_OpEnact_9a61a54948> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_839> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_839> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_839> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "على المالك الذي يرد إليه ملكه أن يدفع إلى الحائز جميع ما أنفقه من المصروفات اللازمة . وفيما يرجع إلى المصروفات النافعة تطبق المادتان 784 و 785 . وإذا كانت المصروفات كمالية فليس للحائز أن يطالب بشيء منها غير أنه يجوز له أن يزيل ما أحدثه من المنشآت بشرط أن يرد الشيء بحالته الأولى الا إذا اختار المالك أن يستبقيها مقابل دفع قيمتها في حالة الهدم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_83_19750926_OpEnact_be7785c7cb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_83> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_83> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_83> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون العقد قابلا للابطال لغلط في القانون إذا توفرت فيه شروط الغلط في الواقع طبقا للمادتين 81 و 82 ما لم يقض القانون بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_840_19750926_OpEnact_6e7fcfde58> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_840> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_840> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_840> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لمن تلقى الحيازة من مالك أو حائز سابق وأثبت أنه دفع إليه ما أنفق من المصاريف أن يطالب بها من يسترد الشيء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_841_19750926_OpEnact_2a38eb0249> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_841> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_841> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_841> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للقاضي بناء على طلب المالك أن يختار ما يراه مناسبا للوفاء بالمصاريف المنصوص عليها في المادتين 839 و 840 وله أيضا أن يقدر بأن يكون الوفاء على أقساط دورية بشرط تقديم الضمانات اللازمة ، وللمالك أن يتحلل من هذا الالتزام إذا سبق مبلغا يساوي قيمة هذه الاقساط ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_842_19750926_OpEnact_c74df7f5ea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_842> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_842> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_842> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الحائز حسن النية وانتفع بالشيء وفقا لما يحسبه من حقه فلا يكون مسؤولا تجاه من هو ملزم برد الشيء إليه عن أي تعويض بسبب هذا الانتفاع. ولا يكون الحائز مسؤولا عما يصيب الشيء من هلاك أو تلف الا بقدر ما عاد عليه من فائدة ترتبت عن هذا الهلاك أو التلف"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_843_19750926_OpEnact_303e7c3f57> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_843> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_843> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_843> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الحائز سيئ النية فإنه يكون مسؤولا عن هلاك الشيء أو تلفه ولو كان ذلك ناشئا عن حادث مفاجئ الا إذا ثبت أن الشيء كان يهلك أو يتلف ولو بقي في يد من يستحقه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_844_19750926_OpEnact_767336191e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_844> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_844> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_844> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكسب حق الانتفاع بالتعاقد وبالشفعة وبالتقادم أو بمقتضى القانون . يجوز أن يوصى ب حق الانتفاع لأشخاص متعاقدين إذا كانوا موجودين على قيد الحياة وقت الوصية كما يجوز أن یوصی به للحمل المستكن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_845_19750926_OpEnact_a18e6d26e3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_845> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_845> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_845> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يراعى في حقوق المنتفع والتزاماته السند الذي أنشأ حق الانتفاع وكذلك الأحكام المقررة في المواد التالية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_846_19750926_OpEnact_b059743f61> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_846> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_846> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_846> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ثمار الشيء المنتفع به تكون للمنتفع بقدر مدة انتفاعه مع مراعاة أحكام الفقرة الثانية من المادة 839 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_847_19750926_OpEnact_b7605a5a85> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_847> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_847> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_847> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "على المنتفع أن يستعمل الشيء بحالته التي تسلمه بها وبحسب ما أعد له وأن يديره إدارة حسنة . وللمالك أن يعترض على أي استعمال غير مشروع أو غير متفق مع طبيعة الشيء فإذا أثبت أن حقوقه في خطر جاز له أن يطالب بتقديم تأمينات فإن لم يقدمها المنتفع أو استمر على الرغم من اعتراض المالك في استعمال الشيء استعمالا غير مشروع أو غير متفق مع طبيعة الشيء فللقاضي أن ينزع العين من تحت يده وأن يسلمها إلى الغير ليتولى إدارتها بل له تبعا لخطورة الحال أن يقرر انتهاء حق الانتفاع دون إخلال بحقوق الغير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_848_19750926_OpEnact_202156d463> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_848> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_848> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_848> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يلزم المنتفع أثناء انتفاعه بكل ما يعرض على العين المنتفع بها من التكاليف المعتادة وبكل النفقات التي تقتضيها أعمال الصيانة . أما التكاليف غير المعتادة والاصلاحات الجسيمة التي لم تنشأ عن خطأ المنتفع فانها تكون على المالك ويلتزم بأن يؤدي للمالك فوائد ما انفقه في ذلك ، وإذا كان المنتفع هو الذي قام بالانفاق ، كان له استرداد رأس المال عند انتهاء حق الانتفاع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_849_19750926_OpEnact_37ffe7788d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_849> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_849> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_849> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على المنتفع أن يبذل من العناية في المحافظة على الشيء ما يبذله الشخص العادي ، وهو مسؤول عن هلاك الشيء ولو بسبب لا ينسب إليه أن تأخر عن رده إلى مالكه بعد انتهاء حق الانتفاع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_84_19750926_OpEnact_659a9fda40> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_84> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_84> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_84> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يؤثر في صحة العقد مجرد الغلط في الحساب ولا غلطات القلم، ولكن يجب تصحيح الغلط ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_850_19750926_OpEnact_d9250c47ed> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_850> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_850> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_850> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا هلك الشيء أو تلف أو احتاج إلى اصلاحات كبرى مما يجب على المالك أن يتحمل نفقاته أو احتاج إلى اتخاذ اجراء يقيه من خطر غير متوقع فعلى المنتفع أن يبادر باخطار المالك و عليه اخطاره أيضا إذا ادعى أجنبي بحق على الشيء نفسه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_851_19750926_OpEnact_6ecfe90468> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_851> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_851> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_851> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان المال المقرر عليه حق الانتفاع منقولا وجب جرده ولزم المنتفع تقديم كفالة به فإن لم يقدمها بيع المال ووظف ثمنه في شراء سندات عامة يستولي المنتفع على أرباحها، وللمنتفع الذي قدم الكفالة أن يستعمل الأشياء القابلة للاستهلاك بشرط أن يرد بدلها عند انتهاء حقه في الانتفاع ، وله نتاج المواشي بعد أن يعرض منها ما هلك من الأصل بسبب حادث مفاجئ أو قوة قاهرة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_852_19750926_OpEnact_b81ae4622f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_852> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_852> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_852> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتهي حق الانتفاع بانقضاء الأجل المعين، فإن لم يعين أجل عد مقرر ا لحياة المنتفع، وهو ينتهي على أي حال بموت المنتفع حتى قبل انقضاء الأجل المعين، وإذا كانت الأرض المنتفع بها مشغولة عند انقضاء الأجل أو عند موت المنتفع بزرع قائم أبقيت للمنتفع أو لورثته إلى حين إدراك الزرع بشرط أن يدفعوا أجرة إيجار الأرض عن هذه الفترة من الزمن ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_853_19750926_OpEnact_1f5962131b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_853> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_853> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_853> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتهي حق الانتفاع بهلاك الشيء الا أنه ينتقل من شيء الهالك إلى ما قد يقابل قيمته، و إذا لم يكن الهلاك راجعا إلى خطأ المالك فلا يجبر المالك على إعادة الشيء إلى أصله ولكنه إذا أعاده رجع حق الانتفاع إلى المنتفع إذا لم يكن الهلاك بسببه وفي هذه الحالة تطبق الفقرة الثانية من المادة 848 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_854_19750926_OpEnact_be5805fe60> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_854> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_854> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_854> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتهي حق الانتفاع بعدم الاستعمال مدة خمسة عشرة (15) سنة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_855_19750926_OpEnact_1fdf9c9faf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_855> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_855> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_855> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "نطاق حق الاستعمال و حق السكن يتحدد بقدر ما يحتاج إليه صاحب الحق وأسرته لخاصة أنفسهم وذلك دون الاخلال بالأحكام التي يقررها السند المنشئ للحق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_856_19750926_OpEnact_3644c11d74> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_856> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_856> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_856> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز التنازل للغير عن حق الاستعمال و حق السكن الا بناء على شرط صريح أو مبرر قوي ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_857_19750926_OpEnact_d2f62a3ad4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_857> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_857> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_857> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري القواعد الخاصة بـ حق الانتفاع على حق الاستعمال و حق السكن متى كانت لا تتعارض مع طبيعة هذين الحقين وذلك مع مراعاة الأحكام المتقدمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_858_19750926_OpEnact_ca6c0d7011> a dzdoc:ArticleVersion ;
