<https://legal.dz/resource/order/1975-09-26/75-58#version_art_902> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للدائن بعد التنبيه على المدين بالوفاء، أن ينفذ بحقه على العقار المرهون ويطلب بيعه في الآجال ووفقا للاوضاع المقررة في قانون الاجراءات المدنية . وإذا كان الراهن شخصا آخر غير المدين جاز له تفادي أي إجراء موجه إليه أن هو تخلى عن العقار المرهون وفقا للأوضاع والأحكام التي يتبعها الحائز في تخلية العقار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_902_19750926_OpEnact_cb2fbb639c> ;
    dzdoc:replacementText "يمكن للدائن بعد التنبيه على المدين بالوفاء، أن ينفذ بحقه على العقار المرهون ويطلب بيعه في الآجال ووفقا للاوضاع المقررة في قانون الاجراءات المدنية . وإذا كان الراهن شخصا آخر غير المدين جاز له تفادي أي إجراء موجه إليه أن هو تخلى عن العقار المرهون وفقا للأوضاع والأحكام التي يتبعها الحائز في تخلية العقار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_902> ;
