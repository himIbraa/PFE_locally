<https://legal.dz/resource/order/1975-09-26/75-58#version_art_735> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع قسمة المهايأة من حيث جواز الاحتجاج بها على الغير ومن حيث أهلية المتقاسمين وحقوقهم والتزاماتهم وطرق الاثبات لأحكام عقد الإيجار ، ما دامت هذه الأحكام لا تتعارض مع طبيعة هذه القسمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_735_19750926_OpEnact_989d6ca467> ;
