<https://legal.dz/resource/order/1975-09-26/75-58#art_966_condition_0_8dc5b653> a dznorm:Condition ;
    dznorm:conditionText "يشترط لنفاذ الرهن العقاري في حق الغير، إلى جانب تسليم الملك للدائن، أن يقيد عقد الرهن العقاري"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_966> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_966_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_966> ;
    dzdoc:position 0 ;
    dzdoc:text "يشترط لنفاذ الرهن العقاري في حق الغير، إلى جانب تسليم الملك للدائن، أن يقيد عقد الرهن العقاري، وتسري على هذا القيد الأحكام الخاصة بقيد الرهن الرسمي."@ar .

