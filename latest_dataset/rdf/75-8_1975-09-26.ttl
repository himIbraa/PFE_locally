    dzdoc:replacementText "أن للراهن الحق في إدارة العقار المرهون وفي قبض ثماره إلى وقت التحاقها بالعقار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_895> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
