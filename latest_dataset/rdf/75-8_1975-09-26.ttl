<https://legal.dz/resource/order/1975-09-26/75-58#version_art_476> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلتزم المؤجر بتسليم العين المؤجرة للمستأجر في حالة تصلح للاستعمال المعد لها تبعا لاتفاق الطرفين . تتم معاينة الأماكن وجاهيا بموجب محضر أو بيان وصفي يلحق بعقد الإيجار. غير أنه إذا تم تسليم العين المؤجرة دون محضر أو بيان وصفي ، يفترض في المستأجر أنه تسلمها في حالة حسنة ما لم يثبت العكس."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_476_19750926_OpEnact_d7c3ab8aa5> ;
    dzdoc:replacementText "يلتزم المؤجر بتسليم العين المؤجرة للمستأجر في حالة تصلح للاستعمال المعد لها تبعا لاتفاق الطرفين . تتم معاينة الأماكن وجاهيا بموجب محضر أو بيان وصفي يلحق بعقد الإيجار. غير أنه إذا تم تسليم العين المؤجرة دون محضر أو بيان وصفي ، يفترض في المستأجر أنه تسلمها في حالة حسنة ما لم يثبت العكس."@ar ;
