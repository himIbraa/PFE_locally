<https://legal.dz/resource/order/1975-09-26/75-58#version_art_983> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مرتبة الامتياز يحددها القانون، فإذا لم يوجد نص خاص يعين مرتبة الامتياز يأتي هذا الامتياز بعد الامتيازات المنصوص عنها في هذا الباب. وإذا كانت الحقوق الممتازة في مرتبة واحدة ، فانها تستوفي عن طريق التسابق، ما لم يوجد نص قانوني يقضي بغير ذلك."@ar ;
