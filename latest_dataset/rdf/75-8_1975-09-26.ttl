<https://legal.dz/resource/order/1975-09-26/75-58#version_art_38> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "موطن القاصر والمحجور عليه والمفقود والغائب هو موطن من ينوب عن هؤلاء قانونا. غير أنه يكون للقاصر المرشد موطن خاص بالنسبة للتصرفات التي يعتبره القانون أهلا لمباشرتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_38_19750926_OpEnact_7186e808ab> ;
    dzdoc:replacementText "موطن القاصر والمحجور عليه والمفقود والغائب هو موطن من ينوب عن هؤلاء قانونا. غير أنه يكون للقاصر المرشد موطن خاص بالنسبة للتصرفات التي يعتبره القانون أهلا لمباشرتها."@ar ;
