        <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_6_19750926_OpEnact_0b8a4b45c2> ;
