dzterm:صلح a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصلح"@ar,
        "الصلح عقد ينهي به الطرفان نزاعا قائما أو يتوقيان به نزاعا محتملا، وذلك بأن يتنازل كل منهما على وجه التبادل عن حقه."@ar,
        "عقد الصلح"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_459_defocc_666156910ad9> .

dzterm:فضالة a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الفضالة"@ar,
        "الفضالة هي أن يتولى شخص عن قصد القيام بالشأن لحساب شخص آخر، دون أن يكون ملزما بذلك."@ar ;
