<https://legal.dz/resource/order/1975-09-26/75-58#art_887> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_887" ;
    dzdoc:fullText "يشمل الرهن ملحقات العقار المرهون التي تعتبر عقارا، ويشمل بوجه خاص حقوق الارتفاق والعقارات بالتخصيص وكافة التحسينات والانشاءات التي تعود بالمنفعة على المالك، ما لم يتفق على غير ذلك، مع عدم الاخلال بامتياز المبالغ المستحقة للمقاولين والمهندسين المعماريين المنصوص عليه في المادة 997 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_887> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_887_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_887_19750926_OpEnact_c30d65f2e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 887" ;
    dzdoc:position 938 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_997> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_997> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_888> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_888" ;
    dzdoc:fullText "توقف وتوزع ثمار العقار المرهون وإيراده مثلما يوقف ويوزع ثمن العقار ابتداءا من تسجيل نزع الملكية الذي هو بمثابة الحجز العقاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_888> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_888_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_888_19750926_OpEnact_ccecb6dac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 888" ;
    dzdoc:position 939 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_905> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_905" ;
    dzdoc:fullText "تسري على إجراء القيد وتجديده وشطبه وإلغاء الشطب والآثار المترتبة على ذلك كله، الأحكام الواردة في قانون تنظيم الاشهار العقاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_905> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_905_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_905_19750926_OpEnact_b159333b69> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 905" ;
    dzdoc:position 956 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_929> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_929" ;
    dzdoc:fullText "يعود للحائز ما كان له قبل انتقال ملكية العقار إليه من حقوق ارفاق وحقوق عينية أخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_929> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_929_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_929_19750926_OpEnact_ddaf429b48> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "929" ;
    dzdoc:position 980 ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_947> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_947" ;
    dzdoc:fullText "تكون للدائن الذي حصل على حق التخصيص نفس الحقوق التي للدائن الذي حصل على رهن رسمي . ويسري على التخصيص ما يسري على الرهن الرسمي من أحكام وخاصة ما يتعلق بالقيد وتجديده وشطبه وعدم تجزئة الحق وأثره ،وانقضائه، وذلك كله مع عدم الإخلال بما ورد من أحكام خاصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_947> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_947_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_947_19750926_OpEnact_e2330664c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "947" ;
    dzdoc:position 998 ;
    dzdoc:usesTerm dzterm:judiciary_charge,
        dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_950> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_950" ;
    dzdoc:fullText "تسري على الرهن الحيازي أحكام المواد 891 و 893 و 904 المتعلقة بالرهن الرسمي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_950> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_950_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_950_19750926_OpEnact_8dfee96de1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 950" ;
    dzdoc:position 1001 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_891>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_893>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_904> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_891>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_893>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_904> ;
    dzdoc:usesTerm dzterm:mortgage_official,
        dzterm:mortgage_pledge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_96" ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_96_para_0> ;
