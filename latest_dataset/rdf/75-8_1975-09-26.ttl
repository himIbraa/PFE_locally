<https://legal.dz/resource/order/1975-09-26/75-58#version_art_682> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل شيء غير خارج عن التعامل بطبيعته أو بحكم القانون يصلح أن يكون محلا للحقوق المالية. والأشياء التي تخرج عن التعامل بطبيعتها هي التي لا يستطيع أحد أن يستأثر بحيازتها وأما الخارجة بحكم القانون فهي التي يجيز القانون أن تكون محلا للحقوق المالية."@ar ;
