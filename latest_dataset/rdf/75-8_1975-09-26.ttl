<https://legal.dz/resource/order/1975-09-26/75-58#version_art_220> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا برئت ذمة الدائن قبل أحد الدائنين المتضامنين لسبب غير الوفاء فلا تبرأ ذمته قبل الدائنين الآخرين إلا بقدر حصة الدائن التي برئت ذمته من أجله. لا يجوز لأحد الدائنين المتضامنين أن يقوم بعمل من شأنه الاضرار بالآخرين."@ar ;
