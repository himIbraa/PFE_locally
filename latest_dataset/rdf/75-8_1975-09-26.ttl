<https://legal.dz/resource/order/1975-09-26/75-58#version_art_587> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للموكل في أي وقت أن ينهي الوكالة أو يقيدها ولو وجد اتفاق يخالف ذلك فإذا كانت الوكالة بأجر فإن الموكل يكون ملزما بتعويض الوكيل عن الضرر الذي لحقه من جراء عزله في وقت غير مناسب بغير عذر مقبول ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_587_19750926_OpEnact_7a1d290427> ;
