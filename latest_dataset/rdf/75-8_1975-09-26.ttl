<https://legal.dz/resource/order/1975-09-26/75-58#version_art_286> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسري أحكام البيع وخصوصا ما يتعلق منها بأهلية الطرفين، وبضمان الاستحقاق، وبضمان العيوب الخفية على الوفاء بمقابل فيما إذا كان ينقل ملكية شيء أعطى في مقابلة الدين ويسري عليه من حيث انه يقضى الدين احكام الوفاء وبالاخص ما تعلق منها بتعيين جهة الدفع وانقضاء التأمينات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_286_19750926_OpEnact_68e9e0e346> ;
    dzdoc:replacementText "تسري أحكام البيع وخصوصا ما يتعلق منها بأهلية الطرفين، وبضمان الاستحقاق، وبضمان العيوب الخفية على الوفاء بمقابل فيما إذا كان ينقل ملكية شيء أعطى في مقابلة الدين ويسري عليه من حيث انه يقضى الدين احكام الوفاء وبالاخص ما تعلق منها بتعيين جهة الدفع وانقضاء التأمينات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
