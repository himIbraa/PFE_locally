<https://legal.dz/resource/order/1975-09-26/75-58#version_art_77> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لشخص أن يتعاقد مع نفسه باسم من ينوب عنه سواء أكان التعاقد لحسابه هو أم لحساب شخص آخر، دون ترخيص من الأصيل على أنه يجوز للأصيل في هذه الحالة أن يجيز التعاقد كل ذلك مع مراعاة ما يخالفه، مما يقضي به القانون وقواعد التجارة."@ar ;
