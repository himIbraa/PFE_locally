<https://legal.dz/resource/order/1975-09-26/75-58#version_art_911> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للدائن المرتهن عند حلول أجل الدين أن يقوم بنزع ملكية العقار المرهون من يد الحائز لهذا العقار ، إلا إذا اختار الحائز أن يقضي الدين أو يطهر العقار من الرهن أو يتخلى عنه . ويعتبر حائزا للعقار المرهون كل من انتقلت إليه بأي سبب من الأسباب ملكية هذا العقار أو أي حق عيني آخر قابل للرهن، دون أن يكون مسؤولا مسؤولية شخصية عن الدين المضمون بالرهن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_911_19750926_OpEnact_1ac24e3743> ;
    dzdoc:replacementText "يجوز للدائن المرتهن عند حلول أجل الدين أن يقوم بنزع ملكية العقار المرهون من يد الحائز لهذا العقار ، إلا إذا اختار الحائز أن يقضي الدين أو يطهر العقار من الرهن أو يتخلى عنه . ويعتبر حائزا للعقار المرهون كل من انتقلت إليه بأي سبب من الأسباب ملكية هذا العقار أو أي حق عيني آخر قابل للرهن، دون أن يكون مسؤولا مسؤولية شخصية عن الدين المضمون بالرهن ."@ar ;
