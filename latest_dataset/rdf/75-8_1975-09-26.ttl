<https://legal.dz/resource/order/1975-09-26/75-58#version_art_441> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أن تحل الشركة بحكم قضائي بناء على طلب أحد الشركاء، لعدم وفاء شريك بما تعهد به أو بأي سبب آخر ليس هو من فعل الشركاء ، ويقدر القاضي خطورة السبب المبرر لحل الشركة. ويكون باطلا كل اتفاق يقضي بخلاف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_441_19750926_OpEnact_0cec68b82b> ;
    dzdoc:replacementText "يجوز أن تحل الشركة بحكم قضائي بناء على طلب أحد الشركاء، لعدم وفاء شريك بما تعهد به أو بأي سبب آخر ليس هو من فعل الشركاء ، ويقدر القاضي خطورة السبب المبرر لحل الشركة. ويكون باطلا كل اتفاق يقضي بخلاف ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
