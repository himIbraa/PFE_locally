<https://legal.dz/resource/order/1975-09-26/75-58#version_art_44> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع فاقد الأهلية، وناقصوها، بحسب الأحوال لأحكام الولاية، أو الوصاية، أو القوامة ، ضمن الشروط ووفقا للقواعد المقررة في القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
