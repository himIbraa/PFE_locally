<https://legal.dz/resource/order/1975-09-26/75-58#art_121_condition_0_9b07d262> a dznorm:Condition ;
    dznorm:conditionText "إذا انقضى التزام بسبب استحالة تنفيذه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_121> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_121_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_121> ;
    dzdoc:position 0 ;
    dzdoc:text "في العقود الملزمة للجانبين إذا انقضى التزام بسبب استحالة تنفيذه انقضت معه الالتزامات المقابلة له وينفسخ العقد بحكم القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_122_condition_0_3facf714> a dznorm:Condition ;
    dznorm:conditionText "إذا فسخ العقد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_122> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_122_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_122> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا فسخ العقد أعيد المتعاقدان إلى الحالة التي كانا عليها قبل العقد، فإذا استحال ذلك جاز للمحكمة أن تحكم بالتعويض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_condition_0_6a5de8c3> a dznorm:Condition ;
    dznorm:conditionText "وإذا لم يعين الواعد أجلا لإنجاز العمل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_condition_1_c267a70e> a dznorm:Condition ;
    dznorm:conditionText "أجل ستة (6) أشهر من تاريخ إعلان العدول للجمهور"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_obligation_0_3adb11b4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dznorm:position 0 ;
    dznorm:provisionText "يلزم بإعطائها لمن قام بالعمل"@ar ;
    dznorm:sourceArticle "art_123_bis_1" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "( جديدة) من وعد الجمهور بجائزة يعطيها عن عمل معين يلزم بإعطائها لمن قام بالعمل، ولو قام به دون نظر إلى الوعد بالجائزة أو دون علم بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا لم يعين الواعد أجلا لإنجاز العمل جاز له الرجوع في وعده بإعلان الجمهور، على ألا يؤثر ذلك في حق من أتم العمل قبل الرجوع في الوعد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123_bis_1> ;
    dzdoc:position 2 ;
    dzdoc:text "يمارس حق المطالبة بالجائزة تحت طائلة السقوط في أجل ستة (6) أشهر من تاريخ إعلان العدول للجمهور."@ar .

