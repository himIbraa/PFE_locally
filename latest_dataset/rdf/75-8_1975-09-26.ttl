    dzdoc:text "إذا نقصت قيمة المبيع قبل التسليم لتلف أصابه جاز للمشتري اما أن يطلب فسخ البيع إذا كان النقص جسيما بحيث لو طرأ قبل العقد لما أتم البيع واما أن يبقي البيع مع انقاص الثمن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_371_obligation_0_1d451401> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_371> ;
    dznorm:position 0 ;
    dznorm:provisionText "يضمن البائع عدم التعرض للمشتري في الانتفاع بالمبيع كله أو بعضه"@ar ;
    dznorm:sourceArticle "art_371" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_371_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_371> ;
    dzdoc:position 0 ;
    dzdoc:text "يضمن البائع عدم التعرض للمشتري في الانتفاع بالمبيع كله أو بعضه سواء كان التعرض من فعله أو من فعل الغير يكون له وقت البيع حق على المبيع يعارض به المشتري. ويكون البائع مطالبا بالضمان ولو كان حق ذلك الغير قد ثبت بعد البيع وقد آل إليه هذا الحق من البائع نفسه."@ar .

