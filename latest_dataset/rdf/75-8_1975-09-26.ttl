<https://legal.dz/resource/order/1975-09-26/75-58#version_art_438> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي الشركة بهلاك جميع مالها أو جزء كبير منه بحيث لا تبقى فائدة في استمرارها. وإذا كان أحد الشركاء قد تعهد بأن يقدم حصته شيئا معينا بالذات وهلك هذا الشيء قبل تقديمه أصبحت الشركة منحلة في حق جميع الشركاء."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_438_19750926_OpEnact_354de4d73c> ;
