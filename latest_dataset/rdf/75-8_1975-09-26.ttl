<https://legal.dz/resource/order/1975-09-26/75-58#art_671_condition_1_a7cd444a> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يوف الا بعض الدين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_671> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_671_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_671> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا وفي الكفيل الدين، كان له أن يحل محل الدائن في جميع ما له من حقوق تجاه المدين. ولكن إذا لم يوف الا بعض الدين، فلا يرجع بما وفاه الا بعد أن يستوفي الدائن كل حقه من المدين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_671_right_0_fb0fdc44> a dznorm:Right ;
