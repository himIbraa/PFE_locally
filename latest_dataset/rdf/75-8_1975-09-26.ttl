    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تضامن بين الشركاء فيما هم مسؤولون عنه من ديون الشركة ، الا إذا وجد اتفاق يقضي بخلاف ذلك . غير انه إذا أعسر أحد الشركاء ، وزعت حصته في الدين على الآخرين كل بقدر نصيبه في تحمل الخسارة ."@ar ;
    dzdoc:isAuthoritative true ;
