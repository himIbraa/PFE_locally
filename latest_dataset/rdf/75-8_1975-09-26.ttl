<https://legal.dz/resource/order/1975-09-26/75-58#version_art_705> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "للمالك إذا كانت له مصلحة جدية في تعلية الحائط المشترك أن يعليه بشرط أن لا يلحق بشريكه ضررا بليغا ، و عليه أن يتحمل وحده نفقة التعلية وصيانة الجزء المعلى وأن يقوم بالأعمال اللازمة لجعل الحائط قادرا على حمل زيادة العبء الناشئ عن التعلية دون أن يفقد شيئا من متانته . فإذا لم يكن الحائط المشترك صالحا لتحمل التعلية فعلى من يرغب فيها من الشركاء أن يعيد بناء الحائط كله على نفقته بحيث يقع ما زاد من سمكه في ناحيته هو بقدر الاستطاعة ، ويظل الحائط المجدد في غير الجزء المعلى مشتركا دون أن يكون للجار الذي أحد"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_705_19750926_OpEnact_2da3fb4ca2> ;
    dzdoc:replacementText "للمالك إذا كانت له مصلحة جدية في تعلية الحائط المشترك أن يعليه بشرط أن لا يلحق بشريكه ضررا بليغا ، و عليه أن يتحمل وحده نفقة التعلية وصيانة الجزء المعلى وأن يقوم بالأعمال اللازمة لجعل الحائط قادرا على حمل زيادة العبء الناشئ عن التعلية دون أن يفقد شيئا من متانته . فإذا لم يكن الحائط المشترك صالحا لتحمل التعلية فعلى من يرغب فيها من الشركاء أن يعيد بناء الحائط كله على نفقته بحيث يقع ما زاد من سمكه في ناحيته هو بقدر الاستطاعة ، ويظل الحائط المجدد في غير الجزء المعلى مشتركا دون أن يكون للجار الذي أحدث التعلية حق في التعويض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_705> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_705> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_706> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
