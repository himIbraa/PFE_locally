<https://legal.dz/resource/order/1975-09-26/75-58#art_272_condition_0_69486fd1> a dznorm:Condition ;
    dznorm:conditionText "فإذا كان للاشياء سعر معروف في السوق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_272> ;
