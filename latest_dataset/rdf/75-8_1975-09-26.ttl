<https://legal.dz/resource/order/1975-09-26/75-58#version_art_261> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قام بالوفاء شخص غير المدين ، حل الموفي محل الدائن الذي استوفي حقه في الأحوال الآتية : إذا كان الموفي ملزما بالدين مع المدين، أو ملزما بوفائه عنه، إذا كان الموفي دائنا ووفي دائنا آخر مقدما عليه بما له من تأمين عيني ولو لم يكن للموفي أي تأمين، إذا كان الموفي اشترى عقارا ودفع ثمنه وفاء لدائنين، خصص العقار لضمان حقوقهم، إذا كان هناك نص خاص يقرر للموفي حق الحلول."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_261_19750926_OpEnact_75d1d1157a> ;
    dzdoc:replacementText "إذا قام بالوفاء شخص غير المدين ، حل الموفي محل الدائن الذي استوفي حقه في الأحوال الآتية : إذا كان الموفي ملزما بالدين مع المدين، أو ملزما بوفائه عنه، إذا كان الموفي دائنا ووفي دائنا آخر مقدما عليه بما له من تأمين عيني ولو لم يكن للموفي أي تأمين، إذا كان الموفي اشترى عقارا ودفع ثمنه وفاء لدائنين، خصص العقار لضمان حقوقهم، إذا كان هناك نص خاص يقرر للموفي حق الحلول."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_261> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_261> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_262> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتفق الدائن الذي استوفي حقه من غير المدين مع هذا الغير على أن يحل محله ولو لم يقبل المدين ذلك، و لا يصح أن يتأخر هذا الاتفاق عن وقت الوفاء ."@ar ;
