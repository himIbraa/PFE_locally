<https://legal.dz/resource/order/1975-09-26/75-58#art_981_condition_0_97fcb20a> a dznorm:Condition ;
    dznorm:conditionText "إذا أصبح كل من الدين المرهون والدين المضمون مستحق الأداء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_981> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_981_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_981> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أصبح كل من الدين المرهون والدين المضمون مستحق الأداء جاز للدائن المرتهن إذا لم يستوف حقه، أن يقبض من الدين المرهون ما يكون مستحقا له أو أن يطلب بيع هذا الدين أو تملكه وفقا للمادة 970 الفقرة الثانية."@ar .

