<https://legal.dz/resource/order/1975-09-26/75-58#art_67_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_67> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر التعاقد ما بين الغائبين قد تم في المكان وفي الزمان اللذين يعلم فيهما الموجب بالقبول، ما لم يوجد اتفاق أو نص قانوني يقضي بغير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_67_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_67> ;
    dzdoc:position 1 ;
    dzdoc:text "ويفترض أن الموجب قد علم بالقبول في المكان، وفي الزمان اللذين وصل إليه فيهما القبول."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_680_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_680> ;
    dzdoc:position 0 ;
    dzdoc:text "يتم الاستيلاء بصفة فردية أو جماعية ويكون كتابيا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_680_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_680> ;
    dzdoc:position 1 ;
    dzdoc:text "يوقع الأمر من طرف الوالي أو كل سلطة مؤهلة قانونا ويوضح فيه إذا كان الاستيلاء بقصد الحصول على الأموال أو الخدمات، ويبين طبيعة وصفة و/أو مدة الخدمة وعند الاقتضاء مبلغ وطرق دفع التعويض و/أو الأجر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_condition_0_75c0fe5f> a dznorm:Condition ;
    dznorm:conditionText "في حالة وجود حيازة من طرف المستفيد من الاستيلاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_obligation_0_7f3aefac> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1> ;
    dznorm:position 0 ;
    dznorm:provisionText "يكون هذا الاستيلاء مسبوقا بجرد"@ar ;
    dznorm:sourceArticle "art_681_bis_1" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة وجود حيازة من طرف المستفيد من الاستيلاء، يكون هذا الاستيلاء مسبوقا بجرد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "وبنفس الطريقة يترتب عن استعادة الحيازة من طرف المستفيد إعداد جرد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_condition_0_6e2c819c> a dznorm:Condition ;
    dznorm:conditionText "وفي حالة عدم الاتفاق"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد تعويض الاستيلاء باتفاق بين الأطراف."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي حالة عدم الاتفاق يحدد مبلغ التعويض عن طريق القضاء مع مراعاة ظروف وغرض الاستيلاء دون أن يتضرر المستفيد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2> ;
    dzdoc:position 2 ;
    dzdoc:text "كما يمكن منح التعويض في حالة تسبب المستفيد من الاستيلاء في نقص القيمة."@ar .

