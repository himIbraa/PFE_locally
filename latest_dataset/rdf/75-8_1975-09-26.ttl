<https://legal.dz/resource/order/1975-09-26/75-58#art_813_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_813> ;
    dzdoc:position 0 ;
