<https://legal.dz/resource/order/1975-09-26/75-58#version_art_664> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعدد الكفلاء لدين واحد، وبعقد واحد، وكانوا غير متضامنين فيما بينهم قسم الدين عليهم، ولا يجوز للدائن أن يطالب كل كفيل الا بقدر نصيبه في الكفالة. أما إذا كان الكفلاء قد التزموا بعقود متوالية ، فإن كل واحد منهم يكون مسؤولا عن الدين كله، الا إذا كان قد احتفظ لنفسه بحق التقسية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
