<https://legal.dz/resource/order/1975-09-26/75-58#version_art_772> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتقادم بعشرة (10) أعوام الدعاوى الشخصية التي تنشأ عن تطبيق نظام الملكية المشتركة بين الشاغلين وبين أحد الشاغلين والمتصرف . أما الدعاوى التي يكون من شأنها معارضة قرار الجمعية فيجب أن تقدم من طرف الشاغلين المعارضين منهم أو الغائبين في مدة شهرين ابتداءا من يوم إعلانها من طرف المتصرف وإلا سقطت الدعوى ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_772_19750926_OpEnact_be936395c3> ;
    dzdoc:replacementText "تتقادم بعشرة (10) أعوام الدعاوى الشخصية التي تنشأ عن تطبيق نظام الملكية المشتركة بين الشاغلين وبين أحد الشاغلين والمتصرف . أما الدعاوى التي يكون من شأنها معارضة قرار الجمعية فيجب أن تقدم من طرف الشاغلين المعارضين منهم أو الغائبين في مدة شهرين ابتداءا من يوم إعلانها من طرف المتصرف وإلا سقطت الدعوى ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_772> ;
