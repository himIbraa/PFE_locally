<https://legal.dz/resource/order/1975-09-26/75-58#version_art_776> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل تصرف قانوني يصدر عن شخص في حال مرض الموت بقصد التبرع يعتبر تبرعا مضافا إلى ما بعد الموت ، وتسري عليه أحكام الوصية أيا كانت التسمية التي تعطى إلى هذا التصرف. وعلى ورثة المتصرف أن يثبتوا ان التصرف القانوني قد صدر عن مورثهم وهو في مرض الموت ولهم إثبات بجميع الطرق، ولا يحتج على الورثة بتاريخ العقد إذا لم يكن هذا التاريخ ثابتا . إذا اثبت الورثة ان التصرف صدر عن مورثهم في مرض الموت اعتبر التصرف صادرا على سبيل التبرع ما لم يثبت من صدر له التصرف خلاف ذلك ، كل هذا ما لم توجد أحكام خاصة تخالفه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_776_19750926_OpEnact_cc21fd02d5> ;
    dzdoc:replacementText "كل تصرف قانوني يصدر عن شخص في حال مرض الموت بقصد التبرع يعتبر تبرعا مضافا إلى ما بعد الموت ، وتسري عليه أحكام الوصية أيا كانت التسمية التي تعطى إلى هذا التصرف. وعلى ورثة المتصرف أن يثبتوا ان التصرف القانوني قد صدر عن مورثهم وهو في مرض الموت ولهم إثبات بجميع الطرق، ولا يحتج على الورثة بتاريخ العقد إذا لم يكن هذا التاريخ ثابتا . إذا اثبت الورثة ان التصرف صدر عن مورثهم في مرض الموت اعتبر التصرف صادرا على سبيل التبرع ما لم يثبت من صدر له التصرف خلاف ذلك ، كل هذا ما لم توجد أحكام خاصة تخالفه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
