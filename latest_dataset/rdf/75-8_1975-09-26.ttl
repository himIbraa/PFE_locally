<https://legal.dz/resource/order/1975-09-26/75-58#version_art_426> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع الاتفاق على أن أحد الشركاء لا يسهم في أرباح الشركة ولا في خسائرها كان عقد الشركة باطلا. ويجوز الاتفاق على إعفاء الشريك الذي لم يقدم سوى عمله من كل مساهمة في الخسائر على شرط ألا يكون قد قررت له أجرة ثمن عمله ."@ar ;
