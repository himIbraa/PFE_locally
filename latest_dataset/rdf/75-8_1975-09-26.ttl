<https://legal.dz/resource/order/1975-09-26/75-58#version_art_331> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تكون الدفاتر والأوراق المنزلية حجة على من صدرت منه الا في الحالتين الآتيتين: إذا ذكر فيها صراحة أنه استوفي دينا ، إذا ذكر فيها صراحة أنه قصد بما دونه في هذه الدفاتر والأوراق أن تقوم مقام السند لمن أثبتت حقا لمصلحته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_331_19750926_OpEnact_cb0fdfe256> ;
    dzdoc:replacementText "لا تكون الدفاتر والأوراق المنزلية حجة على من صدرت منه الا في الحالتين الآتيتين: إذا ذكر فيها صراحة أنه استوفي دينا ، إذا ذكر فيها صراحة أنه قصد بما دونه في هذه الدفاتر والأوراق أن تقوم مقام السند لمن أثبتت حقا لمصلحته ."@ar ;
