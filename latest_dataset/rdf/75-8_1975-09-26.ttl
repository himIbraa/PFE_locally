<https://legal.dz/resource/order/1975-09-26/75-58#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "يطبق القانون الوطني على الالتزام بالنفقة بين الأقارب للمدين بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_14_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_14_19750926_OpEnact_55df36e0a9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "14" ;
    dzdoc:position 15 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_149> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_149" ;
    dzdoc:fullText "تسقط دعوى استرداد ما دفع بغير حق بانقضاء عشر (10) سنوات من اليوم الذي يعلم فيه من دفع غير المستحق بحقه في الاسترداد وتسقط الدعوى في جميع الأحوال بانقضاء خمسة عشرة (15) سنة من اليوم الذي ينشأ فيه هذا الحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_149> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_149_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_149_19750926_OpEnact_47c522d1a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "149" ;
    dzdoc:position 161 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_159> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_159" ;
    dzdoc:fullText "تسقط الدعوى الناشئة عن الفضالة بانقضاء عشر (10) سنوات من اليوم الذي يعلم فيه كل طرف بحقه، وتسقط في جميع الأحوال بانقضاء خمسة عشرة (15) سنة من اليوم الذي ينشأ فيه هذا الحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_159> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_159_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_159_19750926_OpEnact_eddf2a29e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 159" ;
    dzdoc:position 171 ;
    dzdoc:usesTerm dzterm:فضالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "لا يستحق التعويض إلا بعد اعذار المدين ما لم يوجد نص مخالف لذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_179_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_179_19750926_OpEnact_a05d25392a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "179" ;
    dzdoc:position 191 ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_190> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_190" ;
    dzdoc:fullText "يعتبر الدائن في استعماله حقوق مدينه نائبا عن هذا المدين، وكل ما ينتج عن استعمال هذه الحقوق يدخل في أموال المدين ويكون ضمانا لجميع دائنيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_190> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_190_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_190_19750926_OpEnact_ddd6e358ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 190" ;
    dzdoc:position 203 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_194> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_194" ;
    dzdoc:fullText "متى تقرر عدم معارضة التصرف للدائن استفاد من ذلك جميع الدائنين الذين صدر هذا التصرف إجحافا بحقهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_194> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_194_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_194_19750926_OpEnact_8df4b0f98a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 194" ;
    dzdoc:position 207 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_197> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_197" ;
    dzdoc:fullText "تسقط بالتقادم دعوى عدم نفاذ التصرف بانقضاء ثلاث (3) سنوات من اليوم الذي يعلم فيه الدائن بسبب عدم نفاذ التصرف وتسقط في جميع الأحوال بانقضاء خمسة عشرة (15) سنة من الوقت الذي صدر فيه التصرف المطعون فيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_197> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_197_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_197_19750926_OpEnact_22a33797d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 197" ;
    dzdoc:position 210 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_217> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_217" ;
    dzdoc:fullText "التضامن بين الدائنين أو بين المدينين لا يفترض، وانما يكون بناء على اتفاق أو نص في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_217> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_217_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_217_19750926_OpEnact_23f082239b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "217" ;
    dzdoc:position 230 ;
    dzdoc:usesTerm dzterm:debtors,
        dzterm:solidarity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_221> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_221" ;
    dzdoc:fullText "كل ما يستوفيه أحد الدائنين المتضامنين من الدين يصير ملكا لجميع الدائنين وتقسم بينهم حسب وتكون القسمة : بينهم بالتساوي ما لم يوجد اتفاق أو نص قانوني يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_221> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_221_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_221_19750926_OpEnact_93e98e9814> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "221" ;
    dzdoc:position 234 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_243> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_243" ;
    dzdoc:fullText "تشمل حوالة الحق ضماناته كالكفالة، والامتياز والرهون، ورهن الحيازة، كما تشمل ما حل من أقساط."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_243> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_243_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_243_19750926_OpEnact_85d7bdf80a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 243" ;
    dzdoc:position 256 ;
    dzdoc:usesTerm dzterm:assignment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_257> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_257" ;
    dzdoc:fullText "تتم حوالة الدين باتفاق بين الدائن والمحال عليه على أن يتقرر فيه أن هذا الأخير يحل محل المدين الأصلي في التزامه، وفي هذه الحالة تسري أحكام المادتين 254 و 256 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_257> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_257_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_257_19750926_OpEnact_6be4f694a7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "257" ;
    dzdoc:position 270 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_254>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_256> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_254>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_256> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "مسك دفاتر المواليد والوفيات، والتبليغات المتعلقة بها ينظمها القانون الخاص بالحالة المدنية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_27_19750926_OpEnact_51b1cdaea3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "27" ;
    dzdoc:position 33 ;
    dzdoc:usesTerm dzterm:civil_status_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_276> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_276" ;
    dzdoc:fullText "الشيء المستحق أصلا هو الذي يكون به الوفاء ، فلا يجبر الدائن على قبول شيء غيره ولو كان هذا الشيء مساويا له في القيمة أو كانت له قيمة أعلى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_276> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_276_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_276_19750926_OpEnact_de7f29c4af> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 276" ;
    dzdoc:position 289 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:payment,
        dzterm:thing_due .

<https://legal.dz/resource/order/1975-09-26/75-58#art_278> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_278" ;
    dzdoc:fullText "إذا كان المدين ملزما بالوفاء بالمصاريف زيادة على الدائن الأصلي وكان ما أداه لا يفي بالدين مع هذه الملحقات، خصم ما أدى من حساب المصاريف ثم من أصل الدين ما لم يتفق على غير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_278> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_278_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_278_19750926_OpEnact_38492000e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 278" ;
    dzdoc:position 291 ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:original_debt,
        dzterm:payment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_280> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_280" ;
    dzdoc:fullText "إذا لم يعين الدين على الوجه المبين في المادة 279 ، كان الخصم من حساب الدين الذي حل أجله، أو من الدين الاشد كلفة، وذلك إذا حل أجل ديون متعددة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_280> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_280_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_280_19750926_OpEnact_f1a267055f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 280" ;
    dzdoc:position 293 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_279> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_279> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "يسري على اكتساب الألقاب وتبديلها القانون المتعلق بالحالة المدنية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_29_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_29_19750926_OpEnact_a3e218d9cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 35 ;
    dzdoc:usesTerm dzterm:civil_status_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_293> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_293" ;
    dzdoc:fullText "لا تنتقل الكفالة العينية، أو الشخصية، ولا التضامن إلى الالتزام الجديد الا إذا رضي بذلك الكفلاء والمدينون المتضامنون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_293> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_293_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_293_19750926_OpEnact_a67f22ef67> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 293" ;
    dzdoc:position 306 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_299> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_299" ;
    dzdoc:fullText "تقع المقاصة مهما اختلفت مصادر الديون فيما عدا الحالات التالية : إذا كان أحد الدينين شيئا نزع دون حق من يد مالكه وكان مطلوبا رده، إذا كان أحد الدينين شيئا مودعا أو معارا للاستعمال وكان مطلوبا رده، إذا كان أحد الدينين حقا غير قابل للحجز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_299> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_299_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_299_19750926_OpEnact_7782db1a23> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "299" ;
    dzdoc:position 312 ;
    dzdoc:usesTerm dzterm:مقاصة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "ينظم الجنسية الجزائرية قانون الجنسية الخاص بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_30_19750926_OpEnact_f4369e89fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 36 ;
    dzdoc:usesTerm dzterm:nationality_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "تجري على المفقود والغائب الأحكام المقررة في التشريع العائلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_31_19750926_OpEnact_06beacab63> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 37 ;
    dzdoc:usesTerm dzterm:family_legislation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_314> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_314" ;
    dzdoc:fullText "تحسب مدة التقادم بالايام لا بالساعات، ولا يحسب اليوم الأول وتكمل المدة بانقضاء آخر يوم منها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_314> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_314_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_314_19750926_OpEnact_ea3ca662d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "314" ;
    dzdoc:position 327 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_323_bis" ;
    dzdoc:fullText "ينتج الإثبات بالكتابة من تسلسل حروف أو أوصاف أو أرقام أو أية علامات أو رموز ذات معنی مفهوم، مهما كانت الوسيلة التي تتضمنها ، وكذا طرق إرسالها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_323_bis_19750926_OpEnact_b34956746b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 323 مكرر" ;
    dzdoc:position 337 ;
    dzdoc:usesTerm dzterm:proof_by_writing .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324_bis_5" ;
    dzdoc:fullText "يعتبر ما ورد في العقد الرسمي حجة حتى يثبت تزويره ويعتبر نافذا في كامل التراب الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_5_19750926_OpEnact_fdd06ce4df> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324 مكرر 5" ;
    dzdoc:position 344 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "يراعى في ترتيب درجة القرابة المباشرة، اعتبار كل فرع درجة عند الصعود للأصل ما عدا هذا الأصل، وعند ترتيب درجة الحواشي تعد الدرجات صعودا من الفرع للأصل المشترك، ثم نزولا منه إلى الفرع الآخر، وكل فرع فيما عدا الأصل المشترك يعتبر درجة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_34_19750926_OpEnact_2ac0cdcc81> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 40 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يعتبر أقارب أحد الزوجين في نفس القرابة والدرجة بالنسبة إلى الزوج الآخر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_35_19750926_OpEnact_527e4ac86e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 41 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_366> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_366" ;
    dzdoc:fullText "إذا وجد في قدر المبيع نقص أو زيادة فإن حق المشتري في طلب انقاص الثمن، أو فسخ العقد وحق البائع في طلب تكملة الثمن يسقطان بالتقادم بعد مضي سنة من وقت تسليم المبيع تسليما فعليا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_366> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_366_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_366_19750926_OpEnact_5e54507cb6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 366" ;
    dzdoc:position 390 ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "يعتبر المكان الذي يمارس فيه الشخص تجارة أو حرفة موطنا صا بالنسبة إلى المعاملات المتعلقة بهذه التجارة أو المهنة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_37_19750926_OpEnact_fca5114331> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 43 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_382> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_382" ;
    dzdoc:fullText "تبقى دعوى الضمان مستمرة ولو هلك الشيء المبيع وبأي سبب كان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_382> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_382_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_382_19750926_OpEnact_b306034c26> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 382" ;
    dzdoc:position 406 ;
    dzdoc:usesTerm dzterm:guarantee_action .

<https://legal.dz/resource/order/1975-09-26/75-58#art_385> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_385" ;
    dzdoc:fullText "لا ضمان للعيب في البيوع القضائية ، ولا في البيوع الادارية إذا كانت بالمزاد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_385> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_385_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_385_19750926_OpEnact_1337f44e00> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 385" ;
    dzdoc:position 409 ;
    dzdoc:usesTerm dzterm:administrative_sales,
        dzterm:judicial_sales .

<https://legal.dz/resource/order/1975-09-26/75-58#art_401> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_401" ;
    dzdoc:fullText "لا تسري أحكام المادة 400 في الأموال الآتية : إذا كان الحق المتنازع فيه داخلا ضمن مجموعة أموال بيعت جزافا بثمن واحد، إذا كان الحق المتنازع فيه مشاعا بين ورثة أو شركاء وباع أحدهم نصيبه للآخر، إذا تنازل المدين لدائنه عن حق متنازع فيه وفاء للدين الثابت في ذمته، إذا كان الحق المتنازع فيه يكون دينا مترتبا على عقار وبيع الحق لحائز العقار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_401> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_401_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_401_19750926_OpEnact_fcb9a272f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 401" ;
    dzdoc:position 425 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_400> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_400> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_404> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_404" ;
    dzdoc:fullText "من باع تركة دون أن يفصل مشتملاتها، لا يضمن الا صفته كوارث ما لم يقع اتفاق يخالف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_404> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_404_para_0> ;
