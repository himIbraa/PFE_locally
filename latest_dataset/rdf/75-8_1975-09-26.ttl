<https://legal.dz/resource/order/1975-09-26/75-58#version_art_693> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لمالك الأرض المحصورة التي ليس لها أي ممر يصلها بالطريق العام أو كان لها ممر ولكنه غير كاف للمرور، أن يطلب حق المرور على الأملاك المجاورة مقابل تعويض يتناسب مع الاضرار التي يمكن أن تحدث من جراء ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
