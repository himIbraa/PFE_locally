<https://legal.dz/resource/order/1975-09-26/75-58#version_art_814> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتقل الحيازة إلى الخلف العام بجميع صفاتها غير أنه إذا كان السلف سيئ النية وأثبت الخلف أنه كان في حيازته حسن النية جاز له أن يتمسك بحسن نيته ، و يجوز للخلف الخاص أن يضم إلى حيازته حيازة سلفه ليبلغ التقادم ."@ar ;
