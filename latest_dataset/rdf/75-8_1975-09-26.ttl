<https://legal.dz/resource/order/1975-09-26/75-58#version_art_206> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الالتزام معلقا على شرط واقف ، فلا يكون نافذا الا إذا تحقق الشرط اما قبل تحقق الشرط، فلا يكون الالتزام قابلا للتنفيذ الجبري، ولا للتنفيذ الاختياري، على انه يجوز للدائن أن يتخذ من الاجراءات ما يحافظ به على حقه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_206_19750926_OpEnact_1ea4792386> ;
