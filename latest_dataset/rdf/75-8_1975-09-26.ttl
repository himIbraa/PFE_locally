<https://legal.dz/resource/order/1975-09-26/75-58#version_art_660> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للدائن أن يرجع على الكفيل وحده الا بعد رجوعه على المدين . ولا يجوز له أن ينفذ على أموال الكفيل الا بعد أن يجرد المدين من أمواله، و يجب على الكفيل في هذه الحالة أن يتمسك بهذا الحق ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_660_19750926_OpEnact_46a97d0443> ;
    dzdoc:replacementText "لا يجوز للدائن أن يرجع على الكفيل وحده الا بعد رجوعه على المدين . ولا يجوز له أن ينفذ على أموال الكفيل الا بعد أن يجرد المدين من أمواله، و يجب على الكفيل في هذه الحالة أن يتمسك بهذا الحق ."@ar ;
