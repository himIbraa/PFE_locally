<https://legal.dz/resource/order/1975-09-26/75-58#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "يكون اعذار المدين بانذاره، أو بما يقوم مقام الانذار، ويجوز أن يتم الاعذار عن طريق البريد على الوجه المبين في هذا القانون، كما يجوز أن يكون مترتبا على اتفاق يقضي بأن يكون المدين معذرا بمجرد حلول الأجل دون حاجة إلى أي إجراء آخر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_180_permission_0_73feaad5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_180_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_180_19750926_OpEnact_42126504b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "180" ;
    dzdoc:position 192 ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "إذا لم يكن التعويض مقدرا في العقد، أو في القانون فالقاضي هو الذي يقدره، ويشمل التعويض ما لحق الدائن من خسارة وما فاته من كسب، بشرط أن يكون هذا نتيجة طبيعية لعدم الوفاء بالالتزام أو للتأخر في الوفاء به. ويعتبر الضرر نتيجة طبيعية إذا لم يكن في استطاعة الدائن أن يتوقاه ببذل جهد معقول . غير أنه إذا كان الالتزام مصدره العقد ، فلا يلتزم المدين الذي لم يرتكب غشا أو خطأ جسيما إلا بتعويض الضرر الذي كان يمكن توقعه عادة وقت التعاقد."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_182_permission_0_3c3c79f7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_182_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_182_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_182_19750926_OpEnact_145470e017> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "182" ;
    dzdoc:position 194 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_182_condition_0_c7c4d738>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_182_condition_1_528aa4a3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_182_condition_2_c6dfd180> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_206> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_206" ;
    dzdoc:fullText "إذا كان الالتزام معلقا على شرط واقف ، فلا يكون نافذا الا إذا تحقق الشرط اما قبل تحقق الشرط، فلا يكون الالتزام قابلا للتنفيذ الجبري، ولا للتنفيذ الاختياري، على انه يجوز للدائن أن يتخذ من الاجراءات ما يحافظ به على حقه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_206_permission_0_00980e7d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_206_right_0_1807de0e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_206> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_206_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_206_19750926_OpEnact_1ea4792386> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "206" ;
    dzdoc:position 219 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_206_condition_0_a0852f57> ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_245> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_245" ;
    dzdoc:fullText "لا يضمن المحيل يسار المدين الا إذا وجد اتفاق خاص بهذا الضمان . وإذا ضمن المحيل يسار المدين فلا ينصرف هذا الضمان الآلي يسار المدين وقت الحوالة ما لم يتفق على غير"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_245> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_245_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_245_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_245_19750926_OpEnact_bdbd1948cf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 245" ;
    dzdoc:position 258 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_245_condition_0_1a8a6ef7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_245_condition_1_c0541ecc>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_245_condition_2_36c51895> ;
    dzdoc:usesTerm dzterm:assignment,
        dzterm:assignor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_295> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:novation ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_295" ;
    dzdoc:fullText "إذا اتفق المتعاقدون في الانابة أن يستبدلوا بالتزام سابق التزاما جديدا كانت هذه الانابة تجديدا للالتزام بتغيير المدين ويترتب عليها ابراء ذمة المنيب قبل المناب لديه على أن يكون الالتزام الجديد الذي ارتضاه المناب صحيحا والا يكون هذا الأخير معسرا وقت الانابة . غير أنه لا يفترض التجديد في الانابة ، فإن لم يكن هناك اتفاق على التجديد بقى الالتزام القديم إلى جانب الالتزام الجديد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_295_right_0_165a9a0f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_295> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_295_defocc_65befe66ab0b> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_295_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_295_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_295_19750926_OpEnact_73a25510e0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_295_obligation_0_9ebf0988> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 295" ;
    dzdoc:position 308 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_0_78bd843c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_1_29b944c7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_2_877a51d8>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_295_condition_3_c1a0d82b> ;
    dzdoc:usesTerm dzterm:delegation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_316> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_316" ;
    dzdoc:fullText "لا يسري التقادم كلما وجد مانع مبررا شرعا يمنع الدائن من المطالبة بحقه كما لا يسري فيما بين الأصيل و النائب . ولا يسري التقادم الذي تنقضي مدته عن خمس (5) سنوات في حق عديمي الأهلية و الغائبين و المحكوم عليهم بعقوبات جنائية إذا لم يكن لهم نائب قانوني . ولا يسري التقادم الذي تزيد مدته على خمس (5) سنوات في حق الأشخاص المذكورين في الفقرة السابقة ولو كان لهم نائب قانوني طيلة مدة عدم أهليتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_316> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_316_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_316_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_316_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_316_19750926_OpEnact_376788a0eb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_316_obligation_0_42edb281>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_316_obligation_1_a3d52660>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_316_obligation_2_e603b82a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_316_obligation_3_d2cba227> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_316_prohibition_0_c884675c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "316" ;
    dzdoc:position 329 ;
    dzdoc:usesTerm dzterm:absentee,
        dzterm:agent,
        dzterm:convict,
        dzterm:creditor,
        dzterm:incapacitated,
        dzterm:limitation_period,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_334> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_2> ;
    dzdoc:eId "art_334" ;
    dzdoc:fullText "لا يجوز الإثبات بالشهود ولو لم تزد القيمة على 100.000 دينار جزائري : فيما يخالف أو يجاوز ما اشتمل عليه مضمون عقد رسمي، إذا كان المطلوب هو الباقي، أو هو جزء من حق لا يجوز إثباته إلا بالكتابة، إذا طلب أحد الخصوم في الدعوى بما تزيد قيمته على 100.000 دينار جزائري ثم عدل عن طلبه إلى ما لا يزيد على هذه القيمة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_334_permission_0_0ea46166> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_334> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_334_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_334_19750926_OpEnact_1a50e1217b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_334_prohibition_0_0ea46166> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 334" ;
    dzdoc:position 358 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_338> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_3> ;
    dzdoc:eId "art_338" ;
    dzdoc:fullText "الأحكام التي حازت قوة الشيء المقضي به تكون حجة بما فصلت فيه من الحقوق، و لا يجوز قبول أي دليل ينقض هذه القرينة ولكن لا تكون لتلك الأحكام هذه الحجية الا في نزاع قام بين الخصوم انفسهم، دون أن تتغير صفاتهم وتتعلق بحقوق لها نفس المحل والسبب . ولا يجوز للمحكمة أن تأخذ بهذه القرينة تلقائيا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_338_permission_0_54e948c0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_338_permission_1_aa322316> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_338> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_338_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_338_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_338_19750926_OpEnact_b3678a1140> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_338_obligation_0_58d510af>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_338_obligation_1_71131d49> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "338" ;
    dzdoc:position 362 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_338_condition_0_6655d1b7> ;
    dzdoc:usesTerm dzterm:res_judicata .

<https://legal.dz/resource/order/1975-09-26/75-58#art_383> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_383" ;
    dzdoc:fullText "تسقط بالتقادم دعوى الضمان بعد انقضاء سنة من يوم تسليم المبيع حتى ولو لم يكتشف المشتري العيب الا بعد انقضاء هذا الأجل ما لم يلتزم البائع بالضمان لمدة أطول . غير أنه لا يجوز ل لبائع أن يتمسك بسنة التقادم متى تبين انه أخفي العيب غشا منه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_383_permission_0_413b6d85> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_383> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_383_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_383_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_383_19750926_OpEnact_097cdcc50b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_383_prohibition_0_413b6d85> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 383" ;
    dzdoc:position 407 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_383_condition_0_c9deb3f5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_383_condition_1_76008750> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:guarantee_action,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_439> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_4> ;
    dzdoc:eId "art_439" ;
    dzdoc:fullText "تنتهي الشركة بموت أحد الشركاء أو الحجر عليه أو باعساره أو بافلاسه. إلا أنه يجوز الاتفاق في حالة ما إذا مات أحد الشركاء أن تستمر الشركة مع ورثته ولو كانوا قصرا. ويجوز أيضا الاتفاق على انه إذا مات أحد الشركاء أو حجر عليه أو أفلس أو انسحب من الشركة وفقا ل المادة 440 ، أن تستمر الشركة بين الشركاء الباقين وفي هذه الحالة لا يكون لهذا الشريك أو لورثته الا نصيبه في أموال الشركة، ويقدر هذا النصيب بحسب قيمته يوم وقوع الحادث الذي أدى إلى خروجه من الشركة ويدفع له نقدا ولا يكون له نصيب فيما يستجد بعد ذلك من حقوق الا بقدر الحقوق الناتجة من أعمال سابقة على ذلك الحادث."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_439_permission_0_7267853d> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_439_right_0_38441e36>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_439_right_1_2fb93414> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_439> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_439_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_439_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_439_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_439_19750926_OpEnact_2c6dc5037b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_439_obligation_0_e03ec01a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "439" ;
    dzdoc:position 463 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_440> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_440> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_469_bis_1" ;
    dzdoc:fullText "ينتهي الإيجار بانقضاء المدة المتفق عليها دون حاجة إلى تنبيه بالإخلاء. يجوز للمستأجر إنهاء عقد الإيجار قبل ذلك لسبب عائلي أو مهني . و يجب عليه إخطار المؤجر بموجب محرر غیر قضائي يتضمن إشعارا لمدة شهرين ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1_permission_0_0e94efd8> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1_right_0_7ff832af> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_1_19750926_OpEnact_42a1f12dac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1_obligation_0_882e1722> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 469 مكرر 1" ;
    dzdoc:position 496 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_610> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_610" ;
    dzdoc:fullText "يلتزم الحارس باتخاذ دفاتر حساب منظمة ويجوز للقاضي إلزامه باتخاذ دفاتر موقع عليها من طرفه. ويلتزم أن يقدم لذوي الشأن في كل سنة على الأقل حسابا على ما قبضه وما أنفقه مؤيدا بمستندات مثبتة له . وإذا كان الحارس قد عينه القاضي وجب عليه فوق ذلك أن يودع صورة هذا الحساب بقلم الكتاب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_610> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_610_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_610_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_610_19750926_OpEnact_ebdce6977f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_610_obligation_0_57d71ea2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_610_obligation_1_69a4f60e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_610_obligation_2_d061c679> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "610" ;
    dzdoc:position 647 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_610_condition_0_02030587> ;
    dzdoc:usesTerm dzterm:حارس .

<https://legal.dz/resource/order/1975-09-26/75-58#art_677> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_677" ;
    dzdoc:fullText "لا يجوز حرمان أي أحد من ملكيته الا في الأحوال والشروط المنصوص عليها في القانون. غير أن للإدارة الحق في نزع جميع الملكية العقارية أو بعضها ، أو نزع الحقوق العينية العقارية للمنفعة العامة مقابل تعويض منصف وعادل. وإذا وقع خلاف في مبلغ التعويض وجب أن يحدد هذا المبلغ بحكم قضائي الا أن تحديد مبلغ التعويض يجب أن لا يشكل بأي حال مانعا لحيازة الأملاك المنتزعة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_677_permission_0_4dd24de0> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_677_right_0_df1f4829> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_677> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_677_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_677_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_677_19750926_OpEnact_52387e52a5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_677_obligation_0_0b2e04f0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_677_obligation_1_a78ae42a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_677_prohibition_0_4dd24de0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 677" ;
    dzdoc:position 714 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_677_condition_0_b8b0edbb> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_691> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_691" ;
    dzdoc:fullText "يجب على المالك الا يتعسف في استعمال حقه إلى حد يضر بملك الجار . وليس للجار أن يرجع على جاره في مضار الجوار المألوفة غير أنه يجوز له أن يطلب إزالة هذه المضار إذا تجاوزت الحد المألوف وعلى القاضي أن يراعي في ذلك العرف وطبيعة العقارات وموقع كل منها بالنسبة إلى الآخرين والغرض الذي خصصت له."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_691_permission_0_73dd5d53> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_691_right_0_48daab65> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_691> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_691_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_691_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_691_19750926_OpEnact_1cbdff343d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_691_obligation_0_81d3f363> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "691" ;
    dzdoc:position 731 ;
    dzdoc:usesTerm dzterm:owner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_705> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_705" ;
    dzdoc:fullText "للمالك إذا كانت له مصلحة جدية في تعلية الحائط المشترك أن يعليه بشرط أن لا يلحق بشريكه ضررا بليغا ، و عليه أن يتحمل وحده نفقة التعلية وصيانة الجزء المعلى وأن يقوم بالأعمال اللازمة لجعل الحائط قادرا على حمل زيادة العبء الناشئ عن التعلية دون أن يفقد شيئا من متانته . فإذا لم يكن الحائط المشترك صالحا لتحمل التعلية فعلى من يرغب فيها من الشركاء أن يعيد بناء الحائط كله على نفقته بحيث يقع ما زاد من سمكه في ناحيته هو بقدر الاستطاعة ، ويظل الحائط المجدد في غير الجزء المعلى مشتركا دون أن يكون للجار الذي أحدث التعلية حق في التعويض."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_705_right_0_c0c2c8cf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_705> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_705_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_705_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_705_19750926_OpEnact_2da3fb4ca2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_705_obligation_0_263f1d0d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_705_obligation_1_df7525db> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 705" ;
    dzdoc:position 745 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_705_condition_0_cdc61e4b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_705_condition_1_ba66fb31> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_736> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_736" ;
    dzdoc:fullText "يمكن للشركاء أن يتفقوا أثناء اجراءات القسمة النهائية على أن يقسم المال الشائع مهايأة بينهم ، وتظل هذه القسمة نافذة حتى تتم القسمة النهائية. فإذا تعذر اتفاق الشركاء على قسمة المهاية ، جاز للمحكمة أن تأمر بها إذا طلب منها ذلك أحد الشركاء وبعد الاستعانة، إذا اقتضى الأمر ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_736_permission_0_9faaf112> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_736_right_0_46ebd232>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_736_right_1_5cbb2050> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_736> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_736_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_736_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_736_19750926_OpEnact_a00dd92352> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "736" ;
    dzdoc:position 776 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_736_condition_0_1f096227> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_764_bis_2" ;
    dzdoc:fullText "تنطبق القرارات التي صادقت عليها الجمعية العامة على جميع الشركاء في الملكية أو الشاغلين لها وكذا خلفائهم . ولا يمكن منازعة هذه القرارات من طرف المعارضين أو الغائبين الذين لم يتم تمثيلهم، إلا أمام المحكمة وذلك في أجل شهرين ابتداء من تاريخ تبليغ القرارات تحت طائلة سقوط الحق ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_2_permission_0_47eb35ac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_2_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_bis_2_19750926_OpEnact_37f7b815b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_2_obligation_0_e14b2f28>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_2_obligation_1_847b43f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "764 مكرر 2" ;
    dzdoc:position 815 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_2_condition_0_3a0bec7d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_779> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_779" ;
    dzdoc:fullText "تكون ملكا للدولة الأرض التي ينكشف عنها البحر. لا يجوز التعدي على أرض البحر ، والأرض التي تستخلص بكيفية صناعية من مياه البحر تكون ملكا للدولة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_779_permission_0_37f82456> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_779> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_779_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_779_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_779_19750926_OpEnact_eafed59827> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_779_obligation_0_a715ebda> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_779_prohibition_0_37f82456> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "779" ;
    dzdoc:position 830 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_848> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_848" ;
    dzdoc:fullText "يلزم المنتفع أثناء انتفاعه بكل ما يعرض على العين المنتفع بها من التكاليف المعتادة وبكل النفقات التي تقتضيها أعمال الصيانة . أما التكاليف غير المعتادة والاصلاحات الجسيمة التي لم تنشأ عن خطأ المنتفع فانها تكون على المالك ويلتزم بأن يؤدي للمالك فوائد ما انفقه في ذلك ، وإذا كان المنتفع هو الذي قام بالانفاق ، كان له استرداد رأس المال عند انتهاء حق الانتفاع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_848_right_0_ef0225f4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_848> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_848_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_848_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_848_19750926_OpEnact_202156d463> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_848_obligation_0_68872b8b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_848_obligation_1_ca84f9b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 848" ;
    dzdoc:position 899 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_848_condition_0_233bfd2f> ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_893> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_893" ;
    dzdoc:fullText "لا ينفصل الرهن عن الدين المضمون، بل يكون تابعا له في صحته وفي انقضائه ، ما لم ينص القانون على غير ذلك . وإذا كان الراهن غير المدين كان له إلى جانب تمسكه بأوجه الدفع الخاصة به أن يتمسك بما للمدين التمسك به من أوجه الدفع المتعلقة بالدين ، ويبقى له هذا الحق ولو تنازل عنه المدين . 1 - بالنسبة إلى الراهن"@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_893_right_0_be3efeef>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_893_right_1_238cc180> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_893> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_893_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_893_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_893_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_893_19750926_OpEnact_658c6488f3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_893_obligation_0_4ed3d946> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "893" ;
    dzdoc:position 944 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_893_condition_0_7921964f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_893_condition_1_d13fc884> ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_899> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_899" ;
    dzdoc:fullText "إذا تسبب الراهن بخطئه في هلاك العقار المرهون أو تلفه كان للدائن المرتهن الخيار بين أن يطلب تأمينا كافيا أو أن يستوفي حقه فورا . وإذا نشأ الهلاك أو التلف عن سبب لا ينسب إلى الدائن ولم يقبل الدائن بقاء الدين بلا تأمين ، فللمدين الخيار بين أن يقدم تأمينا كافيا أو أن يوفي الدين فورا قبل حلول الأجل . وفي جميع الأحوال إذا كان من شأن الأعمال الواقعة أن تعرض العقار المرهون للهلاك أو للتلف أو جعله غير كاف للضمان ، كان للدائن المرتهن أن يطلب من القاضي وقف هذه الأعمال والأمر باتخاذ الوسائل التي تمنع وقوع الضرر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_899_right_0_192b8446>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_899_right_1_074936fa>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_899_right_2_6234fa25> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_899> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_899_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_899_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_899_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_899_19750926_OpEnact_6bf4f28510> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 899" ;
    dzdoc:position 950 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_899_condition_0_768f907b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_899_condition_1_4bcc8886>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_899_condition_2_2adf947c> ;
    dzdoc:usesTerm dzterm:mortgagee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_903> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_903" ;
    dzdoc:fullText "يكون باطلا كل اتفاق يجعل للدائن الحق عند عدم استيفاء الدين وقت حلول أجله في أن يتملك العقار المرهون في نظير ثمن معلوم أيا كان أو في أن يبيعه دون مراعاة للإجراءات التي فرضها القانون ولو كان هذا الاتفاق قد أبرم بعد الرهن . غير أنه يجوز بعد حلول الدين أو قسط منه الاتفاق على أن يتنازل المدين لدائنه عن العقار المرهون وفاء لدينه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_903_permission_0_e74e76a9> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_903_right_0_70253ee9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_903> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_903_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_903_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_903_19750926_OpEnact_e88214050c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_903_obligation_0_8d03374e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "903" ;
    dzdoc:position 954 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:mortgaged_property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_924> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_924" ;
    dzdoc:fullText "يجوز للحائز الذي سجل سند ملكيته ولم يكن طرفا في الدعوى التي حكم فيها على المدين بالدين، أن يتمسك بأوجه الدفع التي كان للمدين أن يتمسك بها ، إذا كان الحكم بالدين لاحقا لتسجيل سند الحائز . ويجوز له كذلك، في جميع الأحوال، أن يتمسك بالدفوع التي لا يزال للمدين بعد الحكم بالدين حق التمسك بها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_924_permission_0_19c5b011> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_924_right_0_72edb47b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_924_right_1_5ad69c51> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_924> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_924_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_924_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_924_19750926_OpEnact_6cfbb7266d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "924" ;
    dzdoc:position 975 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_924_condition_0_36ec10b7> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_935> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_3> ;
    dzdoc:eId "art_935" ;
    dzdoc:fullText "لا يترتب على بيع عقار مرهون انتقال الدين إلى المشتري إلا إذا وجد اتفاق صريح على ذلك . وإذا اتفق البائع والمشتري على تحويل الدين وكان عقد البيع مقيدا ، وجب على الدائن، بعد الاعلان الموجه إليه بذلك بطريقة قانونية، أن يوافق على التحويل أو يرفضه في أجل لا يتجاوز ستة (6) أشهر و إذا سكت إلى انقضاء الأجل ، كان سكوته بمثابة تصديق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_935> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_935_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_935_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_935_19750926_OpEnact_12aa32dd16> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_935_obligation_0_aac8aff1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "935" ;
    dzdoc:position 986 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_935_condition_0_51bdee4c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_935_condition_1_50107698>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_935_condition_2_f2979444> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_946> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_2> ;
    dzdoc:eId "art_946" ;
    dzdoc:fullText "يجوز لكل ذي مصلحة أن يطالب إنقاص التخصيص إلى الحد المناسب ، إذا كانت الأعيان التي رتب عليها هذا الحق تزيد قيمتها على ما يكفي لضمان الدين . ويكون إنقاص التخصيص إما بقصره على جزء من العقار أو العقارات التي رتب عليها ، أو بنقله إلى عقار آخر تكون قيمته كافية لضمان الدين. وإما المصاريف اللازمة لإجراء الانقاص تكون على من طلب الانقاص ولو تم بموافقة الدائن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_946_permission_0_cef2bae4> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_946_right_0_e31698d2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_946> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_946_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_946_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_946_19750926_OpEnact_33986aaee2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_946_obligation_0_604fade4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "946" ;
    dzdoc:position 997 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_946_condition_0_53c4ac5f> ;
    dzdoc:usesTerm dzterm:judiciary_charge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_980> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_980" ;
    dzdoc:fullText "إذا حل الدين المرهون قبل حلول الدين المضمون بالرهن ، فلا يجوز للمدين أن يوفي الدين إلا للمرتهن والراهن معا ، و يستطيع كل من هذين الأخيرين أن يطلب من المدين إيداع ما يؤديه ، وينتقل حق الرهن إلى ما تم إيداعه. على المرتهن والراهن أن يتعاونا على استغلال ما أداه المدين ، وأن يكون ذلك على أنفع الوجوه للراهن دون أن يكون فيه ضرر للدائن المرتهن مع المبادرة إلى إنشاء رهن جديد لمصلحة هذا الدائن."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_980_permission_0_cee7d59f> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_980_right_0_f109dfb8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_980> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_980_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_980_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_980_19750926_OpEnact_791f8590aa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_980_obligation_0_cd5e84fd>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_980_obligation_1_ca01b821> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "980" ;
    dzdoc:position 1031 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_980_condition_0_8260b06e> .

