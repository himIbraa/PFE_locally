<https://legal.dz/resource/order/1975-09-26/75-58#version_art_671> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وفي الكفيل الدين ، كان له أن يحل محل الدائن في جميع ما له من حقوق تجاه المدين . ولكن إذا لم يوف الا بعض الدين ، فلا يرجع بما وفاه الا بعد أن يستوفي الدائن كل حقه من المدين ."@ar ;
