<https://legal.dz/resource/order/1975-09-26/75-58#version_art_975> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يكون رهن الدين نافذا في حق المدين إلا باعلان هذا الرهن إليه أو بقبوله له وفقا ل المادة 241 . ولا يكون نافذا في حق الغير إلا بتسليم سند الدين المرهون إلى المرتهن ، وتحسب للرهن مرتبته من التاريخ الثابت للاعلان أو القبول."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_975_19750926_OpEnact_fc0c7240fe> ;
