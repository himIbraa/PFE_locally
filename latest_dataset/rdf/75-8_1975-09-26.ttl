<https://legal.dz/resource/order/1975-09-26/75-58#art_824_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_824> ;
    dzdoc:position 2 ;
    dzdoc:text "ويفترض حسن النية دائما حتى يقوم الدليل على العكس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_825_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_825> ;
