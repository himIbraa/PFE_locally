<https://legal.dz/resource/order/1975-09-26/75-58#version_art_540> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اضطر المستعير إلى الانفاق للمحافظة على الشيء أثناء العارية فالمعير ملزم برد ما أنفقه المستعير من مصاريف . أما المصاريف النافعة فتجري عليها الأحكام الخاصة بالمصاريف التي ينفقها حائز الشيء وهو سيئ النية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_540_19750926_OpEnact_0dd268607e> ;
    dzdoc:replacementText "إذا اضطر المستعير إلى الانفاق للمحافظة على الشيء أثناء العارية فالمعير ملزم برد ما أنفقه المستعير من مصاريف . أما المصاريف النافعة فتجري عليها الأحكام الخاصة بالمصاريف التي ينفقها حائز الشيء وهو سيئ النية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_540> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_540> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
