<https://legal.dz/resource/order/1975-09-26/75-58#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2_bis> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "يزول حق إبطال العقد بالاجازة الصريحة أو الضمنية وتستند الاجازة إلى التاريخ الذي تم فيه العقد، دون إخلال بحقوق الغير."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_100_right_0_6f7e51b2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_100_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_100_19750926_OpEnact_85a17340f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "100" ;
    dzdoc:position 107 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_4> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "في العقود الملزمة للجانبين إذا انقضى التزام بسبب استحالة تنفيذه انقضت معه الالتزامات المقابلة له وينفسخ العقد بحكم القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_121_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_121_19750926_OpEnact_c14342d6ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 121" ;
    dzdoc:position 128 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_121_condition_0_9b07d262> ;
    dzdoc:usesTerm dzterm:bilateral_contracts .

<https://legal.dz/resource/order/1975-09-26/75-58#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_4> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "إذا فسخ العقد أعيد المتعاقدان إلى الحالة التي كانا عليها قبل العقد، فإذا استحال ذلك جاز للمحكمة أن تحكم بالتعويض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_122_19750926_OpEnact_96a568c5e8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 122" ;
    dzdoc:position 129 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_122_condition_0_3facf714> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "كل فعل أيا كان يرتكبه الشخص بخطئه، ويسبب ضررا للغير يلزم من كان سببا في حدوثه بالتعويض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_124_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_124_19750926_OpEnact_7f8b6e2097> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_124_obligation_0_aa69cb67> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "124" ;
    dzdoc:position 133 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "لا يسأل المتسبب في الضرر الذي يحدثه بفعله أو امتناعه أو بإهمال منه أو عدم حيطته إلا إذا كان مميزا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_125_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_125_19750926_OpEnact_ae292247c2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "125" ;
    dzdoc:position 135 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_125_condition_0_ece407ee> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "إذا أثبت الشخص أن الضرر قد نشأ عن سبب لا يد له فيه كحادث مفاجئ، أو قوة قاهرة، أو خطأ صدر من المضرور أو خطأ من الغير كان غير ملزم بتعويض هذا الضرر، ما لم يوجد نص قانوني أو اتفاق يخالف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_127_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_127_19750926_OpEnact_c0852e901b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "127" ;
    dzdoc:position 137 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_127_condition_0_21a0d63a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "لا يكون الموظفون والأعوان العموميون مسؤولين شخصيا عن أفعالهم التي أضرت بالغير إذا قاموا بها تنفيذا لأوامر صدرت إليهم من رئيس متى كانت إطاعة هذه الأوامر واجبة عليهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_129_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_129_19750926_OpEnact_0d322d4e09> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "129" ;
    dzdoc:position 139 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_129_condition_0_15d24275> ;
    dzdoc:usesTerm dzterm:public_officials .

<https://legal.dz/resource/order/1975-09-26/75-58#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "يسري القانون الجزائري وحده في الأحوال المنصوص عليها في المادتين 11 و 12 إذا كان أحد الزوجين جزائريا وقت انعقاد الزواج ، إلا فيما يخص أهلية الزواج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_19750926_OpEnact_4ddf7f2a01> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "13" ;
    dzdoc:position 12 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_11>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_12> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_11>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_12> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_13_condition_0_47dd3328> ;
    dzdoc:usesTerm dzterm:algerian_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_13_bis" ;
    dzdoc:fullText "يسري على النسب والإعتراف به وإنكاره قانون جنسية الأب وقت ميلاد الطفل. وفي حالة وفاة الأب قبل ميلاد الطفل يطبق قانون جنسية الأب وقت الوفاة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis_19750926_OpEnact_7df791fb19> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "13 مكرر" ;
    dzdoc:position 13 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_13_bis_1" ;
    dzdoc:fullText "يسري على صحة الكفالة قانون جنسية كل من الكفيل والمكفول وقت إجرائها، ويسري على آثارها قانون جنسية الكفيل. وتطبق نفس الأحكام على التبني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis_1_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_13_bis_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_13_bis_1_19750926_OpEnact_d9cdbf0aee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "13 مكرر 1" ;
    dzdoc:position 14 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "إذا لم تتوافر أهلية التعاقد فيمن تسلم غير المستحق فلا يكون ملزما إلا بالقدر الذي أثرى به."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_148_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_148_19750926_OpEnact_0eb923f1df> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "148" ;
    dzdoc:position 160 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_148_condition_0_072fa45b> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:فضالة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "الفضالة هي أن يتولى شخص عن قصد القيام بالشأن لحساب شخص آخر، دون أن يكون ملزما بذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_150> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_150_defocc_86aa7d06a1aa> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_150_19750926_OpEnact_e7d02364ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 162 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "تسري قواعد الوكالة إذا أجاز رب العمل ما قام به الفضولي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_152_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_152_19750926_OpEnact_027b90c16f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 152" ;
    dzdoc:position 164 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_152_condition_0_c7b32c7b> ;
    dzdoc:usesTerm dzterm:وكالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "يلزم الفضولي بما يلزم به الوكيل من رد ما تسلمه بسبب الفضالة ، وتقديم حساب ما قام به ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_155_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_155_19750926_OpEnact_146d3836ee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_155_obligation_0_b373daf8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 167 ;
    dzdoc:usesTerm dzterm:فضالة,
        dzterm:فضولي .

<https://legal.dz/resource/order/1975-09-26/75-58#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "يسري على الميراث والوصية وسائر التصرفات التي تنفذ بعد الموت قانون جنسية الهالك أو الموصي أو من صدر منه التصرف وقت موته. ويسري على الهبة والوقف قانون جنسية الواهب أو الواقف وقت إجرائهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_16_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_16_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_16_19750926_OpEnact_f080af1e73> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "16" ;
    dzdoc:position 17 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "لا يسترد المدين ما أداه باختياره، بقصد تنفيذ التزام طبيعي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_162_19750926_OpEnact_123a578ce6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_162_obligation_0_db6b7142> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "162" ;
    dzdoc:position 174 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "الالتزام بنقل الملكية، أو أي حق عيني آخر من شأنه أن ينقل بحكم القانون الملكية أو الحق العيني، إذا كان محل الالتزام شيئا معينا بالذات يملكه الملتزم ، وذلك مع مراعاة الأحكام المتعلقة بالاشهار العقاري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_165_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_165_19750926_OpEnact_4347a8a7b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_165_obligation_0_bc6af369> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 165" ;
    dzdoc:position 177 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "الالتزام بنقل حق عيني يتضمن الالتزام بتسليم الشيء والمحافظة عليه حتى التسليم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_167_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_167_19750926_OpEnact_8965687a7f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_167_obligation_0_8b5c957e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 179 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "في الالتزام بعمل، قد يكون حكم القاضي بمثابة سند التنفيذ، إذا سمحت بهذا طبيعة الالتزام مع مراعاة المقتضيات القانونية والتنظيمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_171_19750926_OpEnact_5de405dfbd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 183 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_171_condition_0_14138919> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "إذا تسبب الدائن بسوء نيته، وهو يطالب بحقه، في إطالة أمد النزاع فللقاضي أن يخفض مبلغ التعويض المحدد في الاتفاق أو لا يقضي به إطلاقا عن المدة التي طال فيها النزاع بلا مبرر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_187_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_187_19750926_OpEnact_55a91043e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 187" ;
    dzdoc:position 200 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_187_condition_0_1245bca4> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_199> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_199" ;
    dzdoc:fullText "إذا أخفي المتعاقدان عقدا حقيقيا بعقد ظاهر فـ العقد النافذ فيما بين المتعاقدين ، و الخلف العام هو العقد الحقيقي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_199> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_199_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_199_19750926_OpEnact_832c456bf7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 199" ;
    dzdoc:position 212 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_199_condition_0_586c4d7b> ;
    dzdoc:usesTerm dzterm:contracting_parties,
        dzterm:enforceable_contract,
        dzterm:real_contract,
        dzterm:universal_successor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_203> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:conditional_obligation ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_203" ;
    dzdoc:fullText "يكون الالتزام معلقا إذا كان وجوده أو زواله مترتبا على أمر مستقبل وممكن وقوعه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_203> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_203_defocc_edbbc6bc7d60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_203_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_203_19750926_OpEnact_03aed9be42> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "203" ;
    dzdoc:position 216 ;
    dzdoc:usesTerm dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:التزام_تخييري ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "يكون الالتزام تخييريا إذا شمل محله أشياء متعددة تبرأ ذمة المدين براءة تامة إذا أدى واحد منها ، ويكون الخيار لـ المدين ما لم ينص القانون أو يتفق المتعاقدان على غير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_213> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_213_defocc_64ea5fef7bb1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_213_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_213_19750926_OpEnact_ca01e9223c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 213" ;
    dzdoc:position 226 ;
    dzdoc:usesTerm dzterm:الخيار,
        dzterm:المدين .

<https://legal.dz/resource/order/1975-09-26/75-58#art_224> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_224" ;
    dzdoc:fullText "يترتب على تجديد الدين بين الدائن وأحد المدينين المتضامنين تبرئة ذمة باقي المدينين إلا إذا احتفظ الدائن بحقه قبلهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_224> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_224_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_224_19750926_OpEnact_0fe19cce29> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "224" ;
    dzdoc:position 237 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_224_condition_0_c9e5d54f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_226> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_226" ;
    dzdoc:fullText "إذا اتحدت الذمة بين شخص الدائن وأحد مدينيه المتضامنين ، فإن الدين لا ينقضي بالنسبة إلى باقي المدينين الا بقدر حصة المدين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_226> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_226_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_226_19750926_OpEnact_dad76331bd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "226" ;
    dzdoc:position 239 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_226_condition_0_2bbfa575> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_228> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_228" ;
    dzdoc:fullText "إذا ابرأ الدائن أحد المدينين المتضامنين من التضامن بقي حقه في الرجوع على الباقين بكل الدين ما لم يكن هناك اتفاق على غير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_228> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_228_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_228_19750926_OpEnact_e21b65c0b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "228" ;
    dzdoc:position 241 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_228_condition_0_e0821236> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_229> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_229" ;
    dzdoc:fullText "في جميع الأحوال التي يحصل فيها الابراء سواء من الدين ، أو من التضامن يرجع فيها باقي المدينين على المدين المبرأ بنصيبه في حصة المعسر منهم وفقا ل المادة 235 غير أن الدائن إذا اخلى المدين المبرأ من كل مسؤولية الدين يتحمل نصيب هذا المدين في حصة المعسر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_229> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_229_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_229_19750926_OpEnact_47ad454b9b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 229" ;
    dzdoc:position 242 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_235> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_235> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_229_condition_0_e2c6f44d> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debt,
        dzterm:debtor,
        dzterm:debtors,
        dzterm:discharge,
        dzterm:solidarity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_23_bis_2" ;
    dzdoc:fullText "تطبق المبادئ العامة للقانون الدولي الخاص فيما لم يرد بشأنه نص في المواد الخاصة بتنازع القوانين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_2_19750926_OpEnact_2cbf7ddc1f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_2_obligation_0_8c24597c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "23 مكرر 2" ;
    dzdoc:position 29 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_240> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_240" ;
    dzdoc:fullText "لا تجوز حوالة الحق الا إذا كان الحق قابلا للحجز ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_240> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_240_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_240_19750926_OpEnact_1d0824bacc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 240" ;
    dzdoc:position 253 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_240_condition_0_42b953f8> ;
    dzdoc:usesTerm dzterm:assignment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_247> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_247" ;
    dzdoc:fullText "يسأل المحيل عن أفعاله الشخصية ولو كانت الحوالة مجانية أو بغير ضمان."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_247> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_247_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_247_19750926_OpEnact_d3c3dadb51> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_247_obligation_0_c907a6ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 247" ;
    dzdoc:position 260 ;
    dzdoc:usesTerm dzterm:assignment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_249> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_1> ;
    dzdoc:eId "art_249" ;
    dzdoc:fullText "في حالة وقوع خلاف بين عدة حوالات تخص حقا واحدا فضلت الحوالة التي تصبح قبل غيرها نافذة في حق الغير."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_249> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_249_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_249_19750926_OpEnact_c5e889398d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 249" ;
    dzdoc:position 262 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_249_condition_0_fb29c6e1> ;
    dzdoc:usesTerm dzterm:assignment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_251> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:حوالة_الدين ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_251" ;
    dzdoc:fullText "تتم حوالة الدين باتفاق بين المدين وشخص آخر يتحمل عنه الدين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_251> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_251_defocc_afab1eaa8325> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_251_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_251_19750926_OpEnact_ae187c7f74> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "251" ;
    dzdoc:position 264 ;
    dzdoc:usesTerm dzterm:المدين,
        dzterm:حوالة_الدين .

<https://legal.dz/resource/order/1975-09-26/75-58#art_255> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_4_sec_2> ;
    dzdoc:eId "art_255" ;
    dzdoc:fullText "يضمن المدين الأصلي يسار المحال عليه وقت اقرار الدائن للحوالة ما لم يتفق على غير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_255> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_255_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_255_19750926_OpEnact_81446fe3f0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_255_obligation_0_f7d40fde> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "255" ;
    dzdoc:position 268 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_260> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_260" ;
    dzdoc:fullText "يشترط لصحة الوفاء أن يكون الموفي مالكا للشيء الذي وفي به، وان يكون ذا أهلية للتصرف فيه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_260> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_260_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_260_19750926_OpEnact_5dd487eb16> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_260_obligation_0_8cb1a733> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 260" ;
    dzdoc:position 273 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_264> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_264" ;
    dzdoc:fullText "من حل محل الدائن قانونا أو اتفاقا كان له حقه بما لهذا الحق من خصائص وما يلحقه من توابع، وما يكلفه من تأمينات وما يرد عليه من دفوع ويكون هذا الحلول بالقدر الذي أداه من ماله من حل محل الدائن ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_264_right_0_f2958193> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_264> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_264_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_264_19750926_OpEnact_1942d01f9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 264" ;
    dzdoc:position 277 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_266> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_266" ;
    dzdoc:fullText "إذا وفي الغير الحائز للعقار المرهون كل الدين وحل محل الدائنين فلا يكون له بمقتضى هذا الحلول الرجوع على حائز لعقار آخر مرهون في ذات الدين الا بقدر حصة هذا الحائز بحسب قيمة العقار المحوز."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_266> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_266_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_266_19750926_OpEnact_fd5e6cadcb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 266" ;
    dzdoc:position 279 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_266_condition_0_ccc61071> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_269> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_269" ;
    dzdoc:fullText "إذا رفض الدائن دون مبرر قبول الوفاء المعروض عليه عرضا صحيحا أو رفض القيام بالاعمال التي لا يتم الوفاء الا بها، أو أعلن انه لن يقبل الوفاء ، اعتبر انه قد تم اعذاره من الوقت الذي يسجل المدين عليه هذا الرفض باعلان رسمي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_269> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_269_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_269_19750926_OpEnact_9089fd0903> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "269" ;
    dzdoc:position 282 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_269_condition_0_859244e9> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_274> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_274" ;
    dzdoc:fullText "يقوم العرض الحقيقي بالنسبة إلى المدين مقام الوفاء، إذا تلاه ايداع وفقا لاحكام قانون الاجراءات المدنية، أو تلاه أي إجراء مماثل يشترط قبول الدائن أو صحته بحكم له قوة الشيء المقضى به ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_274> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_274_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_274_19750926_OpEnact_b33daa80d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "274" ;
    dzdoc:position 287 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_274_condition_0_502c7bb8> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_285> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_1> ;
    dzdoc:eId "art_285" ;
    dzdoc:fullText "إذا قبل الدائن في استيفاء حقه مقابلا استعاض به عن الشيء المستحق قام هذا مقام الوفاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_285> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_285_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_285_19750926_OpEnact_c76793675e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "285" ;
    dzdoc:position 298 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_285_condition_0_756d33b8> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:payment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_286> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_1> ;
    dzdoc:eId "art_286" ;
    dzdoc:fullText "تسري أحكام البيع وخصوصا ما يتعلق منها بأهلية الطرفين، وبضمان الاستحقاق، وبضمان العيوب الخفية على الوفاء بمقابل فيما إذا كان ينقل ملكية شيء أعطى في مقابلة الدين ويسري عليه من حيث انه يقضى الدين احكام الوفاء وبالاخص ما تعلق منها بتعيين جهة الدفع وانقضاء التأمينات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_286> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_286_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_286_19750926_OpEnact_68e9e0e346> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "286" ;
    dzdoc:position 299 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_286_condition_0_867b1a2d> ;
    dzdoc:usesTerm dzterm:payment,
        dzterm:payment_by_substitution,
        dzterm:sale .

<https://legal.dz/resource/order/1975-09-26/75-58#art_287> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:تجديد_الالتزام ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_287" ;
    dzdoc:fullText "يتجدد الالتزام : بتغيير الدين إذا اتفق الطرفان على استبدال الالتزام الأصلي بالتزام جديد يختلف عنه في محله أو في مصدره بتغيير المدين إذا اتفق الدائن والغير على أن يكون هذا الأخير مدينا مكان المدين الأصلي على أن تبرأ ذمة المدين الأصلي دون حاجة لرضائه، أو إذا حصل المدين على رضا الدائن بشخص أجنبي قبل أن يكون هو المدين الجديد، بتغيير الدائن إذا اتفق الدائن والمدين والغير على أن يكون هذا الأخير هو الدائن الجديد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_287> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_287_defocc_f1e5b789735a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_287_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_287_19750926_OpEnact_f6a3a98fca> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 287" ;
    dzdoc:position 300 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_290> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_290" ;
    dzdoc:fullText "لا يعد مجرد تقييد الالتزام في حساب جار تجديدا. وإنما يتجدد الالتزام إذا قطع رصيد الحساب، وتم اقراره على انه إذا كان الدين مكفولا بتأمين خاص فإن هذا التأمين يبقى ما لم يتفق على غير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_290> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_290_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_290_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_290_19750926_OpEnact_1ba43949c1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 290" ;
    dzdoc:position 303 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_291> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_291" ;
    dzdoc:fullText "يترتب على التجديد انقضاء الالتزام الأصلي بتوابعه، وانشاء التزام جديد مكانه. ولا تنتقل التأمينات التي تكفل تنفيذ الالتزام الأصلي الا بنص في القانون أو الا إذا تبين من الاتفاق أو من الظروف أن نية المتعاقدين انصرفت إلى غير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_291> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_291_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_291_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_291_19750926_OpEnact_0435d4a041> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 291" ;
    dzdoc:position 304 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_306> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_1> ;
    dzdoc:eId "art_306" ;
    dzdoc:fullText "تسري على الابراء الأحكام الموضوعية التي تسري على كل تبرع. ولا يشترط فيه شكل خاص ولو وقع على التزام يشترط لقيامه توافر شكل فرضه القانون أو اتفق عليه المتعاقدان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_306> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_306_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_306_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_306_19750926_OpEnact_e450736309> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 306" ;
    dzdoc:position 319 ;
    dzdoc:usesTerm dzterm:contracting_parties,
        dzterm:discharge,
        dzterm:law,
        dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_307> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_2> ;
    dzdoc:eId "art_307" ;
    dzdoc:fullText "ينقضي الالتزام إذا اثبت المدين أن الوفاء به أصبح مستحيلا عليه لسبب أجنبي عن إرادته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_307> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_307_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_307_19750926_OpEnact_a87c542ff3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 307" ;
    dzdoc:position 320 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_307_condition_0_6fba762a> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_308> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_308" ;
    dzdoc:fullText "يتقادم الالتزام بانقضاء خمسة عشرة (15) سنة فيما عدا الحالات التي ورد فيها نص خاص في القانون وفيما عدا الاستثناءات الآتية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_308> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_308_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_308_19750926_OpEnact_3377a7fb4d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_308_obligation_0_0a33ed68> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "308" ;
    dzdoc:position 321 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_317> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_317" ;
    dzdoc:fullText "ينقطع التقادم بالمطالبة القضائية ولو رفعت الدعوى إلى محكمة غير مختصة بالتنبيه أو بالحجز، وبالطلب الذي يتقدم به الدائن لقبول حقه في تفليسة المدين أو في توزيع أو بأي عمل يقوم به الدائن أثناء مرافعة لاثبات حقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_317> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_317_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_317_19750926_OpEnact_83d1b89d7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_317_obligation_0_53fe2db4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "317" ;
    dzdoc:position 330 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:limitation_period .

<https://legal.dz/resource/order/1975-09-26/75-58#art_318> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_318" ;
    dzdoc:fullText "ينقطع التقادم إذا أقر المدين بحق الدائن اقرارا صريحا أو ضمنيا ويعتبر اقرارا ضمنيا أن يترك المدين تحت يد الدائن مالا له مرهونا رهنا حيازيا تأمينا لوفاء الدين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_318> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_318_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_318_19750926_OpEnact_0c4dfe6f4d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_318_obligation_0_dcaa3761> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "318" ;
    dzdoc:position 331 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:limitation_period .

<https://legal.dz/resource/order/1975-09-26/75-58#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:family ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "تتكون أسرة الشخص من ذوي قرباه ويعتبر من ذوي القربى كل من يجمعهم أصل واحد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_32> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_32_defocc_dc6dca908806> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_32_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_32_19750926_OpEnact_d3e2076e46> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "32" ;
    dzdoc:position 38 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:authentic_act ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324" ;
    dzdoc:fullText "العقد الرسمي عقد يثبت فيه موظف أو ضابط عمومي أو شخص مكلف بخدمة عامة، ما تم لديه أو ما تلقاه من ذوي الشأن وذلك طبقا للاشكال القانونية وفي حدود سلطته واختصاصه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_324_defocc_4481900ba147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_19750926_OpEnact_298d5fbaf3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324" ;
    dzdoc:position 339 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324_bis_3" ;
    dzdoc:fullText "يتلقى الضابط العمومي، تحت طائلة البطلان العقود الاحتفائية، بحضور شاهدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_3_19750926_OpEnact_c7ccb74b9e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_3_obligation_0_6a20dfb5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324 مكرر 3" ;
    dzdoc:position 342 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324_bis_4" ;
    dzdoc:fullText "يبين الضابط العمومي في العقود الناقلة أو المعلنة عن ملكية عقارية، طبيعة وحالات ومضمون، وحدود العقارات وأسماء المالكين السابقين، وعند الامكان صفة وتاريخ التحويلات المتتالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_4_19750926_OpEnact_47790b7a6d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_4_obligation_0_6f6c26c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324 مكرر 4" ;
    dzdoc:position 343 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_326_bis_2" ;
    dzdoc:fullText "يعتبر العقد غير رسمي بسبب عدم كفاءة أو أهلية الضابط العمومي أو انعدام الشكل، كمحرر عرفي إذا كان موقعا من قبل الاطراف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_bis_2_19750926_OpEnact_9d800f6700> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "326 مكرر 2" ;
    dzdoc:position 350 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_326_bis_2_condition_0_6e11d12d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_327> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_327" ;
    dzdoc:fullText "يعتبر العقد العرفي صادرا ممن كتبه أو وقعه أو وضع عليه بصمة إصبعه ما لم ينكر صراحة ما هو منسوب إليه، أما ورثته أو خلفه فلا يطلب منهم الإنكار ويكفي أن يحلفوا يمينا بأنهم لا يعلمون أن الخط أو الإمضاء أو البصمة هو لمن تلقوا منه هذا الحق. ويعتد بـ التوقيع الإلكتروني وفق الشروط المذكورة في المادة 323 مكرر 1 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_327> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_327_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_327_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_327_19750926_OpEnact_7a8fcf3ba8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "327" ;
    dzdoc:position 351 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_323_bis_1> ;
    dzdoc:usesTerm dzterm:electronic_signature,
        dzterm:private_act .

<https://legal.dz/resource/order/1975-09-26/75-58#art_339> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_3> ;
    dzdoc:eId "art_339" ;
    dzdoc:fullText "لا يرتبط القاضي المدني بالحكم الجنائي الا في الوقائع التي فصل فيها هذا الحكم وكان فصله فيها ضروريا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_339> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_339_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_339_19750926_OpEnact_28dcd229a2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_339_obligation_0_aeee62e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "339" ;
    dzdoc:position 363 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_341> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:الاقرار ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_4> ;
    dzdoc:eId "art_341" ;
    dzdoc:fullText "الاقرار هو اعتراف الخصم أمام القضاء بواقعة قانونية مدعى بها عليه ذلك أثناء السير في الدعوى المتعلقة بها الواقعة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_341> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_341_defocc_554bd17ee507> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_341_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_341_19750926_OpEnact_db06dec092> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "341" ;
    dzdoc:position 365 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_351> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:البيع ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_351" ;
    dzdoc:fullText "البيع عقد يلتزم بمقتضاه البائع أن ينقل للمشتري ملكية شيء أو حقا ماليا آخر في مقابل ثمن نقدي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_351> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_351_defocc_1cbc81241ccb> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_351_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_351_19750926_OpEnact_dc7009f466> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 351" ;
    dzdoc:position 375 ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_361> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_361" ;
    dzdoc:fullText "البائع أن يقوم بما هو لازم لنقل الحق المبيع إلى المشتري وان يمتنع عن كل عمل من شأنه أن يجعل نقل الحق عسيرا أو مستحيلا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_361> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_361_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_361_19750926_OpEnact_0b0c6a9fd9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_361_obligation_0_fff84a89> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 361" ;
    dzdoc:position 385 ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_362> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_362" ;
    dzdoc:fullText "تنتقل الملكية في البيع الجزاف إلى المشتري بنفس الطريق التي تنتقل بها ملكية الشيء المعين. ويعتبر البيع جزافا ولو كان تعيين الثمن موقوفا على تحديد قدر الشيء المبيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_362> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_362_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_362_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_362_19750926_OpEnact_ab61d05eee> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 362" ;
    dzdoc:position 386 ;
    dzdoc:usesTerm dzterm:bulk_sale,
        dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_368> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_368" ;
    dzdoc:fullText "إذا وجب تصدير المبيع إلى المشتري فلا يتم التسليم الا إذا وصل إليه ما لم يوجد اتفاق يخالف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_368> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_368_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_368_19750926_OpEnact_d18d928533> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 368" ;
    dzdoc:position 392 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_368_condition_0_1d3c40a5> ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_371> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_371" ;
    dzdoc:fullText "يضمن البائع عدم التعرض للمشتري في الانتفاع بالمبيع كله أو بعضه سواء كان التعرض من فعله أو من فعل الغير يكون له وقت البيع حق على المبيع يعارض به المشتري. ويكون البائع مطالبا بالضمان ولو كان حق ذلك الغير قد ثبت بعد البيع وقد آل إليه هذا الحق من البائع نفسه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_371> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_371_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_371_19750926_OpEnact_d13c43b10f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_371_obligation_0_1d451401> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 371" ;
    dzdoc:position 395 ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "موطن القاصر والمحجور عليه والمفقود والغائب هو موطن من ينوب عن هؤلاء قانونا. غير أنه يكون للقاصر المرشد موطن خاص بالنسبة للتصرفات التي يعتبره القانون أهلا لمباشرتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_38_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_38_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_38_19750926_OpEnact_7186e808ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 44 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_391> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_391" ;
    dzdoc:fullText "إذا تلف المبلغ في يد البائع وهو ماسك له كان تلفه على المشتري ما لم يكن التلف قد وقع من فعل البائع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_391> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_391_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_391_19750926_OpEnact_6fb6ccadd8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 391" ;
    dzdoc:position 415 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_391_condition_0_46958c04> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_407> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_407" ;
    dzdoc:fullText "يرد المشتري للبائع وقت انعقاد البيع ما قد وفاه هذا الأخير من ديون التركة ويحسب للبائع كل ما يكون دائنا به للتركة ما لم يوجد اتفاق يقضي بخلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_407> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_407_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_407_19750926_OpEnact_ed4a8dd985> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_407_obligation_0_ef096cfb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 407" ;
    dzdoc:position 431 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_412> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_412" ;
    dzdoc:fullText "يصح البيع في الأحوال المشار إليها في المادتين 410 و 411 إذا أجازه من تم البيع لحسابه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_412> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_412_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_412_19750926_OpEnact_b6065b4143> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 412" ;
    dzdoc:position 436 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_410>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_411> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_410>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_411> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_412_condition_0_7e2fcabd> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_414> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_2> ;
    dzdoc:eId "art_414" ;
    dzdoc:fullText "إذا كانت الأشياء المتقايض فيها مختلفة القيم في تقدير المتعاقدين جاز تعويض الفرق بمبلغ من النقود."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_414> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_414_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_414_19750926_OpEnact_94a1ec91de> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 414" ;
    dzdoc:position 438 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_414_condition_0_2f3252f7> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_419> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_419" ;
    dzdoc:fullText "تعتبر حصص الشركاء متساوية القيمة وأنها تخص ملكية المال لا مجرد الانتفاع به، ما لم يوجد اتفاق أو عرف يخالف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_419> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_419_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_419_19750926_OpEnact_f0507e5bde> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 419" ;
    dzdoc:position 443 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_419_condition_0_f28cd850> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_43> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_43" ;
    dzdoc:fullText "كل من بلغ سن التمييز ولم يبلغ سن الرشد وكل من بلغ سن الرشد وكان سفيها أو ذا غفلة ، يكون ناقص الأهلية وفقا لما يقرره القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_43> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_43_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_43_19750926_OpEnact_0017d454a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 43" ;
    dzdoc:position 49 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_43_condition_0_293ab5ec> ;
    dzdoc:usesTerm dzterm:limited_capacity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_444> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_5> ;
    dzdoc:eId "art_444" ;
    dzdoc:fullText "تنتهي مهام المتصرفين عند انحلال الشركة اما شخصية الشركة فتبقى مستمرة إلى أن تنتهي التصفية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_444> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_444_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_444_19750926_OpEnact_0d9a1f0d2c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_444_obligation_0_8100d36a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 444" ;
    dzdoc:position 468 ;
    dzdoc:usesTerm dzterm:company,
        dzterm:legal_personality .

<https://legal.dz/resource/order/1975-09-26/75-58#art_448> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_5> ;
    dzdoc:eId "art_448" ;
    dzdoc:fullText "تطبق في قسمة الشركات القواعد المتعلقة بقسمة المال المشاع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_448> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_448_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_448_19750926_OpEnact_f002754f72> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_448_obligation_0_b1f83641> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 448" ;
    dzdoc:position 472 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "ليس لأحد التنازل عن أهليته ولا لتغيير أحكامها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_45_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_45_19750926_OpEnact_7f0537b83d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_45_obligation_0_3ec0d4ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 51 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_452> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_4> ;
    dzdoc:eId "art_452" ;
    dzdoc:fullText "إذا استحق الشيء فإن أحكام المادة 538 وما بعدها والخاصة بالعارية هي التي تطبق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_452> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_452_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_452_19750926_OpEnact_0d8928dc6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 452" ;
    dzdoc:position 476 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_538> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_538> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_452_condition_0_3e3623f4> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_459> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:صلح ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_5_subsec_1> ;
    dzdoc:eId "art_459" ;
    dzdoc:fullText "الصلح عقد ينهي به الطرفان نزاعا قائما أو يتوقيان به نزاعا محتملا، وذلك بأن يتنازل كل منهما على وجه التبادل عن حقه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_459> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_459_defocc_666156910ad9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_459_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_459_19750926_OpEnact_104b4142c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 459" ;
    dzdoc:position 483 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "ليس لأحد التنازل عن حريته الشخصية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_46_19750926_OpEnact_69f618e5af> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_46_obligation_0_184481a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 52 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_460> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_5_subsec_1> ;
    dzdoc:eId "art_460" ;
    dzdoc:fullText "يشترط فيمن يصالح أن يكون أهلا للتصرف بعوض في الحقوق التي يشملها عقد الصلح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_460> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_460_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_460_19750926_OpEnact_cd8d52a143> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 460" ;
    dzdoc:position 484 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_460_condition_0_0db0e070> ;
    dzdoc:usesTerm dzterm:صلح .

<https://legal.dz/resource/order/1975-09-26/75-58#art_463> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_5_subsec_2> ;
    dzdoc:eId "art_463" ;
    dzdoc:fullText "لل صلح أثر كاشف بالنسبة لما اشتمل عليه من الحقوق ويقتصر هذا الاثر على الحقوق المتنازع فيها دون غيرها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_463_right_0_3e1a4cf2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_463> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_463_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_463_19750926_OpEnact_6449f8cec0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "463" ;
    dzdoc:position 487 ;
    dzdoc:usesTerm dzterm:disputed_rights,
        dzterm:settlement .

<https://legal.dz/resource/order/1975-09-26/75-58#art_467_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_467_bis" ;
    dzdoc:fullText "ينعقد الإيجار كتابة ويكون له تاريخ ثابت وإلا كان باطلا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_467_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_467_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_467_bis_19750926_OpEnact_cc1dea211f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_467_bis_obligation_0_7a1e2ecf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 467 مكرر" ;
    dzdoc:position 492 ;
    dzdoc:usesTerm dzterm:lease .

<https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_469_bis_3" ;
    dzdoc:fullText "إذا انتقلت ملكية العين المؤجرة إراديا أو جبرا يكون الإيجار نافذا في حق من انتقلت إليه الملكية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_3_19750926_OpEnact_1064ed01c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 469 مكرر 3" ;
    dzdoc:position 498 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_3_condition_0_b65a6f5f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "لكل من وقع عليه اعتداء غير مشروع في حق من الحقوق الملازمة لشخصيته أن يطلب وقف هذا الاعتداء والتعويض عما يكون قد لحقه من ضرر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_47_right_0_d5abc9d4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_47_19750926_OpEnact_3d4ea2d286> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 53 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_478> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_478" ;
    dzdoc:fullText "يسري على الالتزام بتسليم العين المؤجرة ما يسري على الالتزام بتسليم المبيع من أحكام، خاصة ما تعلق منها بتاريخ ومكان تسليم الشيء المؤجر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_478> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_478_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_478_19750926_OpEnact_a5cdf8f3cd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_478_obligation_0_7cc05156> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 478" ;
    dzdoc:position 508 ;
    dzdoc:usesTerm dzterm:leased_property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "لكل من نازعه الغير في استعمال اسمه دون مبرر، ومن انتحل الغير اسمه أن يطلب وقف هذا الاعتداء والتعويض، عما يكون قد لحقه من ضرر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_48_right_0_996f8e1d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_48_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_48_19750926_OpEnact_0aeafe078a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 54 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:juridical_persons ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_2> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "الأشخاص الاعتبارية هي : الدولة ، الولاية البلدية ، المؤسسات العمومية ذات الطابع الإداري، الشركات المدنية والتجارية الجمعيات والمؤسسات، الوقف، كل مجموعة من أشخاص أو أموال يمنحها القانون شخصية قانونية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_49> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_49_defocc_7d2417f883b0> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_49_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_49_19750926_OpEnact_6581452db6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 55 ;
    dzdoc:usesTerm dzterm:commune,
        dzterm:state,
        dzterm:wilaya .

<https://legal.dz/resource/order/1975-09-26/75-58#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "يخضع كل سكان القطر الجزائري لقوانين الشرطة والأمن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_5_19750926_OpEnact_49fbbb9662> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_5_obligation_0_dde48902> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 4 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_506> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_506" ;
    dzdoc:fullText "في حالة التنازل عن الإيجار يبقى المستأجر ضامنا للمتنازل له في تنفيذ التزاماته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_506> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_506_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_506_19750926_OpEnact_53807694c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 506" ;
    dzdoc:position 536 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_506_condition_0_aa706fce> ;
    dzdoc:usesTerm dzterm:lease,
        dzterm:lessee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_549> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:مقاول ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1> ;
    dzdoc:eId "art_549" ;
    dzdoc:fullText "المقاولة عقد يتعهد بمقتضاه أحد المتعاقدين أن يصنع شيئا أو أن يؤدي عملا مقابل أجر يتعهد به المتعاقد الآخر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_549> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_549_defocc_97f4cb734676> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_549_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_549_19750926_OpEnact_c921dc3cb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "549" ;
    dzdoc:position 576 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "يكون العقد ملزما للطرفين، متى تبادل المتعاقدان الالتزام بعضهما بعضا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_55_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_55_19750926_OpEnact_825ec7c623> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "55" ;
    dzdoc:position 61 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_55_condition_0_16755952> ;
    dzdoc:usesTerm dzterm:العقد .

<https://legal.dz/resource/order/1975-09-26/75-58#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "يكون العقد ملزما لشخص، أو لعدة أشخاص، إذا تعاقد فيه شخص نحو شخص، أو عدة أشخاص آخرين دون التزام من هؤلاء الآخرين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_56_19750926_OpEnact_da834fb311> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "56" ;
    dzdoc:position 62 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_56_condition_0_35b44ad4> ;
    dzdoc:usesTerm dzterm:العقد .

<https://legal.dz/resource/order/1975-09-26/75-58#art_567> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:termination_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_4> ;
    dzdoc:eId "art_567" ;
    dzdoc:fullText "ينقضي عقد المقاولة باستحالة تنفيذ العمل المعقود عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_567> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_567_defocc_4e93dac26b23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_567_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_567_19750926_OpEnact_ea390366d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 567" ;
    dzdoc:position 594 ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_571> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:agency ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_1> ;
    dzdoc:eId "art_571" ;
    dzdoc:fullText "الوكالة أو الانابة هو عقد بمقتضاه يفوض شخص شخصا آخر للقيام بعمل شيء لحساب الموكل وباسمه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_571> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_571_defocc_8dd5ad30f493> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_571_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_571_19750926_OpEnact_e9fe984888> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "571" ;
    dzdoc:position 608 ;
    dzdoc:usesTerm dzterm:agency .

<https://legal.dz/resource/order/1975-09-26/75-58#art_573> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_1> ;
    dzdoc:eId "art_573" ;
    dzdoc:fullText "إن الوكالة الواردة بألفاظ عامة والتي لا تخصيص فيها حتى لنوع العمل القانوني الحاصل فيه التوكيل لا تخول للوكيل الا القدرة على تنفيذ العقود الادارية. ويعتبر من العقود الادارية الإيجار لمدة لا تزيد عن ثلاث (3) سنوات وأعمال الحفظ والصيانة واستيفاء الحقوق ووفاء الديون وجميع أعمال التصرف كبيع المحصول، وبيع البضاعة أو المنقولات التي يسرع إليها التلف وشراء ما يستلزم الشيء محل الوكالة من أدوات لحفظه ولاستغلاله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_573> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_573_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_573_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_573_19750926_OpEnact_70c2d35120> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "573" ;
    dzdoc:position 610 ;
    dzdoc:usesTerm dzterm:agency .

<https://legal.dz/resource/order/1975-09-26/75-58#art_583> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_2> ;
    dzdoc:eId "art_583" ;
    dzdoc:fullText "يكون الموكل مسؤولا عما أصاب الوكيل من ضرر دون خطأ منه بسبب تنفيذ الوكالة تنفيذا معتادا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_583> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_583_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_583_19750926_OpEnact_5de217a8e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_583_obligation_0_db2e1793> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 583" ;
    dzdoc:position 620 ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_598> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_3> ;
    dzdoc:eId "art_598" ;
    dzdoc:fullText "إذا كانت الوديعة مبلغا من النقود أو أي شيء آخر مما يستهلك وكان المودع لديه مأذونا له في استعماله اعتبر العقد قرضا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_598> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_598_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_598_19750926_OpEnact_1430a462a6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 598" ;
    dzdoc:position 635 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_598_condition_0_62aaa13e> ;
    dzdoc:usesTerm dzterm:loan .

<https://legal.dz/resource/order/1975-09-26/75-58#art_600> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_3> ;
    dzdoc:eId "art_600" ;
    dzdoc:fullText "لا يكون أصحاب الفنادق والنزل ومن يماثلهم من الأشخاص مسؤولين عن السرقات التي ترتكب اما بالتهديد بالسلاح أو كانت ناتجة عن ظروف أخرى طارئة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_600> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_600_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_600_19750926_OpEnact_427b10b163> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 600" ;
    dzdoc:position 637 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_600_condition_0_96aae445> ;
    dzdoc:usesTerm dzterm:hotel_owners .

<https://legal.dz/resource/order/1975-09-26/75-58#art_605> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_605" ;
    dzdoc:fullText "يعين الفريقان الحارس باتفاقهما. فإذا لم يحصل الاتفاق فالقاضي هو الذي يعين الحارس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_605> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_605_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_605_19750926_OpEnact_e27b7434e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "605" ;
    dzdoc:position 642 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_605_condition_0_371e6a8a> ;
    dzdoc:usesTerm dzterm:حارس .

<https://legal.dz/resource/order/1975-09-26/75-58#art_609> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_609" ;
    dzdoc:fullText "للحارس أن يتقاضى أجرا ما لم يكن قد تنازل عنه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_609_right_0_fc529f8a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_609> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_609_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_609_19750926_OpEnact_9d153b8126> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "609" ;
    dzdoc:position 646 ;
    dzdoc:usesTerm dzterm:حارس .

<https://legal.dz/resource/order/1975-09-26/75-58#art_615> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_2> ;
    dzdoc:eId "art_615" ;
    dzdoc:fullText "العقد الذي يقرر المرتب لا يكون صحيحا الا إذا كان مكتوبا وهذا دون إخلال بما يتطلبه القانون من شكل خاص لعقود التبرع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_615> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_615_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_615_19750926_OpEnact_ecc05e8805> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 615" ;
    dzdoc:position 652 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_615_condition_0_2afe5816> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_624> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_3_subsec_1> ;
    dzdoc:eId "art_624" ;
    dzdoc:fullText "تسقط بالتقادم الدعاوى الناشئة عن عقد التأمين بانقضاء ثلاث سنوات من وقت حدوث الواقعة التي تولدت عنها هذه الدعاوى. غير أنه لا تسري تلك المدة : في حالة إخفاء بيانات متعلقة بالخطر المؤمن منه أو تقديم بيانات غير صحيحة أو غير دقيقة عن هذا الخطر الا من اليوم الذي علم فيه المؤمن بذلك، في حالة وقوع الحادث المؤمن منه الا من اليوم الذي علم فيه ذوو الشأن بوقوعه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_624> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_624_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_624_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_624_19750926_OpEnact_da24f05f3f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "624" ;
    dzdoc:position 661 ;
    dzdoc:usesTerm dzterm:insurance_contract,
        dzterm:insurer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_644> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:كفالة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_644" ;
    dzdoc:fullText "المادة 644 : الكفالة عقد يكفل بمقتضاه شخص تنفيذ التزام بأن يتعهد للدائن بأن يفي بهذا الالتزام إذا لم يف به المدين نفسه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_644> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_644_defocc_eac0540fff8e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_644_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_644_19750926_OpEnact_d48cf8c285> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "644" ;
    dzdoc:position 681 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_645> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_645" ;
    dzdoc:fullText "لا تثبت الكفالة الا بالكتابة ، ولو كان من الجائز اثبات الالتزام الأصلي بالبينة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_645> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_645_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_645_19750926_OpEnact_464e61ce94> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "645" ;
    dzdoc:position 682 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_645_condition_0_fcc8f2f6> ;
    dzdoc:usesTerm dzterm:كفالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_648> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_648" ;
    dzdoc:fullText "لا تكون الكفالة صحيحة الا إذا كان الالتزام المكفول صحيحا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_648> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_648_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_648_19750926_OpEnact_b416adae0b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "648" ;
    dzdoc:position 685 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_648_condition_0_713cadab> ;
    dzdoc:usesTerm dzterm:كفالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_651> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_651" ;
    dzdoc:fullText "تعتبر كفالة الدين التجاري عملا مدنيا ولو كان الكفيل تاجرا. غير أن الكفالة الناشئة عن ضمان الأوراق التجارية ضمانا احتياطيا، أو عن تظهير هذه الأوراق، تعتبر دائما عملا تجاريا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_651> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_651_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_651_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_651_19750926_OpEnact_d8df000302> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "651" ;
    dzdoc:position 688 ;
    dzdoc:usesTerm dzterm:كفالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_653> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_653" ;
    dzdoc:fullText "إذا لم يكن هناك اتفاق خاص ، فإن الكفالة تشمل ملحقات الدين، ومصروفات المطالبة الأولى وما يستجد من المصروفات بعد إخطار الكفيل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_653> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_653_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_653_19750926_OpEnact_3e36805b1a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "653" ;
    dzdoc:position 690 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_653_condition_0_d7ef8179> ;
    dzdoc:usesTerm dzterm:كفالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "يعتبر التعاقد ما بين الغائبين قد تم في المكان وفي الزمان اللذين يعلم فيهما الموجب بالقبول، ما لم يوجد اتفاق أو نص قانوني يقضي بغير ذلك. ويفترض أن الموجب قد علم بالقبول في المكان، وفي الزمان اللذين وصل إليه فيهما القبول."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_67_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_67_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_67_19750926_OpEnact_509b6da742> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 73 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_676> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_676" ;
    dzdoc:fullText "لمالك الشيء الحق في كل ثماره ومنتجاته وملحقاته ما لم يوجد نص أو اتفاق يخالف ذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_676_right_0_f4c16ea1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_676> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_676_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_676_19750926_OpEnact_b34cc12c19> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 676" ;
    dzdoc:position 713 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_680> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_680" ;
    dzdoc:fullText "يتم الاستيلاء بصفة فردية أو جماعية ويكون كتابيا. يوقع الأمر من طرف الوالي أو كل سلطة مؤهلة قانونا ويوضح فيه إذا كان الاستيلاء بقصد الحصول على الأموال أو الخدمات، ويبين طبيعة وصفة و/أو مدة الخدمة وعند الاقتضاء مبلغ وطرق دفع التعويض و/أو الأجر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_680> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_680_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_680_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_680_19750926_OpEnact_611a0b585a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 680" ;
    dzdoc:position 717 ;
    dzdoc:usesTerm dzterm:wali .

<https://legal.dz/resource/order/1975-09-26/75-58#art_682> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_682" ;
    dzdoc:fullText "كل شيء غير خارج عن التعامل بطبيعته أو بحكم القانون يصلح أن يكون محلا للحقوق المالية. والأشياء التي تخرج عن التعامل بطبيعتها هي التي لا يستطيع أحد أن يستأثر بحيازتها وأما الخارجة بحكم القانون فهي التي يجيز القانون أن تكون محلا للحقوق المالية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_682> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_682_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_682_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_682_19750926_OpEnact_d197866ab0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "682" ;
    dzdoc:position 722 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_686> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:fungible_things ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_686" ;
    dzdoc:fullText "الأشياء المثلية هي التي يقوم بعضها مقام بعض عند الوفاء والتي تقدر عادة في التعامل بين الناس بالعدد، أو المقياس أو الكيل، أو الوزن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_686> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_686_defocc_7fbe3aca3157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_686_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_686_19750926_OpEnact_1e0bb1a196> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "686" ;
    dzdoc:position 726 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_702> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_702" ;
    dzdoc:fullText "إن ارتفاق المرور في حالة العقار المحصور، ولو كان غير متواصل، تترتب عليه دعوى الحيازة حتى ولو يتم لصاحب العقار المحصور التقادم من حيث القاعدة وكيفية الارتفاق."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_702_right_0_4e8731a1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_702> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_702_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_702_19750926_OpEnact_4193f6d77d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 702" ;
    dzdoc:position 742 ;
    dzdoc:usesTerm dzterm:servitude_of_way .

<https://legal.dz/resource/order/1975-09-26/75-58#art_707> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:common_wall ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_707" ;
    dzdoc:fullText "يعد الحائط الذي يكون في وقت إنشائه فاصلا بين بنائين مشتركا حتى مفرقهما ما لم يقم الدليل على عكس ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_707> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_707_defocc_489be22cd181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_707_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_707_19750926_OpEnact_2e70a3c25b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 707" ;
    dzdoc:position 747 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_718> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_718" ;
    dzdoc:fullText "لكل شريك في الشيوع الحق في أن يتخذ من الوسائل ما يلزم لحفظ الشيء ، ولو كان ذلك بغير موافقة باقي الشركاء."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_718_right_0_40d4aceb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_718> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_718_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_718_19750926_OpEnact_1c7d52f47e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 718" ;
    dzdoc:position 758 ;
    dzdoc:usesTerm dzterm:partner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "إذا وعد شخص بإبرام عقد ثم نكل وقاضاه المتعاقد الآخر طالبا تنفيذ الوعد، وكانت الشروط اللازمة لتمام العقد وخاصة ما يتعلق منها بالشكل متوافرة ، قام الحكم مقام العقد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_19750926_OpEnact_21456e1985> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "72" ;
    dzdoc:position 78 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_72_condition_0_7e617335> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_725> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_725" ;
    dzdoc:fullText "يكون الخبير الحصص على أساس أصغر نصيب حتى ولو كانت القسمة جزئية. وإذا تعذر أن يأخذ أحد الشركاء كامل نصيبه عينا عوض بمعدل عما نقص من نصيبه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_725> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_725_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_725_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_725_19750926_OpEnact_1d5eb42cfe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 725" ;
    dzdoc:position 765 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_728> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_728" ;
    dzdoc:fullText "إذا تعذرت القسمة عينا ، أو كان من شأنها إحداث نقص كبير في قيمة المال المراد قسمته ، بيع هذا المال بالمزاد بالطريقة المبينة في قانون الاجراءات المدنية ، وتقتصر المزايدة على الشركاء وحدهم إذا طلبوا هذا بالاجماع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_728> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_728_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_728_19750926_OpEnact_01f4dd3bda> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 728" ;
    dzdoc:position 768 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_728_condition_0_ff2f9881> ;
    dzdoc:usesTerm dzterm:civil_procedure_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_743> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:joint_ownership ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_743" ;
    dzdoc:fullText "الملكية المشتركة هي الحالة القانونية التي يكون عليها العقار المبني أو والتي تكون ملكيتها مقسمة حصصا بين عدة أشخاص تشتمل كل واحدة منها على جزء خاص ونصيب في الأجزاء المشتركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_743> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_743_defocc_f7becfab9775> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_743_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_743_19750926_OpEnact_71f73ef449> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 743" ;
    dzdoc:position 783 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "إذا لم يعلن المتعاقد وقت إبرام العقد أنه يتعاقد بصفته نائبا ، فإن أثر العقد لا يضاف إلى الأصيل دائنا أو مدينا، إلا إذا كان من المفروض حتما أن من تعاقد معه النائب يعلم بوجود النيابة أو كان يستوي عنده أن يتعامل مع الأصيل أو النائب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_75_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_75_19750926_OpEnact_d8df9337da> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "75" ;
    dzdoc:position 82 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_75_condition_0_60b927bc> ;
    dzdoc:usesTerm dzterm:agent,
        dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "إذا كان النائب ومن تعاقد معه يجهلان معا وقت العقد انقضاء النيابة ، فإن أثر العقد الذي يبرمه، حقا كان أو التزاما، يضاف إلى الأصيل أو خلفائه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_76_19750926_OpEnact_fedee23848> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "76" ;
    dzdoc:position 83 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_76_condition_0_b532ccb5> ;
    dzdoc:usesTerm dzterm:principal .

<https://legal.dz/resource/order/1975-09-26/75-58#art_773> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:state_property ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_773" ;
    dzdoc:fullText "تعتبر ملكا من أملاك الدولة جميع الاموال الشاغرة التي ليس لها مالك، وكذلك أموال الاشخاص الذين يموتون عن غير وارث أو الذين تهمل تركتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_773> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_773_defocc_a1f20797129d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_773_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_773_19750926_OpEnact_b1413d2e67> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "773" ;
    dzdoc:position 824 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:legal_capacity ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "كل شخص أهل للتعاقد ما لم يطرأ على أهليته عارض يجعله ناقص الأهلية أو فاقدها بحكم القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_78> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_78_defocc_7db55b5b5eed> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_78_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_78_19750926_OpEnact_e07859acf3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "78" ;
    dzdoc:position 85 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_1> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "تخضع الأدلة المعدة مقدما للنصوص المعمول بها في الوقت الذي أعد فيه الدليل، أو في الوقت الذي كان ينبغي فيه إعداده ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_8_19750926_OpEnact_b14253c70b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_8_obligation_0_77652856> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:evidence .

<https://legal.dz/resource/order/1975-09-26/75-58#art_803> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:judgment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_803" ;
    dzdoc:fullText "يعتبر الحكم الذي يصدر نهائيا بثبوت الشفعة سندا لملكية الشفيع وذلك دون إخلال بالقواعد المتعلقة بالاشهار العقاري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_803> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_803_defocc_a55a78c0618e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_803_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_803_19750926_OpEnact_3675f9cceb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "803" ;
    dzdoc:position 854 ;
    dzdoc:usesTerm dzterm:real_estate_publicity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_806> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_806" ;
    dzdoc:fullText "لا تكون حجة على الشفيع، الرهون والاختصاصات المأخوذة ضد المشتري وكذلك كل بيع صدر منه وكل حق عيني رتبه المشتري أو ترتب عليه إذا كان ذلك قد تم بعد تاريخ شهر الاعلان بالرغبة في الشفعة على أنه يبقى للدائنين المسجلة ديونهم مالهم من حقوق الأفضلية فيما آل للمشتري من ثمن العقار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_806> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_806_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_806_19750926_OpEnact_817f58bfc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "806" ;
    dzdoc:position 857 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_806_condition_0_6886ed7c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_807> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_807" ;
    dzdoc:fullText "لا يمارس حق الشفعة في الأحوال الآتية : إذا تنازل الشفيع عن حقه في الشفعة ولو قبل البيع، إذا مرت سنة من يوم تسجيل عقد البيع، في الأحوال التي نص عليها القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_807_right_0_dcb1c4c0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_807> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_807_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_807_19750926_OpEnact_055d973002> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "807" ;
    dzdoc:position 858 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_822> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_822" ;
    dzdoc:fullText "إذا تنازع أشخاص متعددون في حيازة حق واحد اعتبر بصفة مؤقتة أن حائزه هو من كانت له الحيازة المادية الا إذا كان قد اكتسب هذه الحيازة عن طريق التدليس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_822> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_822_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_822_19750926_OpEnact_35e77c4d24> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "822" ;
    dzdoc:position 873 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_822_condition_0_7066533d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_829> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_829" ;
    dzdoc:fullText "لا تكسب بالتقادم في جميع الأحوال الحقوق الميراثية الا إذا دامت الحيازة ثلاثا وثلاثين (33) سنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_829> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_829_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_829_19750926_OpEnact_418dcf7bb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 829" ;
    dzdoc:position 880 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_829_condition_0_e918b433> ;
    dzdoc:usesTerm dzterm:inheritance_rights .

<https://legal.dz/resource/order/1975-09-26/75-58#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "يكون العقد قابلا للابطال لغلط في القانون إذا توفرت فيه شروط الغلط في الواقع طبقا للمادتين 81 و 82 ما لم يقض القانون بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_83_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_83_19750926_OpEnact_be7785c7cb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 83" ;
    dzdoc:position 90 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_81>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_82> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_81>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_82> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_83_condition_0_6b2edcbb> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_830> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_830" ;
    dzdoc:fullText "إذا ثبت قيام الحيازة في وقت سابق معين وكانت قائمة في الحال فإن ذلك يكون قرينة على قيامها في المدة ما بين الزمنين ما لم يقم دليل على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_830> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_830_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_830_19750926_OpEnact_963262b603> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 830" ;
    dzdoc:position 881 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_830_condition_0_fb074286> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_833> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_833" ;
    dzdoc:fullText "يوقف التقادم المكسب أيا كانت مدته إذا وجد سبب لوقفه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_833> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_833_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_833_19750926_OpEnact_c5024389db> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 833" ;
    dzdoc:position 884 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_833_condition_0_921d8f52> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_845> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_845" ;
    dzdoc:fullText "يراعى في حقوق المنتفع والتزاماته السند الذي أنشأ حق الانتفاع وكذلك الأحكام المقررة في المواد التالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_845> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_845_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_845_19750926_OpEnact_a18e6d26e3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_845_obligation_0_b2243fea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 845" ;
    dzdoc:position 896 ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_868> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_868" ;
    dzdoc:fullText "ينشأ حق الارتفاق عن الموقع الطبيعي للأمكنة، أو يكسب بعقد شرعي أو بالميراث الا أنه لا تكسب بالتقادم الا الارتفاقات الظاهرة بما فيها حق المرور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_868> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_868_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_868_19750926_OpEnact_3bbc3c5577> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "868" ;
    dzdoc:position 919 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_868_condition_0_9c714017> ;
    dzdoc:usesTerm dzterm:حق_الارتفاق .

<https://legal.dz/resource/order/1975-09-26/75-58#art_871> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_871" ;
    dzdoc:fullText "تخضع حقوق الارتفاق للقواعد المقررة في سند تأسيسها ولما جرى به عرف الجهة، وللأحكام التالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_871> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_871_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_871_19750926_OpEnact_fb3c2189d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_871_obligation_0_b598bb16> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "871" ;
    dzdoc:position 922 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_885> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_885" ;
    dzdoc:fullText "يبقى صحيحا لمصلحة الدائن المرتهن الرهن الصادر من المالك الذي تقرر إبطال سند ملكيته، أو فسخه، أو إلغاؤه أو زواله لأي سبب آخر، إذا ثبت أن الدائن كان حسن النية وقت إبرام عقد الرهن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_885> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_885_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_885_19750926_OpEnact_9b8e4be1c6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 885" ;
    dzdoc:position 936 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_885_condition_0_d66b2502> ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:mortgagee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_895> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_895" ;
    dzdoc:fullText "أن للراهن الحق في إدارة العقار المرهون وفي قبض ثماره إلى وقت التحاقها بالعقار ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_895_right_0_6a73f38c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_895> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_895_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_895_19750926_OpEnact_fc34dd3140> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 895" ;
    dzdoc:position 946 ;
    dzdoc:usesTerm dzterm:mortgaged_property,
        dzterm:mortgagor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "ينتهي عقد التسيير بانقضاء المدة التي أبرم من أجلها ، ويمكن فسخه لعدم احترام الالتزامات المتبادلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_9_19750926_OpEnact_da3f5f99de> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_9_obligation_0_17890f7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 9" ;
    dzdoc:position 8 ;
    dzdoc:usesTerm dzterm:management_contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_907> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_907" ;
    dzdoc:fullText "يستوفي الدائنون المرتهنون حقوقهم تجاه الدائنين العاديين من ثمن العقار المرهون أو من المال الذي حل محل هذا العقار، بحسب مرتبة كل منهم ولو كانوا أجروا القيد في يوم واحد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_907_right_0_6dc9268b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_907> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_907_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_907_19750926_OpEnact_839f860067> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 907" ;
    dzdoc:position 958 ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_908> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_908" ;
    dzdoc:fullText "تحسب مرتبة الرهن من وقت تقييده، ولو كان الدين المضمون بالرهن معلقا على شرط أو كان دينا مستقبلا أو احتماليا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_908> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_908_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_908_19750926_OpEnact_c0ce975244> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 908" ;
    dzdoc:position 959 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_908_condition_0_b306671a> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "إذا كان محل الالتزام مستحيلا في ذاته أو مخالفا للنظام العام أو الآداب العامة كان باطلا بطلانا مطلقا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_93_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_93_19750926_OpEnact_cd22a7dcab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 93" ;
    dzdoc:position 100 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_93_condition_0_8be07fdf> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_932> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_932" ;
    dzdoc:fullText "الحائز مسؤول شخصيا تجاه الدائنين عما يصيب العقار من تلف بخطئه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_932> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_932_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_932_19750926_OpEnact_e68b0e3b10> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_932_obligation_0_2adeacab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 932" ;
    dzdoc:position 983 ;
    dzdoc:usesTerm dzterm:creditors,
        dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_948> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:mortgage_pledge ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_1> ;
    dzdoc:eId "art_948" ;
    dzdoc:fullText "الرهن الحيازي عقد يلتزم به شخص ضمانا لدين عليه أو على غيره، أن يسلم إلى الدائن أو إلى أجنبي يعينه المتعاقدان شيئا يرتب عليه للدائن حقا عينيا يخوله حبس الشيء إلى أن يستوفي الدين، وأن يتقدم الدائنين العاديين والدائنين التالين له في المرتبة في أن يتقاضى حقه من ثمن هذا الشيء في أي يد يكون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_948> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_948_defocc_dbd1120c0f4f> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_948_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_948_19750926_OpEnact_577a7e9bb5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 948" ;
    dzdoc:position 999 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_964> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_3> ;
    dzdoc:eId "art_964" ;
    dzdoc:fullText "ينقضي حق الرهن الحيازي بانقضاء الدين المضمون ويعود معه إذا زال السبب الذي انقضي به الدین ، دون الاخلال بالحقوق التي يكون الغير حسن النية قد كسبها قانونا في الفترة ما بين انقضاء الحق وعودته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_964> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_964_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_964_19750926_OpEnact_528b16d89f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 964" ;
    dzdoc:position 1015 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_964_condition_0_de09347d> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_966> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_4> ;
    dzdoc:eId "art_966" ;
    dzdoc:fullText "يشترط لنفاذ الرهن العقاري في حق الغير، إلى جانب تسليم الملك للدائن، أن يقيد عقد الرهن العقاري ، وتسري على هذا القيد الأحكام الخاصة بقيد الرهن الرسمي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_966> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_966_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_966_19750926_OpEnact_9f158cf413> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 966" ;
    dzdoc:position 1017 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_966_condition_0_8dc5b653> ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:official_mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_969> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_969" ;
    dzdoc:fullText "يشترط لنفاذ رهن المنقول في حق الغير إلى جانب انتقال الحيازة إلى الدائن ، أن يدون العقد في ورقة ثابتة التاريخ يبين فيها المبلغ المضمون بالرهن والعين المرهونة بيانا كافيا ، ويحدد هذا التاريخ الثابت مرتبة الدائن المرتهن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_969> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_969_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_969_19750926_OpEnact_7fdaa93bde> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 969" ;
    dzdoc:position 1020 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_969_condition_0_ee42b012> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:pledge_creditor,
        dzterm:pledge_movable .

<https://legal.dz/resource/order/1975-09-26/75-58#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "إذا التزم المتعاقد لسبب غير مشروع أو لسبب مخالف للنظام العام أو للآداب كان العقد باطلا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_97_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_97_19750926_OpEnact_c5b5712a0e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 97" ;
    dzdoc:position 104 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_97_condition_0_43fcde6d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_984> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_984" ;
    dzdoc:fullText "ترد حقوق الامتياز العامة على جميع أموال المدين من منقول وعقار. أما حقوق الامتياز الخاصة فتكون مقصورة على منقول أو عقار معين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_984> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_984_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_984_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_984_19750926_OpEnact_d4cbf187a2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "984" ;
    dzdoc:position 1035 ;
    dzdoc:usesTerm dzterm:general_privilege,
        dzterm:special_privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2_bis> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "إذا جعل القانون لأحد المتعاقدين حقا في إبطال العقد فليس للمتعاقد الآخر أن يتمسك بهذا الحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_99_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_99_19750926_OpEnact_0f28b62fa7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "99" ;
    dzdoc:position 106 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_99_condition_0_f3c76b93> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_991> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_991" ;
    dzdoc:fullText "المبالغ المستحقة للخزينة العامة من ضرائب ورسوم وحقوق أخرى من أي نوع كان، لها امتياز ضمن الشروط المقررة في القوانين والمراسيم الواردة في هذا الشأن . وتستوفى هذه المبالغ من ثمن الأموال المثقلة بهذا الامتياز في أي يد كانت وقبل أي حق آخر ، ولو كان ممتازا أو مضمونا برهن رسمي، ما عدا المصاريف القضائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_991_right_0_6fc1e336> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_991> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_991_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_991_19750926_OpEnact_cbed5ba7fd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "991" ;
    dzdoc:position 1042 ;
    dzdoc:usesTerm dzterm:judicial_expenses .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_bis_subsec_3> ;
    dzdoc:eId "book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_5" ;
    dzdoc:fullText "يخضع كل سكان القطر الجزائري لقوانين الشرطة والأمن ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_5_19750926_OpEnact_24e45055d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_5_obligation_0_dde48902> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "5" ;
    dzdoc:position 602 .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_bis_subsec_3> ;
    dzdoc:eId "book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_8" ;
    dzdoc:fullText "تخضع الأدلة المعدة مقدما للنصوص المعمول بها في الوقت الذي أعد فيه الدليل، أو في الوقت الذي كان ينبغي فيه إعداده ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_8_19750926_OpEnact_64a7554e6a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_3_art_8_obligation_0_77652856> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 605 ;
    dzdoc:usesTerm dzterm:evidence .

<https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
