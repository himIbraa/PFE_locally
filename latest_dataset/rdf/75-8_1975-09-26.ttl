    dzdoc:evidenceText "إذا كانت عبارة العقد واضحة فلا يجوز الانحراف عنها من طريق تأويلها للتعرف على إرادة المتعاقدين. أما إذا كان هناك محل لتأويل العقد ، فيجب البحث عن النية المشتركة للمتعاقدين دون الوقوف عند المعنى الحرفي للالفاظ ، مع الاستهداء في ذلك بطبيعة التعامل، وبما ينبغي أن يتوافر من أمانة وثقة بين المتعاقدين، وفقا للعرف الجاري في المعاملات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_111_19750926_OpEnact_ad1eaed392> ;
