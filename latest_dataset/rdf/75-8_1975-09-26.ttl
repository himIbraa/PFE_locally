<https://legal.dz/resource/order/1975-09-26/75-58#version_art_832> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسري قواعد التقادم المسقط على التقادم المكسب فيما يتعلق بحساب المدة ووقف التقادم وانقطاعه والتمسك به أمام القضاء والتنازل عنه والاتفاق على تعديل المدة وذلك بالقدر الذي لا تتعارض فيه هذه القواعد مع طبيعة التقادم المكسب ومع مراعاة الأحكام التالية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
