    dzdoc:eId "book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9" ;
    dzdoc:fullText "ينتهي عقد التسيير بانقضاء المدة التي أبرم من أجلها ، ويمكن فسخه لعدم احترام الالتزامات المتبادلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9_19750926_OpEnact_10940fa042> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9_obligation_0_17890f7f> ;
