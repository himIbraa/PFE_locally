<https://legal.dz/resource/order/1975-09-26/75-58#art_659> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_659" ;
    dzdoc:fullText "تجوز كفالة الكفيل ، وفي هذه الحالة لا يحوز المستندات اللازمة لاستعمال حقه في الرجوع. فإذا كان الدين مضمونا بمنقول مرهون أو محبوس وجب على الدائن أن يتخلى عنه للكفيل . أما إذا كان الدين مضمونا بتأمين عقاري ، فإن الدائن يلتزم بالاجراءات اللازمة لنقل هذا التأمين ، و يتحمل الكفيل مصروفات هذا النقل على أن يرجع بها على المدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_659> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_659_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_659_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_659_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_659_19750926_OpEnact_468544cc99> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_659_obligation_0_80cd77b2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_659_obligation_1_859248df>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_659_obligation_2_5718e920> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 659" ;
    dzdoc:position 696 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_659_condition_0_474c0dfa>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_659_condition_1_87f1d422> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_818> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:preferential_possession ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_818" ;
    dzdoc:fullText "إذا لم يكن من فقد الحيازة قد مضت على حيازته سنة على فقدها فلا يجوز له أن يسترد الحيازة الا ممن لا يستند إلى حيازة أحق بالتفضيل والحيازة الأحق بالتفضيل هي الحيازة القائمة على سند قانوني . فإذا لم يكن لدى أي من الحائزين سند أو تعادلت سنداتهما كانت الحيازة الأحق هي الأسبق في التاريخ. للحائز في جميع الأحوال إذا فقد حيازته بالقوة أن يستردها خلال السنة التالية لفقدها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_818_permission_0_db577096> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_818_right_0_ec1af1d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_818> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_818_defocc_a38e04bfb290> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_818_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_818_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_818_19750926_OpEnact_ab63bf3849> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "818" ;
    dzdoc:position 869 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_818_condition_0_9d3d2bd6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_818_condition_1_41e3b64c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:substantial_error ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "يكون الغلط جوهريا إذا بلغ حدا من الجسامة بحيث يمتنع معه المتعاقد عن إبرام العقد لو لم يقع في هذا الغلط . ويعتبر الغلط جوهريا على الأخص إذا وقع في صفة للشيء يراها المتعاقدان جوهرية، أو يجب اعتبارها كذلك نظرا لشروط العقد ولحسن النية . و إذا وقع في ذات المتعاقد أو في صفة من صفاته، وكانت تلك الذات أو هذه الصفة السبب الرئيسي في التعاقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_82> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_82_defocc_b92ab1f3d670> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_82_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_82_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_82_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_82_19750926_OpEnact_8776c50c6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 82" ;
    dzdoc:position 89 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_82_condition_0_1f35fd24>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_82_condition_1_ea514687> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_841> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_841" ;
    dzdoc:fullText "يجوز للقاضي بناء على طلب المالك أن يختار ما يراه مناسبا للوفاء بالمصاريف المنصوص عليها في المادتين 839 و 840 وله أيضا أن يقدر بأن يكون الوفاء على أقساط دورية بشرط تقديم الضمانات اللازمة ، وللمالك أن يتحلل من هذا الالتزام إذا سبق مبلغا يساوي قيمة هذه الاقساط ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_841_permission_0_72addcd6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_841_right_0_7531d07d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_841_right_1_811795c3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_841> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_841_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_841_19750926_OpEnact_2a38eb0249> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "841" ;
    dzdoc:position 892 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_839>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_840> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_839>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_840> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_841_condition_0_3ec0a488> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_877> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_877" ;
    dzdoc:fullText "إذا جزئ العقار المرتفق به بقي حق الارتفاق واقعا على كل جزء منه . غير أنه إذا كان حق الارتفاق لا يستعمل في الواقع على بعض هذه الأجزاء وكان لا يمكن أن يستعمل عليها ، فلمالك كل جزء منها أن يطلب زوال هذا الارتفاق عن الجزء الذي يملكه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_877_permission_0_fe5e2570> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_877_right_0_bb94b29b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_877> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_877_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_877_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_877_19750926_OpEnact_afda8f99c6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_877_obligation_0_2f3422e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "877" ;
    dzdoc:position 928 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_877_condition_0_5116203b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_877_condition_1_57d4d8e5> ;
    dzdoc:usesTerm dzterm:easement,
        dzterm:property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_902> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_902" ;
    dzdoc:fullText "يمكن للدائن بعد التنبيه على المدين بالوفاء، أن ينفذ بحقه على العقار المرهون ويطلب بيعه في الآجال ووفقا للاوضاع المقررة في قانون الاجراءات المدنية . وإذا كان الراهن شخصا آخر غير المدين جاز له تفادي أي إجراء موجه إليه أن هو تخلى عن العقار المرهون وفقا للأوضاع والأحكام التي يتبعها الحائز في تخلية العقار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_902_permission_0_4907e76c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_902_right_0_a73cc055>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_902_right_1_5e893f14> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_902> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_902_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_902_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_902_19750926_OpEnact_cb2fbb639c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "902" ;
    dzdoc:position 953 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_902_condition_0_f6e758e1> ;
    dzdoc:usesTerm dzterm:civil_procedure_law,
        dzterm:creditor,
        dzterm:debtor,
        dzterm:mortgaged_property,
        dzterm:mortgagor,
        dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "إذا لم يكن محل الالتزام معينا بذاته ، وجب أن يكون معينا بنوعه، ومقداره وإلا كان العقد باطلا. ويكفي أن يكون المحل معينا بنوعه فقط إذا تضمن العقد ما يستطاع به تعيين مقداره . و إذا لم يتفق المتعاقدان على درجة الشيء، من حيث جودته ولم يمكن تبين ذلك من العرف أو من أي ظرف آخر ، التزم المدين بتسليم شيء من صنف متوسط ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_94_permission_0_cbeb2766> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_94_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_94_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_94_19750926_OpEnact_9c36730ac8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_94_obligation_0_17f61ef6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_94_obligation_1_f143dc82> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 94" ;
    dzdoc:position 101 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_94_condition_0_7ceb0e63>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_94_condition_1_86c2284b>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_94_condition_2_1cc877d3> .

