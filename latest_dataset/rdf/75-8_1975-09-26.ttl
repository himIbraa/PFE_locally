<https://legal.dz/resource/order/1975-09-26/75-58#version_art_233> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا صدر حكم على أحد المدينين المتضامنين فلا تكون لهذا الحكم سلطة على الآخرين. أما إذا صدر حكم لصالح أحدهم فيستفيد منه الآخرون، الا إذا كان هذا الحكم مبنيا على فعل خاص بالمدين المعني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_233_19750926_OpEnact_05963c97db> ;
