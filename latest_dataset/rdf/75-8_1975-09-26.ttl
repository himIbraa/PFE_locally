    dznorm:conditionText "إذا تعدد الكفلاء لدين واحد، وبعقد واحد، وكانوا غير متضامنين فيما بينهم"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_664> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_664_condition_1_8c26f5db> a dznorm:Condition ;
    dznorm:conditionText "أما إذا كان الكفلاء قد التزموا بعقود متوالية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_664> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_664_condition_2_0f2b7abc> a dznorm:Condition ;
