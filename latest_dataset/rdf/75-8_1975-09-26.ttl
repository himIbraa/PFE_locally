    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_216> ;
    dzdoc:position 0 ;
    dzdoc:text "يكون الالتزام اختياريا إذا لم يشمل محله الا شيئا واحدا، ولكن تبرأ ذمة المدين إذا أدى بدلا منه شيئا آخر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_216_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_216> ;
    dzdoc:position 1 ;
    dzdoc:text "والشيء الذي يشمله محل الالتزام هو وحده محل الالتزام وهو الذي يعين طبيعته، لا البديل الذي تبرأ ذمة المدين بأدائه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_216_right_0_545d3097> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_216> ;
    dznorm:position 0 ;
    dznorm:provisionText "تبرأ ذمة المدين إذا أدى بدلا منه شيئا آخر"@ar ;
    dznorm:sourceArticle "art_216" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_217_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_217> ;
    dzdoc:position 0 ;
    dzdoc:text "التضامن بين الدائنين أو بين المدينين لا يفترض، وانما يكون بناء على اتفاق أو نص في القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_218_condition_0_e1d9e80d> a dznorm:Condition ;
    dznorm:conditionText "إذا كان التضامن بين الدائنين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_218> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_218_condition_1_3e1b6bd1> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الدين غير قابل للانقسام"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_218> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_218_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_218> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان التضامن بين الدائنين جاز للمدين الوفاء بالدين لأي منهم ما لم يمانع أحدهم في ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_218_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_218> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أن التضامن لا يجوز دون انقسام الدين بين ورثة أحد الدائنين المتضامنين، الا إذا كان الدين غير قابل للانقسام."@ar .

