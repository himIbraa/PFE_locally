<https://legal.dz/resource/order/1975-09-26/75-58#art_783_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_783> ;
    dzdoc:position 0 ;
    dzdoc:text "يكون ملكا خالصا لصاحب الأرض ما يحدثه فيها من غراس أو بناء أو منشآت أخرى يقيمها بمواد مملوكة لغيره إذا لم يكن ممكنا نزع هذه المواد دون أن يلحق المنشآت ضرر جسيم أو كان ممكنا نزعها ولكن لم ترفع الدعوى بالاسترداد خلال سنة من اليوم الذي علم فيه مالك المواد أنها اندمجت في هذه المنشآت."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_783_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_783> ;
    dzdoc:position 1 ;
    dzdoc:text "إذا تملك صاحب الأرض المواد كان عليه أن يدفع قيمتها مع التعويض عن الضرر الحاصل إذا اقتضى الحال ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_783_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_783> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة استرداد المواد من صاحبها فإن نزعها يكون على نفقة مالك الأرض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_784_condition_0_dea3526e> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_784_condition_0_dea3526e_role_369151d1d9> ;
    dznorm:conditionText "إذا أقام شخص المنشآت بمواد من عنده على أرض يعلم أنها ملك لغيره دون رضاء صاحبها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_784_condition_0_dea3526e_role_369151d1d9> a dznorm:Role ;
    rdfs:label "أرض يعلم أنها ملك"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا أقام شخص المنشآت بمواد من عنده على أرض يعلم أنها ملك لغيره دون رضاء صاحبها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_784> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_784_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أقام شخص المنشآت بمواد من عنده على أرض يعلم أنها ملك لغيره دون رضاء صاحبها فلصاحب الأرض أن يطلب في أجل سنة من اليوم الذي علم فيه بإقامة المنشآت إزالة المنشآت على نفقة من أقامها مع التعويض عن الضرر إذا اقتضى الحال ذلك، أو أن يطلب استبقاءها مقابل دفع قيمتها أو قيمتها في حالة الهدم أو دفع مبلغ يساوي ما زاد في ثمن الأرض بسبب وجود المنشآت بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_784_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجوز لمن أقام المنشآت أن يطلب نزعها أن كان ذلك لا يلحق بالأرض ضررا الا إذا اختار صاحب الأرض استبقاءها طبقا لأحكام الفقرة السابقة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_785_condition_0_6481d8de> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/order/1975-09-26/75-58#art_785_condition_0_6481d8de_ref_57a25f234efb> ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_784> ;
    dznorm:conditionText "إذا كان من أقام المنشآت المشار إليها في المادة 784 يعتقد بحسن نية أن له الحق في إقامتها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_785_condition_0_6481d8de_ref_57a25f234efb> a dzdoc:Reference ;
