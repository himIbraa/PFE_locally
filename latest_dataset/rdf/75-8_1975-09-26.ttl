<https://legal.dz/resource/order/1975-09-26/75-58#version_art_50> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمتع الشخص الاعتباري بجميع الحقوق الا ما كان منها ملازما لصفة الانسان ، وذلك في الحدود التي يقررها القانون . يكون لها خصوصا : ذمة مالية، أهلية في الحدود التي يعينها عقد انشائها أو التي يقررها القانون ، موطن وهو المكان الذي يوجد فيه مركز إدارتها، الشركات التي يكون مركزها الرئيسي في الخارج ولها نشاط في الجزائر يعتبر مركزها، في نظر القانون الداخلي في الجزائر، نائب يعبر عن إرادتها، حق التقاضي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_50_19750926_OpEnact_3612afe94f> ;
    dzdoc:replacementText "يتمتع الشخص الاعتباري بجميع الحقوق الا ما كان منها ملازما لصفة الانسان ، وذلك في الحدود التي يقررها القانون . يكون لها خصوصا : ذمة مالية، أهلية في الحدود التي يعينها عقد انشائها أو التي يقررها القانون ، موطن وهو المكان الذي يوجد فيه مركز إدارتها، الشركات التي يكون مركزها الرئيسي في الخارج ولها نشاط في الجزائر يعتبر مركزها، في نظر القانون الداخلي في الجزائر، نائب يعبر عن إرادتها، حق التقاضي"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_50> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
