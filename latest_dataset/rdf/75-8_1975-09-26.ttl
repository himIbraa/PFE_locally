    dznorm:sourceArticle "art_407" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_407_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_407> ;
    dzdoc:position 0 ;
    dzdoc:text "يرد المشتري للبائع وقت انعقاد البيع ما قد وفاه هذا الأخير من ديون التركة ويحسب للبائع كل ما يكون دائنا به للتركة ما لم يوجد اتفاق يقضي بخلاف ذلك."@ar .

