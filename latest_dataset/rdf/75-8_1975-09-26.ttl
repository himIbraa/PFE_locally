<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3> ;
    dzdoc:position 0 ;
    dzdoc:text "يعد تعسفيا كل استيلاء تم خارج نطاق الحالات والشروط المحددة قانونا وأحكام المادة 679 وما يليها أعلاه، ويمكن أن يترتب عليه، زيادة على العقوبات الأخرى المنصوص عليها في التشريع المعمول به دفع تعويض يصدر عن طريق القضاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3> ;
    dzdoc:position 1 ;
    dzdoc:text "يتعلق هذا التعويض بإصلاح الضرر المتسبب ومكافأة العمل والرأسمال وكذا بتعويض كل نقص في الربح."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3_right_0_769b6eb3> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3> ;
    dznorm:position 0 ;
    dznorm:provisionText "دفع تعويض يصدر عن طريق القضاء"@ar ;
    dznorm:sourceArticle "art_681_bis_3" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_condition_0_d2df248f> a dznorm:Condition ;
    dznorm:conditionText "في الحالات التي تقتضي ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681> ;
    dzdoc:position 0 ;
    dzdoc:text "ينفذ الاستيلاء مباشرة أو من قبل رئيس المجلس الشعبي البلدي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_681> ;
    dzdoc:position 1 ;
    dzdoc:text "ويمكن في الحالات التي تقتضي ذلك، تنفيذه بالقوة بطريقة إدارية دون الاخلال بالعقوبات المدنية والجزائية التي أقرها التشريع المعمول به."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_682_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_682> ;
    dzdoc:position 0 ;
    dzdoc:text "كل شيء غير خارج عن التعامل بطبيعته أو بحكم القانون يصلح أن يكون محلا للحقوق المالية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_682_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_682> ;
    dzdoc:position 1 ;
    dzdoc:text "والأشياء التي تخرج عن التعامل بطبيعتها هي التي لا يستطيع أحد أن يستأثر بحيازتها وأما الخارجة بحكم القانون فهي التي يجيز القانون أن تكون محلا للحقوق المالية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_683_permission_0_19a226b7> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_683_permission_0_19a226b7_action_d3ca81fc66> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_683> ;
    dznorm:position 0 ;
    dznorm:provisionText "كل شيء مستقر بحيزه وثابت فيه ولا يمكن نقله منه دون تلف فهو عقار، وكل ما عدا ذلك من شيء فهو منقول."@ar ;
    dznorm:sourceArticle "art_683" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_683_permission_0_19a226b7_action_d3ca81fc66> a dznorm:Action ;
    rdfs:label "نقله منه دون تلف فهو"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "كل شيء مستقر بحيزه وثابت فيه ولا يمكن نقله منه دون تلف فهو عقار، وكل ما عدا ذلك من شيء فهو منقول."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_683> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_684_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_684> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر مالا عقاريا كل حق عيني يقع على عقار، بما في ذلك حق الملكية، وكذلك كل دعوى تتعلق بحق عيني على عقار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_685_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_685> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعتبر قابلا للاستهلاك كل شيء يكون جزءا من المحل التجاري وهو معد للبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_687_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_687> ;
    dzdoc:position 0 ;
    dzdoc:text "تنظم قوانين خاصة الحقوق التي ترد على أشياء غير مادية."@ar .

