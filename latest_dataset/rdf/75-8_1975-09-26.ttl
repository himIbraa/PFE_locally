    dzdoc:replacementText "يبرأ الكفيل بمجرد براءة المدين ، وله أن يتمسك بجميع الأوجه التي يحتج بها المدين . غير أنه إذا كان الوجه الذي يحتج به المدين يتمثل في نقص أهليته وكان الكفيل عالما بذلك وقت التعاقد ، فليس له أن يحتج بهذا الوجه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_654> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_654> ;
