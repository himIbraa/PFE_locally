<https://legal.dz/resource/order/1975-09-26/75-58#version_art_570> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا انقضى العقد بموت المقاول وجب على رب العمل أن يدفع للتركة قيمة ما تم من الأعمال وما انفق لتنفيذ ما لم يتم . وذلك بقدر النفع الذي يعود عليه من هذه الأعمال والنفقات. ويجوز ل رب العمل في نظير ذلك أن يطالب بتسلم المواد التي تم إعدادها والرسوم التي بدئ في تنفيذها ، على أن يدفع عنها تعويضا عادلا. وتسري هذه الأحكام أيضا إذا بدأ المقاول في تنفيذ العمل ثم أصبح عاجزا عن إتمامه لسبب خارج عن إرادته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_570_19750926_OpEnact_5cf5b519ac> ;
    dzdoc:replacementText "إذا انقضى العقد بموت المقاول وجب على رب العمل أن يدفع للتركة قيمة ما تم من الأعمال وما انفق لتنفيذ ما لم يتم . وذلك بقدر النفع الذي يعود عليه من هذه الأعمال والنفقات. ويجوز ل رب العمل في نظير ذلك أن يطالب بتسلم المواد التي تم إعدادها والرسوم التي بدئ في تنفيذها ، على أن يدفع عنها تعويضا عادلا. وتسري هذه الأحكام أيضا إذا بدأ المقاول في تنفيذ العمل ثم أصبح عاجزا عن إتمامه لسبب خارج عن إرادته ."@ar ;
