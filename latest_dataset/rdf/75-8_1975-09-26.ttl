<https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_defocc_bd7e32d9f052> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 31 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:abuse_of_right ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يشكل الاستعمال التعسفي للحق خطأ لاسيما في الحالات الآتية :
                
                
                إذا وقع بقصد الاضرار بالغير،
                
                
                إذا كان يرمي للحصول على فائدة قليلة بالنسبة إلى الضرر الناشئ للغير،
                
                
                إذا كان الغرض منه الحصول على فائدة غير مشروعة."""@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_124_bis> ;
    dzdoc:position 0 ;
    dzdoc:text "يشكل الاستعمال التعسفي للحق خطأ لاسيما في الحالات الآتية : إذا وقع بقصد الاضرار بالغير، إذا كان يرمي للحصول على فائدة قليلة بالنسبة إلى الضرر الناشئ للغير، إذا كان الغرض منه الحصول على فائدة غير مشروعة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_136_defocc_ffe2e3a7bc34> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 20 ;
