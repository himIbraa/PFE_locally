    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#book_2_book_2_chp_9_book_2_chp_9_sec_1_bis_book_2_chp_9_sec_1_bis_subsec_4_art_9> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينتهي عقد التسيير بانقضاء المدة التي أبرم من أجلها ، ويمكن فسخه لعدم احترام الالتزامات المتبادلة ."@ar .

