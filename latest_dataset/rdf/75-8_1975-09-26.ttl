<https://legal.dz/resource/order/1975-09-26/75-58#art_102_condition_0_0f25d924> a dznorm:Condition ;
    dznorm:conditionText "إذا كان العقد باطلا بطلانا مطلقا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_102> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_102_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_102> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان العقد باطلا بطلانا مطلقا جاز لكل ذي مصلحة أن يتمسك بهذا البطلان، وللمحكمة أن تقضي به من تلقاء نفسها ولا يزول البطلان بالاجازة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_102_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_102> ;
    dzdoc:position 1 ;
    dzdoc:text "وتسقط دعوى البطلان بمضي خمسة عشرة سنة من وقت إبرام العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_103_obligation_0_a1f98284> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاد المتعاقدان إلى الحالة التي كانا عليها قبل العقد"@ar ;
    dznorm:sourceArticle "art_103" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_103_obligation_1_c5650344> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
    dznorm:position 1 ;
    dznorm:provisionText "لا يلزم ناقص الأهلية، إذا أبطل العقد لنقص أهليته، إلا برد ما عاد عليه من منفعة بسبب تنفيذ العقد"@ar ;
    dznorm:sourceArticle "art_103" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_103_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاد المتعاقدان إلى الحالة التي كانا عليها قبل العقد في حالة بطلان العقد أو إبطاله، فإن كان هذا مستحيلا جاز الحكم بتعويض معادل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_103_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه لا يلزم ناقص الأهلية، إذا أبطل العقد لنقص أهليته، إلا برد ما عاد عليه من منفعة بسبب تنفيذ العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_103_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
    dzdoc:position 2 ;
    dzdoc:text "يحرم من الاسترداد في حالة بطلان العقد من تسبب في عدم مشروعيته أو كان عالما به."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_104_condition_0_0612ab9e> a dznorm:Condition ;
    dznorm:conditionText "إذا كان العقد في شق منه باطلا أو قابلا للابطال"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_104> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_104_condition_1_6268e33a> a dznorm:Condition ;
    dznorm:conditionText "إذا تبين أن العقد ما كان ليتم بغير الشق الذي وقع باطلا، أو قابلا للابطال"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_104> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_104_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_104> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان العقد في شق منه باطلا أو قابلا للابطال ، فهذا الشق وحده هو الذي يبطل، الا إذا تبين أن العقد ما كان ليتم بغير الشق الذي وقع باطلا، أو قابلا للابطال فيبطل العقد كله."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_105_condition_0_65ad8f9c> a dznorm:Condition ;
    dznorm:conditionText "إذا كان العقد باطلا أو قابلا للابطال وتوفرت فيه أركان عقد آخر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_105> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_105_condition_1_62a8838e> a dznorm:Condition ;
    dznorm:conditionText "إذا تبين أن نية المتعاقدين كانت تنصرف إلى إبرام هذا العقد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_105> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_105_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_105> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان العقد باطلا أو قابلا للابطال وتوفرت فيه أركان عقد آخر فإن العقد يكون صحيحا باعتباره العقد الذي توفرت أركانه، إذا تبين أن نية المتعاقدين كانت تنصرف إلى إبرام هذا العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_106_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_106> ;
    dzdoc:position 0 ;
    dzdoc:text "العقد شريعة المتعاقدين، فلا يجوز نقضه ولا تعديله الا باتفاق الطرفين، أو للاسباب التي يقررها القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_106_permission_0_8888ef74> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
