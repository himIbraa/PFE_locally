<https://legal.dz/resource/order/1975-09-26/75-58#art_346> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_346" ;
    dzdoc:fullText "لا يجوز للخصم اثبات كذب اليمين بعد تأديتها من الخصم الذي وجهت إليه أو ردت عليه على انه إذا اثبت كذب اليمين بحكم جنائي فإن للخصم الذي أصابه ضرر منها أن يطالب بالتعويض دون إخلال بما قد يكون له من حق في الطعن على الحكم الذي صدر ضده."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_346_permission_0_8f43f770> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_346_right_0_8f818f5a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_346> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_346_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_346_19750926_OpEnact_6b4a7bd4fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_346_obligation_0_d4199924> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_346_prohibition_0_8f43f770> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "346" ;
    dzdoc:position 370 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_346_condition_0_52093cc2> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_458> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_4> ;
    dzdoc:eId "art_458" ;
    dzdoc:fullText "يجوز للمدين إذا انقضت ستة (6) أشهر على القرض أن يعلن رغبته في إلغاء العقد، ورد ما اقترضه على أن يتم ذلك في أجل لا يجاوز ستة (6) أشهر من تاريخ الاعلان. أما حق المقترض في الرد فإنه لا يجوز اسقاطه أو تحديده بمقتضى الاتفاق."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_458_permission_0_3d95df5e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_458_permission_1_e412a394> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_458_right_0_c2d464f7>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_458_right_1_288a6e8e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_458> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_458_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_458_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_458_19750926_OpEnact_40ca2021cb> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_458_prohibition_0_e412a394> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 458" ;
    dzdoc:position 482 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_484> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_484" ;
    dzdoc:fullText "يتعين على المستأجر ، إخطار المؤجر بالدعوى المرفوعة من الغير الذي يدعي حقا على العين المؤجرة يتعارض مع حق المستأجر ومطالبته بالضمان . وفي هذه الحالة يمكن المستأجر طلب إخراجه من الخصام . إذا ترتب على هذه الدعوى حرمان المستأجر من الانتفاع بالشيء المستأجر كليا أو جزئيا ، جاز له طلب فسخ الإيجار أو إنقاص بدل الإيجار دون الإخلال بحقه في التعويض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_484_permission_0_a82e147e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_484_right_0_8664effb>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_484_right_1_a5b76a13> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_484> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_484_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_484_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_484_19750926_OpEnact_d960c1acdd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_484_obligation_0_291e5efc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 484" ;
    dzdoc:position 514 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_484_condition_0_f0fedf28> ;
    dzdoc:usesTerm dzterm:leased_property,
        dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_501> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_501" ;
    dzdoc:fullText "يحق للمؤجر ، ضمانا لحقوقه الناشئة عن الإيجار، أن يحبس جميع المنقولات القابلة للحجز الموجودة في العين المؤجرة مادامت مثقلة بامتياز المؤجر ، ولو لم تكن مملوكة للمستأجر . يجوز للمؤجر أن يعترض على نقلها ، وإذا نقلت رغم اعتراضه أو دون علمه ، جاز له استردادها من الحائز ولو كان حسن النية ، ولهذا الأخير المطالبة بحقوقه. ولا يجوز للمؤجر استعمال حقه في الحبس أو في الاسترداد إذا كان نقل هذه المنقولات تقتضيه حرفة المستأجر ، أو تقتضيه شؤون الحياة العادية، أو كانت المنقولات التي أبقيت في العين المؤجرة أو التي طلب استردادها تفي ببدل الإيجار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_501_permission_0_c0ff0b1e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_501_permission_1_05c2ccc4> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_501_right_0_24b09a05>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_501_right_1_5dc31e4d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_501_right_2_486a6ce4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_501> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_501_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_501_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_501_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_501_19750926_OpEnact_438df44739> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 501" ;
    dzdoc:position 531 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_501_condition_0_03a8a1e1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_501_condition_1_f0cb907c> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_588> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_2_subsec_3> ;
    dzdoc:eId "art_588" ;
    dzdoc:fullText "يجوز للوكيل أن يتنازل في أي وقت عن الوكالة ولو وجد اتفاق يخالف ذلك، ويتم التنازل بإعلانه للموكل فإذا كانت الوكالة بأجر فإن الوكيل يكون ملزما بتعويض الموكل عن الضرر الذي لحقه من جراء التنازل في وقت غير مناسب أو بعذر غير مقبول . غير أنه لا يجوز للوكيل أن يتنازل عن الوكالة متى كانت صادرة لصالح أجنبي بهذا التنازل وان يمهله وقتا كافيا ليتخذ ما يلزم لصيانة مصالحه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_588_permission_0_7edc2608>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_588_permission_1_8288efaa> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_588_right_0_b5d5ac88> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_588> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_588_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_588_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
