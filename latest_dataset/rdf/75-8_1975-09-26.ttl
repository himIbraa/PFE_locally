    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب دفع الثمن لدى الضابط العمومي الذي حرر العقد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_obligation_2_c4460b12> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> ;
    dznorm:position 2 ;
    dznorm:provisionText "يجب، تحت طائلة البطلان، اثبات العقود المؤسسة أو المعدلة للشركة بعقد رسمي"@ar ;
    dznorm:sourceArticle "art_324_bis_1" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> ;
    dzdoc:position 0 ;
    dzdoc:text "زيادة عن العقود التي يأمر القانون باخضاعها إلى شكل رسمي يجب، تحت طائلة البطلان، تحرير العقود التي تتضمن نقل ملكية عقار أو حقوق عقارية أو محلات تجارية أو صناعية أو كل عنصر من عناصرها، أو التنازل عن أسهم من شركة أو حصص فيها، أو عقود إيجار زراعية أو تجارية أو عقود تسيير محلات تجارية أو مؤسسات صناعية في شكل رسمي، ويجب دفع الثمن لدى الضابط العمومي الذي حرر العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> ;
    dzdoc:position 1 ;
    dzdoc:text "كما يجب، تحت طائلة البطلان، اثبات العقود المؤسسة أو المعدلة للشركة بعقد رسمي. وتودع الأموال الناتجة عن هذه العمليات لدى الضابط العمومي المحرر للعقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_condition_0_7de86489> a dznorm:Condition ;
    dznorm:conditionText "وإذا كان بين الاطراف أو الشهود من لا يعرف أو لا يستطيع التوقيع"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_condition_1_2d273721> a dznorm:Condition ;
    dznorm:conditionText "إذا كان الضابط العمومي يجهل الاسم والحالة والسكن والاهلية المدنية الاطراف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2> ;
    dznorm:position 1 .

