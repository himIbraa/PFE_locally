<https://legal.dz/resource/order/1975-09-26/75-58#version_art_658> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أفلس المدين وجب على الدائن أن يتقدم بدينه في التفليسة ، والا سقط حقه في الرجوع على الكفيل بقدر ما أصاب هذا الأخير من ضرر سبب إهمال الدائن ."@ar ;
