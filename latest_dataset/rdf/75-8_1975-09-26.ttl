<https://legal.dz/resource/order/1975-09-26/75-58#version_art_993> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون للديون التالية امتياز على جميع أموال المدين من منقول وعقار : المبالغ المستحقة للخدم والكتبة، والعمال وكل أجير آخر ، من أجرهم ورواتبهم من أي نوع كان عن الاثني عشر (12) شهرا الاخيرة، المبالغ المستحقة عما تم توريده للمدين ولمن يعوله من مأكل وملبس في الستة (6) الأشهر الأخيرة، النفقة المستحقة في ذمة المدين لأقاربه عن الاشهر (6) الستة الاخيرة. وتستوفى هذه المبالغ مباشرة بعد المصاريف القضائية والمبالغ المستحقة للخزينة العامة ومصاريف الحفظ والترميم، أما فيما بينها فتستوفى بنسبة كل منها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_993_19750926_OpEnact_cacee88605> ;
    dzdoc:replacementText "يكون للديون التالية امتياز على جميع أموال المدين من منقول وعقار : المبالغ المستحقة للخدم والكتبة، والعمال وكل أجير آخر ، من أجرهم ورواتبهم من أي نوع كان عن الاثني عشر (12) شهرا الاخيرة، المبالغ المستحقة عما تم توريده للمدين ولمن يعوله من مأكل وملبس في الستة (6) الأشهر الأخيرة، النفقة المستحقة في ذمة المدين لأقاربه عن الاشهر (6) الستة الاخيرة. وتستوفى هذه المبالغ مباشرة بعد المصاريف القضائية والمبالغ المستحقة للخزينة العامة ومصاريف الحفظ والترميم، أما فيما بينها فتستوفى بنسبة كل منها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_993> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
