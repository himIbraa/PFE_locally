<https://legal.dz/resource/order/1975-09-26/75-58#version_art_75> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يعلن المتعاقد وقت إبرام العقد أنه يتعاقد بصفته نائبا ، فإن أثر العقد لا يضاف إلى الأصيل دائنا أو مدينا، إلا إذا كان من المفروض حتما أن من تعاقد معه النائب يعلم بوجود النيابة أو كان يستوي عنده أن يتعامل مع الأصيل أو النائب."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
