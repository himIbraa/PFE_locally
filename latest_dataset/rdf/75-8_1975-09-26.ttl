<https://legal.dz/resource/order/1975-09-26/75-58#version_art_418> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يكون عقد الشركة مكتوبا وإلا كان باطلا، وكذلك يكون باطلا كل ما يدخل على العقد من تعديلات إذا لم يكن له نفس الشكل الذي يكتسبه ذلك العقد . غير أنه لا يجوز أن يحتج الشركاء بهذا البطلان قبل الغير ولا يكون له أثر فيما بينهم إلا من اليوم الذي يقوم فيه أحدهم بطلب البطلان."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_418_19750926_OpEnact_fa145fc2d5> ;
    dzdoc:replacementText "يجب أن يكون عقد الشركة مكتوبا وإلا كان باطلا، وكذلك يكون باطلا كل ما يدخل على العقد من تعديلات إذا لم يكن له نفس الشكل الذي يكتسبه ذلك العقد . غير أنه لا يجوز أن يحتج الشركاء بهذا البطلان قبل الغير ولا يكون له أثر فيما بينهم إلا من اليوم الذي يقوم فيه أحدهم بطلب البطلان."@ar ;
    dzdoc:resolutionStatus "resolved" ;
