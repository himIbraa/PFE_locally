<https://legal.dz/resource/order/1975-09-26/75-58#art_11_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_11> ;
    dzdoc:position 0 ;
    dzdoc:text "يسري على الشروط الموضوعية الخاصة بصحة الزواج القانون الوطني لكل من الزوجين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_120_obligation_0_43caf86e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_120> ;
    dznorm:position 0 ;
    dznorm:provisionText "الاعذار"@ar ;
    dznorm:sourceArticle "art_120" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_120_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_120> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز الاتفاق على أن يعتبر العقد مفسوخا بحكم القانون عند عدم الوفاء بالالتزامات الناشئة عنه بمجرد تحقيق الشروط المتفق عليها وبدون حاجة إلى حكم قضائي."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_120_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_120> ;
    dzdoc:position 1 ;
    dzdoc:text "وهذا الشرط لا يعفي من الاعذار ، الذي يحدد حسب العرف عند عدم تحديده من طرف المتعاقدين."@ar .

