<https://legal.dz/resource/order/1975-09-26/75-58#version_art_796> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعدد الشفعاء يكون استعمال حق الشفعة حسب الترتيب المنصوص عليه في الفقرات التالية : إذا كان الشفعاء من طبقة واحدة استحق كل منهم الشفعة بقدر نصيبه، وإذا كان المشتري قد توفرت فيه الشروط التي تجعله شفيعا بمقتضى المادة 795 فإنه يفضل على الشفعاء من طبقته أو من طبقة أدنى ولكن يتقدمه الذين هم من طبقة أعلى."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_796_19750926_OpEnact_13d936f15c> ;
