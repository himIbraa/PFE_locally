<https://legal.dz/resource/order/1975-09-26/75-58#version_art_176> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا استحال على المدين أن ينفذ الالتزام عينا حكم عليه بتعويض الضرر الناجم عن عدم تنفيذ التزامه، ما لم يثبت أن استحالة التنفيذ نشأت عن سبب لا يد له فيه ، ويكون الحكم كذلك إذا تأخر المدين في تنفيذ التزامه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
