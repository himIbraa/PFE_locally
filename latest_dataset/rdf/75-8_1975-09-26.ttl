    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_579> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_579_condition_1_70f29061> a dznorm:Condition ;
    dznorm:conditionText "وإذا عين الوكلاء في عقد واحد دون أن يرخص في انفرادهم في العمل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_579> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_579_obligation_0_a451d338> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_579> ;
    dznorm:position 0 ;
    dznorm:provisionText "كانوا مسؤولين بالتضامن متى كانت الوكالة غير قابلة للانقسام أو كان الضرر الذي أصاب الموكل نتيجة خطا مشترك"@ar ;
    dznorm:sourceArticle "art_579" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_579_obligation_1_c88f5d71> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_579> ;
    dznorm:position 1 ;
    dznorm:provisionText "كان عليهم أن يعملوا مجتمعين"@ar ;
    dznorm:sourceArticle "art_579" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_579_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_579> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تعدد الوكلاء كانوا مسؤولين بالتضامن متى كانت الوكالة غير قابلة للانقسام أو كان الضرر الذي أصاب الموكل نتيجة خطا مشترك على أن الوكلاء ولو كانوا متضامنين لا يسألون عما فعله أحدهم متجاوزا حدود الوكالة أو متعسفا في تنفيذها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_579_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_579> ;
    dzdoc:position 1 ;
    dzdoc:text "وإذا عين الوكلاء في عقد واحد دون أن يرخص في انفرادهم في العمل كان عليهم أن يعملوا مجتمعين الا إذا كان العمل مما لا يحتاج فيه إلى تبادل الرأي كقبض الدين أو وفائه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_579_permission_0_4839a566> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
