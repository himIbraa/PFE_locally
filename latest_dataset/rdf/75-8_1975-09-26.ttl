<https://legal.dz/resource/order/1975-09-26/75-58#version_art_594> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المودع لديه أن يسلم الشيء إلى المودع بمجرد طلبه الا إذا ظهر من العقد أن الأجل عين لمصلحة المودع لديه . و للمودع لديه أن يلزم المودع بتسليم الشيء في أي وقت ، الا إذا ظهر من العقد أن الأجل عين لمصلحة المودع ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_594_19750926_OpEnact_2ce1b7bdac> ;
