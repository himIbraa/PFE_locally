    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المال المقرر عليه حق الانتفاع منقولا وجب جرده ولزم المنتفع تقديم كفالة به فإن لم يقدمها بيع المال ووظف ثمنه في شراء سندات عامة يستولي المنتفع على أرباحها، وللمنتفع الذي قدم الكفالة أن يستعمل الأشياء القابلة للاستهلاك بشرط أن يرد بدلها عند انتهاء حقه في الانتفاع ، وله نتاج المواشي بعد أن يعرض منها ما هلك من الأصل بسبب حادث مفاجئ أو قوة قاهرة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_851_19750926_OpEnact_6ecfe90468> ;
    dzdoc:replacementText "إذا كان المال المقرر عليه حق الانتفاع منقولا وجب جرده ولزم المنتفع تقديم كفالة به فإن لم يقدمها بيع المال ووظف ثمنه في شراء سندات عامة يستولي المنتفع على أرباحها، وللمنتفع الذي قدم الكفالة أن يستعمل الأشياء القابلة للاستهلاك بشرط أن يرد بدلها عند انتهاء حقه في الانتفاع ، وله نتاج المواشي بعد أن يعرض منها ما هلك من الأصل بسبب حادث مفاجئ أو قوة قاهرة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_851> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
