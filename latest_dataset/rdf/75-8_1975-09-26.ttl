    dznorm:position 0 ;
    dznorm:provisionText "على أن يعوض المقاول عن جميع ما أنفقه من المصروفات، وما أنجزه من الأعمال وما كان يستطيع كسبه لو أنه أتم العمل"@ar ;
    dznorm:sourceArticle "art_566" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_566_obligation_0_b33e5824_role_63df223389> a dznorm:Role ;
