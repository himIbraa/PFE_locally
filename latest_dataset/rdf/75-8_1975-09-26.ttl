<https://legal.dz/resource/order/1975-09-26/75-58#art_890_obligation_0_519a9495> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-58#art_890_obligation_0_519a9495_period_68854038f5> ;
