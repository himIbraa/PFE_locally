    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_170> ;
    dznorm:hasCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_170_right_0_f37456d0_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "جاز للدائن أن يطلب ترخيصا من القاضي في تنفيذ الالتزام على نفقة المدين إذا كان هذا التنفيذ ممكنا"@ar ;
    dznorm:sourceArticle "art_170" .

