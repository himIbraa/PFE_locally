    dznorm:conditionText "بشرط أن تكون هذه الحقوق واجبة لهم جزاء عما أدوه من عمل مهنتهم وعما تكبدوه من مصاريف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_310> ;
