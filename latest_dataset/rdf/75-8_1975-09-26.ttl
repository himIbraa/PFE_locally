<https://legal.dz/resource/order/1975-09-26/75-58#version_art_872> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لمالك العقار المرتفق أن يجري من الأعمال ما هو ضروري لاستعمال حقه في الارتفاق ويحفظه ، و يجب عليه أن يباشر هذا الحق على الوجه الذي ينشأ عنه أخف الضرر للعقار المرتفق به ولا يجوز أن يترتب على ما يوجد من حاجات العقار المرتفق أي زيادة في عبء الارتفاق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_872_19750926_OpEnact_3381b85652> ;
