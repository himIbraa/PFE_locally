    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الأرض ملك لمن يخدمها وتعتبر جميع موارد المياه ملكا للجماعة الوطنية . تحدد اجراءات تطبيق هذه المادة بالنصوص الخاصة بالثورة الزراعية والنصوص المتعلقة بالبحث والتوزيع، واستعمال، واستغلال المياه."@ar ;
