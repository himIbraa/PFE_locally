<https://legal.dz/resource/order/1975-09-26/75-58#version_art_650> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تجوز الكفالة في الدين المستقبل إذا حدد مقدما المبلغ المكفول ، كما تجوز الكفالة في الدين المشروط. غير أنه إذا كان الكفيل في الدين المستقبل لم يعين مدة الكفالة ، كان له أن يراجع فيها في أي وقت ما دام الدين المكفول لم ينشأ ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_650_19750926_OpEnact_af7b3dd360> ;
    dzdoc:replacementText "تجوز الكفالة في الدين المستقبل إذا حدد مقدما المبلغ المكفول ، كما تجوز الكفالة في الدين المشروط. غير أنه إذا كان الكفيل في الدين المستقبل لم يعين مدة الكفالة ، كان له أن يراجع فيها في أي وقت ما دام الدين المكفول لم ينشأ ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
