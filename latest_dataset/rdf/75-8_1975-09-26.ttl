<https://legal.dz/resource/order/1975-09-26/75-58#version_art_491> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلتزم المستأجر بأن يستعمل العين المؤجرة حسبما وقع الاتفاق عليه ، فإن لم يكن هناك اتفاق وجب على المستأجر أن يستعمل العين المؤجرة بحسب ما أعدت له ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_491_19750926_OpEnact_09ef7d6ef4> ;
