<https://legal.dz/resource/order/1975-09-26/75-58#version_art_486> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ترتب على عمل قامت به السلطة الادارية بمقتضى القانون نقص كبير في الانتفاع بالعين المؤجرة جاز للمستأجر حسب الظروف أن يطلب فسخ الإيجار أو انقاص ثمنه وله أن يطالب بتعويضه إذا كان عمل السلطة الادارية قد صدر بسبب يكون المؤجر مسؤولا عنه كل هذا ما لم يوجد اتفاق يقضي بخلاف ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_486_19750926_OpEnact_3e0c90be2d> ;
