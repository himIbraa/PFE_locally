<https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_6> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر العقد الرسمي حجة لمحتوى الاتفاق المبرم بين الاطراف المتعاقدة وورثتهم وذوي الشأن. غير أنه في حالة شكوى بسبب تزوير في الأصل ، يوقف تنفيذ العقد محل الاحتجاج بتوجيه الاتهام، و عند رفع دعوى فرعية بالتزوير ، يمكن للمحاكم، حسب الظروف، ايقاف تنفيذ العقد مؤقتا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
