    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_286_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_286> ;
    dzdoc:position 0 ;
    dzdoc:text "تسري أحكام البيع وخصوصا ما يتعلق منها بأهلية الطرفين، وبضمان الاستحقاق، وبضمان العيوب الخفية على الوفاء بمقابل فيما إذا كان ينقل ملكية شيء أعطى في مقابلة الدين ويسري عليه من حيث انه يقضى الدين احكام الوفاء وبالاخص ما تعلق منها بتعيين جهة الدفع وانقضاء التأمينات."@ar .

