<https://legal.dz/resource/order/1975-09-26/75-58#version_art_817> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لحائز العقار إذا فقد حيازته أن يطلب خلال السنة التالية لفقدها، ردها إليه فإذا كان فقد الحيازة خفية بدأ سريان السنة من وقت انكشاف ذلك. ويجوز أيضا أن يسترد الحيازة من كان حائزا بالنيابة من غيره ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_817_19750926_OpEnact_0432097637> ;
    dzdoc:replacementText "يجوز لحائز العقار إذا فقد حيازته أن يطلب خلال السنة التالية لفقدها، ردها إليه فإذا كان فقد الحيازة خفية بدأ سريان السنة من وقت انكشاف ذلك. ويجوز أيضا أن يسترد الحيازة من كان حائزا بالنيابة من غيره ."@ar ;
