<https://legal.dz/resource/order/1975-09-26/75-58#version_art_966> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشترط لنفاذ الرهن العقاري في حق الغير، إلى جانب تسليم الملك للدائن، أن يقيد عقد الرهن العقاري ، وتسري على هذا القيد الأحكام الخاصة بقيد الرهن الرسمي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_966_19750926_OpEnact_9f158cf413> ;
