dzterm:authentic_act a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العقد الرسمي"@ar,
        "العقد الرسمي عقد يثبت فيه موظف أو ضابط عمومي أو شخص مكلف بخدمة عامة، ما تم لديه أو ما تلقاه من ذوي الشأن وذلك طبقا للاشكال القانونية وفي حدود سلطته واختصاصه"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_324_defocc_4481900ba147> .

dzterm:bilateral_contracts a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العقود الملزمة للجانبين"@ar .

