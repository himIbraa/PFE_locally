    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_814_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_814> ;
    dzdoc:position 0 ;
    dzdoc:text "تنتقل الحيازة إلى الخلف العام بجميع صفاتها غير أنه إذا كان السلف سيئ النية وأثبت الخلف أنه كان في حيازته حسن النية جاز له أن يتمسك بحسن نيته، ويجوز للخلف الخاص أن يضم إلى حيازته حيازة سلفه ليبلغ التقادم."@ar .

