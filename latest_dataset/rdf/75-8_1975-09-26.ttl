    dzdoc:heading "الملكية الشائعة"@ar ;
    dzdoc:number "الرابع" ;
    dzdoc:position 3 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_428> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_2> ;
    dzdoc:eId "art_428" ;
    dzdoc:fullText "إذا تعدد الشركاء المكلفون بالادارة دون أن يعين اختصاص كل منهم، ودون أن ينص على عدم جواز تصرفاتهم بالانفراد يجوز لكل واحد أن ينفرد بعمله في التصرف على أن يكون لكل واحد من باقي الشركاء الحق في الاعتراض على ذلك العمل قبل انجازه وان يكون الحق لاغلبية الشركاء المنتدبين أن يرفضوا هذا الاعتراض فإذا تساوى الجانبان كان الرفض من حق أغلبية الشركاء جميعا . أما إذا وقع الاتفاق على أن تكون قرارات الشركاء المنتدبين بالإجماع، أو بالأغلبية ، فلا يجوز الخروج على ذلك الا أن يكون لأمر عاجل يترتب على اغفاله خسارة جسيمة لا تعوض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_428_permission_0_4cb3e3de>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_428_permission_1_34c8854d> ;
