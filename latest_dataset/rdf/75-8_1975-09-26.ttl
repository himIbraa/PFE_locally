<https://legal.dz/resource/order/1975-09-26/75-58#version_art_740> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ليس للشركاء أن يطلبوا القسمة ما دامت ملكية الأسرة قائمة ، و لا يجوز لأي شريك أن يتصرف في نصيبه لأجنبي عن الأسرة الا بموافقة الشركاء جميعا . وإذا تملك أجنبي عن الأسرة حصة أحد الشركاء برضاء هذا الشريك أو جبرا عليه ، فلا يكون الأجنبي شريكا في ملكية الأسرة الا برضاء باقي الشركاء ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_740_19750926_OpEnact_049a1e832a> ;
    dzdoc:replacementText "ليس للشركاء أن يطلبوا القسمة ما دامت ملكية الأسرة قائمة ، و لا يجوز لأي شريك أن يتصرف في نصيبه لأجنبي عن الأسرة الا بموافقة الشركاء جميعا . وإذا تملك أجنبي عن الأسرة حصة أحد الشركاء برضاء هذا الشريك أو جبرا عليه ، فلا يكون الأجنبي شريكا في ملكية الأسرة الا برضاء باقي الشركاء ."@ar ;
