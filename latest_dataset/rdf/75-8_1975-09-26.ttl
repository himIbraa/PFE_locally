    dzdoc:position 0 ;
    dzdoc:text "يضمن المدين الأصلي يسار المحال عليه وقت اقرار الدائن للحوالة ما لم يتفق على غير ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_256_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_256> ;
