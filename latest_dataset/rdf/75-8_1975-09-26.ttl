<https://legal.dz/resource/order/1975-09-26/75-58#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان العقد باطلا أو قابلا للابطال وتوفرت فيه أركان عقد آخر فإن العقد يكون صحيحا باعتباره العقد الذي توفرت أركانه، إذا تبين أن نية المتعاقدين كانت تنصرف إلى إبرام هذا العقد ."@ar ;
