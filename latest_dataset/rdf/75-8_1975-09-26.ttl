<https://legal.dz/resource/order/1975-09-26/75-58#version_art_373> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "أن الرجوع بالضمان هو حق يثبت للمشتري ولو اعترف عن حسن نية بحق الغير أو تصالح معه دون أن ينتظر حكما قضائيا متى أخبر البائع بالدعوى في الوقت المناسب ودعاه يحل محله فيها دون جدوى ، كل ذلك ما لم يثبت البائع أن الغير لم يكن على حق في دعواه."@ar ;
