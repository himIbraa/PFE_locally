<https://legal.dz/resource/order/1975-09-26/75-58#version_art_377> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمتعاقدين بمقتضى اتفاق خاص أن يزيدا في ضمان نزع اليد ، أو ينقصا منه، أو يسقطاه . ويفترض في حق الارتفاق أن البائع قد اشترط عدم الضمان إذا كان هذا حقا ظاهرا أو كان البائع قد أعلم به المشتري . ويكون باطلا كل شرط يسقط الضمان أو ينقصه إذا تعمد البائع اخفاء حق الغير ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_377_19750926_OpEnact_854b4dc885> ;
    dzdoc:replacementText "يجوز للمتعاقدين بمقتضى اتفاق خاص أن يزيدا في ضمان نزع اليد ، أو ينقصا منه، أو يسقطاه . ويفترض في حق الارتفاق أن البائع قد اشترط عدم الضمان إذا كان هذا حقا ظاهرا أو كان البائع قد أعلم به المشتري . ويكون باطلا كل شرط يسقط الضمان أو ينقصه إذا تعمد البائع اخفاء حق الغير ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_377> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_377> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
