    dzdoc:position 0 ;
    dzdoc:text "ينقضي الحق في الحبس بخروج الشيء من يد حائزه أو محرزه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_202_para_1> a dzdoc:Paragraph ;
