<https://legal.dz/resource/order/1975-09-26/75-58#version_art_211> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسقط حق المدين في الأجل : إذا شهر افلاسه وفقا لنصوص القانون ، إذا انقص بفعله إلى حد كبير ما أعطى الدائن من تأمين خاص ، ولو كان هذا التأمين قد أعطي بعقد لاحق أو بمقتضى القانون، هذا ما لم يفضل الدائن أن يطالب بتكملة التأمين، اما إذا كان انقاص التأمين يرجع إلى سبب لا دخل للمدين فيه فإن الأجل يسقط ما لم يقدم المدين للدائن ضمانا كافيا ، إذا لم يقدم للدائن ما وعد في العقد بتقديمه من تأمينات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_211_19750926_OpEnact_d9d9cb9358> ;
    dzdoc:replacementText "يسقط حق المدين في الأجل : إذا شهر افلاسه وفقا لنصوص القانون ، إذا انقص بفعله إلى حد كبير ما أعطى الدائن من تأمين خاص ، ولو كان هذا التأمين قد أعطي بعقد لاحق أو بمقتضى القانون، هذا ما لم يفضل الدائن أن يطالب بتكملة التأمين، اما إذا كان انقاص التأمين يرجع إلى سبب لا دخل للمدين فيه فإن الأجل يسقط ما لم يقدم المدين للدائن ضمانا كافيا ، إذا لم يقدم للدائن ما وعد في العقد بتقديمه من تأمينات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_211> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
