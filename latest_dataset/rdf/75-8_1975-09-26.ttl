<https://legal.dz/resource/order/1975-09-26/75-58#art_604_condition_1_7dbbb390> a dznorm:Condition ;
    dznorm:conditionText "إذا عين مسؤول إداري بصفة مؤقتة أو نهائية"@ar ;
