<https://legal.dz/resource/order/1975-09-26/75-58#version_art_175> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تم التنفيذ العيني، أو أصر المدين على رفض التنفيذ حدد القاضي مقدار التعويض الذي يلزم به المدين مراعيا في ذلك الضرر الذي أصاب الدائن والعنت الذي بدأ من المدين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_175_19750926_OpEnact_9ec2788a42> ;
    dzdoc:replacementText "إذا تم التنفيذ العيني، أو أصر المدين على رفض التنفيذ حدد القاضي مقدار التعويض الذي يلزم به المدين مراعيا في ذلك الضرر الذي أصاب الدائن والعنت الذي بدأ من المدين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
