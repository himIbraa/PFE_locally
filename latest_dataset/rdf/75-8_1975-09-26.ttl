    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_1_19750926_OpEnact_42a1f12dac> ;
    dzdoc:replacementText "ينتهي الإيجار بانقضاء المدة المتفق عليها دون حاجة إلى تنبيه بالإخلاء. يجوز للمستأجر إنهاء عقد الإيجار قبل ذلك لسبب عائلي أو مهني . و يجب عليه إخطار المؤجر بموجب محرر غیر قضائي يتضمن إشعارا لمدة شهرين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_1> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا ينتقل الإيجار إلى الورثة. غير أنه في حالة وفاة المستأجر، ما لم يوجد اتفاق على خلاف ذلك ، يستمر العقد إلى انتهاء مدته، وفي هذه الحالة، يجوز للورثة الذين كانوا يعيشون عادة معه منذ ستة (6) أشهر إنهاء العقد إذا أصبحت تكاليفه باهظة بالنسبة إلى مواردهم أو أصبح الإيجار يزيد عن حاجتهم . تجب ممارسة حق إنهاء الإيجار خلال ستة (6) أشهر من يوم وفاة المستأجر . ويجب إخطار المؤجر بموجب محرر غير قضائي يتضمن إشعارا لمدة شهرين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_2_19750926_OpEnact_6b92509a90> ;
    dzdoc:replacementText "لا ينتقل الإيجار إلى الورثة. غير أنه في حالة وفاة المستأجر، ما لم يوجد اتفاق على خلاف ذلك ، يستمر العقد إلى انتهاء مدته، وفي هذه الحالة، يجوز للورثة الذين كانوا يعيشون عادة معه منذ ستة (6) أشهر إنهاء العقد إذا أصبحت تكاليفه باهظة بالنسبة إلى مواردهم أو أصبح الإيجار يزيد عن حاجتهم . تجب ممارسة حق إنهاء الإيجار خلال ستة (6) أشهر من يوم وفاة المستأجر . ويجب إخطار المؤجر بموجب محرر غير قضائي يتضمن إشعارا لمدة شهرين ."@ar ;
