<https://legal.dz/resource/order/1975-09-26/75-58#version_art_981> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا أصبح كل من الدين المرهون والدين المضمون مستحق الأداء جاز للدائن المرتهن إذا لم يستوف حقه، أن يقبض من الدين المرهون ما يكون مستحقا له أو أن يطلب بيع هذا الدين أو تملكه وفقا للمادة 970 الفقرة الثانية ."@ar ;
