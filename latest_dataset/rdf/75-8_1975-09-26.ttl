        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخول الرهن الدائن المرتهن الحق في حبس الشيء المرهون على الناس كافة ، دون إخلال بما للغير من حقوق تم حفظها وفقا للقانون. وإذا خرج الشيء من يد الدائن دون إرادته أو دون علمه كان له الحق في استرداد حيازته من الغير وفقا لأحكام الحيازة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
