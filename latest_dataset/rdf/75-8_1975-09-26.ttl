<https://legal.dz/resource/order/1975-09-26/75-58#version_art_483> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على المؤجر أن يمتنع عن كل تعرض يحول دون انتفاع المستأجر بالعين المؤجرة . ولا يجوز له أن يحدث بها أو بملحقاتها أي تغيير ينقص من هذا الانتفاع . ولا يقتصر ضمان المؤجر على الأفعال التي تصدر منه أو من تابعيه، بل يمتد إلى كل ضرر أو تعرض قانوني صادر عن مستأجر آخر أو أي شخص تلقى الحق عن المؤجر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_483_19750926_OpEnact_30e65c26fc> ;
    dzdoc:replacementText "على المؤجر أن يمتنع عن كل تعرض يحول دون انتفاع المستأجر بالعين المؤجرة . ولا يجوز له أن يحدث بها أو بملحقاتها أي تغيير ينقص من هذا الانتفاع . ولا يقتصر ضمان المؤجر على الأفعال التي تصدر منه أو من تابعيه، بل يمتد إلى كل ضرر أو تعرض قانوني صادر عن مستأجر آخر أو أي شخص تلقى الحق عن المؤجر ."@ar ;
