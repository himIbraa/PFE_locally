<https://legal.dz/resource/order/1975-09-26/75-58#art_165_obligation_0_bc6af369_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_165_obligation_0_bc6af369> ;
    dznorm:conditionText "إذا كان محل الالتزام شيئا معينا بالذات يملكه الملتزم"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_165_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_165> ;
    dzdoc:position 0 ;
    dzdoc:text "الالتزام بنقل الملكية، أو أي حق عيني آخر من شأنه أن ينقل بحكم القانون الملكية أو الحق العيني، إذا كان محل الالتزام شيئا معينا بالذات يملكه الملتزم، وذلك مع مراعاة الأحكام المتعلقة بالاشهار العقاري."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_166_condition_0_a35e12c3> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_166_condition_0_a35e12c3_role_5e86d47a8f> ;
    dznorm:conditionText "إذا ورد الالتزام بنقل حق عيني على شيء لم يعين إلا بنوعه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_166> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_166_condition_0_a35e12c3_role_5e86d47a8f> a dznorm:Role ;
    rdfs:label "شيء لم يعين إلا"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
