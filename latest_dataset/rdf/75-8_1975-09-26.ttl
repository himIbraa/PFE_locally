dzterm:good_faith a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "حسن النية"@ar,
        "يفرض حسن النية لمن يحوز حقا وهو يجهل انه يتعدى على حق الغير الا إذا كان هذا الجهل ناشئا عن خطأ جسيم"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_824_defocc_13256e8fa823> .

dzterm:insurer a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤمن"@ar,
        "للمؤمن"@ar .

dzterm:mortgage_pledge a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الرهن الحيازي"@ar,
        "الرهن الحيازي عقد يلتزم به شخص ضمانا لدين عليه أو على غيره، أن يسلم إلى الدائن أو إلى أجنبي يعينه المتعاقدان شيئا يرتب عليه للدائن حقا عينيا يخوله حبس الشيء إلى أن يستوفي الدين، وأن يتقدم الدائنين العاديين والدائنين التالين له في المرتبة في أن يتقاضى حقه من ثمن هذا الشيء في أي يد يكون."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_948_defocc_dbd1120c0f4f> .

dzterm:partition_of_usufruct a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "قسمة مهايأة"@ar,
        "يتفق الشركاء في قسمة المهايأة على أن يختص كل منهم بجزء مفرز يساوي حصته في المال الشائع متنازلا لشركائه في مقابل ذلك عن الانتفاع بباقي الأجزاء"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_733_defocc_e3ba34cd59d9> .

