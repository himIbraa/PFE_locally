<https://legal.dz/resource/order/1975-09-26/75-58#version_art_108> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينصرف العقد إلى المتعاقدين والخلف العام، ما لم يتبين من طبيعة التعامل، أو من نص القانون، أن هذا الأثر لا ينصرف إلى الخلف العام كل ذلك مع مراعاة القواعد المتعلقة بالميراث."@ar ;
