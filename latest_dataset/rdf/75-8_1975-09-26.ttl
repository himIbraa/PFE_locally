<https://legal.dz/resource/order/1975-09-26/75-58#version_art_709> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للجار أن يكون له على جاره له مطل مواجه على مسافة تقل عن مترين ، وتقاس المسافة من ظهر الحائط الذي يوجد له المطل أو من الحافة الخارجية للشرفة، أو من النتؤ. وإذا كسب أحد بالتقادم الحق في مطل مواجه لملك الجار على مسافة تقل عن مترين ، فلا يجوز لهذا الجار أن يبني على مسافة تقل عن مترين تقاس بالطريقة السابق بيانها أعلاه ، وذلك على طول البناء الذي فتح فيه المطل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_709_19750926_OpEnact_ab5ae168fc> ;
    dzdoc:replacementText "لا يجوز للجار أن يكون له على جاره له مطل مواجه على مسافة تقل عن مترين ، وتقاس المسافة من ظهر الحائط الذي يوجد له المطل أو من الحافة الخارجية للشرفة، أو من النتؤ. وإذا كسب أحد بالتقادم الحق في مطل مواجه لملك الجار على مسافة تقل عن مترين ، فلا يجوز لهذا الجار أن يبني على مسافة تقل عن مترين تقاس بالطريقة السابق بيانها أعلاه ، وذلك على طول البناء الذي فتح فيه المطل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_709> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
