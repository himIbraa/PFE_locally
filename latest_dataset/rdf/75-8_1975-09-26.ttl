    dzdoc:sourceEId "art_786" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يجب عليه أن يدفع للغير إذا لم يطلب هذا الأجر نزعها إحدى القيمتين المنصوص عليهما في الفقرة الأولى من المادة 785"@ar ;
    dzdoc:targetEId "art_785" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_786_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_786> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا أقام أجنبي منشآت بمواد من عنده بعد الترخيص له من مالك الأرض فلا يجوز لمالك الأرض أن يطلب إزالة المنشآت إذا لم يوجد اتفاق في شأنها، ويجب عليه أن يدفع للغير إذا لم يطلب هذا الأجر نزعها إحدى القيمتين المنصوص عليهما في الفقرة الأولى من المادة 785."@ar .

