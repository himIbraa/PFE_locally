<https://legal.dz/resource/order/1975-09-26/75-58#version_art_589> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الوكيل أن يصل بالأعمال التي بدأها بحيث لا تتعرض للتلف وذلك على أي وجه وتنتهي به الوكالة . وفي حالة انتهاء الوكالة بموت الوكيل يجب على ورثته، إذا توفرت فيهم الأهلية وكانوا على علم بالوكالة ، أن يبادروا إلى إخطار الموكل بموت مورثه وان يتخذوا من التدابير ما تقتضيه الحال لصالح الموكل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_589_19750926_OpEnact_66b18c8d3f> ;
    dzdoc:replacementText "يجب على الوكيل أن يصل بالأعمال التي بدأها بحيث لا تتعرض للتلف وذلك على أي وجه وتنتهي به الوكالة . وفي حالة انتهاء الوكالة بموت الوكيل يجب على ورثته، إذا توفرت فيهم الأهلية وكانوا على علم بالوكالة ، أن يبادروا إلى إخطار الموكل بموت مورثه وان يتخذوا من التدابير ما تقتضيه الحال لصالح الموكل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
