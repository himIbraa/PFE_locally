<https://legal.dz/resource/order/1975-09-26/75-58#version_art_263> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز أيضا للمدين إذا اقترض مالا وفي به الدين أن يحل المقرض محل الدائن الذي استوفي حقه ، ولو دون رضا هذا الأخير، على أن يذكر في عقد القرض أن المال قد خصص للوفاء، وفي المخالصة أن الوفاء كان من هذا المال الذي اقرضه الدائن الجديد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
