<https://legal.dz/resource/order/1975-09-26/75-58#art_359_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_359> ;
    dzdoc:position 0 ;
    dzdoc:text "تسقط بالتقادم دعوى تكملة الثمن بسبب الغبن إذا انقضت ثلاث سنوات من يوم وبالنسبة لعديمي الأهلية فمن يوم انقطاع سبب العجز."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_359_para_1> a dzdoc:Paragraph ;
