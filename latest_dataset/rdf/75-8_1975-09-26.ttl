    dzdoc:position 495 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_condition_0_4ba239a5> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_469_bis_4" ;
    dzdoc:fullText "لا يجوز للمستأجر أن يحتج على من انتقلت إليه الملكية بما دفعه مقدما من بدل الإيجار إذا أثبت هذا الأخير أن المستأجر كان يعلم وقت الدفع بانتقال الملكية أو كان من المفروض حتما أن يعلم ذلك . وفي حالة عدم إثبات ذلك فلا يكون لمن انتقلت إليه الملكية إلا الرجوع على المؤجر السابق."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_4_permission_0_e8442fb3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_469_bis_4_19750926_OpEnact_7d417e14a4> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_4_prohibition_0_e8442fb3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 469 مكرر 4" ;
    dzdoc:position 499 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_469_bis_4_condition_0_808b6884> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_543> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_2> ;
    dzdoc:eId "art_543" ;
    dzdoc:fullText "لا يجوز للمستعير أن يسترد المصروفات التي أنفقها لاستعمال الشيء المعار. و هو مكلف بالنفقة اللازمة لصيانة الشيء صيانة معتادة . وله أن ينزع من الشيء المعار كل ما يكون قد أضافه إليه على أن يعيد الشيء إلى حالته الأصلية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_543_permission_0_2db7470f> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_543_right_0_d59140c3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_543> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_543_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_543_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_543_19750926_OpEnact_17c076e5f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_543_obligation_0_866b77ea> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_543_prohibition_0_2db7470f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "543" ;
    dzdoc:position 570 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_543_condition_0_9588e227> ;
    dzdoc:usesTerm dzterm:borrower .

<https://legal.dz/resource/order/1975-09-26/75-58#art_552> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_552" ;
    dzdoc:fullText "إذا كان رب العمل هو الذي قدم المادة فعلى المقاول أن يحرص عليها ويراعي أصول الفن في استخدامه لها وأن يؤدي حسابا لرب العمل عما استعملها فيه ويرد إليه ما بقي منها فإذا صار شيء من هذه المادة غير صالح للاستعمال بسبب إهماله أو قصور كفايته الفنية فهو ملزم برد قيمة هذا الشيء لرب العمل . وعلى المقاول أن يأتي بما يحتاج إليه في انجاز العمل من آلات وأدوات إضافية ويكون ذلك على نفقته ، هذا ما لم يقض الاتفاق أو عرف الحرفة بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_552> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_552_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_552_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_552_19750926_OpEnact_bb6e7541c4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_552_obligation_0_029f4ea3>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_552_obligation_1_08ea08b9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_552_obligation_2_f0498bc5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "552" ;
    dzdoc:position 579 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_552_condition_0_a4d518ab>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_552_condition_1_eebfdf77> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_564> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_3> ;
    dzdoc:eId "art_564" ;
    dzdoc:fullText "يجوز للمقاول أن يوكل تنفيذ العمل في جملته أو في جزء منه إلى مقاول فرعي إذا لم يمنعه من ذلك شرط في العقد أو لم تكن طبيعة العمل تفرض الاعتماد على كفاءته الشخصية . ولكن يبقى في هذه الحالة مسؤولا عن المقاول الفرعي تجاه رب العمل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_564_permission_0_e4b8e36e> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_564_right_0_994d030f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_564> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_564_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_564_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_564_19750926_OpEnact_9ecb462bdc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_564_obligation_0_e4674a75> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "564" ;
    dzdoc:position 591 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_564_condition_0_69d8ee41> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer,
        dzterm:subcontractor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_701> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_701" ;
    dzdoc:fullText "إذا استحق صاحب العقار المرتفق به تعويضا فإنه يمكن أن يحتوي ذلك التعويض على مبلغ مالي يسدد دفعة واحدة أو على أقساط متساوية تتناسب مع الضرر الناجم من استعمال الممر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_701_permission_0_111079cc> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_701_right_0_d5a6f540> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_701> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_701_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_701_19750926_OpEnact_68f0f0592f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 701" ;
    dzdoc:position 741 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_701_condition_0_03fa349c> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_72_bis" ;
    dzdoc:fullText "يمنح دفع العربون وقت إبرام العقد لكل من المتعاقدين الحق في العدول عنه خلال المدة المتفق عليها ، إلا إذا قضى الاتفاق بخلاف ذلك. فإذا عدل من دفع العربون فقدة. وإذا عدل من قبضه رده ومثله ولو لم يترتب على العدول أي ضرر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_right_0_90b28ff9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_bis_19750926_OpEnact_cac27d5eac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_obligation_0_1201bf14> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "72 مكرر" ;
    dzdoc:position 79 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_condition_0_ef602840>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis_condition_1_c5e45dd0> ;
    dzdoc:usesTerm dzterm:earnest_money .

<https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_764_bis" ;
    dzdoc:fullText "يساهم الشريك في الملكية في أعمال الجمعية و له الحق في التصويت على جميع المسائل التي تخص الملكية المشتركة . كما يشارك المستأجر في جميع أعمال الجمعية ، و له الحق في الادلاء بصوت تقريري في الحالات التالية: عندما تناقش الجمعية التكاليف من النوع الأول ، عندما تناقش الجمعية أشغال الترميم التي يراها أغلبية الأعضاء ضرورية ، عندما يكون الشريك في الملكية المعني غائبا أو لم يمثله أحد لدى الجمعية بصفة نظامية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_right_0_c6fd13b4>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_right_1_85a3dbe9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_para_1> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_bis_19750926_OpEnact_481da4eb6e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_obligation_0_6817ad34>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_obligation_1_b7b010f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "764 مكرر" ;
    dzdoc:position 813 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_condition_0_27c727c6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_condition_1_028585d8>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_bis_condition_2_e2173a91> ;
    dzdoc:usesTerm dzterm:partner,
        dzterm:tenant .

<https://legal.dz/resource/order/1975-09-26/75-58#art_776> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:donation_after_death ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_776" ;
    dzdoc:fullText "كل تصرف قانوني يصدر عن شخص في حال مرض الموت بقصد التبرع يعتبر تبرعا مضافا إلى ما بعد الموت ، وتسري عليه أحكام الوصية أيا كانت التسمية التي تعطى إلى هذا التصرف. وعلى ورثة المتصرف أن يثبتوا ان التصرف القانوني قد صدر عن مورثهم وهو في مرض الموت ولهم إثبات بجميع الطرق، ولا يحتج على الورثة بتاريخ العقد إذا لم يكن هذا التاريخ ثابتا . إذا اثبت الورثة ان التصرف صدر عن مورثهم في مرض الموت اعتبر التصرف صادرا على سبيل التبرع ما لم يثبت من صدر له التصرف خلاف ذلك ، كل هذا ما لم توجد أحكام خاصة تخالفه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_776> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_776_defocc_a0a1797e9c33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_776_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_776_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_776_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_776_19750926_OpEnact_cc21fd02d5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_776_obligation_0_23fad649> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "776" ;
    dzdoc:position 827 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_776_condition_0_01681a72>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_776_condition_1_96d823bd>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_776_condition_2_b0d18ae1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_776_condition_3_73042df7> ;
    dzdoc:usesTerm dzterm:will .

<https://legal.dz/resource/order/1975-09-26/75-58#art_786> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_786" ;
    dzdoc:fullText "إذا أقام أجنبي منشآت بمواد من عنده بعد الترخيص له من مالك الأرض فلا يجوز لمالك الأرض أن يطلب إزالة المنشآت إذا لم يوجد اتفاق في شأنها ، و يجب عليه أن يدفع للغير إذا لم يطلب هذا الأجر نزعها إحدى القيمتين المنصوص عليهما في الفقرة الأولى من المادة 785 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_786_permission_0_01a9fd5f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_786> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_786_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_786_19750926_OpEnact_ac97f50070> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_786_obligation_0_456d3195> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 786" ;
    dzdoc:position 837 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_785> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_786_condition_0_63fa2028>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_786_condition_1_01b47bf2> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "يجوز للمتعاقد الذي وقع في غلط جوهري وقت إبرام العقد، أن يطلب ابطاله ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_81_permission_0_244ca356> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_81_right_0_54c2a940> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_81_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_81_19750926_OpEnact_f6d88f4ece> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 81" ;
    dzdoc:position 88 ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:error .

<https://legal.dz/resource/order/1975-09-26/75-58#art_817> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_817" ;
    dzdoc:fullText "يجوز لحائز العقار إذا فقد حيازته أن يطلب خلال السنة التالية لفقدها، ردها إليه فإذا كان فقد الحيازة خفية بدأ سريان السنة من وقت انكشاف ذلك. ويجوز أيضا أن يسترد الحيازة من كان حائزا بالنيابة من غيره ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_817_permission_0_238f8fef> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_817_right_0_ddf858a5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_817_right_1_5cb575c6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_817> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_817_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_817_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_817_19750926_OpEnact_0432097637> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 817" ;
    dzdoc:position 868 ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_840> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_840" ;
    dzdoc:fullText "يجوز لمن تلقى الحيازة من مالك أو حائز سابق وأثبت أنه دفع إليه ما أنفق من المصاريف أن يطالب بها من يسترد الشيء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_840_permission_0_52bb8b18> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_840_right_0_698f8886> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_840> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_840_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_840_19750926_OpEnact_6e7fcfde58> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "840" ;
    dzdoc:position 891 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_870> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_870" ;
    dzdoc:fullText "إذا فرضت قيود معينة تحد من حق مالك العقار في البناء عليه كيف شاء كان يمنع من تجاوز حد معين في الارتفاق بالبناء أو في مساحة رقعته فإن هذه القيود تكون حقوق ارفاق على هذا العقار لفائدة العقارات المجاورة التي فرضت لمصلحتها هذه القيود هذا ما لم يكن هناك اتفاق يخالف ذلك. وكل مخالفة لهذه القيود قد تجعل محلا للمطالبة بإصلاحها عينا الا انه يجوز الاقتصار على الحكم بالتعويض إذا اقتضى رأي المحكمة اختيار هذه الطريقة للتعويض."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_870_permission_0_94df8b07> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_870> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_870_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_870_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_870_19750926_OpEnact_b58db98a4c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_870_prohibition_0_4788c693> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "870" ;
    dzdoc:position 921 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_870_condition_0_3317cf70> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_872> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_872" ;
    dzdoc:fullText "لمالك العقار المرتفق أن يجري من الأعمال ما هو ضروري لاستعمال حقه في الارتفاق ويحفظه ، و يجب عليه أن يباشر هذا الحق على الوجه الذي ينشأ عنه أخف الضرر للعقار المرتفق به ولا يجوز أن يترتب على ما يوجد من حاجات العقار المرتفق أي زيادة في عبء الارتفاق."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_872_permission_0_363fc3ff> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_872_right_0_5d62b7c1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_872> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_872_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_872_19750926_OpEnact_3381b85652> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_872_obligation_0_0dc83713> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "872" ;
    dzdoc:position 923 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_910> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_910" ;
    dzdoc:fullText "يمكن للدائن المرتهن أن ينزل عن مرتبة رهنه في حدود الدين المضمون بهذا الرهن لمصلحة دائن آخر له رهن مقيد على نفس العقار ويجوز التمسك تجاه هذا الدائن الآخر بجميع أوجه الدفع التي يجوز التمسك بها تجاه الدائن الأول عدا ما كان منها متعلقا بانقضاء حق هذا الدائن الأول إذا كان هذا الانقضاء لاحقا للتنازل عن المرتبة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_910_permission_0_11b67431> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_910_right_0_53e46845> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_910> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_910_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_910_19750926_OpEnact_6df243fc54> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 910" ;
    dzdoc:position 961 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_910_condition_0_2d59ab89> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_919> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_919" ;
    dzdoc:fullText "يكون الطلب بإعلان يوجه إلى الحائز والى المالك السابق ويوقعه الطالب أو من أسند إليه في ذلك توكيل خاص، و يجب أن يودع الطالب الخزينة العامة مبلغا كافيا لتغطية مصاريف البيع بالمزاد ، وليس له حق في استرداد ما استغرق منه في المصاريف إذا لم يرس المزاد بثمن أعلى من المبلغ الذي عرضه الحائز ويؤدي عدم استيفاء شرط من هذه الشروط إلى بطلان الطلب. لا يجوز للطالب أن يتنحى عن طلبه إلا بموافقة جميع الدائنين المقيدين وجميع الكفلاء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_919_permission_0_9a56f595> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_919> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_919_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_919_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_919_19750926_OpEnact_6605cf8168> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_919_obligation_0_7f46398e> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_919_prohibition_0_9a56f595> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "919" ;
    dzdoc:position 970 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_919_condition_0_c94b1e8a> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_940> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_940" ;
    dzdoc:fullText "لا يجوز أخذ حق التخصيص إلا على عقار أو عقارات معينة مملوكة للمدين وقت قيد هذا الحق وجائز بيعها بالمزاد العلني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_940_permission_0_f409f19e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_940> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_940_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_940_19750926_OpEnact_9210c24407> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_940_obligation_0_6a444fd0> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_940_prohibition_0_f409f19e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 940" ;
    dzdoc:position 991 ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:right_of_allocation .

