<https://legal.dz/resource/order/1975-09-26/75-58#version_art_982> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الامتياز أولوية يقررها القانون لدين معين مراعاة منه لصفته. ولا يكون للدين امتياز الا بمقتضى نص قانوني."@ar ;
