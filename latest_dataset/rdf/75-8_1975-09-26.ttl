<https://legal.dz/resource/order/1975-09-26/75-58#version_art_278> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان المدين ملزما بالوفاء بالمصاريف زيادة على الدائن الأصلي وكان ما أداه لا يفي بالدين مع هذه الملحقات، خصم ما أدى من حساب المصاريف ثم من أصل الدين ما لم يتفق على غير ذلك."@ar ;
