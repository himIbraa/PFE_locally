<https://legal.dz/resource/order/1975-09-26/75-58#version_art_886> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز أن ينعقد الرهن إلا على عقار ما لم يوجد نص يقضي بغير ذلك. ويجب أن يكون العقار المرهون مما يصح التعامل فيه وبيعه بالمزاد العلني، وأن يكون معينا بالذات تعيينا دقيقا من حيث طبيعته وموقعه، وأن يرد هذا التعيين إما في عقد الرهن ذاته أو في عقد رسمي لاحق ، وإلا كان الرهن باطلا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_886_19750926_OpEnact_4a93c45d7b> ;
    dzdoc:replacementText "لا يجوز أن ينعقد الرهن إلا على عقار ما لم يوجد نص يقضي بغير ذلك. ويجب أن يكون العقار المرهون مما يصح التعامل فيه وبيعه بالمزاد العلني، وأن يكون معينا بالذات تعيينا دقيقا من حيث طبيعته وموقعه، وأن يرد هذا التعيين إما في عقد الرهن ذاته أو في عقد رسمي لاحق ، وإلا كان الرهن باطلا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
