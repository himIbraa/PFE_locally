<https://legal.dz/resource/order/1975-09-26/75-58#version_art_844> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكسب حق الانتفاع بالتعاقد وبالشفعة وبالتقادم أو بمقتضى القانون . يجوز أن يوصى ب حق الانتفاع لأشخاص متعاقدين إذا كانوا موجودين على قيد الحياة وقت الوصية كما يجوز أن یوصی به للحمل المستكن."@ar ;
