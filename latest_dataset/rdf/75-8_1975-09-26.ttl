<https://legal.dz/resource/order/1975-09-26/75-58#version_art_103> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاد المتعاقدان إلى الحالة التي كانا عليها قبل العقد في حالة بطلان العقد أو إبطاله، فإن كان هذا مستحيلا جاز الحكم بتعويض معادل. غير أنه لا يلزم ناقص الأهلية، إذا أبطل العقد لنقص أهليته، إلا برد ما عاد عليه من منفعة بسبب تنفيذ العقد . يحرم من الاسترداد في حالة بطلان العقد من تسبب في عدم مشروعيته أو كان عالما به."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_103_19750926_OpEnact_22206f3f97> ;
    dzdoc:replacementText "يعاد المتعاقدان إلى الحالة التي كانا عليها قبل العقد في حالة بطلان العقد أو إبطاله، فإن كان هذا مستحيلا جاز الحكم بتعويض معادل. غير أنه لا يلزم ناقص الأهلية، إذا أبطل العقد لنقص أهليته، إلا برد ما عاد عليه من منفعة بسبب تنفيذ العقد . يحرم من الاسترداد في حالة بطلان العقد من تسبب في عدم مشروعيته أو كان عالما به."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_103> ;
