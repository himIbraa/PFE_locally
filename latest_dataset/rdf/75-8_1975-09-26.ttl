<https://legal.dz/resource/order/1975-09-26/75-58#art_123_condition_0_6325c607> a dznorm:Condition ;
    dznorm:conditionText "إذا كانت الالتزامات المتقابلة مستحقة الوفاء"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_123> ;
    dzdoc:position 0 ;
    dzdoc:text "في العقود الملزمة للجانبين إذا كانت الالتزامات المتقابلة مستحقة الوفاء جاز لكل من المتعاقدين أن يمتنع عن تنفيذ التزامه إذا لم يقم المتعاقد الآخر بتنفيذ ما التزم به."@ar .

