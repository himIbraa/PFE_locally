<https://legal.dz/resource/order/1975-09-26/75-58#art_910_condition_0_2d59ab89> a dznorm:Condition ;
    dznorm:conditionText "إذا كان هذا الانقضاء لاحقا للتنازل عن المرتبة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_910> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_910_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_910> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن للدائن المرتهن أن ينزل عن مرتبة رهنه في حدود الدين المضمون بهذا الرهن لمصلحة دائن آخر له رهن مقيد على نفس العقار ويجوز التمسك تجاه هذا الدائن الآخر بجميع أوجه الدفع التي يجوز التمسك بها تجاه الدائن الأول عدا ما كان منها متعلقا بانقضاء حق هذا الدائن الأول إذا كان هذا الانقضاء لاحقا للتنازل عن المرتبة."@ar .

