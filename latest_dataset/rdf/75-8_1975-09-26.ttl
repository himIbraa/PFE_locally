<https://legal.dz/resource/order/1975-09-26/75-58#version_art_219> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للدائنين المتضامنين، مجتمعين أو منفردين، مطالبة المدين بالوفاء على أن يراعى في ذلك ما يلحق رابطة كل دائن من وصف. ولا يجوز للمدين إذا طالبه أحد الدائنين المتضامنين بالوفاء أن يعارضه بأوجه الدفع الخاصة بغيره من الدائنين، ولكن يجوز له أن يعارض الدائن المطالب بأوجه الدفع الخاصة به ، وبالتالي يشترك فيها جميع الدائنين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_219_19750926_OpEnact_fba46244d4> ;
    dzdoc:replacementText "يجوز للدائنين المتضامنين، مجتمعين أو منفردين، مطالبة المدين بالوفاء على أن يراعى في ذلك ما يلحق رابطة كل دائن من وصف. ولا يجوز للمدين إذا طالبه أحد الدائنين المتضامنين بالوفاء أن يعارضه بأوجه الدفع الخاصة بغيره من الدائنين، ولكن يجوز له أن يعارض الدائن المطالب بأوجه الدفع الخاصة به ، وبالتالي يشترك فيها جميع الدائنين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
