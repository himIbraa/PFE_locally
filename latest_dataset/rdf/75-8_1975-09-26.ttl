<https://legal.dz/resource/order/1975-09-26/75-58#version_art_564> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للمقاول أن يوكل تنفيذ العمل في جملته أو في جزء منه إلى مقاول فرعي إذا لم يمنعه من ذلك شرط في العقد أو لم تكن طبيعة العمل تفرض الاعتماد على كفاءته الشخصية . ولكن يبقى في هذه الحالة مسؤولا عن المقاول الفرعي تجاه رب العمل ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_564_19750926_OpEnact_9ecb462bdc> ;
    dzdoc:replacementText "يجوز للمقاول أن يوكل تنفيذ العمل في جملته أو في جزء منه إلى مقاول فرعي إذا لم يمنعه من ذلك شرط في العقد أو لم تكن طبيعة العمل تفرض الاعتماد على كفاءته الشخصية . ولكن يبقى في هذه الحالة مسؤولا عن المقاول الفرعي تجاه رب العمل ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_564> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_564> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
