<https://legal.dz/resource/order/1975-09-26/75-58#version_art_842> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان الحائز حسن النية وانتفع بالشيء وفقا لما يحسبه من حقه فلا يكون مسؤولا تجاه من هو ملزم برد الشيء إليه عن أي تعويض بسبب هذا الانتفاع. ولا يكون الحائز مسؤولا عما يصيب الشيء من هلاك أو تلف الا بقدر ما عاد عليه من فائدة ترتبت عن هذا الهلاك أو التلف"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_842_19750926_OpEnact_c74df7f5ea> ;
    dzdoc:replacementText "إذا كان الحائز حسن النية وانتفع بالشيء وفقا لما يحسبه من حقه فلا يكون مسؤولا تجاه من هو ملزم برد الشيء إليه عن أي تعويض بسبب هذا الانتفاع. ولا يكون الحائز مسؤولا عما يصيب الشيء من هلاك أو تلف الا بقدر ما عاد عليه من فائدة ترتبت عن هذا الهلاك أو التلف"@ar ;
