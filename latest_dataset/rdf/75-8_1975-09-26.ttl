<https://legal.dz/resource/order/1975-09-26/75-58#art_841_condition_0_3ec0a488> a dznorm:Condition ;
    dznorm:conditionText "بشرط تقديم الضمانات اللازمة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_841> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_841_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_841> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للقاضي بناء على طلب المالك أن يختار ما يراه مناسبا للوفاء بالمصاريف المنصوص عليها في المادتين 839 و 840 وله أيضا أن يقدر بأن يكون الوفاء على أقساط دورية بشرط تقديم الضمانات اللازمة، وللمالك أن يتحلل من هذا الالتزام إذا سبق مبلغا يساوي قيمة هذه الاقساط."@ar .

