<https://legal.dz/resource/order/1975-09-26/75-58#art_1002> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_1002" ;
    dzdoc:fullText "لا تطبق مدة التقادم المحددة في هذا القانون إلا على الوقائع التي ترد بعد نشر هذا الأمر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1002> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_1002_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1002_19750926_OpEnact_14fa8f077b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "1002" ;
    dzdoc:position 1053 ;
    dzdoc:usesTerm dzterm:limitation_period .

<https://legal.dz/resource/order/1975-09-26/75-58#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "ينصرف العقد إلى المتعاقدين والخلف العام، ما لم يتبين من طبيعة التعامل، أو من نص القانون، أن هذا الأثر لا ينصرف إلى الخلف العام كل ذلك مع مراعاة القواعد المتعلقة بالميراث."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_108_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_108_19750926_OpEnact_a172869897> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 108" ;
    dzdoc:position 115 ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
