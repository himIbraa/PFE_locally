<https://legal.dz/resource/order/1975-09-26/75-58#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا صدر التدليس من غير المتعاقدين ، فليس للمتعاقد المدلس عليه أن يطلب إبطال العقد، ما لم يثبت أن المتعاقد الآخر كان يعلم ، أو كان من المفروض حتما أن يعلم بهذا التدليس ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_87_19750926_OpEnact_330893e8c2> ;
