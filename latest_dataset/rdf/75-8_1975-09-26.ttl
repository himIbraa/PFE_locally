    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_917> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على الحائز أن يذكر في نفس الاعلان أنه مستعد أو يوفي الديون المقيدة إلى القدر الذي قوم به العقار"@ar ;
    dznorm:sourceArticle "art_917" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_917_obligation_0_692a6845_action_c01b00420b> a dznorm:Action ;
    rdfs:label "أن يذكر في نفس الاعلان"@ar ;
