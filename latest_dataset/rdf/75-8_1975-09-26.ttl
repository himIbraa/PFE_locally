<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1000> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المبالغ المستحقة للمقاولين والمهندسين المعماريين الذين عهد إليهم بتشييد أبنية أو منشآت أخرى في إعادة تشييدها أو في ترميمها أو في صيانتها، يكون لها امتياز على هذه المنشآت، ولكن بقدر ما يكون زائدا بسبب هذه الأعمال في قيمة العقار وقت بيعه. ويجب أن يقيد الامتياز ، وتكون مرتبته من وقت القيد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1000_19750926_OpEnact_b8bef587e6> ;
    dzdoc:replacementText "المبالغ المستحقة للمقاولين والمهندسين المعماريين الذين عهد إليهم بتشييد أبنية أو منشآت أخرى في إعادة تشييدها أو في ترميمها أو في صيانتها، يكون لها امتياز على هذه المنشآت، ولكن بقدر ما يكون زائدا بسبب هذه الأعمال في قيمة العقار وقت بيعه. ويجب أن يقيد الامتياز ، وتكون مرتبته من وقت القيد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_1000> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
