<https://legal.dz/resource/order/1975-09-26/75-58#art_415> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_2> ;
    dzdoc:eId "art_415" ;
    dzdoc:fullText "تسري على المقايضة أحكام البيع بالقدر الذي تسمح به طبيعة المقايضة ، ويعتبر كل من المتقايضين بائعا للشيء ومشتريا للشيء الذي قايض عليه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_415> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_415_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_415_19750926_OpEnact_bc5b4a4293> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 415" ;
    dzdoc:position 439 ;
    dzdoc:usesTerm dzterm:barter .

<https://legal.dz/resource/order/1975-09-26/75-58#art_449> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_5> ;
    dzdoc:eId "art_449" ;
    dzdoc:fullText "لا تطبق مقتضيات هذا الفصل على الشركات التجارية الا فيما يخالف القوانين التجارية والعرف التجاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_449> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_449_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_449_19750926_OpEnact_c4ab563063> ;
