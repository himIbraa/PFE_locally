    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبرأ ذمة الكفيل بالقدر الذي أضاعه الدائن بخطئه من الضمانات . ويقصد بالضمانات في هذه المادة كل التأمينات المخصصة لضمان الدين ولو تقررت بعد الكفالة وكذلك كل التأمينات المقررة بحكم القانون ."@ar ;
