<https://legal.dz/resource/order/1975-09-26/75-58#version_art_292> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قدم المدين تأمينات حقيقية لكفالة الالتزام القديم فإن الاتفاق على نقل هذه التأمينات إلى الالتزام الجديد تراعى فيه الأحكام الآتية : إذا كان التجديد بتغيير الدين جاز للدائن وللمدين الاتفاق على انتقال التأمينات للالتزام الجديد، في الحدود التي لا تلحق ضررا بالغير، إذا كان التجديد بتغيير المدين جاز للدائن وللمدين الجديد الاتفاق على استبقاء التأمينات العينية دون حاجة إلى رضا المدين القديم، إذا كان التجديد بتغيير الدائن جاز للاطراف الثلاثة المتعاقدين الاتفاق على استبقاء التأمينات. ولا يكون الاتفاق ع"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_292_19750926_OpEnact_61c3549c6a> ;
    dzdoc:replacementText "إذا قدم المدين تأمينات حقيقية لكفالة الالتزام القديم فإن الاتفاق على نقل هذه التأمينات إلى الالتزام الجديد تراعى فيه الأحكام الآتية : إذا كان التجديد بتغيير الدين جاز للدائن وللمدين الاتفاق على انتقال التأمينات للالتزام الجديد، في الحدود التي لا تلحق ضررا بالغير، إذا كان التجديد بتغيير المدين جاز للدائن وللمدين الجديد الاتفاق على استبقاء التأمينات العينية دون حاجة إلى رضا المدين القديم، إذا كان التجديد بتغيير الدائن جاز للاطراف الثلاثة المتعاقدين الاتفاق على استبقاء التأمينات. ولا يكون الاتفاق على انتقال التأمينات العينية نافذا في حق الغير، الا إذا تم مع التجديد في وقت واحد، مع مراعاة الأحكام المتعلقة بالتسجيل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_292> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_292> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_293> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تنتقل الكفالة العينية، أو الشخصية، ولا التضامن إلى الالتزام الجديد الا إذا رضي بذلك الكفلاء والمدينون المتضامنون."@ar ;
