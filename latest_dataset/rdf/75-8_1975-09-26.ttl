    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_602_19750926_OpEnact_67da150464> ;
    dzdoc:replacementText "الحراسة الاتفاقية هو إيداع شيء متنازع فيه من طرف شخص أو عدة أشخاص بين أيدي شخص آخر يلتزم بإعادته بعد فض المنازعة إلى الشخص الذي يثبت له الحق فيه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
