<https://legal.dz/resource/order/1975-09-26/75-58#art_206_condition_0_a0852f57_role_dc2b6e76e9> a dznorm:Role ;
    rdfs:label "شرط واقف"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "إذا كان الالتزام معلقا على شرط واقف"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_206> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_206_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_206> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان الالتزام معلقا على شرط واقف، فلا يكون نافذا الا إذا تحقق الشرط اما قبل تحقق الشرط، فلا يكون الالتزام قابلا للتنفيذ الجبري، ولا للتنفيذ الاختياري، على انه يجوز للدائن أن يتخذ من الاجراءات ما يحافظ به على حقه."@ar .

