<https://legal.dz/resource/order/1975-09-26/75-58#version_art_824> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يفرض حسن النية لمن يحوز حقا وهو يجهل انه يتعدى على حق الغير الا إذا كان هذا الجهل ناشئا عن خطأ جسيم . وإذا كان الحائز شخصا معنويا فالعبرة بنية من يمثله. ويفترض حسن النية دائما حتى يقوم الدليل على العكس."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_824_19750926_OpEnact_e55b0f5c61> ;
