    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_643> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ملغاة"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_644_19750926_OpEnact_d48cf8c285> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_644> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_644> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_644> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "المادة 644 : الكفالة عقد يكفل بمقتضاه شخص تنفيذ التزام بأن يتعهد للدائن بأن يفي بهذا الالتزام إذا لم يف به المدين نفسه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_645_19750926_OpEnact_464e61ce94> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_645> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_645> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_645> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تثبت الكفالة الا بالكتابة ، ولو كان من الجائز اثبات الالتزام الأصلي بالبينة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_646_19750926_OpEnact_0c6cd40d3f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_646> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_646> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_646> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا التزم المدين بتقديم كفيل ، وجب أن يقدم شخصا موسرا ومقيما بالجزائر ، وله أن يقدم عوضا عن الكفيل، تأمينا عينيا كافيا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_647_19750926_OpEnact_719ad76980> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_647> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_647> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_647> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تجوز كفالة المدين بغير علمه، وتجوز أيضا رغم معارضته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_648_19750926_OpEnact_b416adae0b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_648> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_648> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_648> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تكون الكفالة صحيحة الا إذا كان الالتزام المكفول صحيحا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_649_19750926_OpEnact_4d39166e89> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_649> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_649> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_649> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "من كفل التزام ناقص الأهلية وكانت الكفالة بسبب نقص الأهلية ، كان ملزما بتنفيذ الالتزام إذا لم ينفذه المدين المكفول ، باستثناء الحالة المنصوص عليها في الفقرة الثانية من المادة 654 ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_64_19750926_OpEnact_b8a28ba2fb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_64> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_64> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا صدر الايجاب في مجلس العقد لشخص حاضر دون تحديد أجل القبول فإن الموجب يتحلل من ايجابه إذا لم يصدر القبول فورا وكذلك إذا صدر الايجاب من شخص إلى آخر بطريق الهاتف أو بأي طريق مماثل. غير أن العقد يتم، ولو لم يصدر القبول فورا، إذا لم يوجد ما يدل على أن الموجب قد عدل عن ايجابه في الفترة ما بين الايجاب والقبول، وكان القبول صدر قبل أن ينفض مجلس العقد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_650_19750926_OpEnact_af7b3dd360> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_650> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_650> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_650> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تجوز الكفالة في الدين المستقبل إذا حدد مقدما المبلغ المكفول ، كما تجوز الكفالة في الدين المشروط. غير أنه إذا كان الكفيل في الدين المستقبل لم يعين مدة الكفالة ، كان له أن يراجع فيها في أي وقت ما دام الدين المكفول لم ينشأ ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_651_19750926_OpEnact_d8df000302> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_651> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_651> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_651> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تعتبر كفالة الدين التجاري عملا مدنيا ولو كان الكفيل تاجرا. غير أن الكفالة الناشئة عن ضمان الأوراق التجارية ضمانا احتياطيا، أو عن تظهير هذه الأوراق، تعتبر دائما عملا تجاريا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_652_19750926_OpEnact_f2ff4f49c1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_652> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_652> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_652> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تجوز الكفالة في مبلغ أكبر مما هو مستحق على المدين ولا بشرط أشد من شروط الدين المكفول . ولكن تجوز الكفالة في مبلغ أقل وبشرط أهون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_653_19750926_OpEnact_3e36805b1a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_653> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_653> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_653> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا لم يكن هناك اتفاق خاص ، فإن الكفالة تشمل ملحقات الدين، ومصروفات المطالبة الأولى وما يستجد من المصروفات بعد إخطار الكفيل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_654_19750926_OpEnact_66405cb9de> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_654> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_654> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_654> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يبرأ الكفيل بمجرد براءة المدين ، وله أن يتمسك بجميع الأوجه التي يحتج بها المدين . غير أنه إذا كان الوجه الذي يحتج به المدين يتمثل في نقص أهليته وكان الكفيل عالما بذلك وقت التعاقد ، فليس له أن يحتج بهذا الوجه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_655_19750926_OpEnact_f6ee5d8ee1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_655> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_655> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_655> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا قبل الدائن شيئا آخر في مقابل الدين برئت بذلك ذمة الكفيل ولو استحق هذا الشيء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_656_19750926_OpEnact_dc5898e462> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_656> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_656> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_656> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تبرأ ذمة الكفيل بالقدر الذي أضاعه الدائن بخطئه من الضمانات . ويقصد بالضمانات في هذه المادة كل التأمينات المخصصة لضمان الدين ولو تقررت بعد الكفالة وكذلك كل التأمينات المقررة بحكم القانون ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_657_19750926_OpEnact_2a5c0c89e4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_657> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_657> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_657> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تبرأ ذمة الكفيل بسبب تأخر الدائن في اتخاذ الاجراءات أو لمجرد أنه يتخذها. غير أن ذمة الكفيل تبرأ إذا لم يقم الدائن باتخاذ الاجراءات ضد المدين خلال ستة (6) أشهر من انذار الكفيل للدائن ما لم يقدم المدين للكفيل ضمانا كافيا ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_658_19750926_OpEnact_07de411c01> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_658> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_658> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_658> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا أفلس المدين وجب على الدائن أن يتقدم بدينه في التفليسة ، والا سقط حقه في الرجوع على الكفيل بقدر ما أصاب هذا الأخير من ضرر سبب إهمال الدائن ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_659_19750926_OpEnact_468544cc99> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_659> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_659> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_659> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تجوز كفالة الكفيل ، وفي هذه الحالة لا يحوز المستندات اللازمة لاستعمال حقه في الرجوع. فإذا كان الدين مضمونا بمنقول مرهون أو محبوس وجب على الدائن أن يتخلى عنه للكفيل . أما إذا كان الدين مضمونا بتأمين عقاري ، فإن الدائن يلتزم بالاجراءات اللازمة لنقل هذا التأمين ، و يتحمل الكفيل مصروفات هذا النقل على أن يرجع بها على المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_65_19750926_OpEnact_ba50141104> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا اتفق الطرفان على جميع المسائل الجوهرية في العقد واحتفظا بمسائل تفصيلية يتفقان عليها فيما بعد ولم يشترطا أن لا أثر للعقد عند عدم الاتفاق عليها ، اعتبر العقد منبرما وإذا قام خلاف على المسائل التي لم يتم الاتفاق عليها، فإن المحكمة تقضي فيها طبقا لطبيعة المعاملة ولأحكام القانون، والعرف، والعدالة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_660_19750926_OpEnact_46a97d0443> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_660> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_660> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_660> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للدائن أن يرجع على الكفيل وحده الا بعد رجوعه على المدين . ولا يجوز له أن ينفذ على أموال الكفيل الا بعد أن يجرد المدين من أمواله، و يجب على الكفيل في هذه الحالة أن يتمسك بهذا الحق ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_661_19750926_OpEnact_f327bc2bc9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_661> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_661> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_661> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا طلب الكفيل التجريد ، وجب عليه أن يقوم على نفقته بارشاد الدائن إلى أموال المدين تفي بالدين كله . ولا يؤخذ بعين الاعتبار الأموال التي يدل عليها الكفيل إذا كانت هذه الأموال تقع خارج الأراضي الجزائرية، أو كانت متنازعا فيها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_662_19750926_OpEnact_18c4bf115b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_662> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_662> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_662> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الدائن في كل الأحوال التي يدل فيها الكفيل على أموال المدين ، مسؤولا تجاه الكفيل عن إعسار المدين الذي يترتب عن عدم اتخاذه الاجراءات اللازمة في الوقت المناسب."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_663_19750926_OpEnact_164ae20821> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_663> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_663> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_663> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان هناك تأمين عيني خصص قانونا أو اتفاقا لضمان الدين وقدمت كفالة بعد هذا التأمين أو معه ولم يكن الكفيل متضامنا مع المدين ، فلا يجوز التنفيذ على أموال الكفيل الا بعد التنفيذ على الأموال التي خصصت لهذا التأمين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_664_19750926_OpEnact_3bee9f9fdd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_664> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_664> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_664> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعدد الكفلاء لدين واحد، وبعقد واحد، وكانوا غير متضامنين فيما بينهم قسم الدين عليهم، ولا يجوز للدائن أن يطالب كل كفيل الا بقدر نصيبه في الكفالة. أما إذا كان الكفلاء قد التزموا بعقود متوالية ، فإن كل واحد منهم يكون مسؤولا عن الدين كله، الا إذا كان قد احتفظ لنفسه بحق التقسية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_665_19750926_OpEnact_d8bb17ee9a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_665> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_665> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_665> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للكفيل المتضامن مع المدين أن يطلب التجريد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_666_19750926_OpEnact_a30469cb4e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_666> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_666> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_666> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز للكفيل المتضامن أن يتمسك بما يتمسك به الكفيل غير المتضامن من دفوع متعلقة بالدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_667_19750926_OpEnact_2d864ff964> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_667> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_667> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_667> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الكفلاء في الكفالة القضائية أو القانونية دائما متضامنين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_668_19750926_OpEnact_9b31b7f435> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_668> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_668> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_668> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كان الكفلاء متضامنين فيما بينهم ووفي أحدهم الدين عند حلوله يجوز له أن يرجع على كل من الباقين بحصته في الدين وبنصيبه في حصة المعسر منهم ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_669_19750926_OpEnact_6f59fe38ec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_669> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_669> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_669> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تجوز كفالة الكفيل ، وفي هذه الحالة لا يجوز للدائن أن يرجع على كفيل قبل رجوعه على الكفيل الا إذا كان كفيل الكفيل متضامنا مع الكفيل ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_66_19750926_OpEnact_c77957f123> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_66> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_66> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_66> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يعتبر القبول الذي يغير الايجاب إلا ايجابا جديدا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_670_19750926_OpEnact_c03914ca61> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_670> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_670> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_670> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على الكفيل أن يخبر المدين قبل أن يقوم بوفاء الدين ، والا سقط حقه في الرجوع على المدين إذا كان هذا قد وفي الدين أو كانت عنده وقت الاستحقاق أسباب تقضي ببطلان الدين أو بانقضائه . فإذا لم يعارض المدين في الوفاء بقي للكفيل الحق في الرجوع عليه ولو كان المدين قد دفع الدين أو كانت لديه أسباب تقضي ببطلانه أو بانقضائه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_671_19750926_OpEnact_1ddb2c07ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_671> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_671> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_671> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وفي الكفيل الدين ، كان له أن يحل محل الدائن في جميع ما له من حقوق تجاه المدين . ولكن إذا لم يوف الا بعض الدين ، فلا يرجع بما وفاه الا بعد أن يستوفي الدائن كل حقه من المدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_672_19750926_OpEnact_81e5aeeebe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_672> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_672> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_672> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون للكفيل الذي وفي الدين أن يرجع على المدين سواء كانت الكفالة قد عقدت بعلمه أو بغيرعلمه ويرجع بأصل الدين والمصروفات غير أنه فيما يخص المصروفات لا يرجع الكفيل الا بالذي دفعه من وقت إخبار المدين الأصلي بالاجراءات التي اتخذت ضده."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_673_19750926_OpEnact_12f753a45f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_673> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_673> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_673> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعدد المدينون في دين واحد وكانوا متضامنين فللكفيل الذي ضمنهم جميعا أن يرجع على أي منهم بجميع ما وفاه من الدين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_674_19750926_OpEnact_f120fc69a4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_674> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_674> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_674> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الملكية هي حق المتمتع والتصرف في الأشياء بشرط أن لا يستعمل استعمالا تحرمه القوانين والأنظمة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_675_19750926_OpEnact_866d0a3b4f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_675> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_675> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_675> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "مالك الشيء يملك كل ما يعد من عناصرها الجوهرية بحيث لا يمكن فصله عنه دون أن يفسد أو يتلف أو يتغير. وتشمل ملكية الأرض ما فوقها وما تحتها إلى الحد المفيد في التمتع بها علوا وعمقا. ويجوز بمقتضى القانون أو الاتفاق أن تكون ملكية سطح الأرض منفصلة عن ملكية ما فوقها أو ما تحتها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_676_19750926_OpEnact_b34cc12c19> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_676> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_676> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_676> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لمالك الشيء الحق في كل ثماره ومنتجاته وملحقاته ما لم يوجد نص أو اتفاق يخالف ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_677_19750926_OpEnact_52387e52a5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_677> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_677> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_677> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز حرمان أي أحد من ملكيته الا في الأحوال والشروط المنصوص عليها في القانون. غير أن للإدارة الحق في نزع جميع الملكية العقارية أو بعضها ، أو نزع الحقوق العينية العقارية للمنفعة العامة مقابل تعويض منصف وعادل. وإذا وقع خلاف في مبلغ التعويض وجب أن يحدد هذا المبلغ بحكم قضائي الا أن تحديد مبلغ التعويض يجب أن لا يشكل بأي حال مانعا لحيازة الأملاك المنتزعة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_678_19750926_OpEnact_97586efb05> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_678> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_678> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_678> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز إصدار حكم التأميم الا بنص قانوني على أن الشروط وإجراءات نقل الملكية والكيفية التي يتم بها التعويض يحددها القانون."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_679_19750926_OpEnact_f073680cf1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_679> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_679> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_679> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتم الحصول على الأموال والخدمات لضمان سير المرافق العمومية باتفاق رضائي وفق الحالات والشروط المنصوص عليها في القانون. إلا أنه يمكن في الحالات الاستثنائية والاستعجالية وضمانا لاستمرارية المرفق العمومي ، الحصول على الأموال والخدمات عن طريق الاستيلاء. ولا يجوز الاستيلاء بأي حال على المحلات المخصصة فعلا للسكن ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_67_19750926_OpEnact_509b6da742> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر التعاقد ما بين الغائبين قد تم في المكان وفي الزمان اللذين يعلم فيهما الموجب بالقبول، ما لم يوجد اتفاق أو نص قانوني يقضي بغير ذلك. ويفترض أن الموجب قد علم بالقبول في المكان، وفي الزمان اللذين وصل إليه فيهما القبول."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_680_19750926_OpEnact_611a0b585a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_680> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_680> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_680> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتم الاستيلاء بصفة فردية أو جماعية ويكون كتابيا. يوقع الأمر من طرف الوالي أو كل سلطة مؤهلة قانونا ويوضح فيه إذا كان الاستيلاء بقصد الحصول على الأموال أو الخدمات، ويبين طبيعة وصفة و/أو مدة الخدمة وعند الاقتضاء مبلغ وطرق دفع التعويض و/أو الأجر."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_19750926_OpEnact_3078852230> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_681> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_681> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ينفذ الاستيلاء مباشرة أو من قبل رئيس المجلس الشعبي البلدي. ويمكن في الحالات التي تقتضي ذلك ، تنفيذه بالقوة بطريقة إدارية دون الاخلال بالعقوبات المدنية والجزائية التي أقرها التشريع المعمول به."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_1_19750926_OpEnact_c7ada99335> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في حالة وجود حيازة من طرف المستفيد من الاستيلاء ، يكون هذا الاستيلاء مسبوقا بجرد . وبنفس الطريقة يترتب عن استعادة الحيازة من طرف المستفيد إعداد جرد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_2_19750926_OpEnact_22102b411d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يحدد تعويض الاستيلاء باتفاق بين الأطراف. وفي حالة عدم الاتفاق يحدد مبلغ التعويض عن طريق القضاء مع مراعاة ظروف وغرض الاستيلاء دون أن يتضرر المستفيد. كما يمكن منح التعويض في حالة تسبب المستفيد من الاستيلاء في نقص القيمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_3_19750926_OpEnact_1c3865818d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_3> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_681_bis_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعد تعسفيا كل استيلاء تم خارج نطاق الحالات والشروط المحددة قانونا وأحكام المادة 679 وما يليها أعلاه ، ويمكن أن يترتب عليه، زيادة على العقوبات الأخرى المنصوص عليها في التشريع المعمول به دفع تعويض يصدر عن طريق القضاء . يتعلق هذا التعويض بإصلاح الضرر المتسبب ومكافأة العمل والرأسمال وكذا بتعويض كل نقص في الربح."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_682_19750926_OpEnact_d197866ab0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_682> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_682> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_682> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل شيء غير خارج عن التعامل بطبيعته أو بحكم القانون يصلح أن يكون محلا للحقوق المالية. والأشياء التي تخرج عن التعامل بطبيعتها هي التي لا يستطيع أحد أن يستأثر بحيازتها وأما الخارجة بحكم القانون فهي التي يجيز القانون أن تكون محلا للحقوق المالية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_683_19750926_OpEnact_4cd21997eb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_683> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_683> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_683> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل شيء مستقر بحيزه وثابت فيه ولا يمكن نقله منه دون تلف فهو عقار ، وكل ما عدا ذلك من شيء فهو منقول . غير أن المنقول الذي يضعه صاحبه في عقار يملكه، رصدا على خدمة هذا العقار أو استغلاله يعتبر عقارا بالتخصيص ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_684_19750926_OpEnact_89c138b923> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_684> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_684> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_684> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر مالا عقاريا كل حق عيني يقع على عقار، بما في ذلك حق الملكية، وكذلك كل دعوى تتعلق بحق عيني على عقار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_685_19750926_OpEnact_a85ce085a0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_685> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_685> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_685> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الأشياء القابلة للاستهلاك هي التي ينحصر استعمالها بحسب ما أعدت له، في استهلاكها أو انفاقها . ويعتبر قابلا للاستهلاك كل شيء يكون جزءا من المحل التجاري وهو معد للبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_686_19750926_OpEnact_1e0bb1a196> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_686> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_686> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_686> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الأشياء المثلية هي التي يقوم بعضها مقام بعض عند الوفاء والتي تقدر عادة في التعامل بين الناس بالعدد، أو المقياس أو الكيل، أو الوزن ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_687_19750926_OpEnact_ffba16c55b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_687> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_687> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_687> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنظم قوانين خاصة الحقوق التي ترد على أشياء غير مادية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_688_19750926_OpEnact_b4d43e169f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_688> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_688> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_688> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تعتبر أموالا للدولة العقارات والمنقولات التي تخصص بالفعل أو بمقتضى نص قانوني لمصلحة عامة، أو لادارة، أو لمؤسسة عمومية أو لهيئة لها طابع إداري، أو لمؤسسة اشتراكية، أو لوحدة مسيرة ذاتيا أو لتعاونية داخلة في نطاق الثورة الزراعية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_689_19750926_OpEnact_e7c7c497ac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_689> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_689> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_689> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز التصرف في أموال الدولة، أو حجزها ، أو تملكها بالتقادم غير أن القوانين التي تخصص هذه الأموال لاحدى المؤسسات المشار إليها في المادة 688 ، تحدد شروط إداراتها، وعند الاقتضاء شروط عدم التصرف فيها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_68_19750926_OpEnact_12b4917e2a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_68> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_68> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_68> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت طبيعة المعاملة، أو العرف التجاري، أو غير ذلك من الظروف، تدل على أن الموجب لم يكن لينتظر تصريحا بالقبول فإن العقد يعتبر قد تم إذا لم يرفض الايجاب في وقت مناسب . ويعتبر السكوت في الرد قبولا ، إذا اتصل الايجاب بتعامل سابق بين المتعاقدين، أو إذا كان الايجاب لمصلحة من وجه إليه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_690_19750926_OpEnact_a41e9b73f7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_690> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_690> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_690> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على المالك أن يراعي في استعمال حقه ما تقضي به التشريعات الجاري بها العمل والمتعلقة بالمصلحة العامة، أو المصلحة الخاصة . وعليه أيضا مراعاة الأحكام الآتية ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_691_19750926_OpEnact_1cbdff343d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_691> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_691> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_691> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على المالك الا يتعسف في استعمال حقه إلى حد يضر بملك الجار . وليس للجار أن يرجع على جاره في مضار الجوار المألوفة غير أنه يجوز له أن يطلب إزالة هذه المضار إذا تجاوزت الحد المألوف وعلى القاضي أن يراعي في ذلك العرف وطبيعة العقارات وموقع كل منها بالنسبة إلى الآخرين والغرض الذي خصصت له."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_692_19750926_OpEnact_62e4e571cf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_692> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_692> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_692> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الأرض ملك لمن يخدمها وتعتبر جميع موارد المياه ملكا للجماعة الوطنية . تحدد اجراءات تطبيق هذه المادة بالنصوص الخاصة بالثورة الزراعية والنصوص المتعلقة بالبحث والتوزيع، واستعمال، واستغلال المياه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_693_19750926_OpEnact_323651fc31> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_693> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_693> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_693> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز لمالك الأرض المحصورة التي ليس لها أي ممر يصلها بالطريق العام أو كان لها ممر ولكنه غير كاف للمرور، أن يطلب حق المرور على الأملاك المجاورة مقابل تعويض يتناسب مع الاضرار التي يمكن أن تحدث من جراء ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_694_19750926_OpEnact_f14fa7c306> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_694> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_694> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_694> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر الممر على الطريق العام غير كاف، أو غير ممكن إذا كان ذلك يكلف مشاق كبيرة لا يمكن تسويتها ببذل أعمال باهظة لا تتناسب مع قيمة العقار . ويعتبر الممر عكس ذلك كافيا إذا كانت الاضرار عارضة يمكن إزالتها بنفقات قليلة، أو إذا وجد الممر على وجه الاباحة ما دام لم يمنع استعماله ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_695_19750926_OpEnact_fe3435a645> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_695> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_695> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_695> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز لمالك الأرض المحصورة أو التي لها ممر كاف على الطريق العام أن يطلب حق المرور على أرض الغير إذا كان الحصر ناتجا عن إرادته هو . وليس له أن يطالب بـ حق المرور إذا كان يتمتع إما بحق المرور على وجه الاتفاق وإما بحق المرور على وجه الاباحة ما دام المرور الاتفاقي لم ينقض بعد، وحق الاباحة لم يزل ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_696_19750926_OpEnact_7fc38894e4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_696> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_696> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_696> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن يؤخذ حق المرور من الجهة التي تكون فيها المسافة بين العقار والطريق العام ملائمة والتي تحقق أقل ضرر بالملاك المجاورين ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_697_19750926_OpEnact_4326bb8fb0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_697> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_697> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_697> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا كانت الأرض المحصورة ناتجة عن تجزئة عقار، بسبب بيع أو مبادلة، أو قسمة، أو من أي معاملة أخرى فلا يطلب حق المرور الا على الأراضي التي تشملها تلك المعاملات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_698_19750926_OpEnact_1346fda2d4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_698> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_698> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_698> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إن القاعدة والكيفية التي يتم بهما ارتفاق حق المرور بسبب الحصر تحددان بـ تقادم خمسة عشرة (15) سنة فإذا اكتملت هذه المدة فلا يجوز لصاحب العقار المحصور تغيير قاعدة الارتفاق، ولا تحويلها أو نقلها من طرف صاحب العقار المرتفق به دون إذن من صاحب العقار المحصور."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_699_19750926_OpEnact_95a0939a26> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_699> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_699> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_699> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "أن حيازة الممر الذي يستعمله صاحب العقار المحصور لمدة خمسة عشرة (15) سنة، يعد بمثابة سند ملكية للارتفاق ويصبح تابعا للعقار الذي أنشئ من أجله وإذا كان ارتفاق المرور قد تقرر بالحيازة لصالح العقار المحصور فإنه لا يزول بتوقف الحصر الذي كان السبب الأصلي فيه عارضا كان، أو نهائيا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_69_19750926_OpEnact_ad3f60f560> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_69> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_69> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_69> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يتم العقد في المزايدات إلا برسم المزاد، ويسقط المزاد بمزاد أعلى ولو كان باطلا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_6_19750926_OpEnact_c2ef561061> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تسري القوانين المتعلقة ب الأهلية على جميع الأشخاص الذين تتوفر فيهم الشروط المنصوص عليها . وإذا صار شخص توفرت فيه الأهلية بحسب النص القديم ناقص الأهلية طبقا للنص الجديد ، فلا يؤثر ذلك على تصرفاته السابقة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_700_19750926_OpEnact_662c77abfd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_700> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_700> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_700> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز لمالك العقار المرتفق به أن يطلب التعويض إذا سكت حتى حصل صاحب الأرض المحصورة بالاستعمال والحيازة على حق المرور بالتقادم لمدة خمسة عشرة (15) سنة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_701_19750926_OpEnact_68f0f0592f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_701> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_701> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_701> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا استحق صاحب العقار المرتفق به تعويضا فإنه يمكن أن يحتوي ذلك التعويض على مبلغ مالي يسدد دفعة واحدة أو على أقساط متساوية تتناسب مع الضرر الناجم من استعمال الممر ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_702_19750926_OpEnact_4193f6d77d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_702> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_702> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_702> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إن ارتفاق المرور في حالة العقار المحصور، ولو كان غير متواصل، تترتب عليه دعوى الحيازة حتى ولو يتم لصاحب العقار المحصور التقادم من حيث القاعدة وكيفية الارتفاق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_703_19750926_OpEnact_8a9a8b8339> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_703> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_703> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_703> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لكل مالك أن يجبر جاره على وضع حدود لأملاكهما المتلاصقة ، و تكون نفقات التحديد مشتركة بينهما ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_704_19750926_OpEnact_b98171b513> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_704> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_704> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_704> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لمالك الحائط المشترك أن يستعمله بحسب الغرض الذي أعد له وأن يضع فوقه عوارض ليسند عليها السقف دون أن يحمل الحائط فوق طاقته . فإذا لم يعد الحائط المشترك صالحا للغرض الذي خصص له فإن نفقة ترميمه، وإعادة بنائه تكون على الشركاء كل بنسبة حصته فيه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_705_19750926_OpEnact_2da3fb4ca2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_705> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_705> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_705> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للمالك إذا كانت له مصلحة جدية في تعلية الحائط المشترك أن يعليه بشرط أن لا يلحق بشريكه ضررا بليغا ، و عليه أن يتحمل وحده نفقة التعلية وصيانة الجزء المعلى وأن يقوم بالأعمال اللازمة لجعل الحائط قادرا على حمل زيادة العبء الناشئ عن التعلية دون أن يفقد شيئا من متانته . فإذا لم يكن الحائط المشترك صالحا لتحمل التعلية فعلى من يرغب فيها من الشركاء أن يعيد بناء الحائط كله على نفقته بحيث يقع ما زاد من سمكه في ناحيته هو بقدر الاستطاعة ، ويظل الحائط المجدد في غير الجزء المعلى مشتركا دون أن يكون للجار الذي أحدث التعلية حق في التعويض."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_706_19750926_OpEnact_caf0515bfb> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_706> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_706> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_706> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يمكن للجار الذي لم يسهم في نفقات التعلية أن يصبح شريكا في الجزء المعلي إذا هو دفع نصف ما انفق عليه وقيمة نصف الأرض التي تقوم عليها زيادة السمك إن كانت هناك زيادة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_707_19750926_OpEnact_2e70a3c25b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_707> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_707> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_707> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعد الحائط الذي يكون في وقت إنشائه فاصلا بين بنائين مشتركا حتى مفرقهما ما لم يقم الدليل على عكس ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_708_19750926_OpEnact_081f7ea6f0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_708> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_708> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_708> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ليس لجار أن يجبر جاره على تحويط ملكه ولا على التنازل عن جزء من حائط أو من الأرض التي يقوم عليها الحائط إلا في الحالة المذكورة في المادة 697 . غير أنه ليس لمالك الحائط أن يهدمه مختارا دون عذر قانوني إن كان هذا يضر الجار الذي يستتر ملكه بالحائط ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_709_19750926_OpEnact_ab5ae168fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_709> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_709> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_709> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز للجار أن يكون له على جاره له مطل مواجه على مسافة تقل عن مترين ، وتقاس المسافة من ظهر الحائط الذي يوجد له المطل أو من الحافة الخارجية للشرفة، أو من النتؤ. وإذا كسب أحد بالتقادم الحق في مطل مواجه لملك الجار على مسافة تقل عن مترين ، فلا يجوز لهذا الجار أن يبني على مسافة تقل عن مترين تقاس بالطريقة السابق بيانها أعلاه ، وذلك على طول البناء الذي فتح فيه المطل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_70_19750926_OpEnact_e02ffe15b4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_70> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_70> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_70> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يحصل القبول في عقد الاذعان بمجرد التسليم لشروط مقررة يضعها الموجب ولا يقبل المناقشة فيها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_710_19750926_OpEnact_08019e785a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_710> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_710> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_710> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز أن يكون لجار على جاره مطل منحرف على مسافة تقل عن ستين (60) سنتيمترا من حرف المطل على أن هذا التحريم يبطل إذا كان هذا المطل المنحرف على العقار المجاور هو في الوقت ذاته مطل مواجه للطريق العام ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_711_19750926_OpEnact_3c895f09d6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_711> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_711> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_711> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا تشترك أية مسافة لفتح المناور ، التي تقام من ارتفاع مترين من أرض الغرفة التي يراد إنارتها . ولا يقصد بها الا مرور الهواء ونفاذ النور، دون أن يمكن الاطلاع منها على العقار المجاور ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_712_19750926_OpEnact_00d0451942> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_712> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_712> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_712> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب أن تنشأ المصانع، والآبار، والآلات البخارية وجميع المؤسسات المضرة بالجيران على المسافات المبينة في اللوائح وبالشروط التي تفرضها ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_713_19750926_OpEnact_2c1696c0d2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_713> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_713> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_713> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ملك اثنان أو أكثر شيئا وكانت حصة كل منهم فيه غير مقررة فهم شركاء على الشيوع وتعتبر الحصص متساوية إذا لم يقم دليل على غير ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_714_19750926_OpEnact_afbeae614c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_714> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_714> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_714> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "كل شريك في الشيوع يملك حصته ملكا تاما، وله أن يتصرف فيها وأن يستولي على ثمارها وأن يستعملها بحيث لا يلحق الضرر بحقوق سائر الشركاء . وإذا كان التصرف منصبا على جزء مفرز من المال الشائع ولم يقع هذا الجزء عند القسمة في نصيب المتصرف انتقل حق المتصرف إليه من وقت التصرف إلى الجزء الذي آل إلى المتصرف بطريق القسمة. وللمتصرف إليه الحق في إبطال التصرف إذا كان يجهل أن المتصرف لا يملك العين المتصرف فيها مفرزة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_715_19750926_OpEnact_921672beac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_715> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_715> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_715> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تكون إدارة المال الشائع من حق الشركاء مجتمعين ما لم يوجد اتفاق يخالف ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_716_19750926_OpEnact_62a9c35f88> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_716> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_716> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_716> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون ملزما للجميع كل ما يستقر عليه رأي أغلبية الشركاء في أعمال الادارة المعتادة ، وتحسب الأغلبية على أساس قيمة الأنصباء. فإن لم توجد أغلبية فللمحكمة بناء على طلب أحد الشركاء، أن تتخذ التدابير اللازمة، ولها أن تعين عند الحاجة من يدير المال الشائع. وللأغلبية أيضا أن تختار مديرا ، كما أن لها أن تضع للادارة ولحسن الانتفاع بالمال الشائع نظاما يسري حتى على خلفاء الشركاء جميعا سواء أكان الخلف عاما، أو خاصا. وإذا تولى أحد الشركاء الادارة دون اعتراض من الباقين عد وكيلا عنهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_717_19750926_OpEnact_6af0639415> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_717> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_717> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_717> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للشركاء الذين يملكون على الأقل ثلاثة أرباع (3/4) المال الشائع، يقرروا في سبيل تحسين الانتفاع بهذا المال من التغييرات الأساسية والتعديل في الغرض الذي أعد له ما يخرج عن حدود الادارة المعتادة على أن يعلنوا قراراتهم إلى باقي الشركاء ولمن خالف من هؤلاء حق الرجوع إلى المحكمة خلال شهرين من وقت الاعلان . وللمحكمة عند الرجوع إليها إذا وافقت على قرار تلك الأغلبية، أن تقرر مع هذا كل ما تراه مناسبا من التدابير ولها بوجه خاص أن تأمر باعطاء المخالف من الشركاء كفالة تضمن له الوفاء بما قد يستحق من التعويضات."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_718_19750926_OpEnact_1c7d52f47e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_718> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_718> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_718> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لكل شريك في الشيوع الحق في أن يتخذ من الوسائل ما يلزم لحفظ الشيء ، ولو كان ذلك بغير موافقة باقي الشركاء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_719_19750926_OpEnact_eb320aebe9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_719> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_719> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_719> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتحمل جميع الشركاء، كل بقدر حصته نفقات إدارة المال الشائع، وحفظه، والضرائب المفروضة عليه، وسائر التكاليف الناتجة عن الشيوع أو المقررة على المال ، كل ذلك ما لم يوجد نص يقضي بغير ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_71_19750926_OpEnact_8bfd0f72a8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_71> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_71> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_71> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الاتفاق الذي يعد له كلا المتعاقدين أو أحدهما بإبرام عقد معين في المستقبل لا يكون له أثر الا إذا عينت جميع المسائل الجوهرية للعقد المراد إبرامه، والمدة التي يجب إبرامه فيها . وإذا اشترط القانون لتمام العقد استيفاء شكل معين فهذا الشكل يطبق أيضا على الاتفاق المتضمن الوعد بالتعاقد ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_720_19750926_OpEnact_292805edc6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_720> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_720> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_720> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للشركاء الذين يملكون على الأقل ثلاثة أرباع (3/4) المال الشائع أن يقرروا التصرف فيه إذا استندوا في ذلك إلى أسباب قوية على أن يعلنوا بعقد غير قضائي قراراتهم إلى باقي الشركاء ولمن خالف من هؤلاء حق الرجوع إلى المحكمة خلال شهرين من وقت الاعلان ، وللمحكمة عندما تكون قسمة المال الشائع ضارة بمصالح الشركاء ، أن تقدر تبعا للظروف ما إذا كان التصرف واجبا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_721_19750926_OpEnact_618c5de8f1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_721> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_721> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_721> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للشريك في المنقول الشائع أو في المجموع من المال المنقول، أو العقار أن يسترد قبل القسمة الحصة الشائعة التي باعها شريك غيره لأجنبي عن طريق التراضي ، وذلك خلال شهر من تاريخ علمه بالبيع أو من تاريخ إعلامه ، ويتم الاسترداد بواسطة تصريح يبلغ إلى كل من البائع والمشتري، ويحل المسترد محل المشتري في جميع حقوقه والتزاماته إذا هو عوضه عن كل ما انفقه. وإذا تعدد المستردون فلكل منهم أن يسترد بنسبة حصته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_722_19750926_OpEnact_26fb6e9594> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_722> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_722> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_722> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لكل شريك أن يطالب بقسمة المال الشائع ما لم يكن مجبرا على البقاء في الشيوع بمقتضى نص أو اتفاق. ولا يجوز بمقتضى الاتفاق أن تمنح القسمة إلى أجل يجاوز خمس (5) سنوات فإذا لم تجاوز هذه المدة نفذ الاتفاق في حق الشريك وفي حق من يخلفه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_723_19750926_OpEnact_170774da6a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_723> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_723> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_723> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يستطيع الشركاء إذا انعقد إجماعهم، أن يقتسموا المال الشائع بالطريقة التي يرونها . فإذا كان بينهم من هو ناقص وجبت مراعاة الاجراءات التي يفرضها القانون ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_724_19750926_OpEnact_3728b2048b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_724> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_724> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_724> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا اختلف الشركاء في اقتسام المال الشائع فعلى من يريد الخروج من الشيوع أن يرفع الدعوى على باقي الشركاء أمام المحكمة. وتعين المحكمة إن رأت وجها لذلك خبيرا أو أكثر لتقويم المال الشائع وقسمته حصصا إن كان المال يقبل القسمة عينا دون أن يلحقه نقص كبير في قيمته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_725_19750926_OpEnact_1d5eb42cfe> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_725> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_725> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_725> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يكون الخبير الحصص على أساس أصغر نصيب حتى ولو كانت القسمة جزئية. وإذا تعذر أن يأخذ أحد الشركاء كامل نصيبه عينا عوض بمعدل عما نقص من نصيبه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_726_19750926_OpEnact_bbcbbf5504> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_726> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_726> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_726> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تفصل المحكمة في كل المنازعات وخاصة منها ما يتعلق بتكوين الحصص."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_727_19750926_OpEnact_c8f5de1b5c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_727> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_727> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_727> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تجري القسمة بطريق الاقتراع، و تثبت المحكمة ذلك في محضرها وتصدر حكما باعطاء كل شريك نصيبه المفرز."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_728_19750926_OpEnact_01f4dd3bda> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_728> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_728> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_728> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تعذرت القسمة عينا ، أو كان من شأنها إحداث نقص كبير في قيمة المال المراد قسمته ، بيع هذا المال بالمزاد بالطريقة المبينة في قانون الاجراءات المدنية ، وتقتصر المزايدة على الشركاء وحدهم إذا طلبوا هذا بالاجماع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_729_19750926_OpEnact_1bced3cd57> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_729> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_729> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_729> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لدائني كل شريك أن يعارضوا في أن تتم القسمة عينا أو أن يباع المال بالمزاد بغير تداخلهم . وتوجه المعارضة إلى كل الشركاء ويترتب عليها الزامهم أن يدخلوا من عارض من الدائنين في جميع الاجراءات ، وإلا كانت القسمة غير نافذة في حقهم ويجب على كل حال إدخال الدائنين المقيدة حقوقهم قبل رفع دعوى القسمة. أما إذا تمت القسمة فليس للدائنين الذين لم يتدخلوا فيها أن يطعنوا فيها الا في حالة الغش."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_19750926_OpEnact_21456e1985> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_72> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_72> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_72> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا وعد شخص بإبرام عقد ثم نكل وقاضاه المتعاقد الآخر طالبا تنفيذ الوعد، وكانت الشروط اللازمة لتمام العقد وخاصة ما يتعلق منها بالشكل متوافرة ، قام الحكم مقام العقد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_bis_19750926_OpEnact_cac27d5eac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_72_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_72_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يمنح دفع العربون وقت إبرام العقد لكل من المتعاقدين الحق في العدول عنه خلال المدة المتفق عليها ، إلا إذا قضى الاتفاق بخلاف ذلك. فإذا عدل من دفع العربون فقدة. وإذا عدل من قبضه رده ومثله ولو لم يترتب على العدول أي ضرر ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_730_19750926_OpEnact_db3fb46940> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_730> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_730> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_730> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يعتبر المتقاسم مالكا للحصة التي آلت إليه منذ أن أصبح مالكا في الشيوع، وأنه لم يكن مالكا على الاطلاق لباقي الحصص الأخرى."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_731_19750926_OpEnact_4fee707a18> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_731> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_731> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_731> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يضمن المتقاسمون بعضهم لبعض ما قد يقع من تعرض أو استحقاق لسبب سابق على القسمة ، و يكون كل منهم ملزما بنسبة حصته أن يعوض المتقاسم المتعرض له أو المنتزع حقه على أن تكون العبرة في تقدير الشيء بقيمته وقت القسمة فإذا كان أحد المتقاسمين معسرا ، وزع القدر الذي يلزمه على مستحق الضمان وجميع المتقاسمين غير المعسرين. غير أنه لا محل للضمان إذا كان هناك اتفاق صريح يقضي بالاعفاء منه في الحالة الخاصة التي نشأ عنها ، ويمتنع الضمان أيضا إذا كان الاستحقاق راجعا إلى خطأ المتقاسم نفسه ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_732_19750926_OpEnact_eab39588e6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_732> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_732> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_732> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز نقض القسمة الحاصلة بالتراضي إذا أثبت أحد المتقاسمين أنه لحقه منها غبن يزيد على الخمس (1/5) ، على أن تكون العبرة في التقدير بقيمة الشيء وقت القسمة. ويجب أن ترفع الدعوى خلال السنة التالية للقسمة و للمدعى عليه أن يوقف سيرها ويمنع القسمة من جديد إذا أكمل للمدعى نقدا أو عينا ما نقص من حصته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_733_19750926_OpEnact_2cf519bf53> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_733> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_733> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_733> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يتفق الشركاء في قسمة المهايأة على أن يختص كل منهم بجزء مفرز يساوي حصته في المال الشائع متنازلا لشركائه في مقابل ذلك عن الانتفاع بباقي الأجزاء و لا يصح هذا الاتفاق لمدة تزيد على خمس (5) سنوات . فإذا لم تشترط لها مدة أو انتهت المدة المتفق عليها ولم يحصل اتفاق جديد كانت مدتها سنة واحدة تتجدد إذا لم يعلن الشريك إلى شركائه قبل انتهاء السنة الجارية بثلاثة (3) أشهر أنه لا يرغب في التحديد . وإذا دامت قسمة المهايأة خمسة عشرة سنة انقلبت إلى قسمة نهائية ما لم يتفق الشركاء على غير ذلك. وإذا حاز الشريك على الشيوع جزءا مفرزا من المال الشائع مدة خمسة عشرة (15) سنة ، افترض أن حيازته لهذا الجزء تستند إلى قسمة مهايأة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_734_19750926_OpEnact_e6dcd85999> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_734> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_734> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_734> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز أن تكون قسمة المهايأة أيضا بأن يتفق الشركاء على أن يتناولوا الانتفاع بجميع المال المشترك، كل منهم لمدة تتناسب مع حصته ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_735_19750926_OpEnact_989d6ca467> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_735> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_735> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_735> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تخضع قسمة المهايأة من حيث جواز الاحتجاج بها على الغير ومن حيث أهلية المتقاسمين وحقوقهم والتزاماتهم وطرق الاثبات لأحكام عقد الإيجار ، ما دامت هذه الأحكام لا تتعارض مع طبيعة هذه القسمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_736_19750926_OpEnact_a00dd92352> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_736> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_736> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_736> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يمكن للشركاء أن يتفقوا أثناء اجراءات القسمة النهائية على أن يقسم المال الشائع مهايأة بينهم ، وتظل هذه القسمة نافذة حتى تتم القسمة النهائية. فإذا تعذر اتفاق الشركاء على قسمة المهاية ، جاز للمحكمة أن تأمر بها إذا طلب منها ذلك أحد الشركاء وبعد الاستعانة، إذا اقتضى الأمر ذلك."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_737_19750926_OpEnact_a6ef8410e2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_737> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_737> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_737> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ليس للشركاء في مال شائع أن يطلبوا قسمته إذا تبين من الغرض الذي أعد له هذا المال، أنه يجب أن يبقى دائما على الشيوع ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_738_19750926_OpEnact_8f496416f6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_738> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_738> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_738> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لأعضاء الأسرة الواحدة الذين تجمعهم وحدة العمل أو المصلحة أن يتفقوا كتابة على إنشاء ملكية للأسرة . وتتكون هذه الملكية إما من تركة ورثوها واتفقوا على جعلها كلها أو بعضها ملكا للأسرة وإما من أي مال آخر لهم."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_739_19750926_OpEnact_396047eb62> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_739> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_739> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_739> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجوز الاتفاق على انشاء ملكية لمدة لا تزيد على خمسة عشرة (15) سنة ، غير أنه يجوز لكل شريك أن يطلب من المحكمة الإذن له في إخراج نصيبه من هذه الملكية قبل انقضاء الأجل المتفق عليه إذا وجد مبرر قوي لذلك . وإذا لم يكن للملكية المذكورة أجل معين ، كان لكل شريك أن يخرج نصيبه منها بعد ستة (6) أشهر من يوم أن يعلن إلى الشركاء الآخرين عن رغبته في ذلك ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_73_19750926_OpEnact_25ee0ca425> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_73> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_73> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_73> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا تم العقد بطريق النيابة ، كان شخص النائب لا شخص الأصيل هو محل الاعتبار عند النظر في عيوب الرضاء، أو في أثر العلم ببعض الظروف الخاصة، أو افتراض العلم بها حتما. غير أنه إذا كان النائب وكيلا ويتصرف وفقا لتعليمات معينة صادرة من موكله ، فليس للموكل أن يتمسك بجهل النائب لظروف كان يعلمها هو ، أو كان من المفروض حتما أن يعلمها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_740_19750926_OpEnact_049a1e832a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_740> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_740> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_740> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "ليس للشركاء أن يطلبوا القسمة ما دامت ملكية الأسرة قائمة ، و لا يجوز لأي شريك أن يتصرف في نصيبه لأجنبي عن الأسرة الا بموافقة الشركاء جميعا . وإذا تملك أجنبي عن الأسرة حصة أحد الشركاء برضاء هذا الشريك أو جبرا عليه ، فلا يكون الأجنبي شريكا في ملكية الأسرة الا برضاء باقي الشركاء ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_741_19750926_OpEnact_68b3ca9cb1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_741> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_741> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_741> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "للشركاء أصحاب القدر الأكبر من قيمة الحصص أن يعينوا من بينهم للادارة واحدا أو أكثر ، و للمدير أن يدخل على ملكية الأسرة من التغيير في الغرض الذي أعد له المال المشترك ما يحسن به طرق الانتفاع بهذا المال . يجوز عزل المدير بالطريقة التي عين بها ولو اتفق على غير ذلك ، كما يجوز للمحكمة أن تعزله بناء على طلب أي شريك إذا وجد سبب قوي يبرر هذا العزل ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_742_19750926_OpEnact_09eb6b1378> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_742> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_742> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_742> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "فيما عدا الأحكام السابقة تنطبق قواعد الملكية الشائعة وقواعد الوكالة على ملكية الأسرة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_743_19750926_OpEnact_71f73ef449> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_743> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_743> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_743> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "الملكية المشتركة هي الحالة القانونية التي يكون عليها العقار المبني أو والتي تكون ملكيتها مقسمة حصصا بين عدة أشخاص تشتمل كل واحدة منها على جزء خاص ونصيب في الأجزاء المشتركة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_744_19750926_OpEnact_4611f6707c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_744> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_744> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_744> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تعتبر أجزاء خاصة ، أجزاء العقارات المبنية، أو غير المبنية والمملوكة بالتقسيم لكل واحد من الملاك الشركاء بغرض الاستعمال الشخصي والخاص. وتعد أجزاء خاصة : كل من تبليط الأرض والأرضية، والتغطية، الأسقف والاحواش باستثناء الجدران الأساسية في البناء، الحواجز الداخلية وأبوابها، أبواب المساطح والنوافذ والأبواب النافذة ومغالق الشبابيك والمصارع أو الستائر وتوابعها، قضبان النوافذ والدرابيز الحديدية للشرفات الطلاء الداخلي للحيطان والحواجز مهما كانت، الأنابيب الداخلية، ومنحنيات التوصيل الخاصة بالأجهزة من مجموع الحنفيات واللوازم المتصلة بها، إطار وأعلى المداخن والخزائن، والخزائن المموهة، الأدوات الصحية للحمامات والمغسلة والمرحاض، أدوات المطبخ، الأدوات الخاصة للتدفئة والماء الساخن التي يمكن أن توجد داخل المحل الخاص. وتعتبر مشتركة بين الشركاء المتجاورين الحواجز أو الحيطان الفاصلة في المحلات الخاصة دون الجدران الأساسية في البناء."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_745_19750926_OpEnact_76fbb8628a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_745> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_745> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_745> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تعتبر أجزاء مشتركة أجزاء العقارات المبنية وغير المبنية التي يملكها على الشيوع كافة الملاكين المشتركين بالنسبة لنصيب كل واحد منهم في كل حصة لاستعمال أو منفعة جميع الملاكين المشتركين أو لأكبر عدد منهم. وتعد أجزاء مشتركة ما يلي : الأرض والأفنية، والبساتين، والجنائن، والمداخل، الجدران الأساسية في البناء، وأدوات التجهيز المشتركة بما فيها أجزاء الأنابيب التابعة لها والتي تمر على المحلات الخاصة الخزائن وغلاف ورؤوس المداخل المعدة للاستعمال المشترك، الرواق الخارجي، والدرابيز والأسطح ولو خصصت كلها أو بعضها للاستعمال الخاص من طرف شريك واحد، المحلات المستعملة للمصالح المشتركة، القاعات الكبرى وممرات الدخول والدرج والمصاعد. وتعد حقوق بالتبعية للأجزاء المشتركة ما يلي : حق تعلية العمارة المعدة للاستعمال المشترك، أو المحتوية على عدة محلات تكون أجزاء خاصة مختلفة ، الحق في بناء عمارات جديدة بالأفنية، والبساتين، أو الجنائن التي تكون أجزاء مشتركة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_746_19750926_OpEnact_710f04687c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_746> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_746> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_746> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تتناسب الحصة في الأجزاء المشتركة الخاصة لكل قسمة مع المساحة النافعة بالنسبة للمساحة الاجمالية النافعة لمجموع القسمات التي تشكل الوحدة العقارية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_747_19750926_OpEnact_e97c3d5423> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_747> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_747> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_747> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لا يجوز أن تكون الأجزاء المشتركة، أو الحقوق التابعة لها محلا لدعوى التقسيم، أو بيعا بالمزايدة بمعزل عن الأجزاء الخاصة ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_748_19750926_OpEnact_2c3846bfec> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_748> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_748> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_748> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يحدد نظام الملكية المشتركة مصير الأجزاء المشتركة والأجزاء الخاصة وكيفيات الانتفاع بها وكذا القواعد المتعلقة بإدارة هذه الأجزاء وتسييرها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_749_19750926_OpEnact_7da3f6b629> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_749> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_749> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_749> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "لكل شريك في الملكية الحق في أن يتمتع بالأجزاء الخاصة التابعة لحصته له أن يستعمل وينتفع بحرية بالأجزاء الخاصة والمشتركة ، بشرط أن لا يمس بحقوق الشركاء الآخرين في الملكية أو يلحق ضررا بما أعد له العقار ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_74_19750926_OpEnact_6fcf901efa> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_74> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_74> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_74> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "إذا ابرم النائب في حدود نيابته عقدا باسم الأصيل فإن ما ينشأ عن هذا العقد من حقوق، والتزامات يضاف إلى الأصيل ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_19750926_OpEnact_3cb980eb39> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_750> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_750> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "تنقسم التكاليف المشتركة إلى نوعين : 1 - تكاليف من النوع الأول وهي تتعلق بالتسيير العادي للأجزاء المشتركة والترميمات الصغيرة الخاصة بها. يتولى هذه التكاليف مجموع الشاغلين فعليين كانوا أم لا . وتتوزع هذه التكاليف حسب حصص متساوية بين كل واحد من الشاغلين الذين يجب أن يوفوا بها لدى المتصرف ، وذلك وفقا للكيفيات التي حددتها الجمعية العامة. 2- تكاليف من النوع الثاني وهي تتعلق بالترميمات الكبرى للعقار وصيانته وكذا أمن الشركاء في الملكية والشاغلين لها. ويتكفل الشركاء في ملكية العقار بهذه التكاليف . ويتم توزيع هذه التكاليف على أساس حصة كل جزء مشترك من الأجزاء المتعلقة بكل قسمة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_19750926_OpEnact_ea123c94c1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "يجب على المجموعات والمصالح والهيئات العمومية أن تدرج في ميزانيتها الاعتمادات الضرورية لدفع التكاليف الملزمة بدفعها بصفتها شريكة في الملكية أو شاغلة لها . 2 - حقوق وواجبات الشركاء في الملكية / أو الشاغلين لها"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_1_19750926_OpEnact_12a3b1a4fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_1> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في حالة امتناع الأشخاص المعنيين عن دفع التكاليف المستحقة عليهم بصدد النوع الأول أو الثاني ، يمكن للمتصرف أن يلجأ إلى اجراءات التحصيل الجبري ."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_2_19750926_OpEnact_4e784be7b6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_2> ;
    dzdoc:versionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_750_bis_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:versionText "في حالة ما إذا كان الشريك في الملكية أو الشاغل لهيئة أو مصلحة عمومية أو مجموعة محلية ولم يدفع التكاليف المستحقة بعد الانذار بالتنفيذ ، يتم تحصيل هذه التكاليف عن طريق الخصم التلقائي من الاعتمادات المقررة لهذا الغرض، وذلك على يد المحاسب العمومي بناء على إحالة من المتصرف الذي يتعين عليه تقديم جميع الاثباتات، لا سيما منها الفاتورات وقرارات الجمعية وكل مستند آخر . يتم الخصم في أجل شهر بعد الاحالة على المحاسب المختص."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_751_19750926_OpEnact_c54c65a534> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
