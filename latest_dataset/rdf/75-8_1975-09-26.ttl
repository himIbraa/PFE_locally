<https://legal.dz/resource/order/1975-09-26/75-58#version_art_937> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز لكل دائن بيده حكم واجب التنفيذ صادر في أصل الدعوى يلزم المدين بشيء معين، أن يحصل على حق تخصيص بعقارات مدينة ضمانا لأصل الدين والمصاريف . ولا يجوز للدائن بعد موت المدين أخذ تخصيص على عقار في التركة ."@ar ;
