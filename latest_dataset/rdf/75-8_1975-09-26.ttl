    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_822_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_822> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تنازع أشخاص متعددون في حيازة حق واحد اعتبر بصفة مؤقتة أن حائزه هو من كانت له الحيازة المادية الا إذا كان قد اكتسب هذه الحيازة عن طريق التدليس."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_823_para_0> a dzdoc:Paragraph ;
