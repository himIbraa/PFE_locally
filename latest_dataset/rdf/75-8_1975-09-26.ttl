    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_354_19750926_OpEnact_a9b327e351> ;
    dzdoc:replacementText "يتعين على المشتري في البيع بشرط المذاق أن يقبل المبيع كيفما شاء غير انه يجب عليه أن يعلن بقبوله في الأجل المحدد بعقد الاتفاق أو العرف ، ولا ينعقد البيع الا من يوم هذا الاعلان."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_354> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_354> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_355> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في البيع على شرط التجربة يجوز للمشتري أن يقبل المبيع أو يرفضه وعلى البائع أن يمكنه من التجربة فإذا رفض المشتري المبيع يجب عليه أن يعلن الرفض في المدة المتفق عليها فإن لم يكن هناك اتفاق على المدة ففي مدة معقولة يعينها البائع ، فإذا انقضت هذه المدة وسكت المشتري مع تمكنه من تجربة المبيع اعتبر سكوته قبولا. يعتبر البيع على شرط التجربة بيعا موقوفا على شرط القبول الا إذا تبين من الاتفاق أو الظروف أن البيع معلق على شرط فاسخ ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_355_19750926_OpEnact_0b37a62cff> ;
    dzdoc:replacementText "في البيع على شرط التجربة يجوز للمشتري أن يقبل المبيع أو يرفضه وعلى البائع أن يمكنه من التجربة فإذا رفض المشتري المبيع يجب عليه أن يعلن الرفض في المدة المتفق عليها فإن لم يكن هناك اتفاق على المدة ففي مدة معقولة يعينها البائع ، فإذا انقضت هذه المدة وسكت المشتري مع تمكنه من تجربة المبيع اعتبر سكوته قبولا. يعتبر البيع على شرط التجربة بيعا موقوفا على شرط القبول الا إذا تبين من الاتفاق أو الظروف أن البيع معلق على شرط فاسخ ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_355> ;
