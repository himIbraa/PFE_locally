<https://legal.dz/resource/order/1975-09-26/75-58#version_art_750> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنقسم التكاليف المشتركة إلى نوعين : 1 - تكاليف من النوع الأول وهي تتعلق بالتسيير العادي للأجزاء المشتركة والترميمات الصغيرة الخاصة بها. يتولى هذه التكاليف مجموع الشاغلين فعليين كانوا أم لا . وتتوزع هذه التكاليف حسب حصص متساوية بين كل واحد من الشاغلين الذين يجب أن يوفوا بها لدى المتصرف ، وذلك وفقا للكيفيات التي حددتها الجمعية العامة. 2- تكاليف من النوع الثاني وهي تتعلق بالترميمات الكبرى للعقار وصيانته وكذا أمن الشركاء في الملكية والشاغلين لها. ويتكفل الشركاء في ملكية العقار بهذه التكاليف . ويتم ت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_19750926_OpEnact_3cb980eb39> ;
    dzdoc:replacementText "تنقسم التكاليف المشتركة إلى نوعين : 1 - تكاليف من النوع الأول وهي تتعلق بالتسيير العادي للأجزاء المشتركة والترميمات الصغيرة الخاصة بها. يتولى هذه التكاليف مجموع الشاغلين فعليين كانوا أم لا . وتتوزع هذه التكاليف حسب حصص متساوية بين كل واحد من الشاغلين الذين يجب أن يوفوا بها لدى المتصرف ، وذلك وفقا للكيفيات التي حددتها الجمعية العامة. 2- تكاليف من النوع الثاني وهي تتعلق بالترميمات الكبرى للعقار وصيانته وكذا أمن الشركاء في الملكية والشاغلين لها. ويتكفل الشركاء في ملكية العقار بهذه التكاليف . ويتم توزيع هذه التكاليف على أساس حصة كل جزء مشترك من الأجزاء المتعلقة بكل قسمة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_750> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
