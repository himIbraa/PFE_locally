<https://legal.dz/resource/order/1975-09-26/75-58#art_967_obligation_0_f725bf3e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_967> ;
    dznorm:position 0 ;
    dznorm:provisionText "وجب ذكر ذلك في العقد ذاته"@ar ;
    dznorm:sourceArticle "art_967" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_967_obligation_1_65fa8271> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_967> ;
    dznorm:position 1 ;
    dznorm:provisionText "وجب أن يؤشر به في هامش القيد"@ar ;
    dznorm:sourceArticle "art_967" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_967_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_967> ;
    dzdoc:position 0 ;
    dzdoc:text "يجوز للدائن المرتهن لعقار أن يؤجر العقار إلى الراهن دون أن يمنع ذلك من نفاذ الرهن في حق الغير. فإذا اتفق على الإيجار في عقد الرهن وجب ذكر ذلك في العقد ذاته. وإذا اتفق عليه بعد الرهن وجب أن يؤشر به في هامش القيد. ولا يكون هذا التأشير ضروريا إذا جدد الإيجار تجديدا ضمنيا."@ar .

