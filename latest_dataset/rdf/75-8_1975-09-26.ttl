    dznorm:position 0 ;
    dznorm:provisionText "وجب أن يرد للمشتري ماقبضه"@ar ;
    dznorm:sourceArticle "art_406" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_406_para_0> a dzdoc:Paragraph ;
