<https://legal.dz/resource/order/1975-09-26/75-58#art_361_obligation_0_fff84a89> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_361> ;
    dznorm:position 0 ;
    dznorm:provisionText "البائع أن يقوم بما هو لازم لنقل الحق المبيع إلى المشتري وان يمتنع عن كل عمل من شأنه أن يجعل نقل الحق عسيرا أو مستحيلا"@ar ;
    dznorm:sourceArticle "art_361" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_361_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_361> ;
    dzdoc:position 0 ;
    dzdoc:text "البائع أن يقوم بما هو لازم لنقل الحق المبيع إلى المشتري وان يمتنع عن كل عمل من شأنه أن يجعل نقل الحق عسيرا أو مستحيلا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_362_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_362> ;
    dzdoc:position 0 ;
    dzdoc:text "تنتقل الملكية في البيع الجزاف إلى المشتري بنفس الطريق التي تنتقل بها ملكية الشيء المعين."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_362_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_362> ;
    dzdoc:position 1 ;
    dzdoc:text "ويعتبر البيع جزافا ولو كان تعيين الثمن موقوفا على تحديد قدر الشيء المبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363_condition_0_39d7b491> a dznorm:Condition ;
    dznorm:conditionText "إذا كان ثمن البيع مؤجلا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363_condition_1_bb1b5665> a dznorm:Condition ;
    dznorm:conditionText "فإذا كان الثمن يدفع أقساطا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363_condition_2_47b4bb89> a dznorm:Condition ;
    dznorm:conditionText "وإذا وفي المشتري جميع الاقساط"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dznorm:position 2 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان ثمن البيع مؤجلا جاز للبائع أن يشترط أن يكون نقل الملكية إلى المشتري موقوفا على دفع الثمن كله ولو تم تسليم الشيء المبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dzdoc:position 1 ;
    dzdoc:text "فإذا كان الثمن يدفع أقساطا جاز للمتعاقدين أن يتفقا على أن يستبقي البائع جزءا منه على سبيل التعويض في حالة ما إذا وقع فسخ البيع بسبب عدم استيفاء جميع الاقساط. ومع ذلك يجوز للقاضي تبعا للظروف أن يخفض التعويض المتفق عليه وفقا للفقرة الثانية من المادة 184."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dzdoc:position 2 ;
    dzdoc:text "وإذا وفي المشتري جميع الاقساط يعتبر انه تملك الشيء المبيع من يوم البيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_363_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_363> ;
    dzdoc:position 3 ;
    dzdoc:text "تسري أحكام الفقرات الثلاثة السابقة حتى ولو أعطى المتعاقدان للبيع صفة الإيجار."@ar .

