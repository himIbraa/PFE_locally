<https://legal.dz/resource/order/1975-09-26/75-58#version_art_675> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "مالك الشيء يملك كل ما يعد من عناصرها الجوهرية بحيث لا يمكن فصله عنه دون أن يفسد أو يتلف أو يتغير. وتشمل ملكية الأرض ما فوقها وما تحتها إلى الحد المفيد في التمتع بها علوا وعمقا. ويجوز بمقتضى القانون أو الاتفاق أن تكون ملكية سطح الأرض منفصلة عن ملكية ما فوقها أو ما تحتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_675_19750926_OpEnact_866d0a3b4f> ;
    dzdoc:replacementText "مالك الشيء يملك كل ما يعد من عناصرها الجوهرية بحيث لا يمكن فصله عنه دون أن يفسد أو يتلف أو يتغير. وتشمل ملكية الأرض ما فوقها وما تحتها إلى الحد المفيد في التمتع بها علوا وعمقا. ويجوز بمقتضى القانون أو الاتفاق أن تكون ملكية سطح الأرض منفصلة عن ملكية ما فوقها أو ما تحتها."@ar ;
