<https://legal.dz/resource/order/1975-09-26/75-58#version_art_482> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للمستأجر أن يمنع المؤجر من إجراء الترميمات المستعجلة الضرورية لحفظ العين المؤجرة . غير أنه إذا ترتب على إجراء هذه الترميمات إخلال كلي أو جزئي في الانتفاع بالعين المؤجرة ، جاز للمستأجر ، حسب الحالة، طلب فسخ العقد أو إنقاص بدل الإيجار . إذا بقي المستأجر في العين المؤجرة بعد إتمام الترميمات فليس له حق طلب الفسخ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_482_19750926_OpEnact_16bcdacc9c> ;
    dzdoc:replacementText "لا يجوز للمستأجر أن يمنع المؤجر من إجراء الترميمات المستعجلة الضرورية لحفظ العين المؤجرة . غير أنه إذا ترتب على إجراء هذه الترميمات إخلال كلي أو جزئي في الانتفاع بالعين المؤجرة ، جاز للمستأجر ، حسب الحالة، طلب فسخ العقد أو إنقاص بدل الإيجار . إذا بقي المستأجر في العين المؤجرة بعد إتمام الترميمات فليس له حق طلب الفسخ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_482> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
