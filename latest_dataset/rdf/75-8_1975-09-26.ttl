<https://legal.dz/resource/order/1975-09-26/75-58#version_art_48> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لكل من نازعه الغير في استعمال اسمه دون مبرر، ومن انتحل الغير اسمه أن يطلب وقف هذا الاعتداء والتعويض، عما يكون قد لحقه من ضرر ."@ar ;
    dzdoc:isAuthoritative true ;
