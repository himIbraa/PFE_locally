<https://legal.dz/resource/order/1975-09-26/75-58#version_art_218> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا كان التضامن بين الدائنين جاز للمدين الوفاء بالدين لأي منهم ما لم يمانع أحدهم في ذلك. غير أن التضامن لا يجوز دون انقسام الدين بين ورثة أحد الدائنين المتضامنين، الا إذا كان الدين غير قابل للانقسام ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_218_19750926_OpEnact_51415c037b> ;
    dzdoc:replacementText "إذا كان التضامن بين الدائنين جاز للمدين الوفاء بالدين لأي منهم ما لم يمانع أحدهم في ذلك. غير أن التضامن لا يجوز دون انقسام الدين بين ورثة أحد الدائنين المتضامنين، الا إذا كان الدين غير قابل للانقسام ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
