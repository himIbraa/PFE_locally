<https://legal.dz/resource/order/1975-09-26/75-58#version_art_253> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ما دام الدائن لم يحدد موقفه من الحوالة اقرارا أو رفضا ، كان المحال عليه ملزما قبل المدين الأصلي بالوفاء للدائن في الوقت المناسب ما لم يكن هناك اتفاق يقضي بغير ذلك، ويسري هذا الحكم ولو رفض الدائن الحوالة. غير أنه لا يجوز للمدين الأصلي أن يطالب المحال عليه بالوفاء للدائن ما دام لم يقم هو بما التزم به قبل المحال عليه بمقتضى عقد الحوالة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_253_19750926_OpEnact_4ca49f23fa> ;
    dzdoc:replacementText "ما دام الدائن لم يحدد موقفه من الحوالة اقرارا أو رفضا ، كان المحال عليه ملزما قبل المدين الأصلي بالوفاء للدائن في الوقت المناسب ما لم يكن هناك اتفاق يقضي بغير ذلك، ويسري هذا الحكم ولو رفض الدائن الحوالة. غير أنه لا يجوز للمدين الأصلي أن يطالب المحال عليه بالوفاء للدائن ما دام لم يقم هو بما التزم به قبل المحال عليه بمقتضى عقد الحوالة."@ar ;
