    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1> ;
    dznorm:position 1 ;
    dznorm:provisionText "يجب دفع الثمن لدى الضابط العمومي الذي حرر العقد"@ar ;
    dznorm:sourceArticle "art_324_bis_1" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_1_obligation_1_c7531d51_action_f2d48d9403> a dznorm:Action ;
