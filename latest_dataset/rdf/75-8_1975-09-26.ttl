<https://legal.dz/resource/order/1975-09-26/75-58#version_art_216> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الالتزام اختياريا إذا لم يشمل محله الا شيئا واحدا ، ولكن تبرأ ذمة المدين إذا أدى بدلا منه شيئا آخر . والشيء الذي يشمله محل الالتزام هو وحده محل الالتزام وهو الذي يعين طبيعته، لا البديل الذي تبرأ ذمة المدين بأدائه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
