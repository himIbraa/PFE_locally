<https://legal.dz/resource/order/1975-09-26/75-58#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يجب على الفضولي أن يبذل في القيام بالعمل عناية الشخص العادي ، ويكون مسؤولا عن خطئه. ومع ذلك فللقاضي أن ينقص مبلغ التعويض المترتب على هذا الخطأ، إذا كانت الظروف تبرر ذلك . وإذا عهد الفضولي إلى غيره، بكل العمل الذي تكلف به أو ببعضه كان مسؤولا عن تصرفات نائبه، دون إخلال بما لرب العمل من الرجوع مباشرة على هذا النائب . وإذا تعدد الفضوليون في القيام بعمل واحد كانوا متضامنين في المسؤولية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_154_right_0_eb749e38> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_154_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_154_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_154_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_154_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_154_19750926_OpEnact_03f5e8911a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_154_obligation_0_3c6a37de> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 166 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_154_condition_0_61cbf694>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_154_condition_1_619d22aa>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_154_condition_2_0218f00e> ;
    dzdoc:usesTerm dzterm:فضولي .

<https://legal.dz/resource/order/1975-09-26/75-58#art_219> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_219" ;
    dzdoc:fullText "يجوز للدائنين المتضامنين، مجتمعين أو منفردين، مطالبة المدين بالوفاء على أن يراعى في ذلك ما يلحق رابطة كل دائن من وصف. ولا يجوز للمدين إذا طالبه أحد الدائنين المتضامنين بالوفاء أن يعارضه بأوجه الدفع الخاصة بغيره من الدائنين، ولكن يجوز له أن يعارض الدائن المطالب بأوجه الدفع الخاصة به ، وبالتالي يشترك فيها جميع الدائنين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_219_permission_0_656c61ce>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_219_permission_1_dd56a7f6> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_219_right_0_a11cf267>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_219_right_1_b729c0d7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_219> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_219_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_219_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_219_19750926_OpEnact_fba46244d4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "219" ;
    dzdoc:position 232 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "يجوز للدائن مطالبة المدينين المتضامنين مجتمعين أو منفردين على أن يراعى في ذلك ما يلحق رابطة كل مدين من وصف. ولا يجوز للمدين إذا طالبه أحد الدائنين بالوفاء أن يعارض بأوجه الدفع الخاصة بغيره من المدينين ولكن يجوز له أن يعارض بأوجه الدفع الخاصة به وبالتي يشترك فيها جميع المدينين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_223_permission_0_a978b037>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_223_permission_1_1c0304df> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_223_right_0_cf990efd>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_223_right_1_9b0f9ed0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_223> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_223_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_223_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_223_19750926_OpEnact_6ed775bfa2> ;
