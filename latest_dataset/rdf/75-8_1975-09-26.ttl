<https://legal.dz/resource/order/1975-09-26/75-58#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2_bis> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "يسقط الحق في إبطال العقد إذا لم يتمسك به صاحبه خلال خمس (5) سنوات . ويبدأ سريان هذه المدة، في حالة نقص الأهلية من اليوم الذي يزول فيه هذا السبب، وفي حالة الغلط أو التدليس من اليوم الذي يكشف فيه، وفي حالة الإكراه من يوم انقطاعه، غير أنه لا يجوز التمسك بحق الإبطال لغلط أو تدليس أو إكراه إذا انقضت عشرة (10) سنوات من وقت تمام العقد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_101_permission_0_0ee74bdd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_101_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_101_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_101_19750926_OpEnact_6337935ea1> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_101_prohibition_0_0ee74bdd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "101" ;
    dzdoc:position 108 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_101_condition_0_21fcbe9a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_101_condition_1_0227c513> ;
    dzdoc:usesTerm dzterm:duress,
        dzterm:error,
        dzterm:fraud,
        dzterm:incapacity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "إذا كانت عبارة العقد واضحة فلا يجوز الانحراف عنها من طريق تأويلها للتعرف على إرادة المتعاقدين. أما إذا كان هناك محل لتأويل العقد ، فيجب البحث عن النية المشتركة للمتعاقدين دون الوقوف عند المعنى الحرفي للالفاظ ، مع الاستهداء في ذلك بطبيعة التعامل، وبما ينبغي أن يتوافر من أمانة وثقة بين المتعاقدين، وفقا للعرف الجاري في المعاملات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_111_permission_0_cd36001f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_111_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_111_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_111_19750926_OpEnact_ad1eaed392> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_111_obligation_0_2ad50fff> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 111" ;
    dzdoc:position 118 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_111_condition_0_d1f7aea6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_111_condition_1_fc6e3282> ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "إذا تعهد شخص عن الغير فلا يتقيد الغير بتعهده، فإن رفض الغير أن يلتزم ، وجب على المتعهد أن يعوض من تعاقد معه و يجوز له مع ذلك أن يتخلص من التعويض بأن يقوم هو نفسه بتنفيذ ما التزم به . أما إذا قبل الغير هذا التعهد ، فإن قبوله لا ينتج أثرا إلا من وقت صدوره، ما لم يتبين أنه قصد صراحة أو ضمنا أن يستند أثر هذا القبول إلى الوقت الذي صدر فيه التعهد."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_114_right_0_b880985d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_114_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_114_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_114_19750926_OpEnact_5b3209907f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_114_obligation_0_8c5769dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 121 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_114_condition_0_0f1b109f>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_114_condition_1_36fd1289>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_114_condition_2_f4d60208> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يجوز للمشترط دون دائنيه أو وارثيه أن ينقص المشارطة قبل أن يعلن المنتفع إلى المتعهد أو إلى المشترط رغبته في الاستفادة منها ، ما لم يكن ذلك مخالفا لما يقتضيه العقد . ولا يترتب على نقض المشارطة أن تبرأ ذمة المتعهد قبل المشترط إلا إذا اتفق صراحة أو ضمنا على خلاف ذلك ، وللمشترط، إحلال منتفع آخر محل المنتفع الأول، كما له أن يستأثر لنفسه بالانتفاع من عملية الاشتراط."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_117_permission_0_cddf7326> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_117_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_117_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_117_19750926_OpEnact_6cc8d0d252> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "117" ;
    dzdoc:position 124 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_117_condition_0_9e494ca5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_117_condition_1_2b5e82ac>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_117_condition_2_e58218f7> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_4> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "يجوز الاتفاق على أن يعتبر العقد مفسوخا بحكم القانون عند عدم الوفاء بالالتزامات الناشئة عنه بمجرد تحقيق الشروط المتفق عليها وبدون حاجة إلى حكم قضائي . وهذا الشرط لا يعفي من الاعذار ، الذي يحدد حسب العرف عند عدم تحديده من طرف المتعاقدين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_120_permission_0_b0018f4c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_120_right_0_3c552f75> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_120_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_120_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_120_19750926_OpEnact_32d8ce2da8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_120_obligation_0_43caf86e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 127 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "يقدر القاضي، عند عدم النص ما إذا كان هناك التزام طبيعي وعلى أي حال فإنه لا يجوز أن يخالف الالتزام الطبيعي النظام العام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_161_permission_0_831f7bd6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_161_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_161_19750926_OpEnact_871da7a97e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_161_obligation_0_6c62a163> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_161_prohibition_0_831f7bd6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "161" ;
    dzdoc:position 173 ;
    dzdoc:usesTerm dzterm:natural_obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "مجرد الحق في حبس الشيء لا يثبت حق امتياز عليه. وعلى الحابس أن يحافظ على الشيء وفقا لأحكام رهن الحيازة ، وعليه أن يقدم حسابا عن غلته . وإذا كان الشيء المحبوس يخشى عليه الهلاك أو التلف ، فللحابس أن يحصل على إذن من القضاء في بيعه وفقا للاحكام المنصوص عليها في المادة 971 ، وينتقل الحق في الحبس من الشيء إلى ثمنه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_201_right_0_2eff2717> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_201_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_201_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_201_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_201_19750926_OpEnact_a3bd607294> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_201_obligation_0_3e3f0645>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_201_obligation_1_191cd040> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "201" ;
    dzdoc:position 214 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_971> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_971> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_201_condition_0_1a8e4fd2> ;
    dzdoc:usesTerm dzterm:right_of_retention .

<https://legal.dz/resource/order/1975-09-26/75-58#art_218> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_218" ;
    dzdoc:fullText "إذا كان التضامن بين الدائنين جاز للمدين الوفاء بالدين لأي منهم ما لم يمانع أحدهم في ذلك. غير أن التضامن لا يجوز دون انقسام الدين بين ورثة أحد الدائنين المتضامنين، الا إذا كان الدين غير قابل للانقسام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_218_permission_0_38f104e9> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_218_right_0_287a5073> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_218> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_218_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_218_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_218_19750926_OpEnact_51415c037b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_218_prohibition_0_38f104e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "218" ;
    dzdoc:position 231 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_218_condition_0_e1d9e80d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_218_condition_1_3e1b6bd1> ;
    dzdoc:usesTerm dzterm:solidarity .

<https://legal.dz/resource/order/1975-09-26/75-58#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "في حالة تعدد الجنسيات يطبق القاضي الجنسية الحقيقية . غير أن القانون الجزائري هو الذي يطبق إذا كانت للشخص في وقت واحد، بالنسبة إلى الجزائر الجنسية الجزائرية، وبالنسبة إلى دولة أو عدة دول أجنبية جنسية تلك الدول . وفي حالة انعدام الجنسية يطبق القاضي قانون المواطن أو قانون محل الإقامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_22_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_22_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_22_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_22_19750926_OpEnact_7189a506d4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_22_obligation_0_ca3b8dc0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_22_obligation_1_d76994f2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_22_obligation_2_3bd1e9fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "22" ;
    dzdoc:position 25 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_22_condition_0_0fc54be5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_22_condition_1_88141bbc>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_22_condition_2_e81dbe9d> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_238> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_2> ;
    dzdoc:eId "art_238" ;
    dzdoc:fullText "إذا تعدد الدائنون، أو ورثة الدائن في الالتزام غير القابل للانقسام جاز لكل واحد من هؤلاء أن يطالب باداء الالتزام كاملا ، فإذا اعترض أحدهم على الوفاء كان المدين ملزما به لهم مجتمعين، أو بايداع الشيء محل الالتزام . ويرجع الدائنون على الدائن الذي استوفي الالتزام كل بقدر حصته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_238_right_0_e44e0060>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_238_right_1_0b39c62a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_238> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_238_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_238_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_238_19750926_OpEnact_50676241a8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_238_obligation_0_9cb7dbf3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 238" ;
    dzdoc:position 251 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_238_condition_0_52c172e2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_238_condition_1_32167b07> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_258> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_258" ;
    dzdoc:fullText "يصح الوفاء من المدين أو من نائبه أو من أي شخص له مصلحة في الوفاء وذلك مع مراعاة ما جاء في المادة 170 . كما يصح الوفاء أيضا مع التحفظ السابق ممن ليست له مصلحة في الوفاء ولو كان ذلك دون علم المدين أو رغم إرادته غير انه يجوز للدائن رفض الوفاء من الغير إذا اعترض المدين على ذلك وأبلغ الدائن بهذا الاعتراض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_258_permission_0_20a19c17> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_258_right_0_1a9203af> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_258> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_258_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_258_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_258_19750926_OpEnact_f439279761> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 258" ;
    dzdoc:position 271 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_170> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_170> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_258_condition_0_6914eb2c> ;
    dzdoc:usesTerm dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_273> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_273" ;
    dzdoc:fullText "يجوز القيام بالإيداع أو بكل إجراء مماثل : إذا كان المدين يجهل شخصية أو موطن الدائن ، أو كان الدائن عديم الأهلية، أو ناقصها ، ولم يكن له نائب يقبل عنه الوفاء ، أو كان الدين محل نزاع بين عدة أشخاص ، أو كانت هناك أسباب أخرى جدية تبرر هذا الاجراء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_273_permission_0_eb856a79> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_273_right_0_5e43e60c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_273> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_273_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_273_19750926_OpEnact_3227647dfa> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "273" ;
    dzdoc:position 286 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_273_condition_0_bca501df>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_273_condition_1_a42d6e47>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_273_condition_2_9f17c2ec>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_273_condition_3_6d713dff> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_301> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_3> ;
    dzdoc:eId "art_301" ;
    dzdoc:fullText "إذا مضت على الدين مدة التقادم وقت التمسك بالمقاصة فلا يمنع ذلك من وقوعها رغم التمسك بالتقادم ما دامت المدة لم تكن قد تمت في الوقت الذي أصبحت فيه تلك المقاصة ممكنة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_301> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_301_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_301_19750926_OpEnact_a8d25e2f69> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_301_prohibition_0_0d5e61fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "301" ;
    dzdoc:position 314 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_301_condition_0_c04c33cd>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_301_condition_1_db37971b> ;
    dzdoc:usesTerm dzterm:مقاصة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_324_bis_2" ;
    dzdoc:fullText "توقع العقود الرسمية من قبل الاطراف والشهود عند الاقتضاء ، و يؤشر الضابط العمومي على ذلك في آخر العقد . وإذا كان بين الاطراف أو الشهود من لا يعرف أو لا يستطيع التوقيع يبين الضابط العمومي في آخر العقد تصريحاتهم في هذا الشأن ويضعون بصماتهم ما لم يكن هناك مانع قاهر . وفضلا عن ذلك، إذا كان الضابط العمومي يجهل الاسم والحالة والسكن والاهلية المدنية الاطراف ، يشهد على ذلك شاهدان بالغان تحت مسئوليتهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_para_2> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_324_bis_2_19750926_OpEnact_7060804cc1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_obligation_0_bc1ffce5>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_obligation_1_31b90278>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_obligation_2_f9ba2667> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 324 مكرر 2" ;
    dzdoc:position 341 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_condition_0_7de86489>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_2_condition_1_2d273721> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_326> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_326" ;
    dzdoc:fullText "إذا لم يوجد أصل الورقة الرسمية كانت الصورة حجة على الوجه الآتي : يكون للصور الرسمية الاصلية تنفيذية كانت أو غير تنفيذية حجية الأصل متى كان مظهرها الخارجي لا يسمح بالشك في مطابقتها للأصل. ويكون للصور الرسمية المأخوذة من الصور الاصلية الحجية ذاتها ولكن يجوز في هذه الحالة لكل من الطرفين أن يطلب مراجعتها على الصورة الاصلية التي أخذت منها. أما ما يؤخذ من صور رسمية للصورة المأخوذة من النسخ الأولى فلا يعتد به الا لمجرد الاستئناس تبعا للظروف."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_326_permission_0_46f4613e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_326_permission_1_1308a545> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_326_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_326_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_326_para_2>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_326_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_326_19750926_OpEnact_38143fbcea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "326" ;
    dzdoc:position 348 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_326_condition_0_fbd48238> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_376> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_376" ;
    dzdoc:fullText "في حالة نزع اليد الجزئي عن البيع وفي حالة وجود تكاليف عنه وكانت خسارة المشتري قد بلغت قدرا لو علمه المشتري لما أتم العقد كان له أن يطالب البائع بالمبالغ المبينة بالمادة 375 مقابل رد المبيع مع الانتفاع الذي حصل عليه منه. وإذا اختار المشتري: استبقاء المبيع، أو كانت الخسارة التي لحقته لم تبلغ القدر المشار إليه في الفقرة السابقة لم يكن له سوى المطالبة بحق التعويض عن الضرر الذي لحقه بسبب نزع اليد عن المبيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_376> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_376_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_376_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_376_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_376_19750926_OpEnact_3ca7d7193c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 376" ;
    dzdoc:position 400 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_375> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_375> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_376_condition_0_a0f56c27> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_377> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_377" ;
    dzdoc:fullText "يجوز للمتعاقدين بمقتضى اتفاق خاص أن يزيدا في ضمان نزع اليد ، أو ينقصا منه، أو يسقطاه . ويفترض في حق الارتفاق أن البائع قد اشترط عدم الضمان إذا كان هذا حقا ظاهرا أو كان البائع قد أعلم به المشتري . ويكون باطلا كل شرط يسقط الضمان أو ينقصه إذا تعمد البائع اخفاء حق الغير ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_377_permission_0_11fcb4dd> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_377_right_0_7b808d0a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_377> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_377_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_377_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_377_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_377_19750926_OpEnact_854b4dc885> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 377" ;
    dzdoc:position 401 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_377_condition_0_06008e69>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_377_condition_1_fbd286ca> ;
    dzdoc:usesTerm dzterm:easement_right,
        dzterm:guarantee,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_390> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_390" ;
    dzdoc:fullText "إذا كان تعجيل الثمن كله أو بعضه مستحق الدفع في الحال جاز للبائع أن يمسك المبيع إلى أن يقبض الثمن المستحق ولو قدم له المشتري رهنا أو كفالة هذا ما لم يمنحه البائع أجلا بعد انعقاد البيع. يجوز كذلك للبائع أن يمسك المبيع ولو لم يحل الأجل المتفق عليه لدفع الثمن إذا سقط حق المشتري في الأجل طبقا لمقتضيات المادة 212"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_390_permission_0_65cd111c> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_390_right_0_61fb958c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_390_right_1_495d372a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_390> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_390_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_390_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_390_19750926_OpEnact_08f7693460> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 390" ;
    dzdoc:position 414 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_212> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_212> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_390_condition_0_53ee7367>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_390_condition_1_09447f32> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_411> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_411" ;
    dzdoc:fullText "لا يجوز للسماسرة، ولا للخبراء أن يشتروا الأموال المعهودة إليهم ببيعها أو تقدير قيمتها، سواء بانفسهم مباشرة أو باسم مستعار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_411_permission_0_0f2f1f7f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_411> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_411_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_411_19750926_OpEnact_d990ac276e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_411_obligation_0_857b50fe> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_411_prohibition_0_0f2f1f7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 411" ;
    dzdoc:position 435 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_416> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:company ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3> ;
    dzdoc:eId "art_416" ;
    dzdoc:fullText "الشركة عقد بمقضاه يلتزم شخصان طبيعيان أو اعتباريان أو أكثر على المساهمة في نشاط مشترك بتقديم حصة من عمل أو مال أو نقد ، بهدف اقتسام الربح الذي قد ينتج أو تحقيق اقتصاد أو بلوغ هدف اقتصادي ذي منفعة مشتركة. كما يتحملون الخسائر التي قد تنجر عن ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_416> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_416_defocc_c8086e4d2570> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_416_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_416_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_416_19750926_OpEnact_59735c9455> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_416_obligation_0_e149222d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_416_obligation_1_51b18ea4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 416" ;
    dzdoc:position 440 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_418> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_418" ;
    dzdoc:fullText "يجب أن يكون عقد الشركة مكتوبا وإلا كان باطلا، وكذلك يكون باطلا كل ما يدخل على العقد من تعديلات إذا لم يكن له نفس الشكل الذي يكتسبه ذلك العقد . غير أنه لا يجوز أن يحتج الشركاء بهذا البطلان قبل الغير ولا يكون له أثر فيما بينهم إلا من اليوم الذي يقوم فيه أحدهم بطلب البطلان."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_418_permission_0_704dff02> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_418> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_418_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_418_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_418_19750926_OpEnact_fa145fc2d5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_418_obligation_0_09d98ef5> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_418_prohibition_0_704dff02> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 418" ;
    dzdoc:position 442 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_418_condition_0_88f9c0a4> ;
    dzdoc:usesTerm dzterm:company_contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_420> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_420" ;
    dzdoc:fullText "لا يجوز أن تقتصر حصة الشريك على ما يكون له من نفوذ، أو على ما يتمتع به من ثقة مالية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_420_permission_0_565e7ab0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_420> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_420_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_420_19750926_OpEnact_5d708d0608> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/order/1975-09-26/75-58#art_420_prohibition_0_565e7ab0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 420" ;
    dzdoc:position 444 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_437> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_4> ;
    dzdoc:eId "art_437" ;
    dzdoc:fullText "تنتهي الشركة بانقضاء الميعاد الذي عين لها أو بتحقيق الغاية التي انشئت لأجلها. فإذا انقضت المدة المعينة أو تحققت الغاية التي انشئت لأجلها ثم استمر الشركاء يقومون بعمل من نوع الأعمال التي تكونت من أجلها الشركة أمتد العقد سنة فسنة بالشروط ذاتها. ويجوز لدائن أحد الشركاء أن يعترض على هذا الامتداد ويترتب على اعتراضه وقف أثره في حقه."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_437_right_0_144d1bdb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_437> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_437_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_437_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_437_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_437_19750926_OpEnact_e4ca466587> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_437_obligation_0_abe83450> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "437" ;
    dzdoc:position 461 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_437_condition_0_e545805e> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-58#art_440> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_4> ;
    dzdoc:eId "art_440" ;
    dzdoc:fullText "تنتهي الشركة بانسحاب أحد الشركاء، إذا كانت مدتها غير معينة، على شرط أن يعلن الشريك سلفا عن إرادته في الانسحاب قبل حصوله إلى جميع الشركاء وان لا يكون صادرا عن غش أو في وقت غير لائق. وتنتهي الشركة أيضا بإجماع الشركاء على حلها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_440> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_440_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_440_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_440_19750926_OpEnact_911be29dce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_440_obligation_0_f64868f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "440" ;
    dzdoc:position 464 ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-58#art_441> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_4> ;
    dzdoc:eId "art_441" ;
    dzdoc:fullText "يجوز أن تحل الشركة بحكم قضائي بناء على طلب أحد الشركاء، لعدم وفاء شريك بما تعهد به أو بأي سبب آخر ليس هو من فعل الشركاء ، ويقدر القاضي خطورة السبب المبرر لحل الشركة. ويكون باطلا كل اتفاق يقضي بخلاف ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_441_permission_0_3f30a463> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_441_right_0_1afbb5dd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_441> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_441_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_441_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_441_19750926_OpEnact_0cec68b82b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_441_obligation_0_e0d93105> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "441" ;
    dzdoc:position 465 ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-58#art_483> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_483" ;
    dzdoc:fullText "على المؤجر أن يمتنع عن كل تعرض يحول دون انتفاع المستأجر بالعين المؤجرة . ولا يجوز له أن يحدث بها أو بملحقاتها أي تغيير ينقص من هذا الانتفاع . ولا يقتصر ضمان المؤجر على الأفعال التي تصدر منه أو من تابعيه، بل يمتد إلى كل ضرر أو تعرض قانوني صادر عن مستأجر آخر أو أي شخص تلقى الحق عن المؤجر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_483_permission_0_ce93b356> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_483> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_483_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_483_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_483_19750926_OpEnact_30e65c26fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_483_obligation_0_643ebd94>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_483_obligation_1_1b692107> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 483" ;
    dzdoc:position 513 ;
    dzdoc:usesTerm dzterm:leased_property,
        dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_485> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_485" ;
    dzdoc:fullText "إذا تعدد المستأجرون لعين واحدة ، تكون الأولوية لمن كان عقده سابقا في ثبوت التاريخ على العقود الأخرى. وإذا كان للعقود نفس التاريخ تكون الأولوية لمن حاز الأماكن. يجوز للمستأجر حسن النية، إذا حرم من هذه الأولوية مطالبة المؤجر بالتعويض ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_485_permission_0_d782c8b2> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_485_right_0_a946c34a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_485> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_485_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_485_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_485_para_2> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_485_19750926_OpEnact_dedaeb3006> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 485" ;
    dzdoc:position 515 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_485_condition_0_22e35e5a>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_485_condition_1_1d78a514> ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_538> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:loan_for_use ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2> ;
    dzdoc:eId "art_538" ;
    dzdoc:fullText "العارية عقد يلتزم بمقتضاه المعير أن يسلم المستعير شيئا غير قابل للاستهلاك ليستعمله بلا عوض لمدة معينة أو في غرض معين على أن يرده بعد الاستعمال ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_538> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_538_defocc_1019f182f375> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_538_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_538_19750926_OpEnact_d578d5d2a8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_538_obligation_0_128057ac>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_538_obligation_1_53b3bedb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 538" ;
    dzdoc:position 565 ;
    dzdoc:usesTerm dzterm:borrower,
        dzterm:lender .

<https://legal.dz/resource/order/1975-09-26/75-58#art_542> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_2> ;
    dzdoc:eId "art_542" ;
    dzdoc:fullText "ليس للمستعير أن يستعمل الشيء المعار إلا على الوجه المعين وبالقدر المحدد، وذلك طبقا لما يبينه العقد أو تقتضيه طبيعة الشيء أو يجري به العرف و لا يجوز له دون إذن المعير أن يتنازل عن الاستعمال للغير ولو تبرعا . ولا يكون مسؤولا عما يلحق الشيء من تغيير أو تلف يسببه الاستعمال الذي تبيحه العارية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_542_permission_0_438a190e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_542> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_542_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_542_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_542_19750926_OpEnact_f74c301782> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_542_obligation_0_2c829f1d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_542_obligation_1_492cbb6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "542" ;
    dzdoc:position 569 ;
    dzdoc:usesTerm dzterm:borrower,
        dzterm:lender,
        dzterm:loan_for_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_544> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_2> ;
    dzdoc:eId "art_544" ;
    dzdoc:fullText "على المستعير أن يبذل في المحافظة على الشيء العناية التي يبذلها في المحافظة على ماله بشرط أن لا يكون اهتمامه به أدنى من عناية الرجل المعتاد . وفي كل حال يكون ضامنا لهلاك الشيء إذا نشأ الهلاك عن حادث مفاجئ أو قوة قاهرة أو كان في وسعه أن يتحاشاه باستعمال شيء من ملكه الخاص، أو كان بين أن ينقذ شيئا مملوكا له أو الشيء المعار فاختار أن ينقذ ما يملكه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_544> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_544_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_544_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_544_19750926_OpEnact_21e82fc261> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_544_obligation_0_b18fa029>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_544_obligation_1_ac3de058> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "544" ;
    dzdoc:position 571 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_544_condition_0_41c181be>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_544_condition_1_07f4e826> ;
    dzdoc:usesTerm dzterm:borrower .

<https://legal.dz/resource/order/1975-09-26/75-58#art_546> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_2_subsec_3> ;
    dzdoc:eId "art_546" ;
    dzdoc:fullText "تنتهي العارية بانقضاء الأجل المتفق عليه، فإذا لم يعين لها أجل انتهت باستعمال الشيء الذي أعير من أجله. فإن لم يكن هناك سبيل لتعيين مدة العارية جاز للمعير أن يطلب إنهاءها في أي وقت وفي كل حال يجوز للمستعير أن يرد الشيء المعار قبل انتهاء العارية . غير أنه إذا كان هذا الرد يضر المعير فلا يرغم على قبوله."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_546_permission_0_6a4a74e5> ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_546_right_0_00836a61>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_546_right_1_59544baf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_546> ;
