<https://legal.dz/resource/order/1975-09-26/75-58#version_art_432> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على الشريك أن يمتنع من أي نشاط يلحق ضررا بـ الشركة أو يعاكس الغاية التي انشئت لاجلها . وعليه أن يسهر ويحافظ على مصالح الشركة مثلما يفعله في تدبير مصالحه الخاصة ، الا إذا كان منتدبا للادارة مقابل أجرة وفي هذه الحالة يجب أن لا يقل حرصه عن عناية الرجل المعتاد ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_432_19750926_OpEnact_13c72fe48e> ;
