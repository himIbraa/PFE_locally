<https://legal.dz/resource/order/1975-09-26/75-58#art_673_condition_0_8f9be3b0> a dznorm:Condition ;
    dznorm:conditionText "إذا تعدد المدينون في دين واحد وكانوا متضامنين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_673> ;
