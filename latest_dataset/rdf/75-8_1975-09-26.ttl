<https://legal.dz/resource/order/1975-09-26/75-58#version_art_991> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المبالغ المستحقة للخزينة العامة من ضرائب ورسوم وحقوق أخرى من أي نوع كان، لها امتياز ضمن الشروط المقررة في القوانين والمراسيم الواردة في هذا الشأن . وتستوفى هذه المبالغ من ثمن الأموال المثقلة بهذا الامتياز في أي يد كانت وقبل أي حق آخر ، ولو كان ممتازا أو مضمونا برهن رسمي، ما عدا المصاريف القضائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_991_19750926_OpEnact_cbed5ba7fd> ;
    dzdoc:replacementText "المبالغ المستحقة للخزينة العامة من ضرائب ورسوم وحقوق أخرى من أي نوع كان، لها امتياز ضمن الشروط المقررة في القوانين والمراسيم الواردة في هذا الشأن . وتستوفى هذه المبالغ من ثمن الأموال المثقلة بهذا الامتياز في أي يد كانت وقبل أي حق آخر ، ولو كان ممتازا أو مضمونا برهن رسمي، ما عدا المصاريف القضائية ."@ar ;
