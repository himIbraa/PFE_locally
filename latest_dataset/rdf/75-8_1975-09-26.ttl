<https://legal.dz/resource/order/1975-09-26/75-58#art_581_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_581> ;
    dzdoc:position 0 ;
    dzdoc:text "الوكالة تبرعية ما لم يتفق على غير ذلك صراحة أو يستخلص ضمنيا من حالة الوكيل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_581_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_581> ;
    dzdoc:position 1 ;
    dzdoc:text "فإذا اتفق على أجر للوكالة كان هذا الأجر خاضعا لتقدير القاضي الا إذا دفع طوعا بعد تنفيذ الوكالة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_582_condition_0_04ddb7e2> a dznorm:Condition ;
