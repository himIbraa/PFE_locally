<https://legal.dz/resource/order/1975-09-26/75-58#version_art_978> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق للدائن المرتهن أن يستوفي الاستحقاقات الدورية على أن يخصم ما يستوفيه أولا من المصاريف ثم من أصل الدين المضمون بالرهن ما لم يتفق على غير ذلك . ويلتزم الدائن المرتهن بالمحافظة على الدين المرهون ، فإذا كان له أن يحصل شيئا من هذا الدين دون تدخل الراهن ، وجب عليه أن يحصله في الزمان والمكان المعينين للاستيفاء وأن يبادر بإخطار الراهن بذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_978_19750926_OpEnact_a3efe2c3f1> ;
    dzdoc:replacementText "يحق للدائن المرتهن أن يستوفي الاستحقاقات الدورية على أن يخصم ما يستوفيه أولا من المصاريف ثم من أصل الدين المضمون بالرهن ما لم يتفق على غير ذلك . ويلتزم الدائن المرتهن بالمحافظة على الدين المرهون ، فإذا كان له أن يحصل شيئا من هذا الدين دون تدخل الراهن ، وجب عليه أن يحصله في الزمان والمكان المعينين للاستيفاء وأن يبادر بإخطار الراهن بذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_978> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
