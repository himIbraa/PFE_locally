    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_920> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_920_obligation_1_56e84d74_role_f8305cf998> a dznorm:Role ;
    rdfs:label "الراسي عليه المزاد أن"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "ويلتزم الراسي عليه المزاد أن يرد إلى الحائز الذي نزعت ملكيته المصاريف التي انفقها في سند ملكيته، وفي تسجيل هذا السند وفيما قام به من الاعلانات"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_920> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_920_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_920> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا طلب بيع العقار وجب اتباع الاجراءات المقررة في البيوع الجبرية، ويتم البيع بناء على طلب صاحب المصلحة في التعجيل من طالب أو حائز ، وعلى من يباشر الاجراءات أن يذكر في إعلانات البيع المبلغ الذي قوم به العقار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_920_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_920> ;
    dzdoc:position 1 ;
    dzdoc:text "ويلتزم الراسي عليه المزاد أن يرد إلى الحائز الذي نزعت ملكيته المصاريف التي انفقها في سند ملكيته، وفي تسجيل هذا السند وفيما قام به من الاعلانات، وذلك إلى جانب التزاماته بالثمن الذي رسا به المزاد وبالمصاريف التي اقتضتها إجراءات التطهير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_921_condition_0_3dbd9f82> a dznorm:Condition ;
    dznorm:conditionText "إذا لم يطلب بيع العقار في الأجل وبالأوضاع المقررة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_921> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_921_condition_1_e5a30a0e> a dznorm:Condition ;
    dznorm:conditionText "إذا هو دفع المبلغ الذي قوم له العقار بزيادة العشر للدائنين الذين تسمح مرتبتهم باستيفاء حقوقهم منه، أو هو أودع هذا المبلغ الخزينة العامة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_921> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_921_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_921> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا لم يطلب بيع العقار في الأجل وبالأوضاع المقررة استقرت ملكية العقار نهائيا للحائز خالصة من كل حق مقيد، إذا هو دفع المبلغ الذي قوم له العقار بزيادة العشر للدائنين الذين تسمح مرتبتهم باستيفاء حقوقهم منه، أو هو أودع هذا المبلغ الخزينة العامة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_922_obligation_0_566f1f8b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/order/1975-09-26/75-58#art_922_obligation_0_566f1f8b_action_c4bb0b7a56> ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-58#art_922_obligation_0_566f1f8b_period_d06ccc71e0> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_922> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب عليه أن يطلب التأشير بذلك في هامش تسجيل التنبيه بنزع الملكية، وأن يعلن الدائن المباشر للإجراءات بهذه التخلية في خلال خمسة (5) أيام من وقت التقرير بها"@ar ;
    dznorm:sourceArticle "art_922" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_922_obligation_0_566f1f8b_action_c4bb0b7a56> a dznorm:Action ;
    rdfs:label "عليه أن يطلب التأشير بذلك"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب عليه أن يطلب التأشير بذلك في هامش تسجيل التنبيه بنزع الملكية، وأن يعلن الدائن المباشر للإجراءات بهذه التخلية في خلال خمسة (5) أيام من وقت التقرير بها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_922> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_922_obligation_0_566f1f8b_period_d06ccc71e0> a dznorm:Period ;
    rdfs:label "خلال خمسة (5) أيام من وقت التقرير ب"@ar ;
    dzdoc:confidenceScore 0.68 ;
    dzdoc:extractionMethod "lexical_period_pattern" ;
    dzdoc:sourceTextSpan "يجب عليه أن يطلب التأشير بذلك في هامش تسجيل التنبيه بنزع الملكية، وأن يعلن الدائن المباشر للإجراءات بهذه التخلية في خلال خمسة (5) أيام من وقت التقرير بها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_922> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_922_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_922> ;
    dzdoc:position 0 ;
    dzdoc:text "تكون تخلية العقار المرهون بتقرير يقدمه الحائز إلى قلم كتاب المحكمة المختصة، ويجب عليه أن يطلب التأشير بذلك في هامش تسجيل التنبيه بنزع الملكية، وأن يعلن الدائن المباشر للإجراءات بهذه التخلية في خلال خمسة (5) أيام من وقت التقرير بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_922_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_922> ;
    dzdoc:position 1 ;
    dzdoc:text "يجوز لمن له مصلحة في التعجيل أن يطلب إلى قاضي الأمور المستعجلة تعيين حارس تتخذ في مواجهته إجراءات نزع الملكية. ويعين الطالب حارسا إذا طلب ذلك."@ar .

