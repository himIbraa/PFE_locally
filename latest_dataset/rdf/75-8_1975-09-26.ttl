<https://legal.dz/resource/order/1975-09-26/75-58#version_art_541> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا ضمان على المعير في استحقاق الشيء المعار إلا أن يكون هناك اتفاق على الضمان أو يكون المعير قد تعمد إخفاء سبب نزع اليد . ولا ضمان عليه كذلك في العيوب الخفية، غير أنه إذا تعمد إخفاء العيب أو إذا ضمن سلامة الشيء منه ، لزمه تعويض المستعير عن كل ضرر يسببه ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_541_19750926_OpEnact_4a3cc1a01f> ;
    dzdoc:replacementText "لا ضمان على المعير في استحقاق الشيء المعار إلا أن يكون هناك اتفاق على الضمان أو يكون المعير قد تعمد إخفاء سبب نزع اليد . ولا ضمان عليه كذلك في العيوب الخفية، غير أنه إذا تعمد إخفاء العيب أو إذا ضمن سلامة الشيء منه ، لزمه تعويض المستعير عن كل ضرر يسببه ذلك ."@ar ;
