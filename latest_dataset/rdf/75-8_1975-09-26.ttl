<https://legal.dz/resource/order/1975-09-26/75-58#version_art_515_19750926_OpEnact_581de64946> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
