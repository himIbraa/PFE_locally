<https://legal.dz/resource/order/1975-09-26/75-58#version_art_699> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "أن حيازة الممر الذي يستعمله صاحب العقار المحصور لمدة خمسة عشرة (15) سنة، يعد بمثابة سند ملكية للارتفاق ويصبح تابعا للعقار الذي أنشئ من أجله وإذا كان ارتفاق المرور قد تقرر بالحيازة لصالح العقار المحصور فإنه لا يزول بتوقف الحصر الذي كان السبب الأصلي فيه عارضا كان، أو نهائيا."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_699_19750926_OpEnact_95a0939a26> ;
    dzdoc:replacementText "أن حيازة الممر الذي يستعمله صاحب العقار المحصور لمدة خمسة عشرة (15) سنة، يعد بمثابة سند ملكية للارتفاق ويصبح تابعا للعقار الذي أنشئ من أجله وإذا كان ارتفاق المرور قد تقرر بالحيازة لصالح العقار المحصور فإنه لا يزول بتوقف الحصر الذي كان السبب الأصلي فيه عارضا كان، أو نهائيا."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_699> ;
