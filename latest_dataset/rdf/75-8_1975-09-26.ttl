<https://legal.dz/resource/order/1975-09-26/75-58#version_art_722> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لكل شريك أن يطالب بقسمة المال الشائع ما لم يكن مجبرا على البقاء في الشيوع بمقتضى نص أو اتفاق. ولا يجوز بمقتضى الاتفاق أن تمنح القسمة إلى أجل يجاوز خمس (5) سنوات فإذا لم تجاوز هذه المدة نفذ الاتفاق في حق الشريك وفي حق من يخلفه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
