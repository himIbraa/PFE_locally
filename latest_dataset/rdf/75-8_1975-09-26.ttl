<https://legal.dz/resource/order/1975-09-26/75-58#art_739_right_0_5bf8428a_action_a7358ebb46> a dznorm:Action ;
    rdfs:label "لكل شريك أن يطلب من"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجوز لكل شريك أن يطلب من المحكمة الإذن له في إخراج نصيبه من هذه الملكية قبل انقضاء الأجل المتفق عليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_739> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_739_right_1_ca3e1fff> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_739> ;
    dznorm:position 1 ;
    dznorm:provisionText "كان لكل شريك أن يخرج نصيبه منها بعد ستة (6) أشهر من يوم أن يعلن إلى الشركاء الآخرين عن رغبته في ذلك"@ar ;
    dznorm:sourceArticle "art_739" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_73_condition_0_1f64a78a> a dznorm:Condition ;
    dznorm:conditionText "إذا تم العقد بطريق النيابة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_73> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_73_condition_1_6447012f> a dznorm:Condition ;
    dznorm:conditionText "إذا كان النائب وكيلا ويتصرف وفقا لتعليمات معينة صادرة من موكله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_73> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_73_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_73> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا تم العقد بطريق النيابة، كان شخص النائب لا شخص الأصيل هو محل الاعتبار عند النظر في عيوب الرضاء، أو في أثر العلم ببعض الظروف الخاصة، أو افتراض العلم بها حتما."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_73_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_73> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه إذا كان النائب وكيلا ويتصرف وفقا لتعليمات معينة صادرة من موكله، فليس للموكل أن يتمسك بجهل النائب لظروف كان يعلمها هو ، أو كان من المفروض حتما أن يعلمها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_740_condition_0_8e1bf213> a dznorm:Condition ;
    dznorm:conditionText "وإذا تملك أجنبي عن الأسرة حصة أحد الشركاء برضاء هذا الشريك أو جبرا عليه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_740> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_740_obligation_0_fa5034dc> a dznorm:Obligation ;
