<https://legal.dz/resource/order/1975-09-26/75-58#art_987> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_987" ;
    dzdoc:fullText "يسري على الامتياز ما يسري على الرهن الرسمي من أحكام متعلقة لهلاك الشيء أو تلفه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_987> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_987_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_987_19750926_OpEnact_7d517965fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "987" ;
    dzdoc:position 1038 ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_988> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_988" ;
    dzdoc:fullText "ينقضي حق الامتياز بنفس الطرق التي ينقضي بها حق الرهن الرسمي وحق رهن الحيازة ، ووفقا لأحكام انقضاء هذين الحقين، ما لم يوجد نص يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_988> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_988_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_988_19750926_OpEnact_762f1fe100> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "988" ;
    dzdoc:position 1039 ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:pledge,
        dzterm:privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_989> a dzdoc:Article ;
