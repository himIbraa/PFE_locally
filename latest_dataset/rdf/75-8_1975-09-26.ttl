<https://legal.dz/resource/order/1975-09-26/75-58#version_art_875> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز لمالك العقار المرتفق به أن يعمل شيئا يؤدي إلى الانتقاص من استعمال حق الارتفاق أو أن يجعله شاقا ، و لا يجوز له بوجه أخص أن يغير من الوضع القائم أو أن يبدل الموضع المعين أصلا لاستعمال حق الارتفاق بموضع آخر . غير أنه إذا كان الموضع الذي عين أصلا قد أصبح من شأنه أن يزيد في عبء الارتفاق، أو أصبح الارتفاق مانعا من إحداث تحسينات في العقار المرتفق به فلمالك هذا العقار أن يطلب نقل الارتفاق إلى موضع آخر من العقار، أو على عقار آخر يملكه هو أو يملكه أجنبي إذا رضي الأجنبي بذلك ، كل هذا متى كان استعما"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_875_19750926_OpEnact_a0b7383c83> ;
    dzdoc:replacementText "لا يجوز لمالك العقار المرتفق به أن يعمل شيئا يؤدي إلى الانتقاص من استعمال حق الارتفاق أو أن يجعله شاقا ، و لا يجوز له بوجه أخص أن يغير من الوضع القائم أو أن يبدل الموضع المعين أصلا لاستعمال حق الارتفاق بموضع آخر . غير أنه إذا كان الموضع الذي عين أصلا قد أصبح من شأنه أن يزيد في عبء الارتفاق، أو أصبح الارتفاق مانعا من إحداث تحسينات في العقار المرتفق به فلمالك هذا العقار أن يطلب نقل الارتفاق إلى موضع آخر من العقار، أو على عقار آخر يملكه هو أو يملكه أجنبي إذا رضي الأجنبي بذلك ، كل هذا متى كان استعمال الارتفاق في وضعه الجديد ميسورا لمالك العقار المرتفق بالقدر الذي كان ميسورا به في وضعه السابق ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_875> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_875> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1975-09-26"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_876> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا جزئ العقار المرتفق بقي الارتفاق مستحقا لكل جزء منه ما لم يزد ذلك عبء تكاليف العقار المرتفق به . غیر أنه إذا كان الارتفاق لا يفيد في الواقع الا جزءا من هذه الأجزاء جاز لمالك العقار المرتفق به أن يطلب زوال هذا الارتفاق عن الأجزاء الأخرى ."@ar ;
