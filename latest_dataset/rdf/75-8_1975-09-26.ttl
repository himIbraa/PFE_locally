<https://legal.dz/resource/order/1975-09-26/75-58#art_774> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_1> ;
    dzdoc:eId "art_774" ;
    dzdoc:fullText "تسري أحكام قانون الاحوال الشخصية على تعيين الورثة وتحديد انصبتهم في الميراث وعلى انتقال أموال التركة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_774> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_774_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_774_19750926_OpEnact_63fdd5155a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "774" ;
    dzdoc:position 825 ;
    dzdoc:usesTerm dzterm:personal_status_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_775> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_775" ;
    dzdoc:fullText "يسري على الوصية قانون الاحوال الشخصية والنصوص القانونية المتعلقة بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_775> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_775_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_775_19750926_OpEnact_38edc5b695> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "775" ;
    dzdoc:position 826 ;
    dzdoc:usesTerm dzterm:personal_status_law,
        dzterm:will .

<https://legal.dz/resource/order/1975-09-26/75-58#art_778> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_778" ;
    dzdoc:fullText "الأرض التي تتكون من طمي يجلبه النهر بطريقة تدريجية غير محسوسة تكون ملكا للمالكين المجاورين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_778> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_778_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_778_19750926_OpEnact_cf022e08d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "778" ;
    dzdoc:position 829 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_780> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_780" ;
    dzdoc:fullText "أن مالكي الأراضي الملاصقة للمياه الراكدة كمياه البحيرات والبرك لا يملكون الأراضي التي تنكشف عنها هذه المياه لا تزول ملكيتهم عن الاراضي التي طغت عليها المياه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_780> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_780_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_780_19750926_OpEnact_041876fd96> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "780" ;
    dzdoc:position 831 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_781> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_781" ;
    dzdoc:fullText "الأراضي التي يحولها النهر من مكانها أو ينكشف عنها والجزر التي تتكون في مجراه تكون ملكيتها خاضعة للقوانين الخاصة بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_781> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_781_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_781_19750926_OpEnact_445af89c5b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "781" ;
    dzdoc:position 832 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_787> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_787" ;
    dzdoc:fullText "تطبق أحكام المادة 841 في أداء التعويض المنصوص عليه في المواد 784 و 785 و 786 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_787> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_787_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_787_19750926_OpEnact_779ed61c33> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 787" ;
    dzdoc:position 838 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_784>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_785>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_786>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_841> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_784>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_785>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_786>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_841> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_789> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_789" ;
    dzdoc:fullText "المنشآت الصغيرة كالأكشاك والحوانيت والمأوى التي تقام على أرض الغير من دون أن يكون مقصودا بقاؤها على الدوام تكون ملكا لمن أقامها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_789> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_789_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_789_19750926_OpEnact_8bf9ff003c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 789" ;
    dzdoc:position 840 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "تسري على القصر وعلى المحجور عليهم وعلى غيرهم من عديمي الأهلية أو ناقصيها قواعد الأهلية المنصوص عليها في قانون الأسرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_79_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_79_19750926_OpEnact_5945dd4f82> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 86 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_796> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_796" ;
    dzdoc:fullText "إذا تعدد الشفعاء يكون استعمال حق الشفعة حسب الترتيب المنصوص عليه في الفقرات التالية : إذا كان الشفعاء من طبقة واحدة استحق كل منهم الشفعة بقدر نصيبه، وإذا كان المشتري قد توفرت فيه الشروط التي تجعله شفيعا بمقتضى المادة 795 فإنه يفضل على الشفعاء من طبقته أو من طبقة أدنى ولكن يتقدمه الذين هم من طبقة أعلى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_796> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_796_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_796_19750926_OpEnact_13d936f15c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 796" ;
    dzdoc:position 847 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_795> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_795> ;
    dzdoc:usesTerm dzterm:حق_الشفعة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_798> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_798" ;
    dzdoc:fullText "لا شفعة : إذا حصل البيع بالمزاد العلني وفقا لإجراءات رسمها القانون، وإذا وقع البيع بين الأصول والفروع أو بين الزوجين أو بين الأقارب لغاية الدرجة الرابعة، وبين الأصهار لغاية الدرجة الثانية، إذا كان العقار قد بيع ليكون محل عبادة أو ليلحق بمحل العبادة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_798> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_798_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_798_19750926_OpEnact_835f0339f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 798" ;
    dzdoc:position 849 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_823> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_823" ;
    dzdoc:fullText "الحائز لحق يفرض أنه صاحب لهذا الحق حتى يتبين خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_823> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_823_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_823_19750926_OpEnact_0f00958cab> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "823" ;
    dzdoc:position 874 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_826> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_826" ;
    dzdoc:fullText "تبقى الحيازة محتفظة على الصفة التي كانت عليها وقت كسبها ما لم يقم الدليل على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_826> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_826_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_826_19750926_OpEnact_f04e97f424> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "826" ;
    dzdoc:position 877 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_832> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_832" ;
    dzdoc:fullText "تسري قواعد التقادم المسقط على التقادم المكسب فيما يتعلق بحساب المدة ووقف التقادم وانقطاعه والتمسك به أمام القضاء والتنازل عنه والاتفاق على تعديل المدة وذلك بالقدر الذي لا تتعارض فيه هذه القواعد مع طبيعة التقادم المكسب ومع مراعاة الأحكام التالية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_832> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_832_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_832_19750926_OpEnact_b810ff7fc2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 832" ;
    dzdoc:position 883 ;
    dzdoc:usesTerm dzterm:acquisitive_prescription,
        dzterm:extinctive_prescription .

<https://legal.dz/resource/order/1975-09-26/75-58#art_846> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_846" ;
    dzdoc:fullText "ثمار الشيء المنتفع به تكون للمنتفع بقدر مدة انتفاعه مع مراعاة أحكام الفقرة الثانية من المادة 839 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_846> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_846_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_846_19750926_OpEnact_b059743f61> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 846" ;
    dzdoc:position 897 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_839> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_839> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_854> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_854" ;
    dzdoc:fullText "ينتهي حق الانتفاع بعدم الاستعمال مدة خمسة عشرة (15) سنة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_854> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_854_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_854_19750926_OpEnact_be5805fe60> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 854" ;
    dzdoc:position 905 ;
    dzdoc:usesTerm dzterm:usufruct .

<https://legal.dz/resource/order/1975-09-26/75-58#art_855> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_855" ;
    dzdoc:fullText "نطاق حق الاستعمال و حق السكن يتحدد بقدر ما يحتاج إليه صاحب الحق وأسرته لخاصة أنفسهم وذلك دون الاخلال بالأحكام التي يقررها السند المنشئ للحق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_855> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_855_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_855_19750926_OpEnact_1fdf9c9faf> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 855" ;
    dzdoc:position 906 ;
    dzdoc:usesTerm dzterm:right_of_habitation,
        dzterm:right_of_use .

<https://legal.dz/resource/order/1975-09-26/75-58#art_857> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_1> ;
    dzdoc:eId "art_857" ;
    dzdoc:fullText "تسري القواعد الخاصة بـ حق الانتفاع على حق الاستعمال و حق السكن متى كانت لا تتعارض مع طبيعة هذين الحقين وذلك مع مراعاة الأحكام المتقدمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_857> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_857_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_857_19750926_OpEnact_d2f62a3ad4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 857" ;
    dzdoc:position 908 ;
    dzdoc:usesTerm dzterm:right_of_habitation,
        dzterm:right_of_use,
        dzterm:usufruct .

