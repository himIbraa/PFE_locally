    dznorm:position 0 ;
    dznorm:provisionText "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801 فلا يجوز الأخذ بالشفعة الا من المشتري الثاني وحسب الشروط التي اشترى بها."@ar ;
    dznorm:sourceArticle "art_797" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_797_permission_0_842a33b9_action_c86fb14053> a dznorm:Action ;
    rdfs:label "الأخذ بالشفعة الا من المشتري"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "إذا اشترى شخص عقارا تجوز الشفعة فيه ثم باعه قبل أن تعلن أي رغبة في الأخذ بالشفعة أو قبل تسجيل هذه الرغبة طبقا للمادة 801 فلا يجوز الأخذ بالشفعة الا من المشتري الثاني وحسب الشروط التي اشترى بها."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_797> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_798_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_798> ;
    dzdoc:position 0 ;
    dzdoc:text "لا شفعة : إذا حصل البيع بالمزاد العلني وفقا لإجراءات رسمها القانون، وإذا وقع البيع بين الأصول والفروع أو بين الزوجين أو بين الأقارب لغاية الدرجة الرابعة، وبين الأصهار لغاية الدرجة الثانية، إذا كان العقار قد بيع ليكون محل عبادة أو ليلحق بمحل العبادة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_799_obligation_0_b0c65ffa> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/order/1975-09-26/75-58#art_799_obligation_0_b0c65ffa_period_49b5b9c150> ;
    dzdoc:hasRole <https://legal.dz/resource/order/1975-09-26/75-58#art_799_obligation_0_b0c65ffa_role_a0cc9f5942> ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_799> ;
    dznorm:position 0 ;
    dznorm:provisionText "على من يريد الأخذ بالشفعة أن يعلن رغبته فيها إلى كل من البائع والمشتري في أجل ثلاثين (30) يوما من تاريخ الانذار الذي يوجهه إليه البائع أو المشتري والا سقط حقه"@ar ;
    dznorm:sourceArticle "art_799" .

