<https://legal.dz/resource/order/1975-09-26/75-58#version_art_22> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة تعدد الجنسيات يطبق القاضي الجنسية الحقيقية . غير أن القانون الجزائري هو الذي يطبق إذا كانت للشخص في وقت واحد، بالنسبة إلى الجزائر الجنسية الجزائرية، وبالنسبة إلى دولة أو عدة دول أجنبية جنسية تلك الدول . وفي حالة انعدام الجنسية يطبق القاضي قانون المواطن أو قانون محل الإقامة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
