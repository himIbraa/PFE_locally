<https://legal.dz/resource/order/1975-09-26/75-58#version_art_34> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يراعى في ترتيب درجة القرابة المباشرة، اعتبار كل فرع درجة عند الصعود للأصل ما عدا هذا الأصل، وعند ترتيب درجة الحواشي تعد الدرجات صعودا من الفرع للأصل المشترك، ثم نزولا منه إلى الفرع الآخر، وكل فرع فيما عدا الأصل المشترك يعتبر درجة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_34_19750926_OpEnact_2ac0cdcc81> ;
    dzdoc:replacementText "يراعى في ترتيب درجة القرابة المباشرة، اعتبار كل فرع درجة عند الصعود للأصل ما عدا هذا الأصل، وعند ترتيب درجة الحواشي تعد الدرجات صعودا من الفرع للأصل المشترك، ثم نزولا منه إلى الفرع الآخر، وكل فرع فيما عدا الأصل المشترك يعتبر درجة."@ar ;
