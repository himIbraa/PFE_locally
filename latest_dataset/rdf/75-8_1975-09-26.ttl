<https://legal.dz/resource/order/1975-09-26/75-58#version_art_288> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يتم التجديد الا إذا كان الالتزامان القديم والجديد قد خلا كل منهما من اسباب البطلان. أما إذا كان الالتزام القديم ناشئا عن عقد قابل للبطلان فلا يكون التجديد صحيحا الا إذا فقد الالتزام الجديد اجازة العقد واحلاله محل الالتزام القديم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_288_19750926_OpEnact_e0846f662c> ;
