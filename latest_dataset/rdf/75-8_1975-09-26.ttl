<https://legal.dz/resource/order/1975-09-26/75-58#version_art_481> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا هلكت العين المؤجرة أثناء مدة الإيجار هلاكا كليا يفسخ الإيجار بحكم القانون. إذا كان هلاك العين المؤجرة جزئيا، أو إذا أصبحت في حالة لا تصلح للاستعمال الذي أعدت من أجله، أو نقص هذا الاستعمال نقصا معتبرا ولم يكن ذلك بفعل المستأجر ، يجوز لهذا الأخير، إذا لم يقم المؤجر في الوقت المناسب برد العين المؤجرة إلى الحالة التي كانت عليها، أن يطلب حسب الحالة، إما إنقاص بدل الإيجار أو فسخ الإيجار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_481_19750926_OpEnact_a1834e49ba> ;
    dzdoc:replacementText "إذا هلكت العين المؤجرة أثناء مدة الإيجار هلاكا كليا يفسخ الإيجار بحكم القانون. إذا كان هلاك العين المؤجرة جزئيا، أو إذا أصبحت في حالة لا تصلح للاستعمال الذي أعدت من أجله، أو نقص هذا الاستعمال نقصا معتبرا ولم يكن ذلك بفعل المستأجر ، يجوز لهذا الأخير، إذا لم يقم المؤجر في الوقت المناسب برد العين المؤجرة إلى الحالة التي كانت عليها، أن يطلب حسب الحالة، إما إنقاص بدل الإيجار أو فسخ الإيجار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_481> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
