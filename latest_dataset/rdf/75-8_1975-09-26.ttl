<https://legal.dz/resource/order/1975-09-26/75-58#version_art_231> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يكون المدين المتضامن مسؤولا في تنفيذ الالتزام الا عن فعله. إذا أعذر الدائن أحد المدينين المتضامنين، أو قاضاه فلا يكون لذلك أثر بالنسبة إلى باقي المدينين، اما إذا أعذر أحد المدينين المتضامنين الدائن فيستفيد باقي المدينين من هذا الاعذار."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_231_19750926_OpEnact_c128df4732> ;
    dzdoc:replacementText "لا يكون المدين المتضامن مسؤولا في تنفيذ الالتزام الا عن فعله. إذا أعذر الدائن أحد المدينين المتضامنين، أو قاضاه فلا يكون لذلك أثر بالنسبة إلى باقي المدينين، اما إذا أعذر أحد المدينين المتضامنين الدائن فيستفيد باقي المدينين من هذا الاعذار."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_231> ;
