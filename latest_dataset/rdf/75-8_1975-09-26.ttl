<https://legal.dz/resource/order/1975-09-26/75-58#version_art_165> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الالتزام بنقل الملكية، أو أي حق عيني آخر من شأنه أن ينقل بحكم القانون الملكية أو الحق العيني، إذا كان محل الالتزام شيئا معينا بالذات يملكه الملتزم ، وذلك مع مراعاة الأحكام المتعلقة بالاشهار العقاري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_165_19750926_OpEnact_4347a8a7b4> ;
    dzdoc:replacementText "الالتزام بنقل الملكية، أو أي حق عيني آخر من شأنه أن ينقل بحكم القانون الملكية أو الحق العيني، إذا كان محل الالتزام شيئا معينا بالذات يملكه الملتزم ، وذلك مع مراعاة الأحكام المتعلقة بالاشهار العقاري ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_165> ;
