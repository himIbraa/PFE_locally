<https://legal.dz/resource/order/1975-09-26/75-58#version_art_910> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن للدائن المرتهن أن ينزل عن مرتبة رهنه في حدود الدين المضمون بهذا الرهن لمصلحة دائن آخر له رهن مقيد على نفس العقار ويجوز التمسك تجاه هذا الدائن الآخر بجميع أوجه الدفع التي يجوز التمسك بها تجاه الدائن الأول عدا ما كان منها متعلقا بانقضاء حق هذا الدائن الأول إذا كان هذا الانقضاء لاحقا للتنازل عن المرتبة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_910_19750926_OpEnact_6df243fc54> ;
    dzdoc:replacementText "يمكن للدائن المرتهن أن ينزل عن مرتبة رهنه في حدود الدين المضمون بهذا الرهن لمصلحة دائن آخر له رهن مقيد على نفس العقار ويجوز التمسك تجاه هذا الدائن الآخر بجميع أوجه الدفع التي يجوز التمسك بها تجاه الدائن الأول عدا ما كان منها متعلقا بانقضاء حق هذا الدائن الأول إذا كان هذا الانقضاء لاحقا للتنازل عن المرتبة ."@ar ;
