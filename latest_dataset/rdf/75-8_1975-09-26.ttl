<https://legal.dz/resource/order/1975-09-26/75-58#version_art_277> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجبر المدين الدائن على قبول وفاء جزئى لحقه ما لم يوجد اتفاق أو نص يقضي بغير ذلك . فإذا كان الدين متنازعا في جزء منه وقبل الدائن استيفاء الجزء المعترف به فليس للمدين رفض الوفاء بهذا الجزء."@ar ;
