<https://legal.dz/resource/order/1975-09-26/75-58#version_art_853> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتهي حق الانتفاع بهلاك الشيء الا أنه ينتقل من شيء الهالك إلى ما قد يقابل قيمته، و إذا لم يكن الهلاك راجعا إلى خطأ المالك فلا يجبر المالك على إعادة الشيء إلى أصله ولكنه إذا أعاده رجع حق الانتفاع إلى المنتفع إذا لم يكن الهلاك بسببه وفي هذه الحالة تطبق الفقرة الثانية من المادة 848 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_853_19750926_OpEnact_1f5962131b> ;
