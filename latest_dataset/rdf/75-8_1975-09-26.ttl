<https://legal.dz/resource/order/1975-09-26/75-58#version_art_181> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا ضرورة لاعذار المدين في الحالات الآتية : إذا تعذر تنفيذ الالتزام أو أصبح غير مجد بفعل المدين ، إذا كان محل الالتزام تعويضا ترتب عن عمل مضر، إذا كان محل الالتزام رد شيء يعلم المدين انه مسروق، أو شيء تسلمه دون حق وهو عالم بذلك، إذا صرح المدين كتابة أنه لا ينوي تنفيذ التزامه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_181_19750926_OpEnact_6a5b0739d7> ;
    dzdoc:replacementText "لا ضرورة لاعذار المدين في الحالات الآتية : إذا تعذر تنفيذ الالتزام أو أصبح غير مجد بفعل المدين ، إذا كان محل الالتزام تعويضا ترتب عن عمل مضر، إذا كان محل الالتزام رد شيء يعلم المدين انه مسروق، أو شيء تسلمه دون حق وهو عالم بذلك، إذا صرح المدين كتابة أنه لا ينوي تنفيذ التزامه."@ar ;
