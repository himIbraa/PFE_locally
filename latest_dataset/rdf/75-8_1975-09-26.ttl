<https://legal.dz/resource/order/1975-09-26/75-58#version_art_318> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينقطع التقادم إذا أقر المدين بحق الدائن اقرارا صريحا أو ضمنيا ويعتبر اقرارا ضمنيا أن يترك المدين تحت يد الدائن مالا له مرهونا رهنا حيازيا تأمينا لوفاء الدين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_318_19750926_OpEnact_0c4dfe6f4d> ;
