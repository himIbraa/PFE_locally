<https://legal.dz/resource/order/1975-09-26/75-58#version_art_386> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا ضمن البائع صلاحية المبيع للعمل لمدة معلومة ثم ظهر خلل فيها فعلى المشتري أن يعلم البائع في أجل شهر من يوم ظهوره وان يرفع دعواه في مدة ستة (6) أشهر من يوم الاعلام ، كل هذا ما لم يتفق الطرفان على خلافه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_386_19750926_OpEnact_4aa66386f2> ;
