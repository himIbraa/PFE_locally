<https://legal.dz/resource/order/1975-09-26/75-58#art_647> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_647" ;
    dzdoc:fullText "تجوز كفالة المدين بغير علمه، وتجوز أيضا رغم معارضته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_647> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_647_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_647_19750926_OpEnact_719ad76980> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "647" ;
    dzdoc:position 684 ;
    dzdoc:usesTerm dzterm:كفالة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "لا يعتبر القبول الذي يغير الايجاب إلا ايجابا جديدا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_66_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_66_19750926_OpEnact_c77957f123> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 66" ;
    dzdoc:position 72 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_662> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_662" ;
    dzdoc:fullText "يكون الدائن في كل الأحوال التي يدل فيها الكفيل على أموال المدين ، مسؤولا تجاه الكفيل عن إعسار المدين الذي يترتب عن عدم اتخاذه الاجراءات اللازمة في الوقت المناسب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_662> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_662_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_662_19750926_OpEnact_18c4bf115b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 662" ;
    dzdoc:position 699 ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_667> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_667" ;
    dzdoc:fullText "يكون الكفلاء في الكفالة القضائية أو القانونية دائما متضامنين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_667> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_667_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_667_19750926_OpEnact_2d864ff964> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 667" ;
    dzdoc:position 704 ;
    dzdoc:usesTerm dzterm:judicial_guarantee,
        dzterm:legal_guarantee .

<https://legal.dz/resource/order/1975-09-26/75-58#art_684> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_684" ;
    dzdoc:fullText "يعتبر مالا عقاريا كل حق عيني يقع على عقار، بما في ذلك حق الملكية، وكذلك كل دعوى تتعلق بحق عيني على عقار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_684> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_684_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_684_19750926_OpEnact_89c138b923> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "684" ;
    dzdoc:position 724 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_687> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_687" ;
    dzdoc:fullText "تنظم قوانين خاصة الحقوق التي ترد على أشياء غير مادية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_687> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_687_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_687_19750926_OpEnact_ffba16c55b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "687" ;
    dzdoc:position 727 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "لا يتم العقد في المزايدات إلا برسم المزاد، ويسقط المزاد بمزاد أعلى ولو كان باطلا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_69_19750926_OpEnact_ad3f60f560> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 75 ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_699> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_699" ;
    dzdoc:fullText "أن حيازة الممر الذي يستعمله صاحب العقار المحصور لمدة خمسة عشرة (15) سنة، يعد بمثابة سند ملكية للارتفاق ويصبح تابعا للعقار الذي أنشئ من أجله وإذا كان ارتفاق المرور قد تقرر بالحيازة لصالح العقار المحصور فإنه لا يزول بتوقف الحصر الذي كان السبب الأصلي فيه عارضا كان، أو نهائيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_699> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_699_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
