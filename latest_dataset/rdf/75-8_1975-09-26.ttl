<https://legal.dz/resource/order/1975-09-26/75-58#version_art_828> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقعت الحيازة على عقار أو على حق عيني عقاري وكانت مقترنة بحسن النية ومستندة في الوقت نفسه إلى سند صحيح فإن مدة التقادم المكسب تكون عشر(10) سنوات. ولا يشترط توافر حسن النية الا وقت تلقي الحق. والسند الصحيح هو تصرف يصدر عن شخص لا يكون مالكا للشيء أو صاحبا للحق المراد كسبه بالتقادم. ويجب إشهار السند."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
