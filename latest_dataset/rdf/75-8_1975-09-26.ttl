<https://legal.dz/resource/order/1975-09-26/75-58#version_art_279> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعددت الديون في ذمة المدين ، وكانت لدائن واحد ومن جنس واحد وكان ما أداه لا يفي بهذه الديون جميعا، جاز للمدين عند الوفاء تعيين الدين الذي يريد الوفاء به ما لم يوجد مانع قانوني، أو تعاقدي يحول دون هذا التعيين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
