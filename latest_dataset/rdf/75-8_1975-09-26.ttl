    dzdoc:position 0 ;
    dzdoc:text "ليس للدائن أن ينتفع بالشيء المرهون دون مقابل."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_956_para_1> a dzdoc:Paragraph ;
