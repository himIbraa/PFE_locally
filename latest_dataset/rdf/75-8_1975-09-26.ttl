<https://legal.dz/resource/order/1975-09-26/75-58#version_art_670> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على الكفيل أن يخبر المدين قبل أن يقوم بوفاء الدين ، والا سقط حقه في الرجوع على المدين إذا كان هذا قد وفي الدين أو كانت عنده وقت الاستحقاق أسباب تقضي ببطلان الدين أو بانقضائه . فإذا لم يعارض المدين في الوفاء بقي للكفيل الحق في الرجوع عليه ولو كان المدين قد دفع الدين أو كانت لديه أسباب تقضي ببطلانه أو بانقضائه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_670_19750926_OpEnact_c03914ca61> ;
    dzdoc:replacementText "يجب على الكفيل أن يخبر المدين قبل أن يقوم بوفاء الدين ، والا سقط حقه في الرجوع على المدين إذا كان هذا قد وفي الدين أو كانت عنده وقت الاستحقاق أسباب تقضي ببطلان الدين أو بانقضائه . فإذا لم يعارض المدين في الوفاء بقي للكفيل الحق في الرجوع عليه ولو كان المدين قد دفع الدين أو كانت لديه أسباب تقضي ببطلانه أو بانقضائه."@ar ;
