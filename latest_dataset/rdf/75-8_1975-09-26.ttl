    dzdoc:position 0 ;
    dzdoc:text "موطن القاصر والمحجور عليه والمفقود والغائب هو موطن من ينوب عن هؤلاء قانونا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_38_para_1> a dzdoc:Paragraph ;
