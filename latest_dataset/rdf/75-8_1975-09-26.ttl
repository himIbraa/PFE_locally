<https://legal.dz/resource/order/1975-09-26/75-58#version_art_728> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا تعذرت القسمة عينا ، أو كان من شأنها إحداث نقص كبير في قيمة المال المراد قسمته ، بيع هذا المال بالمزاد بالطريقة المبينة في قانون الاجراءات المدنية ، وتقتصر المزايدة على الشركاء وحدهم إذا طلبوا هذا بالاجماع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_728_19750926_OpEnact_01f4dd3bda> ;
