<https://legal.dz/resource/order/1975-09-26/75-58#version_art_926> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا نزعت ملكية العقار المرهون ولو كان ذلك بعد اتخاذ اجراءات التطهير أو التخلية ورسا المزاد على الحائز نفسه ، أعتبر هذا مالكا للعقار بمقتضى سند ملكيته الأصلي. ويتطهر العقار من كل حق مقيد إذا دفع الحائز الثمن الذي رسا به المزاد أو أودعه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_926_19750926_OpEnact_69c0701804> ;
    dzdoc:replacementText "إذا نزعت ملكية العقار المرهون ولو كان ذلك بعد اتخاذ اجراءات التطهير أو التخلية ورسا المزاد على الحائز نفسه ، أعتبر هذا مالكا للعقار بمقتضى سند ملكيته الأصلي. ويتطهر العقار من كل حق مقيد إذا دفع الحائز الثمن الذي رسا به المزاد أو أودعه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_926> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
