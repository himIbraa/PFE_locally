<https://legal.dz/resource/order/1975-09-26/75-58#version_art_295> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا اتفق المتعاقدون في الانابة أن يستبدلوا بالتزام سابق التزاما جديدا كانت هذه الانابة تجديدا للالتزام بتغيير المدين ويترتب عليها ابراء ذمة المنيب قبل المناب لديه على أن يكون الالتزام الجديد الذي ارتضاه المناب صحيحا والا يكون هذا الأخير معسرا وقت الانابة . غير أنه لا يفترض التجديد في الانابة ، فإن لم يكن هناك اتفاق على التجديد بقى الالتزام القديم إلى جانب الالتزام الجديد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_295_19750926_OpEnact_73a25510e0> ;
    dzdoc:replacementText "إذا اتفق المتعاقدون في الانابة أن يستبدلوا بالتزام سابق التزاما جديدا كانت هذه الانابة تجديدا للالتزام بتغيير المدين ويترتب عليها ابراء ذمة المنيب قبل المناب لديه على أن يكون الالتزام الجديد الذي ارتضاه المناب صحيحا والا يكون هذا الأخير معسرا وقت الانابة . غير أنه لا يفترض التجديد في الانابة ، فإن لم يكن هناك اتفاق على التجديد بقى الالتزام القديم إلى جانب الالتزام الجديد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_295> ;
