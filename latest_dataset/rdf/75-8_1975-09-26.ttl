<https://legal.dz/resource/order/1975-09-26/75-58#version_art_581> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الوكالة تبرعية ما لم يتفق على غير ذلك صراحة أو يستخلص ضمنيا من حالة الوكيل . فإذا اتفق على أجر للوكالة كان هذا الأجر خاضعا لتقدير القاضي الا إذا دفع طوعا بعد تنفيذ الوكالة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_581_19750926_OpEnact_c211cc2169> ;
    dzdoc:replacementText "الوكالة تبرعية ما لم يتفق على غير ذلك صراحة أو يستخلص ضمنيا من حالة الوكيل . فإذا اتفق على أجر للوكالة كان هذا الأجر خاضعا لتقدير القاضي الا إذا دفع طوعا بعد تنفيذ الوكالة ."@ar ;
