<https://legal.dz/resource/order/1975-09-26/75-58#version_art_172> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في الالتزام بعمل، إذا كان المطلوب من المدين أن يحافظ على الشيء، أو أن يقوم بإدارته أو أن يتوخى الحيطة في تنفيذ التزامه فإن المدين يكون قد وفى بالالتزام إذا بذل في تنفيذه من العناية كل ما يبذله الشخص العادي، ولو لم يتحقق الغرض المقصود . هذا ما لم ينص القانون أو الاتفاق على خلاف ذلك. وعلى كل حال يبقى المدين مسؤولا عن غشه، أو خطئه الجسيم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_172_19750926_OpEnact_3bfef056b9> ;
    dzdoc:replacementText "في الالتزام بعمل، إذا كان المطلوب من المدين أن يحافظ على الشيء، أو أن يقوم بإدارته أو أن يتوخى الحيطة في تنفيذ التزامه فإن المدين يكون قد وفى بالالتزام إذا بذل في تنفيذه من العناية كل ما يبذله الشخص العادي، ولو لم يتحقق الغرض المقصود . هذا ما لم ينص القانون أو الاتفاق على خلاف ذلك. وعلى كل حال يبقى المدين مسؤولا عن غشه، أو خطئه الجسيم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_172> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_172> ;
