<https://legal.dz/resource/order/1975-09-26/75-58#art_95_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_95> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا كان محل الالتزام نقودا، التزم المدين بقدر عددها المذكور في العقد دون أن يكون لارتفاع قيمة هذه النقود أو لانخفاضها وقت الوفاء أي تأثير."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_960_para_0> a dzdoc:Paragraph ;
