<https://legal.dz/resource/order/1975-09-26/75-58#version_art_287> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتجدد الالتزام : بتغيير الدين إذا اتفق الطرفان على استبدال الالتزام الأصلي بالتزام جديد يختلف عنه في محله أو في مصدره بتغيير المدين إذا اتفق الدائن والغير على أن يكون هذا الأخير مدينا مكان المدين الأصلي على أن تبرأ ذمة المدين الأصلي دون حاجة لرضائه، أو إذا حصل المدين على رضا الدائن بشخص أجنبي قبل أن يكون هو المدين الجديد، بتغيير الدائن إذا اتفق الدائن والمدين والغير على أن يكون هذا الأخير هو الدائن الجديد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_287_19750926_OpEnact_f6a3a98fca> ;
    dzdoc:replacementText "يتجدد الالتزام : بتغيير الدين إذا اتفق الطرفان على استبدال الالتزام الأصلي بالتزام جديد يختلف عنه في محله أو في مصدره بتغيير المدين إذا اتفق الدائن والغير على أن يكون هذا الأخير مدينا مكان المدين الأصلي على أن تبرأ ذمة المدين الأصلي دون حاجة لرضائه، أو إذا حصل المدين على رضا الدائن بشخص أجنبي قبل أن يكون هو المدين الجديد، بتغيير الدائن إذا اتفق الدائن والمدين والغير على أن يكون هذا الأخير هو الدائن الجديد."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_287> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
