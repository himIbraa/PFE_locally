<https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا كان الشريك في الملكية أو الشاغل لهيئة أو مصلحة عمومية أو مجموعة محلية ولم يدفع التكاليف المستحقة بعد الانذار بالتنفيذ ، يتم تحصيل هذه التكاليف عن طريق الخصم التلقائي من الاعتمادات المقررة لهذا الغرض، وذلك على يد المحاسب العمومي بناء على إحالة من المتصرف الذي يتعين عليه تقديم جميع الاثباتات، لا سيما منها الفاتورات وقرارات الجمعية وكل مستند آخر . يتم الخصم في أجل شهر بعد الاحالة على المحاسب المختص."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_750_bis_2_19750926_OpEnact_4e784be7b6> ;
    dzdoc:replacementText "في حالة ما إذا كان الشريك في الملكية أو الشاغل لهيئة أو مصلحة عمومية أو مجموعة محلية ولم يدفع التكاليف المستحقة بعد الانذار بالتنفيذ ، يتم تحصيل هذه التكاليف عن طريق الخصم التلقائي من الاعتمادات المقررة لهذا الغرض، وذلك على يد المحاسب العمومي بناء على إحالة من المتصرف الذي يتعين عليه تقديم جميع الاثباتات، لا سيما منها الفاتورات وقرارات الجمعية وكل مستند آخر . يتم الخصم في أجل شهر بعد الاحالة على المحاسب المختص."@ar ;
    dzdoc:resolutionStatus "resolved" ;
