<https://legal.dz/resource/order/1975-09-26/75-58#version_art_264> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "من حل محل الدائن قانونا أو اتفاقا كان له حقه بما لهذا الحق من خصائص وما يلحقه من توابع، وما يكلفه من تأمينات وما يرد عليه من دفوع ويكون هذا الحلول بالقدر الذي أداه من ماله من حل محل الدائن ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_264_19750926_OpEnact_1942d01f9f> ;
