<https://legal.dz/resource/order/1975-09-26/75-58#version_art_317> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينقطع التقادم بالمطالبة القضائية ولو رفعت الدعوى إلى محكمة غير مختصة بالتنبيه أو بالحجز، وبالطلب الذي يتقدم به الدائن لقبول حقه في تفليسة المدين أو في توزيع أو بأي عمل يقوم به الدائن أثناء مرافعة لاثبات حقه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
