<https://legal.dz/resource/order/1975-09-26/75-58#version_art_207> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يزول الالتزام إذا تحقق الشرط الفاسخ ، و يكون الدائن ملزما برد ما أخذه فإذا استحال الرد لسبب هو مسؤول عنه وجب عليه تعويض الضرر . غير أن أعمال الادارة التي تصدر من الدائن تبقى نافذة رغم تحقق الشرط."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_207_19750926_OpEnact_abf53e6bf9> ;
