<https://legal.dz/resource/order/1975-09-26/75-58#version_art_489> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وجد بالعين المؤجرة عيب يتحقق معه الضمان يجوز للمستأجر حسب الحالة أن يطلب فسخ الإيجار أو إنقاص بدل الإيجار . وله كذلك أن يطلب إصلاح العيب أو أن يقوم هو بإصلاحه على نفقة المؤجر إذا كان الإصلاح لا يشكل نفقة باهظة على المؤجر . فإذا لحق المستأجر ضرر من العيب التزم المؤجر بتعويضه ما لم يثبت أنه كان يجهل وجود العيب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_489_19750926_OpEnact_c7c5df04db> ;
    dzdoc:replacementText "إذا وجد بالعين المؤجرة عيب يتحقق معه الضمان يجوز للمستأجر حسب الحالة أن يطلب فسخ الإيجار أو إنقاص بدل الإيجار . وله كذلك أن يطلب إصلاح العيب أو أن يقوم هو بإصلاحه على نفقة المؤجر إذا كان الإصلاح لا يشكل نفقة باهظة على المؤجر . فإذا لحق المستأجر ضرر من العيب التزم المؤجر بتعويضه ما لم يثبت أنه كان يجهل وجود العيب ."@ar ;
