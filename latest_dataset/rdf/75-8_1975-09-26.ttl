<https://legal.dz/resource/order/1975-09-26/75-58#version_art_897> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا تكون المخالصة بالأجرة مقدما لمدة لا تزيد على ثلاث (3) سنوات ولا الحوالة بها كذلك نافذة في حق الدائن المرتهن إلا إذا كان تاريخها ثابتا وسابقا لتسجيل تنبيه نزع الملكية . وإذا كانت المخالصة أو الحوالة لمدة تزيد على ثلاث (3) سنوات فانها لا تكون نافذة في حق الدائن المرتهن الا إذا سجلت قبل قيد الرهن والا خفضت المدة إلى ثلاث (3) سنوات مع مراعاة المقتضى الوارد في الفقرة السابقة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_897_19750926_OpEnact_759e152059> ;
    dzdoc:replacementText "لا تكون المخالصة بالأجرة مقدما لمدة لا تزيد على ثلاث (3) سنوات ولا الحوالة بها كذلك نافذة في حق الدائن المرتهن إلا إذا كان تاريخها ثابتا وسابقا لتسجيل تنبيه نزع الملكية . وإذا كانت المخالصة أو الحوالة لمدة تزيد على ثلاث (3) سنوات فانها لا تكون نافذة في حق الدائن المرتهن الا إذا سجلت قبل قيد الرهن والا خفضت المدة إلى ثلاث (3) سنوات مع مراعاة المقتضى الوارد في الفقرة السابقة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_897> ;
