<https://legal.dz/resource/order/1975-09-26/75-58#version_art_603> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجوز للقاضي أن يأمر بالحراسة : في الأحوال المشار إليها في المادة 602 إذا لم يتفق ذوو الشأن على الحراسة ، إذا كان صاحب المصلحة في منقول أو عقار قد تجمع لديه من الأسباب المعقولة ما يخشى معه خطرا عاجلا من بقاء المال تحت يد حائزه في الأحوال الأخرى المنصوص عليها في القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
