<https://legal.dz/resource/order/1975-09-26/75-58#version_art_الاولى> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عقد التسيير هو العقد الذي يلتزم بموجبه متعامل يتمتع بشهرة معترف بها، يسمى مسيرا ، إزاء مؤسسة عمومية اقتصادية أو شركة مختلطة الاقتصاد ، بتسيير كل أملاكها أو بعضها باسمها ولحسابها مقابل أجر فيضفي عليها علامته حسب مقایسه ومعاييره، ويجعلها تستفيد من شبكاته الخاصة بالترويج والبيع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_19750926_OpEnact_7ea5fc81df> ;
