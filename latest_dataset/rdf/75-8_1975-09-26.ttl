    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينقضي حق الرهن الرسمي بانقضاء الدين المضمون و يعود معه إذا زال السبب الذي انقضى به الدين ، دون إخلال بالحقوق التي يكون الغير حسن النية كسبها في الفترة ما بين انقضاء الحق وعودته."@ar ;
