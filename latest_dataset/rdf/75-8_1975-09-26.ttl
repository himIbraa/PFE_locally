<https://legal.dz/resource/order/1975-09-26/75-58#version_art_847> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "على المنتفع أن يستعمل الشيء بحالته التي تسلمه بها وبحسب ما أعد له وأن يديره إدارة حسنة . وللمالك أن يعترض على أي استعمال غير مشروع أو غير متفق مع طبيعة الشيء فإذا أثبت أن حقوقه في خطر جاز له أن يطالب بتقديم تأمينات فإن لم يقدمها المنتفع أو استمر على الرغم من اعتراض المالك في استعمال الشيء استعمالا غير مشروع أو غير متفق مع طبيعة الشيء فللقاضي أن ينزع العين من تحت يده وأن يسلمها إلى الغير ليتولى إدارتها بل له تبعا لخطورة الحال أن يقرر انتهاء حق الانتفاع دون إخلال بحقوق الغير."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_847_19750926_OpEnact_b7605a5a85> ;
    dzdoc:replacementText "على المنتفع أن يستعمل الشيء بحالته التي تسلمه بها وبحسب ما أعد له وأن يديره إدارة حسنة . وللمالك أن يعترض على أي استعمال غير مشروع أو غير متفق مع طبيعة الشيء فإذا أثبت أن حقوقه في خطر جاز له أن يطالب بتقديم تأمينات فإن لم يقدمها المنتفع أو استمر على الرغم من اعتراض المالك في استعمال الشيء استعمالا غير مشروع أو غير متفق مع طبيعة الشيء فللقاضي أن ينزع العين من تحت يده وأن يسلمها إلى الغير ليتولى إدارتها بل له تبعا لخطورة الحال أن يقرر انتهاء حق الانتفاع دون إخلال بحقوق الغير."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_847> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
