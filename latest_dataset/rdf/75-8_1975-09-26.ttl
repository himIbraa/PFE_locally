<https://legal.dz/resource/order/1975-09-26/75-58#version_art_229> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في جميع الأحوال التي يحصل فيها الابراء سواء من الدين ، أو من التضامن يرجع فيها باقي المدينين على المدين المبرأ بنصيبه في حصة المعسر منهم وفقا ل المادة 235 غير أن الدائن إذا اخلى المدين المبرأ من كل مسؤولية الدين يتحمل نصيب هذا المدين في حصة المعسر."@ar ;
