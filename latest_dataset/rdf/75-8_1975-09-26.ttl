<https://legal.dz/resource/order/1975-09-26/75-58#version_art_232> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يسري اقرار أحد المدينين المتضامنين بالدين في حق الباقين. وإذا نكل أحد المدينين المتضامنين عن اليمين الموجهة إليه، أو إذا وجه هذه اليمين إلى الدائن وأداها هذا الأخير فلا يضار بذلك باقي المدينين. وإذا اقتصر الدائن على توجيه اليمين إلى أحد المدينين المتضامنين وحلفها المدين فيستفيد منها الباقون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_232_19750926_OpEnact_fdbbf8a1e0> ;
    dzdoc:replacementText "لا يسري اقرار أحد المدينين المتضامنين بالدين في حق الباقين. وإذا نكل أحد المدينين المتضامنين عن اليمين الموجهة إليه، أو إذا وجه هذه اليمين إلى الدائن وأداها هذا الأخير فلا يضار بذلك باقي المدينين. وإذا اقتصر الدائن على توجيه اليمين إلى أحد المدينين المتضامنين وحلفها المدين فيستفيد منها الباقون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_232> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
