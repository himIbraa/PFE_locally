<https://legal.dz/resource/order/1975-09-26/75-58#version_art_831> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ليس لأحد أن يكسب بالتقادم على خلاف سنده على أنه لا يستطيع أحد أن يغير بنفسه لنفسه سبب حيازته ولا الأصل الذي تقوم عليه. غیر أنه يستطيع أن يكسب بالتقادم إذا تغيرت صفة حيازته إما بفعل الغير أو بفعل منه يعتبر معارضة لحق المالك ولكن في هذه الحالة لا تسري مدة التقادم إلا من تاريخ هذا التغيير."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_831_19750926_OpEnact_7238e2825b> ;
