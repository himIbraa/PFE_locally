<https://legal.dz/resource/order/1975-09-26/75-58#art_999_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_999> ;
    dzdoc:position 0 ;
    dzdoc:text "ما يستحق لبائع العقار من الثمن وملحقاته، يكون له امتياز على العقار المبيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_999_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_999> ;
    dzdoc:position 1 ;
    dzdoc:text "ويجب أن يقيد الامتياز ولو كان البيع مسجلا، وتكون مرتبته من تاريخ البيع إذا وقع التقييد في ظرف شهرين من تاريخ البيع."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_999_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_999> ;
    dzdoc:position 2 ;
    dzdoc:text "فإذا انقضى هذا الأجل أصبح الامتياز رهنا رسميا."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_99_condition_0_f3c76b93> a dznorm:Condition ;
    dznorm:conditionText "إذا جعل القانون لأحد المتعاقدين حقا في إبطال العقد"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_99> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_99_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_99> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا جعل القانون لأحد المتعاقدين حقا في إبطال العقد فليس للمتعاقد الآخر أن يتمسك بهذا الحق."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_9_obligation_0_17890f7f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_9> ;
    dznorm:position 0 ;
    dznorm:provisionText "الالتزامات المتبادلة"@ar ;
    dznorm:sourceArticle "art_9" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_9_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_9> ;
    dzdoc:position 0 ;
    dzdoc:text "ينتهي عقد التسيير بانقضاء المدة التي أبرم من أجلها ، ويمكن فسخه لعدم احترام الالتزامات المتبادلة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_الاولى_obligation_0_ff3eea98> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
