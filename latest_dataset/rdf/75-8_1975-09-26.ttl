    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_253> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_253_obligation_0_a21fccd1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_253> ;
    dznorm:position 0 ;
    dznorm:provisionText "المحال عليه ملزما قبل المدين الأصلي بالوفاء للدائن في الوقت المناسب"@ar ;
    dznorm:sourceArticle "art_253" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_253_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_253> ;
    dzdoc:position 0 ;
    dzdoc:text "ما دام الدائن لم يحدد موقفه من الحوالة اقرارا أو رفضا ، كان المحال عليه ملزما قبل المدين الأصلي بالوفاء للدائن في الوقت المناسب ما لم يكن هناك اتفاق يقضي بغير ذلك، ويسري هذا الحكم ولو رفض الدائن الحوالة."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_253_para_1> a dzdoc:Paragraph ;
