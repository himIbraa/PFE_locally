    dzdoc:text "تتم معاينة الأماكن وجاهيا بموجب محضر أو بيان وصفي يلحق بعقد الإيجار."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_476_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_476> ;
    dzdoc:position 2 ;
