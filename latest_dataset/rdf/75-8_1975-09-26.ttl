<https://legal.dz/resource/order/1975-09-26/75-58#art_307_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_307> ;
    dzdoc:position 0 ;
    dzdoc:text "ينقضي الالتزام إذا اثبت المدين أن الوفاء به أصبح مستحيلا عليه لسبب أجنبي عن إرادته."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_308_obligation_0_0a33ed68> a dznorm:Obligation ;
