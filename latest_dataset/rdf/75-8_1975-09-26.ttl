<https://legal.dz/resource/order/1975-09-26/75-58#version_art_543> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للمستعير أن يسترد المصروفات التي أنفقها لاستعمال الشيء المعار. و هو مكلف بالنفقة اللازمة لصيانة الشيء صيانة معتادة . وله أن ينزع من الشيء المعار كل ما يكون قد أضافه إليه على أن يعيد الشيء إلى حالته الأصلية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_543_19750926_OpEnact_17c076e5f8> ;
