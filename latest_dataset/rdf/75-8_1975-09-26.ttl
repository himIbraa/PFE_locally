<https://legal.dz/resource/order/1975-09-26/75-58#version_art_213> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون الالتزام تخييريا إذا شمل محله أشياء متعددة تبرأ ذمة المدين براءة تامة إذا أدى واحد منها ، ويكون الخيار لـ المدين ما لم ينص القانون أو يتفق المتعاقدان على غير ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_213_19750926_OpEnact_ca01e9223c> ;
    dzdoc:replacementText "يكون الالتزام تخييريا إذا شمل محله أشياء متعددة تبرأ ذمة المدين براءة تامة إذا أدى واحد منها ، ويكون الخيار لـ المدين ما لم ينص القانون أو يتفق المتعاقدان على غير ذلك."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_213> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
