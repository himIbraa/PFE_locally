    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_793_obligation_0_7d41143b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_793> ;
    dznorm:position 0 ;
    dznorm:provisionText "إلا إذا روعيت الاجراءات التي ينص عليها القانون وبالأخص القوانين التي تدير مصلحة شهر العقار"@ar ;
    dznorm:sourceArticle "art_793" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_793_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_793> ;
    dzdoc:position 0 ;
