    dzdoc:text "على المستعير أن يبذل في المحافظة على الشيء العناية التي يبذلها في المحافظة على ماله بشرط أن لا يكون اهتمامه به أدنى من عناية الرجل المعتاد."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_544_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_544> ;
    dzdoc:position 1 ;
    dzdoc:text "وفي كل حال يكون ضامنا لهلاك الشيء إذا نشأ الهلاك عن حادث مفاجئ أو قوة قاهرة أو كان في وسعه أن يتحاشاه باستعمال شيء من ملكه الخاص، أو كان بين أن ينقذ شيئا مملوكا له أو الشيء المعار فاختار أن ينقذ ما يملكه."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_545_condition_0_f8a22ab7> a dznorm:Condition ;
    dznorm:conditionText "متى انتهت العارية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_545> ;
    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_545_condition_1_a4ef3ed5> a dznorm:Condition ;
    dznorm:conditionText "ما لم يوجد اتفاق يقضي بغير ذلك"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_545> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_545_obligation_0_42f7ec92> a dznorm:Obligation ;
