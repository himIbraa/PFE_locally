    dznorm:provisionText "يجب أن يقيد هذا الامتياز"@ar ;
    dznorm:sourceArticle "art_1001" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1001_obligation_0_b0b64282_action_610c2b7d4a> a dznorm:Action ;
    rdfs:label "أن يقيد هذا الامتياز"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن يقيد هذا الامتياز"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1001> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1001_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_1001> ;
    dzdoc:position 0 ;
    dzdoc:text "أن للشركاء الذين اقتسموا عقارا، حق امتياز عليه تأمينا لما تخوله القسمة من حق في رجوع كل منهم على الآخرين، بما في ذلك حق المطالبة بمعدل القسمة، ويجب أن يقيد هذا الامتياز وتكون مرتبته مماثلة لشروط امتياز البائع المشار إليه في المادة 999."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_1001_right_0_82d232b2> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
