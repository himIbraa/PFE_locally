<https://legal.dz/resource/order/1975-09-26/75-58#version_art_546> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنتهي العارية بانقضاء الأجل المتفق عليه، فإذا لم يعين لها أجل انتهت باستعمال الشيء الذي أعير من أجله. فإن لم يكن هناك سبيل لتعيين مدة العارية جاز للمعير أن يطلب إنهاءها في أي وقت وفي كل حال يجوز للمستعير أن يرد الشيء المعار قبل انتهاء العارية . غير أنه إذا كان هذا الرد يضر المعير فلا يرغم على قبوله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_546_19750926_OpEnact_c75b9682ff> ;
    dzdoc:replacementText "تنتهي العارية بانقضاء الأجل المتفق عليه، فإذا لم يعين لها أجل انتهت باستعمال الشيء الذي أعير من أجله. فإن لم يكن هناك سبيل لتعيين مدة العارية جاز للمعير أن يطلب إنهاءها في أي وقت وفي كل حال يجوز للمستعير أن يرد الشيء المعار قبل انتهاء العارية . غير أنه إذا كان هذا الرد يضر المعير فلا يرغم على قبوله."@ar ;
