<https://legal.dz/resource/order/1975-09-26/75-58#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2_bis> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "إذا كان العقد باطلا بطلانا مطلقا جاز لكل ذي مصلحة أن يتمسك بهذا البطلان، وللمحكمة أن تقضي به من تلقاء نفسها ولا يزول البطلان بالاجازة. وتسقط دعوى البطلان بمضي خمسة عشرة سنة من وقت إبرام العقد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_102_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_102_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_102_19750926_OpEnact_ba6c06cedb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "102" ;
    dzdoc:position 109 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_102_condition_0_0f25d924> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2_bis> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "إذا كان العقد في شق منه باطلا أو قابلا للابطال ، فهذا الشق وحده هو الذي يبطل، الا إذا تبين أن العقد ما كان ليتم بغير الشق الذي وقع باطلا، أو قابلا للابطال فيبطل العقد كله."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_104_19750926_OpEnact_1b8e15635f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "104" ;
    dzdoc:position 111 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_104_condition_0_0612ab9e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_104_condition_1_6268e33a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2_bis> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "إذا كان العقد باطلا أو قابلا للابطال وتوفرت فيه أركان عقد آخر فإن العقد يكون صحيحا باعتباره العقد الذي توفرت أركانه، إذا تبين أن نية المتعاقدين كانت تنصرف إلى إبرام هذا العقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_105_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_105_19750926_OpEnact_f2fe7a2a4f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "105" ;
    dzdoc:position 112 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_105_condition_0_65ad8f9c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_105_condition_1_62a8838e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "العقد شريعة المتعاقدين، فلا يجوز نقضه ولا تعديله الا باتفاق الطرفين، أو للاسباب التي يقررها القانون."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_106_permission_0_8888ef74> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_106_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_106_19750926_OpEnact_049253c5cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 106" ;
    dzdoc:position 113 ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "إذا أنشأ العقد التزامات، وحقوقا، شخصية تتصل بشيء انتقل بعد ذلك إلى خلف خاص ، فإن هذه الالتزامات والحقوق تنتقل إلى هذا الخلف في الوقت الذي ينتقل فيه الشيء، إذا كانت من مستلزماته وكان الخلف الخاص يعلم بها وقت انتقال الشيء إليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_109_19750926_OpEnact_2aef1cf8b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 116 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_109_condition_0_72d56275>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_109_condition_1_84d10807> ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "إذا تم العقد بطريقة الاذعان ، وكان قد تضمن شروطا تعسفية ، جاز للقاضي أن يعدل هذه الشروط أو أن يعفي الطرف المذعن منها ، وذلك وفقا لما تقضي به العدالة ويقع باطلا كل اتفاق على خلاف ذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_110_right_0_d562c43e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_110_19750926_OpEnact_2e64817b30> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 117 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_110_condition_0_f33295e4> ;
    dzdoc:usesTerm dzterm:adhesion,
        dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_4> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "في العقود الملزمة للجانبين إذا كانت الالتزامات المتقابلة مستحقة الوفاء جاز لكل من المتعاقدين أن يمتنع عن تنفيذ التزامه إذا لم يقم المتعاقد الآخر بتنفيذ ما التزم به ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_123_right_0_2d9759ad> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_123_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_123_19750926_OpEnact_667a266bf8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 123" ;
    dzdoc:position 130 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_123_condition_0_6325c607> ;
    dzdoc:usesTerm dzterm:bilateral_contracts .

<https://legal.dz/resource/order/1975-09-26/75-58#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "إذا تعدد المسؤولون عن فعل ضار كانوا متضامنين في التزامهم بتعويض الضرر ، وتكون المسؤولية فيما بينهم بالتساوي إلا إذا عين القاضي نصيب كل منهم في الالتزام بالتعويض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_126_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_126_19750926_OpEnact_48e7249dbc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_126_obligation_0_6e032d4c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "126" ;
    dzdoc:position 136 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_126_condition_0_3290dd9d> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "من أحدث ضررا وهو في حالة دفاع شرعي عن نفسه، أو عن ماله، أو عن نفس الغير، أو عن ماله ، كان غير مسؤول، على أن لا يجاوز في دفاعه القدر الضروري، وعند الاقتضاء يلزم بتعويض يحدده القاضي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_128_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_128_19750926_OpEnact_9f078f53c6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_128_obligation_0_3d82cb00> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "128" ;
    dzdoc:position 138 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_128_condition_0_d070536a> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_1> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "يقدر القاضي مدى التعويض عن الضرر الذي لحق المصاب طبقا لأحكام المادتين 182 و 182 مكرر مع مراعاة الظروف الملابسة، فإن لم يتيسر له وقت الحكم أن يقدر مدى التعويض بصفة نهائية، فله أن يحتفظ للمضرور بـ الحق في أن يطالب خلال مدة معينة بالنظر من جديد في التقدير ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_131_right_0_13c67d72> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_131_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_131_19750926_OpEnact_4a7b24fa3e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "131" ;
    dzdoc:position 141 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_182>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_182_bis> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_182>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_182_bis> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/order/1975-09-26/75-58#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "حارس الحيوان ، ولو لم يكن مالكا له، مسؤول عما يحدثه الحيوان من ضرر . ولو ضل الحيوان أو تسرب، ما لم يثبت الحارس أن وقوع الحادث كان بسبب لا ينسب إليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_139_19750926_OpEnact_435a26a436> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_139_obligation_0_30a1ef1e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "139" ;
    dzdoc:position 149 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_139_condition_0_f4281f2b> ;
    dzdoc:usesTerm dzterm:animal_guardian .

<https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_3_subsec_3> ;
    dzdoc:eId "art_140_bis_1" ;
    dzdoc:fullText "إذا انعدم المسؤول عن الضرر الجسماني ولم تكن للمتضرر يد فيه ، تتكفل الدولة بالتعويض عن هذا الضرر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_1_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_140_bis_1_19750926_OpEnact_863804cc63> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_1_obligation_0_31b3d746> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "140 مكرر 1" ;
    dzdoc:position 152 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_140_bis_1_condition_0_4145bdb5> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_1> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "تسقط دعوى التعويض عن الاثراء بلا سبب بانقضاء عشر (10) سنوات من اليوم الذي يعلم فيه من لحقته الخسارة بحقه في التعويض ، وتسقط الدعوى في جميع الأحوال بانقضاء خمسة عشرة سنة من اليوم الذي ينشأ فيه هذا الحق ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_142_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_142_19750926_OpEnact_78de6815b2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 142" ;
    dzdoc:position 154 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_142_condition_0_370904e6>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_142_condition_1_2040a938> ;
    dzdoc:usesTerm dzterm:compensation_claim,
        dzterm:unjust_enrichment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_2> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يصح استرداد غير المستحق إذا كان الوفاء قد تم تنفيذا لالتزام لم يتحقق سببه أو لالتزام زال سببه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_144_right_0_af41482d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_144> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_144_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_144_19750926_OpEnact_3093340a47> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "144" ;
    dzdoc:position 156 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_144_condition_0_3b40ff3e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "يسري على الشروط الموضوعية الخاصة بالولاية والوصاية والقوامة وغيرها من النظم المقررة لحماية القصر وعديمي الأهلية والغائبين قانون الشخص الذي تجب حمايته. غير أنه يطبق القانون الجزائري بالنسبة للتدابير المستعجلة إذا كان القصر وعديمو الأهلية والغائبون موجودين في الجزائر وقت اتخاذ هذه التدابير ، أو تعلقت بأموالهم الموجودة في الجزائر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_15> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_15_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_15_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_15_19750926_OpEnact_b0d51ab310> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "15" ;
    dzdoc:position 16 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_15_condition_0_1e18cb02> ;
    dzdoc:usesTerm dzterm:algerian_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "تتحقق الفضالة ولو كان الفضولي ، أثناء توليه شأنا لنفسه، قد تولى شأن غيره لما بين الأمرين من ارتباط لا يمكن معه القيام بأحدهما منفصلا عن الآخر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_151_permission_0_2347a1b7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_151> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_151_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_151_19750926_OpEnact_22596c6fca> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 151" ;
    dzdoc:position 163 ;
    dzdoc:usesTerm dzterm:فضالة,
        dzterm:فضولي .

<https://legal.dz/resource/order/1975-09-26/75-58#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_4_subsec_3> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "إذا لم تتوافر في الفضولي أهلية التعاقد فلا يكون مسؤولا عن ادارته الا بالقدر الذي أثرى به، ما لم تكن مسئوليته ناشئة عن عمل غير مشروع. أما رب العمل فتبقى مسئوليته كاملة، ولو لم تتوافر فيه أهلية التعاقد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_158_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_158_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_158_19750926_OpEnact_e0473755c1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 158" ;
    dzdoc:position 170 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_158_condition_0_e282b427> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "يمكن أن يكون الالتزام الطبيعي سببا لالتزام مدني."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_163_permission_0_62644a1e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_163_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_163_19750926_OpEnact_d6277ad046> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "163" ;
    dzdoc:position 175 ;
    dzdoc:usesTerm dzterm:natural_obligation .

<https://legal.dz/resource/order/1975-09-26/75-58#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_1> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "في الالتزام بعمل، إذا نص الاتفاق، أو استوجبت طبيعة الدين أن ينفذ المدين الالتزام بنفسه جاز للدائن أن يرفض الوفاء من غير المدين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_169_right_0_fb6cbb3c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_169_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_169_19750926_OpEnact_a7837fe9e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 169" ;
    dzdoc:position 181 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_169_condition_0_60732b21> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_182_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_182_bis" ;
    dzdoc:fullText "يشمل التعويض عن الضرر المعنوي كل مساس بالحرية أو الشرف أو السمعة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_182_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_182_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_182_bis_19750926_OpEnact_70ea744bec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "182 مكرر" ;
    dzdoc:position 195 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_2> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "يجوز للمتعاقدين أن يحددا مقدما قيمة التعويض بالنص عليها في العقد، أو في اتفاق لاحق. وتطبق في هذه الحالة أحكام المواد 176 إلى 181 ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/order/1975-09-26/75-58#art_183_permission_0_15c20dd6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_183_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_183_19750926_OpEnact_5b42bc1ece> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "183" ;
    dzdoc:position 196 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_176>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_181> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_176>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_181> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_19> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_19" ;
    dzdoc:fullText "تخضع التصرفات القانونية في جانبها الشكلي لقانون المكان الذي تمت فيه . ويجوز أيضا أن تخضع لقانون الموطن المشترك للمتقاعدين أو لقانونهما الوطني المشترك أو للقانون الذي يسري على أحكامها الموضوعية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_19_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_19_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_19_19750926_OpEnact_aee9df7bb6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_19_obligation_0_2d48e818> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "19" ;
    dzdoc:position 21 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_191> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_191" ;
    dzdoc:fullText "لكل دائن حل دينه، وصدر من مدينه تصرف ضار به أن يطلب عدم نفاذ هذا التصرف في حقه ، إذا كان التصرف قد انقص من حقوق المدين أو زاد في التزاماته وترتب عسر المدين أو الزيادة في عسره ، وذلك متى توافر أحد الشروط المنصوص عليها في المادة التالية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_191_right_0_542a432b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_191> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_191_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_191_19750926_OpEnact_180b77eb8d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 191" ;
    dzdoc:position 204 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_192> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_191_condition_0_a32e10e7> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_195> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_195" ;
    dzdoc:fullText "إذا كان من تلقى حقا من المدين المعسر لم يدفع ثمنه فإنه يتخلص مما ينتج عن دعوى الدائن متى كان هذا الثمن هو ثمن المثل، وقام بإيداعه الخزانة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_195> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_195_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_195_19750926_OpEnact_537cc79855> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 195" ;
    dzdoc:position 208 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_195_condition_0_97ccfed9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_195_condition_1_212733b9> ;
    dzdoc:usesTerm dzterm:creditor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "تلتزم المؤسسة العمومية الاقتصادية أو الشركة المختلطة الاقتصاد بالمحافظة على الملك المسير في حالة جيدة طوال مدة الاستعمال، وبقاء هذا الملك حرا من أي التزام ماعدا الالتزامات التي لا تضر بحسن سيره ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_2_19750926_OpEnact_1955567f09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_2_obligation_0_e1cf5383> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 ;
    dzdoc:usesTerm dzterm:managed_property,
        dzterm:mixed_economy_company,
        dzterm:public_economic_enterprise .

<https://legal.dz/resource/order/1975-09-26/75-58#art_209> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:term_obligation_for_term ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_209" ;
    dzdoc:fullText "يكون الالتزام لاجل إذا كان نفاذه أو انقضاؤه مترتبا على أمر مستقبل محقق الوقوع. ويعتبر الأمر محقق الوقوع متى كان وقوعه محتما، ولو لم يعرف الوقت الذي يقع فيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_209> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_209_defocc_df078f3175bd> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_209_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_209_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_209_19750926_OpEnact_b335f8a2d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "209" ;
    dzdoc:position 222 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "لا تسري أحكام المواد السابقة الا حيث لا يوجد نص على خلاف ذلك، في قانون خاص، أو معاهدة دولية نافذة في الجزائر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_21_19750926_OpEnact_a0d7e966b7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_21_obligation_0_59d53028> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "21" ;
    dzdoc:position 23 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_11> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_11> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_215> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_215" ;
    dzdoc:fullText "إذا كان الخيار للمدين، ثم استحال تنفيذ كل من الأشياء المتعددة التي اشتمل عليها محل الالتزام، وكان المدين مسؤولا عن هذه الاستحالة ولو فيما يتعلق بواحد من هذه الأشياء ، كان ملزما بدفع آخر شيء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_215> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_215_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_215_19750926_OpEnact_f7e687df73> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_215_obligation_0_fea4eedb> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 215" ;
    dzdoc:position 228 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_215_condition_0_6fc658b0> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_21_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_21_bis" ;
    dzdoc:fullText "يسري على قواعد الاختصاص والاجراءات قانون الدولة التي ترفع فيها الدعوى أو تباشر فيها الاجراءات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_21_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_21_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_21_bis_19750926_OpEnact_0c6decb2a9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_21_bis_obligation_0_25e66bf6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "21 مكرر" ;
    dzdoc:position 24 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_222> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_222" ;
    dzdoc:fullText "إذا كان التضامن بين المدينين فإن وفاء أحدهم للدين مبرئ ذمة الباقين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_222> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_222_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_222_19750926_OpEnact_069216d6dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_222_obligation_0_71f15a22> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "222" ;
    dzdoc:position 235 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_222_condition_0_ce914f7b> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_234> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_3_sec_3_subsec_1> ;
    dzdoc:eId "art_234" ;
    dzdoc:fullText "إذا وفي أحد المدينين المتضامنين كل الدين ، فلا يرجع على أي من الباقين الا بقدر حصته في الدين، ولو كان بدعوى الحلول على الدائن. ويقسم الدين بالتساوي بين المدينين ما لم يكن هناك اتفاق أو نص يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_234> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_234_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_234_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_234_19750926_OpEnact_8c6e6d2bc8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 234" ;
    dzdoc:position 247 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_234_condition_0_93b89383> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1_sec_2> ;
    dzdoc:eId "art_23_bis" ;
    dzdoc:fullText "يطبق القانون الجزائري إذا تعذر إثبات القانون الأجنبي الواجب تطبيقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_para_0> ;
    dzdoc:hasStatus dzdoc:StatusNew ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_23_bis_19750926_OpEnact_73db096ca0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_obligation_0_61bb1866> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "23 مكرر" ;
    dzdoc:position 27 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_23_bis_condition_0_63ebfed8> ;
    dzdoc:usesTerm dzterm:algerian_law .

<https://legal.dz/resource/order/1975-09-26/75-58#art_261> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_261" ;
    dzdoc:fullText "إذا قام بالوفاء شخص غير المدين ، حل الموفي محل الدائن الذي استوفي حقه في الأحوال الآتية : إذا كان الموفي ملزما بالدين مع المدين، أو ملزما بوفائه عنه، إذا كان الموفي دائنا ووفي دائنا آخر مقدما عليه بما له من تأمين عيني ولو لم يكن للموفي أي تأمين، إذا كان الموفي اشترى عقارا ودفع ثمنه وفاء لدائنين، خصص العقار لضمان حقوقهم، إذا كان هناك نص خاص يقرر للموفي حق الحلول."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_261_right_0_8bd67829> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_261> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_261_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_261_19750926_OpEnact_75d1d1157a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 261" ;
    dzdoc:position 274 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_261_condition_0_4eee018e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_267> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_267" ;
    dzdoc:fullText "يكون الوفاء ل لدائن ، أو لنائبه، ويعتبر ذا صفة في استيفاء الدين من يقدم ل لمدين مخالصة صادرة من الدائن ، الا إذا كان متفقا على أن الوفاء يكون للدائن شخصيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_267> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_267_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_267_19750926_OpEnact_56a1db9674> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 267" ;
    dzdoc:position 280 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_267_condition_0_7b173206> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_268> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_1> ;
    dzdoc:eId "art_268" ;
    dzdoc:fullText "الوفاء لشخص غير الدائن ، أو نائبه لا يبرئ ذمة المدين الا إذا أقر الدائن هذا الوفاء، أو عادت عليه منفعة منه، وبقدر هذه المنفعة، أو تم الوفاء بحسن نية للشخص كان الدين في حيازته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_268> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_268_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_268_19750926_OpEnact_aca84301eb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_268_obligation_0_67930f1b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "268" ;
    dzdoc:position 281 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_268_condition_0_334f91db> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_277> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_277" ;
    dzdoc:fullText "لا يجبر المدين الدائن على قبول وفاء جزئى لحقه ما لم يوجد اتفاق أو نص يقضي بغير ذلك . فإذا كان الدين متنازعا في جزء منه وقبل الدائن استيفاء الجزء المعترف به فليس للمدين رفض الوفاء بهذا الجزء."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_277> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_277_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_277_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_277_19750926_OpEnact_e049cfd426> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 277" ;
    dzdoc:position 290 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_277_condition_0_adbefe40> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:debtor,
        dzterm:partial_payment,
        dzterm:payment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_282> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_1_subsec_2> ;
    dzdoc:eId "art_282" ;
    dzdoc:fullText "إذا كان محل الالتزام شيئا معينا بالذات، وجب تسليمه في المكان الذي كان موجودا فيه وقت نشوء الالتزام ما لم يوجد اتفاق أو نص يقضي بغير ذلك . أما في الالتزامات الأخرى فيكون الوفاء في المكان الذي يوجد فيه موطن المدين وقت الوفاء ، أو في المكان الذي يوجد فيه مركز مؤسسته إذا كان الالتزام متعلقا بهذه المؤسسة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_282> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_282_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_282_19750926_OpEnact_25417ad4ca> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_282_obligation_0_f94e037c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 282" ;
    dzdoc:position 295 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_282_condition_0_adbefe40> ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:payment .

<https://legal.dz/resource/order/1975-09-26/75-58#art_294> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:إنابة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_2_subsec_2> ;
    dzdoc:eId "art_294" ;
    dzdoc:fullText "تتم الانابة إذا حصل المدين على رضاء الدائن بشخص أجنبي يلتزم بوفاء الدين مكان المدين. ولا تقتضي الانابة أن تكون هناك حتما مديونية سابقة بين المدين والغير."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_294> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_294_defocc_2619a85b591d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_294_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_294_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_294_19750926_OpEnact_2f03b2d278> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 294" ;
    dzdoc:position 307 ;
    dzdoc:usesTerm dzterm:إنابة .

<https://legal.dz/resource/order/1975-09-26/75-58#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "تضع المؤسسة العمومية الاقتصادية أو الشركة المختلطة الاقتصاد تحت تصرف المسير الوسائل اللازمة لأداء مهمته ، و تعقد جميع التأمينات التي تحفظ وتصون الملك المسير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_3_19750926_OpEnact_2292328b0e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_3_obligation_0_cad82ef8>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_3_obligation_1_a57cc9ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:managed_property,
        dzterm:manager,
        dzterm:mixed_economy_company,
        dzterm:public_economic_enterprise .

<https://legal.dz/resource/order/1975-09-26/75-58#art_310> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_310" ;
    dzdoc:fullText "تتقادم بسنتين حقوق الاطباء والصيادلة، والمحامين والمهندسين والخبراء، ووكلاء التفليسة، والسماسرة، والاساتذة والمعلمين بشرط أن تكون هذه الحقوق واجبة لهم جزاء عما أدوه من عمل مهنتهم وعما تكبدوه من مصاريف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_310> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_310_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_310_19750926_OpEnact_e31f996a8a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_310_obligation_0_8e6ced89> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "310" ;
    dzdoc:position 323 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_310_condition_0_f1d7bc51> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_313> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_5_sec_3_subsec_3> ;
    dzdoc:eId "art_313" ;
    dzdoc:fullText "يبدأ سريان التقادم في الحقوق المذكورة في المادتين 309 و 311 من الوقت الذي يتم فيه الدائنون تقديم خدماتهم ولو استمروا في أداء خدمات أخرى. وإذا حرر سند بحق من هذه الحقوق فلا يتقادم الحق الا بانقضاء خمسة (15) عشرة سنة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_313> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_313_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_313_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_313_19750926_OpEnact_bf67a54aea> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "313" ;
    dzdoc:position 326 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_309>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_311> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_309>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_311> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_313_condition_0_8baa50ad> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_331> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_331" ;
    dzdoc:fullText "لا تكون الدفاتر والأوراق المنزلية حجة على من صدرت منه الا في الحالتين الآتيتين: إذا ذكر فيها صراحة أنه استوفي دينا ، إذا ذكر فيها صراحة أنه قصد بما دونه في هذه الدفاتر والأوراق أن تقوم مقام السند لمن أثبتت حقا لمصلحته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_331> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_331_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_331_19750926_OpEnact_cb0fdfe256> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 331" ;
    dzdoc:position 355 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_331_condition_0_29d2689d>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_331_condition_1_6326f169> ;
    dzdoc:usesTerm dzterm:household_books .

<https://legal.dz/resource/order/1975-09-26/75-58#art_332> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_1> ;
    dzdoc:eId "art_332" ;
    dzdoc:fullText "التأشير على سند بما يستفاد منه براءة ذمة المدين حجة على الدائن إلى أن يثبت العكس ولو لم يكن التأشير موقعا منه ما دام السند لم يخرج قط من حيازته. وكذلك يكون الحكم إذا اثبت الدائن بخطه دون توقيع ما يستفاد منه براءة ذمة المدين في نسخة أصلية أخرى، أو في مخالصة وكانت النسخة أو المخالصة في يد المدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_332> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_332_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_332_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_332_19750926_OpEnact_5a13162b91> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 332" ;
    dzdoc:position 356 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_332_condition_0_0a1d4cdc> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_347> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_6_sec_5> ;
    dzdoc:eId "art_347" ;
    dzdoc:fullText "كل من وجهت إليه اليمين فنكل عنها دون ردها على خصمه وكل من ردت عليه اليمين فنكل عنها ، خسر دعواه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_347> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_347_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_347_19750926_OpEnact_4b07300b6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "347" ;
    dzdoc:position 371 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_347_condition_0_52c97b5e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_369> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_369" ;
    dzdoc:fullText "إذا هلك المبيع قبل تسليمه بسبب لا يد للبائع فيه سقط البيع واسترد المشتري الثمن الا إذا وقع الهلاك بعد اعدار المشتري بتسليم المبيع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_369> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_369_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_369_19750926_OpEnact_b5dae113f7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 369" ;
    dzdoc:position 393 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_369_condition_0_2e46499e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_369_condition_1_6e03089c> ;
    dzdoc:usesTerm dzterm:buyer,
        dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_370> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_370" ;
    dzdoc:fullText "إذا نقصت قيمة المبيع قبل التسليم لتلف أصابه جاز للمشتري اما أن يطلب فسخ البيع إذا كان النقص جسيما بحيث لو طرأ قبل العقد لما أتم البيع واما أن يبقي البيع مع انقاص الثمن."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_370> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_370_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_370_19750926_OpEnact_b1684311d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 370" ;
    dzdoc:position 394 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_370_condition_0_f344c3b9>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_370_condition_1_8f1daea4> ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_374> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_374" ;
    dzdoc:fullText "عندما يتجنب المشتري نزع اليد عن الشيء المبيع كله أو بعضه بدفع مبلغ من النقود أو باداء شيء آخر ، فعلى البائع أن يتخلص من نتائج الضمان بأن يرد للمشتري ما دفعه من النقود أو قيمة ما أداه من شيء آخر مع مصاريف الخصام ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_374> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_374_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_374_19750926_OpEnact_c77034d1dc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_374_obligation_0_2f599943> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 374" ;
    dzdoc:position 398 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_374_condition_0_09fca65b> ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_381> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_381" ;
    dzdoc:fullText "إذا أخبر المشتري البائع بالعيب الموجود في المبيع في الوقت الملائم كان له الحق في المطالبة بالضمان وفقا ل المادة 376 ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_381_right_0_c36e310c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_381> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_381_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_381_19750926_OpEnact_b92387047b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 381" ;
    dzdoc:position 405 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_376> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_376> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_381_condition_0_a6656865> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_389> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_389" ;
    dzdoc:fullText "يستحق المشتري انتفاع وايراد الشيء المبيع ، كما يتحمل تكاليفه من يوم انعقاد البيع ، هذا ما لم يوجد اتفاق أو عرف يقضيان بخلاف ذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_389_right_0_49f2c813> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_389> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_389_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_389_19750926_OpEnact_c0ad1888b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_389_obligation_0_6afea97c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 389" ;
    dzdoc:position 413 ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_392> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_392" ;
    dzdoc:fullText "في بيع العروض وغيرها من المنقولات إذا عين أجل لدفع الثمن وتسلم المبيع يكون البيع مفسوخا وجوبا في صالح البائع ودون سابق انذار إذا لم يدفع الثمن عند حلول الأجل وهذا ما لم يوجد اتفاق على خلاف ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_392> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_392_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_392_19750926_OpEnact_a304c272fe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_392_obligation_0_bbd108c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 392" ;
    dzdoc:position 416 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_392_condition_0_7b453b82> ;
    dzdoc:usesTerm dzterm:seller .

<https://legal.dz/resource/order/1975-09-26/75-58#art_393> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_393" ;
    dzdoc:fullText "أن نفقات التسجيل، والطابع ورسوم الاعلان العقاري، والتوثيق وغيرها تكون على المشتري ما لم تكن هناك نصوص قانونية تقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_393> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_393_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_393_19750926_OpEnact_2bb20e671e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_393_obligation_0_c495d87b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 393" ;
    dzdoc:position 417 ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_395> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_1> ;
    dzdoc:eId "art_395" ;
    dzdoc:fullText "أن نفقات تسلم المبيع تكون على المشتري ما لم يوجد عرف أو اتفاق يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_395> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_395_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_395_19750926_OpEnact_6afd3b0a19> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_395_obligation_0_3bc5e034> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 395" ;
    dzdoc:position 419 ;
    dzdoc:usesTerm dzterm:buyer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_399> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_399" ;
    dzdoc:fullText "إذا أبطل البيع في صالح المشتري بمقتضى حكم وكان المشتري يجهل أن البائع كان لا يملك المبيع فله أن يطالب بالتعويض ولو كان البائع حسن النية."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_399_right_0_edb711cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_399> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_399_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_399_19750926_OpEnact_aa073e57e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 399" ;
    dzdoc:position 423 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_399_condition_0_1a212c08> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_405> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_405" ;
    dzdoc:fullText "إذا بيعت تركة فلا يسري البيع في حق الغير الا إذا قام المشتري بالاجراءات الواجبة لنقل كل حق اشتملت عليه التركة فإذا نص القانون على اجراءات لنقل الحقوق المذكورة بين المتعاقدين وجب أيضا أن تتم هذه الاجراءات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_405> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_405_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_405_19750926_OpEnact_68ebb73694> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_405_obligation_0_01e6fb5f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 405" ;
    dzdoc:position 429 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_405_condition_0_c70190a4> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_406> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_406" ;
    dzdoc:fullText "إذا كان البائع قد استوفي ما للتركة من ديون أو باع شيئا منها وجب أن يرد للمشتري ماقبضه ، ما لم يكن قد اشترط صراحة عدم الرد وقت انعقاد البيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_406> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_406_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_406_19750926_OpEnact_68f99df5b5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_406_obligation_0_ad883d80> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 406" ;
    dzdoc:position 430 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_406_condition_0_95d99b23> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_409> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_1_subsec_2> ;
    dzdoc:eId "art_409" ;
    dzdoc:fullText "لا تسري أحكام المادة 408 على الغير الحسن النية إذا كان الغير قد كسب بعوض حقا عينيا على الشيء المبيع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_409> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_409_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_409_19750926_OpEnact_337e013dbe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 409" ;
    dzdoc:position 433 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_408> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_408> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_409_condition_0_27f15568> ;
    dzdoc:usesTerm dzterm:third_party .

<https://legal.dz/resource/order/1975-09-26/75-58#art_421> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_421" ;
    dzdoc:fullText "إذا كانت حصة الشريك مبلغا من النقود يقدمها للشركة ولم يقدم هذا المبلغ ففي هذه الحالة يلزمه التعويض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_421> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_421_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_421_19750926_OpEnact_133b3ae0a7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_421_obligation_0_7e198fd2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 421" ;
    dzdoc:position 445 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_421_condition_0_cc34da7f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_422> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_422" ;
    dzdoc:fullText "إذا كانت حصة الشريك حق ملكية أو حق منفعة أو أي حق عيني آخر فإن أحكام البيع هي التي تسري فيما يخص ضمان الحصة إذا هلكت أو استحقت أو ظهر فيها عيب أو نقص أما إذا كانت الحصة مجرد انتفاع بالمال فإن أحكام الإيجار هي التي تسري في ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_422> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_422_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_422_19750926_OpEnact_9b86d6dc74> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 422" ;
    dzdoc:position 446 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_422_condition_0_0bc72373>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_422_condition_1_89fa6e5e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_424> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_1> ;
    dzdoc:eId "art_424" ;
    dzdoc:fullText "إذا كانت الحصة التي قدمها الشريك هي ديون له في ذمة الغير فلا ينقض التزامه للشركة إلا إذا استوفيت هذه الديون ومع ذلك يبقى الشريك مسؤولا عن تعويض الضرر إذا لم توف الديون عند حلول أجلها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_424> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_424_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_424_19750926_OpEnact_8003d478d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 424" ;
    dzdoc:position 448 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_424_condition_0_3c1b7b3e>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_424_condition_1_3c8f5dcb> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_433> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_3> ;
    dzdoc:eId "art_433" ;
    dzdoc:fullText "إذا أخذ الشريك أو احتجز مبلغا من مال الشركة وجب عليه إذا اقتضى الحال ذلك تعويض الشركة عن الضرر الذي لحقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_433> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_433_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_433_19750926_OpEnact_3360b16adc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_433_obligation_0_571950a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "433" ;
    dzdoc:position 457 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_433_condition_0_4ea9bbf0> ;
    dzdoc:usesTerm dzterm:company,
        dzterm:partner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_1_chp_2_sec_1> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يخضع فاقد الأهلية، وناقصوها، بحسب الأحوال لأحكام الولاية، أو الوصاية، أو القوامة ، ضمن الشروط ووفقا للقواعد المقررة في القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_44_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_44_19750926_OpEnact_4e50bd13b3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_44_obligation_0_6bea3a86> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 44" ;
    dzdoc:position 50 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_44_condition_0_8a8c6a79> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_443> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_3_subsec_5> ;
    dzdoc:eId "art_443" ;
    dzdoc:fullText "تتم تصفية أموال الشركة وقسمتها بالطريقة المبينة في العقد ، فإن خلا من حكم خاص تتبع الأحكام التالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_443> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_443_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_443_19750926_OpEnact_6e8754f77a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_443_obligation_0_2e0890b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 443" ;
    dzdoc:position 467 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_443_condition_0_671bda52> ;
    dzdoc:usesTerm dzterm:company .

<https://legal.dz/resource/order/1975-09-26/75-58#art_464> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_7_sec_5_subsec_2> ;
    dzdoc:eId "art_464" ;
    dzdoc:fullText "يجب أن تفسر عبارات التنازل التي يتضمنها الصلح تفسيرا ضيقا أيا كانت تلك العبارات فإن التنازل لا يشمل الا الحقوق التي كانت بصفة جلية محلا للنزاع الذي حسمه الصلح ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_464> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_464_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_464_19750926_OpEnact_de2ebeab90> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_464_obligation_0_8fee7331> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "464" ;
    dzdoc:position 488 ;
    dzdoc:usesTerm dzterm:disputed_rights,
        dzterm:settlement .

<https://legal.dz/resource/order/1975-09-26/75-58#art_487> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_487" ;
    dzdoc:fullText "لا يضمن المؤجر للمستأجر التعرض المادي الصادر من الغير الذي لا يدعي حقا على العين المؤجرة، و للمستأجر أن يطالب شخصيا المتعرض بالتعويض عن الضرر الذي لحقه ، وله أن يمارس ضده كل دعاوى الحيازة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_487_right_0_af98ed35>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_487_right_1_e76525f4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_487> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_487_para_0> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_487_19750926_OpEnact_e5f0422f67> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 487" ;
    dzdoc:position 517 ;
    dzdoc:usesTerm dzterm:lessee,
        dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_490> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_8_sec_1_subsec_1> ;
    dzdoc:eId "art_490" ;
    dzdoc:fullText "يبطل كل اتفاق يتضمن الإعفاء أو التحديد من الضمان بسبب التعرض القانوني. يبطل كل اتفاق يتضمن الاعفاء أو التخفيف من ضمان العيوب إذا أخفاها المؤجر غشا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_490> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_490_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_490_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_490_19750926_OpEnact_cf342ef429> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 490" ;
    dzdoc:position 520 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_490_condition_0_28e8acf9> ;
    dzdoc:usesTerm dzterm:lessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_551> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_1> ;
    dzdoc:eId "art_551" ;
    dzdoc:fullText "إذا تعهد المقاول بتقديم مادة العمل كلها أو بعضها كان مسؤولا عن جودتها وعليه ضمانها لرب العمل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_551> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_551_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_551_19750926_OpEnact_adc871a8b8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_551_obligation_0_916189cc> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "551" ;
    dzdoc:position 578 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_551_condition_0_a3bd0426> ;
    dzdoc:usesTerm dzterm:contractor,
        dzterm:employer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_559> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_2> ;
    dzdoc:eId "art_559" ;
    dzdoc:fullText "تدفع الأجرة عند تسلم العمل الا إذا اقتضى العرف أو الاتفاق خلاف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_559> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_559_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_559_19750926_OpEnact_fd37f15017> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_559_obligation_0_c88df8b9> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "559" ;
    dzdoc:position 586 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_559_condition_0_71a3ce3b> ;
    dzdoc:usesTerm dzterm:wage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_562> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_1_subsec_2> ;
    dzdoc:eId "art_562" ;
    dzdoc:fullText "إذا لم يحدد الأجر سلفا وجب الرجوع في تحديده إلى قيمة العمل ونفقات المقاول ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_562> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_562_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_562_19750926_OpEnact_137615ed63> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_562_obligation_0_d8847aec> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "562" ;
    dzdoc:position 589 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_562_condition_0_5b24ce1b> ;
    dzdoc:usesTerm dzterm:contractor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_593> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_3_subsec_1> ;
    dzdoc:eId "art_593" ;
    dzdoc:fullText "ليس للمودع لديه أن يحل غيره محله في حفظ الوديعة دون إذن صريح من المودع الا أن يكون مضطرا إلى ذلك بسبب ضرورة ملحة وعاجلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_593> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_593_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_593_19750926_OpEnact_4473f94d12> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 593" ;
    dzdoc:position 630 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_593_condition_0_d6194d11>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_593_condition_1_22088e6d> ;
    dzdoc:usesTerm dzterm:bailee,
        dzterm:bailor,
        dzterm:deposit .

<https://legal.dz/resource/order/1975-09-26/75-58#art_611> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_9_sec_4> ;
    dzdoc:eId "art_611" ;
    dzdoc:fullText "تنتهي الحراسة باتفاق ذوي الشأن جميعا أو بحكم القضاء وعلى الحارس حينئذ أن يبادر إلى رد الشيء المعهود إليه حر استه إلى من يختاره ذوو الشأن أو من يعينه القاضي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_611> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_611_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_611_19750926_OpEnact_227c5ddd09> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_611_obligation_0_e69ec78a> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "611" ;
    dzdoc:position 648 ;
    dzdoc:usesTerm dzterm:حارس .

<https://legal.dz/resource/order/1975-09-26/75-58#art_616> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_2> ;
    dzdoc:eId "art_616" ;
    dzdoc:fullText "لا يصح أن يشترط عدم جواز الحجز على المرتب الا إذا كان قد قرر على سبيل التبرع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_616> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_616_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_616_19750926_OpEnact_16983eb958> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 616" ;
    dzdoc:position 653 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_616_condition_0_fdd5a5a5> ;
    dzdoc:usesTerm dzterm:pension .

<https://legal.dz/resource/order/1975-09-26/75-58#art_619> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:insurance_contract ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_10_sec_3_subsec_1> ;
    dzdoc:eId "art_619" ;
    dzdoc:fullText "التأمين عقد يلتزم المؤمن بمقتضاه أن يؤدي إلى المؤمن له أو إلى المستفيد الذي اشترط التأمين لصالحه مبلغا من المال أو ايرادا أو أي عوض مالي آخر في حالة وقوع الحادث أو تحقق الخطر المبين بالعقد وذلك مقابل قسط أو أية دفعة مالية أخرى يؤديها المؤمن له للمؤمن . معين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_619> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_619_defocc_1c0c918736e0> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_619_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_619_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_619_19750926_OpEnact_a8e7642bf6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "619" ;
    dzdoc:position 656 ;
    dzdoc:usesTerm dzterm:beneficiary,
        dzterm:insurance,
        dzterm:insured,
        dzterm:insurer .

<https://legal.dz/resource/order/1975-09-26/75-58#art_646> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_646" ;
    dzdoc:fullText "إذا التزم المدين بتقديم كفيل ، وجب أن يقدم شخصا موسرا ومقيما بالجزائر ، وله أن يقدم عوضا عن الكفيل، تأمينا عينيا كافيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_646> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_646_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_646_19750926_OpEnact_0c6cd40d3f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_646_obligation_0_c8369ca0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "646" ;
    dzdoc:position 683 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_646_condition_0_6ba9e815> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_649> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_الاول> ;
    dzdoc:eId "art_649" ;
    dzdoc:fullText "من كفل التزام ناقص الأهلية وكانت الكفالة بسبب نقص الأهلية ، كان ملزما بتنفيذ الالتزام إذا لم ينفذه المدين المكفول ، باستثناء الحالة المنصوص عليها في الفقرة الثانية من المادة 654 ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_649> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_649_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_649_19750926_OpEnact_4d39166e89> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_649_obligation_0_c71e78e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "649" ;
    dzdoc:position 686 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_654> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_654> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_649_condition_0_fcd35a80> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "إذا اتفق الطرفان على جميع المسائل الجوهرية في العقد واحتفظا بمسائل تفصيلية يتفقان عليها فيما بعد ولم يشترطا أن لا أثر للعقد عند عدم الاتفاق عليها ، اعتبر العقد منبرما وإذا قام خلاف على المسائل التي لم يتم الاتفاق عليها، فإن المحكمة تقضي فيها طبقا لطبيعة المعاملة ولأحكام القانون، والعرف، والعدالة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_65_19750926_OpEnact_ba50141104> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 71 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_65_condition_0_3112c430> ;
    dzdoc:usesTerm dzterm:contract .

<https://legal.dz/resource/order/1975-09-26/75-58#art_655> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_1> ;
    dzdoc:eId "art_655" ;
    dzdoc:fullText "إذا قبل الدائن شيئا آخر في مقابل الدين برئت بذلك ذمة الكفيل ولو استحق هذا الشيء ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_655_right_0_18aa61a2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_655> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_655_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_655_19750926_OpEnact_f6ee5d8ee1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 655" ;
    dzdoc:position 692 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_655_condition_0_0e16e229> ;
    dzdoc:usesTerm dzterm:creditor,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_672> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_11_sec_2_subsec_2> ;
    dzdoc:eId "art_672" ;
    dzdoc:fullText "يكون للكفيل الذي وفي الدين أن يرجع على المدين سواء كانت الكفالة قد عقدت بعلمه أو بغيرعلمه ويرجع بأصل الدين والمصروفات غير أنه فيما يخص المصروفات لا يرجع الكفيل الا بالذي دفعه من وقت إخبار المدين الأصلي بالاجراءات التي اتخذت ضده."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_672_right_0_acc5144c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_672> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_672_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_672_19750926_OpEnact_81e5aeeebe> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "672" ;
    dzdoc:position 709 ;
    dzdoc:usesTerm dzterm:debtor,
        dzterm:guarantee,
        dzterm:guarantor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_674> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:property_right ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_674" ;
    dzdoc:fullText "الملكية هي حق المتمتع والتصرف في الأشياء بشرط أن لا يستعمل استعمالا تحرمه القوانين والأنظمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_674> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_674_defocc_0a2ac688fc14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_674_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_674_19750926_OpEnact_f120fc69a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 674" ;
    dzdoc:position 711 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_674_condition_0_d89cd2db> ;
    dzdoc:usesTerm dzterm:property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_681> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_1> ;
    dzdoc:eId "art_681" ;
    dzdoc:fullText "ينفذ الاستيلاء مباشرة أو من قبل رئيس المجلس الشعبي البلدي. ويمكن في الحالات التي تقتضي ذلك ، تنفيذه بالقوة بطريقة إدارية دون الاخلال بالعقوبات المدنية والجزائية التي أقرها التشريع المعمول به."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_681_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_681_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_19750926_OpEnact_3078852230> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 681" ;
    dzdoc:position 718 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_681_condition_0_d2df248f> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_685> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:consumable_things ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_2> ;
    dzdoc:eId "art_685" ;
    dzdoc:fullText "الأشياء القابلة للاستهلاك هي التي ينحصر استعمالها بحسب ما أعدت له، في استهلاكها أو انفاقها . ويعتبر قابلا للاستهلاك كل شيء يكون جزءا من المحل التجاري وهو معد للبيع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_685> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_685_defocc_0029c5a25065> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_685_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_685_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_685_19750926_OpEnact_a85ce085a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "685" ;
    dzdoc:position 725 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_696> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_3> ;
    dzdoc:eId "art_696" ;
    dzdoc:fullText "يجب أن يؤخذ حق المرور من الجهة التي تكون فيها المسافة بين العقار والطريق العام ملائمة والتي تحقق أقل ضرر بالملاك المجاورين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_696> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_696_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_696_19750926_OpEnact_7fc38894e4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_696_obligation_0_22952ae6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "696" ;
    dzdoc:position 736 ;
    dzdoc:usesTerm dzterm:right_of_way .

<https://legal.dz/resource/order/1975-09-26/75-58#art_715> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_715" ;
    dzdoc:fullText "تكون إدارة المال الشائع من حق الشركاء مجتمعين ما لم يوجد اتفاق يخالف ذلك ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_715_right_0_17151fa5> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_715> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_715_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_715_19750926_OpEnact_921672beac> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 715" ;
    dzdoc:position 755 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_715_condition_0_b959ad9e> ;
    dzdoc:usesTerm dzterm:management .

<https://legal.dz/resource/order/1975-09-26/75-58#art_723> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_723" ;
    dzdoc:fullText "يستطيع الشركاء إذا انعقد إجماعهم، أن يقتسموا المال الشائع بالطريقة التي يرونها . فإذا كان بينهم من هو ناقص وجبت مراعاة الاجراءات التي يفرضها القانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_723_right_0_48d8a286> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_723> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_723_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_723_19750926_OpEnact_170774da6a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_723_obligation_0_2819d4e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 723" ;
    dzdoc:position 763 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_724> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_724" ;
    dzdoc:fullText "إذا اختلف الشركاء في اقتسام المال الشائع فعلى من يريد الخروج من الشيوع أن يرفع الدعوى على باقي الشركاء أمام المحكمة. وتعين المحكمة إن رأت وجها لذلك خبيرا أو أكثر لتقويم المال الشائع وقسمته حصصا إن كان المال يقبل القسمة عينا دون أن يلحقه نقص كبير في قيمته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_724> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_724_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_724_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_724_19750926_OpEnact_3728b2048b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 724" ;
    dzdoc:position 764 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_724_condition_0_e3246fc6> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_735> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_735" ;
    dzdoc:fullText "تخضع قسمة المهايأة من حيث جواز الاحتجاج بها على الغير ومن حيث أهلية المتقاسمين وحقوقهم والتزاماتهم وطرق الاثبات لأحكام عقد الإيجار ، ما دامت هذه الأحكام لا تتعارض مع طبيعة هذه القسمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_735> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_735_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_735_19750926_OpEnact_989d6ca467> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_735_obligation_0_fbf9993c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "735" ;
    dzdoc:position 775 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_738> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_738" ;
    dzdoc:fullText "لأعضاء الأسرة الواحدة الذين تجمعهم وحدة العمل أو المصلحة أن يتفقوا كتابة على إنشاء ملكية للأسرة . وتتكون هذه الملكية إما من تركة ورثوها واتفقوا على جعلها كلها أو بعضها ملكا للأسرة وإما من أي مال آخر لهم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_738_right_0_d05e72ea> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_738> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_738_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_738_19750926_OpEnact_8f496416f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "738" ;
    dzdoc:position 778 ;
    dzdoc:usesTerm dzterm:family_property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_742> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_4> ;
    dzdoc:eId "art_742" ;
    dzdoc:fullText "فيما عدا الأحكام السابقة تنطبق قواعد الملكية الشائعة وقواعد الوكالة على ملكية الأسرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_742> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_742_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_742_19750926_OpEnact_09eb6b1378> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_742_obligation_0_7a16cd6e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "742" ;
    dzdoc:position 782 ;
    dzdoc:usesTerm dzterm:agency,
        dzterm:common_property,
        dzterm:family_property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_749> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_749" ;
    dzdoc:fullText "لكل شريك في الملكية الحق في أن يتمتع بالأجزاء الخاصة التابعة لحصته له أن يستعمل وينتفع بحرية بالأجزاء الخاصة والمشتركة ، بشرط أن لا يمس بحقوق الشركاء الآخرين في الملكية أو يلحق ضررا بما أعد له العقار ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_749_right_0_1e1f80da> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_749> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_749_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_749_19750926_OpEnact_7da3f6b629> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 749" ;
    dzdoc:position 789 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_749_condition_0_e61e48aa> ;
    dzdoc:usesTerm dzterm:partner .

<https://legal.dz/resource/order/1975-09-26/75-58#art_764> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:administrator_role ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_1_subsec_5> ;
    dzdoc:eId "art_764" ;
    dzdoc:fullText "تتخذ قرارات الجمعية عن طريق الاقتراع بالأغلبية البسيطة أو الأغلبية المحددة، ويتكفل بتنفيذ هذه القرارات متصرف العقار ، الذي يوضع مباشرة تحت مراقبة الجمعية . يعد هذا المتصرف ، وكيلا للجمعية ، ويمثلها لدى القضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_764_defocc_34445bab060a> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_764_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_764_para_1> ;
    dzdoc:hasStatus dzdoc:StatusModified ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_764_19750926_OpEnact_b79a185810> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 764" ;
    dzdoc:position 812 ;
    dzdoc:usesTerm dzterm:administrator,
        dzterm:association .

<https://legal.dz/resource/order/1975-09-26/75-58#art_777> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_777" ;
    dzdoc:fullText "يعتبر التصرف وصية وتجري عليه أحكامها إذا تصرف شخص لأحد ورثته واستثنى لنفسه بطريقة ما حيازة الشيء المتصرف فيه والانتفاع به مدة حياته ما لم يكن هناك دليل يخالف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_777> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_777_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_777_19750926_OpEnact_8dd46c427b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "777" ;
    dzdoc:position 828 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_777_condition_0_d437f92c>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_777_condition_1_3cfbbe8a> ;
    dzdoc:usesTerm dzterm:will .

<https://legal.dz/resource/order/1975-09-26/75-58#art_792> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_4> ;
    dzdoc:eId "art_792" ;
    dzdoc:fullText "تنقل الملكية وغيرها من الحقوق العينية في العقار بالعقد متى كان الشيء مملوكا للمتصرف طبقا للمادة 164 وذلك مع مراعاة النصوص التالية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_792> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_792_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_792_19750926_OpEnact_dfad596b7e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_792_obligation_0_6c2ae82f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "792" ;
    dzdoc:position 843 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_164> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_164> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_792_condition_0_81fb7389> ;
    dzdoc:usesTerm dzterm:ownership,
        dzterm:real_rights .

<https://legal.dz/resource/order/1975-09-26/75-58#art_793> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_4> ;
    dzdoc:eId "art_793" ;
    dzdoc:fullText "لا تنقل الملكية و الحقوق العينية الأخرى في العقار سواء كان ذلك بين المتعاقدين أم في حق الغير إلا إذا روعيت الاجراءات التي ينص عليها القانون وبالأخص القوانين التي تدير مصلحة شهر العقار ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_793> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_793_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_793_19750926_OpEnact_9dbff27349> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_793_obligation_0_7d41143b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "793" ;
    dzdoc:position 844 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_793_condition_0_ced7981f> ;
    dzdoc:usesTerm dzterm:ownership,
        dzterm:real_rights .

<https://legal.dz/resource/order/1975-09-26/75-58#art_794> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:شفعة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_5> ;
    dzdoc:eId "art_794" ;
    dzdoc:fullText "الشفعة رخصة تجيز الحلول محل المشتري في بيع العقار ضمن الأحوال والشروط المنصوص عليها في المواد التالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_794> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_794_defocc_a261e639f542> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_794_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_794_19750926_OpEnact_f7415b5789> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 794" ;
    dzdoc:position 845 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_794_condition_0_698fb66e> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_808> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_808" ;
    dzdoc:fullText "لا تقوم الحيازة على عمل يأتيه الغير على أنه مجرد رخصة أو على عمل يتحمله على سبيل التسامح. إذا اقترنت الحيازة بإكراه أو حصلت خفية أو كان فيها التباس فلا يكون لها أثر تجاه من وقع عليه الاكراه أو أخفيت عنه الحيازة أو إلتبس عليه أمرها الا من الوقت الذي تزول فيه هذه العيوب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_808> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_808_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_808_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_808_19750926_OpEnact_6f77e74285> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 808" ;
    dzdoc:position 859 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_808_condition_0_e9962405> ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_810> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_810" ;
    dzdoc:fullText "تصح الحيازة بالوساطة متى كان الوسيط يباشرها باسم الحائز وكان متصلا به اتصالا يلزمه الائتمار بأوامره فيما يتعلق بهذه الحيازة وذلك كله مع مراعاة أحكام الأمر الصادر في شأن الثورة الزراعية. وعند الشك يفترض أن مباشر الحيازة إنما يحوز لنفسه فإن كانت الحيازة استمرارا الحيازة سابقة افترض أن هذا الاستمرار هو لحساب البادئ بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_810> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_810_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_810_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_810_19750926_OpEnact_a4645a9980> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 810" ;
    dzdoc:position 861 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_810_condition_0_a389db0c> ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_813> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_813" ;
    dzdoc:fullText "تسليم السندات المعطاة عن البضائع المعهود بها إلى أمين النقل أو المودعة في المخازن يقوم مقام تسليم البضائع ذاتها. غير أنه إذا تسلم شخص السندات وتسلم آخر البضائع ذاتها وكان كلاهما حسن النية فإن الأفضلية تكون لمن تسلم البضائع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_813> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_813_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_813_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_813_19750926_OpEnact_12216fa933> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 813" ;
    dzdoc:position 864 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_813_condition_0_09902716> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_815> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_815" ;
    dzdoc:fullText "تزول الحيازة إذا تخلى الحائز عن سيطرته الفعلية على الحق أي إذا فقد هذه السيطرة بأية طريقة أخرى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_815> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_815_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_815_19750926_OpEnact_fe867ae24b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 815" ;
    dzdoc:position 866 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_815_condition_0_c15012f1> ;
    dzdoc:usesTerm dzterm:possession .

<https://legal.dz/resource/order/1975-09-26/75-58#art_819> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_819" ;
    dzdoc:fullText "للحائز أن يرفع في الميعاد القانوني دعوى استرداد الحيازة على من انتقلت إليه حيازة الشيء المغتصب منه ولو كان هذا الأخير حسن النية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_819_right_0_2defe439> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_819> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_819_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_819_19750926_OpEnact_a5202a358f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "819" ;
    dzdoc:position 870 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_825> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:bad_faith ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_825" ;
    dzdoc:fullText "لا تزول صفة حسن النية من الحائز الا من الوقت الذي يعلم فيه أن حيازته اعتداء على حق الغير. ويزول حسن النية من وقت إعلان الحائز بعيوب حيازته بعريضة افتتاح الدعوى، و يعد سيئ النية من اغتصب حيازة الغير بالاكراه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_825> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_825_defocc_0feaebc819f4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_825_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_825_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_825_19750926_OpEnact_0074b3394e> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "825" ;
    dzdoc:position 876 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_827> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_827" ;
    dzdoc:fullText "من حاز منقولا أو عقارا أو حقا عينيا منقولا كان أو عقارا دون أن يكون مالكا له أو خاصا به صار له ذلك ملكا إذا استمرت حيازته له مدة خمسة عشرة (15) سنة بدون انقطاع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_827_right_0_10bdcb50> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_827> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_827_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_827_19750926_OpEnact_8f552ea892> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "827" ;
    dzdoc:position 878 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_827_condition_0_405edb04> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_831> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_831" ;
    dzdoc:fullText "ليس لأحد أن يكسب بالتقادم على خلاف سنده على أنه لا يستطيع أحد أن يغير بنفسه لنفسه سبب حيازته ولا الأصل الذي تقوم عليه. غیر أنه يستطيع أن يكسب بالتقادم إذا تغيرت صفة حيازته إما بفعل الغير أو بفعل منه يعتبر معارضة لحق المالك ولكن في هذه الحالة لا تسري مدة التقادم إلا من تاريخ هذا التغيير."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_831_right_0_edbc8f05> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_831> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_831_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_831_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_831_19750926_OpEnact_7238e2825b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 831" ;
    dzdoc:position 882 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_837> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_1_sec_2_subsec_6> ;
    dzdoc:eId "art_837" ;
    dzdoc:fullText "يكسب الحائز ما يقبضه من الثمار ما دام حسن النية . وتعتبر الثمار الطبيعية أو الصناعية مقبوضة من يوم فصلها. أما الثمار المدنية فتعتبر مقبوضة يوما فيوما."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_837_right_0_5ee58eb3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_837> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_837_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_837_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_837_19750926_OpEnact_70cf6d9575> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 837" ;
    dzdoc:position 888 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "لا يؤثر في صحة العقد مجرد الغلط في الحساب ولا غلطات القلم، ولكن يجب تصحيح الغلط ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_84_19750926_OpEnact_659a9fda40> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_84_obligation_0_601f5580> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 84" ;
    dzdoc:position 91 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "ليس لمن وقع في غلط أن يتمسك به على وجه يتعارض مع ما يقضي به حسن النية . ويبقى بالأخص ملزما بالعقد قصد إبرامه إذا أظهر الطرف الآخر استعداده لتنفيذ هذا العقد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_85_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_85_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_85_19750926_OpEnact_7330cd995b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 85" ;
    dzdoc:position 92 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_85_condition_0_5e48924f> ;
    dzdoc:usesTerm dzterm:good_faith .

<https://legal.dz/resource/order/1975-09-26/75-58#art_867> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:definesTerm dzterm:الارتفاق ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_867" ;
    dzdoc:fullText "الارتفاق حق يجعل حدا لمنفعة عقار لفائدة عقار آخر لشخص آخر ويجوز أن يترتب الارتفاق على مال أن كان لا يتعارض مع الاستعمال الذي خصص له هذا المال ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_867> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/order/1975-09-26/75-58#art_867_defocc_b00cc6dbde27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_867_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_867_19750926_OpEnact_b9960ea0b1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "867" ;
    dzdoc:position 918 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_867_condition_0_19b42e2a> ;
    dzdoc:usesTerm dzterm:الارتفاق .

<https://legal.dz/resource/order/1975-09-26/75-58#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "إذا صدر التدليس من غير المتعاقدين ، فليس للمتعاقد المدلس عليه أن يطلب إبطال العقد، ما لم يثبت أن المتعاقد الآخر كان يعلم ، أو كان من المفروض حتما أن يعلم بهذا التدليس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_87_19750926_OpEnact_330893e8c2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 87" ;
    dzdoc:position 94 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_87_condition_0_12692d91>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_87_condition_1_d99dccec> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_873> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_873" ;
    dzdoc:fullText "لا يلزم مالك العقار المرتفق به أن يقوم بمنشآت لمصلحة العقار المرتفق الا إذا كانت المنشآت إضافية يقتضيها استعمال الارتفاق على الوجه المألوف ما لم يوجد شرط يخالف ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_873> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_873_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_873_19750926_OpEnact_d914dc1619> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "873" ;
    dzdoc:position 924 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_873_condition_0_a0785883> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_878> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_3_chp_2_sec_2> ;
    dzdoc:eId "art_878" ;
    dzdoc:fullText "تنتهي حقوق الارتفاق بانقضاء الأجل المحدد، وبهلاك العقار المرتفق به هلاكا تاما أو باجتماع العقار المرتفق به و العقار المرتفق في يد مالك واحد ، و يعود حق الارتفاق إذا زال اجتماع العقارين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_878_right_0_e9812834> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_878> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_878_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_878_19750926_OpEnact_8fd620ab4b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_878_obligation_0_61600033> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "878" ;
    dzdoc:position 929 ;
    dzdoc:usesTerm dzterm:easement,
        dzterm:property .

<https://legal.dz/resource/order/1975-09-26/75-58#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "إذا صدر الاكراه من غير المتعاقدين ، فليس للمتعاقد المكره أن يطلب إبطال العقد الا إذا اثبت أن المتعاقد الآخر كان يعلم أو كان من المفروض حتما أن يعلم بهذا الاكراه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_89_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_89_19750926_OpEnact_cae6ab86d2> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 89" ;
    dzdoc:position 96 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_89_condition_0_81351996>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_89_condition_1_8463f137> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_892> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_1> ;
    dzdoc:eId "art_892" ;
    dzdoc:fullText "كل جزء من العقار أو العقارات المرهونة ضامن لكل دين وكل جزء من الدين مضمون بالعقار أو العقارات المرهونة كلها ، ما لم ينص القانون أو يقضي الاتفاق بغير ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_892> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_892_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_892_19750926_OpEnact_c87bd856dc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_892_obligation_0_6767e72f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "892" ;
    dzdoc:position 943 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_892_condition_0_a07f73db> ;
    dzdoc:usesTerm dzterm:real_estate .

<https://legal.dz/resource/order/1975-09-26/75-58#art_909> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_909" ;
    dzdoc:fullText "يترتب على قيد الرهن إدخال مصاريف العقد والقيد والتجديد إدخالا ضمنيا في التوزيع وفي مرتبة الرهن نفسها. وإذا سجل أحد الدائنين تنبيه نزع العقار ، انتفع سائر الدائنين بهذا التسجيل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_909> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_909_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_909_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_909_19750926_OpEnact_4c08ce0e4c> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 909" ;
    dzdoc:position 960 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_909_condition_0_85bfec27> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يراعى في تطبيق المادة 90 عدم الاخلال بالأحكام الخاصة بالغبن في بعض العقود ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_91_19750926_OpEnact_cb69a2ea50> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_91_obligation_0_05e2b99f> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 91" ;
    dzdoc:position 98 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_90> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_90> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_921> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_921" ;
    dzdoc:fullText "إذا لم يطلب بيع العقار في الأجل وبالأوضاع المقررة استقرت ملكية العقار نهائيا للحائز خالصة من كل حق مقيد، إذا هو دفع المبلغ الذي قوم له العقار بزيادة العشر للدائنين الذين تسمح مرتبتهم باستيفاء حقوقهم منه، أو هو أودع هذا المبلغ الخزينة العامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_921> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_921_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_921_19750926_OpEnact_0fcd88b976> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "921" ;
    dzdoc:position 972 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_921_condition_0_3dbd9f82>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_921_condition_1_e5a30a0e> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_927> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_2_subsec_3> ;
    dzdoc:eId "art_927" ;
    dzdoc:fullText "إذا رسا المزاد في الأحوال المتقدمة على شخص آخر غير الحائز ، فإن هذا الشخص الآخر يتلقى حقه من الحائز بمقتضى حكم مرسي المزاد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_927> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_927_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_927_19750926_OpEnact_b1f2ff1791> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "927" ;
    dzdoc:position 978 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_927_condition_0_eef3f9db> ;
    dzdoc:usesTerm dzterm:possessor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_933> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_3> ;
    dzdoc:eId "art_933" ;
    dzdoc:fullText "ينقضي حق الرهن الرسمي بانقضاء الدين المضمون و يعود معه إذا زال السبب الذي انقضى به الدين ، دون إخلال بالحقوق التي يكون الغير حسن النية كسبها في الفترة ما بين انقضاء الحق وعودته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_933_right_0_9d7f9c15> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_933> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_933_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_933_19750926_OpEnact_f1d97acf17> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_933_obligation_0_6605b5d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "933" ;
    dzdoc:position 984 ;
    dzdoc:usesTerm dzterm:mortgage,
        dzterm:third_party .

<https://legal.dz/resource/order/1975-09-26/75-58#art_934> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_1_sec_3> ;
    dzdoc:eId "art_934" ;
    dzdoc:fullText "إذا تمت اجراءات التطهير انقضى حق الرهن الرسمي نهائيا ، ولو زالت لأي سبب من الأسباب ملكية الحائز الذي طهر العقار."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_934> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_934_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_934_19750926_OpEnact_04c3ded6f2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_934_obligation_0_ef607419> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "934" ;
    dzdoc:position 985 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_934_condition_0_2b04f7f1> ;
    dzdoc:usesTerm dzterm:mortgage .

<https://legal.dz/resource/order/1975-09-26/75-58#art_945> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_2_sec_1> ;
    dzdoc:eId "art_945" ;
    dzdoc:fullText "إذا رفض رئيس المحكمة طلب التخصيص المقدم من الدائن سواء كان الرفض في بادئ الأمر أو بعد تظلم المدين ، جاز للدائن أن يتظلم من أمر الرفض إلى المجلس القضائي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_945_right_0_9a477bce> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_945> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_945_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_945_19750926_OpEnact_e5426d9623> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 945" ;
    dzdoc:position 996 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_945_condition_0_6a06c33f> ;
    dzdoc:usesTerm dzterm:court_president,
        dzterm:creditor,
        dzterm:debtor .

<https://legal.dz/resource/order/1975-09-26/75-58#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_2_chp_1_sec_2_subsec_2> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "إذا كان محل الالتزام نقودا ، التزم المدين بقدر عددها المذكور في العقد دون أن يكون لارتفاع قيمة هذه النقود أو لانخفاضها وقت الوفاء أي تأثير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_95_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_95_19750926_OpEnact_7c567873a6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_95_obligation_0_00594a2b> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 95" ;
    dzdoc:position 102 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_95_condition_0_6cbb5ad4> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_952> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_952" ;
    dzdoc:fullText "إذا رجع المرهون إلى حيازة الراهن انقضى الرهن إلا إذا أثبت الدائن المرتهن أن الرجوع كان بسبب لا يقصد به انقضاء الرهن كل هذا دون إخلال بحقوق الغير."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_952> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_952_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_952_19750926_OpEnact_ce248acb76> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "952" ;
    dzdoc:position 1003 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_952_condition_0_a7b101ee>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_952_condition_1_69da258c> ;
    dzdoc:usesTerm dzterm:دائن_مرتهن,
        dzterm:راهن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_954> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_954" ;
    dzdoc:fullText "يضمن الراهن هلاك الشيء المرهون أو تلفه إذا كان الهلاك أو التلف راجعا لخطئه أو ناشئا عن قوة قاهرة . ويسري على الرهن الحيازي أحكام المادتين 899 و 900 المتعلقة بهلاك الشيء المرهون رهنا رسميا أو تلفه، بانتقال حق الدائن من الشيء المرهون إلى ما حل محله من حقوق."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_954> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_954_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_954_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_954_19750926_OpEnact_25f36f9686> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_954_obligation_0_13b6e6c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "954" ;
    dzdoc:position 1005 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_899>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_900> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_899>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_900> ;
    dzdoc:usesTerm dzterm:دائن,
        dzterm:راهن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_955> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_955" ;
    dzdoc:fullText "إذا تسلم الدائن المرتهن الشيء المرهون فعليه أن يبذل في حفظه و وصيانته من العناية ما يبذله الشخص المعتاد وهو مسؤول عن هلاك الشيء أو تلفه ما لم يثبت أن ذلك يرجع لسبب لا يد له فيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_955> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_955_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_955_19750926_OpEnact_23bf46d159> ;
    dzdoc:imposesObligation <https://legal.dz/resource/order/1975-09-26/75-58#art_955_obligation_0_bfdc1871> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "955" ;
    dzdoc:position 1006 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_955_condition_0_dc0dbfde> ;
    dzdoc:usesTerm dzterm:دائن_مرتهن .

<https://legal.dz/resource/order/1975-09-26/75-58#art_976> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_976" ;
    dzdoc:fullText "يتم رهن السندات الاسمية أو السندات لأمر بالطريقة الخاصة المنصوص عليها قانونا بشرط أن يذكر أن الحوالة قد تمت على سبيل الرهن وبدون حاجة إلى إعلان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_976> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_976_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_976_19750926_OpEnact_99d8032fed> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "المادة 976" ;
    dzdoc:position 1027 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_976_condition_0_3e62c8f8> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_981> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_3_sec_5> ;
    dzdoc:eId "art_981" ;
    dzdoc:fullText "إذا أصبح كل من الدين المرهون والدين المضمون مستحق الأداء جاز للدائن المرتهن إذا لم يستوف حقه، أن يقبض من الدين المرهون ما يكون مستحقا له أو أن يطلب بيع هذا الدين أو تملكه وفقا للمادة 970 الفقرة الثانية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_981_right_0_fef8cf18> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_981> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_981_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_981_19750926_OpEnact_fba4c8de4d> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "981" ;
    dzdoc:position 1032 ;
    dzdoc:references <https://legal.dz/resource/order/1975-09-26/75-58#art_970> ;
    dzdoc:referencesInternal <https://legal.dz/resource/order/1975-09-26/75-58#art_970> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_981_condition_0_97fcb20a> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_983> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_983" ;
    dzdoc:fullText "مرتبة الامتياز يحددها القانون، فإذا لم يوجد نص خاص يعين مرتبة الامتياز يأتي هذا الامتياز بعد الامتيازات المنصوص عنها في هذا الباب. وإذا كانت الحقوق الممتازة في مرتبة واحدة ، فانها تستوفي عن طريق التسابق، ما لم يوجد نص قانوني يقضي بغير ذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_983> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_983_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_983_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_983_19750926_OpEnact_1bdbfb1ca1> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "983" ;
    dzdoc:position 1034 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/order/1975-09-26/75-58#art_983_condition_0_3fe71476> ;
    dzdoc:usesTerm dzterm:privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_986> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_1> ;
    dzdoc:eId "art_986" ;
    dzdoc:fullText "تسري على حقوق الامتياز العقارية ، أحكام الرهن الرسمي بالقدر الذي لا تتعارض فيه مع طبيعة هذه الحقوق. وتسري بنوع خاص أحكام التطهير والقيد وما يترتب على القيد من آثار وما يتصل به من تجديد وشطب. غير أن حقوق الامتياز العامة ولو كانت مترتبة على عقار لا يجب فيها الاشهار ولا حق التتبع. ولا حاجة للإشهار أيضا في حقوق الامتياز العقارية الضامنة، بمبلغ مستحقه للخزينة العامة، وهذه الحقوق الممتازة جميعا تكون أسبق في المرتبة على أي حق امتياز عقاري آخر أو حق رهن رسمي مهما كان تاريخ قيده. أما فيما بينهما فالامتياز الضامن للمبالغ المستحقة للخزينة يتقدم على حقوق الامتياز العامة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_986> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_986_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_986_para_1>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_986_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_986_19750926_OpEnact_b12596dfe7> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "986" ;
    dzdoc:position 1037 ;
    dzdoc:usesTerm dzterm:general_privilege,
        dzterm:mortgage,
        dzterm:real_estate_privilege .

<https://legal.dz/resource/order/1975-09-26/75-58#art_992> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#book_4_chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_992" ;
    dzdoc:fullText "المبالغ التي صرفت في حفظ المنقول وفيما يلزم له من ترميم يكون لها امتياز عليه كله . وتستوفى هذه المبالغ من ثمن هذا المنقول المثقل بحق الامتياز بعد المصاريف القضائية والمبالغ المستحقة للخزينة العامة مباشرة. أما فيما بينها فيقدم بعضها على بعض بحسب الترتيب العكسي لتواريخ صرفها."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/order/1975-09-26/75-58#art_992_right_0_b8d378d3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/order/1975-09-26/75-58#version_art_992> ;
    dzdoc:hasParagraph <https://legal.dz/resource/order/1975-09-26/75-58#art_992_para_0>,
        <https://legal.dz/resource/order/1975-09-26/75-58#art_992_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_992_19750926_OpEnact_b3ea5c9258> ;
    dzdoc:introducedBy <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:introducedOn "1975-09-26"^^xsd:date ;
    dzdoc:number "992" ;
    dzdoc:position 1043 ;
    dzdoc:usesTerm dzterm:judicial_expenses .

