<https://legal.dz/resource/order/1975-09-26/75-58#version_art_57> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون العقد تبادليا متى التزم أحد الطرفين بمنح ، أو فعل شيء، يعتبر معادلا لما يمنح، أو يفعل له . إذا كان الشيء المعادل محتويا على حظ ربح، أو خسارة لكل واحد من الطرفين على حسب حادث غير محقق فإن العقد يعتبر عقد غرر ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_57_19750926_OpEnact_166926d8b3> ;
    dzdoc:replacementText "يكون العقد تبادليا متى التزم أحد الطرفين بمنح ، أو فعل شيء، يعتبر معادلا لما يمنح، أو يفعل له . إذا كان الشيء المعادل محتويا على حظ ربح، أو خسارة لكل واحد من الطرفين على حسب حادث غير محقق فإن العقد يعتبر عقد غرر ."@ar ;
