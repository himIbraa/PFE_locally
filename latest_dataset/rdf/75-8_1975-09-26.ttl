    dzdoc:versionSourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_751> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> .

<https://legal.dz/resource/order/1975-09-26/75-58#version_art_752_19750926_OpEnact_7fb8d5d498> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1975-09-26"^^xsd:date ;
