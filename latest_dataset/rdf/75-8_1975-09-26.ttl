<https://legal.dz/resource/order/1975-09-26/75-58#version_art_259> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا قام الغير بوفاء الدين ، كان له حق الرجوع على المدين بقدر ما دفع . غير أنه يجوز للمدين الذي حصل الوفاء بغير إرادته، منع رجوع الموفي بما وفاه عنه كلا أو بعضا إذا أثبت أنله أية مصلحة في الاعتراض على الوفاء ."@ar ;
