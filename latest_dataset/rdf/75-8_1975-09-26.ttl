    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_941> .

<https://legal.dz/resource/order/1975-09-26/75-58#art_941_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_941> ;
    dzdoc:position 0 ;
    dzdoc:text "على الدائن الذي يريد أخذ تخصيص على عقارات مدينة أن يقدم عريضة بذلك إلى رئيس المحكمة التي تقع في دائرتها العقارات التي يريد التخصيص بها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_941_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_941> ;
    dzdoc:position 1 ;
    dzdoc:text "وهذه العريضة يجب أن تكون مصحوبة بصورة رسمية من الحكم أو بشهادة من قلم الكتاب مدون فيها منطوق الحكم، وأن تشمل البيانات الآتية: اسم الدائن ولقبه ومهنته وموطنه الأصلي والموطن المختار الذي يعينه في البلدة التي يقع فيها مقر المحكمة، اسم المدين ولقبه ومهنته وموطنه، تاريخ الحكم وبيان المحكمة التي أصدرته، مقدار الدين، فإن كان الدين المذكور في الحكم غير محدد المقدار، تولى رئيس المحكمة تقديره مؤقتا وعين المبلغ الذي يؤخذ به حق التخصيص، تعيين العقارات تعيينا دقيقا وبيان موقعها مع تقديم الأوراق الدالة على قيمتها."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_942_obligation_0_325f0a07_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/order/1975-09-26/75-58#art_942_obligation_0_325f0a07> ;
    dznorm:conditionText "إذا رأى أن ذلك كاف لتأمين دفع أصل الدين والمصاريف المستحقة للدائنين"@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_942_obligation_0_325f0a07_role_781487c0f4> a dznorm:Role ;
    rdfs:label "جزء من أحدها إذا"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "وعليه عند الترخيص به أن يراعي مقدار الدين وقيمة العقارات المبينة بالعريضة بوجه التقريب، عند الاقتضاء ويجعل الاختصاص مقصورا على بعض هذه العقارات أو على واحد منها فقط أو على جزء من أحدها إذا رأى أن ذلك كاف لتأمين دفع أصل الدين والمصاريف المستحقة للدائنين"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_942> .

