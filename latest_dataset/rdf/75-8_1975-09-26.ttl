<https://legal.dz/resource/order/1975-09-26/75-58#version_art_357> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا لم يحدد المتعاقدان ثمن البيع ، فلا يترتب على ذلك بطلان البيع متى تبين من أن المتعاقدين قد نويا الاعتماد على السعر المتداول في التجارة، أو السعر الذي جرى عليه التعامل بينهما ."@ar ;
