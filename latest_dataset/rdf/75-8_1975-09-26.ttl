<https://legal.dz/resource/order/1975-09-26/75-58#version_art_763_bis> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعين الجمعية في مستهل كل اجتماع لها رئيسا للجلسة عن طريق التصويت برفع اليد ، وإن تعذر ذلك ، يعين تلقائيا الشريك في الملكية أو الشاغل، لها، الأكبر سنا. يقوم المتصرف بدور كاتب الجلسة، غير أنه لا يسوغ للمتصرف أو زوجه ولو كانا مالكين أن يرأسا الجلسة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_763_bis_19750926_OpEnact_28b576feac> ;
    dzdoc:replacementText "تعين الجمعية في مستهل كل اجتماع لها رئيسا للجلسة عن طريق التصويت برفع اليد ، وإن تعذر ذلك ، يعين تلقائيا الشريك في الملكية أو الشاغل، لها، الأكبر سنا. يقوم المتصرف بدور كاتب الجلسة، غير أنه لا يسوغ للمتصرف أو زوجه ولو كانا مالكين أن يرأسا الجلسة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_763_bis> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
