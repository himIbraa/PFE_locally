    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في الالتزام بعمل، قد يكون حكم القاضي بمثابة سند التنفيذ، إذا سمحت بهذا طبيعة الالتزام مع مراعاة المقتضيات القانونية والتنظيمية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_171_19750926_OpEnact_5de405dfbd> ;
    dzdoc:replacementText "في الالتزام بعمل، قد يكون حكم القاضي بمثابة سند التنفيذ، إذا سمحت بهذا طبيعة الالتزام مع مراعاة المقتضيات القانونية والتنظيمية ."@ar ;
