<https://legal.dz/resource/order/1975-09-26/75-58#version_art_1001> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "أن للشركاء الذين اقتسموا عقارا، حق امتياز عليه تأمينا لما تخوله القسمة من حق في رجوع كل منهم على الآخرين ، بما في ذلك حق المطالبة بمعدل القسمة، و يجب أن يقيد هذا الامتياز وتكون مرتبته مماثلة لشروط امتياز البائع المشار إليه في المادة 999 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_1001_19750926_OpEnact_755ded89ed> ;
