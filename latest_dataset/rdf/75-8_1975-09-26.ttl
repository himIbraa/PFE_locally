<https://legal.dz/resource/order/1975-09-26/75-58#version_art_274> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقوم العرض الحقيقي بالنسبة إلى المدين مقام الوفاء، إذا تلاه ايداع وفقا لاحكام قانون الاجراءات المدنية، أو تلاه أي إجراء مماثل يشترط قبول الدائن أو صحته بحكم له قوة الشيء المقضى به ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_274_19750926_OpEnact_b33daa80d8> ;
    dzdoc:replacementText "يقوم العرض الحقيقي بالنسبة إلى المدين مقام الوفاء، إذا تلاه ايداع وفقا لاحكام قانون الاجراءات المدنية، أو تلاه أي إجراء مماثل يشترط قبول الدائن أو صحته بحكم له قوة الشيء المقضى به ."@ar ;
