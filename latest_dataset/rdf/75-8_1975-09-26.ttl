<https://legal.dz/resource/order/1975-09-26/75-58#version_art_681_bis_2> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد تعويض الاستيلاء باتفاق بين الأطراف. وفي حالة عدم الاتفاق يحدد مبلغ التعويض عن طريق القضاء مع مراعاة ظروف وغرض الاستيلاء دون أن يتضرر المستفيد. كما يمكن منح التعويض في حالة تسبب المستفيد من الاستيلاء في نقص القيمة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
