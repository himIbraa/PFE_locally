<https://legal.dz/resource/order/1975-09-26/75-58#version_art_501> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق للمؤجر ، ضمانا لحقوقه الناشئة عن الإيجار، أن يحبس جميع المنقولات القابلة للحجز الموجودة في العين المؤجرة مادامت مثقلة بامتياز المؤجر ، ولو لم تكن مملوكة للمستأجر . يجوز للمؤجر أن يعترض على نقلها ، وإذا نقلت رغم اعتراضه أو دون علمه ، جاز له استردادها من الحائز ولو كان حسن النية ، ولهذا الأخير المطالبة بحقوقه. ولا يجوز للمؤجر استعمال حقه في الحبس أو في الاسترداد إذا كان نقل هذه المنقولات تقتضيه حرفة المستأجر ، أو تقتضيه شؤون الحياة العادية، أو كانت المنقولات التي أبقيت في العين المؤجرة أو التي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_501_19750926_OpEnact_438df44739> ;
    dzdoc:replacementText "يحق للمؤجر ، ضمانا لحقوقه الناشئة عن الإيجار، أن يحبس جميع المنقولات القابلة للحجز الموجودة في العين المؤجرة مادامت مثقلة بامتياز المؤجر ، ولو لم تكن مملوكة للمستأجر . يجوز للمؤجر أن يعترض على نقلها ، وإذا نقلت رغم اعتراضه أو دون علمه ، جاز له استردادها من الحائز ولو كان حسن النية ، ولهذا الأخير المطالبة بحقوقه. ولا يجوز للمؤجر استعمال حقه في الحبس أو في الاسترداد إذا كان نقل هذه المنقولات تقتضيه حرفة المستأجر ، أو تقتضيه شؤون الحياة العادية، أو كانت المنقولات التي أبقيت في العين المؤجرة أو التي طلب استردادها تفي ببدل الإيجار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_501> ;
    dzdoc:sourceDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:targetArticle <https://legal.dz/resource/order/1975-09-26/75-58#art_501> ;
    dzdoc:targetDocument <https://legal.dz/resource/order/1975-09-26/75-58> ;
