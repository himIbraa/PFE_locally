    dznorm:position 0 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_condition_1_cf7c05e7> a dznorm:Condition ;
    dznorm:conditionText "عند رفع دعوى فرعية بالتزوير"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6> ;
    dznorm:position 1 .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6> ;
    dzdoc:position 0 ;
    dzdoc:text "يعتبر العقد الرسمي حجة لمحتوى الاتفاق المبرم بين الاطراف المتعاقدة وورثتهم وذوي الشأن."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_324_bis_6> ;
    dzdoc:position 1 ;
    dzdoc:text "غير أنه في حالة شكوى بسبب تزوير في الأصل، يوقف تنفيذ العقد محل الاحتجاج بتوجيه الاتهام، وعند رفع دعوى فرعية بالتزوير، يمكن للمحاكم، حسب الظروف، ايقاف تنفيذ العقد مؤقتا."@ar .

