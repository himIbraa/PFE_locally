<https://legal.dz/resource/order/1975-09-26/75-58#version_art_337> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "القرينة القانونية تغني من تقررت لمصلحته عن أية طريقة أخرى من طرف الاثبات، على انه يجوز نقض هذه القرينة بالدليل العكسي ما لم يوجد نص يقضي بغير ذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/order/1975-09-26/75-58#version_art_337_19750926_OpEnact_902bb46c8c> ;
    dzdoc:replacementText "القرينة القانونية تغني من تقررت لمصلحته عن أية طريقة أخرى من طرف الاثبات، على انه يجوز نقض هذه القرينة بالدليل العكسي ما لم يوجد نص يقضي بغير ذلك ."@ar ;
