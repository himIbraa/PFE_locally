<https://legal.dz/resource/order/1975-09-26/75-58#version_art_545> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/order/1975-09-26/75-58> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "متى انتهت العارية وجب على المستعير أن يرد الشيء الذي تسلمه بالحالة التي يكون عليها وذلك دون إخلال بمسؤوليته عن الهلاك أو التلف و يجب رد الشيء في المكان الذي يكون المستعير قد تسلمه فيه ما لم يوجد اتفاق يقضي بغير ذلك ."@ar ;
