    dznorm:position 0 ;
    dznorm:provisionText "يتقادم الالتزام بانقضاء خمسة عشرة (15) سنة"@ar ;
    dznorm:sourceArticle "art_308" .

<https://legal.dz/resource/order/1975-09-26/75-58#art_308_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/order/1975-09-26/75-58#art_308> ;
    dzdoc:position 0 ;
    dzdoc:text "يتقادم الالتزام بانقضاء خمسة عشرة (15) سنة فيما عدا الحالات التي ورد فيها نص خاص في القانون وفيما عدا الاستثناءات الآتية."@ar .

<https://legal.dz/resource/order/1975-09-26/75-58#art_309_obligation_0_fbf05ef2> a dznorm:Obligation ;
