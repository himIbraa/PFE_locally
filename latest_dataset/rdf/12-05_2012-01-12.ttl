<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_116> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب كل من خالف أحكام المادة 29 من هذا القانون العضوي بغرامة من مائة ألف دينار 100.000 دج إلى ثلاثمائة ألف دينار 300.000 دج، والوقف المؤقت أو النهائي للنشرية أو جهاز الإعلام . يمكن أن تأمر المحكمة بمصادرة الأموال محل الجنحة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
