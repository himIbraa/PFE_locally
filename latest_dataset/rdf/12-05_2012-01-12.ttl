<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_91> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحق لكل صحفي لا يستفيد من التأمين الخاص المذكور في المادة 90 أعلاه، رفض القيام بالتنقل لا يمثل هذا الرفض خطأ مهنيا ، ولا يمكن أن يتعرض الصحفي بسببه إلى عقوبة مهما كانت طبيعتها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_91_20120112_OpEnact_228e57e0fc> ;
