<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_48> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تضم سلطة ضبط الصحافة المكتوبة هياكل توضع تحت سلطة رئيسها. ولا يمكن أن يشارك مستخدمو هذه الهياكل بصفة مباشرة أو غير مباشرة في مؤسسة متصلة بقطاعات الصحافة المكتوبة والصحافة الإلكترونية ومؤسسات النشر والإشهار ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_48_20120112_OpEnact_61044bb454> ;
    dzdoc:replacementText "تضم سلطة ضبط الصحافة المكتوبة هياكل توضع تحت سلطة رئيسها. ولا يمكن أن يشارك مستخدمو هذه الهياكل بصفة مباشرة أو غير مباشرة في مؤسسة متصلة بقطاعات الصحافة المكتوبة والصحافة الإلكترونية ومؤسسات النشر والإشهار ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_48> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
