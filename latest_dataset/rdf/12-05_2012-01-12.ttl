<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_40> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ سلطة ضبط الصحافة المكتوبة ، وهي سلطة مستقلة تتمتع بالشخصية المعنوية والاستقلال المالي . وتتولى بهذه الصفة، على الخصوص ما يأتي : تشجيع التعددية الإعلامية، السهر على نشر وتوزيع الإعلام المكتوب عبر كامل التراب الوطني، السهر على جودة الرسائل الإعلامية وترقية الثقافة الوطنية وإبرازها بجميع أشكالها، السهر على تشجيع وتدعيم النشر والتوزيع باللغتين الوطنيتين بكل الوسائل الملائمة، السهر على شفافية القواعد الاقتصادية في سير المؤسسات الناشرة، السهر على منع تمركز العناوين والأجهزة تحت التأثير المالي وال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_40_20120112_OpEnact_42bffbb7d9> ;
    dzdoc:replacementText "تنشأ سلطة ضبط الصحافة المكتوبة ، وهي سلطة مستقلة تتمتع بالشخصية المعنوية والاستقلال المالي . وتتولى بهذه الصفة، على الخصوص ما يأتي : تشجيع التعددية الإعلامية، السهر على نشر وتوزيع الإعلام المكتوب عبر كامل التراب الوطني، السهر على جودة الرسائل الإعلامية وترقية الثقافة الوطنية وإبرازها بجميع أشكالها، السهر على تشجيع وتدعيم النشر والتوزيع باللغتين الوطنيتين بكل الوسائل الملائمة، السهر على شفافية القواعد الاقتصادية في سير المؤسسات الناشرة، السهر على منع تمركز العناوين والأجهزة تحت التأثير المالي والسياسي والإيديولوجي لمالك واحد، تحديد قواعد وشروط الإعانات والمساعدات التي تمنحها الدولة لأجهزة الإعلام، والسهر على توزيعها، السهر على احترام المقاييس في مجال الإشهار ومراقبة هدفه ومضمونه، استلام تصريح الحسابات المالية للنشريات الدورية من غير تلك الناتجة عن الاستغلال، جمع كل المعلومات الضرورية من الإدارات والمؤسسات الصحفية للتأكد من ضمان احترام التزامات كل منها. لا يمكن أن تستعمل هذه المعلومات التي تجمعها سلطة ضبط الصحافة المكتوبة لأغراض أخرى غير أداء المهام التي يسندها إليها هذا القانون العضوي ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:targetArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40> ;
    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

