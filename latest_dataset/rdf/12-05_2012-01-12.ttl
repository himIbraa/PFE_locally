<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "يجب على كل نشرية دورية للإعلام العام جهوية أو محلية، أن تخصص نسبة خمسين في المائة (50) على الأقل من مساحتها التحريرية إلى مضامين تتعلق بالمنطقة الجغرافية التي تغطيها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_10_20120112_OpEnact_89ac6062e0> ;
