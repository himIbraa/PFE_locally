    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_50> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتشكل سلطة ضبط الصحافة المكتوبة من أربعة عشر (14) عضوا يعينون بمرسوم رئاسي على النحو الآتي: ثلاثة (3) أعضاء يعينهم رئيس الجمهورية ومن بينهم رئيس سلطة الضبط، عضوان (2) غير برلمانيين يقترحهما رئيس المجلس الشعبي الوطني، عضوان (2) غير برلمانيين يقترحهما رئيس مجلس الأمة، سبعة (7) أعضاء ينتخبون بالأغلبية المطلقة من بين الصحفيين المحترفين الذين يثبتون خمس عشرة (15) سنة على الأقل من الخبرة في المهنة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_50_20120112_OpEnact_63043b3178> ;
    dzdoc:replacementText "تتشكل سلطة ضبط الصحافة المكتوبة من أربعة عشر (14) عضوا يعينون بمرسوم رئاسي على النحو الآتي: ثلاثة (3) أعضاء يعينهم رئيس الجمهورية ومن بينهم رئيس سلطة الضبط، عضوان (2) غير برلمانيين يقترحهما رئيس المجلس الشعبي الوطني، عضوان (2) غير برلمانيين يقترحهما رئيس مجلس الأمة، سبعة (7) أعضاء ينتخبون بالأغلبية المطلقة من بين الصحفيين المحترفين الذين يثبتون خمس عشرة (15) سنة على الأقل من الخبرة في المهنة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_50> ;
