<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_115> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتحمل المدير مسؤول النشرية أو مدير جهاز الصحافة الإلكترونية ، وكذا صاحب الكتابة أو الرسم مسؤولية كل كتابة أو رسم يتم نشرهما من طرف نشرية دورية أو صحافة إلكترونية . ويتحمل مدير خدمة الاتصال السمعي البصري أو عبر الانترنت و صاحب الخبر الذي تم بثه المسؤولية عن الخبر السمعي و/أو البصري المبث من قبل خدمة الاتصال السمعي البصري أو عبر الإنترنت ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_115_20120112_OpEnact_f576e977d1> ;
