<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يسحب الاعتماد في حالة عدم صدور النشرية الدورية في مدة سنة، ابتداء من تاريخ تسليمه. ويترتب عن توقف كل نشرية دورية عن الصدور طيلة تسعين (90) يوما ، تجديد الإجراءات المنصوص عليها في المادتين 11 و 12 أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
