    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_23> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن تتوفر في المدير مسؤول أية نشرية دورية الشروط الآتية :"@ar ;
    dznorm:sourceArticle "art_23" .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_23_obligation_0_60d69a01_action_fea5113cb5> a dznorm:Action ;
    rdfs:label "أن تتوفر في المدير مسؤول"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يجب أن تتوفر في المدير مسؤول أية نشرية دورية الشروط الآتية :"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_23> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_23_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_23> ;
    dzdoc:position 0 ;
    dzdoc:text "يجب أن تتوفر في المدير مسؤول أية نشرية دورية الشروط الآتية : أن يحوز شهادة جامعية، أن يتمتع بخبرة لا تقل عن عشر (10) سنوات في ميدان الإعلام بالنسبة للنشريات الدورية للإعلام العام، وخمس (5) سنوات خبرة في ميدان التخصص العلمي أو التقني أو التكنولوجي بالنسبة للنشريات الدورية المتخصصة، أن يكون جزائري الجنسية، أن يتمتع بحقوقه المدنية، ألا يكون قد حكم عليه بعقوبة مخلة بالشرف، ألا يكون قد قام بسلوك معاد لثورة أول نوفمبر 1954 بالنسبة للأشخاص المولودين قبل يوليو سنة 1942."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_24_obligation_0_d57269f2> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
