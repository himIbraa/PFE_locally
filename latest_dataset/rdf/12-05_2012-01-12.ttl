<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_63> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع إنشاء كل خدمة موضوعاتية للاتصال السمعي البصري، والتوزيع عبر خط الإرسال الإذاعي المسموع أو التلفزي، وكذا استخدام الترددات الإذاعية الكهربائية إلى ترخيص يمنح بموجب مرسوم . يجب إبرام اتفاقية بين سلطة ضبط السمعي البصري والمستفيد من الترخيص . ويعد هذا الاستعمال طريقة شغل خاص للملكية العمومية للدولة."@ar ;
