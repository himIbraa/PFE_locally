<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "يجب على النشريات الدورية أن تصرح وتبرر مصدر الأموال المكونة لرأسمالها والأموال الضرورية لتسييرها، طبقا للتشريع والتنظيم المعمول بهما . يجب على كل نشرية دورية تستفيد من دعم مادي مهما كانت طبيعته أن يكون لها ارتباط عضوي بالهيئة المانحة للدعم، ويجب بيان هذه العلاقة . يمنع الدعم المادي المباشر وغير المباشر الصادر عن أية جهة أجنبية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_29> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_29_20120112_OpEnact_8b8888c337> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29_obligation_0_0c8e6d96>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29_obligation_1_2ddfa37d>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29_obligation_2_e3db2c66> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29_prohibition_0_b0da256a> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 28 ;
    dzdoc:usesTerm dzterm:periodical_publication .

