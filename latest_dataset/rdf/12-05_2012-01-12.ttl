    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "يجب على المؤسسات الإعلامية أن تخصص سنويا نسبة 2% % من أرباحها السنوية لتكوين الصحفيين وترقية الأداء الإعلامي ."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_12_20120112_OpEnact_e8688aee4c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
