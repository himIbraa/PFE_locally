    dzdoc:versionOf <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "يجب أن يتضمن التصريح المذكور في المادة 11 أعلاه، ما يأتي: عنوان النشرية وتوقيت صدورها، موضوع النشرية، مكان صدورها، لغة أو لغات النشرية، اسم ولقب وعنوان ومؤهل المدير مسؤول النشرية، الطبيعة القانونية لشركة نشر النشرية، أسماء وعناوين المالك أو الملاك، مكونات رأسمال الشركة أو المؤسسة المالكة لعنوان النشرية، المقاس والسعر."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_130_20120112_OpEnact_e3406e6969> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
