dzterm:audiovisual_regulatory_authority a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "سلطة ضبط السمعي البصري"@ar .

dzterm:general_info_periodical a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بالنشرية الدورية للإعلام العام، في مفهوم هذا القانون العضوي، كل نشرية تتناول خبرا حول وقائع لأحداث وطنية ودولية، وتكون موجهة للجمهور."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_7_defocc_d11719d142c0> .

dzterm:online_audiovisual_service a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بخدمة السمعي البصري عبر الانترنت في مفهوم هذا القانون العضوي كل خدمة اتصال سمعي بصري عبر الانترنت واب - تلفزيون، واب - إذاعة موجهة للجمهور أو فئة منه، وتنتج وتبث بصفة مهنية من قبل شخص طبيعي أو معنوي يخضع للقانون الجزائري، ويتحكم في محتواها الافتتاحي"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_69_defocc_6ac90096c9fc> .

dzterm:periodical_publications a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تعتبر نشريات دورية، في مفهوم هذا القانون العضوي الصحف والمجلات بجميع أنواعها التي تصدر في فترات منتظمة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_6_defocc_5ca4be388bdc> .

dzterm:regulatory_authority a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "سلطة ضبط الصحافة المكتوبة"@ar .

dzterm:right_of_correction a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "التصحيح"@ar,
        "حق التصحيح"@ar .

dzterm:specialized_periodical a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بالنشرية الدورية المتخصصة في مفهوم هذا القانون العضوي، كل نشرية تتناول خبرا له علاقة بميادين خاصة، وتكون موجهة لفئات من الجمهور."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_8_defocc_07b3dc07fcd1> .

dzterm:خدمة_الاتصال_السمعي_البصري a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بخدمة الاتصال السمعي البصري في مفهوم هذا القانون العضوي كل خدمة اتصال موجهة للجمهور لاستقبالها في آن واحد من قبل الجمهور كله أو فئة منه، يتضمن برنامجها الأساسي حصصا متتابعة ومنتظمة تحتوي على صور و/أو أصوات."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_60_defocc_526528322d0a> .

