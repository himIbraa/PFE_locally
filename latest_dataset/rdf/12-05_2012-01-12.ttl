    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "يعاقب بغرامة من خمسة وعشرين ألف دينار 25.000 دج إلى مائة ألف دينار 100.000 دج كل من أهان بإحدى وسائل الإعلام المنصوص عليها في هذا القانون العضوي، رؤساء الدول الأجنبية وأعضاء البعثات الدبلوماسية المعتمدين لدى حكومة الجمهورية الجزائرية الديمقراطية الشعبية ."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_124_20120112_OpEnact_09d0eee344> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
