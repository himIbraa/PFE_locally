dzterm:professional_journalist a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصحفي المحترف"@ar,
        "الصحفيين المحترفين"@ar,
        "صحفيا محترفا"@ar,
        "يعد صحفيا محترفا في مفهوم هذا القانون العضوي، كل من يتفرغ للبحث عن الأخبار وجمعها وانتقائها ومعالجتها و/أو تقديم الخبر لدى أو لحساب نشرية دورية أو وكالة أنباء أو خدمة اتصال سمعي بصري أو وسيلة إعلام عبر الانترنت، ويتخذ من هذا النشاط مهنته المنتظمة ومصدرا رئيسيا لدخله."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_73_defocc_f9ee0b22bdd4> .

