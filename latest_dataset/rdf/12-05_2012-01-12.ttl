    dzdoc:versionSourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "تؤسس سلطة ضبط السمعي البصري ، وهي سلطة مستقلة تتمتع بالشخصية المعنوية والاستقلال المالي ."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_65_20120112_OpEnact_25c4c42acc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
