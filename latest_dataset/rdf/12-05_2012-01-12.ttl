<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسري الآجال المتعلقة بنشر أو بث الرد أو التصحيح المنصوص عليها في المواد السابقة ابتداء من تاريخ استلام الطلب الذي يثبته وصل استلام موصى عليه أو تاريخ التبليغ عن طريق المحضر القضائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_105_20120112_OpEnact_a2777e9d2b> ;
