dzterm:electronic_press a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "صحافة إلكترونية"@ar,
        "يقصد بالصحافة الإلكترونية، في مفهوم هذا القانون العضوي، كل خدمة اتصال مكتوب عبر الانترنت موجهة للجمهور أو فئة منه، وينشر بصفة مهنية من قبل شخص طبيعي أو معنوي يخضع للقانون الجزائري، ويتحكم في محتواها الافتتاح"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_67_defocc_75fa300a7f70> .

