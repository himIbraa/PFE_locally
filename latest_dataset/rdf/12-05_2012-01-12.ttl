<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103_obligation_0_899f8762> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103_obligation_0_899f8762_action_35d894020a> ;
    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب أن يتضمن طلب حق الرد أو التصحيح الاتهامات التي يرغب الطالب في الرد عليها، وفحوى الرد أو التصحيح الذي يقترحه"@ar ;
    dznorm:sourceArticle "art_103" .

