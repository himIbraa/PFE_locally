<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49> ;
    dzdoc:position 1 ;
