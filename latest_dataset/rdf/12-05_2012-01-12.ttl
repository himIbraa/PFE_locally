    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "تتقادم الدعوى العمومية والدعوى المدنية المتعلقتان بالجنح المرتكبة عن طريق الصحافة المكتوبة أو السمعية البصرية أو الإلكترونية، بعد ستة (6) أشهر كاملة ابتداء من تاريخ ارتكابها."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_125_20120112_OpEnact_b64d09c11e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
