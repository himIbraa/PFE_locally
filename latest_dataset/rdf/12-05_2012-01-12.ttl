<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_29> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على النشريات الدورية أن تصرح وتبرر مصدر الأموال المكونة لرأسمالها والأموال الضرورية لتسييرها، طبقا للتشريع والتنظيم المعمول بهما . يجب على كل نشرية دورية تستفيد من دعم مادي مهما كانت طبيعته أن يكون لها ارتباط عضوي بالهيئة المانحة للدعم، ويجب بيان هذه العلاقة . يمنع الدعم المادي المباشر وغير المباشر الصادر عن أية جهة أجنبية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_29_20120112_OpEnact_8b8888c337> ;
    dzdoc:replacementText "يجب على النشريات الدورية أن تصرح وتبرر مصدر الأموال المكونة لرأسمالها والأموال الضرورية لتسييرها، طبقا للتشريع والتنظيم المعمول بهما . يجب على كل نشرية دورية تستفيد من دعم مادي مهما كانت طبيعته أن يكون لها ارتباط عضوي بالهيئة المانحة للدعم، ويجب بيان هذه العلاقة . يمنع الدعم المادي المباشر وغير المباشر الصادر عن أية جهة أجنبية ."@ar ;
