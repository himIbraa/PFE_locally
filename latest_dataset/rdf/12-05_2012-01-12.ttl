<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يتضمن التصريح المذكور في المادة 11 أعلاه، ما يأتي: عنوان النشرية وتوقيت صدورها، موضوع النشرية، مكان صدورها، لغة أو لغات النشرية، اسم ولقب وعنوان ومؤهل المدير مسؤول النشرية، الطبيعة القانونية لشركة نشر النشرية، أسماء وعناوين المالك أو الملاك، مكونات رأسمال الشركة أو المؤسسة المالكة لعنوان النشرية، المقاس والسعر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_12_20120112_OpEnact_e8688aee4c> ;
    dzdoc:replacementText "يجب أن يتضمن التصريح المذكور في المادة 11 أعلاه، ما يأتي: عنوان النشرية وتوقيت صدورها، موضوع النشرية، مكان صدورها، لغة أو لغات النشرية، اسم ولقب وعنوان ومؤهل المدير مسؤول النشرية، الطبيعة القانونية لشركة نشر النشرية، أسماء وعناوين المالك أو الملاك، مكونات رأسمال الشركة أو المؤسسة المالكة لعنوان النشرية، المقاس والسعر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> ;
