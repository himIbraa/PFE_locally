<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_107> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على مدير خدمة الاتصال السمعي البصري بث الرد مجانا حسب الشروط التقنية، وبنفس شروط أوقات البث التي بث فيها البرنامج المتضمن الاتهام المنسوب . ويتم الإعلان على أن الرد يندرج في إطار ممارسة حق الرد مع الإشارة إلى عنوان البرنامج المتضمن الاتهام المنسوب بذكر تاريخ أو فترة بثه. لا يمكن أن تتجاوز المدة القصوى للرسالة المتضمنة الرد دقيقتين (2) اثنتين . تستثنى من ممارسة حق الرد الحصص التي يشارك فيها الشخص محل الجدل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_107_20120112_OpEnact_3159fb2705> ;
    dzdoc:replacementText "يجب على مدير خدمة الاتصال السمعي البصري بث الرد مجانا حسب الشروط التقنية، وبنفس شروط أوقات البث التي بث فيها البرنامج المتضمن الاتهام المنسوب . ويتم الإعلان على أن الرد يندرج في إطار ممارسة حق الرد مع الإشارة إلى عنوان البرنامج المتضمن الاتهام المنسوب بذكر تاريخ أو فترة بثه. لا يمكن أن تتجاوز المدة القصوى للرسالة المتضمنة الرد دقيقتين (2) اثنتين . تستثنى من ممارسة حق الرد الحصص التي يشارك فيها الشخص محل الجدل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107> ;
