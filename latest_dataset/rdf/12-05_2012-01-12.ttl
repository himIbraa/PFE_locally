<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_82> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة تغيير توجه أو مضمون أية نشرية دورية أو خدمة اتصال سمعي بصري أو أية وسيلة إعلام عبر الإنترنت، وكذا توقف نشاطها أو التنازل عنها ، يمكن الصحفي المحترف فسخ العقد، ويعتبر ذلك تسريحا من العمل يخوله الحق في الاستفادة من التعويضات المنصوص عليها في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_82_20120112_OpEnact_e43f8a0c67> ;
    dzdoc:replacementText "في حالة تغيير توجه أو مضمون أية نشرية دورية أو خدمة اتصال سمعي بصري أو أية وسيلة إعلام عبر الإنترنت، وكذا توقف نشاطها أو التنازل عنها ، يمكن الصحفي المحترف فسخ العقد، ويعتبر ذلك تسريحا من العمل يخوله الحق في الاستفادة من التعويضات المنصوص عليها في التشريع والتنظيم المعمول بهما."@ar ;
