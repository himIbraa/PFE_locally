    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "يعد المجلس الأعلى لآداب وأخلاقيات مهنة الصحافة ميثاق شرف مهنة الصحافة ويصادق عليه."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_97_20120112_OpEnact_c9eb3f4c33> a dzdoc:ArticleVersion ;
