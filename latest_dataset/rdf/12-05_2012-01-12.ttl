<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_62> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعهد إلى الهيئة المكلفة بالبث الإذاعي والتلفزي تخصيص الترددات الموجهة لخدمات الاتصال السمعي البصري المرخص بها بعد أن يمنح خط الترددات من قبل الجهاز الوطني المكلف بضمان تسيير استخدام مجال الترددات الإذاعية الكهربائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
