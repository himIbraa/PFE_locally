<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تساهم ممارسة أنشطة الإعلام على الخصوص فيما يأتي : الاستجابة لحاجات المواطن في مجال الإعلام والثقافة والتربية والترفيه والمعارف العلمية والتقنية، ترقية مبادئ النظام الجمهوري وقيم الديمقراطية وحقوق الإنسان والتسامح ونبذ العنف والعنصرية، ترقية روح المواطنة وثقافة الحوار، ترقية الثقافة الوطنية وإشعاعها، في ظل احترام التنوع اللغوي والثقافي الذي يميز المجتمع الجزائري، المساهمة في الحوار بين ثقافات العالم القائمة على مبادئ الرقي والعدالة والسلم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_5_20120112_OpEnact_b65a5fa449> ;
    dzdoc:replacementText "تساهم ممارسة أنشطة الإعلام على الخصوص فيما يأتي : الاستجابة لحاجات المواطن في مجال الإعلام والثقافة والتربية والترفيه والمعارف العلمية والتقنية، ترقية مبادئ النظام الجمهوري وقيم الديمقراطية وحقوق الإنسان والتسامح ونبذ العنف والعنصرية، ترقية روح المواطنة وثقافة الحوار، ترقية الثقافة الوطنية وإشعاعها، في ظل احترام التنوع اللغوي والثقافي الذي يميز المجتمع الجزائري، المساهمة في الحوار بين ثقافات العالم القائمة على مبادئ الرقي والعدالة والسلم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_5> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
