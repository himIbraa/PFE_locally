<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_118> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من مائة ألف دينار 100.000 دج إلى خمسمائة ألف دينار 500.000 دج كل من يقوم عن قصد بإعارة اسمه إلى أي شخص طبيعي أو معنوي بغرض إنشاء نشرية، ولا سيما عن طريق اكتتاب سهم أو حصة في مؤسسة للنشر . ويعاقب بنفس العقوبة المستفيد من عملية \"إعارة الاسم\" . يمكن أن تأمر المحكمة بوقف صدور النشرية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_118_20120112_OpEnact_9ec0eb1f4d> ;
    dzdoc:replacementText "يعاقب بغرامة من مائة ألف دينار 100.000 دج إلى خمسمائة ألف دينار 500.000 دج كل من يقوم عن قصد بإعارة اسمه إلى أي شخص طبيعي أو معنوي بغرض إنشاء نشرية، ولا سيما عن طريق اكتتاب سهم أو حصة في مؤسسة للنشر . ويعاقب بنفس العقوبة المستفيد من عملية \"إعارة الاسم\" . يمكن أن تأمر المحكمة بوقف صدور النشرية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118> ;
