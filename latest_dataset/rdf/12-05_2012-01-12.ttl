<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_53> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة شغور منصب عضو سلطة ضبط الصحافة المكتوبة لأي سبب كان ، يتم الاستخلاف بتعيين عضو جديد لاستكمال الفترة المتبقية، حسب الشروط والكيفيات المنصوص عليها في المادة 50 أعلاه. وعند انقضاء هذه الفترة المتبقية، يمكن تعيينه من جديد عضوا في سلطة ضبط الصحافة المكتوبة إذا لم تتجاوز هذه الفترة المتبقية السنتين ، وبحسب الشروط والكيفيات المنصوص عليها في المادة 50 أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_53_20120112_OpEnact_5caeb69760> ;
    dzdoc:replacementText "في حالة شغور منصب عضو سلطة ضبط الصحافة المكتوبة لأي سبب كان ، يتم الاستخلاف بتعيين عضو جديد لاستكمال الفترة المتبقية، حسب الشروط والكيفيات المنصوص عليها في المادة 50 أعلاه. وعند انقضاء هذه الفترة المتبقية، يمكن تعيينه من جديد عضوا في سلطة ضبط الصحافة المكتوبة إذا لم تتجاوز هذه الفترة المتبقية السنتين ، وبحسب الشروط والكيفيات المنصوص عليها في المادة 50 أعلاه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_53> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
