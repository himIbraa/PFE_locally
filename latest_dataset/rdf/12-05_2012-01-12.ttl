    dzdoc:versionSourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "تحدد مهام وصلاحيات سلطة ضبط السمعي البصري ، وكذا تشكيلتها وسيرها بموجب القانون المتعلق بالنشاط السمعي البصري."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_66_20120112_OpEnact_02b3bbdad9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
