    dzdoc:versionText "يمارس نشاط الاستشارة في الاتصال ضمن احترام التشريع والتنظيم المعمول بهما . تحدد شروط وكيفيات ممارسة نشاط الاستشارة في الاتصال عن طريق التنظيم ."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_131_20120112_OpEnact_ad19f9b8f8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
