        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد إيداع التصريح المذكور في المادتين 11 و 12 أعلاه وتسليم الوصل ، تمنح سلطة ضبط الصحافة المكتوبة الاعتماد في أجل ستين (60) يوما ابتداء من تاريخ إيداع التصريح. يمنح الاعتماد إلى المؤسسة الناشرة. يعتبر الاعتماد بمثابة الموافقة على الصدور."@ar ;
