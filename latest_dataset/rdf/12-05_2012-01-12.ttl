<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_2> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "يعد المجلس الأعلى لآداب وأخلاقيات مهنة الصحافة ميثاق شرف مهنة الصحافة ويصادق عليه."@ar ;
