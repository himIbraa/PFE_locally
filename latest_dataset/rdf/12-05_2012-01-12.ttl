    dzdoc:versionEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_122> ;
    dzdoc:versionOf <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_122> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_122> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "يعاقب بغرامة من خمسة وعشرين ألف دينار 25.000 دج إلى مائة ألف دينار 100,000 دج كل من نشر أو بث بإحدى وسائل الإعلام المنصوص عليها في هذا القانون العضوي، صورا أو رسوما أو أية بيانات توضيحية أخرى تعيد تمثيل كل أو جزء من ظروف الجنايات أو الجنح المذكورة في المواد 255 و 256 و 257 , 342 , 341 , 339 , 338 , 337 , 336 , 335 , 334 , 333 , 263 , 262 , 261 , 260 , 259 , 258 , من قانون العقوبات ."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_123_20120112_OpEnact_33890537cd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_123> ;
