    rdfs:label "القانون رقم 90-07 المؤرخ في 8 رمضان عام 1410 الموافق 3 أبريل سنة 1990 والمتعلق بالإعلام"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1990-04-03/90-07"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1990-04-03/90-07"^^xsd:anyURI ;
