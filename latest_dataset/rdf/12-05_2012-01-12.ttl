<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_47> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلتزم أعضاء سلطة ضبط الصحافة المكتوبة وأعوانها بالسر المهني بشأن الوقائع والأعمال والمعلومات التي قد يطلعون عليها بحكم مهامهم ، طبقا لأحكام المادة 301 من قانون العقوبات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
