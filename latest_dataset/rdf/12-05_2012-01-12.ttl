<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_26> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يبين في كل عدد من النشرية الدورية ما يأتي: اسم ولقب المدير مسؤول النشر، عنوان التحرير والإدارة، الغرض التجاري للطابع وعنوانه، دورية صدور النشرية وسعرها، عدد نسخ السحب السابق."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
