<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس حق الرد و حق التصحيح : الشخص أو الهيئة المعنية، الممثل القانوني للشخص أو الهيئة المعنية، السلطة السلمية أو الوصاية التي ينتمي إليها الشخص أو الهيئة المعنية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_102_20120112_OpEnact_7334a1f1d0> ;
    dzdoc:replacementText "يمارس حق الرد و حق التصحيح : الشخص أو الهيئة المعنية، الممثل القانوني للشخص أو الهيئة المعنية، السلطة السلمية أو الوصاية التي ينتمي إليها الشخص أو الهيئة المعنية."@ar ;
