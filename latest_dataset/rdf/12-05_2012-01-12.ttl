<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_23_obligation_0_60d69a01> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
