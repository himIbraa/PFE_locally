    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "يعاقب بغرامة من خمسين ألف دينار 50.000 دج إلى مائتي ألف دينار 200.000 دج كل من نشر أو بث بإحدى وسائل الإعلام المنصوص عليها في هذا القانون العضوي، تقارير عن المرافعات التي تتعلق بحالة الأشخاص والإجهاض ."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_122_20120112_OpEnact_68906690be> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
