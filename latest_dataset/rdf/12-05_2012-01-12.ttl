<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_108> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة رفض الرد أو السكوت عن الطلب في ظرف الثمانية (8) أيام التي تلي استلامه ، يمكن الطالب اللجوء إلى المحكمة التي تنظر في القضايا الاستعجالية ، ويصدر أمر الاستعجال في غضون ثلاثة (3) أيام. يمكن أن تأمر المحكمة إجباريا بنشر الرد."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
