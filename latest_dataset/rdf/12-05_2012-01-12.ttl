    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "تمتد مهام وصلاحيات سلطة ضبط الصحافة المكتوبة إلى نشاط الإعلام المكتوب عن طريق الاتصال الإلكتروني."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_42_20120112_OpEnact_125459c624> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "في حالة الإخلال بالالتزامات المنصوص عليها في هذا القانون العضوي ، توجه سلطة ضبط الصحافة المكتوبة ملاحظاتها وتوصياتها إلى جهاز الإعلام المعني، وتحدد شروط وأجال التكفل بها . تنشر هذه الملاحظات والتوصيات وجوبا من طرف جهاز الإعلام المعني ."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_43_20120112_OpEnact_a1e05646b1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
