    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 58 ;
    dzdoc:usesTerm dzterm:النشاط_السمعي_البصري .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_4_sec_2> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "تحدد مهام وصلاحيات سلطة ضبط السمعي البصري ، وكذا تشكيلتها وسيرها بموجب القانون المتعلق بالنشاط السمعي البصري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_65_20120112_OpEnact_25c4c42acc> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "65" ;
    dzdoc:position 64 ;
    dzdoc:usesTerm dzterm:audiovisual_regulatory_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_5> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "تستثنى من هذه التعاريف الأخبار التي تشكل أداة للترويج أو فرعا لنشاط صناعي أو تجاري."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_72_20120112_OpEnact_1513ad217e> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "يعد صحفيا محترفا كذلك كل مراسل دائم له علاقة تعاقدية مع جهاز إعلام، طبقا للإجراءات المنصوص عليها في المادة 80 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_74_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_74_20120112_OpEnact_bde5b80ff0> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 73 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_80> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_80> ;
    dzdoc:usesTerm dzterm:professional_journalist .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "تحدد مدونة مختلف أصناف الصحفيين المحترفين بموجب النص المتضمن القانون الأساسي للصحفي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_75_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_75_20120112_OpEnact_cf70b35701> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 ;
    dzdoc:usesTerm dzterm:professional_journalist .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "تثبت صفة الصحفي المحترف بموجب بطاقة وطنية للصحفي المحترف، تصدرها لجنة تحدد تشكيلتها وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_76_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_76_20120112_OpEnact_f1b10de870> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 76" ;
    dzdoc:position 75 ;
    dzdoc:usesTerm dzterm:professional_journalist .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
