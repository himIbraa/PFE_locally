    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 121" ;
    dzdoc:position 120 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_9> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "يعاقب بغرامة من خمسة وعشرين ألف دينار 25.000 دج إلى مائة ألف دينار 100,000 دج كل من نشر أو بث بإحدى وسائل الإعلام المنصوص عليها في هذا القانون العضوي، صورا أو رسوما أو أية بيانات توضيحية أخرى تعيد تمثيل كل أو جزء من ظروف الجنايات أو الجنح المذكورة في المواد 255 و 256 و 257 , 342 , 341 , 339 , 338 , 337 , 336 , 335 , 334 , 333 , 263 , 262 , 261 , 260 , 259 , 258 , من قانون العقوبات ."@ar ;
