    dzdoc:number "96" ;
    dzdoc:position 95 ;
    dzdoc:usesTerm dzterm:higher_council_ethics .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_97> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_2> ;
    dzdoc:eId "art_97" ;
    dzdoc:fullText "يعرض كل خرق لقواعد آداب وأخلاقيات مهنة الصحافة أصحابه إلى عقوبات يأمر بها المجلس الأعلى لآداب وأخلاقيات مهنة الصحافة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_97> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_97_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
