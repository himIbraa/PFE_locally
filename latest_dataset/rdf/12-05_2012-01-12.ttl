    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_122> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بغرامة من خمسة وعشرين ألف دينار 25.000 دج إلى مائة ألف دينار 100,000 دج كل من نشر أو بث بإحدى وسائل الإعلام المنصوص عليها في هذا القانون العضوي، صورا أو رسوما أو أية بيانات توضيحية أخرى تعيد تمثيل كل أو جزء من ظروف الجنايات أو الجنح المذكورة في المواد 255 و256 و257, 342, 341, 339, 338, 337, 336, 335, 334, 333,263, 262, 261, 260, 259, 258, من قانون العقوبات"@ar ;
    dznorm:sourceArticle "art_122" .

