<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "إصدار كل نشرية دورية يتم بحرية. يخضع إصدار كل نشرية دورية لإجراءات التسجيل ومراقبة صحة المعلومات، بإيداع تصريح مسبق موقع من طرف المدير مسؤول النشرية، لدى سلطة ضبط الصحافة المكتوبة المنصوص عليها في هذا القانون العضوي ، ويسلم له فورا وصل بذلك."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11_right_0_12d5a789> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_11_20120112_OpEnact_5fe0534ef9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11_obligation_0_f19004ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 11" ;
    dzdoc:position 10 ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_12" ;
    dzdoc:fullText "يجب أن يتضمن التصريح المذكور في المادة 11 أعلاه، ما يأتي: عنوان النشرية وتوقيت صدورها، موضوع النشرية، مكان صدورها، لغة أو لغات النشرية، اسم ولقب وعنوان ومؤهل المدير مسؤول النشرية، الطبيعة القانونية لشركة نشر النشرية، أسماء وعناوين المالك أو الملاك، مكونات رأسمال الشركة أو المؤسسة المالكة لعنوان النشرية، المقاس والسعر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_12> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_12_20120112_OpEnact_e8688aee4c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12_obligation_0_396f5069> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 12" ;
    dzdoc:position 11 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11> .

