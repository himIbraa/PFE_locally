    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 10" ;
    dzdoc:position 9 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "يقلص الأجل المخصص للنشر خلال فترات الحملات الانتخابية بالنسبة للنشرية اليومية إلى أربع وعشرين (24) ساعة. في حالة رفض نشر الرد ، يقلص أجل الاستدعاء إلى أربع وعشرين (24) ساعة، ويمكن أن يسلم الاستدعاء بأمر على عريضة. ويخول رفض نشر الرد الحق في رفع عريضة أمام قضاء الاستعجال، طبقا للتشريع المعمول به ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_106_right_0_0137fb73> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_106_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_106_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_106_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_106_20120112_OpEnact_8ddca06cca> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 106" ;
    dzdoc:position 105 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_106_condition_0_6a17a693> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_9> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "يعاقب كل من خالف أحكام المادة 29 من هذا القانون العضوي بغرامة من مائة ألف دينار 100.000 دج إلى ثلاثمائة ألف دينار 300.000 دج، والوقف المؤقت أو النهائي للنشرية أو جهاز الإعلام . يمكن أن تأمر المحكمة بمصادرة الأموال محل الجنحة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_116_permission_0_8059a8cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_116_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_116_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_116_20120112_OpEnact_5f6bcac7d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_116_obligation_0_3faec3c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 116" ;
    dzdoc:position 115 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_29> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_9> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يعاقب بغرامة من مائة ألف دينار 100.000 دج إلى أربعمائة ألف دينار 400.000 دج كل مدير أي من العناوين أو أجهزة الإعلام المنصوص عليها في المادة 4 أعلاه، تقاضى باسمه الشخصي أو لحساب وسيلة إعلام، سواء بصفة مباشرة أو غير مباشرة أموالا ، أو قبل مزايا من طرف مؤسسة عمومية أو خاصة أجنبية، ماعدا عائدات الاشتراك والإشهار وفقا للأسعار والتنظيمات المعمول بها . يمكن أن تأمر المحكمة بمصادرة الأموال محل الجنحة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_117_permission_0_8059a8cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_117_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_117_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_117_20120112_OpEnact_19b4497be8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_117_obligation_0_39df5f4d> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 116 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_4> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_4> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_10> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "تساهم الدولة في رفع المستوى المهني للصحفيين عن طريق التكوين . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_128_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_128_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_128_20120112_OpEnact_d9b3ad47d0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_128_obligation_0_22673068> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 128" ;
    dzdoc:position 127 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_128> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_128> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "في حالة بيع النشرية الدورية أو التنازل عنها ، يجب على المالك الجديد طلب الاعتماد وفق الكيفيات المنصوص عليها في المواد 11 و 12 و 13 من هذا القانون العضوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_17> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_17_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_17_20120112_OpEnact_733472abfa> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_17_obligation_0_d64fde35> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 17" ;
    dzdoc:position 16 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_13> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_13> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_17_condition_0_9d295aee> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "يسحب الاعتماد في حالة عدم صدور النشرية الدورية في مدة سنة، ابتداء من تاريخ تسليمه. ويترتب عن توقف كل نشرية دورية عن الصدور طيلة تسعين (90) يوما ، تجديد الإجراءات المنصوص عليها في المادتين 11 و 12 أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_18_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_18_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_18_20120112_OpEnact_c5bcfc6416> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_18_obligation_0_9acc4a81>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_18_obligation_1_74d0ed79> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 17 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_18_condition_0_4753ba76> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "يجب على المدير مسؤول كل نشرية موجهة للأطفال و / أو الشباب، أن يستعين بهيئة تربوية استشارية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_24_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_24_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_24_20120112_OpEnact_af97892317> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_24_obligation_0_d57269f2> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 23 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "يمكن نفس الشخص المعنوي الخاضع للقانون الجزائري أن يملك أو يراقب أو يسير نشرية واحدة فقط للإعلام العام تصدر بالجزائر بنفس الدورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_25_permission_0_30d65fda> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_25_right_0_f90c2124> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_25_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_25_20120112_OpEnact_7783fa6a03> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 25" ;
    dzdoc:position 24 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "لا يمكن أية نشرية دورية للإعلام العام أن تخصص أكثر من ثلث (3/1) مساحتها الإجمالية للإشهار والاستطلاعات الإشهارية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_28_permission_0_5c0d1869> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_28_20120112_OpEnact_2d877ad719> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_28_obligation_0_9471411e> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 27 ;
    dzdoc:usesTerm dzterm:periodical_publication .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "تمنع إعارة الاسم لكل شخص سواء بالتظاهر باكتتاب الأسهم أو الحصص أو امتلاك أو تأجير بالوكالة لمحل تجاري أو سند . دون المساس بالمتابعات القضائية ذات الصلة، يترتب على خرق هذا الحكم إلغاء العملية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_31_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_31_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_31_20120112_OpEnact_8f4f5bc04c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_31_obligation_0_ca700ac1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_31_obligation_1_2a9be92f> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 30 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "يمكن كل هيئة تابعة للدولة أو جهاز صحافة إخطار سلطة ضبط الصحافة المكتوبة وطلب الرأي المتعلق بمجال اختصاصها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_44_permission_0_21d8ec97> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_44_right_0_3fec231c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_44_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_44_20120112_OpEnact_9ae8aec3e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "44" ;
    dzdoc:position 43 ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "في حالة إخلال عضو سلطة ضبط الصحافة المكتوبة بالتزاماته المحددة في هذا القانون العضوي ، يصرح رئيس سلطة ضبط الصحافة المكتوبة بعد مداولة طبقا لـ المادة 54 أدناه، بالاستقالة التلقائية للعضو المعني. ويصرح رئيس سلطة ضبط الصحافة المكتوبة أيضا بالاستقالة التلقائية لكل عضو يصدر في حقه حكم قضائي نهائي بعقوبة مشينة أو مخلة بالشرف ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_52_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_52_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_52_20120112_OpEnact_351681605c> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 51 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_54> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_54> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_52_condition_0_93da80cc>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_52_condition_1_0adf0f02> ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "لا يمكن أعضاء سلطة ضبط الصحافة المكتوبة ، وكذا أفراد أسرهم وأصولهم وفروعهم من الدرجة الأولى، أن يمارسوا بصفة مباشرة أو غير مباشرة مسؤوليات أو يحوزوا مساهمة في مؤسسة مرتبطة بقطاع الإعلام ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_57_permission_0_d4af80ac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_57_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_57_20120112_OpEnact_c67e8005ce> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_57_obligation_0_d9c682d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 57" ;
    dzdoc:position 56 ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "يمكن الصحفيين المحترفين إنشاء شركات محررين تساهم في رأسمال المؤسسة الصحفية التي تشغلهم، ويشاركون في تسييرها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_78_permission_0_dc6dc19b> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_78_right_0_dc6dc19b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_78_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_78_20120112_OpEnact_cb9024266f> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 78" ;
    dzdoc:position 77 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_81> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_81" ;
    dzdoc:fullText "يشترط على الصحفيين المحترفين الذين يعملون لحساب جهاز يخضع للقانون الأجنبي، الحصول على اعتماد. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_81> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_81_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_81_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_81_20120112_OpEnact_8aac384c7d> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 81" ;
    dzdoc:position 80 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_81_condition_0_22fd843f> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "يجب على كل الهيئات والإدارات والمؤسسات أن تزود الصحفي بالأخبار والمعلومات التي يطلبها بما يكفل حق المواطن في الإعلام ، وفي إطار هذا القانون العضوي والتشريع المعمول به."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_83_right_0_12358752> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_83_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_83_20120112_OpEnact_0df0282d4f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_83_obligation_0_5232bc47> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 83" ;
    dzdoc:position 82 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "يجب أن يتضمن طلب حق الرد أو التصحيح الاتهامات التي يرغب الطالب في الرد عليها، وفحوى الرد أو التصحيح الذي يقترحه . يرسل الطلب برسالة موصى عليها مرفقة بوصل استلام، أو عن طريق المحضر القضائي تحت طائلة سقوط الحق، في أجل أقصاه ثلاثون (30) يوما إذا تعلق الأمر بصحيفة يومية أو خدمة اتصال سمعي بصري أو جهاز إعلام إلكتروني، وستون (60) يوما فيما يخص النشريات الدورية الأخرى ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_103_20120112_OpEnact_0d4375550c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103_obligation_0_899f8762> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 102 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_103_condition_0_d59c35cc> ;
    dzdoc:usesTerm dzterm:right_of_correction,
        dzterm:right_of_reply .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_131> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_12> ;
    dzdoc:eId "art_131" ;
    dzdoc:fullText "يجب على العناوين وأجهزة الصحافة الممارسة لنشاطها أن تتطابق مع أحكام هذا القانون العضوي خلال سنة واحدة ابتداء من تاريخ تنصيب سلطة ضبط الصحافة المكتوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_131> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_131_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_131_20120112_OpEnact_ad19f9b8f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_131_obligation_0_93511eb0> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 131" ;
    dzdoc:position 130 ;
    dzdoc:usesTerm dzterm:press_regulatory_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "تضمن أنشطة الإعلام على وجه الخصوص عن طريق: وسائل الإعلام التابعة للقطاع العمومي، وسائل الإعلام التي تنشئها هيئات عمومية، وسائل الإعلام التي تملكها أو تنشئها أحزاب سياسية أو جمعيات معتمدة، وسائل الإعلام التي يملكها أو ينشئها أشخاص معنويون يخضعون للقانون الجزائري ويمتلك رأسمالها أشخاص طبيعيون أو معنويون يتمتعون بالجنسية الجزائرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_4_20120112_OpEnact_d48c7e2be5> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:media_activities .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "في حالة الإخلال بالالتزامات المنصوص عليها في هذا القانون العضوي ، توجه سلطة ضبط الصحافة المكتوبة ملاحظاتها وتوصياتها إلى جهاز الإعلام المعني، وتحدد شروط وأجال التكفل بها . تنشر هذه الملاحظات والتوصيات وجوبا من طرف جهاز الإعلام المعني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_42_20120112_OpEnact_125459c624> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42_obligation_0_e3ffcb85>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42_obligation_1_2d680f00> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "42" ;
    dzdoc:position 41 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_42_condition_0_a31cdc15> ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "تضم سلطة ضبط الصحافة المكتوبة هياكل توضع تحت سلطة رئيسها. ولا يمكن أن يشارك مستخدمو هذه الهياكل بصفة مباشرة أو غير مباشرة في مؤسسة متصلة بقطاعات الصحافة المكتوبة والصحافة الإلكترونية ومؤسسات النشر والإشهار ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_48_permission_0_42499979> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_48_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_48_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_48_20120112_OpEnact_61044bb454> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_48_obligation_0_39df999f> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "48" ;
    dzdoc:position 47 ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "في حالة شغور منصب عضو سلطة ضبط الصحافة المكتوبة لأي سبب كان ، يتم الاستخلاف بتعيين عضو جديد لاستكمال الفترة المتبقية، حسب الشروط والكيفيات المنصوص عليها في المادة 50 أعلاه. وعند انقضاء هذه الفترة المتبقية، يمكن تعيينه من جديد عضوا في سلطة ضبط الصحافة المكتوبة إذا لم تتجاوز هذه الفترة المتبقية السنتين ، وبحسب الشروط والكيفيات المنصوص عليها في المادة 50 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_53_permission_0_bc645624> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_53_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_53_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_53_20120112_OpEnact_5caeb69760> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 52 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_50> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_50> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_53_condition_0_db23162b>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_53_condition_1_a082777f> ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "لا تصح مداولات سلطة ضبط الصحافة المكتوبة إلا إذا حضرها عشرة (10) أعضاء وتكون المداولة بأغلبية الأعضاء الحاضرين. في حالة تساوي عدد الأصوات يكون صوت الرئيس مرجحا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_54_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_54_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_54_20120112_OpEnact_e8c0a327f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 54" ;
    dzdoc:position 53 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_54_condition_0_af94302f>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_54_condition_1_a68b3f16> ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_4_sec_1> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "يخضع إنشاء كل خدمة موضوعاتية للاتصال السمعي البصري، والتوزيع عبر خط الإرسال الإذاعي المسموع أو التلفزي، وكذا استخدام الترددات الإذاعية الكهربائية إلى ترخيص يمنح بموجب مرسوم . يجب إبرام اتفاقية بين سلطة ضبط السمعي البصري والمستفيد من الترخيص . ويعد هذا الاستعمال طريقة شغل خاص للملكية العمومية للدولة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_63_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_63_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_63_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_63_20120112_OpEnact_c43a8cf40a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_63_obligation_0_5f60d117>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_63_obligation_1_7d16fc35> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 62 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "في حالة تغيير توجه أو مضمون أية نشرية دورية أو خدمة اتصال سمعي بصري أو أية وسيلة إعلام عبر الإنترنت، وكذا توقف نشاطها أو التنازل عنها ، يمكن الصحفي المحترف فسخ العقد، ويعتبر ذلك تسريحا من العمل يخوله الحق في الاستفادة من التعويضات المنصوص عليها في التشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_82_permission_0_6086be7f> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_82_right_0_4bd177cd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_82_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_82_20120112_OpEnact_e43f8a0c67> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 82" ;
    dzdoc:position 81 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_82_condition_0_90ee91ca> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "في حالة نشر أو بث عمل صحفي، من قبل أية وسيلة إعلام ، فإن كل استخدام آخر لهذا العمل يخضع للموافقة المسبقة لصاحبه . يستفيد الصحفي من حق الملكية الأدبية والفنية على أعماله طبقا للتشريع المعمول به."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88_right_0_456d3469> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_88_20120112_OpEnact_e35da33b64> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88_obligation_0_47e51a41> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 87 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88_condition_0_5bec8dfe> ;
    dzdoc:usesTerm dzterm:journalist .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يحق لكل صحفي لا يستفيد من التأمين الخاص المذكور في المادة 90 أعلاه، رفض القيام بالتنقل لا يمثل هذا الرفض خطأ مهنيا ، ولا يمكن أن يتعرض الصحفي بسببه إلى عقوبة مهما كانت طبيعتها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_91_permission_0_7f44ce44> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_91_right_0_2d931044> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_91_20120112_OpEnact_228e57e0fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "91" ;
    dzdoc:position 90 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_90> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_90> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_91_condition_0_20825f8a> ;
    dzdoc:usesTerm dzterm:journalist .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "يجب على مدير جهاز الإعلام الإلكتروني أن ينشر في موقعه كل رد أو تصحيح فور إخطاره من طرف الشخص أو الهيئة المعنية . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_113_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_113_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_113_20120112_OpEnact_20cf4776bc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_113_obligation_0_0fc866e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 113" ;
    dzdoc:position 112 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_113> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_113> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_9> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "يعاقب بغرامة من مائة ألف دينار 100.000 دج إلى خمسمائة ألف دينار 500.000 دج كل من يقوم عن قصد بإعارة اسمه إلى أي شخص طبيعي أو معنوي بغرض إنشاء نشرية، ولا سيما عن طريق اكتتاب سهم أو حصة في مؤسسة للنشر . ويعاقب بنفس العقوبة المستفيد من عملية \"إعارة الاسم\" . يمكن أن تأمر المحكمة بوقف صدور النشرية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118_permission_0_004f3620> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_118_20120112_OpEnact_9ec0eb1f4d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118_obligation_0_cfe483fe>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_118_obligation_1_1a8aeb78> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 118" ;
    dzdoc:position 117 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_11> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "يمارس نشاط الاستشارة في الاتصال ضمن احترام التشريع والتنظيم المعمول بهما . تحدد شروط وكيفيات ممارسة نشاط الاستشارة في الاتصال عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_130_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_130_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_130_20120112_OpEnact_e3406e6969> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_130_obligation_0_09145f5e> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "130" ;
    dzdoc:position 129 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_130_condition_0_6f34b500> ;
    dzdoc:usesTerm dzterm:consultancy_activity .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "تصدر النشريات الدورية للإعلام العام التي تنشأ ابتداء من تاريخ صدور هذا القانون العضوي بإحدى اللغتين الوطنيتين أو كليهما . غير أن النشريات الدورية الموجهة للنشر والتوزيع وطنيا أو دوليا، والنشريات الدورية المتخصصة، يمكن أن تصدر باللغات الأجنبية بعد موافقة سلطة ضبط الصحافة المكتوبة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_20_permission_0_390374ae> ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_20_right_0_132060f9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_20_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_20_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_20_20120112_OpEnact_d3e723139a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_20_obligation_0_41246509> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 20" ;
    dzdoc:position 19 ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "يجب على مسؤول الطبع أن يطلب من الناشر نسخة من الاعتماد مصادقا عليها ، قبل طبع العدد الأول من أية نشرية دورية . ويمنع الطبع في غياب ذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_21_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_21_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_21_20120112_OpEnact_ccb3cc4294> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_21_obligation_0_33af6156>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_21_obligation_1_ffd2cca9> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 20 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "تنشأ سلطة ضبط الصحافة المكتوبة ، وهي سلطة مستقلة تتمتع بالشخصية المعنوية والاستقلال المالي . وتتولى بهذه الصفة، على الخصوص ما يأتي : تشجيع التعددية الإعلامية، السهر على نشر وتوزيع الإعلام المكتوب عبر كامل التراب الوطني، السهر على جودة الرسائل الإعلامية وترقية الثقافة الوطنية وإبرازها بجميع أشكالها، السهر على تشجيع وتدعيم النشر والتوزيع باللغتين الوطنيتين بكل الوسائل الملائمة، السهر على شفافية القواعد الاقتصادية في سير المؤسسات الناشرة، السهر على منع تمركز العناوين والأجهزة تحت التأثير المالي والسياسي والإيديولوجي لمالك واحد، تحديد قواعد وشروط الإعانات والمساعدات التي تمنحها الدولة لأجهزة الإعلام، والسهر على توزيعها، السهر على احترام المقاييس في مجال الإشهار ومراقبة هدفه ومضمونه، استلام تصريح الحسابات المالية للنشريات الدورية من غير تلك الناتجة عن الاستغلال، جمع كل المعلومات الضرورية من الإدارات والمؤسسات الصحفية للتأكد من ضمان احترام التزامات كل منها. لا يمكن أن تستعمل هذه المعلومات التي تجمعها سلطة ضبط الصحافة المكتوبة لأغراض أخرى غير أداء المهام التي يسندها إليها هذا القانون العضوي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40_permission_0_9e908356> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_40_20120112_OpEnact_42bffbb7d9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40_obligation_0_c08be5e8>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_40_obligation_1_d6500655> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 39 ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "تقيد الاعتمادات الضرورية لقيام سلطة ضبط الصحافة المكتوبة بمهامها في الميزانية العامة للدولة . الأمر بالصرف هو رئيس سلطة ضبط الصحافة المكتوبة . تمسك محاسبة سلطة ضبط الصحافة المكتوبة طبقا لقواعد المحاسبة العمومية، من قبل عون محاسب يعينه الوزير المكلف بالمالية . تمارس مراقبة نفقات سلطة ضبط الصحافة المكتوبة طبقا لإجراءات المحاسبة العمومية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_para_2>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_49_20120112_OpEnact_c711df2abc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_obligation_0_c5d26ad8>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_obligation_1_e9471cac>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_49_obligation_2_de67bf95> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 48 ;
    dzdoc:usesTerm dzterm:authorizing_officer,
        dzterm:finance_minister,
        dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يمنع على الصحفي الذي يمارس مهنته بصفة دائمة في نشرية دورية أو وسيلة إعلام، أن يؤدي عملا مهما كانت طبيعته لحساب نشرية دورية أخرى أو وسيلة إعلام أخرى، أو أية هيئة مستخدمة أخرى، إلا بترخيص من الهيئة المستخدمة الرئيسية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_77_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_77_20120112_OpEnact_f37002b48d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_77_obligation_0_04710d28> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_77_prohibition_0_04710d28> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 77" ;
    dzdoc:position 76 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "يعترف لل صحفي المحترف بحق الوصول إلى مصدر الخبر ، ما عدا في الحالات الآتية : عندما يتعلق الخبر بسر الدفاع الوطني كما هو محدد في التشريع المعمول به ، عندما يمس الخبر بأمن الدولة و/أو السيادة الوطنية مساسا واضحا ، عندما يتعلق الخبر بسر البحث والتحقيق القضائي ، عندما يتعلق الخبر بسر اقتصادي استراتيجي ، عندما يكون من شأن الخبر المساس بالسياسة الخارجية والمصالح الاقتصادية للبلاد ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_84_right_0_2a48efb6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_84_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_84_20120112_OpEnact_699d94c99a> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "84" ;
    dzdoc:position 83 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_84_condition_0_c6374b93>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_84_condition_1_281a2f25>,
