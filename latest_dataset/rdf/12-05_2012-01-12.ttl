<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_11> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إصدار كل نشرية دورية يتم بحرية. يخضع إصدار كل نشرية دورية لإجراءات التسجيل ومراقبة صحة المعلومات، بإيداع تصريح مسبق موقع من طرف المدير مسؤول النشرية، لدى سلطة ضبط الصحافة المكتوبة المنصوص عليها في هذا القانون العضوي ، ويسلم له فورا وصل بذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_11_20120112_OpEnact_5fe0534ef9> ;
