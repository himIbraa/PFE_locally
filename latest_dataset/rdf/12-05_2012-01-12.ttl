    dzdoc:replacementText "في حالة نشر أو بث عمل صحفي، من قبل أية وسيلة إعلام ، فإن كل استخدام آخر لهذا العمل يخضع للموافقة المسبقة لصاحبه . يستفيد الصحفي من حق الملكية الأدبية والفنية على أعماله طبقا للتشريع المعمول به."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:targetArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_88> ;
    dzdoc:targetDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

