<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "يحق لكل شخص يرى أنه تعرض لاتهامات كاذبة من شأنها المساس بشرفه أو سمعته أن يستعمل حقه في الرد ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_101_right_0_222a8b77> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_101_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_101_20120112_OpEnact_3008592ec4> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 101" ;
    dzdoc:position 100 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "يقلص أجل الرد من ثمانية (8) أيام إلى أربع وعشرين (24) ساعة خلال فترة الحملة الانتخابية ، إذا كان المرشح محل جدل من قبل خدمة الاتصال السمعي البصري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_109_20120112_OpEnact_4c702af70e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_109_obligation_0_99819889> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 108 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_109_condition_0_1319f5b4> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "يمارس حق الرد أيضا إذا أرفق نشره أو بثه بتعاليق جديدة . وفي هذه الحالة، يجب أن لا يرفق الرد بأي تعليق ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_110_right_0_018cbfd3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_110_20120112_OpEnact_96e13e8293> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_110_obligation_0_c9434c1a> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 109 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "يمكن رفض نشر أو بث الرد إذا كان مضمونه منافيا للقانون أو الآداب العامة أو المنفعة المشروعة للغير أو لشرف الصحفي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_114_permission_0_6eee2b61> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_114_20120112_OpEnact_7f1f99b1d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 113 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_114_condition_0_d06c39df> .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_8> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "يتحمل المدير مسؤول النشرية أو مدير جهاز الصحافة الإلكترونية ، وكذا صاحب الكتابة أو الرسم مسؤولية كل كتابة أو رسم يتم نشرهما من طرف نشرية دورية أو صحافة إلكترونية . ويتحمل مدير خدمة الاتصال السمعي البصري أو عبر الانترنت و صاحب الخبر الذي تم بثه المسؤولية عن الخبر السمعي و/أو البصري المبث من قبل خدمة الاتصال السمعي البصري أو عبر الإنترنت ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_115_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_115_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_115_20120112_OpEnact_f576e977d1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_115_obligation_0_232fe810>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_115_obligation_1_7bea7647> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "115" ;
    dzdoc:position 114 ;
    dzdoc:usesTerm dzterm:audiovisual_communication_service,
        dzterm:author,
        dzterm:director_audiovisual_service,
        dzterm:director_electronic_press,
        dzterm:director_publisher,
        dzterm:electronic_press,
        dzterm:news_author,
        dzterm:periodical_publication .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_10> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "يجب على المؤسسات الإعلامية أن تخصص سنويا نسبة 2% % من أرباحها السنوية لتكوين الصحفيين وترقية الأداء الإعلامي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_129_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_129_20120112_OpEnact_35b0c86f88> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_129_obligation_0_12928ffb> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 129" ;
    dzdoc:position 128 ;
    dzdoc:usesTerm dzterm:media_institutions .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_2> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "تسهر الدولة على ضمان ترقية توزيع الصحافة المكتوبة عبر كامل التراب الوطني ، بهدف تمكين كل المواطنين من الوصول إلى الخبر ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_36_right_0_241df775> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_36_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_36_20120112_OpEnact_f1468ebf5a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_36_obligation_0_b4f52c93> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 35 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "يلتزم أعضاء سلطة ضبط الصحافة المكتوبة وأعوانها بالسر المهني بشأن الوقائع والأعمال والمعلومات التي قد يطلعون عليها بحكم مهامهم ، طبقا لأحكام المادة 301 من قانون العقوبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_47_20120112_OpEnact_ba27a3edf3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_47_obligation_0_f6be1aae> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "47" ;
    dzdoc:position 46 ;
    dzdoc:referencesExternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_47_extref_4c6571be> ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_3> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "تتنافى مهام أعضاء سلطة ضبط الصحافة المكتوبة مع كل عهدة انتخابية أو وظيفة عمومية أو أي نشاط مهني . تحدد تعويضات أعضاء سلطة ضبط الصحافة المكتوبة بموجب مرسوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_56_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_56_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_56_20120112_OpEnact_7dd935012b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_56_obligation_0_9862da14> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 56" ;
    dzdoc:position 55 ;
    dzdoc:usesTerm dzterm:press_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "تخضع كل علاقة عمل بين الهيئة المستخدمة والصحفي إلى عقد عمل مكتوب يحدد حقوق الطرفين وواجباتهما، طبقا للتشريع المعمول به."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_80_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_80_20120112_OpEnact_47a1577b38> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_80_obligation_0_13be4938> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 80" ;
    dzdoc:position 79 .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_1> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يجب على الصحفي أو كاتب المقال الذي يستعمل اسما مستعارا ، أن يبلغ آليا وكتابيا، قبل نشر أعماله، المدير مسؤول النشرية بهويته الحقيقية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_86_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_86_20120112_OpEnact_68819da05b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_86_obligation_0_987dd9c7> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 85 ;
    dzdoc:usesTerm dzterm:journalist .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_2> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "تحدد تشكيلة المجلس الأعلى لآداب وأخلاقيات مهنة الصحافة وتنظيمه وسيره من قبل جمعيته العامة التأسيسية. يستفيد المجلس الأعلى لآداب وأخلاقيات مهنة الصحافة من دعم عمومي لتمويله ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_95_right_0_9eb73f12> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_95_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_95_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_95_20120112_OpEnact_55490378de> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "95" ;
    dzdoc:position 94 ;
    dzdoc:usesTerm dzterm:higher_council_ethics .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_99> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_6_sec_2> ;
    dzdoc:eId "art_99" ;
    dzdoc:fullText "ينصب المجلس الأعلى لآداب وأخلاقيات مهنة الصحافة في أجل أقصاه سنة ابتداء من تاريخ صدور هذا القانون العضوي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_99> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_99_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_99_20120112_OpEnact_306b32e337> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_99_obligation_0_13036d0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "99" ;
    dzdoc:position 98 ;
    dzdoc:usesTerm dzterm:higher_council_ethics .

