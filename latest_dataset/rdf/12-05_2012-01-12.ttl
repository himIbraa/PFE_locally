    dzdoc:versionSourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:versionText "ترفع سلطة ضبط الصحافة المكتوبة سنويا تقريرا إلى رئيس الجمهورية والبرلمان تبين فيه نشاطها . وينشر هذا التقرير."@ar .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_44_20120112_OpEnact_9ae8aec3e7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2012-01-12"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
