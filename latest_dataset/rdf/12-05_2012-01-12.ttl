<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_23> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تتوفر في المدير مسؤول أية نشرية دورية الشروط الآتية : أن يحوز شهادة جامعية، أن يتمتع بخبرة لا تقل عن عشر (10) سنوات في ميدان الإعلام بالنسبة للنشريات الدورية للإعلام العام، وخمس (5) سنوات خبرة في ميدان التخصص العلمي أو التقني أو التكنولوجي بالنسبة للنشريات الدورية المتخصصة، أن يكون جزائري الجنسية، أن يتمتع بحقوقه المدنية، ألا يكون قد حكم عليه بعقوبة مخلة بالشرف، ألا يكون قد قام بسلوك معاد لثورة أول نوفمبر 1954 بالنسبة للأشخاص المولودين قبل يوليو سنة 1942."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_23_20120112_OpEnact_f7cde265b4> ;
    dzdoc:replacementText "يجب أن تتوفر في المدير مسؤول أية نشرية دورية الشروط الآتية : أن يحوز شهادة جامعية، أن يتمتع بخبرة لا تقل عن عشر (10) سنوات في ميدان الإعلام بالنسبة للنشريات الدورية للإعلام العام، وخمس (5) سنوات خبرة في ميدان التخصص العلمي أو التقني أو التكنولوجي بالنسبة للنشريات الدورية المتخصصة، أن يكون جزائري الجنسية، أن يتمتع بحقوقه المدنية، ألا يكون قد حكم عليه بعقوبة مخلة بالشرف، ألا يكون قد قام بسلوك معاد لثورة أول نوفمبر 1954 بالنسبة للأشخاص المولودين قبل يوليو سنة 1942."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_23> ;
