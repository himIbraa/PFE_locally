    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_27_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_27_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_27_20120112_OpEnact_9b3f7a05b6> ;
