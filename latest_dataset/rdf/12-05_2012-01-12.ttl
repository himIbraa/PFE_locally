<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_20> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تصدر النشريات الدورية للإعلام العام التي تنشأ ابتداء من تاريخ صدور هذا القانون العضوي بإحدى اللغتين الوطنيتين أو كليهما . غير أن النشريات الدورية الموجهة للنشر والتوزيع وطنيا أو دوليا، والنشريات الدورية المتخصصة، يمكن أن تصدر باللغات الأجنبية بعد موافقة سلطة ضبط الصحافة المكتوبة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_20_20120112_OpEnact_d3e723139a> ;
    dzdoc:replacementText "تصدر النشريات الدورية للإعلام العام التي تنشأ ابتداء من تاريخ صدور هذا القانون العضوي بإحدى اللغتين الوطنيتين أو كليهما . غير أن النشريات الدورية الموجهة للنشر والتوزيع وطنيا أو دوليا، والنشريات الدورية المتخصصة، يمكن أن تصدر باللغات الأجنبية بعد موافقة سلطة ضبط الصحافة المكتوبة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_20> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
