<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_100_obligation_0_db8a74e1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_100_obligation_0_db8a74e1_action_c03f53674a> ;
    dzdoc:hasRole <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_100_obligation_0_db8a74e1_role_0fb3e36da2> ;
    dznorm:expressedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_100> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجب على المدير مسؤول النشرية أو مدير خدمة الاتصال السمعي البصري أو مدير وسيلة إعلام إلكترونية، أن ينشر أو يبث مجانا كل تصحيح يبلغه إياه شخص طبيعي أو معنوي بشأن وقائع أو آراء، تكون قد أوردتها وسيلة الإعلام المعنية بصورة غير صحيحة"@ar ;
    dznorm:sourceArticle "art_100" .

