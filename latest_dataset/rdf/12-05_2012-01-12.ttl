<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_7> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "يجب على مدير خدمة الاتصال السمعي البصري بث الرد مجانا حسب الشروط التقنية، وبنفس شروط أوقات البث التي بث فيها البرنامج المتضمن الاتهام المنسوب . ويتم الإعلان على أن الرد يندرج في إطار ممارسة حق الرد مع الإشارة إلى عنوان البرنامج المتضمن الاتهام المنسوب بذكر تاريخ أو فترة بثه. لا يمكن أن تتجاوز المدة القصوى للرسالة المتضمنة الرد دقيقتين (2) اثنتين . تستثنى من ممارسة حق الرد الحصص التي يشارك فيها الشخص محل الجدل."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107_permission_0_adc12e57> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107_para_2>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_107_20120112_OpEnact_3159fb2705> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107_obligation_0_f9d13a9c> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 106 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_107_condition_0_2c694095> ;
    dzdoc:usesTerm dzterm:director,
        dzterm:right_of_reply .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "يجب أن تنشر النشريات الدورية سنويا عبر صفحاتها حصيلة الحسابات مصدقا عليها عن السنة الفارطة . وفي حالة عدم القيام بذلك ، توجه سلطة ضبط الصحافة المكتوبة إعذارا إلى النشرية الدورية لنشر حصيلة حساباتها في أجل ثلاثين (30) يوما . وفي حالة عدم نشر الحصيلة في الأجل المذكور أعلاه ، يمكن سلطة ضبط الصحافة المكتوبة أن تقرر وقف صدور النشرية إلى غاية تسوية وضعيتها ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_permission_0_7812ccd2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_30_20120112_OpEnact_b4674e005d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_obligation_0_72525dbf>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_obligation_1_bac3a4eb>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_obligation_2_047d2ff9> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 29 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_condition_0_3b6e77f2>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_30_condition_1_6e2fd980> ;
    dzdoc:usesTerm dzterm:periodical_publication,
        dzterm:regulatory_authority .

<https://legal.dz/resource/organic-law/2012-01-12/12-05#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/organic-law/2012-01-12/12-05#chp_2_sec_1> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "بعد إيداع التصريح المذكور في المادتين 11 و 12 أعلاه وتسليم الوصل ، تمنح سلطة ضبط الصحافة المكتوبة الاعتماد في أجل ستين (60) يوما ابتداء من تاريخ إيداع التصريح. يمنح الاعتماد إلى المؤسسة الناشرة. يعتبر الاعتماد بمثابة الموافقة على الصدور."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_13_para_0>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_13_para_1>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_13_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_13_20120112_OpEnact_e06bd22f6c> ;
    dzdoc:introducedBy <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:introducedOn "2012-01-12"^^xsd:date ;
    dzdoc:number "المادة 13" ;
    dzdoc:position 12 ;
    dzdoc:references <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> ;
    dzdoc:referencesInternal <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_11>,
        <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_12> ;
