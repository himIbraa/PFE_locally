<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_52> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة إخلال عضو سلطة ضبط الصحافة المكتوبة بالتزاماته المحددة في هذا القانون العضوي ، يصرح رئيس سلطة ضبط الصحافة المكتوبة بعد مداولة طبقا لـ المادة 54 أدناه، بالاستقالة التلقائية للعضو المعني. ويصرح رئيس سلطة ضبط الصحافة المكتوبة أيضا بالاستقالة التلقائية لكل عضو يصدر في حقه حكم قضائي نهائي بعقوبة مشينة أو مخلة بالشرف ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_52_20120112_OpEnact_351681605c> ;
    dzdoc:replacementText "في حالة إخلال عضو سلطة ضبط الصحافة المكتوبة بالتزاماته المحددة في هذا القانون العضوي ، يصرح رئيس سلطة ضبط الصحافة المكتوبة بعد مداولة طبقا لـ المادة 54 أدناه، بالاستقالة التلقائية للعضو المعني. ويصرح رئيس سلطة ضبط الصحافة المكتوبة أيضا بالاستقالة التلقائية لكل عضو يصدر في حقه حكم قضائي نهائي بعقوبة مشينة أو مخلة بالشرف ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_52> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
