<https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_117> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب بغرامة من مائة ألف دينار 100.000 دج إلى أربعمائة ألف دينار 400.000 دج كل مدير أي من العناوين أو أجهزة الإعلام المنصوص عليها في المادة 4 أعلاه، تقاضى باسمه الشخصي أو لحساب وسيلة إعلام، سواء بصفة مباشرة أو غير مباشرة أموالا ، أو قبل مزايا من طرف مؤسسة عمومية أو خاصة أجنبية، ماعدا عائدات الاشتراك والإشهار وفقا للأسعار والتنظيمات المعمول بها . يمكن أن تأمر المحكمة بمصادرة الأموال محل الجنحة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/organic-law/2012-01-12/12-05#version_art_117_20120112_OpEnact_19b4497be8> ;
    dzdoc:replacementText "يعاقب بغرامة من مائة ألف دينار 100.000 دج إلى أربعمائة ألف دينار 400.000 دج كل مدير أي من العناوين أو أجهزة الإعلام المنصوص عليها في المادة 4 أعلاه، تقاضى باسمه الشخصي أو لحساب وسيلة إعلام، سواء بصفة مباشرة أو غير مباشرة أموالا ، أو قبل مزايا من طرف مؤسسة عمومية أو خاصة أجنبية، ماعدا عائدات الاشتراك والإشهار وفقا للأسعار والتنظيمات المعمول بها . يمكن أن تأمر المحكمة بمصادرة الأموال محل الجنحة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/organic-law/2012-01-12/12-05#art_117> ;
    dzdoc:sourceDocument <https://legal.dz/resource/organic-law/2012-01-12/12-05> ;
