    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمارس سيادة الدولة على مجالها البري، ومجالها الجوي، وعلى مياهها. كما تمارس الدولة حقها السيد الذي يقره القانون الدولي على كل منطقة من مختلف مناطق المجال البحري التي ترجع إليها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_12_20081116_OpEnact_3663dcb5ef> ;
    dzdoc:replacementText "تمارس سيادة الدولة على مجالها البري، ومجالها الجوي، وعلى مياهها. كما تمارس الدولة حقها السيد الذي يقره القانون الدولي على كل منطقة من مختلف مناطق المجال البحري التي ترجع إليها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_12> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_12> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
