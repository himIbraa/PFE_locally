    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_151> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الحق في الدفاع معترف به . الحق في الدفاع مضمون في القضايا الجزائية ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_152_20081116_OpEnact_f5850358bc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_152> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_152> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_152> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يؤَسس مجلس دولة كهيئة مقومة لأعمال الجهات القضائية الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد ويسهران على احترام القانون. تؤَسس محكمة تنازع تتولى الفصل في حالات تنازع الاختصاص بين المحكمة العليا و مجلس الدولة ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_153_20081116_OpEnact_6c8ad90969> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_153> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_153> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_153> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يحدد قانون عضوي تنظيم المحكمة العليا ، و مجلس الدولة ، و محكمة التنازع ، وعملهم، واختصاصاتهم الأخرى."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_154_20081116_OpEnact_d22ff01c8f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
