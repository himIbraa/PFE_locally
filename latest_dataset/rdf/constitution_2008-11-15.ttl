<https://legal.dz/resource/law/2008-11-15/08-19#version_art_103> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدد كيفيات انتخاب النواب وكيفيات انتخاب أعضاء مجلس الأمة أو تعيينهم، وشروط قابليتهم للانتخاب، ونظام عدم قابليتهم للانتخاب، وحالات التنافي، بموجب قانون عضوي."@ar ;
