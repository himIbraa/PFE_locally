<https://legal.dz/resource/law/2008-11-15/08-19#version_art_115> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد قانون عضوي تنظيم المجلس الشعبي الوطني ومجلس الأمة، وعملهما، وكذا العلاقات الوظيفية بينهما وبين الحكومة. يحدد القانون ميزانية الغرفتين والتعويضات التي تدفع للنواب وأعضاء مجلس الأمة. يعد المجلس الشعبي الوطني ومجلس الأمة نظامهما الداخلي ويصادقان عليهما."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_115_20081116_OpEnact_6df7ee0710> ;
