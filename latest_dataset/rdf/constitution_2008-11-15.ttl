<https://legal.dz/resource/law/2008-11-15/08-19#art_109_obligation_1_7d950591> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-11-15/08-19#art_109_obligation_1_7d950591_action_9aa9a35ff3> ;
