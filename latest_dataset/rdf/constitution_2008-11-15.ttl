<https://legal.dz/resource/law/2008-11-15/08-19#version_art_125_21> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس رئيس الجمهورية السلطة التنظيمية في المسائل غير المخصصة للقانون . يندرج تطبيق القوانين في المجال التنظيمي الذي يعود للوزير الأول (21) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( استبدال وظيفة ” رئيس الحكومة ” بوظيفة ” الوزير الأول “)"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_125_21_20081116_OpEnact_6ffc213682> ;
    dzdoc:replacementText "يمارس رئيس الجمهورية السلطة التنظيمية في المسائل غير المخصصة للقانون . يندرج تطبيق القوانين في المجال التنظيمي الذي يعود للوزير الأول (21) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( استبدال وظيفة ” رئيس الحكومة ” بوظيفة ” الوزير الأول “)"@ar ;
    dzdoc:resolutionStatus "resolved" ;
