    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "على كل أجهزة الدولة المختصة أن تقوم، في كل وقت وفي كل مكان، وفي جميع الظروف، بتنفيذ أحكام القضاء ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_146_20081116_OpEnact_3df176a2e4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_146> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_146> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_146> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يختص القضاء بإصدار الأحكام. ويمكن أن يعينهم في ذلك مساعدون شعبيون حسب الشروط التي يحددها القانون ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_147_20081116_OpEnact_f5bc11e9b0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
