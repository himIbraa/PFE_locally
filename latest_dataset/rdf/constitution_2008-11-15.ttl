<https://legal.dz/resource/law/2008-11-15/08-19#version_art_109> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحصانة البرلمانية معترف بها للنواب ولأعضاء مجلس الأمة مدة نيابتهم ومهمتهم البرلمانية. ولا يمكن أن يتابعوا أو يوقفوا. وعلى العموم لا يمكن أن ترفع عليهم أية دعوى مدنية أو جزائية أو يسلط عليهم أي ضغط بسبب ما عبروا عنه من آراء أو ما تلفظوا به من كلام، أو بسبب تصويتهم خلال ممارسة مهامهم البرلمانية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_109_20081116_OpEnact_762843a3f3> ;
    dzdoc:replacementText "الحصانة البرلمانية معترف بها للنواب ولأعضاء مجلس الأمة مدة نيابتهم ومهمتهم البرلمانية. ولا يمكن أن يتابعوا أو يوقفوا. وعلى العموم لا يمكن أن ترفع عليهم أية دعوى مدنية أو جزائية أو يسلط عليهم أي ضغط بسبب ما عبروا عنه من آراء أو ما تلفظوا به من كلام، أو بسبب تصويتهم خلال ممارسة مهامهم البرلمانية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_109> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_109> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

