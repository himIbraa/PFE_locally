<https://legal.dz/resource/law/2008-11-15/08-19#version_art_75> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فورأدائه اليمين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
