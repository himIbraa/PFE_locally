    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_34> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_34> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تضمن الدولة عدم انتهاك حرمة الإنسان . ويحظر أي عنف بدني أو معنوي أو أي مساس بالكرامة."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_35_20081116_OpEnact_d45f0aa88e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_35> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_35> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_35> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يعاقب القانون على المخالفات المرتكبة ضد الحقوق والحريات وعلى كل ما يمس سلامة الإنسان البدنية والمعنوية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_36_20081116_OpEnact_3df9fbfe2e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_36> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_36> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_36> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا مساس بحرمة حرية المعتقد، وحرمة حرية الرأي ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_37_20081116_OpEnact_32fba859e2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_37> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_37> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_37> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "حرية التجارة والصناعة مضمونة ، وتمارس في إطار القانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_38_20081116_OpEnact_605e075758> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_38> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_38> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_38> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "حرية الابتكار الفكري والفني والعلمي مضمونة للمواطن . حقوق المؤلف يحميها القانون . لا يجوز حجز أي مطبوع أو تسجيل أو أية وسيلة أخرى من وسائل التبليغ والإعلام إلا بمقتضى أمر قضائي ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_39_20081116_OpEnact_df8137cb9a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_39> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_39> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_39> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا يجوز انتهاك حرمة حياة المواطن الخاصة، وحرمة شرفه ، ويحميهما القانون. سرية المراسلات والاتصالات الخاصة بكل أشكالها مضمونة ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_3_20081116_OpEnact_1799829794> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_3> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_3> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_3> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "اللغة العربية هي اللغة الوطنية والرسمية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_3__1_20081116_OpEnact_f5d47f1729> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_3_مكرر1> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_3_مكرر1> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_3_مكرر1> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تمازيغت هي كذلك لغة وطنية. تعمل الدولة لترقيتها وتطويرها بكل تنوعاتها اللسانية المستعملة التراب الوطني. (1) القانون رقم 02-03 المؤرخ في 27 محرم عام 1423 الموافق 10 أبريل سنة 2002 المتضمن التعديل الدستوري. ( دسترة تمازيغت بصفتها لغة وطنية)."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_40_20081116_OpEnact_695de4d670> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_40> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_40> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_40> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تضمن الدولة عدم انتهاك حرمة المسكن . فلا تفتيش إلا بمقتضى القانون، وفي إطار احترامه . ولا تفتيش إلا بأمر مكتوب صادر عن السلطة القضائية المختصة ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_41_20081116_OpEnact_a8437c8d3d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_41> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_41> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_41> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "حريات التعبير، وإنشاء الجمعيات، والاجتماع، مضمونة للمواطن ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_42_20081116_OpEnact_9c7afa525e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_42> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_42> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_42> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "حق إنشاء الأحزاب السياسية معترف به ومضمون . ولا يمكن التذرع بهذا الحق لضرب الحريات الأساسية، والقيم والمكونات الأساسية للهوية الوطنية، والوحدة الوطنية، وأمن التراب الوطني وسلامته، واستقلال البلاد، وسيادة الشعب، وكذا الطابع الديمقراطي والجمهوري للدولة . وفي ظل احترام أحكام هذا الدستور، لا يجوز تأسيس الأحزاب السياسية على أساس ديني أو لغوي أو عرقي أو جنسي أو مهني أو جهوي . ولا يجوز للأحزاب السياسية اللجوء إلى الدعاية الحزبية التي تقوم على العناصر المبينة في الفقرة السابقة . يحظر على الأحزاب السياسية كل شكل من أشكال التبعية للمصالح أو الجهات الأجنبية . لا يجوز أن يلجأ أي حزب سياسي إلى استعمال العنف أو الإكراه مهما كانت طبيعتهما أو شكلهما . تحدد التزامات وواجبات أخرى بموجب قانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_43_20081116_OpEnact_94b2bfd135> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_43> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_43> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_43> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "حق إنشاء الجمعيات مضمون . تشجع الدولة ازدهار الحركة الجمعوية . يحدد القانون شروط وكيفيات إنشاء الجمعيات ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_44_20081116_OpEnact_33e9fda128> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_44> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_44> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_44> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يحق لكل مواطن يتمتع بحقوقه المدنية والسياسية، أن يختار بحرية موطن إقامته، وأن يتنقل عبر التراب الوطني . حق الدخول إلى التراب الوطني والخروج منه مضمون له ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_45_20081116_OpEnact_d60fc98555> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_45> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_45> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_45> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "كل شخص يعتبر بريئا حتى تثبت جهة قضائية نظامية إدانته ، مع كل الضمانات التي يتطلبها القانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_46_20081116_OpEnact_9792fb6029> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_46> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_46> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_46> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا إدانة إلا بمقتضى قانون صادر قبل ارتكاب الفعل المجرم ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_47_20081116_OpEnact_47e98fa7ea> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_47> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_47> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_47> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا يتابع أحد، ولا يوقف أو يحتجز إلا في الحالات المحددة بالقانون، وطبقا للأشكال التي نص عليها ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_48_20081116_OpEnact_424a3f660a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_48> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_48> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_48> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون . ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_49_20081116_OpEnact_ee4db85993> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_49> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_49> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_49> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يترتب على الخطاء القضائي تعويض من الدولة . ويحدد القانون شروط التعويض وكيفياته."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_4_20081116_OpEnact_89d5d8ca79> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
