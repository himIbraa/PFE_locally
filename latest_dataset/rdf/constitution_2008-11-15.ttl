    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_23> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "عدم تحيز الإدارة يضمنه القانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_24_20081116_OpEnact_f7f3d3aaf8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_24> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_24> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_24> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الدولة مسؤولة عن أمن الأشخاص والممتلكات، وتتكفل بحماية كل مواطن في الخارج."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_25_20081116_OpEnact_8a3b7a2fe4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_25> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_25> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_25> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي . تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية. كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي، ومختلف مناطق أملاكها البحرية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_26_20081116_OpEnact_e26dcc01b6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_26> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_26> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_26> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها. وتبذل جهدها لتسوية الخلافات الدولية بالوسائل السلمية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_27_20081116_OpEnact_ae5f36ca55> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_27> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_27> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_27> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الجزائر متضامنة مع جميع الشعوب التي تكافح من أجل التحرر السياسي والاقتصادي ، و الحق في تقرير المصير ، وضد كل تمييز عنصري."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_28_20081116_OpEnact_9ab56a7131> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_28> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_28> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_28> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تعمل الجزائر من أجل دعم التعاون الدولي، وتنمية العلاقات الودية بين الدول، على أساس المساواة، والمصلحة المتبادلة، وعدم التدخل في الشؤون الداخلية . وتتبنى مبادئ ميثاق الأمم المتحدة وأهدافه."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_29_20081116_OpEnact_bddc4d0259> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_29> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_29> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_29> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "كل المواطنين سواسية أمام القانون . ولا يمكن أن يتذرع بأي تمييز يعود سببه إلى المولد، أو العرق، أو الجنس، أو الرأي، أو أي شرط أو ظرف آخر، شخصي أو اجتماعي."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_2_20081116_OpEnact_31ada14318> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_2> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الإسلام دين الدولة."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_30_20081116_OpEnact_3d9961a560> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_30> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_30> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_30> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الجنسية الجزائرية، معرفة بالقانون . شروط اكتساب الجنسية الجزائرية ، والاحتفاظ بها، أو فقدانها، أو إسقاطها، محددة بالقانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_31_20081116_OpEnact_c6413d3a26> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_31> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_31> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_31> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تستهدف المؤسسات ضمان مساواة كل المواطنين والمواطنات في الحقوق والواجبات بإزالة العقبات التي تعوق تفتح شخصية الإنسان، وتحول دون مشاركة الجميع الفعلية في الحياة السياسية، والاقتصادية، والاجتماعية، والثقافية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_32_20081116_OpEnact_f6c732df4d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_32> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_32> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_32> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الحريات الأساسية وحقوق الإنسان والمواطن مضمونة . وتكون تراثا مشتركا بين جميع الجزائريين والجزائريات، واجبهم أن ينقلوه من جيل إلى جيل كي يحافظوا على سلامته، وعدم انتهاك حرمته ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_33_20081116_OpEnact_c20c02c06c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_33> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_33> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_33> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الدفاع الفردي أو عن طريق الجمعية عن الحقوق الأساسية للإنسان وعن الحريات الفردية والجماعية، مضمون ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_34_20081116_OpEnact_0d66513ef5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
