<https://legal.dz/resource/law/2008-11-15/08-19#version_art_102> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب المجلس الشعبي الوطني لمدة خمس (05) سنوات. تحدد مهمة مجلس الأمة بمدة ست (06) سنوات. تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (03) سنوات. لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية واستشارة المجلس الدستوري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_102_20081116_OpEnact_7d863c028b> ;
    dzdoc:replacementText "ينتخب المجلس الشعبي الوطني لمدة خمس (05) سنوات. تحدد مهمة مجلس الأمة بمدة ست (06) سنوات. تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (03) سنوات. لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية واستشارة المجلس الدستوري ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_102> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_102> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
