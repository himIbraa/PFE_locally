<https://legal.dz/resource/law/2008-11-15/08-19#version_art_80_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقدم الوزير الأول مخطط عمله إلى المجلس الشعبي الوطني للموافقة عليه. ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن للوزير الأول أن يكيف مخطط العمل هذا، على ضوء هذه المناقشة، بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمله لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني. يمكن لمجلس الأمة أن يصدر لائحة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_80_8_20081116_OpEnact_6e172acb6e> ;
    dzdoc:replacementText "يقدم الوزير الأول مخطط عمله إلى المجلس الشعبي الوطني للموافقة عليه. ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن للوزير الأول أن يكيف مخطط العمل هذا، على ضوء هذه المناقشة، بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمله لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني. يمكن لمجلس الأمة أن يصدر لائحة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_80_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
