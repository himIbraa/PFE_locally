<https://legal.dz/resource/law/2008-11-15/08-19#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "يقرر رئيس الجمهورية التعبئة العامة في مجلس الوزراء بعد الاستماع إلى المجلس الأعلى للأمن واستشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_94_20081116_OpEnact_14a6d9b777> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "94" ;
    dzdoc:position 94 ;
    dzdoc:usesTerm dzterm:president .

