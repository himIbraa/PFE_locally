    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تحمي السلطة القضائية المجتمع والحريات، وتضمن للجميع ولكل واحد المحافظة على حقوقهم الأساسية ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_13_20081116_OpEnact_05a9ac825b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
