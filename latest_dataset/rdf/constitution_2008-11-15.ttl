<https://legal.dz/resource/law/2008-11-15/08-19#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "يجدد نصف (1/2) عدد أعضاء مجلس الأمة أثناء مدة العضوية الأولى عقب السنة الثالثة عن طريق القرعة . و يستخلف أعضاء مجلس الأمة الذين وقعت عليهم القرعة وفق الشروط نفسها وحسب الإجراء نفسه المعمول به في انتخابهم أو تعيينهم . لا تشمل القرعة رئيس مجلس الأمة الذي يمارس العهدة الأولى مدة ست (6) سنوات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_181_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_181_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_181_20081116_OpEnact_6fb30ad692> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_181_obligation_0_d0103991>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_181_obligation_1_ae254cf4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 180 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_181_condition_0_5241c415> ;
    dzdoc:usesTerm dzterm:council_of_nation .

<https://legal.dz/resource/law/2008-11-15/08-19#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "لا يمكن أن تكون الوظائف في مؤسسات الدولة مصدرا للثراء، ولا وسيلة لخدمة المصالح الخاصة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_21_permission_0_c0df376a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_21> ;
