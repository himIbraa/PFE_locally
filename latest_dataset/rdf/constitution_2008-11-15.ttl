<https://legal.dz/resource/law/2008-11-15/08-19#version_art_130> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين . يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان، المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_130_20081116_OpEnact_935a5eb0f3> ;
    dzdoc:replacementText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين . يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان، المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية ."@ar ;
