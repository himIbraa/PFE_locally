<https://legal.dz/resource/law/2008-11-15/08-19#version_art_152> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يؤَسس مجلس دولة كهيئة مقومة لأعمال الجهات القضائية الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد ويسهران على احترام القانون. تؤَسس محكمة تنازع تتولى الفصل في حالات تنازع الاختصاص بين المحكمة العليا و مجلس الدولة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_152_20081116_OpEnact_f5850358bc> ;
    dzdoc:replacementText "تمثل المحكمة العليا الهيئة المقومة لأعمال المجالس القضائية والمحاكم. يؤَسس مجلس دولة كهيئة مقومة لأعمال الجهات القضائية الإدارية. تضمن المحكمة العليا و مجلس الدولة توحيد الاجتهاد القضائي في جميع أنحاء البلاد ويسهران على احترام القانون. تؤَسس محكمة تنازع تتولى الفصل في حالات تنازع الاختصاص بين المحكمة العليا و مجلس الدولة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_152> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_152> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetScope "whole_article" ;
