    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_89> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_89_obligation_1_efbc0888> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2008-11-15/08-19#art_89_obligation_1_efbc0888_period_779edda8af> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_89> ;
