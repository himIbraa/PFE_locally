    dzdoc:eId "art_117" ;
    dzdoc:fullText "يشكل المجلس الشعبي الوطني ومجلس الأمة لجانهما الدائمة في إطار نظامهما الداخلي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_117_para_0> ;
