<https://legal.dz/resource/law/2008-11-15/08-19#version_art_177> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن ثلاثة أرباع (3/4) أعضاء غرفتي البرلمان المجتمعتين معا، أن يبادروا باقتراح تعديل الدستور على رئيس الجمهورية الذي يمكنه عرضه على الاستفتاء الشعبي . ويصدره في حالة الموافقة عليه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_177_20081116_OpEnact_6b4d357d60> ;
