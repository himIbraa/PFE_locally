dzterm:parliament a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "البرلمان"@ar,
        "برلمان"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_118_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_118_18" ;
    dzdoc:fullText "يجتمع البرلمان في دورتين عاديتين كل سنة، ومدة كل دورة أربعة (04) أشهر على الأقل. يمكن أن يجتمع البرلمان في دورة غير عادية بمبادرة من رئيس الجمهورية. ويمكن كذلك أن يجتمع باستدعاء من رئيس الجمهورية بطلب من الوزير الأول ، أو بطلب من ثلثي (3/2) أعضاء المجلس الشعبي الوطني. تختتم الدورة غير العادية بمجرد ما يستنفذ البرلمان جدول الأعمال الذي استدعي من أجله."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_118_18_permission_0_055b0e92> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_118_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_118_18_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_118_18_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_118_18_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_118_18_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_118_18_20081116_OpEnact_83e8bfffe4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "118 (18)" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:prime_minister .

<https://legal.dz/resource/law/2008-11-15/08-19#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية ، والانتخابات التشريعية، ويعلن نتائج هذه العمليات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_163_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_163_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_163_20081116_OpEnact_f57c9f4911> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_163_obligation_0_ede666d0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_163_obligation_1_c7bac15e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 162 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:constitutional_council,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText "يخطر رئيس الجمهورية أو رئيس المجلس الشعبي الوطني أو رئيس مجلس الأمة ، المجلس الدستوري ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_166_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
