<https://legal.dz/resource/law/2008-11-15/08-19#version_art_174> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني و مجلس الأمة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على استفتاء الشعب خلال الخمسين (50) يوما الموالية لإقراره . يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_174_20081116_OpEnact_38499a918f> ;
    dzdoc:replacementText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني و مجلس الأمة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على استفتاء الشعب خلال الخمسين (50) يوما الموالية لإقراره . يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_174> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_174> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_175> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب . ولا يمكن عرضه من جديد على الشعب خلال الفترة التشريعية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_175_20081116_OpEnact_4e4901adba> ;
    dzdoc:replacementText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب . ولا يمكن عرضه من جديد على الشعب خلال الفترة التشريعية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_175> ;
