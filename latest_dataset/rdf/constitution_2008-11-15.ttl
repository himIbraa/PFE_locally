<https://legal.dz/resource/law/2008-11-15/08-19#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الأملاك الوطنية يحددها القانون. وتتكون من الأملاك العمومية والخاصة التي تملكها كل من الدولة ، والولاية، والبلدية. يتم تسيير الأملاك الوطنية طبقا للقانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_18_20081116_OpEnact_3dc76b66d3> ;
    dzdoc:replacementText "الأملاك الوطنية يحددها القانون. وتتكون من الأملاك العمومية والخاصة التي تملكها كل من الدولة ، والولاية، والبلدية. يتم تسيير الأملاك الوطنية طبقا للقانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_18> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_18> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
