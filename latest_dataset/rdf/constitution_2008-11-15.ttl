<https://legal.dz/resource/law/2008-11-15/08-19#version_art_116_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جلسات البرلمان علانية. وتدون مداولاته في محاضر تنشر طبقا للشروط التي يحددها القانون العضوي. يجوز للمجلس الشعبي الوطني ومجلس الأمة أن يعقدا جلسات مغلقة بطلب من رئيسيهما، أو من أغلبية أعضائهما الحاضرين، أو بطلب من الوزير الأول ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
