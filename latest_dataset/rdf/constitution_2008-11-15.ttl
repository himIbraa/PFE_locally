    dzdoc:eId "art_138" ;
    dzdoc:fullText "السلطة القضائية مستقلة، وتمارس في إطار القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_138> ;
