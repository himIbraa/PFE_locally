    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_45_20081116_OpEnact_d60fc98555> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 45 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "لا إدانة إلا بمقتضى قانون صادر قبل ارتكاب الفعل المجرم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_46_20081116_OpEnact_9792fb6029> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_46_obligation_0_819b28fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 46 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "لا يتابع أحد، ولا يوقف أو يحتجز إلا في الحالات المحددة بالقانون، وطبقا للأشكال التي نص عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_47_20081116_OpEnact_47e98fa7ea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_47_obligation_0_cb5ef50e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 47 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "لكل مواطن تتوفر فيه الشروط القانونية أن ينتخب وينتخب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_50_right_0_52a45c21> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_50_20081116_OpEnact_93375da184> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 50" ;
    dzdoc:position 50 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يتساوى جميع المواطنين في تقلد المهام والوظائف في الدولة دون أية شروط أخرى غير الشروط التي يحددها القانون."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_51_right_0_9b39a61d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_51_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_51_20081116_OpEnact_4b2efd26b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 51 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_56> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_56" ;
    dzdoc:fullText "الحق النقابي معترف به لجميع المواطنين ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_56_right_0_57aa4771> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_56> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_56_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_56_20081116_OpEnact_dbe129fdac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 56" ;
    dzdoc:position 56 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "تحظى الأسرة بحماية الدولة والمجتمع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_58_20081116_OpEnact_47d0a89145> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_58_obligation_0_777169bb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 58" ;
    dzdoc:position 58 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "ظروف معيشة المواطنين الذين لم يبلغوا سن العمل، والذين لا يستطيعون القيام به، والذين عجزوا عنه نهائيا، مضمونة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_59_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_59_20081116_OpEnact_8596e09982> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_59_obligation_0_8d0b6832> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 59 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_2> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "الشعب مصدر كل سلطة. السيادة الوطنية ملك للشعب وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_6_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_6_20081116_OpEnact_833b5f2579> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 6 ;
    dzdoc:usesTerm dzterm:people,
        dzterm:sovereignty .

<https://legal.dz/resource/law/2008-11-15/08-19#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "يتمتع كل أجنبي، يكون وجوده فوق التراب الوطني قانونيا، بحماية شخصه وأملاكه طبقا للقانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_67_right_0_e1b942a7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_67_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_67_20081116_OpEnact_e645d1184b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 67 ;
    dzdoc:usesTerm dzterm:law .

<https://legal.dz/resource/law/2008-11-15/08-19#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_2> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "يختار الشعب لنفسه مؤسسات، غايتها ما يأتي : المحافظة على الاستقلال الوطني، ودعمه، المحافظة على الهوية، والوحدة الوطنية، ودعمهما، حماية الحريات الأساسية للمواطن ، والازدهار الاجتماعي والثقافي للأمة، القضاء على استغلال الإنسان للإنسان، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب، أو الاختلاس، أو الاستحواذ، أو المصادرة غير المشروعة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_8_right_0_ee0881e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_8_20081116_OpEnact_9c59cee6ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 8 ;
    dzdoc:usesTerm dzterm:people .

<https://legal.dz/resource/law/2008-11-15/08-19#art_83_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_83_10" ;
    dzdoc:fullText "ينفذ الوزير الأول وينسق مخطط العمل الذي يصادق عليه المجلس الشعبي الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_83_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_83_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_83_10_20081116_OpEnact_17972b4ffc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_83_10_obligation_0_37bf6d13> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "83 (10)" ;
    dzdoc:position 83 ;
    dzdoc:usesTerm dzterm:national_assembly,
        dzterm:prime_minister .

