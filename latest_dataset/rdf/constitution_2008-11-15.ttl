<https://legal.dz/resource/law/2008-11-15/08-19#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_9_20081116_OpEnact_18c9f01b55> ;
    dzdoc:replacementText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_9> ;
