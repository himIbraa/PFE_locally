    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_88> ;
    dznorm:position 3 ;
    dznorm:provisionText "يجتمع المجلس الدستوري وجوبا ويثبت الشغور النهائي لرئاسة الجمهورية."@ar ;
    dznorm:sourceArticle "art_88" .

<https://legal.dz/resource/law/2008-11-15/08-19#art_88_obligation_4_58b12fb6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_88> ;
    dznorm:position 4 ;
    dznorm:provisionText "وتبلغ فورا شهادة التصريح بالشغور النهائي إلى البرلمان الذي يجتمع وجوبا."@ar ;
    dznorm:sourceArticle "art_88" .

<https://legal.dz/resource/law/2008-11-15/08-19#art_88_obligation_5_190fe605> a dznorm:Obligation ;
