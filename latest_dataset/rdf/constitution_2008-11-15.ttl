    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا يخضع القاضي إلا للقانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_149_20081116_OpEnact_7450f6478a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
