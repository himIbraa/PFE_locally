<https://legal.dz/resource/law/2008-11-15/08-19#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "الجزائر جمهورية ديمقراطية شعبية. وهي وحدة لا تتجزأ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_1_para_0> ;
