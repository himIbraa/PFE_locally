<https://legal.dz/resource/law/2008-11-15/08-19#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "السلطة التأسيسية ملك للشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها. يمارس الشعب هذه السيادة عن طريق الاستفتاء وبواسطة ممثليه المنتخبين. لـ رئيس الجمهورية أن يلتجئ إلي إرادة الشعب مباشرة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
