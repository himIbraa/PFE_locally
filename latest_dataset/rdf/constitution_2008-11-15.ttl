<https://legal.dz/resource/law/2008-11-15/08-19#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس السلطة التشريعية برلمان يتكون من غرفتين، وهما المجلس الشعبي الوطني و مجلس الأمة . وله السيادة في إعداد القانون والتصويت عليه ."@ar ;
