<https://legal.dz/resource/law/2008-11-15/08-19#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز الشروع في متابعة أي نائب أو عضو مجلس الأمة بسبب جناية أو جنحة إلا بتنازل صريح منه، أو بإذن، حسب الحالة، من المجلس الشعبي الوطني أو مجلس الأمة الذي يقرر رفع الحصانة عنه بأغلبية أعضائه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_110_20081116_OpEnact_8eb7dde3a1> ;
