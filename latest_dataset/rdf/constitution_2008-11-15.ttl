<https://legal.dz/resource/law/2008-11-15/08-19#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "يعاقب القانون على التعسف في استعمال السلطة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_22> ;
