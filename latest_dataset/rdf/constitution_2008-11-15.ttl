<https://legal.dz/resource/law/2008-11-15/08-19#version_art_118_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجتمع البرلمان في دورتين عاديتين كل سنة، ومدة كل دورة أربعة (04) أشهر على الأقل. يمكن أن يجتمع البرلمان في دورة غير عادية بمبادرة من رئيس الجمهورية. ويمكن كذلك أن يجتمع باستدعاء من رئيس الجمهورية بطلب من الوزير الأول ، أو بطلب من ثلثي (3/2) أعضاء المجلس الشعبي الوطني. تختتم الدورة غير العادية بمجرد ما يستنفذ البرلمان جدول الأعمال الذي استدعي من أجله."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_118_18_20081116_OpEnact_83e8bfffe4> ;
    dzdoc:replacementText "يجتمع البرلمان في دورتين عاديتين كل سنة، ومدة كل دورة أربعة (04) أشهر على الأقل. يمكن أن يجتمع البرلمان في دورة غير عادية بمبادرة من رئيس الجمهورية. ويمكن كذلك أن يجتمع باستدعاء من رئيس الجمهورية بطلب من الوزير الأول ، أو بطلب من ثلثي (3/2) أعضاء المجلس الشعبي الوطني. تختتم الدورة غير العادية بمجرد ما يستنفذ البرلمان جدول الأعمال الذي استدعي من أجله."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_118_18> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
