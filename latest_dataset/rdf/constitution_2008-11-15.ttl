<https://legal.dz/resource/law/2008-11-15/08-19#art_76_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_76> ;
    dzdoc:position 0 ;
    dzdoc:text "يؤدي رئيس الجمهورية اليمين حسب النص الآتي :"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_76_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_76> ;
    dzdoc:position 1 ;
    dzdoc:text "” بسم الله الرحمن الرحيم ، وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده، وأدافع عن الدستور، وأسهر على استمرارية الدولة، وأعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري، وأسعى من أجل تدعيم المسار الديمقراطي، وأحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، وأحافظ على سلامة التراب الوطني، ووحدة الشعب والأمة، وأحمي الحريات والحقوق الأساسية للإنسان والمواطن، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة والحرية والسلم في العالم. والله على ما أقول شهيد “."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_extref_8fb72ba6> a dzdoc:ExternalReference ;
    rdfs:label "الدستور"@ar ;
    dzdoc:frbrUri "/akn/dz/act/constitution/1996-11-28/96-438"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/constitution/1996-11-28/96-438"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/constitution/1996-11-28/96-438" ;
    dzdoc:referencesTarget <https://legal.dz/resource/constitution/1996-11-28/96-438> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/constitution/1996-11-28/96-438"^^xsd:anyURI .

<https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_obligation_0_830d7c15> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_obligation_0_830d7c15_ref_8fb72ba6fe0d> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_obligation_0_830d7c15_ref_8fb72ba6fe0d> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6> ;
    dznorm:position 0 ;
    dznorm:provisionText "يضطلع رئيس الجمهورية، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، بالسلطات والصلاحيات الآتية :"@ar ;
    dznorm:sourceArticle "art_77_6" .

<https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6> ;
    dzdoc:position 0 ;
    dzdoc:text "يضطلع رئيس الجمهورية، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور، بالسلطات والصلاحيات الآتية : هو القائد الأعلى للقوات المسلحة للجمهورية، يتولى مسؤولية الدفاع الوطني، يقرر السياسة الخارجية للأمة ويوجهها، يرأس مجلس الوزراء، يعين الوزير الأول وينهي مهامه، يمكن رئيس الجمهورية أن يفوض جزءا من صلاحيته للوزير الأول لرئاسة اجتماعات الحكومة، مع مراعاة أحكام المادة 87 من الدستور، يمكنه أن يعين نائبا أو عدة نواب للوزير الأول بغرض مساعدة الوزير الأول في ممارسة وظائفه، و ينهي مهامهم، يوقع المراسيم الرئاسية، له حق إصدار العفو و حق تخفيض العقوبات أو استبدالها، يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، يبرم المعاهدات الدولية ويصادق عليها، يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_permission_0_9a134a1c> a dznorm:Permission ;
