<https://legal.dz/resource/law/2008-11-15/08-19#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يحدد قانون عضوي تنظيم المحكمة العليا ، و مجلس الدولة ، و محكمة التنازع ، وعملهم، واختصاصاتهم الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_153> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_153_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_153_20081116_OpEnact_6c8ad90969> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 152 ;
    dzdoc:usesTerm dzterm:conflict_court,
        dzterm:state_council,
        dzterm:supreme_court .

<https://legal.dz/resource/law/2008-11-15/08-19#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يرأس رئيس الجمهورية ، المجلس الأعلى للقضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_154_para_0> ;
