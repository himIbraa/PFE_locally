    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_58> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تحظى الأسرة بحماية الدولة والمجتمع ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_59_20081116_OpEnact_8596e09982> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_59> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_59> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_59> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "ظروف معيشة المواطنين الذين لم يبلغوا سن العمل، والذين لا يستطيعون القيام به، والذين عجزوا عنه نهائيا، مضمونة ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_5_2_20081116_OpEnact_9d4314dde4> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_5_2> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_5_2> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_5_2> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "العلم الوطني و النشيد الوطني من مكاسب ثورة أول نوفمبر 1954 و هما غير قابلين للتغيير. هذان الرمزان من رموز الثورة، هما رمزان للجمهورية بالصفات التالية : علم الجزائر أخضر و أبيض تتوسطه نجمة و هلال أحمر اللون. النشيد الوطني هو ” قسما ” بجميع مقاطعه. يحدد القانون خاتم الدول. (2) القانون رقم 08-19 المؤرخ في 17 ذي القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( دسترة صفات العلم الوطني و النشيد الوطني)"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_60_20081116_OpEnact_b4c17741dd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_60> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_60> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_60> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا يعذر بجهل القانون . يجب على كل شخص أن يحترم الدستور وقوانين الجمهورية ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_61_20081116_OpEnact_106e472a9a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_61> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_61> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_61> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يجب على كل مواطن أن يحمي ويصون استقلال البلاد وسيادتها وسلامة ترابها الوطني وجميع رموز الدولة . يعاقب القانون بكل صرامة على الخيانة والتجسس والولاء للعدو، وعلى جميع الجرائم المرتكبة ضد أمن الدولة."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_62_4_20081116_OpEnact_bf8087e58d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_62_4> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "على كل مواطن أن يؤدي بإخلاص واجباته تجاه المجموعة الوطنية . التزام المواطن إزاء الوطن وإجبارية المشاركة في الدفاع عنه، واجبان مقدسان دائمان . تضمن الدولة احترام رموز الثورة، وأرواح الشهداء، وكرامة ذويهم، والمجاهدين . و تعمل كذلك على ترقية كتابة التاريخ، وتعليمه للأجيال الناشئة."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_63_20081116_OpEnact_51ae9a2132> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_63> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_63> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_63> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يمارس كل واحد جميع حرياته، في إطار احترام الحقوق المعترف بها للغير في الدستور ، لا سيما احترام الحق في الشرف ، و ستر الحياة الخاصة ، و حماية الأسرة والشبيبة والطفولة ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_64_20081116_OpEnact_dee2e10b93> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_64> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_64> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "كل المواطنين متساوون في أداء الضريبة. ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_65_20081116_OpEnact_d3e8b83ee6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يجازي القانون الآباء على القيام بـ واجب تربية أبنائهم ورعايتهم ، كما يجازي الأبناء على القيام بـ واجب الإحسان إلى آبائهم ومساعدتهم ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_66_20081116_OpEnact_7dce4fc610> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_66> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_66> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_66> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يجب على كل مواطن أن يحمي الملكية العامة، ومصالح المجموعة الوطنية، ويحترم ملكية الغير ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_67_20081116_OpEnact_e645d1184b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يتمتع كل أجنبي، يكون وجوده فوق التراب الوطني قانونيا، بحماية شخصه وأملاكه طبقا للقانون ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_68_20081116_OpEnact_b6d6da96ca> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_68> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_68> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_68> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا يسلم أحد خارج التراب الوطني إلا بناء على قانون تسليم المجرمين وتطبيقا له."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_69_20081116_OpEnact_3081b0c388> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_69> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_69> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_69> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا يمكن بأي حال من الأحوال أن يسلم أو يطرد لا جئ سياسي يتمتع قانونا بـ حق اللجوء ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_6_20081116_OpEnact_833b5f2579> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الشعب مصدر كل سلطة. السيادة الوطنية ملك للشعب وحده."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_70_20081116_OpEnact_f51c8d1df2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_70> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_70> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_70> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "رئيس الجمهورية ، رئيس الدولة ، يجسد وحدة الأمة. وهو حامي الدستور . ويجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_71_20081116_OpEnact_4710d8fc06> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_71> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_71> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_71> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "ينتخب رئيس الجمهورية ، عن طريق الاقتراع العام المباشر والسري. يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. ويحدد القانون الكيفيات الأخرى للانتخابات الرئاسية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_72_20081116_OpEnact_53cf770a62> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
