    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_149> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "القاضي مسؤول أمام المجلس الأعلى للقضاء عن كيفية قيامه بمهمته، حسب الأشكال المنصوص عليها في القانون ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_14_20081116_OpEnact_95537af526> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_14> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_14> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_14> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تقوم الدولة على مبادئ التنظيم الديمقراطي والعدالة الاجتماعية. المجلس المنتخب هو الإطار الذي يعبر فيه الشعب عن إرادته، ويراقب عمل السلطات العمومية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_150_20081116_OpEnact_3398e92dd3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_150> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_150> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_150> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يحمي القانون المتقاضي من أي تعسف أو أي انحراف يصدر من القاضي ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_151_20081116_OpEnact_fb73ce2a70> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
