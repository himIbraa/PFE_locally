dzterm:national_peoples_assembly a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي الوطني"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_2> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "الشعب حر في اختيار ممثليه. لا حدود لتمثيل الشعب ، إلا ما نص عليه الدستور و قانون الانتخابات ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_10_right_0_37f1fcac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_10_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_10_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_10_20081116_OpEnact_c86bf09f57> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "10" ;
    dzdoc:position 10 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:electoral_law,
        dzterm:people .

<https://legal.dz/resource/law/2008-11-15/08-19#art_106> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_106" ;
    dzdoc:fullText "كل نائب أو عضو مجلس الأمة لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لسقوط مهمته البرلمانية. ويقرر المجلس الشعبي الوطني أو مجلس الأمة ، حسب الحالة، هذا السقوط بأغلبية أعضائهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_106> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_106_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_106_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_106_20081116_OpEnact_0cc1d944e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 106" ;
    dzdoc:position 106 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_106_condition_0_14e00619> ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/law/2008-11-15/08-19#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "النائب أو عضو مجلس الأمة مسؤول أمام زملائه الذين يمكنهم تجريده من مهمته النيابية إن اقترف فعلا يخل بشرف مهمته . يحدد النظام الداخلي لكل واحدة من الغرفتين، الشروط التي يتعرض فيها أي نائب أو عضو مجلس الأمة للإقصاء. ويقرر هذا الإقصاء، حسب الحالة، المجلس الشعبي الوطني أو مجلس الأمة بأغلبية أعضائهما، دون المساس بجميع المتابعات الأخرى الواردة في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_107_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_107_20081116_OpEnact_7c529c7dea> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 107 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_107_condition_0_5bb515dc> ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:national_peoples_assembly .

<https://legal.dz/resource/law/2008-11-15/08-19#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تستمد الدولة مشروعيتها وسبب وجودها من إرادة الشعب. شعارها : ” بالشعب وللشعب “. وهي في خدمته وحده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_11_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_11_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_11_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_11_20081116_OpEnact_de9b414ec8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 11" ;
    dzdoc:position 11 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/law/2008-11-15/08-19#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "لا يقبل اقتراح أي قانون، مضمونه أو نتيجته تخفيض الموارد العمومية، أو زيادة النفقات العمومية، إلا إذا كان مرفوقا بتدابير تستهدف الزيادة في إيرادات الدولة، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_121_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_121_20081116_OpEnact_e7d235c1f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "121" ;
    dzdoc:position 121 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_121_condition_0_2893db1a> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "تحمي السلطة القضائية المجتمع والحريات، وتضمن للجميع ولكل واحد المحافظة على حقوقهم الأساسية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_139_20081116_OpEnact_1767e4f0fd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_139_obligation_0_c8564567> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 139" ;
    dzdoc:position 139 ;
    dzdoc:usesTerm dzterm:judicial_authority .

<https://legal.dz/resource/law/2008-11-15/08-19#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "على كل أجهزة الدولة المختصة أن تقوم، في كل وقت وفي كل مكان، وفي جميع الظروف، بتنفيذ أحكام القضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_145_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_145_20081116_OpEnact_4c2356221e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_145_obligation_0_603cf404> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 145" ;
    dzdoc:position 145 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "يختص القضاء بإصدار الأحكام. ويمكن أن يعينهم في ذلك مساعدون شعبيون حسب الشروط التي يحددها القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_146_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_146_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_146_20081116_OpEnact_3df176a2e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 146" ;
    dzdoc:position 146 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_146_condition_0_732c65d3> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_155> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_155" ;
    dzdoc:fullText "يقرر المجلس الأعلى للقضاء ، طبقا للشروط التي يحددها القانون ، تعيين القضاة، ونقلهم، وسير سلمهم الوظيفي. ويسهر على احترام أحكام القانون الأساسي للقضاء، وعلى رقابة انضباط القضاة تحت رئاسة الرئيس الأول للمحكمة العليا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_155> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_155_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_155_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_155_20081116_OpEnact_451afd412d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 155" ;
    dzdoc:position 154 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_155_condition_0_86d14ec6> ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/law/2008-11-15/08-19#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "تقدم الحكومة لكل غرفة من البرلمان عرضا عن استعمال الاعتمادات المالية التي أقرتها لكل سنة مالية . تختتم السنة المالية فيما يخص البرلمان ، بالتصويت على قانون يتضمن تسوية ميزانية السنة المالية المعنية من قبل كل غرفة من البرلمان ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_160> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_160_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_160_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_160_20081116_OpEnact_1051d6ad1e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_160_obligation_0_a8e0b597> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 160" ;
    dzdoc:position 159 ;
    dzdoc:usesTerm dzterm:government,
        dzterm:parliament .

<https://legal.dz/resource/law/2008-11-15/08-19#art_168> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_168" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري عدم دستورية معاهدة أو اتفاق،أو اتفاقية ، فلا يتم التصديق عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_168> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_168_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_168_20081116_OpEnact_cdb5eb6cf3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_168_obligation_0_a7e41b08> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 168" ;
    dzdoc:position 167 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_168_condition_0_0f4f60db> ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/law/2008-11-15/08-19#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري أن نصا تشريعيا أو تنظيميا غير دستوري ، يفقد هذا نص أثره، ابتداء من يوم قرار المجلس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_169_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_169_20081116_OpEnact_2c1c811597> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_169_obligation_0_03fb7be4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 169" ;
    dzdoc:position 168 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_169_condition_0_2e597329> ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/law/2008-11-15/08-19#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "الأملاك الوطنية يحددها القانون. وتتكون من الأملاك العمومية والخاصة التي تملكها كل من الدولة ، والولاية، والبلدية. يتم تسيير الأملاك الوطنية طبقا للقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_18_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_18_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_18_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_18_20081116_OpEnact_3dc76b66d3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 18 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/law/2008-11-15/08-19#art_180> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_180" ;
    dzdoc:fullText "ريثما يتم تنصيب المؤسسات المنصوص عليها في هذا الدستور : يستمر سريان مفعول القوانين التي تتعلق بالمواضيع التي تخضع لمجال القوانين العضوية، إلى أن تعدل أو تستبدل وفق الإجراءات المنصوص عليها في الدستور، يمارس المجلس الدستوري بتمثيله الحالي الاختصاصات المسندة إليه بموجب هذا الدستور، حتى تاريخ تنصيب المؤسسات الممثلة فيه. وكل تغيير أو إضافة يجب أن يتم مع مراعاة الفقرة 3 من المادة 164 من هذا الدستور، مع استعمال القرعة عند الحاجة، يمارس المجلس الشعبي الوطني المنتخب السلطة التشريعية كاملة حتى تنصيب مجلس الأمة . و يمكن رئيس الجمهورية وقف إصدار القوانين المتخذة بمبادرة من النواب إلى غاية المصادقة عليها من قبل مجلس الأمة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_180_right_0_c39ad7b1> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_180> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_180_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_180_20081116_OpEnact_411c40314e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 180" ;
    dzdoc:position 179 ;
    dzdoc:references <https://legal.dz/resource/law/2008-11-15/08-19#art_164> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-11-15/08-19#art_164> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_council,
        dzterm:council_of_nation,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_182> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_182" ;
    dzdoc:fullText "يصدر رئيس الجمهورية نص التعديل الدستوري الذي أقره الشعب ، و ينفذ كقانون أساسي للجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_182> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_182_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_182_20081116_OpEnact_a93a0de2a8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_182_obligation_0_7748720b>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_182_obligation_1_ba9aadbc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 182" ;
    dzdoc:position 181 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "تنتظم الطاقة الدفاعية للأمة، ودعمها، وتطويرها، حول الجيش الوطني الشعبي . تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني، والدفاع عن السيادة الوطنية. كما يضطلع بالدفاع عن وحدة البلاد، وسلامتها الترابية، وحماية مجالها البري والجوي، ومختلف مناطق أملاكها البحرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_25_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_25_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_25_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_25_20081116_OpEnact_8a3b7a2fe4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 25" ;
    dzdoc:position 25 ;
    dzdoc:usesTerm dzterm:anp .

<https://legal.dz/resource/law/2008-11-15/08-19#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها. وتبذل جهدها لتسوية الخلافات الدولية بالوسائل السلمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_26_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_26_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_26_20081116_OpEnact_e26dcc01b6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_26_obligation_0_6f775748> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 26" ;
    dzdoc:position 26 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "الجزائر متضامنة مع جميع الشعوب التي تكافح من أجل التحرر السياسي والاقتصادي ، و الحق في تقرير المصير ، وضد كل تمييز عنصري."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_27_right_0_804d9170> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_27_20081116_OpEnact_ae5f36ca55> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_27_obligation_0_409116c0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 27 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "تعمل الجزائر من أجل دعم التعاون الدولي، وتنمية العلاقات الودية بين الدول، على أساس المساواة، والمصلحة المتبادلة، وعدم التدخل في الشؤون الداخلية . وتتبنى مبادئ ميثاق الأمم المتحدة وأهدافه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_28_20081116_OpEnact_9ab56a7131> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_28_obligation_0_56734ac1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 28" ;
    dzdoc:position 28 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:definesTerm dzterm:nationality ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "الجنسية الجزائرية، معرفة بالقانون . شروط اكتساب الجنسية الجزائرية ، والاحتفاظ بها، أو فقدانها، أو إسقاطها، محددة بالقانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_30> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2008-11-15/08-19#art_30_defocc_283286249132> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_30_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_30_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_30_20081116_OpEnact_3d9961a560> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 30" ;
    dzdoc:position 30 ;
    dzdoc:usesTerm dzterm:nationality .

<https://legal.dz/resource/law/2008-11-15/08-19#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة الإنسان . ويحظر أي عنف بدني أو معنوي أو أي مساس بالكرامة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_34> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_34_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_34_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_34_20081116_OpEnact_0d66513ef5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_34_obligation_0_6ae6c4df> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 34" ;
    dzdoc:position 34 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "يجازي القانون الآباء على القيام بـ واجب تربية أبنائهم ورعايتهم ، كما يجازي الأبناء على القيام بـ واجب الإحسان إلى آبائهم ومساعدتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_65_20081116_OpEnact_d3e8b83ee6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_65_obligation_0_bede1239>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_65_obligation_1_6092d0d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 65" ;
    dzdoc:position 65 ;
    dzdoc:usesTerm dzterm:law .

<https://legal.dz/resource/law/2008-11-15/08-19#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "ينتخب رئيس الجمهورية ، عن طريق الاقتراع العام المباشر والسري. يتم الفوز في الانتخاب بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها. ويحدد القانون الكيفيات الأخرى للانتخابات الرئاسية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_71_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_71_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_71_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_71_20081116_OpEnact_4710d8fc06> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "71" ;
    dzdoc:position 71 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "إذا لم تحصل من جديد موافقة المجلس الشعبي الوطني ينحل وجوبا. تستمر الحكومة القائمة في تسيير الشؤون العادية إلى غاية انتخاب المجلس الشعبي الوطني وذلك في أجل أقصاه ثلاثة (3) أشهر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_82_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_82_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_82_20081116_OpEnact_0cd5698ef6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 82 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_82_condition_0_f8dffce7> ;
    dzdoc:usesTerm dzterm:national_assembly .

<https://legal.dz/resource/law/2008-11-15/08-19#art_86_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_86_13" ;
    dzdoc:fullText "يمكن الوزير الأول أن يقدم استقالة الحكومة ل رئيس الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_86_13_permission_0_8dbd40aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_86_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_86_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_86_13_20081116_OpEnact_1985aba7b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "86 (13)" ;
    dzdoc:position 86 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2008-11-15/08-19#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "يمارس السلطة التشريعية برلمان يتكون من غرفتين، وهما المجلس الشعبي الوطني و مجلس الأمة . وله السيادة في إعداد القانون والتصويت عليه ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_98_right_0_d2f47341> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_98> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_98_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_98_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_98_20081116_OpEnact_4e863eddf4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 98" ;
    dzdoc:position 98 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:legislative_power,
        dzterm:national_peoples_assembly,
        dzterm:parliament .

dzterm:apn a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الشعبي الوطني"@ar,
        "للمجلس الشعبي الوطني"@ar .

dzterm:constitution a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدستور"@ar,
        "للدستور"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "ينتخب أعضاء المجلس الشعبي الوطني عن طريق الاقتراع العام المباشر والسري. ينتخب ثلثا (2/3) أعضاء مجلس الأمة عن طريق الاقتراع غير المباشر والسري من بين ومن طرف أعضاء المجالس الشعبية البلدية والمجلس الشعبي الولائي. ويعين رئيس الجمهورية الثلث الآخر من أعضاء مجلس الأمة من بين الشخصيات والكفاءات الوطنية في المجالات العلمية والثقافية والمهنية والاقتصادية والاجتماعية. عدد أعضاء مجلس الأمة يساوي، على الأكثر، نصف عدد أعضاء المجلس الشعبي الوطني . يحدد القانون كيفيات تطبيق الفقرة الثانية السابقة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_101_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_101_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_101_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_101_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_101_20081116_OpEnact_063ba90da4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 101" ;
    dzdoc:position 101 ;
    dzdoc:usesTerm dzterm:council_of_nation,
        dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "تبتدئ الفترة التشريعية، وجوبا، في اليوم العاشر الموالي لتاريخ انتخاب المجلس الشعبي الوطني ، تحت رئاسة أكبر النواب سنا، وبمساعدة أصغر نائبين منهم. ينتخب المجلس الشعبي الوطني مكتبه ويشكل لجانه. تطبق الأحكام السابقة الذكر على مجلس الأمة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_113_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_113_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_113_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_113_20081116_OpEnact_0dc5aa6481> ;
