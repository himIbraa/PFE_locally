    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_138> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "السلطة القضائية مستقلة، وتمارس في إطار القانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_139_20081116_OpEnact_1767e4f0fd> a dzdoc:ArticleVersion ;
