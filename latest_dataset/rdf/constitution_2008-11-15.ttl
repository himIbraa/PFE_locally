    dzdoc:eId "art_159" ;
    dzdoc:fullText "تضطلع المجالس المنتخبة بوظيفة الرقابة في مدلولها الشعبي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_159> ;
