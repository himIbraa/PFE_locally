    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_52> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الملكية الخاصة مضمونة . حق الإرث مضمون . الأملاك الوقفية وأملاك الجمعيات الخيرية معترف بها ، و يحمي القانون تخصيصها ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_53_20081116_OpEnact_71e0204af2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_53> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_53> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_53> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الحق في التعليم مضمون . التعليم مجاني حسب الشروط التي يحددها القانون. التعليم الأساسي إجباري . تنظم الدولة المنظومة التعليمية . تسهر الدولة على التساوي في الالتحاق بالتعليم، والتكوين المهني ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_54_20081116_OpEnact_b12d4a29ab> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_54> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_54> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_54> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "الرعاية الصحية حق للمواطنين . تتكفل الدولة بالوقاية من الأمراض الوبائية والمعدية وبمكافحتها ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_55_20081116_OpEnact_c49a90cc4f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_55> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_55> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_55> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لكل المواطنين الحق في العمل . يضمن القانون في أثناء العمل الحق في الحماية، والأمن، والنظافة . الحق في الراحة مضمون ، ويحدد القانون كيفيات ممارسته."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_56_20081116_OpEnact_dbe129fdac> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
