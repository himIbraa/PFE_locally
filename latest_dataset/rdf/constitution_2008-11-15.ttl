<https://legal.dz/resource/law/2008-11-15/08-19#art_16_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_16> ;
    dzdoc:position 0 ;
    dzdoc:text "يمثل المجلس المنتخب قاعدة اللامركزية، ومكان مشاركة المواطنين في تسيير الشؤون العمومية."@ar .

