    dzdoc:text "يحدد قانون عضوي كيفيات وشروط تطبيق هذه الأحكام."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_8_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_8> ;
    dzdoc:position 0 ;
    dzdoc:text "يختار الشعب لنفسه مؤسسات، غايتها ما يأتي : المحافظة على الاستقلال الوطني، ودعمه، المحافظة على الهوية، والوحدة الوطنية، ودعمهما، حماية الحريات الأساسية للمواطن، والازدهار الاجتماعي والثقافي للأمة، القضاء على استغلال الإنسان للإنسان، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب، أو الاختلاس، أو الاستحواذ، أو المصادرة غير المشروعة."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_8_right_0_ee0881e4> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_8> ;
    dznorm:position 0 ;
    dznorm:provisionText "الحريات الأساسية للمواطن"@ar ;
    dznorm:sourceArticle "art_8" .

<https://legal.dz/resource/law/2008-11-15/08-19#art_90_15_condition_0_6bd26193> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2008-11-15/08-19#art_90_15_condition_0_6bd26193_action_ed90fb6543> ;
    dzdoc:hasActivity <https://legal.dz/resource/law/2008-11-15/08-19#art_90_15_condition_0_6bd26193_activity_908f8160a2> ;
    dznorm:conditionText "لا يمكن أن تقال أو تعدل الحكومة القائمة إبان حصول مانع لرئيس الجمهورية، أو وفاته، أو استقالته، حتى يشرع رئيس الجمهورية الجديد في ممارسة مهامه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_90_15> ;
    dznorm:position 0 .

