<https://legal.dz/resource/law/2008-11-15/08-19#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "اللغة العربية هي اللغة الوطنية والرسمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_3_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_3_20081116_OpEnact_1799829794> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:arabic_language .

<https://legal.dz/resource/law/2008-11-15/08-19#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يعاقب القانون على المخالفات المرتكبة ضد الحقوق والحريات وعلى كل ما يمس سلامة الإنسان البدنية والمعنوية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_35_20081116_OpEnact_d45f0aa88e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 35" ;
    dzdoc:position 35 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "عاصمة الجمهورية مدينة الجزائر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_4_20081116_OpEnact_89d5d8ca79> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "4" ;
    dzdoc:position 4 ;
    dzdoc:usesTerm dzterm:algiers .

<https://legal.dz/resource/law/2008-11-15/08-19#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "لا يسلم أحد خارج التراب الوطني إلا بناء على قانون تسليم المجرمين وتطبيقا له."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_68_20081116_OpEnact_b6d6da96ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 68 ;
    dzdoc:usesTerm dzterm:extradition_law .

<https://legal.dz/resource/law/2008-11-15/08-19#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يمارس رئيس الجمهورية ، السلطة السامية في الحدود المثبتة في الدستور ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_72_20081116_OpEnact_53cf770a62> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "72" ;
    dzdoc:position 72 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
