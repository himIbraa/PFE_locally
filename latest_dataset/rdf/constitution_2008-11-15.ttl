<https://legal.dz/resource/law/2008-11-15/08-19#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "ينتخب المجلس الشعبي الوطني لمدة خمس (05) سنوات. تحدد مهمة مجلس الأمة بمدة ست (06) سنوات. تجدد تشكيلة مجلس الأمة بالنصف كل ثلاث (03) سنوات. لا يمكن تمديد مهمة البرلمان إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت البرلمان المنعقد بغرفتيه المجتمعتين معا هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية واستشارة المجلس الدستوري ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_102_permission_0_a62bb0cb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_102_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_102_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_102_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_102_para_3>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_102_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_102_20081116_OpEnact_7d863c028b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_102_obligation_0_4923baa0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 102" ;
    dzdoc:position 102 ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:council_of_nation,
        dzterm:national_peoples_assembly,
        dzterm:parliament,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_129_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_129_22" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يقرر حل المجلس الشعبي الوطني ، أو إجراء انتخابات تشريعية قبل أوانها ، بعد استشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، و الوزير الأول . وتجري هذه الانتخابات في كلتا الحالتين في أجل أقصاه ثلاثة (03) أشهر. (22) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( استبدال وظيفة ” رئيس الحكومة ” بوظيفة ” الوزير الأول “)"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_permission_0_60734357> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_right_0_84611261> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_129_22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_129_22_20081116_OpEnact_1d07ff09f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 129 (22)" ;
    dzdoc:position 129 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_extref_cf1de335> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_condition_0_7a38074e> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2008-11-15/08-19#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "لا يجوز انتهاك حرمة حياة المواطن الخاصة، وحرمة شرفه ، ويحميهما القانون. سرية المراسلات والاتصالات الخاصة بكل أشكالها مضمونة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_39_permission_0_1d202042> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_39_right_0_8bbd505f>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_39_right_1_e3b0822f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_39_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_39_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_39_20081116_OpEnact_df8137cb9a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-11-15/08-19#art_39_prohibition_0_1d202042> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 39" ;
    dzdoc:position 39 .

dzterm:council_of_nation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مجلس الأمة"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "لا يجوز الشروع في متابعة أي نائب أو عضو مجلس الأمة بسبب جناية أو جنحة إلا بتنازل صريح منه، أو بإذن، حسب الحالة، من المجلس الشعبي الوطني أو مجلس الأمة الذي يقرر رفع الحصانة عنه بأغلبية أعضائه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_110_permission_0_719df5d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_110_20081116_OpEnact_8eb7dde3a1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_110_obligation_0_3cf49cd6> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-11-15/08-19#art_110_prohibition_0_719df5d8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 110 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_110_condition_0_bb4b1f43> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "يصدر رئيس الجمهورية القانون في أجل ثلاثين (30) يوما، ابتداء من تاريخ تسلمه إياه . غير أنه إذا أخطرت سلطة من السلطات المنصوص عليها في المادة 166 الآتية، المجلس الدستوري، قبل صدور القانون ، يوقف هذا الأجل حتى يفصل في ذلك المجلس الدستوري وفق الشروط التي تحددها المادة 167 الآتية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_126_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_126_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_126_20081116_OpEnact_674956ee41> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_126_obligation_0_7bb2a461> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 126" ;
    dzdoc:position 126 ;
    dzdoc:references <https://legal.dz/resource/law/2008-11-15/08-19#art_166>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_167> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-11-15/08-19#art_166>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_167> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_126_condition_0_7c044c6d> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يوجه خطابا إلى البرلمان ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_128_permission_0_240fa2f6> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_128_right_0_e9f99f58> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_128_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_128_20081116_OpEnact_bfcd4c6603> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 128" ;
    dzdoc:position 128 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "يمكن البرلمان أن يفتح مناقشة حول السياسة الخارجية بناء على طلب رئيس الجمهورية أو رئيس إحدى الغرفتين . يمكن أن تتوج هذه المناقشة، عند الاقتضاء، بإصدار البرلمان، المنعقد بغرفتيه المجتمعتين معا، لائحة يبلغها إلى رئيس الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_130_permission_0_9fdb4e89>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_130_permission_1_ba849150> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_130_right_0_11bfd62a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_130_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_130_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_130_20081116_OpEnact_935a5eb0f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 130" ;
    dzdoc:position 130 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_158_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_158_24" ;
    dzdoc:fullText "تؤسس محكمة عليا للدولة ، تختص بمحاكمة رئيس الجمهورية عن الأفعال التي يمكن وصفها بالخيانة العظمى، و الوزير الأول عن الجنايات والجنح، التي يرتكبانها بمناسبة تأديتهما مهامهما . يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذا الإجراءات المطبقة . (24) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( استبدال وظيفة ” رئيس الحكومة ” بوظيفة ” الوزير الأول “)"@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_permission_0_7d06a70e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_158_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_158_24_20081116_OpEnact_b0bc5677e9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_obligation_0_27ca01e0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_obligation_1_48df232a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 158 (24)" ;
    dzdoc:position 157 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24_extref_cf1de335> ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president,
        dzterm:prime_minister,
        dzterm:supreme_court_of_state .

<https://legal.dz/resource/law/2008-11-15/08-19#art_176> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_176" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري أن مشروع أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري، وحقوق الإنسان والمواطن وحرياتهما، ولا يمس بأي كيفية التوازنات الأساسية للسلطات والمؤسسات الدستورية، وعلل رأيه ، أمكن رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الاستفتاء الشعبي ، متى أحرز ثلاثة أرباع (3/4) أصوات أعضاء غرفتي البرلمان ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_176_right_0_bcd50739> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_176> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_176_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_176_20081116_OpEnact_a2429a01cd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 176" ;
    dzdoc:position 175 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_176_condition_0_aacf4f4f>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_176_condition_1_76eca6c2> ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "حرية الابتكار الفكري والفني والعلمي مضمونة للمواطن . حقوق المؤلف يحميها القانون . لا يجوز حجز أي مطبوع أو تسجيل أو أية وسيلة أخرى من وسائل التبليغ والإعلام إلا بمقتضى أمر قضائي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_38_permission_0_e572d87b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_38_right_0_aa355506>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_38_right_1_b4af3016> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_38_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_38_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_38_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_38_20081116_OpEnact_605e075758> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-11-15/08-19#art_38_prohibition_0_e572d87b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 38" ;
    dzdoc:position 38 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_38_condition_0_9d307c43> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "الحق في الإضراب معترف به ، ويمارس في إطار القانون. يمكن أن يمنع القانون ممارسة هذا الحق، أو يجعل حدودا لممارسته في ميادين الدفاع الوطني والأمن، أو في جميع الخدمات أو الأعمال العمومية ذات المنفعة الحيوية للمجتمع ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_57_permission_0_2707fc1c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_57_right_0_ec8eef20> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_57_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_57_20081116_OpEnact_e875e7a5ec> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-11-15/08-19#art_57_prohibition_0_2707fc1c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 57" ;
    dzdoc:position 57 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_57_condition_0_b03824e3> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "لا يحق أن ينتخب لرئاسة الجمهورية إلا المترشح الذي : يتمتع، فقط، بالجنسية الجزائرية الأصلية ، يدين بالإسلام ، يكون عمره أربعين (40) سنة كاملة يوم الانتخاب ، يتمتع بكامل حقوقه المدنية والسياسية ، يثبت الجنسية الجزائرية لزوجه ، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942 ، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942 ، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه ، تحدد شروط أخرى بموجب القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_73_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_73_20081116_OpEnact_c30e3b4fd5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "73" ;
    dzdoc:position 73 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_0_046120d3>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_1_dbe7c34f>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_2_cb09e588>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_3_2814a3e7>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_4_295678df>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_5_eb010bb2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_6_6f909d1e>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_73_condition_7_5a4f478a> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "يعين رئيس الجمهورية في الوظائف والمهام الآتية : الوظائف والمهام المنصوص عليها في الدستور ، الوظائف المدنية والعسكرية في الدولة، التعيينات التي تتم في مجلس الوزراء، رئيس مجلس الدولة، الأمين العام للحكومة، محافظ بنك الجزائر، القضاة، مسؤولو أجهزة الأمن، الولاة. ويعين رئيس الجمهورية سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب وأوراق إنهاء مهامهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_78_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_78_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_78_20081116_OpEnact_860a7fbb04> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_78_obligation_0_d055a199> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 78" ;
    dzdoc:position 78 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2008-11-15/08-19#art_78_extref_8fb72ba6> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يطلب إجراء مداولة ثانية في قانون تم التصويت عليه في غضون الثلاثين (30) يوما الموالية لتاريخ إقراره . وفي هذه الحالة لا يتم إقرار القانون إلا بأغلبية ثلثي (3/2) أعضاء المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_127_permission_0_16bcdff9> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_127_right_0_93dff93c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_127_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_127_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_127_20081116_OpEnact_66b8f6e71b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 127" ;
    dzdoc:position 127 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "الحق في التعليم مضمون . التعليم مجاني حسب الشروط التي يحددها القانون. التعليم الأساسي إجباري . تنظم الدولة المنظومة التعليمية . تسهر الدولة على التساوي في الالتحاق بالتعليم، والتكوين المهني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_53_right_0_777dfa7e>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_53_right_1_76460077> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_53_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_53_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_53_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_53_para_3>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_53_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_53_20081116_OpEnact_71e0204af2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_53_obligation_0_ba684010>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_53_obligation_1_35ad2d16>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_53_obligation_2_dd36b1ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 53" ;
    dzdoc:position 53 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "تتم الموافقة على ملتمس الرقابة بتصويت أغلبية ثلثي (2/3) النواب . ولا يتم التصويت إلا بعد ثلاثة (03) أيام من تاريخ إيداع ملتمس الرقابة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_136_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_136_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_136_20081116_OpEnact_ab12816a8b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 136" ;
    dzdoc:position 136 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_136_condition_0_5862097d>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_136_condition_1_d721b9f0> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_77_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_77_6" ;
    dzdoc:fullText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، بالسلطات والصلاحيات الآتية : هو القائد الأعلى للقوات المسلحة للجمهورية، يتولى مسؤولية الدفاع الوطني، يقرر السياسة الخارجية للأمة ويوجهها، يرأس مجلس الوزراء، يعين الوزير الأول وينهي مهامه، يمكن رئيس الجمهورية أن يفوض جزءا من صلاحيته للوزير الأول لرئاسة اجتماعات الحكومة، مع مراعاة أحكام المادة 87 من الدستور ، يمكنه أن يعين نائبا أو عدة نواب للوزير الأول بغرض مساعدة الوزير الأول في ممارسة وظائفه، و ينهي مهامهم، يوقع المراسيم الرئاسية، له حق إصدار العفو و حق تخفيض العقوبات أو استبدالها ، يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء، يبرم المعاهدات الدولية ويصادق عليها، يسلم أوسمة الدولة ونياشينها وشهاداتها التشريفية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_permission_0_9a134a1c> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_right_0_99679886>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_right_1_418943dd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_77_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_77_6_20081116_OpEnact_f45ab9f0e0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_obligation_0_830d7c15> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 77 (6)" ;
    dzdoc:position 77 ;
    dzdoc:references <https://legal.dz/resource/law/2008-11-15/08-19#art_87> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2008-11-15/08-19#art_77_6_extref_8fb72ba6> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-11-15/08-19#art_87> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2008-11-15/08-19#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "يوقف العمل ب الدستور مدة حالة الحرب ويتولى رئيس الجمهورية جميع السلطات . وإذا انتهت المدة الرئاسية ل رئيس الجمهورية تمدد وجوبا إلى غاية نهاية الحرب . في حالة استقالة رئيس الجمهورية أو وفاته أو حدوث أي مانع آخر له ، يخول رئيس مجلس الأمة باعتباره رئيسا للدولة، كل الصلاحيات التي تستوجبها حالة الحرب ، حسب الشروط نفسها التي تسري على رئيس الجمهورية . في حالة اقتران شغوررئاسة الجمهورية ورئاسة مجلس الأمة ، يتولى رئيس المجلس الدستوري وظائف رئيس الدولة حسب الشروط المبينة سابقا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_96_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_96_20081116_OpEnact_76425c39b9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_96_obligation_0_0a76cbeb>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_obligation_1_087e015c>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_obligation_2_9d7d5691>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_obligation_3_cd51199d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 96" ;
    dzdoc:position 96 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_96_condition_0_e40cb7e4>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_condition_1_1120c8c3>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_96_condition_2_65809a9c> ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:head_of_constitutional_council,
        dzterm:head_of_council_of_nation,
        dzterm:president,
        dzterm:war_state .

dzterm:prime_minister a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوزير الأول"@ar,
        "للوزير الأول"@ar,
        "وزير الأول"@ar,
        "وزيرا أول"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يمكن المجلس الشعبي الوطني لدى مناقشته بيان السياسة العامة، أن يصوت على ملتمس رقابة ينصب على مسؤولية الحكومة . ولا يقبل هذا الملتمس إلا إذا وقعه سبع (7/1) عدد النواب على الأقل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_135_permission_0_8c8c7401> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_135_right_0_93572a1f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_135_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_135_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_135_20081116_OpEnact_605e7e7429> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 135" ;
    dzdoc:position 135 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_135_condition_0_ed591233> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:government .

<https://legal.dz/resource/law/2008-11-15/08-19#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني و مجلس الأمة بنفس الصيغة حسب الشروط نفسها التي تطبق على نص تشريعي ، يعرض التعديل على استفتاء الشعب خلال الخمسين (50) يوما الموالية لإقراره . يصدر رئيس الجمهورية التعديل الدستوري الذي صادق عليه الشعب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_174_right_0_d606ac4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_174_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_174_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_174_20081116_OpEnact_38499a918f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_174_obligation_0_fc2d552a>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_174_obligation_1_1122fd51> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 173 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_174_condition_0_fbab1abf> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:council_of_nation,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "في حالة وفاة أحد المترشحين للانتخابات الرئاسية في الدور الثاني أو انسحابه أو حدوث أي مانع آخر له ، يستمر رئيس الجمهورية القائم أو من يمارس مهام رئاسة الدولة في ممارسة مهامه إلى غاية الإعلان عن انتخاب رئيس الجمهورية. في هذه الحالة، يمدد المجلس الدستوري مهلة إجراء هذه الانتخابات لمدة أقصاها ستون (60) يوما. يحدد قانون عضوي كيفيات وشروط تطبيق هذه الأحكام."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_89_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_89_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_89_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_89_20081116_OpEnact_eac4c59cc9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_89_obligation_0_c4619d3d>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_89_obligation_1_efbc0888>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_89_obligation_2_344f85b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "89" ;
    dzdoc:position 89 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_89_condition_0_5af54280> ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:president .

