<https://legal.dz/resource/law/2008-11-15/08-19#art_178_25_extref_cf1de335> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/2008-11-15/08-19"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/2008-11-15/08-19"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/2008-11-15/08-19" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:resolutionReason "canonical_akn_path_alias" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/2008-11-15/08-19"^^xsd:anyURI .

<https://legal.dz/resource/law/2008-11-15/08-19#art_178_25_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_178_25> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمكن أي تعديل دستوري أن يمس : الطابع الجمهوري للدولة، النظام الديمقراطي القائم على التعددية الحزبية، الإسلام باعتباره دين الدولة، العربية باعتبارها اللغة الوطنية والرسمية، الحريات الأساسية وحقوق الإنسان والمواطن، سلامة التراب الوطني ووحدته. العلم الوطني و النشيد الوطني باعتبارهما من رموز الثورة و الجمهورية."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_178_25_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_178_25> ;
    dzdoc:position 1 ;
    dzdoc:text "(25) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. (إدراج العلم الوطني و النشيد الوطني ضمن المواضيع التي لا تقبل أي تعديل)"@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_178_25_permission_0_0ef8db0e> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
