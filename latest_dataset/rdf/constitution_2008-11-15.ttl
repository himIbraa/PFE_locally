    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_154> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يرأس رئيس الجمهورية ، المجلس الأعلى للقضاء ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_155_20081116_OpEnact_451afd412d> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_155> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_155> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_155> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يقرر المجلس الأعلى للقضاء ، طبقا للشروط التي يحددها القانون ، تعيين القضاة، ونقلهم، وسير سلمهم الوظيفي. ويسهر على احترام أحكام القانون الأساسي للقضاء، وعلى رقابة انضباط القضاة تحت رئاسة الرئيس الأول للمحكمة العليا."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_156_20081116_OpEnact_6ee2f95959> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_156> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_156> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_156> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبليا في ممارسة رئيس الجمهورية حق العفو."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_157_20081116_OpEnact_aed1c63bc3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
