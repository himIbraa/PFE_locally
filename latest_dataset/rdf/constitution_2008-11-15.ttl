<https://legal.dz/resource/law/2008-11-15/08-19#art_111_condition_0_69fbc225> a dznorm:Condition ;
    dznorm:conditionText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية"@ar ;
