    dzdoc:number "المادة 154" ;
    dzdoc:position 153 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:supreme_council_judiciary .

<https://legal.dz/resource/law/2008-11-15/08-19#art_156> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_156" ;
    dzdoc:fullText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبليا في ممارسة رئيس الجمهورية حق العفو."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_156> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_156_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_156_20081116_OpEnact_6ee2f95959> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 156" ;
    dzdoc:position 155 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:supreme_council_judiciary .

<https://legal.dz/resource/law/2008-11-15/08-19#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يحدد قانون عضوي تشكيل المجلس الأعلى للقضاء ، وعمله، وصلاحياته الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_157_20081116_OpEnact_aed1c63bc3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 156 ;
    dzdoc:usesTerm dzterm:supreme_council_judiciary .

<https://legal.dz/resource/law/2008-11-15/08-19#art_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_16" ;
    dzdoc:fullText "يمثل المجلس المنتخب قاعدة اللامركزية، ومكان مشاركة المواطنين في تسيير الشؤون العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_16_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_16_20081116_OpEnact_ccda9ebc13> ;
