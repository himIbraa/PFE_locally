        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "يقرر رئيس الجمهورية الحالة الاستثنائية إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية أو استقلالها أو سلامة ترابها . ولا يتخذ مثل هذا الإجراء إلا بعد استشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة والمجلس الدستوري، والاستماع إلى المجلس الأعلى للأمن ومجلس الوزراء . تخول الحالة الاستثنائية رئيس الجمهورية أن يتخذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية. ويجتمع البرلمان وجوبا . تنتهي الحالة الاستثنائية، حسب الأشكال والإجراءات السالفة الذكر التي أوجبت إعلانها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_93_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_93_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_93_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_93_para_3>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_93_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_93_20081116_OpEnact_cf68e573c9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_93_obligation_0_5a7e9308> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
