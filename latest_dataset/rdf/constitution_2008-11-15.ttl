    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_179> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى الهيئة التشريعية القائمة عند إصدار هذا الدستور وإلى غاية انتهاء مهمتها وكذا رئيس الجمهورية بعد انتهاء هذه المهمة وإلى غاية انتخاب المجلس الشعبي الوطني ، مهمة التشريع بأوامر بما في ذلك في المسائل التي أصبحت تدخل ضمن القوانين العضوية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_179_20081116_OpEnact_e2cff420e7> ;
