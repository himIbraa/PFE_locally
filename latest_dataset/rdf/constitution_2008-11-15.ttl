<https://legal.dz/resource/law/2008-11-15/08-19#version_art_73> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يحق أن ينتخب لرئاسة الجمهورية إلا المترشح الذي : يتمتع، فقط، بالجنسية الجزائرية الأصلية ، يدين بالإسلام ، يكون عمره أربعين (40) سنة كاملة يوم الانتخاب ، يتمتع بكامل حقوقه المدنية والسياسية ، يثبت الجنسية الجزائرية لزوجه ، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942 ، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942 ، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه ، تحدد شروط أخرى بموجب القانون."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_73_20081116_OpEnact_c30e3b4fd5> ;
    dzdoc:replacementText "لا يحق أن ينتخب لرئاسة الجمهورية إلا المترشح الذي : يتمتع، فقط، بالجنسية الجزائرية الأصلية ، يدين بالإسلام ، يكون عمره أربعين (40) سنة كاملة يوم الانتخاب ، يتمتع بكامل حقوقه المدنية والسياسية ، يثبت الجنسية الجزائرية لزوجه ، يثبت مشاركته في ثورة أول نوفمبر 1954 إذا كان مولودا قبل يوليو 1942 ، يثبت عدم تورط أبويه في أعمال ضد ثورة أول نوفمبر 1954 إذا كان مولودا بعد يوليو 1942 ، يقدم التصريح العلني بممتلكاته العقارية والمنقولة داخل الوطن وخارجه ، تحدد شروط أخرى بموجب القانون."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_73> ;
