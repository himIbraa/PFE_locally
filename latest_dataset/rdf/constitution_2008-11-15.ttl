<https://legal.dz/resource/law/2008-11-15/08-19#version_art_93> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر رئيس الجمهورية الحالة الاستثنائية إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية أو استقلالها أو سلامة ترابها . ولا يتخذ مثل هذا الإجراء إلا بعد استشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة والمجلس الدستوري، والاستماع إلى المجلس الأعلى للأمن ومجلس الوزراء . تخول الحالة الاستثنائية رئيس الجمهورية أن يتخذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية. ويجتمع البرلمان وجوبا . تنتهي الحالة الاستثنائية، حسب الأشكال والإجراء"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_93_20081116_OpEnact_cf68e573c9> ;
    dzdoc:replacementText "يقرر رئيس الجمهورية الحالة الاستثنائية إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية أو استقلالها أو سلامة ترابها . ولا يتخذ مثل هذا الإجراء إلا بعد استشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة والمجلس الدستوري، والاستماع إلى المجلس الأعلى للأمن ومجلس الوزراء . تخول الحالة الاستثنائية رئيس الجمهورية أن يتخذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية. ويجتمع البرلمان وجوبا . تنتهي الحالة الاستثنائية، حسب الأشكال والإجراءات السالفة الذكر التي أوجبت إعلانها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_93> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_93> ;
