<https://legal.dz/resource/law/2008-11-15/08-19#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "الحصانة البرلمانية معترف بها للنواب ولأعضاء مجلس الأمة مدة نيابتهم ومهمتهم البرلمانية. ولا يمكن أن يتابعوا أو يوقفوا. وعلى العموم لا يمكن أن ترفع عليهم أية دعوى مدنية أو جزائية أو يسلط عليهم أي ضغط بسبب ما عبروا عنه من آراء أو ما تلفظوا به من كلام، أو بسبب تصويتهم خلال ممارسة مهامهم البرلمانية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_109_permission_0_82c49e6b> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_109_right_0_0afba358> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_109_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_109_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_109_20081116_OpEnact_762843a3f3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_109_obligation_0_d4d7a62c>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_109_obligation_1_7d950591> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "109" ;
    dzdoc:position 109 ;
    dzdoc:usesTerm dzterm:parliamentary_immunity .

<https://legal.dz/resource/law/2008-11-15/08-19#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "يمكن أعضاء البرلمان استجواب الحكومة في إحدى قضايا الساعة . يمكن لجان البرلمان أن تستمع إلى أعضاء الحكومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_133_permission_0_af7715b5>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_133_permission_1_7e61c141> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_133_right_0_918ab644>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_133_right_1_eb45572c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_133_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_133_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_133_20081116_OpEnact_5cded9e319> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 133" ;
    dzdoc:position 133 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "كل المواطنين متساوون في أداء الضريبة. ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي، أية ضريبة، أو جباية، أو رسم، أو أي حق كيفما كان نوعه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_64_permission_0_25cf019f>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_64_permission_1_0c1ffb95> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_64_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_64_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_64_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_64_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_64_20081116_OpEnact_dee2e10b93> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_64_obligation_0_8a813084> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-11-15/08-19#art_64_prohibition_0_25cf019f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 64 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_64_condition_0_b6769299> ;
    dzdoc:usesTerm dzterm:law .

<https://legal.dz/resource/law/2008-11-15/08-19#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : ” بسم الله الرحمن الرحيم ، وفاء للتضحيات الكبرى، ولأرواح شهدائنا الأبرار، وقيم ثورة نوفمبر الخالدة، أقسم بالله العلي العظيم، أن أحترم الدين الإسلامي وأمجده ، و أدافع عن الدستور ، و أسهر على استمرارية الدولة ، و أعمل على توفير الشروط اللازمة للسير العادي للمؤسسات والنظام الدستوري ، و أسعى من أجل تدعيم المسار الديمقراطي ، و أحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها ، و أحافظ على سلامة التراب الوطني، ووحدة الشعب والأمة ، و أحمي الحريات والحقوق الأساسية للإنسان والمواطن ، و أعمل بدون هوادة من أجل تطور الشعب وازدهاره ، و أسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة والحرية والسلم في العالم . والله على ما أقول شهيد “."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_76_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_76_20081116_OpEnact_e394385c59> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_0_006e3efd>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_1_b37c2d38>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_2_b41ee168>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_3_ddaf1a1e>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_4_a816b711>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_5_ab8ffd8e>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_6_afd75725>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_7_278282fd>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_8_9c07de19>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_76_obligation_9_940cfbc5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "76" ;
    dzdoc:position 76 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_177> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_177" ;
    dzdoc:fullText "يمكن ثلاثة أرباع (3/4) أعضاء غرفتي البرلمان المجتمعتين معا، أن يبادروا باقتراح تعديل الدستور على رئيس الجمهورية الذي يمكنه عرضه على الاستفتاء الشعبي . ويصدره في حالة الموافقة عليه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_177_permission_0_a4dfe66d> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_177_right_0_748f112b>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_177_right_1_0e6cb281> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_177> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_177_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_177_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_177_20081116_OpEnact_6b4d357d60> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 177" ;
    dzdoc:position 176 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "إذا وقع عدوان فعلي على البلاد أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء والاستماع إلى المجلس الأعلى للأمن واستشارة رئيس المجلس الشعبي الوطني ورئيس مجلس الأمة. ويجتمع البرلمان وجوبا . ويوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_95_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_95_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_95_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_95_20081116_OpEnact_da88b6395b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_95_obligation_0_5a7e9308> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "95" ;
    dzdoc:position 95 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_95_condition_0_6e2e0802> ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثالث_السلطة_القضائية> a dzdoc:Section ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
