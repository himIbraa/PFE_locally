<https://legal.dz/resource/law/2008-11-15/08-19#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "لرئيس الجمهورية أن يشرع بأوامر في حالة شغور المجلس الشعبي الوطني أو بين دورتي البرلمان . ويعرض رئيس الجمهورية النصوص التي اتخذها على كل غرفة من البرلمان في أول دورة له لتوافق عليها . تعد لاغية الأوامر التي لا يوافق عليها البرلمان. يمكن رئيس الجمهورية أن يشرع بأوامر في الحالة الاستثنائية المذكورة في المادة 93 من الدستور . تتخذ الأوامر في مجلس الوزراء."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_124_permission_0_b4918fac> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_124_right_0_6de2e5ed>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_124_right_1_a0870499> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_124_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_124_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_124_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_124_para_3>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_124_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_124_20081116_OpEnact_0c7709d588> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_124_obligation_0_098c9c45> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 124" ;
    dzdoc:position 124 ;
    dzdoc:references <https://legal.dz/resource/law/2008-11-15/08-19#art_93> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-11-15/08-19#art_93> ;
