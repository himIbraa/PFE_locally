<https://legal.dz/resource/law/2008-11-15/08-19#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية ، و لا يمكن أن يتجاوز مدة ثمان وأربعين (48) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء، ووفقا للشروط المحددة بالقانون . ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك ، على أن يعلم بهذه الإمكانية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_48_permission_0_998c2a8c>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_48_permission_1_e5548cd4> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_48_right_0_0244f79f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_48_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_48_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_48_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_48_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_48_20081116_OpEnact_424a3f660a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_48_obligation_0_00aea134>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_48_obligation_1_cc8177e5>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_48_obligation_2_89eeafba> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 48 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_48_condition_0_704332c2> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_87_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_87_14" ;
    dzdoc:fullText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين الوزير الأول وأعضاء الحكومة وكذا رؤساء المؤسسات الدستورية وأعضائها الذين لم ينص الدستور على طريقة أخرى لتعيينهم. كما لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء، وحل المجلس الشعبي الوطني، وتقرير إجراء الانتخابات التشريعية قبل أوانها، وتطبيق الأحكام المنصوص عليها في المواد 77 و 78 و 91 و من 93 إلى 95 و 97 و 124 و 126 و 127 و 128 من الدستور."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_87_14_permission_0_02b33385>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_87_14_permission_1_f1a2f31f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_87_14> ;
