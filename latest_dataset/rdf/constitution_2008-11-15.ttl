<https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_extref_cf1de335> a dzdoc:ExternalReference ;
    rdfs:label "القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/2008-11-15/08-19"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/2008-11-15/08-19"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/2008-11-15/08-19" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:resolutionReason "canonical_akn_path_alias" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/2008-11-15/08-19"^^xsd:anyURI .

<https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن رئيس الجمهورية أن يقرر حل المجلس الشعبي الوطني، أو إجراء انتخابات تشريعية قبل أوانها، بعد استشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، و الوزير الأول."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22> ;
    dzdoc:position 1 ;
    dzdoc:text "وتجري هذه الانتخابات في كلتا الحالتين في أجل أقصاه ثلاثة (03) أشهر."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_129_22_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_129_22> ;
    dzdoc:position 2 ;
    dzdoc:text "(22) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( استبدال وظيفة ” رئيس الحكومة ” بوظيفة ” الوزير الأول “)"@ar .

