    dzdoc:eId "art_92" ;
    dzdoc:fullText "يحدد تنظيم حالة الطوارئ وحالة الحصار بموجب قانون عضوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_92> ;
