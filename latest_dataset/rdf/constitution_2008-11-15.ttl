    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "تعلل الأحكام القضائية، وينطق بها في جلسات علانية ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_145_20081116_OpEnact_4c2356221e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
