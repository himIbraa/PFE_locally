    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_89> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_89_obligation_2_344f85b0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_89> ;
