<https://legal.dz/resource/law/2008-11-15/08-19#version_art_170> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس مجلس محاسبة يكلف بالرقابة البعدية لأموال الدولة والجماعات الإقليمية والمرافق العمومية . يعد مجلس المحاسبة تقريرا سنويا يرفعه إلى رئيس الجمهورية . يحدد القانون صلاحيات مجلس المحاسبة ويضبط تنظيمه وعمله وجزاء تحقيقاته."@ar ;
    dzdoc:isAuthoritative true ;
