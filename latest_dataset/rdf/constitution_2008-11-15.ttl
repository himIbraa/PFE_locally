    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 16" ;
    dzdoc:position 16 ;
    dzdoc:usesTerm dzterm:elected_council .

<https://legal.dz/resource/law/2008-11-15/08-19#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "يؤسس لدى رئيس الجمهورية مجلس إسلامي أعلى ، يتولى على الخصوص ما يأتي : الحث على الاجتهاد وترقيته، إبداء الحكم الشرعي فيما يعرض عليه، رفع تقرير دوري عن نشاطه إلى رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_171_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_171_20081116_OpEnact_f845d3efad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 170 ;
    dzdoc:usesTerm dzterm:high_islamic_council,
        dzterm:president .

<https://legal.dz/resource/law/2008-11-15/08-19#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "يتكون المجلس الإسلامي الأعلى من خمسة عشر (15) عضوا منهم الرئيس، يعينهم رئيس الجمهورية من بين الكفاءات الوطنية العليا في مختلف العلوم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_172> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_172_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_172_20081116_OpEnact_28cd033839> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 172" ;
    dzdoc:position 171 ;
    dzdoc:usesTerm dzterm:high_islamic_council,
        dzterm:president .

