<https://legal.dz/resource/law/2008-11-15/08-19#version_art_32> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحريات الأساسية وحقوق الإنسان والمواطن مضمونة . وتكون تراثا مشتركا بين جميع الجزائريين والجزائريات، واجبهم أن ينقلوه من جيل إلى جيل كي يحافظوا على سلامته، وعدم انتهاك حرمته ."@ar ;
    dzdoc:isAuthoritative true ;
