<https://legal.dz/resource/law/2008-11-15/08-19#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "تحدد كيفيات انتخاب النواب وكيفيات انتخاب أعضاء مجلس الأمة أو تعيينهم، وشروط قابليتهم للانتخاب، ونظام عدم قابليتهم للانتخاب، وحالات التنافي، بموجب قانون عضوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_103_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_103_20081116_OpEnact_2f61d9ecd4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 103 ;
    dzdoc:usesTerm dzterm:council_of_nation .

<https://legal.dz/resource/law/2008-11-15/08-19#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "إثبات عضوية النواب وأعضاء مجلس الأمة من اختصاص كل من الغرفتين على حدة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_104_20081116_OpEnact_31ac2f343c> ;
