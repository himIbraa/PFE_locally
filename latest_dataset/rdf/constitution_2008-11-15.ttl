    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_4> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "عاصمة الجمهورية مدينة الجزائر ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_50_20081116_OpEnact_93375da184> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_50> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_50> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_50> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لكل مواطن تتوفر فيه الشروط القانونية أن ينتخب وينتخب ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_51_20081116_OpEnact_4b2efd26b5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_51> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_51> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_51> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يتساوى جميع المواطنين في تقلد المهام والوظائف في الدولة دون أية شروط أخرى غير الشروط التي يحددها القانون."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_52_20081116_OpEnact_ddf08f81e7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_52> ;
