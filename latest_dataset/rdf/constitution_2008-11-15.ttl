    dzdoc:usesTerm dzterm:council_of_nation .

<https://legal.dz/resource/law/2008-11-15/08-19#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يحدد قانون عضوي الحالات التي يقبل فيها البرلمان استقالة أحد أعضائه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_108_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_108_20081116_OpEnact_343d08e456> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 108" ;
    dzdoc:position 108 ;
    dzdoc:usesTerm dzterm:parliament .

<https://legal.dz/resource/law/2008-11-15/08-19#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يحدد قانون عضوي شروط استخلاف النائب أو عضو مجلس الأمة في حالة شغور مقعده."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_112_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_112_20081116_OpEnact_76a894b6b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "112" ;
    dzdoc:position 112 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
