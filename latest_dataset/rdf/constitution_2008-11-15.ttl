    dzdoc:eId "art_142" ;
    dzdoc:fullText "تخضع العقوبات الجزائية إلى مبدئي الشرعية والشخصية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_142_para_0> ;
