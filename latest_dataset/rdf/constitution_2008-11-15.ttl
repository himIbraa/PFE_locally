    dzdoc:versionOf <https://legal.dz/resource/law/2008-11-15/08-19#art_72> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_72> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يمارس رئيس الجمهورية ، السلطة السامية في الحدود المثبتة في الدستور ."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_73_20081116_OpEnact_c30e3b4fd5> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
