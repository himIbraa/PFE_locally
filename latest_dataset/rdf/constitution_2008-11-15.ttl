    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "لا يجوز البتة التنازل أو التخلي عن أي جزء من التراب الوطني."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_140_20081116_OpEnact_dcf9825285> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2008-11-16"^^xsd:date ;
