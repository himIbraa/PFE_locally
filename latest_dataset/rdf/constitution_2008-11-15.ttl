<https://legal.dz/resource/law/2008-11-15/08-19#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "عدم تحيز الإدارة يضمنه القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_23_para_0> ;
