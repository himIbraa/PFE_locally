<https://legal.dz/resource/law/2008-11-15/08-19#art_112_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#art_112> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد قانون عضوي شروط استخلاف النائب أو عضو مجلس الأمة في حالة شغور مقعده."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#art_113_obligation_0_16f4958a> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
