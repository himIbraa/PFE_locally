    dzdoc:usesTerm dzterm:apn,
        dzterm:government,
        dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2008-11-15/08-19#art_175> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الرابع__التعديل_الدستوري> ;
    dzdoc:eId "art_175" ;
    dzdoc:fullText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب . ولا يمكن عرضه من جديد على الشعب خلال الفترة التشريعية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_175_permission_0_012ce352> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_175> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_175_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_175_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_175_20081116_OpEnact_4e4901adba> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 175" ;
    dzdoc:position 174 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_175_condition_0_eaa50af3> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "الملكية الخاصة مضمونة . حق الإرث مضمون . الأملاك الوقفية وأملاك الجمعيات الخيرية معترف بها ، و يحمي القانون تخصيصها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_52_right_0_6421b836>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_52_right_1_51711fef>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_52_right_2_e1ee3680> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_52_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_52_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_52_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_52_20081116_OpEnact_ddf08f81e7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_52_obligation_0_ed613d56> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 52 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "لكل المواطنين الحق في العمل . يضمن القانون في أثناء العمل الحق في الحماية، والأمن، والنظافة . الحق في الراحة مضمون ، ويحدد القانون كيفيات ممارسته."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2008-11-15/08-19#art_55_right_0_8388195d>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_55_right_1_5c4ba0b8>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_55_right_2_36fc38c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_55_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_55_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_55_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_55_20081116_OpEnact_c49a90cc4f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_55_obligation_0_f5ab5423> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 55" ;
    dzdoc:position 55 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_80_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_80_8" ;
    dzdoc:fullText "يقدم الوزير الأول مخطط عمله إلى المجلس الشعبي الوطني للموافقة عليه. ويجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة. ويمكن للوزير الأول أن يكيف مخطط العمل هذا، على ضوء هذه المناقشة، بالتشاور مع رئيس الجمهورية . يقدم الوزير الأول عرضا حول مخطط عمله لمجلس الأمة مثلما وافق عليه المجلس الشعبي الوطني. يمكن لمجلس الأمة أن يصدر لائحة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_80_8_permission_0_bf248773> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_80_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_80_8_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_80_8_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_80_8_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_80_8_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_80_8_20081116_OpEnact_6e172acb6e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_80_8_obligation_0_e6666514> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 80 (8)" ;
    dzdoc:position 80 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2008-11-15/08-19#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_2> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية، والجهوية، والمحسوبية، إقامة علاقات الاستغلال والتبعية، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_9_permission_0_545c1ac3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_9_20081116_OpEnact_18c9f01b55> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_9_obligation_0_362e3c68> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2008-11-15/08-19#art_9_prohibition_0_545c1ac3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 9 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_91_16> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الأول_السلطة_التنفيذية> ;
    dzdoc:eId "art_91_16" ;
    dzdoc:fullText "يقرر رئيس الجمهورية ، إذا دعت الضرورة الملحة ، حالة الطوارئ أو الحصار، لمدة معينة بعد اجتماع المجلس الأعلى للأمن، واستشارة رئيس المجلس الشعبي الوطني، ورئيس مجلس الأمة، و الوزير الأول ، ورئيس المجلس الدستوري، ويتخذ كل التدابير اللازمة لاستتباب الوضع. ولا يمكن تمديد حالة الطوارئ أو الحصار، إلا بعد موافقة البرلمان، المنعقد بغرفتيه المجتمعتين معا ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_91_16_permission_0_90080bb2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_91_16> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_91_16_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_91_16_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_91_16_20081116_OpEnact_a8eeab453d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "91 (16)" ;
    dzdoc:position 91 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_91_16_condition_0_ef2cac40>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_91_16_condition_1_5b518f3e> ;
    dzdoc:usesTerm dzterm:president,
        dzterm:prime_minister .

<https://legal.dz/resource/law/2008-11-15/08-19#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثاني_تنظيم_السلطات_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "في حالة تلبس أحد النواب أو أحد أعضاء مجلس الأمة بجنحة أو جناية ، يمكن توقيفه. ويخطر بذلك مكتب المجلس الشعبي الوطني، أو مكتب مجلس الأمة، حسب الحالة، فورا. يمكن المكتب المخطر أن يطلب إيقاف المتابعة وإطلاق سراح النائب أو عضو مجلس الأمة، على أن يعمل فيما بعد بأحكام المادة 110 أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2008-11-15/08-19#art_111_permission_0_f624be32>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_111_permission_1_7f72861f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_111_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_111_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_111_20081116_OpEnact_ec80ea520b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "111" ;
    dzdoc:position 111 ;
    dzdoc:references <https://legal.dz/resource/law/2008-11-15/08-19#art_110> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2008-11-15/08-19#art_110> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2008-11-15/08-19#art_111_condition_0_69fbc225> .

<https://legal.dz/resource/law/2008-11-15/08-19#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الثالث__الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "يتكون المجلس الدستوري من تسعة (9) أعضاء : ثلاثة (3) أعضاء من بينهم رئيس المجلس يعينهم رئيس الجمهورية ، واثنان (2) ينتخبهما المجلس الشعبي الوطني ، واثنان (2) ينتخبهما مجلس الأمة ، وعضو واحد (1) تنتخبه المحكمة العليا ، وعضو واحد (1) ينتخبه مجلس الدولة . بمجرد انتخاب أعضاء المجلس الدستوري أو تعيينهم، يتوقفون عن ممارسة أي عضوية أو أي وظيفة أو تكليف أو مهمة أخرى . يعين رئيس الجمهورية رئيس المجلس الدستوري لفترة واحدة مدتها ست (6) سنوات. يضطلع أعضاء المجلس الدستوري بمهامهم مرة واحدة مدتها ست (6) سنوات، ويجدد نصف عدد أعضاء المجلس الدستوري كل ثلاث (3) سنوات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_164_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_164_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_164_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_164_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_164_20081116_OpEnact_9d6a90695e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_164_obligation_0_73f76862> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 163 ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:council_of_nation,
        dzterm:national_peoples_assembly,
        dzterm:president,
        dzterm:state_council,
        dzterm:supreme_court .

<https://legal.dz/resource/law/2008-11-15/08-19#art_62_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2008-11-15/08-19#chp_الأول__المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_62_4" ;
    dzdoc:fullText "على كل مواطن أن يؤدي بإخلاص واجباته تجاه المجموعة الوطنية . التزام المواطن إزاء الوطن وإجبارية المشاركة في الدفاع عنه، واجبان مقدسان دائمان . تضمن الدولة احترام رموز الثورة، وأرواح الشهداء، وكرامة ذويهم، والمجاهدين . و تعمل كذلك على ترقية كتابة التاريخ، وتعليمه للأجيال الناشئة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2008-11-15/08-19#version_art_62_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4_para_0>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4_para_1>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4_para_2>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_62_4_20081116_OpEnact_bf8087e58d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4_obligation_0_e80ec231>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4_obligation_1_bbf58b55>,
        <https://legal.dz/resource/law/2008-11-15/08-19#art_62_4_obligation_2_1d2b8d3d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 62 (4)" ;
    dzdoc:position 62 .

