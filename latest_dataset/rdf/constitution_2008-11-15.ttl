<https://legal.dz/resource/law/2008-11-15/08-19#version_art_158_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تؤسس محكمة عليا للدولة ، تختص بمحاكمة رئيس الجمهورية عن الأفعال التي يمكن وصفها بالخيانة العظمى، و الوزير الأول عن الجنايات والجنح، التي يرتكبانها بمناسبة تأديتهما مهامهما . يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذا الإجراءات المطبقة . (24) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( استبدال وظيفة ” رئيس الحكومة ” بوظيفة ” الوزير الأول “)"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2008-11-15/08-19#version_art_158_24_20081116_OpEnact_b0bc5677e9> ;
    dzdoc:replacementText "تؤسس محكمة عليا للدولة ، تختص بمحاكمة رئيس الجمهورية عن الأفعال التي يمكن وصفها بالخيانة العظمى، و الوزير الأول عن الجنايات والجنح، التي يرتكبانها بمناسبة تأديتهما مهامهما . يحدد قانون عضوي تشكيلة المحكمة العليا للدولة وتنظيمها وسيرها وكذا الإجراءات المطبقة . (24) القانون رقم 08-19 المؤرخ في 17 ذو القعدة عام 1429 الموافق 15 نوفمبر سنة 2008 المتضمن التعديل الدستوري. ( استبدال وظيفة ” رئيس الحكومة ” بوظيفة ” الوزير الأول “)"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2008-11-15/08-19#art_158_24> ;
