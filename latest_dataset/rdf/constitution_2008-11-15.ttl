    dzdoc:introducedOn "2008-11-16"^^xsd:date ;
    dzdoc:number "المادة 37" ;
    dzdoc:position 37 .

<https://legal.dz/resource/law/2008-11-15/08-19#art_41> a dzdoc:Article ;
