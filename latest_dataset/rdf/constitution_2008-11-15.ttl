    dznorm:position 0 ;
    dznorm:provisionText "يجتمع المجلس الدستوري وجوبا، وبعد أن يتثبت من حقيقة هذا المانع بكل الوسائل الملائمة، يقترح بالإجماع على البرلمان التصريح بثبوت المانع."@ar ;
    dznorm:sourceArticle "art_88" .

<https://legal.dz/resource/law/2008-11-15/08-19#art_88_obligation_0_3c4e2f25_role_45d0170b0f> a dznorm:Role ;
