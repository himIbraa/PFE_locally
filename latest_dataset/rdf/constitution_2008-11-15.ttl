    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2008-11-15/08-19> ;
    dzdoc:versionText "يصدر القضاء أحكامه باسم الشعب."@ar .

<https://legal.dz/resource/law/2008-11-15/08-19#version_art_142_20081116_OpEnact_9e8a5e7bba> a dzdoc:ArticleVersion ;
