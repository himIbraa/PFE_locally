<https://legal.dz/resource/constitution/1989-02-23/1989#art_61> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_61" ;
    dzdoc:fullText "كل المواطنين متساوون في أداء الضريبة . ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي ، أية ضريبة ، أو جباية ، أو رسم ، أو أي حق كيفما كان نوعه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_permission_0_f95c3368>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_permission_1_0f417854> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_61> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_61_19890223_OpEnact_764619c4ae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_obligation_0_8a813084> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_prohibition_0_f95c3368> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 61" ;
    dzdoc:position 60 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_61_condition_0_b6769299> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_85> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_85" ;
    dzdoc:fullText "لا يمكن أن تقال أو تعدل الحكومة القائمة إبان حصول المانع لـ رئيس الجمهورية ، أو وفاته ، أو استقالته ، حتى يشرع رئيس الجمهورية الجديد في ممارسة مهامه . يستقيل وجوبا رئيس الحكومة القائمة قانونا ، إذا ترشح لرئاسة الجمهورية ، ويمارس وظيفة رئيس الحكومة حينئذ أحد أعضائها الذي يعينه رئيس الدولة . لا يمكن في فترتي الخمسة والأربعين يوما، تطبيق الأحكام المنصوص عيها في الفقرتين 8 ، و 9 من المادة 74 ، والمواد 75 ، 90 ، 120 ، 127 ، و 128 من الدستور . لا يمكن ، خلال الفترتين السابق ذكرهما ، تطبيق أحكام المواد 87 ، و 88 ، و 89 ، و 91 من الدستور، إلا بموافقة المجلس الشعبي الوطني ، بعد استشارة المجلس الدستوري ، و المجلس الأعلى للأمن ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_permission_0_e6c67641>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_permission_1_cb232799>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_permission_2_82e01e9b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_85> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_3> ;
