    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_71_right_0_cfb03b89> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_71_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_71_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_71_19890223_OpEnact_c51a3f40fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 70 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "في حالة عدم موافقة المجلس الشعبي الوطني على البرنامج المعروض عليه ، يقدم رئيس الحكومة استقالة حكومته ل رئيس الجمهورية . يعين رئيس الجمهورية من جديد رئيس حكومة حسب الكيفيات نفسها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_77> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_77_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_77_19890223_OpEnact_6e61c3e8d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_77_obligation_0_a449e648>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_77_obligation_1_11186356> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "77" ;
    dzdoc:position 76 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_77_condition_0_063a7ad2> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_78> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_78" ;
    dzdoc:fullText "إذا لم تحصل من جديد موافقة المجلس الشعبي الوطني ينحل وجوبا . وتجري انتخابات تشريعية جديدة في أجل أقصاه ثلاثة أشهر ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_78> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_78_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_78_para_1> ;
