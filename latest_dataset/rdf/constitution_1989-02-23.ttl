<https://legal.dz/resource/constitution/1989-02-23/1989#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الأول_الجزائر> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "اللغة العربية هي اللغة الوطنية والرسمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_3_para_0> ;
