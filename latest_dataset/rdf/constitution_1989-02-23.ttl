<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم ، و المقالع ، والموارد الطبيعية للطاقة ، والثروات المعدنية، الطبيعية ، والحية ، في مختلف مناطق الأملاك الوطنية البحرية ، والمياه، والغابات . كما تشمل النقل بالسكك الحديدية ، والنقل البحري والجوي ، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_17_19890223_OpEnact_16bcf986c8> ;
    dzdoc:replacementText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم ، و المقالع ، والموارد الطبيعية للطاقة ، والثروات المعدنية، الطبيعية ، والحية ، في مختلف مناطق الأملاك الوطنية البحرية ، والمياه، والغابات . كما تشمل النقل بالسكك الحديدية ، والنقل البحري والجوي ، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_17> ;
