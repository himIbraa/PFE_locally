dzorg:الجريدة_الرسمية a dzdoc:Organization ;
    rdfs:label "الجريدة الرسمية"@ar ;
    dzdoc:frbrUri "/ontology/organization/dz/joradp"^^xsd:anyURI .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_100_condition_0_3103b9ee> a dznorm:Condition ;
    dznorm:conditionText "كل نائب لا يستوفي شروط قابلية انتخابه أو يفقدها"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_100> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "كل نائب لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لإسقاط صفته النيابية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_100_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_100> ;
    dzdoc:position 1 ;
    dzdoc:text "ويقرر المجلس الشعبي الوطني هذا الإسقاط بأغلبية أعضائه ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_101_condition_0_e1901fc7> a dznorm:Condition ;
    dznorm:conditionText "إذا اقترف فعلا يخل بشرف وظيفته"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_101> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_101_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_101> ;
    dzdoc:position 0 ;
    dzdoc:text "النائب مسؤول أمام زملائه الذين يمكنهم تجريده من صفته النيابية، إذا اقترف فعلا يخل بشرف وظيفته ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_101_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_101> ;
    dzdoc:position 1 ;
    dzdoc:text "يحدد القانون الحالات التي يتعرض فيها النائب للإقصاء ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_101_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_101> ;
    dzdoc:position 2 ;
    dzdoc:text "ويقرر المجلس الشعبي الوطني هذا الإقصاء بأغلبية أعضائه، دون المساس بحق المتابعات الأخرى الواردة في القانون ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_102_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_102> ;
    dzdoc:position 0 ;
    dzdoc:text "يحدد القانون الحالات التي يقبل فيها المجلس الشعبي الوطني استقالة أحد أعضائه ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_103_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_103> ;
    dzdoc:position 0 ;
    dzdoc:text "الحصانة النيابية معترف بها للنائب مدة نيابته ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_103_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_103> ;
    dzdoc:position 1 ;
    dzdoc:text "لا يمكن أن يتابع أي نائب أو يوقف ، وعلى العموم ، لا يمكن أن ترفع عليه دعوى مدنية أو جزائية ، أو يسلط عليه أي شكل من أشكال الضغط ، بسبب ما عبر عنه من آراء ، أو ما تلفظ به من كلام ، أو بسبب تصويته خلال ممارسة مهمته النيابية ."@ar .

