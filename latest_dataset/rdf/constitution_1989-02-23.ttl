    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_133> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "تخضع العقوبات الجزائية إلى مبدأي الشرعية والشخصية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_134_19890223_OpEnact_6c74c55bd7> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
