<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_112> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجتمع المجلس الشعبي الوطني في دورتين كل سنة . ومدة كل دورة ثلاثة أشهر على الأكثر . يمكن أن يجتمع المجلس الشعبي الوطني في دورة غير عادية بمبادرة من رئيس الجمهورية ، أو بطلب من ثلثي أعضاء المجلس ، أو بطلب من رئيس الحكومة . تختتم الدورة غير العادية بمجرد ما يستنفذ المجلس الشعبي الوطني جدول الأعمال الذي استدعي للاجتماع من أجله ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_112_19890223_OpEnact_88005ecad9> ;
    dzdoc:replacementText "يجتمع المجلس الشعبي الوطني في دورتين كل سنة . ومدة كل دورة ثلاثة أشهر على الأكثر . يمكن أن يجتمع المجلس الشعبي الوطني في دورة غير عادية بمبادرة من رئيس الجمهورية ، أو بطلب من ثلثي أعضاء المجلس ، أو بطلب من رئيس الحكومة . تختتم الدورة غير العادية بمجرد ما يستنفذ المجلس الشعبي الوطني جدول الأعمال الذي استدعي للاجتماع من أجله ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_112> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
