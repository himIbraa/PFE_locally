    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_140> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "القاضي مسؤول أمام المجلس الأعلى للقضاء عن كيفية قيامه بمهمته ، حسب الأشكال المنصوص عليها في القانون ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_141_19890223_OpEnact_9e69a1aa32> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
