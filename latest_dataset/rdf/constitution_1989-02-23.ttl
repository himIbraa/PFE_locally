<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "chp_الرابع_التعديل_الدستوري_art_166" ;
    dzdoc:fullText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب و لا يمكن عرضه من جديد على الشعب من خلال نفس الفترة التشريعية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166_permission_0_ef6c118a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_الرابع_التعديل_الدستوري_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_______art_166_19890223_OpEnact_bdfb1ce3ea> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 166" ;
    dzdoc:position 168 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166_condition_0_8870ca08> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "جلسات المجلس الشعبي الوطني علانية . وتدون مداولاته في محاضر تنشر طبقا لما يحدده القانون . يجوز للمجلس الشعبي الوطني أن يعقد جلسات مغلقة بطلب من رئيسه ، أو من أغلبية أعضائه الحاضرين ، أو بطلب من الحكومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_110_permission_0_ebe8f97b> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_110_right_0_032b39d8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_110_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_110_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_110_19890223_OpEnact_f438be5d71> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 110" ;
    dzdoc:position 109 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_110_condition_0_5453d5ca> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_113> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_113" ;
    dzdoc:fullText "لكل من رئيس الحكومة وأعضاء المجلس الشعبي الوطني حق المبادرة بالقوانين . تكون اقتراحات القوانين قابلة للمناقشة ، إذا قدمها عشرون نائبا . تعرض مشاريع القوانين على مجلس الوزراء ، ثم يودعها رئيس الحكومة مكتب المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_113_right_0_0345f4be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_113> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_113_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_113_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_113_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_113_19890223_OpEnact_9a93674cac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_113_obligation_0_75db4818> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 113" ;
    dzdoc:position 112 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_113_condition_0_16958dcc> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يقرر حل المجلس الشعبي الوطني أو إجراء انتخابات تشريعية قبل أوانها ، بعد استشارة رئيس المجلس الشعبي الوطني ورئيس الحكومة . وتجري هذه الانتخابات في أجل أقصاه ثلاثة أشهر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_120_permission_0_a4a36d0f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_120_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_120_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_120_19890223_OpEnact_00c31e0023> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 120" ;
    dzdoc:position 119 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_120_condition_0_fb7ce70b> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_13> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_13" ;
    dzdoc:fullText "لا يجوز البتة التنازل أو التخلي عن أي جزء من التراب الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_13_permission_0_11f69827> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_13> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_13_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_13_19890223_OpEnact_7c403d4c28> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_13_obligation_0_b18088ca> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1989-02-23/1989#art_13_prohibition_0_11f69827> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 13" ;
    dzdoc:position 12 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_59> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_59" ;
    dzdoc:fullText "على كل مواطن أن يؤدي بإخلاص واجباته تجاه المجموعة الوطنية . التزام المواطن إزاء الوطن وإجبارية المشاركة في الدفاع عنه ، واجبان مقدسان دائمان . تضمن الدولة احترام رموز الثورة، و أرواح الشهداء، و كرامة ذويهم، والمجاهدين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_59> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_59_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_59_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_59_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_59_19890223_OpEnact_b8b220a38d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_59_obligation_0_e80ec231>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_59_obligation_1_0856ae51>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_59_obligation_2_5fbb9312> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 59" ;
    dzdoc:position 58 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_80> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_80" ;
    dzdoc:fullText "تقدم الحكومة سنويا ل المجلس الشعبي الوطني بيانا عن السياسة العامة . تعقب بيان السياسة العامة مناقشة لعمل الحكومة . يمكن المجلس الشعبي الوطني أن يختتم هذه المناقشة بلائحة أو بإيداع ملتمس رقابة، طبقا لأحكام المواد 126 و 127 و 128 ، أدناه . ل رئيس الحكومة أن يطلب تصويتا بالثقة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_80_permission_0_a4cf4cae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_80> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_80_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_80_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_80_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_80_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_80_19890223_OpEnact_4163cb9fb7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_80_obligation_0_7fbe5f18> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "80" ;
    dzdoc:position 79 ;
    dzdoc:references <https://legal.dz/resource/constitution/1989-02-23/1989#art_126>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_127>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_128> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/1989-02-23/1989#art_126>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_127>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_128> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:head_of_government .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "لا يجوز للمؤسسات أن تقوم بما يأتي : الممارسات الإقطاعية ، و الجهوية ، و المحسوبية ، إقامة علاقات الاستغلال والتبعية ، السلوك المخالف للخلق الإسلامي وقيم ثورة نوفمبر ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_9_permission_0_2ac87c64> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_9_19890223_OpEnact_cd562ddafe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_9_obligation_0_362e3c68> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1989-02-23/1989#art_9_prohibition_0_2ac87c64> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "9" ;
    dzdoc:position 8 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "ينتخب المجلس الشعبي الوطني لمدة خمس سنوات . ولا يمكن تمديد الفترة النيابية إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت المجلس الشعبي الوطني هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية، واستشارة المجلس الدستوري ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_96_permission_0_8b758b44> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_96_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_96_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_96_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_96_19890223_OpEnact_619f23d730> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 96" ;
    dzdoc:position 95 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_96_condition_0_55df21ba> ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_104> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_104" ;
    dzdoc:fullText "لا يجوز الشروع في متابعة أي نائب بسبب فعل إجرامي إلا بتنازل صريح منه أو بإذن من المجلس الشعبي الوطني الذي يقرر رفع الحصانة عن النائب بأغلبية أعضائه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_104_permission_0_b1d269be> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_104> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_104_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_104_19890223_OpEnact_680c11a069> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1989-02-23/1989#art_104_prohibition_0_b1d269be> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 104" ;
    dzdoc:position 103 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_104_condition_0_5c397f13> ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_105> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_105" ;
    dzdoc:fullText "في حالة تلبس أحد النواب بجنحة أو جناية ، يمكن توقيفه ، ويخطر مكتب المجلس الشعبي الوطني فورا . يمكن مكتب المجلس الشعبي الوطني أن يطلب إيقاف المتابعة وإطلاق سراح النائب ، على أن يعمل فيما بعد بأحكام المادة 104 أعلاه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_105_permission_0_d747694c>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_105_permission_1_6197dac2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_105> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_105_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_105_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_105_19890223_OpEnact_c4d1ca8c0d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 105" ;
    dzdoc:position 104 ;
    dzdoc:references <https://legal.dz/resource/constitution/1989-02-23/1989#art_104> ;
    dzdoc:referencesInternal <https://legal.dz/resource/constitution/1989-02-23/1989#art_104> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_105_condition_0_db9a185e> ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "يجتمع المجلس الشعبي الوطني في دورتين كل سنة . ومدة كل دورة ثلاثة أشهر على الأكثر . يمكن أن يجتمع المجلس الشعبي الوطني في دورة غير عادية بمبادرة من رئيس الجمهورية ، أو بطلب من ثلثي أعضاء المجلس ، أو بطلب من رئيس الحكومة . تختتم الدورة غير العادية بمجرد ما يستنفذ المجلس الشعبي الوطني جدول الأعمال الذي استدعي للاجتماع من أجله ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_112_permission_0_ab7a09eb> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_112_right_0_57b6e231> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_112_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_112_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_112_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_112_19890223_OpEnact_88005ecad9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_112_obligation_0_b3906ef7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 112" ;
    dzdoc:position 111 ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_117> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_117" ;
    dzdoc:fullText "يصدر رئيس الجمهورية القانون في أجل ثلاثين يوما ، ابتداء من تاريخ تسلمه إياه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_117> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_117_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_117_19890223_OpEnact_a857a16fc4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_117_obligation_0_be5c6212> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 117" ;
    dzdoc:position 116 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_128> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_128" ;
    dzdoc:fullText "إذا صادق المجلس الشعبي الوطني على ملتمس الرقابة ، يقدم رئيس الحكومة استقالة حكومته إلى رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_128> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_128_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_128_19890223_OpEnact_03208b5ef4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_128_obligation_0_5fae6b59> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 128" ;
    dzdoc:position 127 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_128_condition_0_3bc3553a> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يتكون المجلس الدستوري من سبعة أعضاء : اثنان منهم ، يعينهما رئيس الجمهورية ، واثنان ينتخبهما المجلس الشعبي الوطني ، واثنان تنتخبهما المحكمة العليا من بين أعضائها . وبمجرد انتخابهم أو تعيينهم ، يتوقفون عن ممارسة أي عضوية أو أي وظيفة أو تكليف أو مهمة أخرى . يضطلع أعضاء المجلس الدستوري بمهامهم مرة واحدة غير قابلة للتجديد مدتها ست سنوات . ويجدد نصف عدد أعضاء المجلس الدستوري كل ثلاث سنوات . يعين رئيس الجمهورية رئيس المجلس الدستوري لفترة واحدة مدتها ست سنوات غير قابلة للتجديد."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_154_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_154_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_154_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_154_para_3>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_154_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_154_19890223_OpEnact_694be55da6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_154_obligation_0_6c45ffd0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 154" ;
    dzdoc:position 153 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_154_condition_0_f99f2640> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "حرية الابتكار الفكري والفني والعلمي مضمونة للمواطن . حقوق المؤلف يحميها القانون . لا يجوز حجز أي مطبوع أو تسجيل أو أية وسيلة أخرى من وسائل التبليغ والإعلام إلا بمقتضى أمر قضائي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_36_permission_0_35c1ff29> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_36_right_0_aa355506>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_36_right_1_b4af3016> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_36_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_36_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_36_19890223_OpEnact_0703b14c68> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1989-02-23/1989#art_36_prohibition_0_35c1ff29> ;
