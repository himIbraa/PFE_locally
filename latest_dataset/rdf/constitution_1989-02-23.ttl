    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_167> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_167> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يصدر رئيس الجمهورية نص التعديل الدستوري الذي أقره الشعب ."@ar .

