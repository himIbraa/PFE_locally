dzterm:constitutional_council a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المجلس الدستوري"@ar,
        "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1989-02-23/1989#art_153_defocc_cd780e05c7b1> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_118> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_118" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يطلب من المجلس الشعبي الوطني إجراء مداولة ثانية في قانون تم التصويت عليه ، ويكون هذا الطلب خلال الثلاثين يوما الموالية لتاريخ إقراره . وفي هذه الحالة لا يتم إقرار القانون إلا بأغلبية ثلثي أعضاء المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_118_permission_0_5f29539b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_118> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_118_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_118_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_118_19890223_OpEnact_5c029926b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 118" ;
    dzdoc:position 117 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_118_condition_0_ba683fb0> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_125> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_125" ;
    dzdoc:fullText "يمكن أعضاء المجلس الشعبي الوطني أن يوجهوا أي سؤال شفوي أو كتابي إلى أي عضو في الحكومة . ويكون الجواب عن السؤال الكتابي كتابيا ، خلال أجل أقصاه ثلاثون يوما وتتم الإجابة عن الأسئلة الشفوية في جلسات المجلس . إذا رأى المجلس الشعبي الوطني أن جواب عضو الحكومة شفويا كان أو كتابيا يبرر إجراء مناقشة ، تجري المناقشة حسب الشروط التي ينص عليها النظام الداخلي للمجلس الشعبي الوطني . تنشر الأسئلة والأجوبة طبقا للشروط التي يخضع لها نشر محاضر مناقشات المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_permission_0_a7e58f60> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_right_0_a0dc50ac> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_125> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_125_19890223_OpEnact_4887a524e9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_obligation_0_89245221> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 125" ;
    dzdoc:position 124 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_125_condition_0_8225d73b> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "يمكن المجلس الشعبي الوطني لدى مناقشة بيان السياسة العامة، أن يصوت على ملتمس رقابة ينصب على مسؤولية الحكومة . ولا يقبل هذا الملتمس إلا إذا وقعه سبع (7/1) النواب على الأقل ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_126_permission_0_f764aa66> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_126_right_0_fe567f59> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_126_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_126_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_126_19890223_OpEnact_cfccf33be1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 126" ;
    dzdoc:position 125 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_126_condition_0_72c7cd47> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_74> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_74" ;
    dzdoc:fullText "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، بالسلطات والصلاحيات الآتية : 1)- هو القائد الأعلى لجميع القوات المسلحة للجمهورية ، 2)- يتولى مسؤولية الدفاع الوطني ، 3)- يقرر السياسة الخارجية للأمة ويوجهها ، 4)- يرأس مجلس الوزراء ، 5)- يعين رئيس الحكومة وينهي مهامه ، 6)- يوقع المراسيم الرئاسية ، 7)- يعين في الوظائف المدنية والعسكرية للدولة ، 8)- له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها ، 9)- يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء ، 10)- يعين سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب ، وأوراق إنهاء مهامهم، 11)- يبرم المعاهدات الدولية ويصادق عليها ، 12)- يسلم أوسمة الدولة ، و نياشينها، وشهاداتها التشريفية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_74> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_74_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_74_19890223_OpEnact_df95ba557c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 74" ;
    dzdoc:position 73 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "يقرر رئيس الجمهورية ، الحالة الاستثنائية ، إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية ، أو استقلالها ، أو سلامة ترابها و لا يتخذ مثل هذا الإجراء إلا بعد استشارة المجلس الدستوري ، و الاستماع إلى المجلس الأعلى للأمن ، و مجلس الوزراء . تخول الحالة الاستثنائية رئيس الجمهورية أن يتخذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية . يجتمع المجلس الشعبي الوطني وجوبا . تنتهي الحالة الاستثنائية ، حسب الأشكال والإجراءات السالفة الذكر التي أوجبت إعلانها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_para_3>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_87_19890223_OpEnact_0438aabc8e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_obligation_0_aaebcd6c>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_obligation_1_03fff59e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "87" ;
    dzdoc:position 86 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_condition_0_1398a1be>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_87_condition_1_3c3c62f8> ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:council_of_ministers,
        dzterm:exceptional_state,
        dzterm:high_security_council,
        dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "يوقع رئيس الجمهورية اتفاقيات الهدنة ومعاهدات السلم . ويتلقى رأي المجلس الدستوري في الاتفاقيات المتعلقة بهما . ويعرضها فورا على المجلس الشعبي الوطني ليوافق عليها صراحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_91_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_91_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_91_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_91_19890223_OpEnact_19ab844752> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_91_obligation_0_143e202a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "91" ;
    dzdoc:position 90 ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية، ولا يمكن أن يتجاوز مدة ثمان وأربعين (48 ) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء و وفقا للشروط المحددة بالقانون . ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك، على أن يعلم بهذه الإمكانية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_permission_0_5a394de2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_permission_1_f60bea84> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_right_0_13ecfb8b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_45_19890223_OpEnact_c1188eac72> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_45_obligation_0_0884f72c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 44 ;
    dzdoc:usesTerm dzterm:detention .

