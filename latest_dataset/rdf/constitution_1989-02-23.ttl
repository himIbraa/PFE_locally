    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "تعلل الأحكام القضائية ، وينطق بها في جلسات علانية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_136_19890223_OpEnact_ca4f09b33f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_136> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_136> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_136> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "على كل أجهزة الدولة المختصة أن تقوم ، في كل وقت وفي كل مكان ، وفي جميع الظروف ، بتنفيذ أحكام القضاء ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_137_19890223_OpEnact_3e5e964a69> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_137> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_137> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_137> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يختص القضاة بإصدار الأحكام . ويمكن أن يعينهم في ذلك مساعدون شعبيون حسب الشروط التي يحددها القانون ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_138_19890223_OpEnact_71d070fbd0> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_138> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_138> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_138> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "لا يخضع القاضي إلا للقانون ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_139_19890223_OpEnact_363ad63ba2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_139> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_139> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_139> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "القاضي محمي من كل أشكال الضغوط والتدخلات والمناورات التي قد تضر بأداء مهمته أو تمس نزاهة حكمه ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_13_19890223_OpEnact_7c403d4c28> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_13> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_13> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_13> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "لا يجوز البتة التنازل أو التخلي عن أي جزء من التراب الوطني ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_140_19890223_OpEnact_96a9ae3cb8> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
