    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_144> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_144> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يحدد القانون تنظيم المحكمة العليا ، وعملها ، واختصاصاتها الأخرى ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_145_19890223_OpEnact_40d506b941> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
