<https://legal.dz/resource/constitution/1989-02-23/1989#art_83> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_83" ;
    dzdoc:fullText "لا يجوز بأي حال من الأحوال أن يفوض رئيس الجمهورية سلطته في تعيين أعضاء المجلس الدستوري الذي يختص بتعيينهم، وفي تعيين رئيس الحكومة وأعضائها، وأعضاء المجلس الأعلى للأمن، وأعضاء المجلس الإسلامي الأعلى، وإنها مهامهم . كما لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء ، وحل المجلس الشعبي الوطني ، وتقرير إجراء الانتخابات التشريعية قبل أو في أوانها، وتطبيق الأحكام المنصوص عليها في المواد من 86 إلى 91 في الدستور، وكذلك السلطات المحددة في الفقرات : 1، 2 ، 3 ، 4 ، 6، 8 ، 10، 11، من المادة 74 ، وأحكام المادتين 117 و 118 من الدستور ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_83_permission_0_16e27f15>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_83_permission_1_0e1ffdf9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_83> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_83_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_83_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_83_19890223_OpEnact_857ba5dcfd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_83_obligation_0_5794c714>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_83_obligation_1_802995e2> ;
