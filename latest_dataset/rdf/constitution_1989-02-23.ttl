<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_condition_0_0d18d680> a dznorm:Condition ;
    dznorm:conditionText "إذا رأى المجلس الدستوري أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_condition_1_6874c616> a dznorm:Condition ;
    dznorm:conditionText "لا يمس بأي شيء التوازنات الأساسية للسلطات و المؤسسات الدستورية، و علل رأيه"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164> ;
    dznorm:position 1 .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_condition_2_73aa32a0> a dznorm:Condition ;
    dznorm:conditionText "متى أحرز ثلاثة أرباع من أصوات أعضاء المجلس الشعبي الوطني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164> ;
    dznorm:position 2 .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا رأى المجلس الدستوري أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري و حقوق الإنسان و المواطن و حرياتهما، و لا يمس بأي شيء التوازنات الأساسية للسلطات و المؤسسات الدستورية، و علل رأيه أمكن لرئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الإستفتاء الشعبي، متى أحرز ثلاثة أرباع من أصوات أعضاء المجلس الشعبي الوطني."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_right_0_5c125b8e> a dznorm:Right ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_right_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164> ;
    dznorm:position 0 ;
    dznorm:provisionText "حقوق الإنسان و المواطن و حرياتهما"@ar ;
    dznorm:sourceArticle "chp_الرابع_التعديل_الدستوري_art_164" .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165_condition_0_6080e428> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165_condition_0_6080e428_role_b9191c62bc> ;
    dznorm:conditionText "بعد أن يقره المجلس الشعبي الوطني، حسب الشروط نفسها التي تطبق على النص التشريعي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165_condition_0_6080e428_role_b9191c62bc> a dznorm:Role ;
    rdfs:label "النص التشريعي"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "بعد أن يقره المجلس الشعبي الوطني، حسب الشروط نفسها التي تطبق على النص التشريعي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165> .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165> ;
    dzdoc:position 0 ;
    dzdoc:text "يعرض القانون الذي يتضمن مشروع التعديل الدستوري، بعد أن يقره المجلس الشعبي الوطني، حسب الشروط نفسها التي تطبق على النص التشريعي، على إستفتاء الشعب للموافقة عليه، خلال الخمسة و الأربعين يوما الموالية لإقرار المجلس إياه."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166_condition_0_8870ca08> a dznorm:Condition ;
    dznorm:conditionText "إذا رفضه الشعب"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_166> ;
    dzdoc:position 0 ;
    dzdoc:text "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب و لا يمكن عرضه من جديد على الشعب من خلال نفس الفترة التشريعية."@ar .

