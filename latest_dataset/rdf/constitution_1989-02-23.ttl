<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_152> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المؤسسات الدستورية وأجهزة الرقابة مكلفة بالتحقيق في تطابق العمل التشريعي والتنفيذي مع الدستور ، وفي ظروف استخدام الوسائل المادية والأموال العمومية وتسييرها ."@ar ;
