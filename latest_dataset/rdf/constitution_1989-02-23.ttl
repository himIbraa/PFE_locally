<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_80> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تقدم الحكومة سنويا ل المجلس الشعبي الوطني بيانا عن السياسة العامة . تعقب بيان السياسة العامة مناقشة لعمل الحكومة . يمكن المجلس الشعبي الوطني أن يختتم هذه المناقشة بلائحة أو بإيداع ملتمس رقابة، طبقا لأحكام المواد 126 و 127 و 128 ، أدناه . ل رئيس الحكومة أن يطلب تصويتا بالثقة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_80_19890223_OpEnact_4163cb9fb7> ;
    dzdoc:replacementText "تقدم الحكومة سنويا ل المجلس الشعبي الوطني بيانا عن السياسة العامة . تعقب بيان السياسة العامة مناقشة لعمل الحكومة . يمكن المجلس الشعبي الوطني أن يختتم هذه المناقشة بلائحة أو بإيداع ملتمس رقابة، طبقا لأحكام المواد 126 و 127 و 128 ، أدناه . ل رئيس الحكومة أن يطلب تصويتا بالثقة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_80> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_80> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:targetScope "whole_article" ;
