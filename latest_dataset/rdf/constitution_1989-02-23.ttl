<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_160> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس مجلس محاسبة ، يكلف بالرقابة البعدية لأموال الدولة ، والجماعات الإقليمية ، والمرافق العمومية . يعد مجلس المحاسبة تقريرا سنويا ، ثم يرفعه إلى رئيس الجمهورية . يحدد القانون تنظيم مجلس المحاسبة ، وعمله ، وجزاء تحقيقاته ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_160_19890223_OpEnact_8ed5586bb9> ;
    dzdoc:replacementText "يؤسس مجلس محاسبة ، يكلف بالرقابة البعدية لأموال الدولة ، والجماعات الإقليمية ، والمرافق العمومية . يعد مجلس المحاسبة تقريرا سنويا ، ثم يرفعه إلى رئيس الجمهورية . يحدد القانون تنظيم مجلس المحاسبة ، وعمله ، وجزاء تحقيقاته ."@ar ;
