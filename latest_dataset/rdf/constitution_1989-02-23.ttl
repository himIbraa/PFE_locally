<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_81> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس رئيس الحكومة ، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، الصلاحيات الآتية : يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية ، يرأس مجلس الحكومة ، يسهر على تنفيذ القوانين والتنظيمات ، يوقع المراسيم التنفيذية ، يعين في وظائف الدولة دون المساس بأحكام الفقرتين 7 و 10 من المادة 74 ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_81_19890223_OpEnact_c27aac5088> ;
    dzdoc:replacementText "يمارس رئيس الحكومة ، زيادة على السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، الصلاحيات الآتية : يوزع الصلاحيات بين أعضاء الحكومة مع احترام الأحكام الدستورية ، يرأس مجلس الحكومة ، يسهر على تنفيذ القوانين والتنظيمات ، يوقع المراسيم التنفيذية ، يعين في وظائف الدولة دون المساس بأحكام الفقرتين 7 و 10 من المادة 74 ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_81> ;
