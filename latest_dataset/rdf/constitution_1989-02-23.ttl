<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_126> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المجلس الشعبي الوطني لدى مناقشة بيان السياسة العامة، أن يصوت على ملتمس رقابة ينصب على مسؤولية الحكومة . ولا يقبل هذا الملتمس إلا إذا وقعه سبع (7/1) النواب على الأقل ."@ar ;
