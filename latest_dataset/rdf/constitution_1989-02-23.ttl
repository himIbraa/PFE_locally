    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يقبل اقتراح أي قانون ، مضمونه أو نتيجته تخفيض الموارد العمومية ، أو زيادة النفقات العمومية ، إلا إذا كان مرفقا بتدابير تستهدف الزيادة في إيرادات الدولة ، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_114_19890223_OpEnact_e23728e357> ;
    dzdoc:replacementText "لا يقبل اقتراح أي قانون ، مضمونه أو نتيجته تخفيض الموارد العمومية ، أو زيادة النفقات العمومية ، إلا إذا كان مرفقا بتدابير تستهدف الزيادة في إيرادات الدولة ، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
