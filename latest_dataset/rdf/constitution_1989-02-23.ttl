<https://legal.dz/resource/constitution/1989-02-23/1989#art_125_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_125> ;
    dzdoc:position 1 ;
    dzdoc:text "ويكون الجواب عن السؤال الكتابي كتابيا ، خلال أجل أقصاه ثلاثون يوما وتتم الإجابة عن الأسئلة الشفوية في جلسات المجلس ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_125_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_125> ;
