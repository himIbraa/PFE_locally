<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_153> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية، والانتخابات التشريعية ، ويعلن نتائج هذه العمليات ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_153_19890223_OpEnact_a92aedd12a> ;
    dzdoc:replacementText "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية، والانتخابات التشريعية ، ويعلن نتائج هذه العمليات ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_153> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
