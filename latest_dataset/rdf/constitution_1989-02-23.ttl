<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_163> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني ، يعرض على إستفتاء الشعب للموافقة عليه ثم يصدره رئيس الجمهورية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_163_19890223_OpEnact_f414c705b4> ;
    dzdoc:replacementText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني ، يعرض على إستفتاء الشعب للموافقة عليه ثم يصدره رئيس الجمهورية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
