<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_146> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر المجلس الأعلى للقضاء ، طبقا للشروط التي يحددها القانون ، تعيين القضاة ، ونقلهم ، وسير سلمهم الوظيفي . ويسهر على احترام أحكام القانون الأساسي للقضاء، وعلى رقابة انضباط القضاة تحت رئاسة الرئيس الأول للمحكمة العليا ."@ar ;
