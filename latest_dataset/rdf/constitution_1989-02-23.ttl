    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_56> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_56> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "ظروف معيشة المواطنين الذين لم يبلغوا سن العمل ، والذين لا يستطيعون القيام به ، والذين عجزوا عنه نهائيا، مضمونة"@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_57_19890223_OpEnact_fe06ca5e68> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
