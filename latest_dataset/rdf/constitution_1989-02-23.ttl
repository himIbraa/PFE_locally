<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_7> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "السلطة التأسيسية ملك الشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها . يمارس الشعب هذه السيادة عن طريق الاستفتاء وبواسطة ممثليه المنتخبين . ل رئيس الجمهورية أن يلتجئ إلى إرادة الشعب مباشرة ."@ar ;
