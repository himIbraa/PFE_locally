    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_55> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "تحظى الأسرة بحماية الدولة والمجتمع ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_56_19890223_OpEnact_13e03c3237> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
