<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_61> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "كل المواطنين متساوون في أداء الضريبة . ويجب على كل واحد أن يشارك في تمويل التكاليف العمومية، حسب قدرته الضريبية . لا يجوز أن تحدث أية ضريبة إلا بمقتضى القانون . ولا يجوز أن تحدث بأثر رجعي ، أية ضريبة ، أو جباية ، أو رسم ، أو أي حق كيفما كان نوعه."@ar ;
