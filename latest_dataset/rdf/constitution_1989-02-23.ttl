<https://legal.dz/resource/constitution/1989-02-23/1989#art_73_obligation_0_1f8b7644> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/constitution/1989-02-23/1989#art_73_obligation_0_1f8b7644_role_f0719a287e> ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_73> ;
    dznorm:position 0 ;
    dznorm:provisionText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى ولأرواح شهدائنا الأبرار وقيم ثورة نوفمبر، أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده، و أدافع عن الدستور، و أحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، و أحافظ على سلامة التراب الوطني و وحدة الشعب و الأمة ، و أحمي الحريات والحقوق الأساسية للإنسان والمواطن ، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره ، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة ، والحرية ، والسلم في العالم”"@ar ;
    dznorm:sourceArticle "art_73" .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_73_obligation_0_1f8b7644_role_f0719a287e> a dznorm:Role ;
    rdfs:label "سلامة التراب الوطني"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى ولأرواح شهدائنا الأبرار وقيم ثورة نوفمبر، أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده، و أدافع عن الدستور، و أحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، و أحافظ على سلامة التراب الوطني و وحدة الشعب و الأمة ، و أحمي الحريات والحقوق الأساسية للإنسان والمواطن ، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره ، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة ، والحرية ، والسلم في العالم”"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_73> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_73_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_73> ;
    dzdoc:position 0 ;
    dzdoc:text "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى ولأرواح شهدائنا الأبرار وقيم ثورة نوفمبر، أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده، و أدافع عن الدستور، و أحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، و أحافظ على سلامة التراب الوطني و وحدة الشعب و الأمة ، و أحمي الحريات والحقوق الأساسية للإنسان والمواطن ، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره ، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة ، والحرية ، والسلم في العالم” ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_74_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_74> ;
    dzdoc:position 0 ;
    dzdoc:text "يضطلع رئيس الجمهورية ، بالإضافة إلى السلطات التي تخولها إياه صراحة أحكام أخرى في الدستور ، بالسلطات والصلاحيات الآتية : 1)- هو القائد الأعلى لجميع القوات المسلحة للجمهورية ، 2)- يتولى مسؤولية الدفاع الوطني ، 3)- يقرر السياسة الخارجية للأمة ويوجهها ، 4)- يرأس مجلس الوزراء ، 5)- يعين رئيس الحكومة وينهي مهامه ، 6)- يوقع المراسيم الرئاسية ، 7)- يعين في الوظائف المدنية والعسكرية للدولة ، 8)- له حق إصدار العفو وحق تخفيض العقوبات أو استبدالها ، 9)- يمكنه أن يستشير الشعب في كل قضية ذات أهمية وطنية عن طريق الاستفتاء ، 10)- يعين سفراء الجمهورية والمبعوثين فوق العادة إلى الخارج، وينهي مهامهم، ويتسلم أوراق اعتماد الممثلين الدبلوماسيين الأجانب ، وأوراق إنهاء مهامهم، 11)- يبرم المعاهدات الدولية ويصادق عليها ، 12)- يسلم أوسمة الدولة ، و نياشينها، وشهاداتها التشريفية."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_75_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_75> ;
    dzdoc:position 0 ;
    dzdoc:text "يقدم رئيس الحكومة أعضاء حكومته الذين اختارهم لـ رئيس الجمهورية الذي يعينهم ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_75_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_75> ;
    dzdoc:position 1 ;
    dzdoc:text "يضبط رئيس الحكومة برنامج حكومته، ويعرضه في مجلس الوزراء ."@ar .

