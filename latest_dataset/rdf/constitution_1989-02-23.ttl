<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_45> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية، ولا يمكن أن يتجاوز مدة ثمان وأربعين (48 ) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء و وفقا للشروط المحددة بالقانون . ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك، على أن يعلم بهذه الإمكانية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_45_19890223_OpEnact_c1188eac72> ;
    dzdoc:replacementText "يخضع التوقيف للنظر في مجال التحريات الجزائية للرقابة القضائية، ولا يمكن أن يتجاوز مدة ثمان وأربعين (48 ) ساعة . يملك الشخص الذي يوقف للنظر حق الاتصال فورا بأسرته . ولا يمكن تمديد مدة التوقيف للنظر، إلا استثناء و وفقا للشروط المحددة بالقانون . ولدى انتهاء مدة التوقيف للنظر، يجب أن يجرى فحص طبي على الشخص الموقوف، إن طلب ذلك، على أن يعلم بهذه الإمكانية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_45> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
