<https://legal.dz/resource/constitution/1989-02-23/1989#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "لا يخضع القاضي إلا للقانون ."@ar ;
