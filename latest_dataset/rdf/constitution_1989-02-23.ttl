    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_132> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يصدر القضاء أحكامه باسم الشعب ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_133_19890223_OpEnact_ddade322e2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
