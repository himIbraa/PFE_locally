<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المجلس الشعبي الوطني أن يفتح مناقشة حول السياسة الخارجية ، بناء على طلب رئيس الجمهورية ، أو رئيس المجلس . يمكن ، عند الاقتضاء ، أن تتوج هذه المناقشة بإصدار لائحة من المجلس الشعبي الوطني ، يبلغها رئيسه إلى رئيس الجمهورية ."@ar ;
