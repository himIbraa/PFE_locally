    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تستهدف المؤسسات ضمان مساواة كل المواطنين والمواطنات في الحقوق والواجبات بإزالة العقبات التي تعوق تفتح شخصية الإنسان، وتحول دون مشاركة الجميع الفعلية في الحياة السياسية ، والاقتصادية، والاجتماعية، والثقافية ."@ar ;
