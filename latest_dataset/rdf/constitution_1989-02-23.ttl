<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_110> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "جلسات المجلس الشعبي الوطني علانية . وتدون مداولاته في محاضر تنشر طبقا لما يحدده القانون . يجوز للمجلس الشعبي الوطني أن يعقد جلسات مغلقة بطلب من رئيسه ، أو من أغلبية أعضائه الحاضرين ، أو بطلب من الحكومة ."@ar ;
