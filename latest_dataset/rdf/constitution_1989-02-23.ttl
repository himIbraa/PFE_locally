    dznorm:conditionText "بعد أن يقره المجلس الشعبي الوطني، حسب الشروط نفسها التي تطبق على النص التشريعي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_165> ;
