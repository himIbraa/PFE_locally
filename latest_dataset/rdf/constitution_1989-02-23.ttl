<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_87> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقرر رئيس الجمهورية ، الحالة الاستثنائية ، إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية ، أو استقلالها ، أو سلامة ترابها و لا يتخذ مثل هذا الإجراء إلا بعد استشارة المجلس الدستوري ، و الاستماع إلى المجلس الأعلى للأمن ، و مجلس الوزراء . تخول الحالة الاستثنائية رئيس الجمهورية أن يتخذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية . يجتمع المجلس الشعبي الوطني وجوبا . تنتهي الحالة الاستثنائية ، حسب الأشكال والإجراءات السالفة الذكر ال"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_87_19890223_OpEnact_0438aabc8e> ;
    dzdoc:replacementText "يقرر رئيس الجمهورية ، الحالة الاستثنائية ، إذا كانت البلاد مهددة بخطر داهم يوشك أن يصيب مؤسساتها الدستورية ، أو استقلالها ، أو سلامة ترابها و لا يتخذ مثل هذا الإجراء إلا بعد استشارة المجلس الدستوري ، و الاستماع إلى المجلس الأعلى للأمن ، و مجلس الوزراء . تخول الحالة الاستثنائية رئيس الجمهورية أن يتخذ الإجراءات الاستثنائية التي تستوجبها المحافظة على استقلال الأمة والمؤسسات الدستورية في الجمهورية . يجتمع المجلس الشعبي الوطني وجوبا . تنتهي الحالة الاستثنائية ، حسب الأشكال والإجراءات السالفة الذكر التي أوجبت إعلانها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_87> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_87> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

