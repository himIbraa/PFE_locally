<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_96> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينتخب المجلس الشعبي الوطني لمدة خمس سنوات . ولا يمكن تمديد الفترة النيابية إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت المجلس الشعبي الوطني هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية، واستشارة المجلس الدستوري ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_96_19890223_OpEnact_619f23d730> ;
    dzdoc:replacementText "ينتخب المجلس الشعبي الوطني لمدة خمس سنوات . ولا يمكن تمديد الفترة النيابية إلا في ظروف خطيرة جدا لا تسمح بإجراء انتخابات عادية . ويثبت المجلس الشعبي الوطني هذه الحالة بقرار، بناء على اقتراح رئيس الجمهورية، واستشارة المجلس الدستوري ."@ar ;
