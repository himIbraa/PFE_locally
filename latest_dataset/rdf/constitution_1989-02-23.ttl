    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_145> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يرأس رئيس الجمهورية ، المجلس الأعلى للقضاء ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_146_19890223_OpEnact_adc4c8e12c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_146> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_146> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_146> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يقرر المجلس الأعلى للقضاء ، طبقا للشروط التي يحددها القانون ، تعيين القضاة ، ونقلهم ، وسير سلمهم الوظيفي . ويسهر على احترام أحكام القانون الأساسي للقضاء، وعلى رقابة انضباط القضاة تحت رئاسة الرئيس الأول للمحكمة العليا ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_147_19890223_OpEnact_90839aa61a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_147> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_147> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_147> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يبدي المجلس الأعلى للقضاء رأيا استشاريا قبليا في ممارسة رئيس الجمهورية حق العفو ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_148_19890223_OpEnact_408f14283b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
