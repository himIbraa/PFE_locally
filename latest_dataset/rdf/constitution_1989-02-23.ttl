<https://legal.dz/resource/constitution/1989-02-23/1989#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "الشعب مصدر كل سلطة . ” السيادة الوطنية ملك الشعب ” ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_6_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_6_19890223_OpEnact_c410c0d1e4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "6" ;
    dzdoc:position 5 ;
    dzdoc:usesTerm dzterm:national_sovereignty,
        dzterm:people .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "يتمتع كل أجنبي يكون وجوده فوق التراب الوطني قانونيا بـ حماية شخصه وأملاكه طباق لـ القانون ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_64_right_0_35c3af4b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_64_19890223_OpEnact_95f0bb7f92> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 64" ;
    dzdoc:position 63 ;
    dzdoc:usesTerm dzterm:law .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "لا يحق أن ينتخب لرئاسة الجمهورية إلا من كان جزائري الجنسية أصلا، ويدين بالإسلام ، وعمره أربعون سنة كاملة يوم الانتخاب ، ويتمتع بكامل حقوقه المدنية والسياسية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_70_19890223_OpEnact_c5d46912ba> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_70_condition_0_815853a3> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "ينفذ رئيس الحكومة وينسق البرنامج الذي يوافق عليه المجلس الشعبي الوطني ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_79_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_79_19890223_OpEnact_c8bfb7137b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_79_obligation_0_1253ef05> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "79" ;
    dzdoc:position 78 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:head_of_government .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "يختار الشعب لنفسه مؤسسات ، غايتها ما يأتي : المحافظة على الاستقلال الوطني ، ودعمه ، المحافظة على الهوية ، والوحدة الوطنية ، ودعمهما ، حماية الحريات الأساسية للمواطن ، والازدهار الاجتماعي والثقافي للأمة ، القضاء على استغلال الإنسان للإنسان، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب ، أو الاختلاس ، أو الاستحواذ ، أو المصادرة غير المشروعة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_8_right_0_86a39f2d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_8_19890223_OpEnact_df842476a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:people .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "يمارس السلطة التشريعية مجلس واحد يسمى المجلس الشعبي الوطني . وله السيادة في إعداد القانون والتصويت عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_92_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_92_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_92_19890223_OpEnact_3630950fb2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 92" ;
    dzdoc:position 91 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:legislative_power .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "واجب المجلس الشعبي الوطني في إطار اختصاصاته الدستورية، أن يبقى وفيا لثقة الشعب ، ويظل يتحسس تطلعاته"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_94_19890223_OpEnact_dbf8d43686> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_94_obligation_0_69a52fca> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 94" ;
    dzdoc:position 93 ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "chp_الرابع_التعديل_الدستوري_art_167" ;
    dzdoc:fullText "يصدر رئيس الجمهورية نص التعديل الدستوري الذي أقره الشعب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_الرابع_التعديل_الدستوري_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_167_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_______art_167_19890223_OpEnact_0cf768d65d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_167_obligation_0_7748720b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 169 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_100> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_100" ;
    dzdoc:fullText "كل نائب لا يستوفي شروط قابلية انتخابه أو يفقدها ، يتعرض لإسقاط صفته النيابية . ويقرر المجلس الشعبي الوطني هذا الإسقاط بأغلبية أعضائه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_100> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_100_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_100_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_100_19890223_OpEnact_33cf852adf> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 100" ;
    dzdoc:position 99 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_100_condition_0_3103b9ee> ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "تستمد الدولة مشروعيتها وسبب وجودها من إرادة الشعب . شعارها : ” بالشعب وللشعب” . وهي في خدمته وحده ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_11_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_11_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_11_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_11_19890223_OpEnact_3edb11356d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 11" ;
    dzdoc:position 10 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "لا يقبل اقتراح أي قانون ، مضمونه أو نتيجته تخفيض الموارد العمومية ، أو زيادة النفقات العمومية ، إلا إذا كان مرفقا بتدابير تستهدف الزيادة في إيرادات الدولة ، أو توفير مبالغ مالية في فصل آخر من النفقات العمومية تساوي على الأقل المبالغ المقترح إنفاقها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_114_19890223_OpEnact_e23728e357> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_114_obligation_0_0d22e4ff> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 114" ;
    dzdoc:position 113 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "يمكن رئيس الجمهورية أن يوجه خطابا إلى المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_119_permission_0_29855e26> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_119_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_119_19890223_OpEnact_83688d9319> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 119" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_130> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_130" ;
    dzdoc:fullText "تحمي السلطة القضائية والحريات، وتضمن للجميع ولكل واحد المحافظة على حقوقهم الأساسية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_130> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_130_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_130_19890223_OpEnact_fb980a9073> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_130_obligation_0_87aba4b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 130" ;
    dzdoc:position 129 ;
    dzdoc:usesTerm dzterm:judicial_authority .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "على كل أجهزة الدولة المختصة أن تقوم ، في كل وقت وفي كل مكان ، وفي جميع الظروف ، بتنفيذ أحكام القضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_136_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_136_19890223_OpEnact_ca4f09b33f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_136_obligation_0_baf9685c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 136" ;
    dzdoc:position 135 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "يختص القضاة بإصدار الأحكام . ويمكن أن يعينهم في ذلك مساعدون شعبيون حسب الشروط التي يحددها القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_137_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_137_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_137_19890223_OpEnact_3e5e964a69> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 137" ;
    dzdoc:position 136 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_137_condition_0_732c65d3> ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_15> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:definesTerm dzterm:local_authorities,
        dzterm:municipality ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_15" ;
    dzdoc:fullText "الجماعات الإقليمية للدولة هي البلدية والولاية . البلدية هي الجماعة القاعدية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_15> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1989-02-23/1989#art_15_defocc_72149717b200>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_15_defocc_ae54bf579089> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_15_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_15_19890223_OpEnact_c1831cf872> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 15" ;
    dzdoc:position 14 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "تقدم الحكومة للمجلس الشعبي الوطني ، عرضا عن استعمال الاعتمادات المالية التي أقرها لكل سنة مالية . تختتم السنة المالية ، فيما يخص المجلس الشعبي الوطني ، بالتصويت على قانون يتضمن تسوية ميزانية السنة المالية المعنية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_150_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_150_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_150_19890223_OpEnact_10906d44d4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_150_obligation_0_f0091b42> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 150" ;
    dzdoc:position 149 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:government .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "إذا ارتأى المجلس الدستوري عدم دستورية معاهدة أو اتفاق ، أو اتفاقية ، فلا تتم المصادقة عليها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_158_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_158_19890223_OpEnact_8ada33fd14> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_158_obligation_0_c350331a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 158" ;
    dzdoc:position 157 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_158_condition_0_bd964190> ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_159> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_159" ;
    dzdoc:fullText "إذا قرر المجلس الدستوري أن نصا تشريعيا أو تنظيميا غير دستوري ، يفقد هذا النص أثره ، ابتداء من يوم قرار المجلس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_159> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_159_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_159_19890223_OpEnact_3192efc971> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_159_obligation_0_38202cc6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 159" ;
    dzdoc:position 158 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_159_condition_0_761ab708> ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني ، يعرض على إستفتاء الشعب للموافقة عليه ثم يصدره رئيس الجمهورية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_163_right_0_d606ac4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_163_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_163_19890223_OpEnact_f414c705b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 160 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_163_condition_0_fc4bd50b> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "يعرض القانون الذي يتضمن مشروع التعديل الدستوري، بعد أن يقره المجلس الشعبي الوطني ، حسب الشروط نفسها التي تطبق على النص التشريعي ، على إستفتاء الشعب للموافقة عليه، خلال الخمسة و الأربعين يوما الموالية لإقرار المجلس إياه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_165_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_165_19890223_OpEnact_5b790577f8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 165" ;
    dzdoc:position 162 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_165_condition_0_6080e428> ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "الدولة مسؤولة عن أمن كل مواطن . وتتكفل بحمايته في الخارج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_23_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_23_19890223_OpEnact_b0e36f83ff> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_23_obligation_0_2c52d802>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_23_obligation_1_fa108eac> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 23" ;
    dzdoc:position 22 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_24> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_24" ;
    dzdoc:fullText "تنتظم الطاقة الدفاعية للأمة ، ودعمها ، وتطويرها ، حول الجيش الوطني الشعبي . تتمثل المهمة الدائمة للجيش الوطني الشعبي في المحافظة على الاستقلال الوطني ، والدفاع عن السيادة الوطنية . كما يضطلع بالدفاع عن وحدة البلاد ، وسلامتها الترابية ، وحماية مجالها البري والجوي ، ومختلف مناطق أملاكها البحرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_24> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_24_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_24_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_24_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_24_19890223_OpEnact_2e74ccfcb9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 24" ;
    dzdoc:position 23 ;
    dzdoc:usesTerm dzterm:anp .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "تمتنع الجزائر عن اللجوء إلى الحرب من أجل المساس بالسيادة المشروعة للشعوب الأخرى وحريتها . وتبذل جهدها لتسوية الخلافات الدولية بالوسائل السلمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_25_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_25_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_25_19890223_OpEnact_98950cade7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_25_obligation_0_ed4a40d0> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 25" ;
    dzdoc:position 24 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_26> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_26" ;
    dzdoc:fullText "الجزائر متضامنة مع جميع الشعوب التي تكافح من أجل التحرير السياسي والاقتصادي ، و الحق في تقرير المصير ، وضد كل تمييز عنصري ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_26_right_0_804d9170> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_26> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_26_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_26_19890223_OpEnact_fd101b4e97> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_26_obligation_0_eeadc24d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 26" ;
    dzdoc:position 25 ;
    dzdoc:usesTerm dzterm:algeria .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_27> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_27" ;
    dzdoc:fullText "تعمل الجزائر من أجل دعم التعاون الدولي ، وتنمية العلاقات الودية بين الدول ، على أساس المساواة ، والمصلحة المتبادلة ، وعدم التدخل في الشؤون الداخلية ، وتتبنى مبادئ ميثاق الأمم المتحدة وأهدافه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_27> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_27_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_27_19890223_OpEnact_b7c65ec3a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_27_obligation_0_a7435179> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 27" ;
    dzdoc:position 26 ;
    dzdoc:usesTerm dzterm:algeria .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "لا مساس ب حرمة حرية المعتقد ، و حرمة حرية الرأي ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_35_right_0_cc836dbc>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_35_right_1_d148bdab> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_35_19890223_OpEnact_144d9edf6b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 34 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "يترتب على الخطأ القضائي تعويض من الدولة . ويحدد القانون شروط التعويض و كيفياته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_46_right_0_8f3eec6f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_46_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_46_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_46_19890223_OpEnact_edf030b852> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 45 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "لكل مواطن تتوفر فيه الشروط القانونية أن ينتخب وينتخب ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_47_right_0_f8970ca3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_47_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_47_19890223_OpEnact_88dcd19123> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 46 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_47_condition_0_32b2f7fa> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "يجازي القانون الآباء على القيام بـ واجب تربية أبنائهم ورعايتهم ، كما يجازي الأبناء على القيام بـ واجب الإحسان إلى آبائهم ومساعدتهم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_62_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_62_19890223_OpEnact_c460abdeda> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_62_obligation_0_bede1239>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_62_obligation_1_6092d0d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 61 ;
    dzdoc:usesTerm dzterm:law .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "ينتخب رئيس الجمهورية ، عن طريق الاقتراع العام المباشر والسري . يتم الفوز في الانتخابات بالحصول على الأغلبية المطلقة من أصوات الناخبين المعبر عنها . ويحدد القانون الكيفيات الأخرى للانتخابات الرئاسية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_68_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_68_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_68_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_68_19890223_OpEnact_3ed17e6db1> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 67 ;
    dzdoc:usesTerm dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين حسب النص الآتي : “وفاء للتضحيات الكبرى ولأرواح شهدائنا الأبرار وقيم ثورة نوفمبر، أقسم بالله العلي العظيم أن أحترم الدين الإسلامي و أمجده، و أدافع عن الدستور، و أحترم حرية اختيار الشعب، ومؤسسات الجمهورية وقوانينها، و أحافظ على سلامة التراب الوطني و وحدة الشعب و الأمة ، و أحمي الحريات والحقوق الأساسية للإنسان والمواطن ، وأعمل بدون هوادة من أجل تطور الشعب وازدهاره ، وأسعى بكل قواي في سبيل تحقيق المثل العليا للعدالة ، والحرية ، والسلم في العالم” ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_73_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_73_19890223_OpEnact_307e7332ea> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_73_obligation_0_1f8b7644> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 72 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "يمكن رئيس الحكومة أن يقدم استقالة حكومته ل رئيس الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_82_permission_0_296feeff> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_82_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_82_19890223_OpEnact_ab88d14cb6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "82" ;
    dzdoc:position 81 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "التعبئة العامة يقررها رئيس الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_88> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_88_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_88_19890223_OpEnact_7f7e91467f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:general_mobilization,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_90> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_90" ;
    dzdoc:fullText "يوقف العمل بالدستور مدة حالة الحرب ، ويتولى رئيس الجمهورية جميع السلطات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_90> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_90_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_90_19890223_OpEnact_b26ba3fbce> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 89 ;
    dzdoc:usesTerm dzterm:president,
        dzterm:state_of_war .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "chp_الرابع_التعديل_الدستوري_art_163" ;
    dzdoc:fullText "ل رئيس الجمهورية حق المبادرة بالتعديل الدستوري ، و بعد أن يصوت عليه المجلس الشعبي الوطني ، يعرض على إستفتاء الشعب للموافقة عليه ثم يصدره رئيس الجمهورية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163_right_0_d606ac4e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_الرابع_التعديل_الدستوري_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_______art_163_19890223_OpEnact_53ab36eb51> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 165 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163_condition_0_fc4bd50b> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "chp_الرابع_التعديل_الدستوري_art_165" ;
    dzdoc:fullText "يعرض القانون الذي يتضمن مشروع التعديل الدستوري، بعد أن يقره المجلس الشعبي الوطني ، حسب الشروط نفسها التي تطبق على النص التشريعي ، على إستفتاء الشعب للموافقة عليه، خلال الخمسة و الأربعين يوما الموالية لإقرار المجلس إياه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_الرابع_التعديل_الدستوري_art_165> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_______art_165_19890223_OpEnact_90c99b956a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 165" ;
    dzdoc:position 167 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_165_condition_0_6080e428> ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_101> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_101" ;
    dzdoc:fullText "النائب مسؤول أمام زملائه الذين يمكنهم تجريده من صفته النيابية، إذا اقترف فعلا يخل بشرف وظيفته . يحدد القانون الحالات التي يتعرض فيها النائب للإقصاء . ويقرر المجلس الشعبي الوطني هذا الإقصاء بأغلبية أعضائه، دون المساس بحق المتابعات الأخرى الواردة في القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_101> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_101_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_101_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_101_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_101_19890223_OpEnact_20050fd4a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 101" ;
    dzdoc:position 100 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_101_condition_0_e1901fc7> ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "تبتدئ الفترة التشريعية وجوبا ، في اليوم العاشر الموالي لتاريخ انتخاب المجلس الشعبي الوطني ، تحت رئاسة أكبر النواب سنا ، وبمساعدة أصغر نائبين منهم . ينتخب المجلس الشعبي الوطني مكتبه ، ويشكل لجانه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_107_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_107_19890223_OpEnact_4d1596875a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_107_obligation_0_2bd70c3d>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_107_obligation_1_0d01f392> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 107" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "يحدد القانون تنظيم المجلس الشعبي الوطني ، وعلمه ، وميزانيته ، والتعويضات التي تدفع لأعضائه . يعد المجلس الشعبي الوطني نظامه الداخلي ، ويصادق عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_109_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_109_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_109_19890223_OpEnact_dc876995b7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_109_obligation_0_25eb25ed>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_109_obligation_1_275aa6e6> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 109" ;
    dzdoc:position 108 ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "يصادق رئيس الجمهورية على اتفاقيات الهدنة ، ومعاهدات السلم والتحالف والاتحاد، والمعاهدات المتعلقة بحدود الدولة ، والمعاهدات المتعلقة بقانون الأشخاص، والمعاهدات التي تترتب عليها نفقات غير واردة في ميزانية الدولة بعد أن يوافق عليها المجلس الشعبي الوطني صراحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_122_19890223_OpEnact_c1f64186dd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_122_obligation_0_e5ea54aa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 122" ;
    dzdoc:position 121 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_122_condition_0_6b4a7400> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_142> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_142" ;
    dzdoc:fullText "الحق في الدفاع معترف به . الحق في الدفاع مضمون في القضايا الجزائية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_142_right_0_1fb9a7f8>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_142_right_1_8ef87a6f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_142> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_142_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_142_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_142_19890223_OpEnact_d889bedccf> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 142" ;
    dzdoc:position 141 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "تمثل المحكمة العليا ، في جميع مجالات القانون ، الهيئة المقومة لأعمال المجالس القضائية والمحاكم . تضمن المحكمة العليا توحيد الاجتهاد القضائي في جميع أنحاء البلاد ، وتسهر على احترام القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_143_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_143_19890223_OpEnact_4efaf520fc> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_143_obligation_0_0ac396fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 142 ;
    dzdoc:usesTerm dzterm:supreme_court .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_17> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:definesTerm dzterm:public_property ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_17" ;
    dzdoc:fullText "الملكية العامة هي ملك المجموعة الوطنية . وتشمل باطن الأرض، والمناجم ، و المقالع ، والموارد الطبيعية للطاقة ، والثروات المعدنية، الطبيعية ، والحية ، في مختلف مناطق الأملاك الوطنية البحرية ، والمياه، والغابات . كما تشمل النقل بالسكك الحديدية ، والنقل البحري والجوي ، والبريد والمواصلات السلكية واللاسلكية، وأملاكا أخرى محددة في القانون ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_17> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1989-02-23/1989#art_17_defocc_1285e6742479> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_17_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_17_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_17_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_17_19890223_OpEnact_16bcf986c8> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 17" ;
    dzdoc:position 16 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "كل المواطنين سواسية أمام القانون . ولا يمكن أن يتذرع بأي تمييز يعود سببه إلى المولد ، أو العرق ، أو الجنس ، أو الرأي ، أو أي شرط أو ظرف آخر ، شخصي أو اجتماعي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_28_permission_0_b8bbaa04> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_28_right_0_9952cfc0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_28_19890223_OpEnact_e5d99afffa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 27 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_31> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_31" ;
    dzdoc:fullText "الحريات الأساسية وحقوق الإنسان والمواطن مضمونة ، وتكون تراثا مشتركا بين جميع الجزائريين والجزائريات ، واجبهم أن ينقلوه من جيل إلى جيل كي يحافظوا على سلامته ، وعدم انتهاك حرمته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_31_right_0_d0e243e4> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_31_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_31_19890223_OpEnact_24fcd83cb4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_31_obligation_0_a1146d26> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "31" ;
    dzdoc:position 30 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "تضمن الدولة عدم انتهاك حرمة المسكن . فلا تفتيش إلا بمقتضى القانون، وفي إطار احترامه . ولا تفتيش إلا بأمر مكتوب صادر عن السلطة القضائية المختصة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_38_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_38_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_38_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_38_19890223_OpEnact_0b8f0bff71> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_38_obligation_0_dad5edad> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 37 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "يحق لكل مواطن يتمتع بحقوقه المدنية والسياسية، أن يختار بحرية موطن إقامته ، وأن ينتقل عبر التراب الوطني . حق الدخول إلى التراب الوطني والخروج منه مضمون له ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_41_right_0_85021025>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_41_right_1_d6a64e0b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_41_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_41_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_41_19890223_OpEnact_122d05bf6b> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "41" ;
    dzdoc:position 40 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "الرعاية الصحية حق للمواطنين . تتكفل الدولة بالوقاية من الأمراض الوبائية والمعدية ومكافحتها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_51_right_0_c6d02896> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_51> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_51_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_51_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_51_19890223_OpEnact_9c807286d6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_51_obligation_0_f0c4ea06> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 51" ;
    dzdoc:position 50 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي الملكية العامة ، ومصالح المجموعة الوطنية ، ويحترم ملكية الغير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_63_19890223_OpEnact_d182db88ab> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_63_obligation_0_5e057d12> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 62 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "لا يمكن بأي حال من الأحوال أن يسلم أو يطرد لاجئ سياسي يتمتع قنونا بـ حق اللجوء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_66_permission_0_0daa1cc9> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_66_right_0_98a48beb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_66_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_66_19890223_OpEnact_0e58b7f35d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 66" ;
    dzdoc:position 65 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثاني_الشعب> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "السلطة التأسيسية ملك الشعب . يمارس الشعب سيادته بواسطة المؤسسات الدستورية التي يختارها . يمارس الشعب هذه السيادة عن طريق الاستفتاء وبواسطة ممثليه المنتخبين . ل رئيس الجمهورية أن يلتجئ إلى إرادة الشعب مباشرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_7_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_7_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_7_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_7_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_7_19890223_OpEnact_0d7a82b331> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "7" ;
    dzdoc:position 6 ;
    dzdoc:usesTerm dzterm:constituent_power,
        dzterm:constitutional_institutions,
        dzterm:people,
        dzterm:president_of_the_republic,
        dzterm:referendum .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة ، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فور أدائه اليمين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_72_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_72_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_72_19890223_OpEnact_56361ebaa4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_72_obligation_0_bfd4881f> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "يقدم رئيس الحكومة أعضاء حكومته الذين اختارهم لـ رئيس الجمهورية الذي يعينهم . يضبط رئيس الحكومة برنامج حكومته، ويعرضه في مجلس الوزراء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_75_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_75_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_75_19890223_OpEnact_a6f0e86396> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 ;
    dzdoc:usesTerm dzterm:head_of_government,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_76> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_76" ;
    dzdoc:fullText "يقدم رئيس الحكومة برنامجه إلى المجلس الشعبي الوطني للموافقة عليه يجري المجلس الشعبي الوطني لهذا الغرض مناقشة عامة . ويمكن رئيس الحكومة أن يكيف برنامجه في ضوء هذه المناقشة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_76> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_76_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_76_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_76_19890223_OpEnact_6ee850c2c6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_76_obligation_0_7ea7aaf5>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_76_obligation_1_8cfbca19> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "76" ;
    dzdoc:position 75 ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:head_of_government .

dzterm:head_of_government a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "رئيس الحكومة"@ar,
        "رئيس حكومة"@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_151> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_151" ;
    dzdoc:fullText "يمكن المجلس الشعبي الوطني ، في إطار اختصاصاته ، أن ينشئ في أي وقت ، لجنة تحقيق في أية قضية ذات مصلحة عامة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_151_permission_0_ed80756b> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_151_right_0_ba7327cc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_151> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_151_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_151_19890223_OpEnact_bfddcc13ab> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 151" ;
    dzdoc:position 150 ;
    dzdoc:usesTerm dzterm:apn .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_153> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:definesTerm dzterm:constitutional_council ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_153" ;
    dzdoc:fullText "يؤسس مجلس دستوري يكلف بالسهر على احترام الدستور . كما يسهر المجلس الدستوري على صحة عمليات الاستفتاء، وانتخاب رئيس الجمهورية، والانتخابات التشريعية ، ويعلن نتائج هذه العمليات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_153> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1989-02-23/1989#art_153_defocc_cd780e05c7b1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_153_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_153_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_153_19890223_OpEnact_a92aedd12a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_153_obligation_0_2fa9f87c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 153" ;
    dzdoc:position 152 ;
    dzdoc:usesTerm dzterm:constitutional_council .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_160> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:definesTerm dzterm:court_of_auditors ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الأول_الرقابة> ;
    dzdoc:eId "art_160" ;
    dzdoc:fullText "يؤسس مجلس محاسبة ، يكلف بالرقابة البعدية لأموال الدولة ، والجماعات الإقليمية ، والمرافق العمومية . يعد مجلس المحاسبة تقريرا سنويا ، ثم يرفعه إلى رئيس الجمهورية . يحدد القانون تنظيم مجلس المحاسبة ، وعمله ، وجزاء تحقيقاته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_160> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/constitution/1989-02-23/1989#art_160_defocc_769cc7b7325e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_160_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_160_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_160_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_160_19890223_OpEnact_8ed5586bb9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_160_obligation_0_a72b4f04> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 160" ;
    dzdoc:position 159 ;
    dzdoc:usesTerm dzterm:court_of_auditors .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "إذا رأى المجلس الدستوري أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري و حقوق الإنسان و المواطن و حرياتهما ، و لا يمس بأي شيء التوازنات الأساسية للسلطات و المؤسسات الدستورية، و علل رأيه أمكن ل رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الإستفتاء الشعبي، متى أحرز ثلاثة أرباع من أصوات أعضاء المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_164_right_0_5c125b8e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_164_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_164_19890223_OpEnact_8ea8313380> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 161 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_164_condition_0_0d18d680>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_164_condition_1_6874c616>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_164_condition_2_73aa32a0> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_council,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الثالث_الدولة> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "لا يمكن أن تكون الوظائف في مؤسسات الدولة مصدرا للثراء ، ولا وسيلة لخدمة المصالح الخاصة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_21_permission_0_e63713c9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_21_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_21_19890223_OpEnact_df129d517c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_21_obligation_0_795332da> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 21" ;
    dzdoc:position 20 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_40> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_40" ;
    dzdoc:fullText "حق إنشاء الجمعيات ذات الطابع السياسي معترف به . ولا يمكن التذرع بهذا الحق لضرب الحريات الأساسية، والوحدة الوطنية، والسلامة الترابية ، واستقلال البلاد ، وسيادة الشعب ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_40_permission_0_74787e0a> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_40_right_0_c1bf59cd> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_40> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_40_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_40_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_40_19890223_OpEnact_394671c97d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "40" ;
    dzdoc:position 39 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_57> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_57" ;
    dzdoc:fullText "لا يعذر بجهل القانون . يجب على كل شخص أن يحترم الدستور وقوانين الجمهورية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_57> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_57_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_57_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_57_19890223_OpEnact_fe06ca5e68> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_57_obligation_0_baafbb6d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 57" ;
    dzdoc:position 56 ;
    dzdoc:usesTerm dzterm:law .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "يجب على كل مواطن أن يحمي ويصون استقلال الوطن، وسيادته، وسلامة ترابه . يعاقب القانون بكل صرامة على الخيانة والتجسس والولاء للعدو، وعلى جميع الجرائم المرتكبة ضد أمن الدولة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_58_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_58_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_58_19890223_OpEnact_f37e88f6a4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_58_obligation_0_72529ad4> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 58" ;
    dzdoc:position 57 ;
    dzdoc:usesTerm dzterm:law .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الخامس_الواجبات> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يمارس كل واحد جميع حرياته، في احترام الحقوق المعترف بها للغير في الدستور ، لا سيما احترام الحق في الشرف ، و ستر الحياة الخاصة ، و حماية الأسرة والشبيبة والطفولة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_60_right_0_7f45fb78>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_60_right_1_ceeefc0a>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_60_right_2_2afbc6e1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_60_right_3_25680bde> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_60_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_60_19890223_OpEnact_f715d3625c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 59 .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري> ;
    dzdoc:eId "chp_الرابع_التعديل_الدستوري_art_164" ;
    dzdoc:fullText "إذا رأى المجلس الدستوري أي تعديل دستوري لا يمس البتة المبادئ العامة التي تحكم المجتمع الجزائري و حقوق الإنسان و المواطن و حرياتهما ، و لا يمس بأي شيء التوازنات الأساسية للسلطات و المؤسسات الدستورية، و علل رأيه أمكن ل رئيس الجمهورية أن يصدر القانون الذي يتضمن التعديل الدستوري مباشرة دون أن يعرضه على الإستفتاء الشعبي، متى أحرز ثلاثة أرباع من أصوات أعضاء المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_right_0_5c125b8e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_الرابع_التعديل_الدستوري_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_chp_______art_164_19890223_OpEnact_529fa6e097> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 166 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_condition_0_0d18d680>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_condition_1_6874c616>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_164_condition_2_73aa32a0> ;
    dzdoc:usesTerm dzterm:apn,
        dzterm:constitutional_council,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "يشرع المجلس الشعبي الوطني في المجالات التي خولها إياه الدستور . ويدخل كذلك في مجال القانون ما يأتي . 1)- حقوق الأشخاص وواجباتهم الأساسية ، لا سيما نظام الحريات العمومية ، و حماية الحريات الفردية ، و واجبات المواطنين ، 2)- القواعد العامة المتعلقة بـ قانون الأحوال الشخصية ، و حق الأسرة ، لا سيما الزواج ، و الطلاق ، والبنوة ، والأهلية ، والتركات ، 3)- شروط استقرار الأشخاص ، 4)- التشريع الأساسي المتعلق بالجنسية ، 5)- القواعد العامة المتعلقة بوضعية الأجانب ، 6)- القواعد المتعلقة بالتنظيم القضائي ، وإنشاء الهيئات القضائية ، 7)- القواعد العامة للقانون الجزائي ، والإجراءات الجزائية ، لا سيما تحديد الجنايات والجنح ، والعقوبات المختلفة المطابقة لها ، والعفو الشامل ، وتسليم المجرمين . 8)- القواعد العامة للإجراءات المدنية وطرق التنفيذ ، 9)- نظام الالتزامات المدنية والتجارية ، 10)- نظام الانتخابات ، 11)- التقسيم الإقليمي للبلاد ، 12)- المصادقة على المخطط الوطني ، 13)- التصويت على ميزانية الدولة ، 14)- إحداث الضرائب و الجبايات والرسوم والحقوق المختلفة، وتحديد أساسها ونسبها 15)- النظام الجمركي ، 16)- نظام البنوك والقروض والتأمينات ، 17)- القواعد العامة المتعلقة بالتعليم ، 18)- القواعد العامة المتعلقة بـ الصحة العمومية ، والسكان ، 19)- القواعد العامة المتعلقة بقانون العمل والضمان الاجتماعي ، 20)- القواعد العامة المتعلقة بالبيئة وإطار المعيشة ، 21)- القواعد العامة المتعلقة بحماية الثروة الحيوانية والنباتية ، 22)- حماية التراث الثقافي والتاريخي ، والمحافظة عليه ، 23)- النظام العام للغابات والأراضي الرعوية ، 24)- النظام العام للمياه ، 25)- النظام العام للمناجم والمحروقات ، 26)- إنشاء أوسمة الدولة ونياشينها وألقابها التشريفية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_115_right_0_95e593b1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_115_right_1_608e6daa>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_115_right_2_faac9992> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_115_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_115_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_115_19890223_OpEnact_8b18ba5ead> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_115_obligation_0_971d5571> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 115" ;
    dzdoc:position 114 ;
    dzdoc:referencesExternal <https://legal.dz/resource/constitution/1989-02-23/1989#art_115_extref_e4fae7b7> ;
    dzdoc:usesTerm dzterm:family_law,
        dzterm:national_peoples_assembly,
        dzterm:personal_status_law,
        dzterm:public_health,
        dzterm:public_liberties .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_146> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_146" ;
    dzdoc:fullText "يقرر المجلس الأعلى للقضاء ، طبقا للشروط التي يحددها القانون ، تعيين القضاة ، ونقلهم ، وسير سلمهم الوظيفي . ويسهر على احترام أحكام القانون الأساسي للقضاء، وعلى رقابة انضباط القضاة تحت رئاسة الرئيس الأول للمحكمة العليا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_146> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_146_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_146_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_146_19890223_OpEnact_adc4c8e12c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_146_obligation_0_1728dc7d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 146" ;
    dzdoc:position 145 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_146_condition_0_86d14ec6> ;
    dzdoc:usesTerm dzterm:judge,
        dzterm:supreme_council_judiciary .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_166> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الثالث_الرقابة_والمؤسسات_الاستشارية_sec_الثاني_المؤسسات_الاستشارية> ;
    dzdoc:eId "art_166" ;
    dzdoc:fullText "يصبح القانون الذي يتضمن مشروع التعديل الدستوري لاغيا، إذا رفضه الشعب و لا يمكن عرضه من جديد على الشعب من خلال نفس الفترة التشريعية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_166_permission_0_ef6c118a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_166> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_166_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_166_19890223_OpEnact_bd09a098fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 166" ;
    dzdoc:position 163 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_166_condition_0_8870ca08> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "الملكية الخاصة مضمونة . حق الإرث مضمون . الأملاك الوقفية وأملاك الجمعيات الخيرية معترف بها . ويحمي القانون تخصيصها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_49_right_0_6421b836>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_49_right_1_51711fef> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_49_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_49_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_49_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_49_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_49_19890223_OpEnact_c8e602bc81> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 49" ;
    dzdoc:position 48 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "لكل المواطنين الحق في العمل . يضمن القانون في أثناء العمل الحق في الحماية ، والأمن ، والنظافة . الحق في الراحة مضمون ، ويحدد القانون كيفيات ممارسته ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_52_right_0_a50ddcac>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_52_right_1_1bfb9e75>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_52_right_2_36fc38c2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_52_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_52_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_52_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_52_19890223_OpEnact_237347fb78> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 52" ;
    dzdoc:position 51 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "الحق في الإضراب معترف به ، ويمارس في إطار القانون . ويمكن أن يمنع القانون ممارسة هذا الحق ، أو يجعل حدودا لممارسته في ميادين الدفاع الوطني والأمن ، أو في جميع الخدمات أو الأعمال العمومية ذات المنفعة الحيوية للمجتمع ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_54_right_0_ec8eef20> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_54> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_54_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_54_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_54_19890223_OpEnact_52f67a27fb> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1989-02-23/1989#art_54_prohibition_0_cab6e52c> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 54" ;
    dzdoc:position 53 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_67> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_67" ;
    dzdoc:fullText "يجسد رئيس الجمهورية ، رئيس الدولة ، وحدة الأمة . وهو حامي الدستور . ويجسد الدولة داخل البلاد وخارجها. له أن يخاطب الأمة مباشرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_67> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_67_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_67_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_67_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_67_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_67_19890223_OpEnact_232171b9cc> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 67" ;
    dzdoc:position 66 ;
    dzdoc:usesTerm dzterm:constitution,
        dzterm:president .

