    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_83> ;
    dznorm:position 1 ;
    dznorm:provisionText "كما لا يجوز أن يفوض سلطته في اللجوء إلى الاستفتاء ، وحل المجلس الشعبي الوطني، وتقرير إجراء الانتخابات التشريعية قبل أو في أوانها، وتطبيق الأحكام المنصوص عليها في المواد من 86 إلى 91 في الدستور، وكذلك السلطات المحددة في الفقرات : 1، 2 ، 3 ، 4 ، 6، 8 ، 10، 11، من المادة 74 ، وأحكام المادتين 117 و 118 من الدستور"@ar ;
    dznorm:sourceArticle "art_83" .

