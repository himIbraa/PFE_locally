    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dznorm:position 2 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_condition_3_40f60d29> a dznorm:Condition ;
    dznorm:conditionText "وإذا اقترنت وفاة رئيس الجمهورية بشغور المجلس الشعبي الوطني بسبب حله"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dznorm:position 3 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_obligation_0_95b331d9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dznorm:position 0 ;
    dznorm:provisionText "يجتمع المجلس الدستوري وجوبا"@ar ;
    dznorm:sourceArticle "art_84" .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_obligation_1_1e970ff4> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dznorm:position 1 ;
    dznorm:provisionText "يجتمع المجلس الدستوري، وجوبا، ويثبت الشغور النهائي لرئاسة الجمهورية"@ar ;
    dznorm:sourceArticle "art_84" .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_obligation_2_ef755168> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dznorm:position 2 ;
    dznorm:provisionText "يجتمع المجلس الدستوري وجوبا لإثبات الشغور النهائي لرئاسة الجمهورية"@ar ;
    dznorm:sourceArticle "art_84" .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 0 ;
    dzdoc:text "إذا استحال على رئيس الجمهورية أن يمارس مهامه بسبب مرض خطيرمزمن ، يجتمع المجلس الدستوري وجوبا ، وبعد أن يتثبت من حقيقة هذا المانع بكل الوسائل الملائمة ، يقترح بالإجماع على المجلس الشعبي الوطني التصريح بثبوت المانع ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 1 ;
    dzdoc:text "يعلن المجلس الشعبي الوطني ثبوت المانع لـ رئيس الجمهورية بأغلبية ثلثي أعضائه ، ويكلف رئيسه بتولي رئاسة الدولة بالنيابة مدة أقصاها خمسة وأربعون يوما، ويمارس صلاحياته مع مراعاة أحكام المادة 85 من الدستور"@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 2 ;
    dzdoc:text "وفي حالة استمرار المانع ، بعد انقضاء خمسة وأربعين يوما ، يعلن الشغور بالاستقالة وجوبا ، حسب الإجراء المنصوص عليه في الفقرتين السابقتين ، وطبقا لأحكام الفقرات الآتية من هذه المادة ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 3 ;
    dzdoc:text "في حالة استقالة رئيس الجمهورية أو وفاته، يجتمع المجلس الدستوري، وجوبا، ويثبت الشغور النهائي لرئاسة الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 4 ;
    dzdoc:text "وتبلغ فورا شهادة الشغور النهائي لـ المجلس الشعبي الوطني الذي يجتمع وجوبا ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 5 ;
    dzdoc:text "يتولى رئيس المجلس الشعبي الوطني مهام رئيس الدولة مدة أقصاها خمسة وأربعون يوما ، تنظم خلالها انتخابات رئاسية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_6> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 6 ;
    dzdoc:text "ولا يحق لرئيس الدولة المعين بهذه الطريقة أن يترشح لرئاسة الجمهورية"@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_7> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 7 ;
    dzdoc:text "يمارس رئيس الجمهورية المنتخب مهامه طبقا لأحكام المواد من 67 إلى 74 من الدستور ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_8> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 8 ;
    dzdoc:text "وإذا اقترنت وفاة رئيس الجمهورية بشغور المجلس الشعبي الوطني بسبب حله، يجتمع المجلس الدستوري وجوبا لإثبات الشغور النهائي لرئاسة الجمهورية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_84_para_9> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_84> ;
    dzdoc:position 9 ;
    dzdoc:text "يضطلع رئيس المجلس الدستوري بمهمة رئيس الدولة في الظروف المبينة في الفقرات السابقة من هذه المادة وفي المادة 85 من الدستور ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_85_obligation_0_1dad9962_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_85_obligation_0_1dad9962> ;
    dznorm:conditionText "إذا ترشح لرئاسة الجمهورية"@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_85> ;
    dzdoc:position 0 ;
    dzdoc:text "لا يمكن أن تقال أو تعدل الحكومة القائمة إبان حصول المانع لـ رئيس الجمهورية ، أو وفاته ، أو استقالته ، حتى يشرع رئيس الجمهورية الجديد في ممارسة مهامه ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_85> ;
    dzdoc:position 1 ;
    dzdoc:text "يستقيل وجوبا رئيس الحكومة القائمة قانونا ، إذا ترشح لرئاسة الجمهورية، ويمارس وظيفة رئيس الحكومة حينئذ أحد أعضائها الذي يعينه رئيس الدولة ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_85> ;
    dzdoc:position 2 ;
    dzdoc:text "لا يمكن في فترتي الخمسة والأربعين يوما، تطبيق الأحكام المنصوص عيها في الفقرتين 8 ، و 9 من المادة 74 ، والمواد 75، 90، 120، 127، و 128 من الدستور ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_85_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#art_85> ;
    dzdoc:position 3 ;
    dzdoc:text "لا يمكن ، خلال الفترتين السابق ذكرهما ، تطبيق أحكام المواد 87، و 88، و 89، و 91 من الدستور، إلا بموافقة المجلس الشعبي الوطني ، بعد استشارة المجلس الدستوري ، و المجلس الأعلى للأمن ."@ar .

