<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_101> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "النائب مسؤول أمام زملائه الذين يمكنهم تجريده من صفته النيابية، إذا اقترف فعلا يخل بشرف وظيفته . يحدد القانون الحالات التي يتعرض فيها النائب للإقصاء . ويقرر المجلس الشعبي الوطني هذا الإقصاء بأغلبية أعضائه، دون المساس بحق المتابعات الأخرى الواردة في القانون ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_101_19890223_OpEnact_20050fd4a5> ;
    dzdoc:replacementText "النائب مسؤول أمام زملائه الذين يمكنهم تجريده من صفته النيابية، إذا اقترف فعلا يخل بشرف وظيفته . يحدد القانون الحالات التي يتعرض فيها النائب للإقصاء . ويقرر المجلس الشعبي الوطني هذا الإقصاء بأغلبية أعضائه، دون المساس بحق المتابعات الأخرى الواردة في القانون ."@ar ;
