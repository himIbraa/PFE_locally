    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_141> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_141> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_141> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "يحمي القانون المتقاضي من أي تعسف أو أي انحراف يصدر من القاضي"@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_142_19890223_OpEnact_d889bedccf> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
