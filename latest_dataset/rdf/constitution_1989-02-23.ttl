<https://legal.dz/resource/constitution/1989-02-23/1989#art_139> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_139" ;
    dzdoc:fullText "القاضي محمي من كل أشكال الضغوط والتدخلات والمناورات التي قد تضر بأداء مهمته أو تمس نزاهة حكمه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_139_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_139_19890223_OpEnact_363ad63ba2> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 139" ;
    dzdoc:position 138 ;
    dzdoc:usesTerm dzterm:judge .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_144> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثالث_السلطة_القضائية> ;
    dzdoc:eId "art_144" ;
    dzdoc:fullText "يحدد القانون تنظيم المحكمة العليا ، وعملها ، واختصاصاتها الأخرى ."@ar ;
