<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_89> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "إذا وقع عدوان فعلي على البلاد ، أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء ، والاستماع إلى المجلس الأعلى للأمن . يجتمع المجلس الشعبي الوطني وجوبا . ويوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_89_19890223_OpEnact_59a39da9b2> ;
    dzdoc:replacementText "إذا وقع عدوان فعلي على البلاد ، أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء ، والاستماع إلى المجلس الأعلى للأمن . يجتمع المجلس الشعبي الوطني وجوبا . ويوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك ."@ar ;
