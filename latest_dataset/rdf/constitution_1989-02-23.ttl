<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_118> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن رئيس الجمهورية أن يطلب من المجلس الشعبي الوطني إجراء مداولة ثانية في قانون تم التصويت عليه ، ويكون هذا الطلب خلال الثلاثين يوما الموالية لتاريخ إقراره . وفي هذه الحالة لا يتم إقرار القانون إلا بأغلبية ثلثي أعضاء المجلس الشعبي الوطني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_118_19890223_OpEnact_5c029926b7> ;
    dzdoc:replacementText "يمكن رئيس الجمهورية أن يطلب من المجلس الشعبي الوطني إجراء مداولة ثانية في قانون تم التصويت عليه ، ويكون هذا الطلب خلال الثلاثين يوما الموالية لتاريخ إقراره . وفي هذه الحالة لا يتم إقرار القانون إلا بأغلبية ثلثي أعضاء المجلس الشعبي الوطني ."@ar ;
