<https://legal.dz/resource/constitution/1989-02-23/1989#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "الحصانة النيابية معترف بها للنائب مدة نيابته . لا يمكن أن يتابع أي نائب أو يوقف ، وعلى العموم ، لا يمكن أن ترفع عليه دعوى مدنية أو جزائية ، أو يسلط عليه أي شكل من أشكال الضغط ، بسبب ما عبر عنه من آراء ، أو ما تلفظ به من كلام ، أو بسبب تصويته خلال ممارسة مهمته النيابية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_103_permission_0_36f04b35> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_103_right_0_034bc48b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_103> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_103_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_103_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_103_19890223_OpEnact_69f89961bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 102 ;
    dzdoc:usesTerm dzterm:immunity .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "تتم الموافقة على ملتمس الرقابة بتصويت أغلبية ثلثي النواب . ولا يتم التصويت إلا بعد ثلاثة أيام من تاريخ إيداع ملتمس الرقابة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_127_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_127_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_127_19890223_OpEnact_0263f89499> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 127" ;
    dzdoc:position 126 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_127_condition_0_8aa2f233>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_127_condition_1_5b36b18e> .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "لا يجوز انتهاك حرمة حياة المواطن الخاصة ، و حرمة شرفه ، ويحميهما القانون . سرية المراسلات والاتصالات الخاصة بكل أشكالها مضمونة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_37_permission_0_ec75e320> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_37_right_0_0a5c0b55>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_37_right_1_4c830850>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_37_right_2_e3b0822f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_37_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_37_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_37_19890223_OpEnact_72963cd89a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/constitution/1989-02-23/1989#art_37_prohibition_0_ec75e320> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 36 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_121> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_121" ;
    dzdoc:fullText "يمكن المجلس الشعبي الوطني أن يفتح مناقشة حول السياسة الخارجية ، بناء على طلب رئيس الجمهورية ، أو رئيس المجلس . يمكن ، عند الاقتضاء ، أن تتوج هذه المناقشة بإصدار لائحة من المجلس الشعبي الوطني ، يبلغها رئيسه إلى رئيس الجمهورية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_121_permission_0_2c607be7>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_121_permission_1_e99e2686> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_121_right_0_6a5d7876> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_121> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_121_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_121_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_121_19890223_OpEnact_2e7da312a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 121" ;
    dzdoc:position 120 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_121_condition_0_97f7daf6> ;
    dzdoc:usesTerm dzterm:national_peoples_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_الثاني_السلطة_التشريعية> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "يمكن أعضاء المجلس الشعبي الوطني استجواب الحكومة في إحدى قضايا الساعة . يمكن لجان المجلس الشعبي الوطني أن تستمع إلى أعضاء الحكومة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_124_permission_0_fb186dae>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_124_permission_1_85c72f6d> ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_124_right_0_e950fbfe>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_124_right_1_0e7e1d3d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_124_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_124_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_124_19890223_OpEnact_f06a52102a> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 124" ;
    dzdoc:position 123 ;
    dzdoc:usesTerm dzterm:national_peoples_assembly .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الأول_المبادئ_العامة_التي_تحكم_المجتمع_الجزائري_sec_الرابع_الحقوق_والحريات> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "الحق في التعليم مضمون . التعليم مجاني حسب الشروط التي يحددها القانون . التعليم الأساسي إجباري . تنظم الدولة المنظومة التعليمية . تسهر الدولة على التساوي في الالتحاق بالتعليم والتكوين المهني ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_right_0_777dfa7e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_para_2>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_para_3>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_para_4> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_50_19890223_OpEnact_c58e97efc7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_obligation_0_ba684010>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_obligation_1_35ad2d16>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_50_obligation_2_de66fc18> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "المادة 50" ;
    dzdoc:position 49 .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "يقرر رئيس الجمهورية ، إذا دعت الضرورة الملحة ، حالة الطوارئ أو الحصار، لمدة معينة بعد اجتماع المجلس الأعلى للأمن ، واستشارة رئيس المجلس الشعبي الوطني ورئيس الحكومة ، ورئيس المجلس الدستوري ، ويتخذ كل التدابير اللازمة لاستتباب الوضع . ولا يمكن تمديد حالة الطوارئ أو الحصار، إلا بموافقة المجلس الشعبي الوطني ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/constitution/1989-02-23/1989#art_86_permission_0_80acf641> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_86_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_86_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_86_19890223_OpEnact_c85cd7c32d> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "86" ;
    dzdoc:position 85 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_86_condition_0_ef2cac40> ;
    dzdoc:usesTerm dzterm:constitutional_council,
        dzterm:high_security_council,
        dzterm:national_assembly,
        dzterm:president .

<https://legal.dz/resource/constitution/1989-02-23/1989#art_89> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_2_sec_1> ;
    dzdoc:eId "art_89" ;
    dzdoc:fullText "إذا وقع عدوان فعلي على البلاد ، أو يوشك أن يقع حسبما نصت عليه الترتيبات الملائمة لميثاق الأمم المتحدة ، يعلن رئيس الجمهورية الحرب، بعد اجتماع مجلس الوزراء ، والاستماع إلى المجلس الأعلى للأمن . يجتمع المجلس الشعبي الوطني وجوبا . ويوجه رئيس الجمهورية خطابا للأمة يعلمها بذلك ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_89> ;
    dzdoc:hasParagraph <https://legal.dz/resource/constitution/1989-02-23/1989#art_89_para_0>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_89_para_1>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_89_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_89_19890223_OpEnact_59a39da9b2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/constitution/1989-02-23/1989#art_89_obligation_0_bba2ea4c>,
        <https://legal.dz/resource/constitution/1989-02-23/1989#art_89_obligation_1_03fff59e> ;
    dzdoc:introducedBy <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:introducedOn "1989-02-23"^^xsd:date ;
    dzdoc:number "89" ;
    dzdoc:position 88 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/constitution/1989-02-23/1989#art_89_condition_0_2333f1d4> ;
    dzdoc:usesTerm dzterm:council_of_ministers,
        dzterm:high_security_council,
        dzterm:national_peoples_assembly,
        dzterm:president .

