<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_8> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يختار الشعب لنفسه مؤسسات ، غايتها ما يأتي : المحافظة على الاستقلال الوطني ، ودعمه ، المحافظة على الهوية ، والوحدة الوطنية ، ودعمهما ، حماية الحريات الأساسية للمواطن ، والازدهار الاجتماعي والثقافي للأمة ، القضاء على استغلال الإنسان للإنسان، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب ، أو الاختلاس ، أو الاستحواذ ، أو المصادرة غير المشروعة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_8_19890223_OpEnact_df842476a3> ;
    dzdoc:replacementText "يختار الشعب لنفسه مؤسسات ، غايتها ما يأتي : المحافظة على الاستقلال الوطني ، ودعمه ، المحافظة على الهوية ، والوحدة الوطنية ، ودعمهما ، حماية الحريات الأساسية للمواطن ، والازدهار الاجتماعي والثقافي للأمة ، القضاء على استغلال الإنسان للإنسان، حماية الاقتصاد الوطني من أي شكل من أشكال التلاعب ، أو الاختلاس ، أو الاستحواذ ، أو المصادرة غير المشروعة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_8> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
