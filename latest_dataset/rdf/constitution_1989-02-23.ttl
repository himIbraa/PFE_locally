<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_54> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الحق في الإضراب معترف به ، ويمارس في إطار القانون . ويمكن أن يمنع القانون ممارسة هذا الحق ، أو يجعل حدودا لممارسته في ميادين الدفاع الوطني والأمن ، أو في جميع الخدمات أو الأعمال العمومية ذات المنفعة الحيوية للمجتمع ."@ar ;
