    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "ينظر القضاء في الطعن في قرارات السلطات العمومية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_135_19890223_OpEnact_699feedbc9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
