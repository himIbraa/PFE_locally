<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163_condition_0_fc4bd50b> a dznorm:Condition ;
    dznorm:conditionText "بعد أن يصوت عليه المجلس الشعبي الوطني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163> ;
    dznorm:position 0 .

<https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/constitution/1989-02-23/1989#chp_الرابع_التعديل_الدستوري_art_163> ;
    dzdoc:position 0 ;
    dzdoc:text "لرئيس الجمهورية حق المبادرة بالتعديل الدستوري، و بعد أن يصوت عليه المجلس الشعبي الوطني، يعرض على إستفتاء الشعب للموافقة عليه ثم يصدره رئيس الجمهورية."@ar .

