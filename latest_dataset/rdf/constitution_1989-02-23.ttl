    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_142> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "الحق في الدفاع معترف به . الحق في الدفاع مضمون في القضايا الجزائية ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_143_19890223_OpEnact_4efaf520fc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_143> ;
    dzdoc:versionOf <https://legal.dz/resource/constitution/1989-02-23/1989#art_143> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_143> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:versionText "تمثل المحكمة العليا ، في جميع مجالات القانون ، الهيئة المقومة لأعمال المجالس القضائية والمحاكم . تضمن المحكمة العليا توحيد الاجتهاد القضائي في جميع أنحاء البلاد ، وتسهر على احترام القانون ."@ar .

<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_144_19890223_OpEnact_38e42a0327> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "1989-02-23"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
