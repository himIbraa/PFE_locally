<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_72> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة ، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فور أدائه اليمين ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_72_19890223_OpEnact_56361ebaa4> ;
    dzdoc:replacementText "يؤدي رئيس الجمهورية اليمين أمام الشعب بحضور جميع الهيئات العليا في الأمة ، خلال الأسبوع الموالي لانتخابه . ويباشر مهمته فور أدائه اليمين ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_72> ;
    dzdoc:sourceDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:targetArticle <https://legal.dz/resource/constitution/1989-02-23/1989#art_72> ;
    dzdoc:targetDocument <https://legal.dz/resource/constitution/1989-02-23/1989> ;
