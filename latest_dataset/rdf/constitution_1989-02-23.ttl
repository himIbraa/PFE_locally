<https://legal.dz/resource/constitution/1989-02-23/1989#version_art_105> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/constitution/1989-02-23/1989> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة تلبس أحد النواب بجنحة أو جناية ، يمكن توقيفه ، ويخطر مكتب المجلس الشعبي الوطني فورا . يمكن مكتب المجلس الشعبي الوطني أن يطلب إيقاف المتابعة وإطلاق سراح النائب ، على أن يعمل فيما بعد بأحكام المادة 104 أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/constitution/1989-02-23/1989#version_art_105_19890223_OpEnact_c4d1ca8c0d> ;
