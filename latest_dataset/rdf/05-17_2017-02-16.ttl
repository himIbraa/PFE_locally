    dzdoc:evidenceText "تدرج ضمن أحكام القانون رقم 1401 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمذكور أعلاه، مادة 92 مكرر تحرر كما يأتي: \" المادة 92 مكرر : عندما يرتكب حائز رخصة السياقة الأجنبية أية مخالفة منصوص عليها في"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
