<https://legal.dz/resource/law/2017-02-16/05-17#version_art_16> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلتزم صاحب المركبة باتخاذ كل الاحتياطات حتى لا تتسبب حمولة سيارة أو مقطورة في إلحاق الضرر بالغير وبالطريق العام وبتجهيزاته أو ملحقاته أو تشكل خطرا عليهم . تتم كل حمولة على مركبات نقل البضائع، أيا كان المنتوج المنقول، وفقا للشروط المحددة عن طريق التنظيم. تتم مراقبة حمولة المركبات، ووزنها على مستوى محطات الوزن ، بواسطة تجهيزات وأدوات قياس معتمدة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2017-02-16/05-17#version_art_16_20170216_OpEnact_862e1fbbbf> ;
    dzdoc:replacementText "يلتزم صاحب المركبة باتخاذ كل الاحتياطات حتى لا تتسبب حمولة سيارة أو مقطورة في إلحاق الضرر بالغير وبالطريق العام وبتجهيزاته أو ملحقاته أو تشكل خطرا عليهم . تتم كل حمولة على مركبات نقل البضائع، أيا كان المنتوج المنقول، وفقا للشروط المحددة عن طريق التنظيم. تتم مراقبة حمولة المركبات، ووزنها على مستوى محطات الوزن ، بواسطة تجهيزات وأدوات قياس معتمدة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_16> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_16> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2017-02-16"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2017-02-16/05-17#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تلغى الأحكام المخالفة لهذا القانون، لا سيما المادتان 83 و 137 من القانون رقم14-01 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها المعدل والمتمم . كما تلغى المادة 10 مكرر من القانون رقم 04-16 المؤرخ في 27 رمضان عام 1425 الموافق 10 نوفمبر سنة 2004 ، المعدل والمتمم للقانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها المعدل والمتمم ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2017-02-16/05-17#version_art_17_20170216_OpEnact_a31bd3e465> ;
    dzdoc:replacementText "تلغى الأحكام المخالفة لهذا القانون، لا سيما المادتان 83 و 137 من القانون رقم14-01 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها المعدل والمتمم . كما تلغى المادة 10 مكرر من القانون رقم 04-16 المؤرخ في 27 رمضان عام 1425 الموافق 10 نوفمبر سنة 2004 ، المعدل والمتمم للقانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها المعدل والمتمم ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
