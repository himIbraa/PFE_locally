    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_13> .

<https://legal.dz/resource/law/2017-02-16/05-17#art_13_obligation_1_c374adf7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_13> ;
    dznorm:position 1 ;
    dznorm:provisionText "يرسل محضر عدم الدفع إلى وكيل الجمهورية"@ar ;
    dznorm:sourceArticle "art_13" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_13_obligation_2_1ba24e50> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2017-02-16/05-17#art_13_obligation_2_1ba24e50_period_176c73b853> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_13> ;
