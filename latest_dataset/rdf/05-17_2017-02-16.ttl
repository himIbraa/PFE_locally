<https://legal.dz/resource/law/2017-02-16/05-17#art_14> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#sec_4_subsec_الأول_من_هذا_الفصل_يتم_الاحتفاظ_بها_إلى_غاية_تسديد_الغرامة_الجزافية_> ;
    dzdoc:eId "art_14" ;
    dzdoc:fullText "تدرج ضمن أحكام القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمذكور أعلاه، مادة 98 مكرر تحرر كما يأتي: \" المادة 98 مكرر : في حالة تعليق رخصة السياقة أو إلغائها بموجب حكم قضائي ، يتعين على المعني إعادة رخصة سياقته إلى المصالح المؤهلة التابعة للوزارة المكلفة بالداخلية .\""@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2017-02-16/05-17#version_art_14> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2017-02-16/05-17#art_14_para_0>,
        <https://legal.dz/resource/law/2017-02-16/05-17#art_14_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2017-02-16/05-17#version_art_14_20170216_OpEnact_b09c2e44a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2017-02-16/05-17#art_14_obligation_0_18d843bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:introducedOn "2017-02-16"^^xsd:date ;
    dzdoc:number "المادة 14" ;
    dzdoc:position 13 ;
    dzdoc:references <https://legal.dz/resource/law/2017-02-16/05-17#art_98_bis> ;
