    dzdoc:position 0 ;
    dzdoc:text "تدرج ضمن أحكام القانون رقم 1401 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمذكور أعلاه، مادة 92 مكرر تحرر كما يأتي:"@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_12_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_12> ;
    dzdoc:position 1 ;
    dzdoc:text "\"المادة 92 مكرر: عندما يرتكب حائز رخصة السياقة الأجنبية أية مخالفة منصوص عليها في"@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_13_condition_0_f36a4fdc> a dznorm:Condition ;
    dznorm:conditionText "في حالة المخالفات المذكورة في القسم الأول من هذا الفصل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_13> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2017-02-16/05-17#art_13_condition_1_a5db1516> a dznorm:Condition ;
    dznorm:conditionText "ومع انقضاء هذا الأجل وفي حالة عدم دفع الغرامة الجزافية"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_13> ;
