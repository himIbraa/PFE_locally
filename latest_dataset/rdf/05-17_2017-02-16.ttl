    dznorm:sourceArticle "art_5" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_obligation_2_b98fa6f7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dznorm:position 2 ;
    dznorm:provisionText "تكلف بتنفيذ السياسة الوطنية للوقاية والأمن في الطرق من الناحية العملية"@ar ;
    dznorm:sourceArticle "art_5" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:position 0 ;
    dzdoc:text "تدرج ضمن أحكام القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 و المذكور أعلاه مادتان 63 مكرر و 63 مكرر 1 تحرران كما يأتي:"@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:position 1 ;
    dzdoc:text """" 
            المادة 63 مكرر
            
            
            يحدث مجلس تشاوري ما بين القطاعات يوضع لدى الوزير الأول، يكلف بتحديد السياسة والاستراتيجية الوطنية للوقاية والأمن في الطرق والتنسيق المؤسساتي بين كافة الفاعلين المعنيين.
            
            
            تحدد طبيعة هذا المجلس ومهامه وعمله وتنظيمه عن طريق التنظيم ". يحدث مجلس تشاوري ما بين القطاعات يوضع لدى الوزير الأول، يكلف بتحديد السياسة والاستراتيجية الوطنية للوقاية والأمن في الطرق والتنسيق المؤسساتي بين كافة الفاعلين المعنيين. تحدد طبيعة هذا المجلس ومهامه وعمله وتنظيمه عن طريق التنظيم "."""@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:position 2 ;
    dzdoc:text "يحدث مجلس تشاوري ما بين القطاعات يوضع لدى الوزير الأول، يكلف بتحديد السياسة والاستراتيجية الوطنية للوقاية والأمن في الطرق والتنسيق المؤسساتي بين كافة الفاعلين المعنيين."@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:position 3 ;
    dzdoc:text "تحدد طبيعة هذا المجلس ومهامه وعمله وتنظيمه عن طريق التنظيم \"."@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:position 4 ;
    dzdoc:text """" 
            المادة 63 مكرر 1
            
            
            تنشأ مندوبية وطنية للأمن في الطرق تابعة للوزارة المكلفة بالداخلية.
            
            
            تكلف بتنفيذ السياسة الوطنية للوقاية والأمن في الطرق من الناحية العملية.
            
            
            تحدد طبيعة هذه المندوبية ومهامها وعملها وتنظيمها عن طريق التنظيم". تنشأ مندوبية وطنية للأمن في الطرق تابعة للوزارة المكلفة بالداخلية. تكلف بتنفيذ السياسة الوطنية للوقاية والأمن في الطرق من الناحية العملية. تحدد طبيعة هذه المندوبية ومهامها وعملها وتنظيمها عن طريق التنظيم"."""@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_para_5> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:position 5 ;
    dzdoc:text "تنشأ مندوبية وطنية للأمن في الطرق تابعة للوزارة المكلفة بالداخلية."@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_5_para_6> a dzdoc:Paragraph ;
