<https://legal.dz/resource/law/2017-02-16/05-17#art_13_condition_2_c413fb03> a dznorm:Condition ;
    dznorm:conditionText "في حالة ارتكاب السائق حائز رخصة السياقة إحدى الجنح المنصوص عليها في القسم الثاني من هذا الفصل"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_13> ;
    dznorm:position 2 .

<https://legal.dz/resource/law/2017-02-16/05-17#art_13_condition_3_e8e20d41> a dznorm:Condition ;
    dzdoc:hasRole <https://legal.dz/resource/law/2017-02-16/05-17#art_13_condition_3_e8e20d41_role_71e7bcd413> ;
