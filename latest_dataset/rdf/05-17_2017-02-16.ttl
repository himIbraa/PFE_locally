<https://legal.dz/resource/law/2017-02-16/05-17#art_11_obligation_0_806f4259> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_11> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من ستة (6) أشهر إلى سنة(1) وبغرامة من 20.000 دج إلى 50.000دج، كل شخص يقود مركبة دون أن يكون حائزا لرخصة سياقة صالحة لصنف المركبة المعنية"@ar ;
    dznorm:sourceArticle "art_11" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_11_obligation_1_24b388f6> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2017-02-16/05-17#art_11_obligation_1_24b388f6_role_0ad1f8d8a9> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_11> ;
    dznorm:position 1 ;
    dznorm:provisionText "يعاقب بغرامة من 50.000 دج إلى 150.000 دج ، كل شخص لا يمتثل للقواعد الخاصة بتنظيم السباقات على المسلك العمومي"@ar ;
    dznorm:sourceArticle "art_11" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_11_obligation_1_24b388f6_role_0ad1f8d8a9> a dznorm:Role ;
    rdfs:label "المسلك العمومي"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يعاقب بغرامة من 50.000 دج إلى 150.000 دج ، كل شخص لا يمتثل للقواعد الخاصة بتنظيم السباقات على المسلك العمومي"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_11> .

<https://legal.dz/resource/law/2017-02-16/05-17#art_11_obligation_2_6877653e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_11> ;
    dznorm:position 2 ;
    dznorm:provisionText "يعاقب بغرامة من 50.000 دج إلى 150.000 دج، كل شخص يشارك في سباق المركبات ذات محرك غير المرخص لها في المسللك العمومي"@ar ;
    dznorm:sourceArticle "art_11" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_11_obligation_3_d1aaa2ea> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
