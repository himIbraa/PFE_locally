<https://legal.dz/resource/law/2017-02-16/05-17#preamble_segment_2> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#preamble> ;
    dzdoc:position 2 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 90-30 المؤرخ في 14 جمادى الأولى عام 1411 الموافق أول ديسمبر سنة 1990 والمتضمن قانون الأملاك الوطنية، المعدل والمتمم،"@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#preamble_segment_3> a dzdoc:Citation,
        dzdoc:PreambleSegment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#preamble> ;
    dzdoc:position 3 ;
    dzdoc:segmentType "citation" ;
    dzdoc:text "وبمقتضى القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها المعدل والمتمم،"@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#version_art_1> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يهدف هذا القانون إلى تعديل وتتميم القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها المعدل والمتمم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2017-02-16/05-17#version_art_1_20170216_OpEnact_859f1b7567> ;
    dzdoc:replacementText "يهدف هذا القانون إلى تعديل وتتميم القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمتعلق بتنظيم حركة المرور عبر الطرق وسلامتها وأمنها المعدل والمتمم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_1> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_1> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2017-02-16"^^xsd:date ;
