<https://legal.dz/resource/law/2017-02-16/05-17#version_art_15> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تعدل وتتمم أحكام المواد 99 و 108 و 134 من القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمذكور أعلاه، وتحرر كما يأتي: \" المادة 99 : في حالة ارتكاب صاحب رخصة السياقة المخالفات المدرجة ضمن القسم الثاني من هذا الفصل التي تتم معاينتها قانونا خلال الفترة الاختبارية ، تصدر الجهة القضائية المختصة قرار إلغاء رخصة السياقة بالإضافة إلى العقوبات الجزائية . وفي هذه الحالة، لا يمكن لهذا الأخير طلب الحصول على رخصة سياقة جديدة خلال أجل مدته ثمانية عشر (18) شهرا، ابتداء من تاريخ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2017-02-16/05-17#version_art_15_20170216_OpEnact_daaaa886e5> ;
    dzdoc:replacementText "تعدل وتتمم أحكام المواد 99 و 108 و 134 من القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 والمذكور أعلاه، وتحرر كما يأتي: \" المادة 99 : في حالة ارتكاب صاحب رخصة السياقة المخالفات المدرجة ضمن القسم الثاني من هذا الفصل التي تتم معاينتها قانونا خلال الفترة الاختبارية ، تصدر الجهة القضائية المختصة قرار إلغاء رخصة السياقة بالإضافة إلى العقوبات الجزائية . وفي هذه الحالة، لا يمكن لهذا الأخير طلب الحصول على رخصة سياقة جديدة خلال أجل مدته ثمانية عشر (18) شهرا، ابتداء من تاريخ صدور قرار الإلغاء \"."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_15> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_15> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
