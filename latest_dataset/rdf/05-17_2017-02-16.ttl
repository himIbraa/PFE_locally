    dzdoc:position 1 ;
    dzdoc:text "حرر بالجزائر في 19 جمادى الأولى عام 1438 الموافق 16 فبراير سنة 2017."@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_18_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_18> ;
