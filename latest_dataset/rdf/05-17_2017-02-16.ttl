<https://legal.dz/resource/law/2017-02-16/05-17#art_10_obligation_0_7963ecd9_condition_0> a dznorm:Condition ;
    dznorm:conditionOf <https://legal.dz/resource/law/2017-02-16/05-17#art_10_obligation_0_7963ecd9> ;
    dznorm:conditionText "عقب عدم احترام التدابير القانونية المتعلقة بمدة السياقة، ومدة الراحة، التي تسببت في حادث مرور نجم عنه جنحة الجرح الخطأ"@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_10_obligation_0_7963ecd9_role_0a27130f8a> a dznorm:Role ;
    rdfs:label "أكثر من تسعة (9)"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "يعاقب بالحبس من ستة (6) أشهر إلى سنتين (2) ، وبغرامة من 20.000 دج إلى 50.000 دج، كل سائق مركبة نقل البضائع التي يتجاوز وزنها الإجمالي المرخص به مع الحمولة، أو وزنها الإجمالي السائر المرخص به 3.500 كلغ أو مركبة نقل الأشخاص التي تشتمل على أكثر من تسعة (9) مقاعد بما في ذلك مقعد السائق، وذلك عقب عدم احترام التدابير القانونية المتعلقة بمدة السياقة، ومدة الراحة، التي تسببت في حادث مرور نجم عنه جنحة الجرح الخطأ"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_10> .

<https://legal.dz/resource/law/2017-02-16/05-17#art_10_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_10> ;
    dzdoc:position 0 ;
    dzdoc:text "تدرج ضمن أحكام القانون رقم 1401 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 و المذكور أعلاه مادة 71 مكرر تحرر كما يأتي:"@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_10_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_10> ;
    dzdoc:position 1 ;
    dzdoc:text "\" المادة 71 مكرر : يعاقب بالحبس من ستة (6) أشهر إلى سنتين (2) ، وبغرامة من 20.000 دج إلى 50.000 دج، كل سائق مركبة نقل البضائع التي يتجاوز وزنها الإجمالي المرخص به مع الحمولة، أو وزنها الإجمالي السائر المرخص به 3.500 كلغ أو مركبة نقل الأشخاص التي تشتمل على أكثر من تسعة (9) مقاعد بما في ذلك مقعد السائق، وذلك عقب عدم احترام التدابير القانونية المتعلقة بمدة السياقة، ومدة الراحة، التي تسببت في حادث مرور نجم عنه جنحة الجرح الخطأ \"."@ar .

