<https://legal.dz/resource/law/2017-02-16/05-17#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#sec_4_subsec_الأول_من_هذا_الفصل_يتم_الاحتفاظ_بها_إلى_غاية_تسديد_الغرامة_الجزافية_> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية . حرر بالجزائر في 19 جمادى الأولى عام 1438 الموافق 16 فبراير سنة 2017. عبد العزيز بوتفليقة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2017-02-16/05-17#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2017-02-16/05-17#art_18_para_0>,
        <https://legal.dz/resource/law/2017-02-16/05-17#art_18_para_1>,
        <https://legal.dz/resource/law/2017-02-16/05-17#art_18_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
