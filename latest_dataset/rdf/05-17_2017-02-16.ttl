<https://legal.dz/resource/law/2017-02-16/05-17#art_108_obligation_0_de1f5612> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2017-02-16/05-17#art_108_obligation_0_de1f5612_ref_4c294b9d515b> ;
    dzdoc:references <https://legal.dz/resource/law/2017-02-16/05-17#art_107> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2017-02-16/05-17#art_107> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_108> ;
    dznorm:position 0 ;
    dznorm:provisionText "تسلم المركبات المهجورة وفقا للشروط المنصوص عليها في المادة 107 أعلاه، أو المصرح بها كذلك بموجب حكم قضائي، إلى مصلحة الأملاك الوطنية قصد التصرف فيها"@ar ;
    dznorm:sourceArticle "art_108" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_108_obligation_0_de1f5612_ref_4c294b9d515b> a dzdoc:Reference ;
    rdfs:label "المادة 107"@ar ;
    dzdoc:frbrUri "#art_107"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2017-02-16/05-17#art_107> ;
    dzdoc:sourceEId "art_108" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "تسلم المركبات المهجورة وفقا للشروط المنصوص عليها في المادة 107 أعلاه، أو المصرح بها كذلك بموجب حكم قضائي، إلى مصلحة الأملاك الوطنية قصد التصرف فيها"@ar ;
    dzdoc:targetEId "art_107" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_108_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_108> ;
    dzdoc:position 0 ;
    dzdoc:text "تسلم المركبات المهجورة وفقا للشروط المنصوص عليها في المادة 107 أعلاه، أو المصرح بها كذلك بموجب حكم قضائي، إلى مصلحة الأملاك الوطنية قصد التصرف فيها."@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_108_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_108> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد شروط وكيفيات تطبيق هذه المادة عن طريق التنظيم \""@ar .

<https://legal.dz/resource/law/2017-02-16/05-17#art_108_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_108> ;
    dzdoc:position 2 ;
    dzdoc:text "\" المادة 134 : يختص مفتشو النقل البري بمعاينة المخالفات من الدرجة الرابعة، المطتان 11 و 13، والمخالفة من الدرجة الثالثة - المطة 12 من المادة 66 أعلاه، وإعداد محضر بذلك\"."@ar .

