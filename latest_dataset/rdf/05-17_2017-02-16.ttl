    dznorm:provisionText "يقوم العون الذي عاين المخالفة بإرسال محضر المخالفة المرتكبة مرفقا برخصة السياقة، حسب الحالة، إلى وكيل الجمهورية في أجل أقصاه اثنتان وسبعون (72) ساعة"@ar ;
    dznorm:sourceArticle "art_13" .

<https://legal.dz/resource/law/2017-02-16/05-17#art_13_obligation_2_1ba24e50_period_176c73b853> a dznorm:Period ;
    rdfs:label "في أجل أقصاه اثنتان وسبعون (72) ساعة"@ar ;
