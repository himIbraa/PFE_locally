<https://legal.dz/resource/law/2017-02-16/05-17#version_art_12> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:confidenceScore 1.0 ;
