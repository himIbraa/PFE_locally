<https://legal.dz/resource/law/2017-02-16/05-17#art_16_obligation_0_e09c0756> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
