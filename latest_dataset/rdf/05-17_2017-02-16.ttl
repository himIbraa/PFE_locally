<https://legal.dz/resource/law/2017-02-16/05-17#version_art_5> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تدرج ضمن أحكام القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 و المذكور أعلاه مادتان 63 مكرر و 63 مكرر 1 تحرران كما يأتي: \" المادة 63 مكرر يحدث مجلس تشاوري ما بين القطاعات يوضع لدى الوزير الأول ، يكلف بتحديد السياسة والاستراتيجية الوطنية للوقاية والأمن في الطرق والتنسيق المؤسساتي بين كافة الفاعلين المعنيين . تحدد طبيعة هذا المجلس ومهامه وعمله وتنظيمه عن طريق التنظيم \". \" المادة 63 مكرر 1 تنشأ مندوبية وطنية للأمن في الطرق تابعة للوزارة المكلفة بالداخلية . تكلف بتنفيذ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2017-02-16/05-17#version_art_5_20170216_OpEnact_f7da82e576> ;
    dzdoc:replacementText "تدرج ضمن أحكام القانون رقم 01-14_2001-08-19 المؤرخ في 29 جمادى الأولى عام 1422 الموافق 19 غشت سنة 2001 و المذكور أعلاه مادتان 63 مكرر و 63 مكرر 1 تحرران كما يأتي: \" المادة 63 مكرر يحدث مجلس تشاوري ما بين القطاعات يوضع لدى الوزير الأول ، يكلف بتحديد السياسة والاستراتيجية الوطنية للوقاية والأمن في الطرق والتنسيق المؤسساتي بين كافة الفاعلين المعنيين . تحدد طبيعة هذا المجلس ومهامه وعمله وتنظيمه عن طريق التنظيم \". \" المادة 63 مكرر 1 تنشأ مندوبية وطنية للأمن في الطرق تابعة للوزارة المكلفة بالداخلية . تكلف بتنفيذ السياسة الوطنية للوقاية والأمن في الطرق من الناحية العملية . تحدد طبيعة هذه المندوبية ومهامها وعملها وتنظيمها عن طريق التنظيم\"."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2017-02-16/05-17#art_5> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2017-02-16/05-17> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2017-02-16"^^xsd:date ;
