<https://legal.dz/resource/law/2017-02-16/05-17#art_10_obligation_0_7963ecd9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2017-02-16/05-17#art_10_obligation_0_7963ecd9_role_0a27130f8a> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2017-02-16/05-17#art_10> ;
    dznorm:hasCondition <https://legal.dz/resource/law/2017-02-16/05-17#art_10_obligation_0_7963ecd9_condition_0> ;
    dznorm:position 0 ;
    dznorm:provisionText "يعاقب بالحبس من ستة (6) أشهر إلى سنتين (2) ، وبغرامة من 20.000 دج إلى 50.000 دج، كل سائق مركبة نقل البضائع التي يتجاوز وزنها الإجمالي المرخص به مع الحمولة، أو وزنها الإجمالي السائر المرخص به 3.500 كلغ أو مركبة نقل الأشخاص التي تشتمل على أكثر من تسعة (9) مقاعد بما في ذلك مقعد السائق، وذلك عقب عدم احترام التدابير القانونية المتعلقة بمدة السياقة، ومدة الراحة، التي تسببت في حادث مرور نجم عنه جنحة الجرح الخطأ"@ar ;
    dznorm:sourceArticle "art_10" .

