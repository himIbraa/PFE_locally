    dzdoc:hasVersion <https://legal.dz/resource/law/2017-02-16/05-17#version_art_10_20170216_OpEnact_8c2bdfd616> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2017-02-16/05-17#art_10_obligation_0_7963ecd9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2017-02-16/05-17> ;
