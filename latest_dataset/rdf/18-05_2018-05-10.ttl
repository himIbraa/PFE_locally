<https://legal.dz/resource/law/2018-05-10/18-05#version_art_47> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تبلغ المصالح التابعة لإدارة التجارة المورد الإلكتروني المخالف خلال مدة لا تتجاوز سبعة (7) أيام ابتداء من تاريخ تحرير المحضر، الأمر بالدفع عن طريق جميع الوسائل المناسبة مصحوبا بإشعار بالاستلام ، يتضمن هوية المورد الإلكتروني، عنوان بريده الإلكتروني، وتاريخ وسبب المخالفة، ومراجع النصوص المطبقة ومبلغ الغرامة المفروضة بالإضافة إلى مواعيد وكيفيات الدفع. إذا لم يتم دفع الغرامة أو لم يمتثل المخالف للأحكام التشريعية والتنظيمية المعمول بها في أجل خمسة وأربعين (45) يوما ، يرسل المحضر إلى الجهة القضائية الم"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
