<https://legal.dz/resource/law/2018-05-10/18-05#version_art_36> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "زيادة على ضباط وأعوان الشرطة القضائية المنصوص عليهم بموجب قانون الإجراءات الجزائية ، يؤهل لمعاينة مخالفات أحكام هذا القانون، الأعوان المنتمون للأسلاك الخاصة بالرقابة التابعون للإدارات المكلفة بالتجارة. تتم كيفيات الرقابة ومعاينة المخالفات المنصوص عليها في هذا القانون حسب نفس الأشكال المحددة في التشريع والتنظيم المعمول بهما، لا سيما تلك المطبقة على الممارسات التجارية وعلى شروط ممارسة الأنشطة التجارية وعلى حماية المستهلك وقمع الغش. يجب على المورد الإلكتروني السماح للأعوان المؤهلين لمعاينة المخالفا"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_36_20180510_OpEnact_e1ee419cd9> ;
    dzdoc:replacementText "زيادة على ضباط وأعوان الشرطة القضائية المنصوص عليهم بموجب قانون الإجراءات الجزائية ، يؤهل لمعاينة مخالفات أحكام هذا القانون، الأعوان المنتمون للأسلاك الخاصة بالرقابة التابعون للإدارات المكلفة بالتجارة. تتم كيفيات الرقابة ومعاينة المخالفات المنصوص عليها في هذا القانون حسب نفس الأشكال المحددة في التشريع والتنظيم المعمول بهما، لا سيما تلك المطبقة على الممارسات التجارية وعلى شروط ممارسة الأنشطة التجارية وعلى حماية المستهلك وقمع الغش. يجب على المورد الإلكتروني السماح للأعوان المؤهلين لمعاينة المخالفات بالولوج بحرية إلى تواريخ المعاملات التجارية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_36> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_36> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-05-10"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-05-10/18-05#version_art_37> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون المساس بتطبيق العقوبات الأشد المنصوص عليها في التشريع المعمول به ، يعاقب بغرامة من 200.000 دج إلى 1.000.000 دج كل من يعرض للبيع، أو يبيع عن طريق الاتصال الإلكتروني، المنتجات أو الخدمات المذكورة في المادة 3 من هذا القانون . يمكن القاضي أن يأمر بغلق الموقع الإلكتروني لمدة تتراوح من شهر (1) إلى ستة (6) أشهر."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_37_20180510_OpEnact_0cd5c77832> ;
