    dzdoc:targetDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-05-10"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-05-10/18-05#version_art_30> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دون المساس بالأحكام التشريعية والتنظيمية المعمول بها في هذا المجال، كل إشهار أو ترويج أو رسالة ذات طبيعة أو هدف تجاري تتم عن طريق الاتصالات الإلكترونية يجب أن يلبي المقتضيات الآتية : أن تكون محددة بوضوح كرسالة تجارية أو إشهارية، أن تسمح بتحديد الشخص الذي تم تصميم الرسالة لحسابه، ألا تمس بالآداب العامة والنظام العام. أن تحدد بوضوح ما إذا كان هذا العرض التجاري يشمل تخفيضا أو مكافآت أو هدايا، في حالة ما إذا كان هذا العرض تجاريا أو تنافسيا أو ترويجيا، التأكد من أن جميع الشروط الواجب استيفاؤها للاستف"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_30_20180510_OpEnact_0fcf9b62c5> ;
    dzdoc:replacementText "دون المساس بالأحكام التشريعية والتنظيمية المعمول بها في هذا المجال، كل إشهار أو ترويج أو رسالة ذات طبيعة أو هدف تجاري تتم عن طريق الاتصالات الإلكترونية يجب أن يلبي المقتضيات الآتية : أن تكون محددة بوضوح كرسالة تجارية أو إشهارية، أن تسمح بتحديد الشخص الذي تم تصميم الرسالة لحسابه، ألا تمس بالآداب العامة والنظام العام. أن تحدد بوضوح ما إذا كان هذا العرض التجاري يشمل تخفيضا أو مكافآت أو هدايا، في حالة ما إذا كان هذا العرض تجاريا أو تنافسيا أو ترويجيا، التأكد من أن جميع الشروط الواجب استيفاؤها للاستفادة من العرض التجاري، ليست مضللة ولا غامضة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_30> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_30> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-05-10"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-05-10/18-05#version_art_32> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المورد الإلكتروني أن يضع منظومة إلكترونية يسمح من خلالها لكل شخص بالتعبير عن رغبته في عدم تلقي أي إشهار منه عن طريق الاتصالات الإلكترونية، دون مصاريف أو مبررات . و في هذه الحالة، يلزم المورد الإلكتروني بما يأتي : تسليم وصل استلام عن طريق الاتصالات الإلكترونية يؤكد من خلاله للشخص المعني تسجيل طلبه، اتخاذ التدابير اللازمة لتلبية رغبته في غضون 24 ساعة،"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_32_20180510_OpEnact_d7811d031e> ;
    dzdoc:replacementText "يجب على المورد الإلكتروني أن يضع منظومة إلكترونية يسمح من خلالها لكل شخص بالتعبير عن رغبته في عدم تلقي أي إشهار منه عن طريق الاتصالات الإلكترونية، دون مصاريف أو مبررات . و في هذه الحالة، يلزم المورد الإلكتروني بما يأتي : تسليم وصل استلام عن طريق الاتصالات الإلكترونية يؤكد من خلاله للشخص المعني تسجيل طلبه، اتخاذ التدابير اللازمة لتلبية رغبته في غضون 24 ساعة،"@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_32> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
