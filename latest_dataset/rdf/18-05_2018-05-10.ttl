<https://legal.dz/resource/law/2018-05-10/18-05#version_art_21> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "عندما يسلم المورد الإلكتروني منتوجا أو خدمة لم يتم طلبها من طرف المستهلك الإلكتروني ، لا يمكنه المطالبة بدفع الثمن أو مصاريف التسليم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_21_20180510_OpEnact_9b1801a31d> ;
