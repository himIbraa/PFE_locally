<https://legal.dz/resource/law/2018-05-10/18-05#version_art_10> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن تكون كل معاملة تجارية إلكترونية مسبوقة ب عرض تجاري إلكتروني وأن توثق بموجب عقد إلكتروني يصادق عليه المستهلك الإلكتروني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_10_20180510_OpEnact_13e997a981> ;
    dzdoc:replacementText "يجب أن تكون كل معاملة تجارية إلكترونية مسبوقة ب عرض تجاري إلكتروني وأن توثق بموجب عقد إلكتروني يصادق عليه المستهلك الإلكتروني ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_10> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
