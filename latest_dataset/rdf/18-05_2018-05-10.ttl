<https://legal.dz/resource/law/2018-05-10/18-05#version_art_9> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ بطاقية وطنية للموردين الإلكترونيين لدى المركز الوطني للسجل التجاري ، تضم الموردين الإلكترونيين المسجلين في السجل التجاري ، أو سجل الصناعات التقليدية والحرفية . لا يمكن ممارسة نشاط التجارة الإلكترونية إلا بعد إيداع اسم النطاق لدى مصالح المركز الوطني للسجل التجاري . تنشر البطاقية الوطنية للموردين الإلكترونيين عن طريق الاتصالات الإلكترونية وتكون في متناول المستهلك الإلكتروني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_9_20180510_OpEnact_943e365275> ;
    dzdoc:replacementText "تنشأ بطاقية وطنية للموردين الإلكترونيين لدى المركز الوطني للسجل التجاري ، تضم الموردين الإلكترونيين المسجلين في السجل التجاري ، أو سجل الصناعات التقليدية والحرفية . لا يمكن ممارسة نشاط التجارة الإلكترونية إلا بعد إيداع اسم النطاق لدى مصالح المركز الوطني للسجل التجاري . تنشر البطاقية الوطنية للموردين الإلكترونيين عن طريق الاتصالات الإلكترونية وتكون في متناول المستهلك الإلكتروني ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_9> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_9> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-05-10"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

