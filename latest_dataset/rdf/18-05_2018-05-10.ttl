    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-05-10"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-05-10/18-05#version_art_14> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "حالة في عدم احترام أحكام المادة 10 أو أحكام المادة 13 أعلاه، من طرف المورد الإلكتروني ، يمكن المستهلك الالكتروني أن يطلب إبطال العقد والتعويض عن الضرر الذي لحق به ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_14_20180510_OpEnact_9fd453a468> ;
