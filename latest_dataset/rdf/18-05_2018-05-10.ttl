        dzdoc:LegalTerm ;
    skos:prefLabel "التجارة الإلكترونية"@ar,
        "التجارة الإلكترونية : النشاط الذي يقوم بموجبه مورد إلكتروني باقتراح أو ضمان توفير سلع وخدمات عن بعد لمستهلك إلكتروني، عن طريق الاتصالات الإلكترونية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_7294cdaea7b3> .

