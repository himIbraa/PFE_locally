<https://legal.dz/resource/law/2018-05-10/18-05#version_art_17> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المورد الإلكتروني أن يطلب من المستهلك الإلكتروني توقيع وصل استلام عند التسليم الفعلي للمنتوج أو تأدية الخدمة موضوع العقد الإلكتروني . لا يمكن المستهلك الإلكتروني أن يرفض توقيع وصل الاستلام . تسلم نسخة من وصل الاستلام وجوبا للمستهلك الإلكتروني ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_17_20180510_OpEnact_9d021410a6> ;
    dzdoc:replacementText "يجب على المورد الإلكتروني أن يطلب من المستهلك الإلكتروني توقيع وصل استلام عند التسليم الفعلي للمنتوج أو تأدية الخدمة موضوع العقد الإلكتروني . لا يمكن المستهلك الإلكتروني أن يرفض توقيع وصل الاستلام . تسلم نسخة من وصل الاستلام وجوبا للمستهلك الإلكتروني ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_17> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_17> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-05-10"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-05-10/18-05#version_art_18> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-05-10/18-05> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "بعد إبرام العقد الإلكتروني ، يصبح المورد الإلكتروني مسؤولا بقوة القانون أمام المستهلك الإلكتروني عن حسن تنفيذ الالتزامات المترتبة على هذا العقد ، سواء تم تنفيذها من قبله أو من قبل مؤديي خدمات آخرين، دون المساس بحقه في الرجوع ضدهم. غير أنه، يمكن المورد الإلكتروني أن يتحلل من كامل مسؤوليته أو جزء منها إذا أثبت أن عدم التنفيذ أو سوءه يعود إلى المستهلك الإلكتروني أو إلى قوة قاهرة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-05-10/18-05#version_art_18_20180510_OpEnact_c62975a014> ;
    dzdoc:replacementText "بعد إبرام العقد الإلكتروني ، يصبح المورد الإلكتروني مسؤولا بقوة القانون أمام المستهلك الإلكتروني عن حسن تنفيذ الالتزامات المترتبة على هذا العقد ، سواء تم تنفيذها من قبله أو من قبل مؤديي خدمات آخرين، دون المساس بحقه في الرجوع ضدهم. غير أنه، يمكن المورد الإلكتروني أن يتحلل من كامل مسؤوليته أو جزء منها إذا أثبت أن عدم التنفيذ أو سوءه يعود إلى المستهلك الإلكتروني أو إلى قوة قاهرة ."@ar ;
