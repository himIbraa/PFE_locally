        dzdoc:Reference ;
    rdfs:label "القانون رقم 04-02 المؤرخ في 5 جمادى الأولى عام 1425 الموافق 23 يونيو سنة 2004"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/2004-06-23/04-02"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/2004-06-23/04-02"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/2004-06-23/04-02" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2004-06-23/04-02> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_44" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "كل مخالفة لأحكام المادة 20 من هذا القانون يعاقب عليها طبقا لأحكام القانون رقم 04-02 المؤرخ في 5 جمادى الأولى عام 1425 الموافق 23 يونيو سنة 2004 والمذكور أعلاه"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/2004-06-23/04-02"^^xsd:anyURI .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_1cb60d4a93af> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 256 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:e-contract ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_2> ;
    dzdoc:paragraphPosition 2 ;
    dzdoc:snippet "العقد الإلكتروني : العقد بمفهوم القانون رقم 04-02 المؤرخ في 5 جمادى الأولى عام 1425 الموافق 23 يونيو سنة 2004 الذي يحدد القواعد المطبقة على الممارسات التجارية، ويتم إبرامه عن بعد، دون الحضور الفعلي والمتزامن لأطرافه باللجوء حصريا لتقنية الاتصال الإلكتروني."@ar .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_252e6bcdb420> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 133 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:domain-name ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_8> ;
    dzdoc:paragraphPosition 8 ;
    dzdoc:snippet "اسم النطاق : عبارة عن سلسلة أحرف و/أو أرقام مقيسة ومسجلة لدى السجل الوطني لأسماء النطاق، وتسمح بالتعرف والولوج إلى الموقع الإلكتروني."@ar .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_34e735ab2354> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 138 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:e-payment-method ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_5> ;
    dzdoc:paragraphPosition 5 ;
    dzdoc:snippet "وسيلة الدفع الإلكتروني : كل وسيلة دفع مرخص بها طبقا للتشريع المعمول به تمكن صاحبها من القيام بالدفع عن قرب أو عن بعد عبر منظومة إلكترونية."@ar .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_52921e1cdc86> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 157 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:e-consumer ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_3> ;
    dzdoc:paragraphPosition 3 ;
    dzdoc:snippet "المستهلك الإلكتروني : كل شخص طبيعي أو معنوي يقتني بعوض أو بصفة مجانية سلعة أو خدمة عن طريق الاتصالات الإلكترونية من المورد الإلكتروني بغرض الاستخدام النهائي."@ar .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_7294cdaea7b3> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 148 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:e-commerce ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_1> ;
    dzdoc:paragraphPosition 1 ;
    dzdoc:snippet "التجارة الإلكترونية : النشاط الذي يقوم بموجبه مورد إلكتروني باقتراح أو ضمان توفير سلع وخدمات عن بعد لمستهلك إلكتروني، عن طريق الاتصالات الإلكترونية."@ar .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_73d131ec4388> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 118 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:e-advertising ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_6> ;
    dzdoc:paragraphPosition 6 ;
    dzdoc:snippet "الإشهار الإلكتروني : كل إعلان يهدف بصفة مباشرة أو غير مباشرة إلى ترويج بيع سلع أو خدمات عن طريق الاتصالات الإلكترونية."@ar .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_86b2de311069> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 117 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:e-supplier ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_4> ;
    dzdoc:paragraphPosition 4 ;
    dzdoc:snippet "المورد الإلكتروني : كل شخص طبيعي أو معنوي يقوم بتسويق أو اقتراح توفير السلع أو الخدمات عن طريق الاتصالات الإلكترونية."@ar .

<https://legal.dz/resource/law/2018-05-10/18-05#art_6_defocc_a5c9a31af656> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 126 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:pre-order ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-05-10/18-05#art_6> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-05-10/18-05#art_6_para_7> ;
    dzdoc:paragraphPosition 7 ;
    dzdoc:snippet "الطلبية المسبقة : هو تعهد بالبيع يمكن أن يقترحه المورد الإلكتروني على المستهلك الالكتروني في حالة عدم توفر المنتوج في المخزون."@ar .

