<https://legal.dz/resource/law/2018-07-02/18-11#version_art_303> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع المؤسسة العمومية للصحة، في مجال مراقبة النفقات طبقا للتنظيم والتشريع المعمول بهما، إلى ما يأتي : المراقبة المالية المسبقة بالنسبة لنفقات المستخدمين المسيرين بموجب القانون الأساسي العام للوظيفة العمومية، المراقبة المالية البعدية بالنسبة للنفقات الأخرى."@ar ;
