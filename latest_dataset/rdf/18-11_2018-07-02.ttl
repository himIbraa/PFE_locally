    dzdoc:position 0 ;
    dzdoc:text "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_450_para_1> a dzdoc:Paragraph ;
