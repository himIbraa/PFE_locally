<https://legal.dz/resource/law/2018-07-02/18-11#version_art_212> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يقصد بمستلزم طبي في مفهوم هذا القانون، كل جهاز أو أداة أو تجهيز أو مادة أو منتوج، باستثناء المنتوجات ذات الأصل البشري، أو مادة أخرى مستعملة لوحدها أو بصفة مشتركة، بما في ذلك الملحقات والبرمجيات التي تدخل في سيره، وموجه للاستعمال لدى الإنسان لأغراض طبية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_212_20180702_OpEnact_2618c0c3c5> ;
    dzdoc:replacementText "يقصد بمستلزم طبي في مفهوم هذا القانون، كل جهاز أو أداة أو تجهيز أو مادة أو منتوج، باستثناء المنتوجات ذات الأصل البشري، أو مادة أخرى مستعملة لوحدها أو بصفة مشتركة، بما في ذلك الملحقات والبرمجيات التي تدخل في سيره، وموجه للاستعمال لدى الإنسان لأغراض طبية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_212> ;
