<https://legal.dz/resource/law/2018-07-02/18-11#version_art_274> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن تعد هياكل ذات طابع صحي وتسمى \"مراكز علاج\"، الهياكل المعتمدة من طرف الوزير المكلف بالصحة التي تتوفر، لا سيما على وسائل علاجية طبيعية أو عناصر حموية أو حقول وحل علاجي أو نباتات بحرية أو شروط مناخية مواتية للعلاج الشافي والوقائي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
