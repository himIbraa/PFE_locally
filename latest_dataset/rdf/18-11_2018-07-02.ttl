dzterm:assisted_reproduction a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المساعدة الطبية على الإنجاب"@ar,
        "المساعدة الطبية على الإنجاب هي نشاط طبي يسمح بالإنجاب خارج المسار الطبيعي، في حالة العقم المؤكد طبيا."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_370_defocc_afb8c9daadd3> .

dzterm:medical_devices a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المستلزمات الطبية"@ar,
        "مستلزم طبي"@ar .

dzterm:medicine a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدواء"@ar,
        "الدواء، في مفهوم هذا القانون، هو كل مادة أو تركيب يعرض على أنه يحتوي على خاصيات علاجية أو وقائية من الأمراض البشرية أو الحيوانية وكل المواد التي يمكن وصفها للإنسان أو للحيوان قصد القيام بتشخيص طبي أو استعادة وظائفه الفيزيولوجية أو تصحيحها وتعديلها."@ar,
        "الطب"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_208_defocc_38a1e719a7a3> .

dzterm:national_drug_register a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "السجل الوطني للأدوية"@ar,
        "السجل الوطني للأدوية هو المصنف الذي يضم الصيغ التركيبية، التي تم التأكد من جودتها ونجاعتها وأمنها وانعدام أضرارها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_216_defocc_2695b23a888e> .

dzterm:national_health_system a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المنظومة الوطنية للصحة"@ar .

dzterm:non_communicable_diseases a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأمراض غير المنتقلة"@ar .

dzterm:observation_obligatoire a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوضع في الملاحظة الإجبارية"@ar,
        "للوضع في الملاحظة الإجبارية"@ar .

dzterm:patient a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المريض"@ar,
        "مريض"@ar .

dzterm:pharmacopoeia a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "دستور الأدوية"@ar,
        "دستور الأدوية هو السجل الذي يضم الخصائص المطبقة على الأدوية ومكوناتها وعلى بعض المستلزمات الطبية وكذا مناهج التعرف عليها وتجريبها وتحليلها بغرض ضمان مراقبتها وتقييم نوعيتها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_215_defocc_e277f6a78e03> .

dzterm:prosecutor_general a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "النائب العام"@ar .

dzterm:state a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدولة"@ar .

