<https://legal.dz/resource/law/2018-07-02/18-11#version_art_395> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعد المرقي مسؤولا عن التقييم المستمر لأمن الدواء التجريبي . وهو ملزم بالتبليغ الفوري بكل أثر خطير غير مرغوب فيه أو غير متوقع أو أي حدث جديد للأمن يطرأ، خلال أو بعد نهاية الدراسة، ل الوزير المكلف بالصحة و لجنة الأخلاقيات الطبية للتجارب العيادية المعنية ولكل الأطباء الباحثين المعنيين، خلال سبعة (7) أيام كحد أقصى . وهو ملزم، كذلك، بوضع تدابير وإجراءات عملية مقيسة مكتوبة تمكن من احترام مقاييس الجودة اللازمة لكل مرحلة من جمع المعطيات، وعن توثيق حالات الأحداث والآثار غير المرغوب فيها والتصديق عليها وت"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_395_20180702_OpEnact_58af7cd7d0> ;
    dzdoc:replacementText "يعد المرقي مسؤولا عن التقييم المستمر لأمن الدواء التجريبي . وهو ملزم بالتبليغ الفوري بكل أثر خطير غير مرغوب فيه أو غير متوقع أو أي حدث جديد للأمن يطرأ، خلال أو بعد نهاية الدراسة، ل الوزير المكلف بالصحة و لجنة الأخلاقيات الطبية للتجارب العيادية المعنية ولكل الأطباء الباحثين المعنيين، خلال سبعة (7) أيام كحد أقصى . وهو ملزم، كذلك، بوضع تدابير وإجراءات عملية مقيسة مكتوبة تمكن من احترام مقاييس الجودة اللازمة لكل مرحلة من جمع المعطيات، وعن توثيق حالات الأحداث والآثار غير المرغوب فيها والتصديق عليها وتقييمها وحفظها في الأرشيف والتصريح بها ، وكذا عن ضمان احترام حماية المعطيات . ويجب أن يعرض تقريرا سنويا عن الأمن على الوزير المكلف بالصحة و لجنة الأخلاقيات الطبية فيما يخص الدراسات العيادية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_395> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_395> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_396> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يصرح الطبيب الباحث بكل حدث خطير من شأنه أن يحصل جراء بحث حول منتوج صيدلاني ل الوزير المكلف بالصحة ول لمرقي و لجنة الأخلاقيات الطبية للدراسات العيادية ."@ar ;
    dzdoc:isAuthoritative true ;
