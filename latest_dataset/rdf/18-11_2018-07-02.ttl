<https://legal.dz/resource/law/2018-07-02/18-11#art_31_para_3> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_31> ;
    dzdoc:position 3 ;
    dzdoc:text "وتتولى تنفيذ هذه البرامج المصالح الخارجية المنصوص عليها في المادة 267 أدناه ، وهياكل ومؤسسات الصحة والقطاعات المعنية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_31_para_4> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_31> ;
