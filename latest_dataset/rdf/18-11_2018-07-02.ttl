<https://legal.dz/resource/law/2018-07-02/18-11#art_136> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_136" ;
    dzdoc:fullText "يمكن المريض الراشد المتمتع بالأهلية أن يطلب بنفسه الاستشفاء الخاص به . و في حالة ما إذا كان المريض عديم الأهلية ولم تكن له أسرة ، يمكن الممثل الشرعي . إعداد طلب الاستشفاء ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_136_permission_0_8bdc959d>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_136_permission_1_06fc9711> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_136_right_0_4149c03e>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_136_right_1_167cca83> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_136> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_136_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_136_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_136_20180702_OpEnact_a94dd2c001> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 136" ;
    dzdoc:position 134 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_136_condition_0_93bed189> ;
    dzdoc:usesTerm dzterm:hospitalization,
        dzterm:legal_representative,
        dzterm:patient .

<https://legal.dz/resource/law/2018-07-02/18-11#art_137> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_137" ;
    dzdoc:fullText "يتم اللجوء إلى الوضع في الملاحظة أو الاستشفاء بفعل الغير عندما تتسبب اضطرابات المريض العقلية في استحالة الحصول على موافقته وتتطلب حالته معالجة فورية ومراقبة مستمرة في الوسط الاستشفائي . يمكن أن يتولى تقديم المريض لطبيب الأمراض العقلية: أحد أعضاء أسرته، الممثل الشرعي، السلطة العمومية التي تتصرف لمصلحة المريض، لا سيما الوالي أو رئيس المجلس الشعبي البلدي أو رئيس أمن الدائرة أو قائد كتيبة الدرك الوطني أو ممثلوهم المفوضون قانونا. يتعين على الشخص الذي يحضر المريض إلى طبيب الأمراض العقلية أن يقدم كل المعلومات الإدارية والطبية المفيدة خلال المراحل الطبية والإدارية لاستشفائه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_137_permission_0_ccd1f05e> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_137> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_137_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_137_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_137_para_2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_137_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_137_20180702_OpEnact_591f7ad0b3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_137_obligation_0_93477d5c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 137" ;
    dzdoc:position 135 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_137_condition_0_a202080c> ;
    dzdoc:usesTerm dzterm:apc_president,
        dzterm:district_security_chief,
        dzterm:gendarmerie_commander,
        dzterm:hospitalization_third_party,
        dzterm:placement_observation,
        dzterm:wali .

<https://legal.dz/resource/law/2018-07-02/18-11#art_145> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_145" ;
    dzdoc:fullText "يكون النائب العام لدى المجلس القضائي أو الوالي مؤهلين، دون سواهما، لاتخان قرار الفحص الإجباري في طب الأمراض العقلية . لا يمكن الوالي أو النائب العام طلب فحص إجباري في طب الأمراض العقلية لأحد أعضاء أسرتيهما ، لاسيما الأصول أو الفروع المباشرين، الزوج أو الأخ أو الأخت أو العم أو الخال أو العمة أو الخالة أو الأقارب الحواشي."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_145_permission_0_5432a951> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_145> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_145_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_145_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_145_20180702_OpEnact_05d24cdf9a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_145_obligation_0_0500a05a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "145" ;
    dzdoc:position 143 ;
    dzdoc:usesTerm dzterm:compulsory_psychiatric_examination,
        dzterm:prosecutor_general,
        dzterm:wali .

<https://legal.dz/resource/law/2018-07-02/18-11#art_174> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_174" ;
    dzdoc:fullText "يمكن مهنيي الصحة الممارسين الطبيين المؤهلين لممارسة مهامهم وفي حدود اختصاصاتهم، دون سواهم، وصف أعمال تشخيص وعلاج واستكشاف ومواد صيدلانية . ويجب عليهم السهر على احترام الممارسات الحسنة للوصف ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_174_permission_0_c8135a17> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_174_right_0_05dad574> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_174> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_174_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_174_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_174_20180702_OpEnact_cfa3bfdbe1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_174_obligation_0_96d5055f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 174" ;
    dzdoc:position 171 ;
    dzdoc:usesTerm dzterm:health_professionals,
        dzterm:medical_practitioners .

<https://legal.dz/resource/law/2018-07-02/18-11#art_205> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_1> ;
    dzdoc:eId "art_205" ;
    dzdoc:fullText "تسهر الدولة على توفير المواد الصيدلانية و المستلزمات الطبية وتضمن تسهيل الحصول على المواد، لا سيما الأساسية منها، في كل وقت وفي كل مكان من التراب الوطني . وتسهر كذلك على احترام مقتضيات الفعالية والأمن والنوعية في مجال صنع المواد الصيدلانية و المستلزمات الطبية واستيرادها وتصديرها وتوزيعها وتوفيرها . وتسهر زيادة على ذلك، على الاستعمال العقلاني للدواء، وترقية الدواء الجنيس ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_205> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_205_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_205_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_205_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_205_20180702_OpEnact_1c183f1a49> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_205_obligation_0_b677f1e3>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_205_obligation_1_1be8f9be>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_205_obligation_2_32ad123e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 205" ;
    dzdoc:position 202 ;
    dzdoc:usesTerm dzterm:generic_medicine,
        dzterm:medical_devices,
        dzterm:pharmaceutical_products .

<https://legal.dz/resource/law/2018-07-02/18-11#art_252> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_11> ;
    dzdoc:eId "art_252" ;
    dzdoc:fullText "يرخص الحائزون على شهادة الدراسات الطبية المتخصصة في البيولوجيا العيادية باستغلال مخبر للتحاليل البيولوجية الطبية . الأشخاص المذكورون في الفقرة الأولى أعلاه ، مسؤولون على مخابرهم، وكذا على نشاطهم الذي يجب عليهم ممارسته شخصيا وفعليا ضمن الشروط المحددة عن طريق التنظيم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_252_permission_0_e62c113d> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_252_right_0_264ff700> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_252> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_252_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_252_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_252_20180702_OpEnact_95dd7181a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_252_obligation_0_c066ddef> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 252" ;
    dzdoc:position 249 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_252__para_1> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_252__para_1> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_252_condition_0_cff08cd1> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_292> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_292" ;
    dzdoc:fullText "يتعين على الهياكل والمؤسسات العمومية والخاصة للصحة إعداد ملف طبي وحيد معلوماتي لكل مريض وتحيينه و يجب عليها الحفاظ على سرية المعلومات التي في حوزتها . ويتعين عليها، زيادة على ذلك، ضمان تسيير الأرشيف الطبي والمحافظة عليه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_292> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_292_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_292_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_292_20180702_OpEnact_1594362990> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_292_obligation_0_ada8a076>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_292_obligation_1_2236b25f>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_292_obligation_2_7934265e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "292" ;
    dzdoc:position 289 ;
    dzdoc:usesTerm dzterm:electronic_medical_file,
        dzterm:information_confidentiality,
        dzterm:medical_archives .

<https://legal.dz/resource/law/2018-07-02/18-11#art_334> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_334" ;
    dzdoc:fullText "يمكن أن يطلب من المستفيدين من العلاجات المساهمة في تمويل نفقات الصحة ضمن احترام أحكام هذا القانون. إن عدم المساهمة في تمويل نفقات الصحة لا يمكن أن يشكل عائقا أمام الحصول على العلاجات، لا سيما في حالة الاستعجالات . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_334_permission_0_1dbc3b57>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_334_permission_1_858b3a34> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_334_right_0_f1874310> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_334> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_334_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_334_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_334_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_334_20180702_OpEnact_7068280181> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 334" ;
    dzdoc:position 331 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_363> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_363" ;
    dzdoc:fullText "يمنع كشف هوية المتبرع المتوفي للمتلقي وهوية المتلقي لأسرة المتبرع . يجب ألا يكون الطبيب الذي قام بمعاينة وإثبات وفاة المتبرع من الفريق الذي يقوم بالزرع . ويمنع الشروع في نزع الأعضاء أو الأنسجة إذا كان ذلك سببا في عرقلة التشريح الطبي الشرعي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_363> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_363_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_363_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_363_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_363_20180702_OpEnact_44fa84c390> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_363_obligation_0_d2a34f01>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_363_obligation_1_39e44a15>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_363_obligation_2_14fe5334> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_363_prohibition_0_f44d8c60> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "363" ;
    dzdoc:position 360 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_56> a dzdoc:Article ;
