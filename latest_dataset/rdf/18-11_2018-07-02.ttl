<https://legal.dz/resource/law/2018-07-02/18-11#version_art_88> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر أشخاصا في وضع صعب ، لا سيما : الأشخاص ذوو الدخل الضعيف، لا سيما الأشخاص المعوقون أو الذين يعيشون في ظروف مادية واجتماعية و/أو نفسية هشة تهدد صحتهم العقلية والبدنية، الأشخاص ضحايا الكوارث أو أي حادث استثنائي آخر، الذين هم في وضعية مادية أو اجتماعية هشة، الأشخاص المستون أو الأطفال أو المراهقون الذين هم في خطر معنوي و/أو الموضوعون في المؤسسات التابعة لـ الوزارة المكلفة بالتضامن الوطني ، الأمهات والنساء اللائي هن في حالة نفسية واجتماعية صعبة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_88_20180702_OpEnact_14ac80bd25> ;
    dzdoc:replacementText "يعتبر أشخاصا في وضع صعب ، لا سيما : الأشخاص ذوو الدخل الضعيف، لا سيما الأشخاص المعوقون أو الذين يعيشون في ظروف مادية واجتماعية و/أو نفسية هشة تهدد صحتهم العقلية والبدنية، الأشخاص ضحايا الكوارث أو أي حادث استثنائي آخر، الذين هم في وضعية مادية أو اجتماعية هشة، الأشخاص المستون أو الأطفال أو المراهقون الذين هم في خطر معنوي و/أو الموضوعون في المؤسسات التابعة لـ الوزارة المكلفة بالتضامن الوطني ، الأمهات والنساء اللائي هن في حالة نفسية واجتماعية صعبة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
