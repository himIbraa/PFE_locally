    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_63> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تضع الدولة هياكل إزالة التسمم وإعادة التأهيل وإعادة الإدماج الاجتماعي، وتشجع على إنشائها وفقا للتشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_64_20180702_OpEnact_9f877f0cd6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
