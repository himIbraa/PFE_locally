<https://legal.dz/resource/law/2018-07-02/18-11#art_316> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_5> ;
    dzdoc:eId "art_316" ;
    dzdoc:fullText "قصد تلبية الاحتياجات الصحية للمواطنين، يمكن هياكل ومؤسسات الصحة، بموجب اتفاقية تعاون تشكيل شبكات علاج أو التطبيب عن بعد من أجل التكفل بالمواطنين أو بمشاكل صحية خاصة، لا سيما في المناطق التي تكون التغطية الصحية فيها غير كافية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_316_permission_0_326cdcf9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_316> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_316_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_316_20180702_OpEnact_ff09e0a19f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 316" ;
    dzdoc:position 313 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_316_condition_0_8a735496> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_352> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_352" ;
    dzdoc:fullText "لا يمكن أي شخص يمارس مهنة الصحة أن يقدم إلا العلاجات التي تحصل فيها على التكوين والخبرة الضروريين . ويجب عليه أن يمتنع عن كل عمل زائد أو غير ملائم حتى ولو كان بطلب من المريض أو من مهني في الصحة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_352_permission_0_41dea773> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_352> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_352_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_352_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_352_20180702_OpEnact_a937cc17bf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_352_obligation_0_eb9f8503>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_352_obligation_1_4700cb07> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 352" ;
    dzdoc:position 349 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_51> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_51" ;
    dzdoc:fullText "يمنع كل شكل من أشكال الترويج والرعاية والإشهار لفائدة مواد التبغ ."@ar ;
