    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف أحكام المادة 245 من هذا القانون المتعلقة بالمراقبة الإدارية والتقنية والأمنية لاستعمال مواد وأدوية ونباتات ذات خصائص مخدرة أو مؤثرة عقليا بالحبس من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 200.000 دج إلى 500.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_424_20180702_OpEnact_b42f676243> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
