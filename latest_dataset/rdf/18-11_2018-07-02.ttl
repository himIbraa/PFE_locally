<https://legal.dz/resource/law/2018-07-02/18-11#version_art_205> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسهر الدولة على توفير المواد الصيدلانية و المستلزمات الطبية وتضمن تسهيل الحصول على المواد، لا سيما الأساسية منها، في كل وقت وفي كل مكان من التراب الوطني . وتسهر كذلك على احترام مقتضيات الفعالية والأمن والنوعية في مجال صنع المواد الصيدلانية و المستلزمات الطبية واستيرادها وتصديرها وتوزيعها وتوفيرها . وتسهر زيادة على ذلك، على الاستعمال العقلاني للدواء، وترقية الدواء الجنيس ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_205_20180702_OpEnact_1c183f1a49> ;
    dzdoc:replacementText "تسهر الدولة على توفير المواد الصيدلانية و المستلزمات الطبية وتضمن تسهيل الحصول على المواد، لا سيما الأساسية منها، في كل وقت وفي كل مكان من التراب الوطني . وتسهر كذلك على احترام مقتضيات الفعالية والأمن والنوعية في مجال صنع المواد الصيدلانية و المستلزمات الطبية واستيرادها وتصديرها وتوزيعها وتوفيرها . وتسهر زيادة على ذلك، على الاستعمال العقلاني للدواء، وترقية الدواء الجنيس ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
