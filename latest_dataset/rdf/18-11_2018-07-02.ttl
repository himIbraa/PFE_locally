<https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_2> a dzdoc:Subsubsection ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4> ;
    dzdoc:directlyContains <https://legal.dz/resource/law/2018-07-02/18-11#art_59>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_60>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_61>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_62>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_63> ;
    dzdoc:eId "chp_2_sec_2_subsec_4_subsubsec_2" ;
    dzdoc:hasArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_59>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_60>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_61>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_62>,
