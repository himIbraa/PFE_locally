<https://legal.dz/resource/law/2018-07-02/18-11#art_103_defocc_3c7646e46139> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 159 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:mental_health ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_103> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_103_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "الصحة العقلية هي حالة من الراحة يكون فيها الشخص قادرا على إثبات قدراته، وعلى التغلب على التوترات العادية للحياة وتأدية عمل منتج ومفيد والمساهمة في حياة جماعته."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_103_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_103> ;
    dzdoc:position 0 ;
    dzdoc:text "الصحة العقلية هي حالة من الراحة يكون فيها الشخص قادرا على إثبات قدراته، وعلى التغلب على التوترات العادية للحياة وتأدية عمل منتج ومفيد والمساهمة في حياة جماعته."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_128_obligation_0_198aa3f7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
