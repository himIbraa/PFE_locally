<https://legal.dz/resource/law/2018-07-02/18-11#version_art_133> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكلف اللجنة الولائية للصحة العقلية ، لا سيما بما يأتي : دراسة كل طلب صادر عن الوالي أو طبيب الأمراض العقلية للمؤسسة والفصل فيه بخصوص استشفاء مريض مصاب باضطرابات عقلية أو إبقائه بالمستشفى أو إخراجه، دراسة كل طلب يتقدم به المريض أو ممثله الشرعي أو كل شخص يتصرف لمصلحته والفصل فيه. تعد قرارات اللجنة الولائية للصحة العقلية نافذة بالنسبة للسلطات والإدارات المعنية. يحدد تنظيم اللجنة وسيرها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_133_20180702_OpEnact_9458a0f062> ;
    dzdoc:replacementText "تكلف اللجنة الولائية للصحة العقلية ، لا سيما بما يأتي : دراسة كل طلب صادر عن الوالي أو طبيب الأمراض العقلية للمؤسسة والفصل فيه بخصوص استشفاء مريض مصاب باضطرابات عقلية أو إبقائه بالمستشفى أو إخراجه، دراسة كل طلب يتقدم به المريض أو ممثله الشرعي أو كل شخص يتصرف لمصلحته والفصل فيه. تعد قرارات اللجنة الولائية للصحة العقلية نافذة بالنسبة للسلطات والإدارات المعنية. يحدد تنظيم اللجنة وسيرها عن طريق التنظيم."@ar ;
