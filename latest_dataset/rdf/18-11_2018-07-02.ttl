<https://legal.dz/resource/law/2018-07-02/18-11#art_225_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_225> ;
    dzdoc:position 0 ;
    dzdoc:text "تضمن الوكالة على الخصوص، مهمة خدمة عمومية في مجال تسجيل المواد الصيدلانية والمستلزمات الطبية ذات الاستعمال البشري، والمصادقة عليها ومراقبتها."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_225_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_225> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد مهام هذه الوكالة وتنظيمها وسيرها عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_226_obligation_0_f6b66a79> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_226> ;
    dznorm:position 0 ;
    dznorm:provisionText "تسجل الاعتمادات الضرورية لتأدية مهام الوكالة في ميزانية الدولة"@ar ;
    dznorm:sourceArticle "art_226" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_226_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_226> ;
    dzdoc:position 0 ;
    dzdoc:text "تسجل الاعتمادات الضرورية لتأدية مهام الوكالة في ميزانية الدولة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_226_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_226> ;
    dzdoc:position 1 ;
    dzdoc:text "تتأتى الموارد المالية للوكالة، على الخصوص مما يأتي : الإعانات المسجلة في ميزانية الدولة، الإيرادات المرتبطة بنشاط الوكالة، لاسيما الأتاوى المتأتية من تسجيل المواد الصيدلانية والمستلزمات الطبية ذات الاستعمال البشري والمصادقة عليها والإشهار لها، طبقا للتشريع والتنظيم المعمول بهما، مداخيل الخدمات المقدمة، الهبات والوصايا، كل إيرادات أخرى مرتبطة بنشاطها."@ar .

