    dzdoc:replacementText "يتم ضمان نشاطات الصحة التي يمارسها، بصفة خاصة مهنيو الصحة لاسيما في : المؤسسات الاستشفائية الخاصة، المؤسسات الخاصة للعلاج و/أو التشخيص، هياكل الممارسة الفردية، هياكل الممارسة الجماعية، الصيدليات والمؤسسات الصيدلانية، مخابر التحاليل الطبية، الهياكل المعتمدة للنقل الصحي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_308> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_308> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_309> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن إنشاء أو استغلال الهياكل والمؤسسات الخاصة للصحة من طرف أي شخص طبيعي أو معنوي، لا سيما التعاضديات الاجتماعية. تحدد شروط وكيفيات استغلال مختلف الهياكل والمؤسسات الخاصة للصحة وتنظيم وسير نشاطاتها الصحية، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_309_20180702_OpEnact_25561502aa> ;
    dzdoc:replacementText "يمكن إنشاء أو استغلال الهياكل والمؤسسات الخاصة للصحة من طرف أي شخص طبيعي أو معنوي، لا سيما التعاضديات الاجتماعية. تحدد شروط وكيفيات استغلال مختلف الهياكل والمؤسسات الخاصة للصحة وتنظيم وسير نشاطاتها الصحية، عن طريق التنظيم."@ar ;
