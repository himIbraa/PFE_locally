    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف أحكام المادة 230 من هذا القانون، المتعلقة بتسجيل المواد الصيدلانية والمصادقة على المستلزمات الطبية، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 1.000.000 دج إلى 5.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_427_20180702_OpEnact_3c36fd09af> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
