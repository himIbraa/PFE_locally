<https://legal.dz/resource/law/2018-07-02/18-11#art_165_defocc_d99d7b00d2a8> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 144 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:health_professional ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_165> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_165_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يقصد بمهني الصحة في مفهوم هذا القانون، كل شخص ممارس وتابع لهيكل أو مؤسسة للصحة يقدم في نشاطه المهني خدمة صحية أو يساعد فيها أو يساهم في إنجازها."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_165_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_165> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بمهني الصحة في مفهوم هذا القانون، كل شخص ممارس وتابع لهيكل أو مؤسسة للصحة يقدم في نشاطه المهني خدمة صحية أو يساعد فيها أو يساهم في إنجازها."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_185_defocc_c107ee934c19> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 102 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:illegal_practice_health ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_185> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_185_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يمارس بصفة غير شرعية مهنة الصحة كل من لا يستوفي شروط الممارسة المحددة في التشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_185_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_185> ;
    dzdoc:position 0 ;
    dzdoc:text "يمارس بصفة غير شرعية مهنة الصحة كل من لا يستوفي شروط الممارسة المحددة في التشريع والتنظيم المعمول بهما."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_186_defocc_0ba1358600a4> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 50 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:illegal_practice_medicine ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_186> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_186_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يمارس بصفة غير شرعية الطب أو طب الأسنان أو الصيدلة :
            
            
            كل شخص يمارس نشاط طبيب أو طبيب أسنان أو صيدلي دون أن تتوفر فيه الشروط المحددة في هذا القانون أو خلال مدة المنع من الممارسة،
            
            
            كل شخص يقوم عادة، مقابل مكافأة أو بدونها ولو بحضور طبيب أو طبيب أسنان، بإعداد تشخيص أو تقديم دواء من خلال أعمال شخصية أو فحوص شفوية أو كتابية أو عن طريق أسلوب آخر كيفما كان نوعه، دون أن تتوفر فيه الشروط المحددة في هذا القانون،
            
            
            كل من كان حائزا الشهادة المطلوبة ويقدم مساعدته للأشخاص المذكورين في الفقرات أعلاه، أو يكون شريكا لهم،
            
            
            كل شخص غير مرخص له من الوزير المكلف بالصحة، يمارس في هيكل أو مؤسسة خاصة للصحة."""@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_186_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_186> ;
    dzdoc:position 0 ;
    dzdoc:text "يمارس بصفة غير شرعية الطب أو طب الأسنان أو الصيدلة : كل شخص يمارس نشاط طبيب أو طبيب أسنان أو صيدلي دون أن تتوفر فيه الشروط المحددة في هذا القانون أو خلال مدة المنع من الممارسة، كل شخص يقوم عادة، مقابل مكافأة أو بدونها ولو بحضور طبيب أو طبيب أسنان، بإعداد تشخيص أو تقديم دواء من خلال أعمال شخصية أو فحوص شفوية أو كتابية أو عن طريق أسلوب آخر كيفما كان نوعه، دون أن تتوفر فيه الشروط المحددة في هذا القانون، كل من كان حائزا الشهادة المطلوبة ويقدم مساعدته للأشخاص المذكورين في الفقرات أعلاه، أو يكون شريكا لهم، كل شخص غير مرخص له من الوزير المكلف بالصحة، يمارس في هيكل أو مؤسسة خاصة للصحة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_196_obligation_0_90c64690_ref_1ae33ec9202d> a dzdoc:ExternalReference,
        dzdoc:Reference ;
    rdfs:label "القانون رقم 84-10 المؤرخ في 11 فبراير سنة 1984"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1984-02-11/84-10"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1984-02-11/84-10"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1984-02-11/84-10" ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/1984-02-11/84-10> ;
    dzdoc:resolutionReason "canonical_akn_path" ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceEId "art_196" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "يخضع الممارسون المتخصصون لأحكام القانون رقم 84-10 المؤرخ في 11 فبراير سنة 1984 والمتعلق بـ الخدمة المدنية"@ar ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1984-02-11/84-10"^^xsd:anyURI .

<https://legal.dz/resource/law/2018-07-02/18-11#art_207_defocc_28091b4897c3> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 56 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:pharmaceutical_products ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_207> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_207_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """تتضمن المواد الصيدلانية، في مفهوم هذا القانون، ما يأتي :
            
            
            الأدوية،
            
            
            المواد الكيميائية الخاصة بالصيدليات،
            
            
            المواد الجالينوسية،
            
            
            المواد الأولية ذات الاستعمال الصيدلاني،
            
            
            الأغذية الحميوية الموجهة لأغراض طبية خاصة،
            
            
            كل المواد الأخرى الضرورية للطب البشري."""@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_207_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_207> ;
    dzdoc:position 0 ;
    dzdoc:text "تتضمن المواد الصيدلانية، في مفهوم هذا القانون، ما يأتي : الأدوية، المواد الكيميائية الخاصة بالصيدليات، المواد الجالينوسية، المواد الأولية ذات الاستعمال الصيدلاني، الأغذية الحميوية الموجهة لأغراض طبية خاصة، كل المواد الأخرى الضرورية للطب البشري."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_208_defocc_38a1e719a7a3> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 248 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:medicine ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_208> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_208_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "الدواء، في مفهوم هذا القانون، هو كل مادة أو تركيب يعرض على أنه يحتوي على خاصيات علاجية أو وقائية من الأمراض البشرية أو الحيوانية وكل المواد التي يمكن وصفها للإنسان أو للحيوان قصد القيام بتشخيص طبي أو استعادة وظائفه الفيزيولوجية أو تصحيحها وتعديلها."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_208_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_208> ;
    dzdoc:position 0 ;
    dzdoc:text "الدواء، في مفهوم هذا القانون، هو كل مادة أو تركيب يعرض على أنه يحتوي على خاصيات علاجية أو وقائية من الأمراض البشرية أو الحيوانية وكل المواد التي يمكن وصفها للإنسان أو للحيوان قصد القيام بتشخيص طبي أو استعادة وظائفه الفيزيولوجية أو تصحيحها وتعديلها."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_210_defocc_f41026cdceb7> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 37 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:definitions ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_210> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_210_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يقصد، في مفهوم هذا القانون بما يأتي :
            
            
            اختصاص صيدلاني : كل دواء يحضر مسبقا ويقدم وفق توضيب خاص ويتميز بتسمية خاصة،
            
            
            اختصاص جنيس من اختصاص مرجعي : كل دواء يتوفر على نفس التركيبة النوعية والكمية من المبدأ (المبادئ) الفاعل (الفاعلة) ونفس الشكل الصيدلاني والمتعاوض مع الاختصاص المرجعي نظر التكافئه البيولوجي المثبت بدراسات ملائمة للتوفر البيولوجي. لا يمكن إعطاء الاختصاص صفة اختصاص مرجعي إلا إذا تم تسجيله نظرا لكل المعطيات الضرورية والكافية لوحدها لتقييمه،
            
            
            منتوج بيو - علاجي : كل دواء تكون مادته الفاعلة مصنوعة انطلاقا من مصدر حيوي أو مشتقة منه،
            
            
            منتوج بيو - علاجي مماثل : كل دواء مماثل فيما يخص الجودة والأمن والفعالية لمنتوج بيو علاجي مرجعي، لا يمكن إعطاء المنتوج البيو علاجي صفة منتوج بيو علاجي مرجعي إلا إذا تم تسجيله نظرا لكل المعطيات الضرورية والكافية لوحدها لتقييمه،
            
            
            مستحضر وصفي : كل دواء يحضر فوريا تنفيذا لوصفة طبية، بسبب غياب اختصاص صيدلاني متوفر أو ملائم،
            
            
            مستحضر استشفائي : كل دواء محضر بناء على وصفة طبية وحسب بيانات دستور الأدوية بسبب غياب اختصاص صيدلاني متوفر أو ملائم في صيدلية مؤسسة صحية وموجه للتقديم لمريض أو عدة مرضى،
            
            
            مستحضر صيدلاني لدواء : كل دواء يحضر في الصيدلية حسب بيانات دستور الأدوية أو السجل الوطني للأدوية وموجه لتقديمه مباشرة للمريض،
            
            
            مادة صيدلانية مقسمة : كل عقار بسيط أو كل منتوج كيميائي أو كل مستحضر ثابت وارد في دستور الأدوية ومحضر سلفا من قبل مؤسسة صيدلانية تضمن تقسيمه إما هي وإما الصيدلية التي تعرضه للبيع وإما صيدلية مؤسسة صحية،
            
            
            دواء مناعي : كل دواء يتمثل في :
            
            
            1 - كاشف الحساسية يعرف على أنه كل منتوج موجه لتحديد أو إحداث تعديل خاص ومكتسب للرد المناعي على عامل مثير للحساسية،
            
            
            2 - لقاح أو سمين أو مصل موجه لتقديمه للإنسان قصد إحداث مناعة فاعلة أو سلبية أو قصد تشخيص حالة المناعة،
            
            
            
            
            دواء صيدلاني إشعاعي : كل دواء جاهز للاستعمال لدى الإنسان لأغراض طبية يحتوي على نظير أو عدة نظائر إشعاعية، مسماة نوكليدات إشعاعية،
            
            
            مولد : كل نظام يحتوي نوكليدا إشعاعيا أصليا، يستعمل في إنتاج نوكليد إشعاعي وليد يستخدم في دواء صيدلاني إشعاعي،
            
            
            الإضمامة : كل مستحضر يجب إعادة تشكيله أو تركيبه مع نوكليدات إشعاعية في المنتوج الصيدلاني الإشعاعي النهائي،
            
            
            السلف : كل نوكليد إشعاعي آخر تم إنتاجه من أجل الوسم المشع لمادة أخرى قبل تقديمها،
            
            
            دواء مكون أساسا من نبات : كل دواء تكون مواده الفاعلة حصريا مادة أو عدة مواد نباتية أو مستحضرات مكونة أساسا من نباتات،
            
            
            دواء تجريبي : كل دواء مجرب أو مستعمل كمرجع، بما في ذلك كغفل، خلال تجربة عيادية."""@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_210_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_210> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد، في مفهوم هذا القانون بما يأتي : اختصاص صيدلاني : كل دواء يحضر مسبقا ويقدم وفق توضيب خاص ويتميز بتسمية خاصة، اختصاص جنيس من اختصاص مرجعي : كل دواء يتوفر على نفس التركيبة النوعية والكمية من المبدأ (المبادئ) الفاعل (الفاعلة) ونفس الشكل الصيدلاني والمتعاوض مع الاختصاص المرجعي نظر التكافئه البيولوجي المثبت بدراسات ملائمة للتوفر البيولوجي. لا يمكن إعطاء الاختصاص صفة اختصاص مرجعي إلا إذا تم تسجيله نظرا لكل المعطيات الضرورية والكافية لوحدها لتقييمه، منتوج بيو - علاجي : كل دواء تكون مادته الفاعلة مصنوعة انطلاقا من مصدر حيوي أو مشتقة منه، منتوج بيو - علاجي مماثل : كل دواء مماثل فيما يخص الجودة والأمن والفعالية لمنتوج بيو علاجي مرجعي، لا يمكن إعطاء المنتوج البيو علاجي صفة منتوج بيو علاجي مرجعي إلا إذا تم تسجيله نظرا لكل المعطيات الضرورية والكافية لوحدها لتقييمه، مستحضر وصفي : كل دواء يحضر فوريا تنفيذا لوصفة طبية، بسبب غياب اختصاص صيدلاني متوفر أو ملائم، مستحضر استشفائي : كل دواء محضر بناء على وصفة طبية وحسب بيانات دستور الأدوية بسبب غياب اختصاص صيدلاني متوفر أو ملائم في صيدلية مؤسسة صحية وموجه للتقديم لمريض أو عدة مرضى، مستحضر صيدلاني لدواء : كل دواء يحضر في الصيدلية حسب بيانات دستور الأدوية أو السجل الوطني للأدوية وموجه لتقديمه مباشرة للمريض، مادة صيدلانية مقسمة : كل عقار بسيط أو كل منتوج كيميائي أو كل مستحضر ثابت وارد في دستور الأدوية ومحضر سلفا من قبل مؤسسة صيدلانية تضمن تقسيمه إما هي وإما الصيدلية التي تعرضه للبيع وإما صيدلية مؤسسة صحية، دواء مناعي : كل دواء يتمثل في : 1 - كاشف الحساسية يعرف على أنه كل منتوج موجه لتحديد أو إحداث تعديل خاص ومكتسب للرد المناعي على عامل مثير للحساسية، 2 - لقاح أو سمين أو مصل موجه لتقديمه للإنسان قصد إحداث مناعة فاعلة أو سلبية أو قصد تشخيص حالة المناعة، دواء صيدلاني إشعاعي : كل دواء جاهز للاستعمال لدى الإنسان لأغراض طبية يحتوي على نظير أو عدة نظائر إشعاعية، مسماة نوكليدات إشعاعية، مولد : كل نظام يحتوي نوكليدا إشعاعيا أصليا، يستعمل في إنتاج نوكليد إشعاعي وليد يستخدم في دواء صيدلاني إشعاعي، الإضمامة : كل مستحضر يجب إعادة تشكيله أو تركيبه مع نوكليدات إشعاعية في المنتوج الصيدلاني الإشعاعي النهائي، السلف : كل نوكليد إشعاعي آخر تم إنتاجه من أجل الوسم المشع لمادة أخرى قبل تقديمها، دواء مكون أساسا من نبات : كل دواء تكون مواده الفاعلة حصريا مادة أو عدة مواد نباتية أو مستحضرات مكونة أساسا من نباتات، دواء تجريبي : كل دواء مجرب أو مستعمل كمرجع، بما في ذلك كغفل، خلال تجربة عيادية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_211_defocc_23319352aa31> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 15 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:counterfeit_drug ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_211> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_211_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet """يقصد بدواء مقلد، في مفهوم هذا القانون، كل دواء معرف في المادة 208 أعلاه، يتضمن خطأ في التقديم بالنسبة:
            
            
            لهويته، بما في ذلك رزمه ووسمه، اسمه أو تكوينه، ويخص ذلك كل مكون من مكوناته بما في ذلك السواغات و مقدار هذه المكونات.
            
            
            لمصدره، بما في ذلك صانعه ، بلد صنعه أو بلد منشئه،
            
            
            لتاريخه، بما في ذلك التراخيص والتسجيلات والوثائق المتعلقة بمسارات التوزيع المستعملة."""@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_211_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_211> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بدواء مقلد، في مفهوم هذا القانون، كل دواء معرف في المادة 208 أعلاه، يتضمن خطأ في التقديم بالنسبة: لهويته، بما في ذلك رزمه ووسمه، اسمه أو تكوينه، ويخص ذلك كل مكون من مكوناته بما في ذلك السواغات و مقدار هذه المكونات. لمصدره، بما في ذلك صانعه ، بلد صنعه أو بلد منشئه، لتاريخه، بما في ذلك التراخيص والتسجيلات والوثائق المتعلقة بمسارات التوزيع المستعملة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_212_defocc_880d2de0790d> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 253 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:medical_device ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_212> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_212_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يقصد بمستلزم طبي في مفهوم هذا القانون، كل جهاز أو أداة أو تجهيز أو مادة أو منتوج، باستثناء المنتوجات ذات الأصل البشري، أو مادة أخرى مستعملة لوحدها أو بصفة مشتركة، بما في ذلك الملحقات والبرمجيات التي تدخل في سيره، وموجه للاستعمال لدى الإنسان لأغراض طبية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_212_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_212> ;
    dzdoc:position 0 ;
    dzdoc:text "يقصد بمستلزم طبي في مفهوم هذا القانون، كل جهاز أو أداة أو تجهيز أو مادة أو منتوج، باستثناء المنتوجات ذات الأصل البشري، أو مادة أخرى مستعملة لوحدها أو بصفة مشتركة، بما في ذلك الملحقات والبرمجيات التي تدخل في سيره، وموجه للاستعمال لدى الإنسان لأغراض طبية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_214_defocc_256861b43a08> a dzdoc:DefinitionOccurrence ;
