        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يحدد هذا القانون الأحكام والمبادئ الأساسية ويهدف إلى تجسيد حقوق وواجبات المواطنين مجال الصحة . ويرمي إلى ضمان الوقاية وحماية صحة الأشخاص والحفاظ عليها واستعادتها وترقيتها ضمن احترام الكرامة والحرية والسلامة والحياة الخاصة."@ar ;
