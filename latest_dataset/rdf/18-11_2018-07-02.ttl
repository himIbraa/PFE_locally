<https://legal.dz/resource/law/2018-07-02/18-11#version_art_231> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يلزم أعضاء لجان التسجيل والمصادقة والخبراء ومساعدوهم وكذا كل الأشخاص الذين يطلعون على ملفات التسجيل والمصادقة بالسر المهني، لاسيما فيما يخص تركيب المواد الخاضعة للخبرة وكذا معطياتها. لا يمكن الخبراء ومساعديهم إعطاء معلومات متعلقة بأعمالهم إلا للهيكل المؤهل للوكالة الوطنية للمواد الصيدلانية ."@ar ;
