<https://legal.dz/resource/law/2018-07-02/18-11#version_art_269> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تهدف الخريطة الصحية إلى ما يأتي : التنبو بالتطورات الضرورية من أجل تكييف عروض العلاج، التلبية القصوى لاحتياجات الصحة، تحديد تنظيم منظومة العلاج، تحديد شروط ربط مؤسسات الصحة بالشبكة، ضمان الحصول على العلاجات في كل نقطة من التراب الوطني وتحسينها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_269_20180702_OpEnact_36a2505b1a> ;
