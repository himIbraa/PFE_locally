<https://legal.dz/resource/law/2018-07-02/18-11#art_219> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:pharmaceutical_establishments ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_3> ;
    dzdoc:eId "art_219" ;
    dzdoc:fullText "المؤسسات الصيدلانية هي مؤسسات إنتاج واستغلال واستيراد وتصدير وتوزيع بالجملة مواد صيدلانية ومستلزمات طبية موجهة للطب البشري. ويجب عليها أن تضمن وفرة هذه المواد وأن تتوفر على هيكل تتم فيه على الأقل، إحدى العمليات المذكورة في المادتين 221 و 222 من هذا القانون، وتستوفي الشروط الواردة المادة 218 أعلاه. تحدد كيفيات تطبيق هذه المادة، لا سيما شروط اعتماد المؤسسات الصيدلانية، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_219> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_219_defocc_68aa3e582b22> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_219_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_219_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_219_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_219_20180702_OpEnact_a13d3166c5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_219_obligation_0_8fca0c6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "219" ;
    dzdoc:position 216 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_218>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_221>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_222> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_218>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_221>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_222> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_258> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_12> ;
    dzdoc:eId "art_258" ;
    dzdoc:fullText "تتولى هياكل صحية عمومية جمع الدم، طبقا للمعايير المطلوبة في مجال نشاط نقل الدم . تكلف الهياكل المذكورة في الفقرة الأولى أعلاه ، بجمع وتقسيم ومراقبة و حفظ و توزيع الدم ومواد الدم غير الثابتة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_258> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_258_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_258_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_258_20180702_OpEnact_2d89ef52bd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_258_obligation_0_eb73f4bc>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_258_obligation_1_42ce8c36> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 258" ;
    dzdoc:position 255 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_258> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_258> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_382> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:ethics_committee ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_382" ;
    dzdoc:fullText "تنشأ لجنة الأخلاقيات الطبية للدراسات العيادية على مستوى المصالح الخارجية المكلفة بالصحة. لجنة الأخلاقيات الطبية للدراسات العيادية هي جهاز مستقل، تراقب نشاطاتها من طرف المصالح المختصة للوزارة المكلفة بالصحة. تحدد مهام اللجنة وتشكيلتها وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_382> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_382_defocc_13e99180cc60> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_382_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_382_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_382_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_382_20180702_OpEnact_a90e525d3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_382_obligation_0_e727a69c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "382" ;
    dzdoc:position 379 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_382_condition_0_38cfe34a> ;
    dzdoc:usesTerm dzterm:ethics_committee .

<https://legal.dz/resource/law/2018-07-02/18-11#art_395> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_395" ;
    dzdoc:fullText "يعد المرقي مسؤولا عن التقييم المستمر لأمن الدواء التجريبي . وهو ملزم بالتبليغ الفوري بكل أثر خطير غير مرغوب فيه أو غير متوقع أو أي حدث جديد للأمن يطرأ، خلال أو بعد نهاية الدراسة، ل الوزير المكلف بالصحة و لجنة الأخلاقيات الطبية للتجارب العيادية المعنية ولكل الأطباء الباحثين المعنيين، خلال سبعة (7) أيام كحد أقصى . وهو ملزم، كذلك، بوضع تدابير وإجراءات عملية مقيسة مكتوبة تمكن من احترام مقاييس الجودة اللازمة لكل مرحلة من جمع المعطيات، وعن توثيق حالات الأحداث والآثار غير المرغوب فيها والتصديق عليها وتقييمها وحفظها في الأرشيف والتصريح بها ، وكذا عن ضمان احترام حماية المعطيات . ويجب أن يعرض تقريرا سنويا عن الأمن على الوزير المكلف بالصحة و لجنة الأخلاقيات الطبية فيما يخص الدراسات العيادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_395> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_395_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_395_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_395_para_2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_395_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_395_20180702_OpEnact_58af7cd7d0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_395_obligation_0_c144ad47>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_395_obligation_1_143d8a98>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_395_obligation_2_2d0f49c1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_395_obligation_3_2702ed40> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 395" ;
    dzdoc:position 392 ;
    dzdoc:usesTerm dzterm:ethics_committee,
        dzterm:experimental_drug,
        dzterm:minister_health,
        dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_171> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_171" ;
    dzdoc:fullText "يمكن تعويض مهني الصحة الذي يمارس بصفة حرة، وفق الشروط المنصوص عليها في أحكام المادة 166 أعلاه ، بسبب لا سيما التكوين أو العطلة. ويمكن أيضا، تعويضه لسبب صحي، لمدة أقصاها سنة واحدة قابلة للتجديد مرة واحدة. كما يمكن استخلافه من أجل ضمان استمرارية الخدمة العمومية، عندما يكون في عهدة دائمة في مؤسسة وطنية أو في جماعة إقليمية خلال مدة العهدة. وفي هذه الحالة، يمارس مهني الصحة المستخلف مهنته تحت هويته القانونية، ويبقى مسؤولا عن نشاطاته. تنتهي مدة الاستخلاف بانتهاء العهدة (العهدات) المنصوص عليها في الفقرة أعلاه. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_0_919627f4>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_1_4eb93694> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_171> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_171_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_171_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_171_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_171_20180702_OpEnact_fb1b5e012d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 171" ;
    dzdoc:position 169 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_166> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_166> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_171_condition_0_4447ddbc>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_171_condition_1_78be4fd8> ;
    dzdoc:usesTerm dzterm:health_professional .

<https://legal.dz/resource/law/2018-07-02/18-11#art_311> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_311" ;
    dzdoc:fullText "يجب على هياكل ومؤسسات الصحة الخاصة المكلفة بضمان مهمة خدمة عمومية للصحة، أن تستوفي الشروط الواردة في دفتر الأعباء الذي يحدده الوزير المكلف بالصحة ، لاسيما : الآداءات الصحية المقدمة، المدة الزمنية للاتفاق، شروط وكيفيات تقديم الخدمة العمومية. ويتعين على هذه الهياكل والمؤسسات إعداد مشروع مؤسسة مطابق لأهداف مخطط التنظيم الصحي. تهدف مهمة الخدمة العمومية المسندة بصفة مؤقتة وظرفية إلى الهياكل والمؤسسات الخاصة للصحة، إلى المساواة في الحصول على العلاج بضمان تغطية صحية بشكل دائم في المناطق التي تكون فيها التغطية الصحية غير كافية ، وذلك على أساس تنفيذ برامج وطنية وجهوية للصحة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_311_right_0_341d4271> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_311> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_311_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_311_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_311_para_2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_311_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_311_20180702_OpEnact_a66a085a4c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_311_obligation_0_886983a3>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_311_obligation_1_d3dd9ac8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
