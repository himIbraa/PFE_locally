<https://legal.dz/resource/law/2018-07-02/18-11#version_art_209> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعتبر كذلك كأدوية، لا سيما، ما يأتي : منتجات التغذية الحميوية التي تحتوي على مواد غير غذائية تمنحها خاصيات مفيدة للصحة البشرية، المنتجات الثابتة المشتقة من الدم، مركزات تصفية الكلى أو محاليل التصفية الصفاقية، الغازات الطبية. وتكون مماثلة للأدوية، على الخصوص : منتجات حفظ الصحة البدنية والتجميل التي تحتوي مواد سامة بمقادير وتركيزات تفوق تلك التي تحدد عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_209_20180702_OpEnact_50a6956a39> ;
    dzdoc:replacementText "يعتبر كذلك كأدوية، لا سيما، ما يأتي : منتجات التغذية الحميوية التي تحتوي على مواد غير غذائية تمنحها خاصيات مفيدة للصحة البشرية، المنتجات الثابتة المشتقة من الدم، مركزات تصفية الكلى أو محاليل التصفية الصفاقية، الغازات الطبية. وتكون مماثلة للأدوية، على الخصوص : منتجات حفظ الصحة البدنية والتجميل التي تحتوي مواد سامة بمقادير وتركيزات تفوق تلك التي تحدد عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_209> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_209> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
