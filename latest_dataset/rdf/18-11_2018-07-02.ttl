    dzdoc:position 308 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_311> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_311> ;
    dzdoc:usesTerm dzterm:minister .

