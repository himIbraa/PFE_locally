dzterm:الوكالة a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوكالة"@ar,
        "للوكالة"@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_10> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_10" ;
    dzdoc:fullText "تساهم الحركة الجمعوية للأشخاص المرضى ومهنيي ومرتفقي المنظومة الصحية العاملة على تحسين الصحة وتطويرها في حماية الصحة وترقيتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_10> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_10_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_10_20180702_OpEnact_ea2890bc9f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 10" ;
    dzdoc:position 9 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_109> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_109" ;
    dzdoc:fullText "يخضع استيراد المواد الغذائية وتجهيزات التحضير والتوضيب ومواد التوضيب وكذا عملية إنتاجها وحفظها ونقلها وتوزيعها وبيعها للمراقبة المنتظمة للسلامة وحفظ الصحة من طرف المصالح المعنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_109> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_109_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_109_20180702_OpEnact_dd1a190619> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "109" ;
    dzdoc:position 108 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_111> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_111" ;
    dzdoc:fullText "تسهر مصالح الصحة، بالتعاون مع المصالح المعنية على تطبيق التنظيم في مجال استعمال المواد الكيميائية في إنتاج وحفظ الأغذية النباتية والحيوانية وكذا مواد الصحة النباتية والمواد المركبة اصطناعيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_111> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_111_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_111_20180702_OpEnact_c0bc6f7f6f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "111" ;
    dzdoc:position 110 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_114> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_114" ;
    dzdoc:fullText "تخضع حماية صحة السكان للشروط والمقاييس التقنية في المجال طبقا للتشريع والتنظيم المعمول بهما، إنتاج المواد والمستحضرات المشعة ومعالجتها وحيازتها ونقلها واستعمالها وكذلك حيازة النفايات التي تحتوي على مادة مشعة وجمعها وتخزينها ونقلها ومعالجتها وإزالتها وتصريفها النهائي، وكذلك استعمال واستغلال الأدوات والتجهيزات التي تحتوي على مصدر إشعاع أيوني أو التي ترسل مثل هذه الإشعاعات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_114> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_114_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_114_20180702_OpEnact_2bdc3d0487> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "114" ;
    dzdoc:position 113 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_122> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_5> ;
    dzdoc:eId "art_122" ;
    dzdoc:fullText "تمارس نشاطات التربية من أجل الصحة على أساس برنامج يعده وينفذه ويقيمه الوزير المكلف بالصحة ، بالتنسيق مع القطاعات المعنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_122> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_122_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_122_20180702_OpEnact_806da67539> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "122" ;
    dzdoc:position 120 ;
    dzdoc:usesTerm dzterm:minister_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_129> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_129" ;
    dzdoc:fullText "ينحصر تقييد ممارسة الحريات الفردية للأشخاص الذين تم استشفاؤهم دون موافقتهم، بسبب اضطرابات عقلية في القيود الضرورية لحالة المريض الصحية وتنفيذ العلاج الخاص به."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_129> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_129_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_129_20180702_OpEnact_ccaa4833f0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 129" ;
    dzdoc:position 127 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_135> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_1> ;
    dzdoc:eId "art_135" ;
    dzdoc:fullText "يتم استشفاء مريض مصاب باضطرابات عقلية في مصلحة مفتوحة للأمراض العقلية وخروجه منها، القواعد المعمول بها بالنسبة للأمراض الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_135> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_135_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_135_20180702_OpEnact_e7aa80a480> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 135" ;
    dzdoc:position 133 ;
    dzdoc:usesTerm dzterm:hospitalization,
        dzterm:patient .

<https://legal.dz/resource/law/2018-07-02/18-11#art_138> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_2> ;
    dzdoc:eId "art_138" ;
    dzdoc:fullText "يتم الوضع في الملاحظة و/أو الاستشفاء بفعل الغير داخل مصلحة أو وحدة مغلقة لطب الأمراض العقلية، تحدد شروط إنشائها من طرف الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_138> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_138_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_138_20180702_OpEnact_1aa9fc9853> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 138" ;
    dzdoc:position 136 ;
    dzdoc:usesTerm dzterm:health_minister,
        dzterm:hospitalization_third_party,
        dzterm:placement_observation .

<https://legal.dz/resource/law/2018-07-02/18-11#art_148> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_148" ;
    dzdoc:fullText "يتم الوضع في الملاحظة الإجبارية داخل مصلحة أو وحدة مغلقة لطب الأمراض العقلية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_148> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_148_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_148_20180702_OpEnact_a11daa36a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "148" ;
    dzdoc:position 146 ;
    dzdoc:usesTerm dzterm:observation_obligatoire .

<https://legal.dz/resource/law/2018-07-02/18-11#art_167> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_167" ;
    dzdoc:fullText "تمارس مهن الصحة حسب أحد الأنظمة الآتية : بصفة موظف أو متعاقد في الهياكل والإدارات والمؤسسات العمومية للصحة أو أخرى، يسيره القانون الأساسي العام للوظيفة العمومية، بصفة متعاقد في هياكل ومؤسسات الصحة أو ذات طابع صحي أو اجتماعي طبقا للتشريع والتنظيم المعمول بهما، بصفة حرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_167> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_167_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_167_20180702_OpEnact_b193d4045f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 167" ;
    dzdoc:position 165 ;
    dzdoc:usesTerm dzterm:health_professions .

<https://legal.dz/resource/law/2018-07-02/18-11#art_175> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_175" ;
    dzdoc:fullText "تحدد الفئات الأخرى من مهنيي الصحة المرخص لهم بوصف مواد صيدلانية و/أو ممارسة فحوصات وإجراءات ومناهج، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_175> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_175_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_175_20180702_OpEnact_94d3d49af8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 175" ;
    dzdoc:position 172 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_187> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_3> ;
    dzdoc:eId "art_187" ;
    dzdoc:fullText "تعتبر شبيهة بممارسة غير شرعية للمهنة، كل عملية بيع الأدوية أو تخزينها أو إيداعها أو عرضها أو توفيرها على الطريق العمومي أو في أماكن أخرى غير مرخص بها من قبل الوزير المكلف بالصحة يقوم بها أي شخص ولو كان حائزا شهادة صيدلي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_187> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_187_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_187_20180702_OpEnact_d3f6bd72fc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "187" ;
    dzdoc:position 184 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:pharmacist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_189> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_4> ;
    dzdoc:eId "art_189" ;
    dzdoc:fullText "دون المساس بالصلاحيات المخولة لـ ضباط الشرطة القضائية المنصوص عليها في التشريع المعمول به، ينشأ لدى المصالح الخارجية التابعة لـ الوزارة المكلفة بالصحة ، سلك ممارسين مفتشين مؤهلين لبحث ومعاينة المخالفات للقوانين والأنظمة في مجال الصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_189> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_189_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_189_20180702_OpEnact_b18a6ce7e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 189" ;
    dzdoc:position 186 ;
    dzdoc:usesTerm dzterm:health_minister,
        dzterm:judicial_police_officers,
        dzterm:practitioner_inspectors .

<https://legal.dz/resource/law/2018-07-02/18-11#art_191> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_4> ;
    dzdoc:eId "art_191" ;
    dzdoc:fullText "يكلف الممارسون المفتشون ، لا سيما بما يأتي: مراقبة تطابق ممارسة مهن الصحة مع الأحكام القانونية والتنظيمية المعمول بها، السهر على مطابقة المحلات والتجهيزات الصحية مع المقاييس والشروط القانونية والتنظيمية، مراقبة الهياكل والمؤسسات والهيئات وكل مكان آخر تمارس فيه نشاطات الصحة أو يتم فيه إنتاج مواد الصحة أو إيداعها أو تسويقها أو استيرادها أو شحنها أو تخزينها أو تحليلها، مراقبة مدى تنفيذ برامج الصحة والتعليمات وغيرها من المقاييس الصادرة عن السلطات الصحية، مراقبة شروط حفظ الصحة والأمن الصحي في هياكل ومؤسسات الصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_191> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_191_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_191_20180702_OpEnact_2ee03467dc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 191" ;
    dzdoc:position 188 ;
    dzdoc:usesTerm dzterm:practitioner_inspectors .

<https://legal.dz/resource/law/2018-07-02/18-11#art_2> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_2" ;
    dzdoc:fullText "تساهم حماية الصحة وترقيتها في الراحة البدنية والنفسية والاجتماعية للشخص ورقيه في المجتمع، وتشكلان عاملا أساسيا في التنمية الاقتصادية والاجتماعية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_2> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_2_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_2_20180702_OpEnact_be353eeaa8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 2" ;
    dzdoc:position 1 ;
    dzdoc:usesTerm dzterm:health_protection .

<https://legal.dz/resource/law/2018-07-02/18-11#art_201> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_6> ;
    dzdoc:eId "art_201" ;
    dzdoc:fullText "يقوم بالتشريح الطبي الشرعي في الهياكل الاستشفائية العمومية طبيب عي تعينه الجهة القضائية المختصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_201> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_201_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_201_20180702_OpEnact_ce0b24dae3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "201" ;
    dzdoc:position 198 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_213> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_2> ;
    dzdoc:eId "art_213" ;
    dzdoc:fullText "تعتبر كذلك كمستلزمات طبية تلك المستعملة في التشخيص في المخبر : المنتوجات والكواشف والمواد والأدوات والأنظمة ومكوناتها وملحقاتها وكذا أوعية العينات الموجهة خصوصا للاستعمال في المخبر ، لوحدها أو بصفة مشتركة، في فحص عينات متأتية من جسم الإنسان من أجل توفير معلومة بخصوص حالة فيزيولوجية أو مرضية مثبتة أو محتملة أو شذوذ خلقي من أجل مراقبة قياسات علاجية أو من أجل تحديد أمن نزع عناصر من جسم الإنسان أو مطابقته مع متلقين محتملين."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_213> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_213_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_213_20180702_OpEnact_a67e2d4239> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 213" ;
    dzdoc:position 210 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_224> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_4> ;
    dzdoc:eId "art_224" ;
    dzdoc:fullText "الوكالة مؤسسة عمومية ذات تسيير خاص تتمتع بالشخصية المعنوية والاستقلال المالي، توضع تحت وصاية الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_224> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_224_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_224_20180702_OpEnact_4039499c8d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 224" ;
    dzdoc:position 221 ;
    dzdoc:usesTerm dzterm:الوكالة,
        dzterm:وزير_الصحة .

<https://legal.dz/resource/law/2018-07-02/18-11#art_248> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_9> ;
    dzdoc:eId "art_248" ;
    dzdoc:fullText "تتولى الصيدلية الاستشفائية المهام الآتية : ضمان، مع مراعاة القواعد التي تحكم سير المؤسسة، تسيير المواد الصيدلانية و الأدوية ومنتجات أو مستلزمات التضميد وكذا العتاد الطبي المعقم الموجه للاستعمال في المؤسسة، وتموينها وتحضيرها ومراقبتها وتخزينها وحيازتها وتسليمها، القيام أو المشاركة في كل عمل إعلامي حول هذه المواد الصيدلانية أو الأدوية أو العتاد أو الأشياء، وكذا في كل عمل ترقية حسن استعمالها والمساهمة في تقييمها، القيام أو المشاركة في كل عمل من شأنه أن يساهم في جودة وأمن المعالجات والعلاجات التي تدخل في مجال نشاطها، تطبيق قواعد الممارسات الحسنة للصيدلة الاستشفائية التي يحددها الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_248> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_248_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_248_20180702_OpEnact_bafedb989e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 248" ;
    dzdoc:position 245 ;
    dzdoc:usesTerm dzterm:drugs,
        dzterm:hospital_pharmacy,
        dzterm:minister_of_health,
        dzterm:pharmaceutical_materials .

<https://legal.dz/resource/law/2018-07-02/18-11#art_265> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_1> ;
    dzdoc:eId "art_265" ;
    dzdoc:fullText "يرتكز تنظيم المنظومة الوطنية للصحة ، لا سيما على ما يأتي : الخريطة الصحية ومخطط التنظيم الصحي، المصالح الخارجية التابعة للقطاع المكلف بالصحة، خدمة عمومية للصحة تضمنها المؤسسات العمومية والمؤسسات الخاصة المكلفة بهذه المهمة، قطاع خاص للصحة، العمل القطاعي المشترك في تنفيذ السياسة الوطنية للصحة، التكامل بين القطاع العمومي والقطاع الخاص في مجال الخدمات الصحية، تكامل نشاطات الوقاية والعلاج وإعادة التأهيل في جانبها الطبي والاجتماعي، مساعي تشخيصية وعلاجية ترتكز على اتفاقات ذات فائدة طبية فعلية مقيمة ومحينة بانتظام، تنظيم وترقية التكوين والبحث في علوم الصحة، مساهمة الحركة الجمعوية والتعاضدية. شبكات العلاج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_265> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_265_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_265_20180702_OpEnact_46761ce20b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "265" ;
    dzdoc:position 262 ;
    dzdoc:usesTerm dzterm:national_health_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_278> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3> ;
    dzdoc:eId "art_278" ;
    dzdoc:fullText "تكون نشاطات التكوين واستغلال الهياكل البيداغوجية لمؤسسات الصحة العمومية محل اتفاقيات بين الوزير المكلف بالصحة والقطاعات الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_278> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_278_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_278_20180702_OpEnact_e57ff2b722> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "278" ;
    dzdoc:position 275 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_279> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3> ;
    dzdoc:eId "art_279" ;
    dzdoc:fullText "تكون الأملاك العقارية للهياكل والمؤسسات العمومية للصحة غير قابلة للتصرف فيها وغير قابلة للتقادم والحجز، طبقا للتشريع المعمول به لا سيما قانون الأملاك الوطنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_279> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_279_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_279_20180702_OpEnact_5a03bbe17e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "279" ;
    dzdoc:position 276 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_286> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_286" ;
    dzdoc:fullText "تهدف علاجات الرعاية التلطيفية إلى التخفيف من ألم المريض والتقليل من معاناته النفسية ومنحه المرافقة الضرورية طبقا لأحكام هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_286> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_286_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_286_20180702_OpEnact_2e2e267377> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 286" ;
    dzdoc:position 283 ;
    dzdoc:usesTerm dzterm:palliative_care .

<https://legal.dz/resource/law/2018-07-02/18-11#art_299> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_3> ;
    dzdoc:eId "art_299" ;
    dzdoc:fullText "تسري أحكام القانون الأساسي العام للوظيفة العمومية على مستخدمي المؤسسة العمومية للصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_299> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_299_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_299_20180702_OpEnact_ac3e7bb26b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 299" ;
    dzdoc:position 296 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_303> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_3> ;
    dzdoc:eId "art_303" ;
    dzdoc:fullText "تخضع المؤسسة العمومية للصحة، في مجال مراقبة النفقات طبقا للتنظيم والتشريع المعمول بهما، إلى ما يأتي : المراقبة المالية المسبقة بالنسبة لنفقات المستخدمين المسيرين بموجب القانون الأساسي العام للوظيفة العمومية، المراقبة المالية البعدية بالنسبة للنفقات الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_303> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_303_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_303_20180702_OpEnact_149106a2c9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 303" ;
    dzdoc:position 300 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_308> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_308" ;
    dzdoc:fullText "يتم ضمان نشاطات الصحة التي يمارسها، بصفة خاصة مهنيو الصحة لاسيما في : المؤسسات الاستشفائية الخاصة، المؤسسات الخاصة للعلاج و/أو التشخيص، هياكل الممارسة الفردية، هياكل الممارسة الجماعية، الصيدليات والمؤسسات الصيدلانية، مخابر التحاليل الطبية، الهياكل المعتمدة للنقل الصحي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_308> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_308_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_308_20180702_OpEnact_70792149de> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 308" ;
    dzdoc:position 305 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_312> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_312" ;
    dzdoc:fullText "تسير اتفاقيات مبرمة مع الوزارة المكلفة بالصحة النفقات المتعلقة بالعلاجات التي تقدمها الهياكل والمؤسسات الخاصة للصحة الموكلة لها مهام الخدمة العمومية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_312> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_312_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_312_20180702_OpEnact_28e6fd0c65> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 312" ;
    dzdoc:position 309 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_320> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_6> ;
    dzdoc:eId "art_320" ;
    dzdoc:fullText "يدرج النظام الوطني للإعلام الصحي كل المعطيات الصحية ويضمن العمل مع أنظمة إعلام قطاعات النشاط الأخرى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_320> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_320_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_320_20180702_OpEnact_9fcfa54b43> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 320" ;
    dzdoc:position 317 ;
    dzdoc:usesTerm dzterm:national_health_information_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_326> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_7> ;
    dzdoc:eId "art_326" ;
    dzdoc:fullText "ترسل مؤسسة الصحة المعنية التقرير التقييمي الداخلي المنصوص عليه في المادة 325 أعلاه إلى المصالح المختصة التابعة للوزارة المكلفة بالصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_326> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_326_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_326_20180702_OpEnact_5494319bb2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "326" ;
    dzdoc:position 323 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_325> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_325> ;
    dzdoc:usesTerm dzterm:health_institution .

<https://legal.dz/resource/law/2018-07-02/18-11#art_331> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_331" ;
    dzdoc:fullText "تشارك الجماعات المحلية في تمويل الصحة في إطار برامج الاستثمار وبرامج الوقاية وحفظ الصحة والتربية من أجل الصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_331> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_331_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_331_20180702_OpEnact_5d5be9db1c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 331" ;
    dzdoc:position 328 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_336> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_336" ;
    dzdoc:fullText "يحدد الوزير المكلف بالصحة ، بالاتصال مع الوزراء المعنيين، أسعار الخدمات غير تلك المتعلقة بالأعمال والنشاطات الطبية التي تقدمها مؤسسات الصحة العمومية والخاصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_336> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_336_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_336_20180702_OpEnact_26960c948f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 336" ;
    dzdoc:position 333 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_37> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2> ;
    dzdoc:eId "art_37" ;
    dzdoc:fullText "تحدد قائمة الأمراض المنتقلة التي يكون الكشف عنها سريا ومجانيا، ولاسيما منها الأمراض المنتقلة جنسيا، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_37> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_37_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_37_20180702_OpEnact_bd48de1362> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "37" ;
    dzdoc:position 36 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_376> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_3> ;
    dzdoc:eId "art_376" ;
    dzdoc:fullText "تحدد شروط حفظ وإتلاف الأمشاج عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_376> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_376_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_376_20180702_OpEnact_061638663d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "376" ;
    dzdoc:position 373 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_388> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_388" ;
    dzdoc:fullText "تحدد شروط تأهيل الأشخاص المطلوبين للدراسة العيادية بذات منفعة على صحتهم، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_388> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_388_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_388_20180702_OpEnact_25fa2f6672> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 388" ;
    dzdoc:position 385 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_4> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_4" ;
    dzdoc:fullText "ترتكز السياسة الوطنية للصحة ، لا سيما تنفيذها، على العمل القطاعي المشترك عبر مساهمة مختلف الفاعلين المتدخلين في مجال الصحة وتنظيمهم وتوجيههم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_4_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_4_20180702_OpEnact_78d28d45b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 4" ;
    dzdoc:position 3 ;
    dzdoc:usesTerm dzterm:national_health_policy .

<https://legal.dz/resource/law/2018-07-02/18-11#art_415> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_415" ;
    dzdoc:fullText "يعاقب على مخالفة لأحكام المادة 168 من هذا القانون المتعلقة ب الممارسة تحت الهوية القانونية لمهن الصحة ، طبقا لأحكام المادة 247 من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_415> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_415_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_415_20180702_OpEnact_7e4c256394> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 415" ;
    dzdoc:position 412 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_168> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_415_extref_83a3e9fd> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_168> ;
    dzdoc:usesTerm dzterm:legal_identity_practice .

<https://legal.dz/resource/law/2018-07-02/18-11#art_416> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_416" ;
    dzdoc:fullText "يعاقب كل شخص على الممارسة غير الشرعية لمهن الصحة طبقا لأحكام المادة 243 من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_416> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_416_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_416_20180702_OpEnact_f6784790c3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 416" ;
    dzdoc:position 413 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_416_extref_9a6f91e6> ;
    dzdoc:usesTerm dzterm:illegal_practice .

<https://legal.dz/resource/law/2018-07-02/18-11#art_418> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_418" ;
    dzdoc:fullText "يعاقب على كل رفض للامتثال لطلبات التسخيرة الصادرة من السلطة العمومية حسب الأشكال المنصوص عليها في التنظيم الساري المفعول، طبقا لأحكام المادة 187 مكرر من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_418> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_418_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_418_20180702_OpEnact_fd30069bfa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 418" ;
    dzdoc:position 415 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_418_extref_9b262dcb> ;
    dzdoc:usesTerm dzterm:requisition .

<https://legal.dz/resource/law/2018-07-02/18-11#art_423> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_423" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 245 من هذا القانون المتعلقة بالمراقبة الإدارية والتقنية والأمنية لاستعمال مواد وأدوية ونباتات ذات خصائص مخدرة أو مؤثرة عقليا بالحبس من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 200.000 دج إلى 500.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_423> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_423_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_423_20180702_OpEnact_ce81ada560> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 423" ;
    dzdoc:position 420 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_245> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_245> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_424> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_424" ;
    dzdoc:fullText "يعاقب كل من يخالف الأحكام المتعلقة بالنوكليدات الإشعاعية، بالحبس من ستة (6) أشهر إلى سنتين (2) وبغرامة من 200.000 دج إلى 500.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_424> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_424_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_424_20180702_OpEnact_b42f676243> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 424" ;
    dzdoc:position 421 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_425> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_425" ;
    dzdoc:fullText "يعاقب كل من قام بصنع الأدوية المقلدة المحددة في المادة 211 من هذا القانون، أو السمسرة لها أو توزيعها أو الإشهار لها أو عرضها للبيع أو بيعها أو استيرادها أو تصديرها أو حيازتها، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 1.000.000 دج إلى 5.000.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_425> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_425_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_425_20180702_OpEnact_b0b6d10561> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 425" ;
    dzdoc:position 422 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_211> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_211> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_426> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_426" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 230 من هذا القانون، المتعلقة بتسجيل المواد الصيدلانية والمصادقة على المستلزمات الطبية، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 1.000.000 دج إلى 5.000.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_426> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_426_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_426_20180702_OpEnact_122bafeecd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 426" ;
    dzdoc:position 423 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_230> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_230> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_428> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_428" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 258 من هذا القانون، المتعلقة بجمع وتقسيم وحفظ وتوزيع الدم ومواد الدم غير الثابتة، بغرامة من 1.000.000 دج إلى 2.000.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_428> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_428_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_428_20180702_OpEnact_9c4def06f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 428" ;
    dzdoc:position 425 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_258> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_258> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_429> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_429" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 263 من هذا القانون، المتعلقة بالنشاطات المربحة المرتبطة بالدم البشري والبلازما ومشتقاتهما، بالحبس من سنتين (2) إلى ثلاث (3) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_429> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_429_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_429_20180702_OpEnact_007eddab60> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 429" ;
    dzdoc:position 426 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_263> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_263> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_430> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_430" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام هذا القانون المتعلقة بنزع الأعضاء والأنسجة والخلايا البشرية وزرعها، طبقا لأحكام المواد من 303 مكرر 16 إلى 303 مكرر 20 من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_430> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_430_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_430_20180702_OpEnact_dcca739bab> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 430" ;
    dzdoc:position 427 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_430_extref_a26a0338>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_430_extref_dfdb1866> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_431> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_431" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 361 من هذا القانون، المتعلقة بنزع الأعضاء والأنسجة والخلايا من الأشخاص القصر أو عديمي الأهلية، طبقا لأحكام المواد من 303 مكرر 16 إلى 303 مكرر 20 من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_431> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_431_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_431_20180702_OpEnact_eeb048351b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 431" ;
    dzdoc:position 428 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_361> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_431_extref_a26a0338>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_431_extref_dfdb1866> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_361> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_432> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_432" ;
    dzdoc:fullText "يعاقب كل من يقوم بالإشهار للتبرع بالأعضاء أو الأنسجة أو الخلايا البشرية لفائدة شخص أو مؤسسة، بالحبس من ستة (6) أشهر إلى سنة (1) وبغرامة من 200.000 دج إلى 400.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_432> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_432_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_432_20180702_OpEnact_8ee8a1a19e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 432" ;
    dzdoc:position 429 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_433> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_433" ;
    dzdoc:fullText "يعاقب كل من يقوم بنزع أو زرع الأعضاء أو الأنسجة أو الخلايا البشرية أو يمارس نشاطات المساعدة الطبية على الإنجاب في مؤسسة غير مرخص لها، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_433> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_433_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_433_20180702_OpEnact_bf8a82999c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 433" ;
    dzdoc:position 430 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_442> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_442" ;
    dzdoc:fullText "لا تطبق أحكام المادتين 276 و 318 من هذا القانون على هياكل ومؤسسات الصحة التابعة لوزارة الدفاع الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_442> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_442_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_442_20180702_OpEnact_211edfa699> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 442" ;
    dzdoc:position 439 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_276>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_318> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_276>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_318> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_445> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_445" ;
    dzdoc:fullText "تحدد إجراءات وشروط تصنيف وأرشفة ومدة وطريقة حفظ الملف الطبي وإتلافه كما تم ذكره في المادة 292 أعلاه، وكذا كل الأرشيفات الأخرى الخاصة بالصحة، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_445> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_445_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_445_20180702_OpEnact_95a47174f4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 445" ;
    dzdoc:position 442 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_292> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_292> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_446> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_446" ;
    dzdoc:fullText "يتم تنصيب المصالح الخارجية للصحة في أجل أقصاه سنتان (2) ابتداء من تاريخ نشر هذا القانون في الجريدة الرسمية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_446> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_446_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_446_20180702_OpEnact_667c79d56b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 446" ;
    dzdoc:position 443 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_447> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_447" ;
    dzdoc:fullText "يواصل المجلس الوطني والمجالس الجهوية للأدبيات الطبية المنتخبة والمنصبة وفقا لأحكام القانون رقم 85-05 المؤرخ في 26 جمادى الأولى عام 1405 الموافق 16 فبراير سنة 1985 و المذكور أعلاه، ممارسة صلاحياتها إلى غاية تنصيب المجالس الوطنية والجهوية للأدبيات الطبية المنصوص عليها في أحكام هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_447> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_447_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_447_20180702_OpEnact_5eb60c80e1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 447" ;
    dzdoc:position 444 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_447_extref_6958f988> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_448> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_448" ;
    dzdoc:fullText "تواصل الهياكل المكلفة بالمهام المسندة إلى الوكالة الوطنية للمواد الصيدلانية بمقتضى أحكام هذا القانون، ضمان هذه المهام إلى غاية تنصيب الوكالة المذكورة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_448> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_448_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_448_20180702_OpEnact_cf9ccfaa6a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 448" ;
    dzdoc:position 445 ;
    dzdoc:usesTerm dzterm:national_agency_pharmaceutical_products .

<https://legal.dz/resource/law/2018-07-02/18-11#art_5> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_5" ;
    dzdoc:fullText "ترتكز المنظومة الوطنية للصحة على قطاع عمومي قوي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_5_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_5_20180702_OpEnact_969fb96026> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 5" ;
    dzdoc:position 4 ;
    dzdoc:usesTerm dzterm:national_health_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_68> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_4> ;
    dzdoc:eId "art_68" ;
    dzdoc:fullText "تكيف برامج النشاطات المنصوص عليها في المادة 67 أعلاه، حسب السن والجنس والحالة الصحية والظروف المعيشية للمواطنين وعملهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_68> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_68_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_68_20180702_OpEnact_921b92a3da> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 68" ;
    dzdoc:position 67 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_67> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_67> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_70> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_70" ;
    dzdoc:fullText "تشكل برامج مكافحة الوفيات لدى الأم والطفل أولوية لـ الصحة العمومية ، وتنفذها هياكل ومؤسسات الصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_70> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_70_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_70_20180702_OpEnact_f5d18c0ff6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 70" ;
    dzdoc:position 69 ;
    dzdoc:usesTerm dzterm:public_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_8> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_8" ;
    dzdoc:fullText "تهدف البرامج الصحية إلى تنفيذ كل الأعمال وتعبئة الوسائل التي من شأنها ضمان خدمات وقائية وعلاجية للمواطنين من أجل تفادي أو إيقاف مرض أو مجموعة من الأمراض المعينة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_8_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_8_20180702_OpEnact_40bc89e6a5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 8" ;
    dzdoc:position 7 ;
    dzdoc:usesTerm dzterm:health_programs .

<https://legal.dz/resource/law/2018-07-02/18-11#art_9> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_9" ;
    dzdoc:fullText "تهدف حماية الصحة وترقيتها إلى ضمان حماية المستهلك والبيئة وحفظ الصحة وسلامة المحيط وإطار المعيشة والعمل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_9_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_9_20180702_OpEnact_f9ab7f33d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 9" ;
    dzdoc:position 8 ;
    dzdoc:usesTerm dzterm:health_protection .

<https://legal.dz/resource/law/2018-07-02/18-11#art_98> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_6> ;
    dzdoc:eId "art_98" ;
    dzdoc:fullText "تهدف الصحة في وسط العمل ، لا سيما إلى ما يأتي : ترقية الراحة البدنية والعقلية والاجتماعية للعمال في كل المهن والحفاظ على أعلى درجة لها، الوقاية من كل ضرر يلحق بصحة العمال جراء ظروف عملهم، حماية العمال في شغلهم من الأخطار الناتجة عن وجود عوامل مضرة بصحتهم، وقاية العمال وحمايتهم من حوادث العمل والأمراض المهنية، تنصيب العمال في منصب عمل ملائم لقدراتهم الفيزيولوجية والنفسية وإبقاؤهم فيه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_98> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_98_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_98_20180702_OpEnact_1bb1b2e67c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 98" ;
    dzdoc:position 97 ;
    dzdoc:usesTerm dzterm:health_at_work .

