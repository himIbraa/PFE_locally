<https://legal.dz/resource/law/2018-07-02/18-11#art_6_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_6> ;
    dzdoc:position 0 ;
