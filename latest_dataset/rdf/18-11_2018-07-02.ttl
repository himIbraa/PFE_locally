    dznorm:provisionText "في حالة رفض علاجات طبية، يمكن اشتراط تصريح كتابي من المريض أو ممثله الشرعي."@ar ;
    dznorm:sourceArticle "art_344" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_344_permission_0_0c6da7fe_action_bf8c0c81ed> a dznorm:Action ;
