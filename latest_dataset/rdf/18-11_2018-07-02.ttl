<https://legal.dz/resource/law/2018-07-02/18-11#art_208_permission_0_e0f93bcc> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
