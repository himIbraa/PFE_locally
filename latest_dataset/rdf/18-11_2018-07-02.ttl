<https://legal.dz/resource/law/2018-07-02/18-11#art_416_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_416> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل شخص على الممارسة غير الشرعية لمهن الصحة طبقا لأحكام المادة 243 من قانون العقوبات."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_417_extref_3ee0d81d> a dzdoc:ExternalReference ;
    rdfs:label "المادة 301"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/1966-06-08/66-156#art_301"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1966-06-08/66-156#art_301"^^xsd:anyURI ;
