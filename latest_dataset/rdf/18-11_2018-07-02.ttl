    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 60" ;
    dzdoc:position 59 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_61> a dzdoc:Article ;
