<https://legal.dz/resource/law/2018-07-02/18-11#version_art_123> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على هياكل ومؤسسات الصحة المعنية، في إطار التكفل الصحي عند الكوارث أو الحالات الاستثنائية، إعداد مخطط تدخل ونجدة خصوصي، وذلك بالتعاون مع سلطات المصالح المؤهلة . ويجب عليها مسك بطاقية محينة للأشخاص المختصين والوسائل الواجب تعبئتهما في حالة كارثة أو في حالة استثنائية . كما يتعين عليها القيام بشكل دوري تنظيم تمارين محاكاة بالتنسيق مع المصالح المؤهلة في إطار الوقاية وذلك من أجل التخفيف من آثار الكوارث أو الحالة الاستثنائية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_123_20180702_OpEnact_782b30d133> ;
    dzdoc:replacementText "يتعين على هياكل ومؤسسات الصحة المعنية، في إطار التكفل الصحي عند الكوارث أو الحالات الاستثنائية، إعداد مخطط تدخل ونجدة خصوصي، وذلك بالتعاون مع سلطات المصالح المؤهلة . ويجب عليها مسك بطاقية محينة للأشخاص المختصين والوسائل الواجب تعبئتهما في حالة كارثة أو في حالة استثنائية . كما يتعين عليها القيام بشكل دوري تنظيم تمارين محاكاة بالتنسيق مع المصالح المؤهلة في إطار الوقاية وذلك من أجل التخفيف من آثار الكوارث أو الحالة الاستثنائية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_123> ;
