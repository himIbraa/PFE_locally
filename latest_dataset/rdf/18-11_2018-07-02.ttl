    dzdoc:position 0 ;
    dzdoc:text "يخضع كل استشفاء لكامل الوقت للأشخاص الذين تقل أعمارهم عن ست عشرة (16) سنة أو تتجاوز خمسا وسبعين (75) سنة ، لموافقة اللجنة الولائية للصحة العقلية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_131_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_131> ;
