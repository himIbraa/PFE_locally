<https://legal.dz/resource/law/2018-07-02/18-11#version_art_357> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "ينشأ ، كلما اقتضت الضرورة إلى ذلك، في المؤسسات المرخص لها بنزع الأنسجة والخلايا، بعد أخذ رأي الوكالة الوطنية لزرع الأعضاء ، هيكل يكلف بالحفاظ على الأنسجة ،والخلايا ، تحدد شروط وكيفيات انشائه وسيره عن طريق التنظيم. لا يجوز جمع أعضاء جسم الإنسان من متبرع حي لأغراض الحفظ ، دون موافقة المتبرع أو ممثله الشرعي ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_357_20180702_OpEnact_e2c0d8dae3> ;
    dzdoc:replacementText "ينشأ ، كلما اقتضت الضرورة إلى ذلك، في المؤسسات المرخص لها بنزع الأنسجة والخلايا، بعد أخذ رأي الوكالة الوطنية لزرع الأعضاء ، هيكل يكلف بالحفاظ على الأنسجة ،والخلايا ، تحدد شروط وكيفيات انشائه وسيره عن طريق التنظيم. لا يجوز جمع أعضاء جسم الإنسان من متبرع حي لأغراض الحفظ ، دون موافقة المتبرع أو ممثله الشرعي ."@ar ;
