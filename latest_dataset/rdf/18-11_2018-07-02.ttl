<https://legal.dz/resource/law/2018-07-02/18-11#art_29_defocc_ec1094cd57c0> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 250 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:حماية_الصحة ;
