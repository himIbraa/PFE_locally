    dzdoc:hasArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_370>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_371>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_372>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_373>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_374>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_375>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_376> ;
    dzdoc:heading "أحكام خاصة بالمساعدة الطبية على الإنجاب"@ar ;
    dzdoc:number "الثالث" ;
    dzdoc:position 2 .

dzterm:clinical_studies a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الدراسات العيادية"@ar .

dzterm:compulsory_hospitalization a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "استشفاء إجباريا"@ar,
        "الاستشفاء الإجباري"@ar,
        "للاستشفاء الإجباري"@ar .

dzterm:psychiatrist a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "طبيب أمراض عقلية"@ar,
        "طبيب الأمراض العقلية"@ar,
        "طبيب المؤسسة للأمراض العقلية"@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_1> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_1" ;
    dzdoc:fullText "يحدد هذا القانون الأحكام والمبادئ الأساسية ويهدف إلى تجسيد حقوق وواجبات المواطنين مجال الصحة . ويرمي إلى ضمان الوقاية وحماية صحة الأشخاص والحفاظ عليها واستعادتها وترقيتها ضمن احترام الكرامة والحرية والسلامة والحياة الخاصة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_1_right_0_336931f0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_1_right_1_fbfc46ff> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_1> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_1_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_1_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_1_20180702_OpEnact_57678b6208> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة الأولى" ;
    dzdoc:position 0 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_103> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:mental_health ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_8> ;
    dzdoc:eId "art_103" ;
    dzdoc:fullText "الصحة العقلية هي حالة من الراحة يكون فيها الشخص قادرا على إثبات قدراته، وعلى التغلب على التوترات العادية للحياة وتأدية عمل منتج ومفيد والمساهمة في حياة جماعته. تتولى الدولة تطوير سياسات متعددة القطاعات لحماية الصحة العقلية وترقيتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_103> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_103_defocc_3c7646e46139> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_103_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_103_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_103_20180702_OpEnact_2e76748611> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_103_obligation_0_fee46c0a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 103" ;
    dzdoc:position 102 ;
    dzdoc:usesTerm dzterm:mental_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_11> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_11" ;
    dzdoc:fullText "ينشأ مرصد وطني للصحة يكلف، على أساس المعطيات العلمية والوبائية والديموغرافية والاقتصادية والاجتماعية بالمساهمة في إعداد عناصر السياسة الوطنية للصحة وتحديد الأولويات الصحية التي يجب أن تستفيد من برنامج للصحة العمومية والإدلاء برأيه وتقديم توصيات حول كل المسائل المتعلقة بمجالات الصحة. يعد المرصد تقرير سنويا حول الحالة الصحية للمواطنين يعرضه على الوزير المكلف بالصحة . تحدد تشكيلة المرصد وتنظيمه وسيره، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_11> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_11_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_11_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_11_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_11_20180702_OpEnact_9532a95916> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_11_obligation_0_d598327b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 11" ;
    dzdoc:position 10 ;
    dzdoc:usesTerm dzterm:minister,
        dzterm:national_health_observatory .

<https://legal.dz/resource/law/2018-07-02/18-11#art_110> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_110" ;
    dzdoc:fullText "يجب أن يبين وسم المواد المسوقة كل مكون ذي خطر صحي على المستعمل أو أثر على البيئة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_110> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_110_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_110_20180702_OpEnact_3ee1847ee3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_110_obligation_0_6b3e0aec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "110" ;
    dzdoc:position 109 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_116> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_116" ;
    dzdoc:fullText "يجب أن يتم جمع النفايات ونقلها ومعالجتها قصد حماية صحة المواطنين والمحافظة على البيئة، طبقا للمقاييس المحددة في التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_116> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_116_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_116_20180702_OpEnact_533f950ffb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_116_obligation_0_27137734> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "116" ;
    dzdoc:position 115 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_119> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_119" ;
    dzdoc:fullText "يمكن مصالح الصحة أن تقترح على السلطة المختصة، كل إجراء ضروري ضد نشاطات أو مصالح أو مؤسسات من شأنها أن تسبب ضررا للصحة العمومية، بما في ذلك غلقها مؤقتا كإجراء تحفظ وتتم إعادة فتحها بعد رأي مصالح الصحة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_119_permission_0_14dedb39> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_119> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_119_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_119_20180702_OpEnact_b38d799b67> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "119" ;
    dzdoc:position 117 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_127> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_127" ;
    dzdoc:fullText "يجب على الهياكل المكلفة بعلاج الصحة العقلية للأطفال والمراهقين وحمايتها وترقيتها أن تأخذ في الحسبان خصوصية التكفل بالصحة العقلية لهذه الفئة العمرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_127> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_127_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_127_20180702_OpEnact_0399a2743c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_127_obligation_0_9083cc24> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "127" ;
    dzdoc:position 125 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_152> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_3> ;
    dzdoc:eId "art_152" ;
    dzdoc:fullText "يمكن طبيب الأمراض العقلية للمؤسسة أن يطلب استشفاء إجباريا عند نهاية أو خلال : الاستشفاء في مصلحة مفتوحة، الوضع في الملاحظة أو الاستشفاء بفعل الغير الوضع في الملاحظة الإجبارية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_152_permission_0_9486dc12> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_152> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_152_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_152_20180702_OpEnact_7091810105> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "152" ;
    dzdoc:position 150 ;
    dzdoc:usesTerm dzterm:compulsory_hospitalization,
        dzterm:psychiatrist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_165> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:health_professional ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_1> ;
    dzdoc:eId "art_165" ;
    dzdoc:fullText "يقصد بمهني الصحة في مفهوم هذا القانون، كل شخص ممارس وتابع لهيكل أو مؤسسة للصحة يقدم في نشاطه المهني خدمة صحية أو يساعد فيها أو يساهم في إنجازها. ويعتبر كذلك مهنيي الصحة المستخدمون التابعون للمصالح الخارجية الذين يقومون بمهام تقنية وتحقيقات وبائية ومهام المراقبة والتفتيش. تحدد مدونة مهن الصحة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_165> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_165_defocc_d99d7b00d2a8> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_165_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_165_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_165_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_165_20180702_OpEnact_c30f617bac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "165" ;
    dzdoc:position 163 ;
    dzdoc:usesTerm dzterm:health_professional .

<https://legal.dz/resource/law/2018-07-02/18-11#art_177> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_177" ;
    dzdoc:fullText "يتعين على مهني الصحة الممارس الطبي ، زيادة على التزاماته القانونية الأساسية والتنظيمية، القيام بما يأتي : التصريح للسلطات الصحية بالآثار الثانوية غير المرغوب فيها عند استعمال الأدوية، إخطار السلطة الصحية بكل حدث ذي خطر أو حدث ناتج أو ممكن أن ينتج عن استعمال المستلزمات الطبية لغرض التشخيص أو العلاج أو الوقاية، التصريح للسلطة الصحية بحالات التسممات الحادة أو المزمنة والآثار السامة المحتملة أو المثبتة الناتجة عن منتوجات أو مواد طبيعية أو تركيبية، المشاركة في كل عمل إعلامي وتقييمي حول الاستعمال الجيد للمواد الصيدلانية واللجوء لليقظة بخصوص المواد الصيدلانية والعتاد، مسك الملف الطبي للمريض وتحيينه، المشاركة في اقتصاد الصحة، السهر على احترام الممارسات الحسنة للوصف."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_177> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_177_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_177_20180702_OpEnact_10d0efda6f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_177_obligation_0_f61026a0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 177" ;
    dzdoc:position 174 ;
    dzdoc:usesTerm dzterm:health_professional,
        dzterm:medical_practitioner .

<https://legal.dz/resource/law/2018-07-02/18-11#art_197> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_5> ;
    dzdoc:eId "art_197" ;
    dzdoc:fullText "يتعين على الممارسين الطبيين المتخصصين أداء التزام الخدمة المدنية بالهياكل والمؤسسات العمومية للصحة ، قبل أن يمارسوا في القطاع الخاص أو بصفة حرة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_197> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_197_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_197_20180702_OpEnact_83e7106160> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_197_obligation_0_96c19182> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 197" ;
    dzdoc:position 194 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_197_condition_0_f919f01a> ;
    dzdoc:usesTerm dzterm:civil_service,
        dzterm:medical_practitioners .

<https://legal.dz/resource/law/2018-07-02/18-11#art_200> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_6> ;
    dzdoc:eId "art_200" ;
    dzdoc:fullText "في حالة وفاة مشبوهة أو عنيفة أو وفاة في الشارع وفي حالة وفاة بمرض منتقل يمثل خطرا كبيرا على الصحة العمومية ، لا يسلم الطبيب المعني إلا شهادة لإثبات الوفاة، ويخطر السلطات المختصة بذلك للقيام بالفحص الطبي الشرعي للجنة، مع احترام الإجراءات التنظيمية المعمول بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_200> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_200_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_200_20180702_OpEnact_407f668077> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_200_obligation_0_e2ad5758> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "200" ;
    dzdoc:position 197 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_200_condition_0_338f483d> ;
    dzdoc:usesTerm dzterm:public_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_204> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_6> ;
    dzdoc:eId "art_204" ;
    dzdoc:fullText "لا يتم الدفن إلا على أساس شهادة طبية لإثبات الوفاة يعدها طبيب حسب الكيفيات المحددة عن طريق التنظيم . تبين هذه الشهادة المحررة حسب نموذج تعده الإدارة المختصة، سبب أو أسباب الوفاة وعند الاقتضاء، المعلومات المفيدة لـ الصحة العمومية وفق شروط تضمن سريتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_204> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_204_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_204_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_204_20180702_OpEnact_f1b6772ea0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_204_obligation_0_68f42699> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "204" ;
    dzdoc:position 201 ;
    dzdoc:usesTerm dzterm:public_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_211> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:counterfeit_drug ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_2> ;
    dzdoc:eId "art_211" ;
    dzdoc:fullText "يقصد بدواء مقلد ، في مفهوم هذا القانون، كل دواء معرف في المادة 208 أعلاه، يتضمن خطأ في التقديم بالنسبة: لهويته، بما في ذلك رزمه ووسمه، اسمه أو تكوينه، ويخص ذلك كل مكون من مكوناته بما في ذلك السواغات و مقدار هذه المكونات. لمصدره، بما في ذلك صانعه ، بلد صنعه أو بلد منشئه، لتاريخه، بما في ذلك التراخيص والتسجيلات والوثائق المتعلقة بمسارات التوزيع المستعملة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_211> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_211_defocc_23319352aa31> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_211_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_211_20180702_OpEnact_a37b77d00c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 211" ;
    dzdoc:position 208 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_208> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_208> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_220> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_3> ;
    dzdoc:eId "art_220" ;
    dzdoc:fullText "يجب أن تكون المؤسسة الصيدلانية مستغلة و/أو حائزة على مقرر تسجيل الدواء في الجزائر، قصد ضمان وفرة وجودة المنتوج الصيدلاني المصنوع و/أو المستورد طبقا للشروط المنصوص عليها في المادة 219 أعلاه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_220> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_220_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_220_20180702_OpEnact_eeabc05855> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_220_obligation_0_05f17337> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "220" ;
    dzdoc:position 217 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_219> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_219> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_225> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_4> ;
    dzdoc:eId "art_225" ;
    dzdoc:fullText "تضمن الوكالة على الخصوص، مهمة خدمة عمومية في مجال تسجيل المواد الصيدلانية والمستلزمات الطبية ذات الاستعمال البشري، والمصادقة عليها ومراقبتها . تحدد مهام هذه الوكالة وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_225> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_225_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_225_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_225_20180702_OpEnact_f58d49c7b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_225_obligation_0_d753cf43> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 225" ;
    dzdoc:position 222 ;
    dzdoc:usesTerm dzterm:الوكالة .

<https://legal.dz/resource/law/2018-07-02/18-11#art_229> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_4> ;
    dzdoc:eId "art_229" ;
    dzdoc:fullText "تضمن المؤسسات المختصة في هذا المجال اليقظة الصيدلانية واليقظة بخصوص العتاد والسموم بشأن المواد الصيدلانية والمستلزمات الطبية المستعملة في الطب البشري . وتقدم هذه المؤسسات مساعدتها للوكالة الوطنية للمواد الصيدلانية . يحدد إنشاء هذه المؤسسات وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_229> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_229_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_229_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_229_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_229_20180702_OpEnact_9fa46edc7c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_229_obligation_0_c7fb75eb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 229" ;
    dzdoc:position 226 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_223> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_223> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_23> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_3> ;
    dzdoc:eId "art_23" ;
    dzdoc:fullText "يجب إعلام كل شخص بشأن حالته الصحية والعلاج الذي تتطلبه والأخطار التي يتعرض لها . تمارس حقوق الأشخاص القصر أو عديمي الأهلية من طرف الأولياء أو الممثل الشرعي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_23> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_23_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_23_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_23_20180702_OpEnact_251c428e17> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_23_obligation_0_8c357934> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "23" ;
    dzdoc:position 22 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_240> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_6> ;
    dzdoc:eId "art_240" ;
    dzdoc:fullText "يرخص الإشهار للمواد الصيدلانية غير الخاضعة للوصف الإجباري الموجه لمهنيي الصحة ، و يخضع للتأشيرة التقنية لمصالح الوزارة المكلفة بالصحة التي تحدد قائمة هذه المواد ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_240_permission_0_66c84ce8> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_240_right_0_2e2b91f6> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_240> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_240_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_240_20180702_OpEnact_3c78a65125> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_240_obligation_0_fc2c8f3c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 240" ;
    dzdoc:position 237 ;
    dzdoc:usesTerm dzterm:health_minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_246> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_9> ;
    dzdoc:eId "art_246" ;
    dzdoc:fullText "يتعين على المؤسسات العمومية والخاصة للصحة أن تتوفر على صيدلية استشفائية . ويخصص نشاط الصيدلية الاستشفائية للمرضى الذين يعالجون في هذه المؤسسات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_246> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_246_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_246_20180702_OpEnact_9978b72725> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_246_obligation_0_75cf76f5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 246" ;
    dzdoc:position 243 ;
    dzdoc:usesTerm dzterm:hospital_pharmacy,
        dzterm:public_private_health_institutions .

<https://legal.dz/resource/law/2018-07-02/18-11#art_250> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_10> ;
    dzdoc:eId "art_250" ;
    dzdoc:fullText "يمكن أن يساعد الصيدلي صيدلي مساعد أو عدة صيادلة مساعدين. ويمارس الصيدلي المساعد ، تحت مسؤوليته، نشاطاته الصيدلانية. تحدد شروط ممارسة مهنة الصيدلي و الصيدلي المساعد وكيفيات تنظيمها عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_250_permission_0_dcd69add> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_250> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_250_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_250_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_250_20180702_OpEnact_8c841c5ea0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 250" ;
    dzdoc:position 247 ;
    dzdoc:usesTerm dzterm:assistant_pharmacist,
        dzterm:pharmacist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_251> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_11> ;
    dzdoc:eId "art_251" ;
    dzdoc:fullText "يرخص ل مخابر البيولوجيا الطبية و مخابر التشريح المرضي للخلايا دون سواها، بالقيام بالفحوصات التي تساهم في تشخيص الأمراض البشرية أو علاجها أو الوقاية منها أو التي تبين كل تغيير آخر في الحالة الفيزيولوجية للمرضى . تخص الفحوصات البيولوجية، على الخصوص، التخصصات البيولوجية القاعدية والمتمثلة في البيو- كيمياء وبيولوجيا الدم وعلم الطفيليات والبيولوجيا المجهرية وعلم المناعة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_251_permission_0_eb3c972a> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_251_right_0_bd5e8605> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_251> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_251_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_251_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_251_20180702_OpEnact_26ac92ae73> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 251" ;
    dzdoc:position 248 ;
    dzdoc:usesTerm dzterm:medical_biology_labs,
        dzterm:pathology_labs .

<https://legal.dz/resource/law/2018-07-02/18-11#art_260> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_12> ;
    dzdoc:eId "art_260" ;
    dzdoc:fullText "يجب أن يتم نشاط نقل الدم طبقا لممارسات الحسنة في مجال الجمع والتحضير والتصنيف والتخزين والتوزيع قصد تسليم مواد تستجيب لمقاييس الجودة المطلوبة، كما هي محددة في التنظيم المعمول به ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_260> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_260_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_260_20180702_OpEnact_eb2aa553ba> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_260_obligation_0_4b588514> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 260" ;
    dzdoc:position 257 ;
    dzdoc:usesTerm dzterm:blood_transfusion_activity .

<https://legal.dz/resource/law/2018-07-02/18-11#art_261> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_12> ;
    dzdoc:eId "art_261" ;
    dzdoc:fullText "يجب مراقبة الدم الذي يتم نزعه قصد البحث عن عدم وجود عوامل مسببة للأمراض أو العدوى . ويخضع، وجوبا، لاختبارات بغرض ضمان المطابقة في مجال نقل الدم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_261> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_261_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_261_20180702_OpEnact_dd26325e43> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_261_obligation_0_ce943735>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_261_obligation_1_31021eab> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 261" ;
    dzdoc:position 258 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_266> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_1> ;
    dzdoc:eId "art_266" ;
    dzdoc:fullText "تتولى المنظومة الوطنية للصحة التكفل بالأحواض السكانية، عبر انتشار القطاع العمومي للصحة على كامل التراب الوطني ، مع الأخذ في الحسبان تسلسل العلاج وتكامل نشاطات المؤسسات المنظمة في شكل شبكة أو في أي شكل آخر من أشكال التعاون. وتكون مهيكلة حول مؤسسات وهياكل صحية عمومية وخاصة وكل مؤسسة أخرى تساهم في صحة الأشخاص."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_266> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_266_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_266_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_266_20180702_OpEnact_0006aebbef> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_266_obligation_0_eaec5ce7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "266" ;
    dzdoc:position 263 ;
    dzdoc:usesTerm dzterm:national_health_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_267> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_1> ;
    dzdoc:eId "art_267" ;
    dzdoc:fullText "تتمثل مهام المصالح الخارجية التابعة للوزارة المكلفة بالصحة، على الخصوص، في توزيع الموارد وتنسيق برامج الصحة الوطنية والجهوية والمحلية ومتابعتها وتنفيذها. وتتخذ أيضا كل التدابير التي من شأنها تأطير النشاطات في مجال الصحة. يحدد تنظيم المصالح الخارجية ومهامها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_267> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_267_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_267_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_267_20180702_OpEnact_28e303b894> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "267" ;
    dzdoc:position 264 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_276> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3> ;
    dzdoc:eId "art_276" ;
    dzdoc:fullText "تخضع هياكل ومؤسسات الصحة أو ذات الطابع الصحي غير التابعة لوزارة الصحة، للترخيص والمراقبة التقنية من الوزير المكلف بالصحة وفق كيفيات تحدد عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_276> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_276_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_276_20180702_OpEnact_3d72378c30> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_276_obligation_0_364495fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "276" ;
    dzdoc:position 273 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_277> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3> ;
    dzdoc:eId "art_277" ;
    dzdoc:fullText "يعد تنظيم مصالح الصحة وسيرها وتقييمها من اختصاص وسلطة الوزير المكلف بالصحة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_277> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_277_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_277_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_277_20180702_OpEnact_91875e8b29> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "277" ;
    dzdoc:position 274 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_277> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_277> ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_295> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_295" ;
    dzdoc:fullText "يجب على الهياكل والمؤسسات العمومية والخاصة للصحة ضمان النظام والانضباط والأمن داخلها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_295> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_295_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_295_20180702_OpEnact_886fa63fdb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_295_obligation_0_65e22b41> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "295" ;
    dzdoc:position 292 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_3> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_3" ;
    dzdoc:fullText "تتمثل الأهداف في مجال الصحة في حماية صحة المواطنين عبر المساواة في الحصول على العلاج وضمان استمرارية الخدمة العمومية للصحة و الأمن الصحي . ترتكز نشاطات الصحة على مبادئ تسلسل وتكامل نشاطات الوقاية والعلاج وإعادة تكييف مختلف هياكل ومؤسسات الصحة."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_3_right_0_58707134> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_3_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_3_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_3_20180702_OpEnact_43ec458208> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 3" ;
    dzdoc:position 2 ;
    dzdoc:usesTerm dzterm:health_security,
        dzterm:public_service .

<https://legal.dz/resource/law/2018-07-02/18-11#art_314> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_314" ;
    dzdoc:fullText "يمكن السحب المؤقت أو النهائي لترخيص الاستغلال المنصوص عليه في المادة 307 أعلاه ، عند: عدم احترام الشروط التنظيمية التقنية للتسيير، معاينة مخالفات القوانين والأنظمة في الهياكل والمؤسسات الخاصة للصحة، عدم ضمان أمن المرضى."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_314_permission_0_15c88df2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_314> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_314_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_314_20180702_OpEnact_27157622de> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 314" ;
    dzdoc:position 311 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_307> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_307> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_314_condition_0_1ec2ff5a> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_318> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_5> ;
    dzdoc:eId "art_318" ;
    dzdoc:fullText "يخضع كل شكل من أشكال اتفاقية و/أو عقد خدمات ، أو علاج أو بحث في مجال الصحة، المبرم بين هياكل ومؤسسات الصحة والأشخاص أو الهيئات الأجنبية، إلى ترخيص من المصالح المختصة للوزارة المكلفة بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_318> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_318_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_318_20180702_OpEnact_5c35e6cbbd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_318_obligation_0_7388ae97> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 318" ;
    dzdoc:position 315 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_328> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_7> ;
    dzdoc:eId "art_328" ;
    dzdoc:fullText "يجب أن يكون تقييم الممارسات المهنية مطابقا لقواعد الأدبيات الطبية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_328> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_328_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_328_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_328_20180702_OpEnact_750d91e122> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_328_obligation_0_8b9deb10> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "328" ;
    dzdoc:position 325 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_346> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_346" ;
    dzdoc:fullText "تنشأ مجالس وطنية وجهوية للأدبيات الطبية مختصة على التوالي، إزاء الأطباء وأطباء الأسنان والصيادلة. تتشكل المجالس الوطنية والمجالس الجهوية للأدبيات الطبية حصريا من أعضاء ينتخبون من طرف نظرائهم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_346> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_346_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_346_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_346_20180702_OpEnact_aaa7c292e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 346" ;
    dzdoc:position 343 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_35> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2> ;
    dzdoc:eId "art_35" ;
    dzdoc:fullText "يتعين على الوالي و رئيس المجلس الشعبي البلدي ومسؤولي الهيئات العمومية والخاصة، في إطار اختصاصهم وبالاتصال مع مصالح الصحة، تنفيذ التدابير والوسائل الضرورية بشكل دائم لمكافحة الأمراض المتوطنة وتفادي ظهور الأوبئة والقضاء على أسباب الوضعية الوبائية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_35> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_35_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_35_20180702_OpEnact_3e55fb8476> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_35_obligation_0_b2623286> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "35" ;
    dzdoc:position 34 ;
    dzdoc:usesTerm dzterm:p_apc,
        dzterm:wali .

<https://legal.dz/resource/law/2018-07-02/18-11#art_378> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_378" ;
    dzdoc:fullText "يجب أن تراعي الدراسات العيادية ، وجوبا، المبادئ الأخلاقية والعلمية والأخلاقيات والأدبيات التي تحكم الممارسة الطبية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_378> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_378_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_378_20180702_OpEnact_b6fec7dd90> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_378_obligation_0_75c967e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "378" ;
    dzdoc:position 375 ;
    dzdoc:usesTerm dzterm:clinical_studies .

<https://legal.dz/resource/law/2018-07-02/18-11#art_385> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_385" ;
    dzdoc:fullText "تكون الدراسات العيادية موضوع بروتوكول يحرره ويوفره المرقي ويوقعه الطبيب الباحث، بعد إبداء موافقته بالتعبير عن قبوله للبروتوكول والتزامه باحترام شروط الإنجاز. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_385> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_385_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_385_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_385_20180702_OpEnact_c1f987a1a5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_385_obligation_0_5e9c67fe> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "385" ;
    dzdoc:position 382 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_385_condition_0_5b1786f2> ;
    dzdoc:usesTerm dzterm:clinical_studies,
        dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_389> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_389" ;
    dzdoc:fullText "تحدد الإجراءات التي تضبط المقاييس والمناهج المطبقة على دراسات المواد الصيدلانية والمستلزمات الطبية، عن طريق التنظيم. يمكن الوزير المكلف بالصحة تسليم المرقي ، بطلب منه، ترخيصا لاستيراد أي عتاد ضروري للقيام بالدراسات العيادية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_389_permission_0_16febb28> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_389> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_389_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_389_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_389_20180702_OpEnact_2ca0f17a20> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 389" ;
    dzdoc:position 386 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_397> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_397" ;
    dzdoc:fullText "يتعين على المرقي في الدراسات العيادية التدخلية، اكتتاب تأمين يغطي مسؤوليته المدنية والمهنية بخصوص النشاط الذي يقوم به ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_397> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_397_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_397_20180702_OpEnact_20059a5b6d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_397_obligation_0_a79c315c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 397" ;
    dzdoc:position 394 ;
    dzdoc:usesTerm dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_402> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_402" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادتين 51 و 60 من هذا القانون، المتعلقتين على التوالي، بالترويج والرعاية والإشهار للتبغ والمشروبات الكحولية، بغرامة من 500.000 دج إلى 1.000.000 دج . وفي حالة العود، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_402> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_402_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_402_20180702_OpEnact_8f0ce8bfe8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_402_obligation_0_829576a7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
