    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_3_20180702_OpEnact_43ec458208> ;
    dzdoc:replacementText "تتمثل الأهداف في مجال الصحة في حماية صحة المواطنين عبر المساواة في الحصول على العلاج وضمان استمرارية الخدمة العمومية للصحة و الأمن الصحي . ترتكز نشاطات الصحة على مبادئ تسلسل وتكامل نشاطات الوقاية والعلاج وإعادة تكييف مختلف هياكل ومؤسسات الصحة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_3> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
