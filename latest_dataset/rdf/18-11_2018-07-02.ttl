    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من قام بصنع الأدوية المقلدة المحددة في المادة 211 من هذا القانون، أو السمسرة لها أو توزيعها أو الإشهار لها أو عرضها للبيع أو بيعها أو استيرادها أو تصديرها أو حيازتها، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 1.000.000 دج إلى 5.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_426_20180702_OpEnact_122bafeecd> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
