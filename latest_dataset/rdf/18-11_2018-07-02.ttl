<https://legal.dz/resource/law/2018-07-02/18-11#art_307_condition_1_b1d8fc94> a dznorm:Condition ;
    dznorm:conditionText "كما يخضع إلى الترخيص من الوزير المكلف بالصحة اقتناء كل تجهيز صحي يخضع تنصيبه واستغلاله لمراقبة مسبقة تخص احترام المقاييس التقنية والممارسة، وكذا النشاطات الخاضعة لمقاييس أو أحكام خاصة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_307> ;
