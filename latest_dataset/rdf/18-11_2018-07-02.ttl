<https://legal.dz/resource/law/2018-07-02/18-11#art_246_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_246> ;
    dzdoc:position 0 ;
    dzdoc:text "يتعين على المؤسسات العمومية والخاصة للصحة أن تتوفر على صيدلية استشفائية. ويخصص نشاط الصيدلية الاستشفائية للمرضى الذين يعالجون في هذه المؤسسات."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_247_obligation_0_5af50cf0> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
