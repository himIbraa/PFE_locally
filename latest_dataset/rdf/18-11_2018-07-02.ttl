<https://legal.dz/resource/law/2018-07-02/18-11#art_404> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_404" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 56 من هذا القانون، المتعلقة بالتدخين في الأماكن المخصصة لاستعمال جماعي أو المستقبلة للجمهور، بغرامة من 2000 دج إلى 5000 دج . تطبق على المخالفة المنصوص عليها في الفقرة أعلاه، غرامة صلح طبقا لأحكام المادتين 381 و 393 من قانون الإجراءات الجزائية وفي حالة العود، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_404> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_404_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_404_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_404_20180702_OpEnact_fc76fbfcae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_404_obligation_0_29fc5714> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 404" ;
    dzdoc:position 401 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_56> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_404_extref_4dd82f83>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_404_extref_d3106ea7> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_56> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_404_condition_0_496e33b9> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_406> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_406" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 61 من هذا القانون، المتعلقة ببيع المشروبات الكحولية للقصر، بالحبس من ستة (6) أشهر إلى سنتين (2) وبغرامة من 50.000 دج إلى 100.000 دج . و في حالة العود، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_406> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_406_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_406_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_406_20180702_OpEnact_ba8c7fee37> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_406_obligation_0_9c7a8c10> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 406" ;
    dzdoc:position 403 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_61> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_61> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_406_condition_0_2f1bef64> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_44> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_44" ;
    dzdoc:fullText "إن طبيب المصلحة المكلفة بالمراقبة الصحية بالحدود هو السلطة الوحيدة المختصة على مستوى نقطة الدخول. ويجب أن يكون محلفا وفقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_44> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_44_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_44_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_44_20180702_OpEnact_05bbdd13af> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_44_obligation_0_95570ed7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 44" ;
    dzdoc:position 43 ;
    dzdoc:usesTerm dzterm:border_health_officer .

<https://legal.dz/resource/law/2018-07-02/18-11#art_440> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_440" ;
    dzdoc:fullText "يمكن أن يعاقب، علاوة على ذلك، كل من يرتكب إحدى المخالفات المذكورة أعلاه، بعقوبة واحدة أو أكثر من العقوبات التكميلية المنصوص عليها في قانون العقوبات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_440_permission_0_bc422a0c> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_440> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_440_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_440_20180702_OpEnact_66d67a3cad> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 440" ;
    dzdoc:position 437 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_46> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_46" ;
    dzdoc:fullText "تدعم الدولة والجماعات المحلية نشاطات التربية الصحية والتربية البدنية والرياضية، وتشجع الأشخاص على مكافحة السلوكات التي تعرض للخطر، وعلى الوقاية من الأمراض غير المنتقلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_46> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_46_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_46_20180702_OpEnact_d4727954af> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_46_obligation_0_82f044d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 46" ;
    dzdoc:position 45 ;
    dzdoc:usesTerm dzterm:non_communicable_diseases .

<https://legal.dz/resource/law/2018-07-02/18-11#art_47> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_47" ;
    dzdoc:fullText "ينشأ سجل مخصص لجمع وحفظ وتفسير المعلومات المتعلقة بالمرضى المصابين ببعض الأمراض غير المنتقلة ، مع الحفاظ على السر الطبي . يحدد قائمة هذه الأمراض الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_47_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_47_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_47_20180702_OpEnact_0126ff2fa7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_47_obligation_0_9da934b5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 47" ;
    dzdoc:position 46 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:non_communicable_diseases .

<https://legal.dz/resource/law/2018-07-02/18-11#art_84> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_2> ;
    dzdoc:eId "art_84" ;
    dzdoc:fullText "تعد حماية وترقية صحة المراهقين والشباب أولوية للدولة. يتولى الوزير المكلف بالصحة ، بالتعاون مع المصالح المعنية، إعداد وتنفيذ برامج نوعية ومكيفة مع الاحتياجات الصحية للمراهقين والشباب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_84> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_84_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_84_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_84_20180702_OpEnact_b1e6443bae> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_84_obligation_0_8282a676>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_84_obligation_1_9e1b2abf> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "84" ;
    dzdoc:position 83 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_86> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_86" ;
    dzdoc:fullText "تتولى الدولة إعداد وتنفيذ برامج الحماية صحة الأشخاص المسنين . يستفيد الأشخاص المسنون، لا سيما المصابون بأمراض مزمنة أو المعوقون من كل الخدمات المتعلقة بالعلاج وإعادة التكييف والتكفل النفسي التي تتطلبها حالتهم الصحية ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_86_right_0_7a1df06a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_86> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_86_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_86_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_86_20180702_OpEnact_96f1829f83> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_86_obligation_0_1f7b19fb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 86" ;
    dzdoc:position 85 ;
    dzdoc:usesTerm dzterm:state .

<https://legal.dz/resource/law/2018-07-02/18-11#art_94> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_5> ;
    dzdoc:eId "art_94" ;
    dzdoc:fullText "تضمن الدولة حماية وترقية الصحة في الوسط التربوي والجامعي و في التكوين المهني، عبر أعمال وبرامج صحية ملائمة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_94> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_94_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_94_20180702_OpEnact_ff27a22ff5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_94_obligation_0_3d5d6136> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "94" ;
    dzdoc:position 93 ;
    dzdoc:usesTerm dzterm:health,
        dzterm:state .

