<https://legal.dz/resource/law/2018-07-02/18-11#version_art_251> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرخص ل مخابر البيولوجيا الطبية و مخابر التشريح المرضي للخلايا دون سواها، بالقيام بالفحوصات التي تساهم في تشخيص الأمراض البشرية أو علاجها أو الوقاية منها أو التي تبين كل تغيير آخر في الحالة الفيزيولوجية للمرضى . تخص الفحوصات البيولوجية، على الخصوص، التخصصات البيولوجية القاعدية والمتمثلة في البيو- كيمياء وبيولوجيا الدم وعلم الطفيليات والبيولوجيا المجهرية وعلم المناعة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_251_20180702_OpEnact_26ac92ae73> ;
    dzdoc:replacementText "يرخص ل مخابر البيولوجيا الطبية و مخابر التشريح المرضي للخلايا دون سواها، بالقيام بالفحوصات التي تساهم في تشخيص الأمراض البشرية أو علاجها أو الوقاية منها أو التي تبين كل تغيير آخر في الحالة الفيزيولوجية للمرضى . تخص الفحوصات البيولوجية، على الخصوص، التخصصات البيولوجية القاعدية والمتمثلة في البيو- كيمياء وبيولوجيا الدم وعلم الطفيليات والبيولوجيا المجهرية وعلم المناعة."@ar ;
