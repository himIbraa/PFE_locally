<https://legal.dz/resource/law/2018-07-02/18-11#art_413_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_413> ;
    dzdoc:position 0 ;
    dzdoc:text "باستثناء الضرورة الطبية المبررة، يعاقب طبقا لأحكام المواد 288 و 289 و 442 الفقرة (2) من قانون العقوبات، كل مهني الصحة، عن كل تقصير أو خطأ مهني تم إثباته، يرتكبه خلال ممارسته مهامه أو بمناسبة القيام بها ويلحق ضررا بالسلامة البدنية لأحد الأشخاص أو بصحته أو يحدث له عجزا مستديما أو يعرض حياته للخطر أو يتسبب في وفاته."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_414_condition_0_e12d2793> a dznorm:Condition ;
    dzdoc:hasReference <https://legal.dz/resource/law/2018-07-02/18-11#art_414_condition_0_e12d2793_ref_958814f7fa8a>,
