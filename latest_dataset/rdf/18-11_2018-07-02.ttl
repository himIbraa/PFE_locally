    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_64> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تتولى الدولة ترقية أنماط استهلاك تشجع على تغذية صحية ومتوازنة لدى المواطنين ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_65_20180702_OpEnact_759b942ea9> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_65> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_65> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_65> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تسهر الدولة على وضع واحترام مقاييس في مجال التغذية ، عبر برامج التربية والإعلام والتحسيس والاتصال."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_66_20180702_OpEnact_a12cc760a3> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_66> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_66> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_66> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تتخذ الدولة، على كل المستويات، التدابير الضرورية التي تسمح بالوقاية من السمنة لدى المواطنين ، ولا سيما لدى الأطفال."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_67_20180702_OpEnact_e69b6df630> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_67> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_67> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_67> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تتولى الدولة، بواسطة برامج ملائمة ترقية الممارسة الفردية والجماعية للتربية البدنية والرياضية والرياضات التي تشكل أحد العوامل الأساسية لحماية صحة الشخص والمواطنين وتحسينها ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_68_20180702_OpEnact_921b92a3da> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_68> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_68> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_68> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تكيف برامج النشاطات المنصوص عليها في المادة 67 أعلاه، حسب السن والجنس والحالة الصحية والظروف المعيشية للمواطنين وعملهم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_69_20180702_OpEnact_bb7503b01b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_69> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_69> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_69> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تضمن حماية صحة الأم والطفل بواسطة كل التدابير الطبية والنفسية والاجتماعية والتربوية والإدارية التي تهدف، لا سيما إلى ما يأتي : حماية صحة الأم قبل وأثناء وبعد الحمل، ضمان الظروف الصحية للطفل ونموه."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_6_20180702_OpEnact_e279007bdc> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_6> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_6> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_6> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تهدف المنظومة الوطنية للصحة إلى التكفل باحتياجات المواطنين في مجال الصحة بصفة شاملة ومنسجمة ومستمرة. ويرتكز تنظيمها وسيرها على مبادئ الشمولية والمساواة في الحصول على العلاج والتضامن والعدل واستمرارية الخدمة العمومية والخدمات الصحية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_70_20180702_OpEnact_f5d18c0ff6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_70> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_70> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_70> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تشكل برامج مكافحة الوفيات لدى الأم والطفل أولوية لـ الصحة العمومية ، وتنفذها هياكل ومؤسسات الصحة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_71_20180702_OpEnact_e86c6fe89a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_71> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_71> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_71> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يشكل التنظيم العائلي أولوية لـ الصحة العمومية . ويساهم في الحفاظ على صحة الأم والطفل. وتعده هياكل ومؤسسات الصحة وتنفذه عبر كل التدابير والترتيبات الصحية والاجتماعية والتربوية وكذا الاتصال والتحسيس."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_72_20180702_OpEnact_4c7d132a42> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_72> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_72> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_72> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "الفحص الطبي السابق للزواج إجباري . تحدد قائمة الفحوص والتحاليل عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_73_20180702_OpEnact_b1875ac52b> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_73> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_73> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_73> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يجب على مهنيي الصحة التصريح بالمرأة الحامل ، ويتم تسجيلها ابتداء من الثلاثي الثالث من الحمل، حسب اختيارها لدى عيادة ولادة عمومية أو خاصة. وتوفر الدولة الوسائل الملائمة لضمان المتابعة الدورية والإجبارية للحمل . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_74_20180702_OpEnact_3377568262> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_74> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_74> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_74> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يتم قبول النساء الحوامل في وضع صعب، الشهر السابع (7) على الأقل، بناء على طلبهن في هياكل ومؤسسات الصحة العمومية المتوفرة على أسرة الولادة ، عندما يستوجب استشفاؤهن ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_75_20180702_OpEnact_c2f138198e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_75> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_75> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_75> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تعد الوزارة المكلفة بالصحة برامج الكشف والتشخيص تخص المواليد حديثي الولادة، ويتم تنفيذها من طرف مؤسسات الصحة. تحدد قائمة الأمراض التي يجب كشفها عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_76_20180702_OpEnact_a9af52514f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_76> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_76> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_76> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يمكن إجراء التشخيص ما قبل الولادة بأمر طبي من أجل اكتشاف مرض بالغ الخطورة للمضغة أو الجنين داخل الرحم. ويتم ضمان التشخيص ما قبل الولادة في هياكل مؤهلة أو معتمدة لهذا الغرض. تحدد شروط اعتماد هذه الهياكل عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_77_20180702_OpEnact_89b4f34f67> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_77> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_77> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_77> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يهدف الإيقاف العلاجي للحمل إلى حماية صحة الأم عندما تكون حياتها أو توازنها النفسي والعقلي مهددين بخطر بسبب الحمل . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_78_20180702_OpEnact_d25ed5286e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_78> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_78> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_78> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "لا يمكن إجراء الإيقاف العلاجي للحمل إلا في المؤسسات العمومية الاستشفائية ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_79_20180702_OpEnact_9fa504daa2> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
