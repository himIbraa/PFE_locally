    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "90" ;
    dzdoc:position 89 ;
    dzdoc:usesTerm dzterm:persons_in_difficult_situation .

<https://legal.dz/resource/law/2018-07-02/18-11#art_93> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_4> ;
    dzdoc:eId "art_93" ;
    dzdoc:fullText "تضمن الدولة الشروط الخاصة المتعلقة بالمراقبة والتكفل في مجال صحة الأطفال الموضوعين في المؤسسات، لا سيما منها تلك التابعة لـ الوزارة المكلفة بالتضامن الوطني . يجب أن يستفيد الأطفال المذكورون في الفقرة أعلاه ، من جميع التدابير الصحية والاجتماعية والتربوية الملائمة لنموهم المنسجم و اندماجهم في الأسرة والمجتمع."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_93> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_93_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_93_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_93_20180702_OpEnact_519da0cd4e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_93_obligation_0_ba4b3617> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "93" ;
    dzdoc:position 92 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_93> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_93> ;
    dzdoc:usesTerm dzterm:ministry_solidarity .

<https://legal.dz/resource/law/2018-07-02/18-11#art_96> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_5> ;
    dzdoc:eId "art_96" ;
    dzdoc:fullText "تضع وزارة الصحة بالتنسيق مع وزارات التربية والتكوين المهني والتعليم العالي، هياكل كشف ومتابعة . وتضمن الجماعات المحلية والمؤسسات التابعة للوزارات المذكورة في الفقرة أعلاه، الوسائل لذلك . تسند نشاطات الكشف عن صحة التلاميذ والطلبة والمتربصين ومتابعتها إلى المستخدمين الطبيين. بما فيهم النفسانيون وشبه الطبيين المعينين في هياكل الكشف والمتابعة المنشأة لهذا الغرض، بالتعاون مع مؤسسات التربية والتعليم العالي والتكوين المهني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_96> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_96_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_96_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_96_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_96_20180702_OpEnact_fc76913143> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_96_obligation_0_bda72ea7>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_96_obligation_1_03b69665> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "96" ;
    dzdoc:position 95 ;
    dzdoc:usesTerm dzterm:health_ministry,
        dzterm:local_authorities .

