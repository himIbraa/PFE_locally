<https://legal.dz/resource/law/2018-07-02/18-11#version_art_346> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ مجالس وطنية وجهوية للأدبيات الطبية مختصة على التوالي، إزاء الأطباء وأطباء الأسنان والصيادلة. تتشكل المجالس الوطنية والمجالس الجهوية للأدبيات الطبية حصريا من أعضاء ينتخبون من طرف نظرائهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_346_20180702_OpEnact_aaa7c292e9> ;
    dzdoc:replacementText "تنشأ مجالس وطنية وجهوية للأدبيات الطبية مختصة على التوالي، إزاء الأطباء وأطباء الأسنان والصيادلة. تتشكل المجالس الوطنية والمجالس الجهوية للأدبيات الطبية حصريا من أعضاء ينتخبون من طرف نظرائهم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_346> ;
