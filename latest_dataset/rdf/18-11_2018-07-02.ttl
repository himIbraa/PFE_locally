    dzdoc:text "وتسهر على احترام مقاييس حفظ الصحة والأمن في الوسط المؤسساتي بالتعاون مع المصالح المعنية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_91_obligation_0_8ad4e4d7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
