<https://legal.dz/resource/law/2018-07-02/18-11#version_art_252> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرخص الحائزون على شهادة الدراسات الطبية المتخصصة في البيولوجيا العيادية باستغلال مخبر للتحاليل البيولوجية الطبية . الأشخاص المذكورون في الفقرة الأولى أعلاه ، مسؤولون على مخابرهم، وكذا على نشاطهم الذي يجب عليهم ممارسته شخصيا وفعليا ضمن الشروط المحددة عن طريق التنظيم ."@ar ;
