<https://legal.dz/resource/law/2018-07-02/18-11#version_art_145> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون النائب العام لدى المجلس القضائي أو الوالي مؤهلين، دون سواهما، لاتخان قرار الفحص الإجباري في طب الأمراض العقلية . لا يمكن الوالي أو النائب العام طلب فحص إجباري في طب الأمراض العقلية لأحد أعضاء أسرتيهما ، لاسيما الأصول أو الفروع المباشرين، الزوج أو الأخ أو الأخت أو العم أو الخال أو العمة أو الخالة أو الأقارب الحواشي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_145_20180702_OpEnact_05d24cdf9a> ;
    dzdoc:replacementText "يكون النائب العام لدى المجلس القضائي أو الوالي مؤهلين، دون سواهما، لاتخان قرار الفحص الإجباري في طب الأمراض العقلية . لا يمكن الوالي أو النائب العام طلب فحص إجباري في طب الأمراض العقلية لأحد أعضاء أسرتيهما ، لاسيما الأصول أو الفروع المباشرين، الزوج أو الأخ أو الأخت أو العم أو الخال أو العمة أو الخالة أو الأقارب الحواشي."@ar ;
