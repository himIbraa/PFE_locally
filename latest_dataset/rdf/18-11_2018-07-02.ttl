<https://legal.dz/resource/law/2018-07-02/18-11#version_art_114> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع حماية صحة السكان للشروط والمقاييس التقنية في المجال طبقا للتشريع والتنظيم المعمول بهما، إنتاج المواد والمستحضرات المشعة ومعالجتها وحيازتها ونقلها واستعمالها وكذلك حيازة النفايات التي تحتوي على مادة مشعة وجمعها وتخزينها ونقلها ومعالجتها وإزالتها وتصريفها النهائي، وكذلك استعمال واستغلال الأدوات والتجهيزات التي تحتوي على مصدر إشعاع أيوني أو التي ترسل مثل هذه الإشعاعات."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_114_20180702_OpEnact_2bdc3d0487> ;
    dzdoc:replacementText "تخضع حماية صحة السكان للشروط والمقاييس التقنية في المجال طبقا للتشريع والتنظيم المعمول بهما، إنتاج المواد والمستحضرات المشعة ومعالجتها وحيازتها ونقلها واستعمالها وكذلك حيازة النفايات التي تحتوي على مادة مشعة وجمعها وتخزينها ونقلها ومعالجتها وإزالتها وتصريفها النهائي، وكذلك استعمال واستغلال الأدوات والتجهيزات التي تحتوي على مصدر إشعاع أيوني أو التي ترسل مثل هذه الإشعاعات."@ar ;
