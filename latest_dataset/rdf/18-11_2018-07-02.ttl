    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تضمن الدولة الشروط الخاصة المتعلقة بالمراقبة والتكفل في مجال صحة الأطفال الموضوعين في المؤسسات، لا سيما منها تلك التابعة لـ الوزارة المكلفة بالتضامن الوطني . يجب أن يستفيد الأطفال المذكورون في الفقرة أعلاه ، من جميع التدابير الصحية والاجتماعية والتربوية الملائمة لنموهم المنسجم و اندماجهم في الأسرة والمجتمع."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_93_20180702_OpEnact_519da0cd4e> ;
    dzdoc:replacementText "تضمن الدولة الشروط الخاصة المتعلقة بالمراقبة والتكفل في مجال صحة الأطفال الموضوعين في المؤسسات، لا سيما منها تلك التابعة لـ الوزارة المكلفة بالتضامن الوطني . يجب أن يستفيد الأطفال المذكورون في الفقرة أعلاه ، من جميع التدابير الصحية والاجتماعية والتربوية الملائمة لنموهم المنسجم و اندماجهم في الأسرة والمجتمع."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_93> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_93> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

