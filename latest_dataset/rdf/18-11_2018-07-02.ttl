<https://legal.dz/resource/law/2018-07-02/18-11#art_414_condition_0_e12d2793_ref_c883ff31f15c> a dzdoc:Reference ;
    rdfs:label "المادتين 273"@ar ;
    dzdoc:frbrUri "#art_273"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2018-07-02/18-11#art_273> ;
    dzdoc:sourceEId "art_414" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "دون الترخيص المنصوص عليه في المادتين 273 و 307 من هذا القانون"@ar ;
    dzdoc:targetEId "art_273" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_414_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_414> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من ينشئ أو ينجز أو يفتح أو يستغل مؤسسة صحية دون الترخيص المنصوص عليه في المادتين 273 و 307 من هذا القانون، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 1.000.000 دج إلى 2.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_415_extref_83a3e9fd> a dzdoc:ExternalReference ;
