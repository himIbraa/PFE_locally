    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_381" ;
    dzdoc:fullText "تخضع الدراسات العيادية لترخيص الوزير المكلف بالصحة الذي يبت في أجل ثلاثة (3) أشهر، على أساس ملف طبي وتقني، وتصريح بشأن إنجاز الدراسات العيادية على الكائن البشري، يقدمها المرقي . يخضع كل تعديل لملف الدراسات العيادية ، بعد الحصول على الترخيص، لموافقة الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_381> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_381_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_381_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_381_20180702_OpEnact_e85eb511b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_381_obligation_0_5adfadf7>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_381_obligation_1_229d3abb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "381" ;
    dzdoc:position 378 ;
    dzdoc:usesTerm dzterm:clinical_studies,
        dzterm:minister,
        dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_79> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_79" ;
    dzdoc:fullText "تتولى الدولة ترقية وتشجيع الرضاعة الطبيعية من خلال عمليات وتدابير مناسبة . يمنع الترويج لبدائل عن الرضاعة الطبيعية والإشهار لها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_79> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_79_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_79_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_79_20180702_OpEnact_9fa504daa2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_79_obligation_0_cecd9c0e>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_79_obligation_1_e5025d13> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_79_prohibition_0_aee10324> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 79" ;
    dzdoc:position 78 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_307> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_307" ;
    dzdoc:fullText "يخضع إنجاز وفتح واستغلال وتوسيع ونقل وغلق وتحويل كلي أو جزئي لكل هيكل أو مؤسسة خاصة للصحة وكذا تجمعها، إلى ترخيص من الوزير المكلف بالصحة . كما يخضع إلى الترخيص من الوزير المكلف بالصحة اقتناء كل تجهيز صحي يخضع تنصيبه واستغلاله لمراقبة مسبقة تخص احترام المقاييس التقنية والممارسة، وكذا النشاطات الخاضعة لمقاييس أو أحكام خاصة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_307> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_307_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_307_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_307_20180702_OpEnact_eaf4f21f16> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 307" ;
    dzdoc:position 304 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_307_condition_0_f029600b>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_307_condition_1_b1d8fc94> ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_343> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_2> ;
    dzdoc:eId "art_343" ;
    dzdoc:fullText "لا يمكن القيام بأي عمل طبي ولا بأي علاج دون الموافقة الحرة والمستنيرة للمريض . ويجب على الطبيب احترام إرادة المريض، بعد إعلامه بالنتائج التي تنجر عن خياراته . وتخص هذه المعلومة مختلف الاستكشافات أو العلاجات أو الأعمال الوقائية المقترحة ومنفعتها وطابعها الاستعجالي المحتمل وعواقبها والأخطار الاعتيادية أو الخطيرة التي تنطوي عليها والتي يمكن عادة توقعها، وكذا الحلول الأخرى الممكنة والعواقب المتوقعة في حالة الرفض. ويضمن تقديم المعلومة كل مهني الصحة، في إطار صلاحياته ضمن احترام القواعد الأدبية والمهنية المطبقة عليه . تمارس حقوق الأشخاص القصر أو عديمي الأهلية، حسب الحالات، من قبل الأولياء أو الممثل الشرعي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_343_permission_0_53c1e2ce>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_343_permission_1_f1deccbf> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_343_right_0_b5c88587> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_343> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_343_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_343_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_343_para_2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_343_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_343_20180702_OpEnact_a954169c6d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_343_obligation_0_7d6c8403>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_343_obligation_1_a6c9bda5>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_343_obligation_2_a904fb91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "343" ;
    dzdoc:position 340 ;
    dzdoc:usesTerm dzterm:doctor .

<https://legal.dz/resource/law/2018-07-02/18-11#art_366> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_366" ;
    dzdoc:fullText "لا يمكن القيام بنزع أو زرع الأعضاء أو الأنسجة أو الخلايا البشرية إلا على مستوى المؤسسات الاستشفائية العمومية المرخص لها من طرف الوزير المكلف بالصحة ، بعد رأي الوكالة الوطنية لزرع الأعضاء . يجب أن تتوفر المؤسسات الاستشفائية على تنظيم طبي - تقني وتنسيق استشفائي، كي تحصل على ترخيص للقيام بعمليات نزع الأعضاء والأنسجة . تحدد شروط وكيفيات الترخيص عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_366_permission_0_5d34bb86> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_366> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_366_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_366_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_366_20180702_OpEnact_f077fb9ebe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_366_obligation_0_513aa0f1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "366" ;
    dzdoc:position 363 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_366_condition_0_35de8e61> ;
    dzdoc:usesTerm dzterm:minister_of_health,
        dzterm:national_organ_transplant_agency .

<https://legal.dz/resource/law/2018-07-02/18-11#art_52> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_52" ;
    dzdoc:fullText "يشترط في تسويق مواد التبغ كتابة إنذار عام على الجانب الظاهر من الغلاف وبحروف كبيرة يتضمن العبارة الآتية: \"استهلاك التبغ مضر بالصحة\" . يجب أن تتضمن الجهة الكبرى الأخرى من العلبة بالنسبة لعلب السجائر، علاوة على الإنذار العام، إنذارا خاصا في شكل رسومات أو رموز مصورة صادرة عن السلطة الصحية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_52> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_52_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_52_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_52_20180702_OpEnact_07daa3643a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_52_obligation_0_b619e788>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_52_obligation_1_6b20492b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "52" ;
    dzdoc:position 51 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_52_condition_0_13ba9400> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_218> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:pharmaceutical_establishment ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_3> ;
    dzdoc:eId "art_218" ;
    dzdoc:fullText "المؤسسة الصيدلانية هي شركة منظمة وفق الأشكال القانونية المنصوص عليها في القانون التجاري، تخضع للاعتماد من المصالح المختصة للوزارة المكلفة بالصحة. تكون الإدارة التقنية للمؤسسة الصيدلانية تحت مسؤولية صيدلي مدير تقني يستوفي شروط التأهيل المهني والممارسة المحددة عن طريق التنظيم . يمكن أن يساعد الصيدلي المدير التقني صيادلة مساعدون يستوفون شروط التأهيل المهني والممارسة المحددة عن طريق التنظيم ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_218_permission_0_3545c077> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_218> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_218_defocc_6c78c89c8a42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_218_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_218_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_218_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_218_20180702_OpEnact_0576960619> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "218" ;
    dzdoc:position 215 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_218_condition_0_2da65617>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_218_condition_1_2da65617> ;
    dzdoc:usesTerm dzterm:technical_director_pharmacist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_371> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_3> ;
    dzdoc:eId "art_371" ;
    dzdoc:fullText "تخصص المساعدة الطبية على الإنجاب ، حصريا، للاستجابة لطلب يعبر عنه رجل وامرأة في سن الإنجاب، على قيد الحياة، يشكلان زوجا مرتبطا قانونا، يعانيان من عقم مؤكد طبيا ويوافقان على النقل أو التخصيب الاصطناعي. ولا يمكن اللجوء فيها إلا للحيوانات المنوية للزوج وبويضة الزوجة، دون سواهما، مع استبعاد كل شخص آخر. يقدم الزوج والزوجة كتابيا، وهما على قيد الحياة، طلبهما المتعلق بالمساعدة الطبية على الإنجاب، ويجب عليهما تأكيده بعد شهر (1) واحد من تاريخ استلامه من الهيكل أو المؤسسة المعنية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_371_permission_0_c1babe24> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_371> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_371_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_371_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_371_20180702_OpEnact_ad38e9eb65> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_371_obligation_0_2fbadd35> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "371" ;
    dzdoc:position 368 ;
    dzdoc:usesTerm dzterm:assisted_reproduction .

<https://legal.dz/resource/law/2018-07-02/18-11#art_179> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_179" ;
    dzdoc:fullText "لا يمكن أن يقدم الصيدلي المواد الصيدلانية إلا بناء على وصفة طبية . غير أنه، يمكن أن يقدم، دون وصفة طبية ، بعض المواد التي يحدد قائمتها الوزير المكلف بالصحة . يضمن الصيدلي خدمات مرتبطة بالصحة، ويشارك في إعلام المرتفقين ونصحهم ومتابعتهم وتربيتهم العلاجية، لا سيما بتثبيط العلاج الذاتي والحث على استعمال الأدوية الجنيسة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_179_permission_0_75c60703>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_179_permission_1_6ffaa93b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_179> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_179_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_179_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_179_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_179_20180702_OpEnact_4bd5ba68fb> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_179_obligation_0_7883524b>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_179_obligation_1_316449ed> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 179" ;
    dzdoc:position 176 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_179> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_179> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_179_condition_0_419451c8> ;
    dzdoc:usesTerm dzterm:minister,
        dzterm:pharmacist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_25> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_3> ;
    dzdoc:eId "art_25" ;
    dzdoc:fullText "في حالة تشخيص أو احتمال مرض خطير ، يمكن أفراد أسرة المريض الحصول على المعلومات الضرورية التي تمكنهم من مساعدة هذا المريض ، ما لم يعترض على ذلك . لا يمنع السر الطبي من إعلام أسرة الشخص المتوفى طالما يسمح بمعرفة أسباب الوفاة من أجل الدفاع عن ذاكرة المتوفى أو المطالبة بحقوقه، ما لم يعبر الشخص قبل وفاته على خلاف ذلك."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_25_permission_0_13fd4e76>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_25_permission_1_8c4024c5> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_25_right_0_03feaacf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_25> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_25_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_25_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_25_20180702_OpEnact_3413183d0e> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_25_prohibition_0_8c4024c5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "25" ;
    dzdoc:position 24 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_25_condition_0_e66b6e5b>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_25_condition_1_fdaed629> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_361> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_361" ;
    dzdoc:fullText "يمنع نزع أعضاء وأنسجة وخلايا بشرية من أشخاص قصر أو عديمي الأهلية أحياء ، كما يمنع نزع أعضاء أو أنسجة من أشخاص أحياء مصابين بأمراض من شأنها أن تصيب صحة المتبرع أو المتلقي . يسمح بنزع الخلايا الجذعية المكونة للدم من متبرع قاصر فقط لصالح أخ أو أخت . وفي حالة غياب حلول علاجية أخرى يمكن أن يتم هذا النزع بشكل استثنائي لصالح ابنة عمه أو ابنة خاله أو ابنة عمته أو ابنة خالته أو ابن عمه أو ابن خاله أو ابن عمته أو ابن خالته، و يقتضي هذا النزع في جميع الحالات الموافقة المستنيرة لكلا الأبوين أو ممثلهم الشرعي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_361_permission_0_94183866>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_361_permission_1_a7c4ad47> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_361_right_0_e07450c4> ;
