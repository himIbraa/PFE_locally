    dznorm:position 0 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_268_condition_0_c66030b2_ref_fda15611a3ab> a dzdoc:Reference ;
    rdfs:label "المادة 316"@ar ;
    dzdoc:frbrUri "#art_316"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2018-07-02/18-11#art_316> ;
    dzdoc:sourceEId "art_268" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "ضمن الشروط المنصوص عليها في المادة 316 أدناه"@ar ;
    dzdoc:targetEId "art_316" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_268_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_268> ;
    dzdoc:position 0 ;
    dzdoc:text "تهدف شبكات العلاج إلى تحقيق تكفل أفضل بالمريض واستمرارية العلاج وكذا تقديم علاج جواري ذي جودة من أجل ضمان تسهيل الحصول على العلاج والعدالة في مجال الصحة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_268_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_268> ;
    dzdoc:position 1 ;
    dzdoc:text "يمكن شبكات العلاج إشراك هياكل ومؤسسات الصحة العمومية والخاصة ومهنيي الصحة الآخرين وهيئات ذات طابع صحي أو اجتماعي ضمن الشروط المنصوص عليها في المادة 316 أدناه."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_268_para_2> a dzdoc:Paragraph ;
