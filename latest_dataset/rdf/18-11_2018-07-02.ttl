        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_3>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_4>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_5>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_6>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_7>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_8>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_9> ;
    dzdoc:eId "chp_5" ;
    dzdoc:hasSection <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_10>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_11>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_12>,
