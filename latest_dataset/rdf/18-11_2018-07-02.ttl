<https://legal.dz/resource/law/2018-07-02/18-11#version_art_186> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمارس بصفة غير شرعية الطب أو طب الأسنان أو الصيدلة : كل شخص يمارس نشاط طبيب أو طبيب أسنان أو صيدلي دون أن تتوفر فيه الشروط المحددة في هذا القانون أو خلال مدة المنع من الممارسة ، كل شخص يقوم عادة، مقابل مكافأة أو بدونها ولو بحضور طبيب أو طبيب أسنان ، بإعداد تشخيص أو تقديم دواء من خلال أعمال شخصية أو فحوص شفوية أو كتابية أو عن طريق أسلوب آخر كيفما كان نوعه، دون أن تتوفر فيه الشروط المحددة في هذا القانون ، كل من كان حائزا الشهادة المطلوبة ويقدم مساعدته للأشخاص المذكورين في الفقرات أعلاه، أو يكون شر"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_186_20180702_OpEnact_c78ccc3289> ;
    dzdoc:replacementText "يمارس بصفة غير شرعية الطب أو طب الأسنان أو الصيدلة : كل شخص يمارس نشاط طبيب أو طبيب أسنان أو صيدلي دون أن تتوفر فيه الشروط المحددة في هذا القانون أو خلال مدة المنع من الممارسة ، كل شخص يقوم عادة، مقابل مكافأة أو بدونها ولو بحضور طبيب أو طبيب أسنان ، بإعداد تشخيص أو تقديم دواء من خلال أعمال شخصية أو فحوص شفوية أو كتابية أو عن طريق أسلوب آخر كيفما كان نوعه، دون أن تتوفر فيه الشروط المحددة في هذا القانون ، كل من كان حائزا الشهادة المطلوبة ويقدم مساعدته للأشخاص المذكورين في الفقرات أعلاه، أو يكون شريكا لهم، كل شخص غير مرخص له من الوزير المكلف بالصحة ، يمارس في هيكل أو مؤسسة خاصة للصحة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_186> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
