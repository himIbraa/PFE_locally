    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_443_20180702_OpEnact_c808253bf3> ;
    dzdoc:replacementText "يمكن المستخدمين في وضعية نشاط في المؤسسات العمومية للصحة التابعة للوزارة المكلفة بالصحة التي تم تعديل قانونها الأساسي الاحتفاظ بالقانون الأساسي المطبق عليهم إذا رغبوا في ذلك ، ابتداء من تاريخ دخول هذا القانون حيز التنفيذ. ويبقى المستخدمون الذين يمارسون عملهم في إطار اتفاقات واتفاقيات التعاون، خاضعين للأحكام الخاصة بهم."@ar ;
