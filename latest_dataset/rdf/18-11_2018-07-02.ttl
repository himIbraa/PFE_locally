    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_30> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنظم هياكل الصحة، في إطار تنفيذ برامج الصحة، بمساعدة السلطة المعنية، حملات التوعية والإعلام وأعمال الوقاية من الأمراض والآفات الاجتماعية والحوادث والكوارث مهما كانت طبيعتها."@ar ;
    dzdoc:isAuthoritative true ;
