<https://legal.dz/resource/law/2018-07-02/18-11#art_60> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_2> ;
    dzdoc:eId "art_60" ;
    dzdoc:fullText "يمنع الترويج والرعاية والإشهار للمشروبات الكحولية ولكل مادة أخرى معينة ومصنفة مضرة بالصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_60> ;
