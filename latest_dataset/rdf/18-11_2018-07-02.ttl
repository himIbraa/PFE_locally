<https://legal.dz/resource/law/2018-07-02/18-11#version_art_140> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يقرر طبيب الأمراض العقلية للمؤسسة ، عند انقضاء أجل خمسة عشر (15) يوما : إما خروج المريض ، وإما تمديد فترة الوضع في الملاحظة لمدة أقصاها خمسة عشر (15) يوما. غير أن طبيب الأمراض العقلية للمؤسسة يمكنه أن يقرر خروج المريض قبل انقضاء أجل خمسة عشر (15) يوما إذا قدر أن حالة المريض تسمح بذلك ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_140_20180702_OpEnact_7580056746> ;
    dzdoc:replacementText "يمكن أن يقرر طبيب الأمراض العقلية للمؤسسة ، عند انقضاء أجل خمسة عشر (15) يوما : إما خروج المريض ، وإما تمديد فترة الوضع في الملاحظة لمدة أقصاها خمسة عشر (15) يوما. غير أن طبيب الأمراض العقلية للمؤسسة يمكنه أن يقرر خروج المريض قبل انقضاء أجل خمسة عشر (15) يوما إذا قدر أن حالة المريض تسمح بذلك ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
