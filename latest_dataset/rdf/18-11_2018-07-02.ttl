    dznorm:position 0 ;
    dznorm:provisionText "تضمن الوكالة على الخصوص، مهمة خدمة عمومية في مجال تسجيل المواد الصيدلانية والمستلزمات الطبية ذات الاستعمال البشري، والمصادقة عليها ومراقبتها"@ar ;
    dznorm:sourceArticle "art_225" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_225_obligation_0_d753cf43_role_5ba3c925b8> a dznorm:Role ;
