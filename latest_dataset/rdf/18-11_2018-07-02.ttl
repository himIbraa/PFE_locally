<https://legal.dz/resource/law/2018-07-02/18-11#art_412_obligation_0_c0d12fa1> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
