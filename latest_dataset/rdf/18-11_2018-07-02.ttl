<https://legal.dz/resource/law/2018-07-02/18-11#version_art_177> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على مهني الصحة الممارس الطبي ، زيادة على التزاماته القانونية الأساسية والتنظيمية، القيام بما يأتي : التصريح للسلطات الصحية بالآثار الثانوية غير المرغوب فيها عند استعمال الأدوية، إخطار السلطة الصحية بكل حدث ذي خطر أو حدث ناتج أو ممكن أن ينتج عن استعمال المستلزمات الطبية لغرض التشخيص أو العلاج أو الوقاية، التصريح للسلطة الصحية بحالات التسممات الحادة أو المزمنة والآثار السامة المحتملة أو المثبتة الناتجة عن منتوجات أو مواد طبيعية أو تركيبية، المشاركة في كل عمل إعلامي وتقييمي حول الاستعمال الجي"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_177_20180702_OpEnact_10d0efda6f> ;
    dzdoc:replacementText "يتعين على مهني الصحة الممارس الطبي ، زيادة على التزاماته القانونية الأساسية والتنظيمية، القيام بما يأتي : التصريح للسلطات الصحية بالآثار الثانوية غير المرغوب فيها عند استعمال الأدوية، إخطار السلطة الصحية بكل حدث ذي خطر أو حدث ناتج أو ممكن أن ينتج عن استعمال المستلزمات الطبية لغرض التشخيص أو العلاج أو الوقاية، التصريح للسلطة الصحية بحالات التسممات الحادة أو المزمنة والآثار السامة المحتملة أو المثبتة الناتجة عن منتوجات أو مواد طبيعية أو تركيبية، المشاركة في كل عمل إعلامي وتقييمي حول الاستعمال الجيد للمواد الصيدلانية واللجوء لليقظة بخصوص المواد الصيدلانية والعتاد، مسك الملف الطبي للمريض وتحيينه، المشاركة في اقتصاد الصحة، السهر على احترام الممارسات الحسنة للوصف."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_177> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_177> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

