    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يمنع بيع المشروبات الكحولية للقصر."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_62_20180702_OpEnact_ad5577eb32> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_62> ;
    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_62> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_62> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تطور الدولة المصالح المناسبة للوقاية من السلوكات الإدمانية ومكافحة المخدرات والإدمان، وفقا للتشريع والتنظيم المعمول بهما. تحدد قائمة المواد الإدمانية والمحظورة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_63_20180702_OpEnact_cddfefccdf> a dzdoc:ArticleVersion ;
