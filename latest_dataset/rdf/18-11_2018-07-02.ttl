<https://legal.dz/resource/law/2018-07-02/18-11#version_art_315> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يبت الوزير المكلف بالصحة في الغلق المؤقت أو النهائي لكل هيكل أو مؤسسة خاصة للصحة بناء على تقرير المصالح المختصة. ويمكن الوالي أن يبت في الغلق الذي لا تتجاوز مدته ثلاثة (3) أشهر لكل هيكل أو مؤسسة صحية خاصة بناء على تقرير المصالح المختصة للوزارة المكلفة بالصحة."@ar ;
