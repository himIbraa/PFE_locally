    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "تضمن الهياكل الصحية، في مكافحة الإدمان على التبغ التحسيس والمساعدة على الإقلاع والمعالجة ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_59_20180702_OpEnact_d3e73646df> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_59> ;
