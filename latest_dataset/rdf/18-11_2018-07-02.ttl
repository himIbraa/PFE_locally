<https://legal.dz/resource/law/2018-07-02/18-11#version_art_215> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "دستور الأدوية هو السجل الذي يضم الخصائص المطبقة على الأدوية ومكوناتها وعلى بعض المستلزمات الطبية وكذا مناهج التعرف عليها وتجريبها وتحليلها بغرض ضمان مراقبتها وتقييم نوعيتها. يتمم دستور الأدوية بـ السجل الوطني للأدوية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_215_20180702_OpEnact_7dc2864779> ;
    dzdoc:replacementText "دستور الأدوية هو السجل الذي يضم الخصائص المطبقة على الأدوية ومكوناتها وعلى بعض المستلزمات الطبية وكذا مناهج التعرف عليها وتجريبها وتحليلها بغرض ضمان مراقبتها وتقييم نوعيتها. يتمم دستور الأدوية بـ السجل الوطني للأدوية ."@ar ;
