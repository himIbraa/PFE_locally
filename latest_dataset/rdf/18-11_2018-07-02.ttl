<https://legal.dz/resource/law/2018-07-02/18-11#version_art_164> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يخبر مدير المؤسسة السلطات المعنية بكل خروج غير قانوني أو كل حادث استثنائي بخصوص مريض خاضع للملاحظة الإجبارية أو الاستشفاء الإجباري . تطبق أحكام الفقرة أعلاه على المرضى المصابين باضطرابات عقلية الخاضعين للأشكال الأخرى من الوضع في الملاحظة أو الذين تم استشفاؤهم ضمن الشروط المنصوص عليها في القوانين المعمول بها ."@ar ;
