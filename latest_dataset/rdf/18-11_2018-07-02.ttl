<https://legal.dz/resource/law/2018-07-02/18-11#version_art_273> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع إنجاز وإنشاء وفتح واستغلال أي هيكل أو مؤسسة صحية أو ذات طابع صحي، وتوسيعها وتحويلها وتغيير تخصيصها وغلقها المؤقت أو النهائي، لترخيص من الوزير المكلف بالصحة ."@ar ;
