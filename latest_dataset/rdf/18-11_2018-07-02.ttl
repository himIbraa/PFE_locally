<https://legal.dz/resource/law/2018-07-02/18-11#version_art_203> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن الاحتفاظ بجثمان المتوفى على مستوى مصلحة حفظ الجثث لمؤسسة الصحة، أكثر من خمسة عشر (15) يوما، ويمكن النائب العام المختص إقليميا تمديد هذا الأجل بخمسة عشر (15) يوما. وبعد انقضاء هذا الأجل، يجب عليه أن يقرر بشأن مآل الجثمان وفق الكيفيات المحددة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
