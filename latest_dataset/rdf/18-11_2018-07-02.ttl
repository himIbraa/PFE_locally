<https://legal.dz/resource/law/2018-07-02/18-11#version_art_143> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يكون خروج المريض : إما بمبادرة من طبيب الأمراض العقلية للمؤسسة، وإما بطلب من المريض الراشد المؤهل مدنيا وإما بطلب من الشخص الذي كان سببا في الاستشفاء بفعل الغير، وإما بطلب من أحد الأصول أو الفروع المباشر الراشد للمريض أو زوج المريض أو أخيه أو أخته أو عمه أو عمته أو خاله أو خالته الراشدين أو الممثل الشرعي للمريض عديم الأهلية، وهم مسؤولون مدنيا عن المريض و يجب عليهم الالتزام بالتكفل به . يخضع كل طلب خروج للموافقة المسبقة لطبيب الأمراض العقلية و يجب أن يكون محررا كتابيا وموقعا من طرف الشخص الذي يقد"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_143_20180702_OpEnact_81baecc600> ;
    dzdoc:replacementText "يكون خروج المريض : إما بمبادرة من طبيب الأمراض العقلية للمؤسسة، وإما بطلب من المريض الراشد المؤهل مدنيا وإما بطلب من الشخص الذي كان سببا في الاستشفاء بفعل الغير، وإما بطلب من أحد الأصول أو الفروع المباشر الراشد للمريض أو زوج المريض أو أخيه أو أخته أو عمه أو عمته أو خاله أو خالته الراشدين أو الممثل الشرعي للمريض عديم الأهلية، وهم مسؤولون مدنيا عن المريض و يجب عليهم الالتزام بالتكفل به . يخضع كل طلب خروج للموافقة المسبقة لطبيب الأمراض العقلية و يجب أن يكون محررا كتابيا وموقعا من طرف الشخص الذي يقدمه . ويدون في سجل مخصص لهذا الغرض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_143> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_143> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_144> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة ما إذا ارتأت السلطة العمومية ضرورة ذلك، ولا سيما عندما يتم تقدير حدوث خطر وشيك بسبب مرض يتعرض له المريض نفسه أو الغير ، يمكن اتخاذ قرار الفحص الإجباري في طب الأمراض العقلية بكتابة عبارة : \"فحص إجباري في طب الأمراض العقلية\"، على استمارة طلب الفحص في طب الأمراض العقلية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_144_20180702_OpEnact_c9889ad8ae> ;
    dzdoc:replacementText "في حالة ما إذا ارتأت السلطة العمومية ضرورة ذلك، ولا سيما عندما يتم تقدير حدوث خطر وشيك بسبب مرض يتعرض له المريض نفسه أو الغير ، يمكن اتخاذ قرار الفحص الإجباري في طب الأمراض العقلية بكتابة عبارة : \"فحص إجباري في طب الأمراض العقلية\"، على استمارة طلب الفحص في طب الأمراض العقلية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_144> ;
