<https://legal.dz/resource/law/2018-07-02/18-11#art_430_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_430> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف أحكام هذا القانون المتعلقة بنزع الأعضاء والأنسجة والخلايا البشرية وزرعها، طبقا لأحكام المواد من 303 مكرر 16 إلى 303 مكرر 20 من قانون العقوبات."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_431_extref_a26a0338> a dzdoc:ExternalReference ;
    rdfs:label "303 مكرر 20"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_303_bis_20"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_303_bis_20"^^xsd:anyURI ;
