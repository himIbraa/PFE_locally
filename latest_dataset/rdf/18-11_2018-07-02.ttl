<https://legal.dz/resource/law/2018-07-02/18-11#version_art_390> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن إجراء أي نقل، قصد التحليل، لمجموعة من العينات البيولوجية لغرض الدراسات العيادية، دون أن تكون موضوع تصريح مسبق لدى الوزير المكلف بالصحة وتسليم شهادة نقل . ويخضع نقل المواد والعتاد موضوع الدراسة العيادية إلى نفس الأشكال."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
