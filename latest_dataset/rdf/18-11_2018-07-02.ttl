<https://legal.dz/resource/law/2018-07-02/18-11#art_21> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_3> ;
    dzdoc:eId "art_21" ;
    dzdoc:fullText "لكل شخص الحق في الحماية والوقاية والعلاج والمرافقة التي تتطلبها حالته الصحية ، في كل مراحل حياته وفي كل مكان. ولا يجوز التمييز بين الأشخاص في الحصول على الوقاية أو العلاج ، لا سيما بسبب أصلهم أو دينهم أو سنهم أو جنسهم أو وضعيتهم الاجتماعية والعائلية أو حالتهم الصحية أو إعاقتهم. لا يمكن أن يشكل أي مبرر ، مهما كانت طبيعته، عائقا في حصول المواطن على العلاجات في هياكل ومؤسسات الصحة ، لا سيما في حالة الاستعجالات. ولا يمكن أن تتعرض السلامة الجسدية للشخص لأي مساس إلا في حالة الضرورة الطبية المثبتة قانونا وحسب الأحكام المنصوص عليها في هذا القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_21_permission_0_63203a26>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_21_permission_1_22f78335>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_21_permission_2_27a9c144> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_21_right_0_42581771> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_21> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_21_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_21_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_21_para_2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_21_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_21_20180702_OpEnact_97e2e963b2> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_21_obligation_0_e2827394>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_21_obligation_1_9f2970e3>,
