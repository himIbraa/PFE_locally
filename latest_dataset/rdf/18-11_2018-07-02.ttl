    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف أحكام المادتين 237 و 238 من هذا القانون، المتعلقة على التوالي، بالإشهار وبالإعلام العلمي حول المواد الصيدلانية بغرامة من 200.000 دج إلى 500.000 دج. و في حالة العود، تضاعف العقوبة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_428_20180702_OpEnact_9c4def06f1> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
