<https://legal.dz/resource/law/2018-07-02/18-11#version_art_52> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشترط في تسويق مواد التبغ كتابة إنذار عام على الجانب الظاهر من الغلاف وبحروف كبيرة يتضمن العبارة الآتية: \"استهلاك التبغ مضر بالصحة\" . يجب أن تتضمن الجهة الكبرى الأخرى من العلبة بالنسبة لعلب السجائر، علاوة على الإنذار العام، إنذارا خاصا في شكل رسومات أو رموز مصورة صادرة عن السلطة الصحية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_52_20180702_OpEnact_07daa3643a> ;
    dzdoc:replacementText "يشترط في تسويق مواد التبغ كتابة إنذار عام على الجانب الظاهر من الغلاف وبحروف كبيرة يتضمن العبارة الآتية: \"استهلاك التبغ مضر بالصحة\" . يجب أن تتضمن الجهة الكبرى الأخرى من العلبة بالنسبة لعلب السجائر، علاوة على الإنذار العام، إنذارا خاصا في شكل رسومات أو رموز مصورة صادرة عن السلطة الصحية ."@ar ;
