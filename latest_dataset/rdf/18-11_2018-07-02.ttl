        <https://legal.dz/resource/law/2018-07-02/18-11#art_307> ;
    dznorm:conditionText "دون الترخيص المنصوص عليه في المادتين 273 و 307 من هذا القانون"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_414> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_414_condition_0_e12d2793_ref_958814f7fa8a> a dzdoc:Reference ;
