<https://legal.dz/resource/law/2018-07-02/18-11#version_art_281> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تضمن هياكل ومؤسسات الصحة ، لفائدة كل المواطنين، تقديم علاجات أولية وثانوية وذات المستوى العالي وكذا الاستعجالات ، حسب مخطط تنظيمي محدد عن طريق التنظيم. كما يمكن هياكل ومؤسسات الصحة العمومية والخاصة أن تتولى تقديم : علاجات بالمنزل استشفاء بالمنزل، علاجات تلطيفية. تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_281_20180702_OpEnact_72c21dc75a> ;
    dzdoc:replacementText "تضمن هياكل ومؤسسات الصحة ، لفائدة كل المواطنين، تقديم علاجات أولية وثانوية وذات المستوى العالي وكذا الاستعجالات ، حسب مخطط تنظيمي محدد عن طريق التنظيم. كما يمكن هياكل ومؤسسات الصحة العمومية والخاصة أن تتولى تقديم : علاجات بالمنزل استشفاء بالمنزل، علاجات تلطيفية. تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
