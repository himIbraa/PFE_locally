<https://legal.dz/resource/law/2018-07-02/18-11#version_art_120> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى الدولة و الجماعات المحلية ومؤسسات التربية والتعليم العالي والتكوين المهني، التربية من أجل الصحة . وتهدف هذه التربية إلى المساهمة في توفير الراحة للمواطنين بتمكينهم من اكتساب المعارف الضرورية في مجال التربية الصحية، لا سيما منها : حفظ الصحة الفردية والجماعية، حماية البيئة، الوقاية من الأخطار الطبيعية، التغذية الصحية والمتوازنة، ترقية صحة الفم والأسنان، الوقاية من الأمراض والحوادث، الوقاية في مجال الصحة العقلية، الوقاية في مجال الصحة الإنجابية، لا سيما التربية الجنسية لدى الشباب، استهلاك الأ"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_120_20180702_OpEnact_6921bcea91> ;
    dzdoc:replacementText "تتولى الدولة و الجماعات المحلية ومؤسسات التربية والتعليم العالي والتكوين المهني، التربية من أجل الصحة . وتهدف هذه التربية إلى المساهمة في توفير الراحة للمواطنين بتمكينهم من اكتساب المعارف الضرورية في مجال التربية الصحية، لا سيما منها : حفظ الصحة الفردية والجماعية، حماية البيئة، الوقاية من الأخطار الطبيعية، التغذية الصحية والمتوازنة، ترقية صحة الفم والأسنان، الوقاية من الأمراض والحوادث، الوقاية في مجال الصحة العقلية، الوقاية في مجال الصحة الإنجابية، لا سيما التربية الجنسية لدى الشباب، استهلاك الأدوية، مكافحة الممارسات الضارة بالصحة، ترقية ممارسة التربية البدنية والرياضية والرياضات."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_120> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_120> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_121> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتناول أعمال التربية من أجل الصحة الموجهة لمختلف الفئات السكانية حفظ الصحة والوقاية والإسعافات الأولية. وتدرج هذه الأعمال ضمن برامج التعليم والتكوين."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_121_20180702_OpEnact_a3543fcf98> ;
    dzdoc:replacementText "تتناول أعمال التربية من أجل الصحة الموجهة لمختلف الفئات السكانية حفظ الصحة والوقاية والإسعافات الأولية. وتدرج هذه الأعمال ضمن برامج التعليم والتكوين."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_121> ;
