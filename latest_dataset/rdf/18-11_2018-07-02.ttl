<https://legal.dz/resource/law/2018-07-02/18-11#art_54_defocc_4fcc9a1deca4> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 153 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:tobacco_products ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_54> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_54_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "تعتبر موادا تبغية، المواد المخصصة للتدخين أو النشق أو الوضع على اللثة أو المضغ أو المص، بما في ذلك السيجارة الإلكترونية ما دامت تحتوي على التبغ ولو جزئيا."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_54_para_0> a dzdoc:Paragraph ;
