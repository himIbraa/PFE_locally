<https://legal.dz/resource/law/2018-07-02/18-11#art_417_obligation_0_abc40f7f> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_417> ;
    dznorm:position 0 ;
    dznorm:provisionText "عدم التقيد بالتزام السر الطبي والمهني"@ar ;
    dznorm:sourceArticle "art_417" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_417_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_417> ;
    dzdoc:position 0 ;
    dzdoc:text "عدم التقيد بالتزام السر الطبي والمهني، يعرض صاحبه للعقوبات المنصوص عليها في أحكام المادة 301 من قانون العقوبات."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_418_extref_9b262dcb> a dzdoc:ExternalReference ;
    rdfs:label "المادة 187 مكرر"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/1966-06-08/66-156#art_187_bis"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/order/1966-06-08/66-156#art_187_bis"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/code/1966-06-08/66-156#art_187_bis" ;
    dzdoc:resolutionReason "cross_document_fragment_unverified" ;
    dzdoc:resolutionStatus "partial" ;
    dzdoc:targetDocumentUri "https://legal.dz/resource/order/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_187_bis" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_418_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_418> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب على كل رفض للامتثال لطلبات التسخيرة الصادرة من السلطة العمومية حسب الأشكال المنصوص عليها في التنظيم الساري المفعول، طبقا لأحكام المادة 187 مكرر من قانون العقوبات."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_419_obligation_0_e8b284d9> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2018-07-02/18-11#art_419_obligation_0_e8b284d9_ref_b844f0405feb> ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_180> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_180> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_419> ;
    dznorm:position 0 ;
    dznorm:provisionText "المنع المتعلق بالوصف الطبي أو تغييره المنصوص عليه في أحكام المادة 180 من هذا القانون"@ar ;
    dznorm:sourceArticle "art_419" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_419_obligation_0_e8b284d9_ref_b844f0405feb> a dzdoc:Reference ;
    rdfs:label "المادة 180"@ar ;
    dzdoc:frbrUri "#art_180"^^xsd:anyURI ;
    dzdoc:referencesTarget <https://legal.dz/resource/law/2018-07-02/18-11#art_180> ;
    dzdoc:sourceEId "art_419" ;
    dzdoc:sourceElementType "obligation" ;
    dzdoc:sourceTextSpan "المنع المتعلق بالوصف الطبي أو تغييره المنصوص عليه في أحكام المادة 180 من هذا القانون"@ar ;
    dzdoc:targetEId "art_180" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_419_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_419> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل مهني الصحة الذي يخالف المنع المتعلق بالوصف الطبي أو تغييره المنصوص عليه في أحكام المادة 180 من هذا القانون بالحبس من ستة (6) أشهر إلى سنتين (2) وبغرامة من 50.000 دج إلى 100.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_41_condition_0_0dbd2662> a dznorm:Condition ;
    dznorm:conditionText "في حالة وجود خطر انتشار وباء و/أو في حالة حماية الأشخاص المعرضين لخطر"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_41> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_41_obligation_0_efb44dd8> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_41> ;
    dznorm:position 0 ;
    dznorm:provisionText "تنظم السلطات الصحية حملات تلقيح وتتخذ كل تدبير ملائم لفائدة المواطنين أو الأشخاص المعنيين"@ar ;
    dznorm:sourceArticle "art_41" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_41_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_41> ;
    dzdoc:position 0 ;
    dzdoc:text "في حالة وجود خطر انتشار وباء و/أو في حالة حماية الأشخاص المعرضين لخطر، تنظم السلطات الصحية حملات تلقيح وتتخذ كل تدبير ملائم لفائدة المواطنين أو الأشخاص المعنيين."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_420_obligation_0_0382b21e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_420> ;
    dznorm:position 0 ;
    dznorm:provisionText "إعلام المصالح المعنية"@ar ;
    dznorm:sourceArticle "art_420" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_420_obligation_1_1bb7835e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_420> ;
    dznorm:position 1 ;
    dznorm:provisionText "تحرير الشهادة الوصفية لحالات العنف"@ar ;
    dznorm:sourceArticle "art_420" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_420_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_420> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل مهني الصحة الذي يخالف أحكام المادتين 198 و 199 من هذا القانون، المتعلقة، على التوالي، بإعلام المصالح المعنية وتحرير الشهادة الوصفية لحالات العنف، بغرامة من 20.000 دج إلى 40.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_421_obligation_0_5e5b1350> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_421> ;
    dznorm:position 0 ;
    dznorm:provisionText "الإعلام الخاص بالأعمال المهنية وتسعيرتها المحددة في التنظيم المعمول به"@ar ;
    dznorm:sourceArticle "art_421" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_421_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_421> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف الأحكام المتعلقة بالإعلام الخاص بالأعمال المهنية وتسعيرتها المحددة في التنظيم المعمول به بغرامة من 300.000 دج إلى 500.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_422_condition_0_e4eb1a9b> a dznorm:Condition ;
    dznorm:conditionText "غير معتمدة من المصالح المختصة"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_422> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_422_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_422> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب على كل نشاط إنتاج واستغلال واستيراد وتصدير وتوزيع المواد الصيدلانية من طرف مؤسسات غير معتمدة من المصالح المختصة، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 5.000.000 دج إلى 10.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_423_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_423> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف أحكام المادة 245 من هذا القانون المتعلقة بالمراقبة الإدارية والتقنية والأمنية لاستعمال مواد وأدوية ونباتات ذات خصائص مخدرة أو مؤثرة عقليا بالحبس من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 200.000 دج إلى 500.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_424_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_424> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف الأحكام المتعلقة بالنوكليدات الإشعاعية، بالحبس من ستة (6) أشهر إلى سنتين (2) وبغرامة من 200.000 دج إلى 500.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_425_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_425> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من قام بصنع الأدوية المقلدة المحددة في المادة 211 من هذا القانون، أو السمسرة لها أو توزيعها أو الإشهار لها أو عرضها للبيع أو بيعها أو استيرادها أو تصديرها أو حيازتها، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 1.000.000 دج إلى 5.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_426_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_426> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف أحكام المادة 230 من هذا القانون، المتعلقة بتسجيل المواد الصيدلانية والمصادقة على المستلزمات الطبية، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 1.000.000 دج إلى 5.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_427_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_427> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف أحكام المادتين 237 و 238 من هذا القانون، المتعلقة على التوالي، بالإشهار وبالإعلام العلمي حول المواد الصيدلانية بغرامة من 200.000 دج إلى 500.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_427_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_427> ;
    dzdoc:position 1 ;
    dzdoc:text "و في حالة العود، تضاعف العقوبة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_428_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_428> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف أحكام المادة 258 من هذا القانون، المتعلقة بجمع وتقسيم وحفظ وتوزيع الدم ومواد الدم غير الثابتة، بغرامة من 1.000.000 دج إلى 2.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_429_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_429> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 263 من هذا القانون، المتعلقة بالنشاطات المربحة المرتبطة بالدم البشري والبلازما ومشتقاتهما، بالحبس من سنتين (2) إلى ثلاث (3) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_42_obligation_0_4a25315e> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_42> ;
    dznorm:position 0 ;
    dznorm:provisionText "تخضع الوقاية من الأمراض ذات الانتشار الدولي ومكافحتها لأحكام اللوائح الصحية الدولية لمنظمة الصحة العالمية"@ar ;
    dznorm:sourceArticle "art_42" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_42_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_42> ;
    dzdoc:position 0 ;
    dzdoc:text "تخضع الوقاية من الأمراض ذات الانتشار الدولي ومكافحتها لأحكام اللوائح الصحية الدولية لمنظمة الصحة العالمية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_430_extref_a26a0338> a dzdoc:ExternalReference ;
