<https://legal.dz/resource/law/2018-07-02/18-11#art_90_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_90> ;
    dzdoc:position 0 ;
    dzdoc:text "تضمن هياكل ومؤسسات الصحة العمومية والخاصة المكلفة بخدمة عمومية، التغطية الصحية المجانية لكل الأشخاص في وضع صعب، لا سيما الذين يعيشون في الوسط المؤسساتي."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_90_para_1> a dzdoc:Paragraph ;
