<https://legal.dz/resource/law/2018-07-02/18-11#version_art_179> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن أن يقدم الصيدلي المواد الصيدلانية إلا بناء على وصفة طبية . غير أنه، يمكن أن يقدم، دون وصفة طبية ، بعض المواد التي يحدد قائمتها الوزير المكلف بالصحة . يضمن الصيدلي خدمات مرتبطة بالصحة، ويشارك في إعلام المرتفقين ونصحهم ومتابعتهم وتربيتهم العلاجية، لا سيما بتثبيط العلاج الذاتي والحث على استعمال الأدوية الجنيسة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_179_20180702_OpEnact_4bd5ba68fb> ;
    dzdoc:replacementText "لا يمكن أن يقدم الصيدلي المواد الصيدلانية إلا بناء على وصفة طبية . غير أنه، يمكن أن يقدم، دون وصفة طبية ، بعض المواد التي يحدد قائمتها الوزير المكلف بالصحة . يضمن الصيدلي خدمات مرتبطة بالصحة، ويشارك في إعلام المرتفقين ونصحهم ومتابعتهم وتربيتهم العلاجية، لا سيما بتثبيط العلاج الذاتي والحث على استعمال الأدوية الجنيسة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_179> ;
