<https://legal.dz/resource/law/2018-07-02/18-11#version_art_382> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ لجنة الأخلاقيات الطبية للدراسات العيادية على مستوى المصالح الخارجية المكلفة بالصحة. لجنة الأخلاقيات الطبية للدراسات العيادية هي جهاز مستقل، تراقب نشاطاتها من طرف المصالح المختصة للوزارة المكلفة بالصحة. تحدد مهام اللجنة وتشكيلتها وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
