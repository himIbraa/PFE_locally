<https://legal.dz/resource/law/2018-07-02/18-11#version_art_154> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يرسل طبيب المؤسسة للأمراض العقلية ، في إلى الوالي يفصل فيها الأسباب التي يراها ضرورية لاتخاذ حالة ضرورة الاستشفاء الإجباري ، شهادة طبية هذا التدبير. يتخذ قرار الاستشفاء الإجباري بموجب قرار من الوالي لمدة ستة (6) أشهر، على الأكثر، ويمكن أن يكون محل تجديد ضمن نفس الأشكال. في حالة الاحتجاج على طلب الاستشفاء الإجباري تخطر اللجنة الولائية للصحة العقلية ضمن الشروط المنصوص عليها في المادة 132 أعلاه. يبقي طبيب الأمراض العقلية ، بعد إعلامه بهذا الإخطار من طرف اللجنة المريض في الملاحظة الإجبارية في انتظار"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_154_20180702_OpEnact_be5c287e6a> ;
    dzdoc:replacementText "يرسل طبيب المؤسسة للأمراض العقلية ، في إلى الوالي يفصل فيها الأسباب التي يراها ضرورية لاتخاذ حالة ضرورة الاستشفاء الإجباري ، شهادة طبية هذا التدبير. يتخذ قرار الاستشفاء الإجباري بموجب قرار من الوالي لمدة ستة (6) أشهر، على الأكثر، ويمكن أن يكون محل تجديد ضمن نفس الأشكال. في حالة الاحتجاج على طلب الاستشفاء الإجباري تخطر اللجنة الولائية للصحة العقلية ضمن الشروط المنصوص عليها في المادة 132 أعلاه. يبقي طبيب الأمراض العقلية ، بعد إعلامه بهذا الإخطار من طرف اللجنة المريض في الملاحظة الإجبارية في انتظار قرار اللجنة الولائية للصحة العقلية ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_154> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_154> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_155> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن الوالي أن يتخذ قرار الاستشفاء الإجباري بشأن أحد الأصول أو الفروع، الزوج أو الحواشي، الأخ أو الأخت العم أو الخال العمة أو الخالة وكذلك الشأن بالنسبة لأزواج هؤلاء الأشخاص. ويتم اللجوء في هذه الحالة إلى والي الولاية المجاورة."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_155_20180702_OpEnact_fd0c777e7b> ;
    dzdoc:replacementText "لا يمكن الوالي أن يتخذ قرار الاستشفاء الإجباري بشأن أحد الأصول أو الفروع، الزوج أو الحواشي، الأخ أو الأخت العم أو الخال العمة أو الخالة وكذلك الشأن بالنسبة لأزواج هؤلاء الأشخاص. ويتم اللجوء في هذه الحالة إلى والي الولاية المجاورة."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_155> ;
