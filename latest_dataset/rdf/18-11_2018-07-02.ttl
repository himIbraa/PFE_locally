<https://legal.dz/resource/law/2018-07-02/18-11#version_art_196> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يخضع الممارسون المتخصصون لأحكام القانون رقم 84-10 المؤرخ في 11 فبراير سنة 1984 والمتعلق بـ الخدمة المدنية . تضمن الدولة الوسائل المادية وتضع التدابير التحفيزية الضرورية لممارسة النشاط الخاضع لـ الخدمة المدنية ، لا سيما في ولايات الجنوب والهضاب العليا. يعين الممارسون الطبيون المتخصصون الخاضعون لـ الخدمة المدنية في الهياكل والمؤسسات العمومية للصحة ، حسب الحاجيات التي تحددها الخريطة الصحية . تحدد كيفيات تطبيق هذه المادة ، لا سيما قائمة التخصصات المعنية وكيفيات أداء الخدمة المدنية وكذا التدابير التح"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_196_20180702_OpEnact_39821190ff> ;
    dzdoc:replacementText "يخضع الممارسون المتخصصون لأحكام القانون رقم 84-10 المؤرخ في 11 فبراير سنة 1984 والمتعلق بـ الخدمة المدنية . تضمن الدولة الوسائل المادية وتضع التدابير التحفيزية الضرورية لممارسة النشاط الخاضع لـ الخدمة المدنية ، لا سيما في ولايات الجنوب والهضاب العليا. يعين الممارسون الطبيون المتخصصون الخاضعون لـ الخدمة المدنية في الهياكل والمؤسسات العمومية للصحة ، حسب الحاجيات التي تحددها الخريطة الصحية . تحدد كيفيات تطبيق هذه المادة ، لا سيما قائمة التخصصات المعنية وكيفيات أداء الخدمة المدنية وكذا التدابير التحفيزية المرافقة، عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_196> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_196> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

