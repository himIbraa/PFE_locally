<https://legal.dz/resource/law/2018-07-02/18-11#version_art_248> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتولى الصيدلية الاستشفائية المهام الآتية : ضمان، مع مراعاة القواعد التي تحكم سير المؤسسة، تسيير المواد الصيدلانية و الأدوية ومنتجات أو مستلزمات التضميد وكذا العتاد الطبي المعقم الموجه للاستعمال في المؤسسة، وتموينها وتحضيرها ومراقبتها وتخزينها وحيازتها وتسليمها، القيام أو المشاركة في كل عمل إعلامي حول هذه المواد الصيدلانية أو الأدوية أو العتاد أو الأشياء، وكذا في كل عمل ترقية حسن استعمالها والمساهمة في تقييمها، القيام أو المشاركة في كل عمل من شأنه أن يساهم في جودة وأمن المعالجات والعلاجات التي تد"@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_248_20180702_OpEnact_bafedb989e> ;
    dzdoc:replacementText "تتولى الصيدلية الاستشفائية المهام الآتية : ضمان، مع مراعاة القواعد التي تحكم سير المؤسسة، تسيير المواد الصيدلانية و الأدوية ومنتجات أو مستلزمات التضميد وكذا العتاد الطبي المعقم الموجه للاستعمال في المؤسسة، وتموينها وتحضيرها ومراقبتها وتخزينها وحيازتها وتسليمها، القيام أو المشاركة في كل عمل إعلامي حول هذه المواد الصيدلانية أو الأدوية أو العتاد أو الأشياء، وكذا في كل عمل ترقية حسن استعمالها والمساهمة في تقييمها، القيام أو المشاركة في كل عمل من شأنه أن يساهم في جودة وأمن المعالجات والعلاجات التي تدخل في مجال نشاطها، تطبيق قواعد الممارسات الحسنة للصيدلة الاستشفائية التي يحددها الوزير المكلف بالصحة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_248> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_248> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetScope "whole_article" ;
    dzdoc:validFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_249> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الصيدلية هي المؤسسة المخصصة لصرف المواد الصيدلانية والمستلزمات الطبية بالتجزئة وكذا تنفيذ مستحضرات وصفية وصيدلانية. كما يمكنها أن تضمن، بصفة ثانوية، التوزيع بالتجزئة للمواد شبه الصيدلانية. الصيدلي هو المالك والمسير الوحيد للمحل التجاري للصيدلية التي يمتلكها. تحدد قائمة المواد والمستلزمات الطبية عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_249_20180702_OpEnact_bc871acc06> ;
    dzdoc:replacementText "الصيدلية هي المؤسسة المخصصة لصرف المواد الصيدلانية والمستلزمات الطبية بالتجزئة وكذا تنفيذ مستحضرات وصفية وصيدلانية. كما يمكنها أن تضمن، بصفة ثانوية، التوزيع بالتجزئة للمواد شبه الصيدلانية. الصيدلي هو المالك والمسير الوحيد للمحل التجاري للصيدلية التي يمتلكها. تحدد قائمة المواد والمستلزمات الطبية عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_249> ;
