    dzdoc:targetDocumentUri "https://legal.dz/resource/law/1966-06-08/66-156"^^xsd:anyURI ;
    dzdoc:targetEId "art_303_bis_16" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_431_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_431> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 361 من هذا القانون، المتعلقة بنزع الأعضاء والأنسجة والخلايا من الأشخاص القصر أو عديمي الأهلية، طبقا لأحكام المواد من 303 مكرر 16 إلى 303 مكرر 20 من قانون العقوبات."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_432_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_432> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يقوم بالإشهار للتبرع بالأعضاء أو الأنسجة أو الخلايا البشرية لفائدة شخص أو مؤسسة، بالحبس من ستة (6) أشهر إلى سنة (1) وبغرامة من 200.000 دج إلى 400.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_433_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_433> ;
    dzdoc:position 0 ;
    dzdoc:text "يعاقب كل من يقوم بنزع أو زرع الأعضاء أو الأنسجة أو الخلايا البشرية أو يمارس نشاطات المساعدة الطبية على الإنجاب في مؤسسة غير مرخص لها، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_434_obligation_0_a8a25046> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasReference <https://legal.dz/resource/law/2018-07-02/18-11#art_434_obligation_0_a8a25046_ref_bb0692712a2a> ;
    dzdoc:hasRole <https://legal.dz/resource/law/2018-07-02/18-11#art_434_obligation_0_a8a25046_role_1078280260> ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_371> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_371> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_434> ;
    dznorm:position 0 ;
