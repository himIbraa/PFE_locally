<https://legal.dz/resource/law/2018-07-02/18-11#version_art_195> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمنع على الممارسين المفتشين القيام بمراقبة الهياكل والمؤسسات والهيئات التي يشرف عليها أو يسيرها أولياؤهم أو أشخاص تربطهم بهم صلة القرابة . ويمنع عليهم، لمدة سنتين (2) الموالية لتوقفهم عن ممارسة مهنتهم، أن تكون لهم مصالح مباشرة أو غير مباشرة في المؤسسات التي خضعت لمراقبتهم طبقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_195_20180702_OpEnact_32a5cea8fd> ;
    dzdoc:replacementText "يمنع على الممارسين المفتشين القيام بمراقبة الهياكل والمؤسسات والهيئات التي يشرف عليها أو يسيرها أولياؤهم أو أشخاص تربطهم بهم صلة القرابة . ويمنع عليهم، لمدة سنتين (2) الموالية لتوقفهم عن ممارسة مهنتهم، أن تكون لهم مصالح مباشرة أو غير مباشرة في المؤسسات التي خضعت لمراقبتهم طبقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
