<https://legal.dz/resource/law/2018-07-02/18-11#version_art_443> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن المستخدمين في وضعية نشاط في المؤسسات العمومية للصحة التابعة للوزارة المكلفة بالصحة التي تم تعديل قانونها الأساسي الاحتفاظ بالقانون الأساسي المطبق عليهم إذا رغبوا في ذلك ، ابتداء من تاريخ دخول هذا القانون حيز التنفيذ. ويبقى المستخدمون الذين يمارسون عملهم في إطار اتفاقات واتفاقيات التعاون، خاضعين للأحكام الخاصة بهم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
