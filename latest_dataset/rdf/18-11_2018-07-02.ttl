<https://legal.dz/resource/law/2018-07-02/18-11#art_431_extref_dfdb1866> a dzdoc:ExternalReference ;
    rdfs:label "المواد من 303 مكرر 16"@ar ;
    dzdoc:frbrUri "/akn/dz/act/law/1966-06-08/66-156#art_303_bis_16"^^xsd:anyURI ;
    dzdoc:normalizedUri "/akn/dz/act/law/1966-06-08/66-156#art_303_bis_16"^^xsd:anyURI ;
    dzdoc:rawHref "/akn/dz/act/law/1966-06-08/66-156#art_303_bis_16" ;
