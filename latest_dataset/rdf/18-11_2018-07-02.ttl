    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 247" ;
    dzdoc:position 244 ;
    dzdoc:usesTerm dzterm:hospital_pharmacy,
        dzterm:pharmacist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_256> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_11> ;
    dzdoc:eId "art_256" ;
    dzdoc:fullText "تتولى المصالح المختصة للوزارة المكلفة بالصحة مراقبة نوعية المخابر طبقا للإجراءات والمقاييس المعمول بها في هذا المجال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_256> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_256_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_256_20180702_OpEnact_32c5c7cb37> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_256_obligation_0_89c0b021> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 256" ;
    dzdoc:position 253 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_259> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:blood_transfusion_activity ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_12> ;
    dzdoc:eId "art_259" ;
    dzdoc:fullText "نشاط نقل الدم هو نشاط طبي يتمثل في : تحضير مواد الدم، تحليل الدم المتبرع به وتصنيفه، حفظ وتوزيع الدم ومشتقاته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_259> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_259_defocc_811148f795d5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_259_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_259_20180702_OpEnact_6c2ad2a957> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 259" ;
    dzdoc:position 256 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_264> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_12> ;
    dzdoc:eId "art_264" ;
    dzdoc:fullText "تنشأ وكالة وطنية للدم تكلف بضمان خدمة عمومية في مجال متابعة وتنفيذ السياسة الوطنية للدم ومراقبة، وترقية التبرع بالدم، واحترام الممارسات الحسنة المتعلقة باستعمال الدم. تحدد مهام هذه الوكالة وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_264> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_264_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_264_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_264_20180702_OpEnact_efe8d8c964> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 264" ;
    dzdoc:position 261 ;
    dzdoc:usesTerm dzterm:national_blood_agency .

<https://legal.dz/resource/law/2018-07-02/18-11#art_270> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_2> ;
    dzdoc:eId "art_270" ;
    dzdoc:fullText "تحدد الخريطة الصحية مقاييس التغطية الصحية وتضبط الوسائل الواجب تعبئتها على المستوى الوطني والجهوي، مع الأخذ في الحسبان، لا سيما الحوض السكاني والخصائص الوبائية والصحية والجغرافية والديموغرافية والاجتماعية والاقتصادية، قصد ضمان توزيع عادل للعلاجات الصحية. تعد الخريطة الصحية وتقيم وتحين دوريا، وفق كيفيات تحدد عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_270> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_270_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_270_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_270_20180702_OpEnact_3d90ba573f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 270" ;
    dzdoc:position 267 ;
    dzdoc:usesTerm dzterm:health_map .

<https://legal.dz/resource/law/2018-07-02/18-11#art_275> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:rehabilitation_centers ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3> ;
    dzdoc:eId "art_275" ;
    dzdoc:fullText "تعد هياكل ذات طابع صحي وتسمى \"مراكز إعادة التأهيل\" ، الهياكل المعتمدة من طرف الوزير المكلف بالصحة التي تضمن خدمات الفحص والعلاج الخاص بإعادة التأهيل الوظيفي البدني أو العقلي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_275> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_275_defocc_7495613ab60d> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_275_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_275_20180702_OpEnact_6b4b7f560f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "275" ;
    dzdoc:position 272 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_283> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:primary_care ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_283" ;
    dzdoc:fullText "العلاجات القاعدية أو الأولية هي كل خدمات الوقاية والترقية الصحية والعلاجات الأساسية وإعادة التأهيل التي تستجيب للحاجيات الصحية للأشخاص . وتمثل المستوى الأول لمسار العلاج في المنظومة الوطنية للصحة ويجب تقريبها، قدر الإمكان، من أماكن العيش والتعليم والتكوين والعمل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_283> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_283_defocc_decd3d0d4b47> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_283_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_283_20180702_OpEnact_0661eda16d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 283" ;
    dzdoc:position 280 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_284> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:secondary_care ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_284" ;
    dzdoc:fullText "العلاجات الثانوية هي مجمل الخدمات التشخيصية والعلاجية المتخصصة المقدمة في هياكل ومؤسسات الصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_284> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_284_defocc_239c099dc2a9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_284_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_284_20180702_OpEnact_02956581b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 284" ;
    dzdoc:position 281 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_285> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:high_level_care ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_285" ;
    dzdoc:fullText "العلاجات ذات المستوى العالي هي مجموع الخدمات التشخيصية والعلاجية عالية التخصص المقدمة في هياكل ومؤسسات الصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_285> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_285_defocc_ab252bb62226> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_285_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_285_20180702_OpEnact_a9187a9a25> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 285" ;
    dzdoc:position 282 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_287> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_287" ;
    dzdoc:fullText "يتم ضمان الرعاية التلطيفية على مستوى هياكل ومؤسسات الصحة وبالمنزل وفي المؤسسات ذات الطابع الصحي أو الاجتماعي التابعة للقطاعات الأخرى، لا سيما تلك التابعة للقطاع المكلف بالتضامن الوطني وفق الشروط والكيفيات التي يحددها الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_287> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_287_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_287_20180702_OpEnact_7f40faf764> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 287" ;
    dzdoc:position 284 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_287_condition_0_b19130a3> ;
    dzdoc:usesTerm dzterm:minister,
        dzterm:palliative_care .

<https://legal.dz/resource/law/2018-07-02/18-11#art_29> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:حماية_الصحة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_1> ;
    dzdoc:eId "art_29" ;
    dzdoc:fullText "حماية الصحة هي كل التدابير الصحية والاقتصادية والاجتماعية والتربوية والبيئية الرامية إلى الحد من الأخطار الصحية أو القضاء عليها، سواء كانت ذات أصل وراثي أو ناجمة عن التغذية أو عن سلوك الإنسان أو مرتبطة بالبيئة وذلك بغرض الحفاظ على صحة الشخص والجماعة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_29> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_29_defocc_ec1094cd57c0> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_29_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_29_20180702_OpEnact_ce0aae4f85> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "29" ;
    dzdoc:position 28 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_291> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_291" ;
    dzdoc:fullText "تلزم الهياكل والمؤسسات العمومية للصحة و المؤسسات الخاصة للصحة الموكلة لها مهمة الخدمة العمومية، بضمان التكفل الطبي بالأشخاص في وضع صعب المذكورين في المادة 88 أعلاه ، على مستوى هياكلها وبالمنزل و في المؤسسات ذات الطابع الصحي والاجتماعي التابعة للقطاعات الأخرى، لاسيما تلك التابعة لقطاع التضامن الوطني."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_291> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_291_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_291_20180702_OpEnact_66577dc138> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_291_obligation_0_8e639ac2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "291" ;
    dzdoc:position 288 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_88> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_88> ;
    dzdoc:usesTerm dzterm:private_health_institutions,
        dzterm:public_health_structures .

<https://legal.dz/resource/law/2018-07-02/18-11#art_294> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_294" ;
    dzdoc:fullText "تلزم الهياكل والمؤسسات العمومية والخاصة للصحة بالتصريح بالولادات والوفيات إلى المصالح المختصة للبلدية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_294> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_294_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_294_20180702_OpEnact_9d58f7d29b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_294_obligation_0_8dad24f9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "294" ;
    dzdoc:position 291 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_298> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_3> ;
    dzdoc:eId "art_298" ;
    dzdoc:fullText "تتمثل مختلف المؤسسات العمومية للصحة، لاسيما فيما يأتي : المركز الاستشفائي الجامعي، المؤسسة الاستشفائية المتخصصة، المقاطعة الصحية، مؤسسة الإعانة الطبية المستعجلة. تحدد كيفيات إنشاء هذه المؤسسات ومهامها وتنظيمها وسيرها وكذا معايير تصنيفها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_298> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_298_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_298_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_298_20180702_OpEnact_ed6f1984b4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 298" ;
    dzdoc:position 295 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_30> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_1> ;
    dzdoc:eId "art_30" ;
    dzdoc:fullText "تنظم هياكل الصحة، في إطار تنفيذ برامج الصحة، بمساعدة السلطة المعنية، حملات التوعية والإعلام وأعمال الوقاية من الأمراض والآفات الاجتماعية والحوادث والكوارث مهما كانت طبيعتها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_30> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_30_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_30_20180702_OpEnact_2509bc8484> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_30_obligation_0_1f9d0b89> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "30" ;
    dzdoc:position 29 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_302> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_3> ;
    dzdoc:eId "art_302" ;
    dzdoc:fullText "تخضع المؤسسة العمومية للصحة في مجال التسيير المالي والمحاسبي لما يأتي : المحاسبة العمومية بالنسبة لنفقات المستخدمين، النظام المحاسبي المالي المنصوص عليه في القانون رقم 07-11 المؤرخ في 15 ذي القعدة عام 1428 الموافق 25 نوفمبر سنة 2007 والمذكور أعلاه، بالنسبة للنفقات الأخرى. يسند مسك محاسبة المؤسسة إلى عون محاسب يعينه الوزير المكلف بالمالية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_302> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_302_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_302_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_302_20180702_OpEnact_e83e260419> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 302" ;
    dzdoc:position 299 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_302_extref_682991f7> ;
    dzdoc:usesTerm dzterm:minister_of_finance .

<https://legal.dz/resource/law/2018-07-02/18-11#art_304> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_3> ;
    dzdoc:eId "art_304" ;
    dzdoc:fullText "يتولى تدقيق حسابات المؤسسة العمومية للصحة والتصديق عليها محافظ حسابات يعينه الوزير المكلف بالمالية بالاشتراك مع الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_304> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_304_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_304_20180702_OpEnact_7e80ca115c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_304_obligation_0_8dc471d5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "304" ;
    dzdoc:position 301 ;
    dzdoc:usesTerm dzterm:auditor,
        dzterm:health_public_institution,
        dzterm:minister_finance,
        dzterm:minister_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_305> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:private_health_structures ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_305" ;
    dzdoc:fullText "الهياكل والمؤسسات الخاصة للصحة هي هياكل استكشاف و أو علاج واستشفاء فيما يتعلق بالصحة البشرية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_305> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_305_defocc_2622e6afa940> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_305_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_305_20180702_OpEnact_ce6ad06ee4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 305" ;
    dzdoc:position 302 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_310> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_310" ;
    dzdoc:fullText "تخضع الهياكل والمؤسسات الخاصة للصحة لمراقبة وتقييم المصالح والهيئات المختصة للوزارة المكلفة بالصحة، دون المساس بالمراقبات الأخرى التي تمارسها المصالح والأجهزة المؤهلة الأخرى طبقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_310> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_310_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_310_20180702_OpEnact_214c3f2a5a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_310_obligation_0_946d4231> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 310" ;
    dzdoc:position 307 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_315> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_4> ;
    dzdoc:eId "art_315" ;
    dzdoc:fullText "يبت الوزير المكلف بالصحة في الغلق المؤقت أو النهائي لكل هيكل أو مؤسسة خاصة للصحة بناء على تقرير المصالح المختصة. ويمكن الوالي أن يبت في الغلق الذي لا تتجاوز مدته ثلاثة (3) أشهر لكل هيكل أو مؤسسة صحية خاصة بناء على تقرير المصالح المختصة للوزارة المكلفة بالصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_315> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_315_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_315_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_315_20180702_OpEnact_ef0729e042> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 315" ;
    dzdoc:position 312 ;
    dzdoc:usesTerm dzterm:minister,
        dzterm:wali .

<https://legal.dz/resource/law/2018-07-02/18-11#art_32> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_1> ;
    dzdoc:eId "art_32" ;
    dzdoc:fullText "تخصص البرامج الجهوية لحماية الصحة للتكفل بالمشاكل الصحية الخاصة بعدة ولايات من الوطن، وتتولى إعدادها وتنفيذها المصالح الخارجية، ويتم تقييمها من طرف الوزير المكلف بالصحة . تستفيد البرامج الجهوية لحماية الصحة من تعديلات نوعية تخص الاحتياجات الصحية لأحواض سكانية معنية، لا سيما فيما يتعلق بتنظيم الهياكل في شكل شبكات، أو التوأمة بين مؤسسات الصحة من أجل التكفل، وكذا من تعبئة الموارد البشرية الضرورية لتنفيذها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_32> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_32_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_32_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_32_20180702_OpEnact_8c50f00c9e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "32" ;
    dzdoc:position 31 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_321> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_6> ;
    dzdoc:eId "art_321" ;
    dzdoc:fullText "تلزم هياكل ومؤسسات الصحة العمومية والخاصة بالانضمام إلى النظام الوطني للإعلام الصحي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_321> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_321_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_321_20180702_OpEnact_0a21182464> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_321_obligation_0_b4d1e18d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 321" ;
    dzdoc:position 318 ;
    dzdoc:usesTerm dzterm:national_health_information_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_322> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_6> ;
    dzdoc:eId "art_322" ;
    dzdoc:fullText "يتم تطبيق النظام الوطني للإعلام الصحي مع مراعاة قواعد الأمن والسرية وفقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_322> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_322_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_322_20180702_OpEnact_d3a858e26b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 322" ;
    dzdoc:position 319 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_322_condition_0_dade4523> ;
    dzdoc:usesTerm dzterm:national_health_information_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_327> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_7> ;
    dzdoc:eId "art_327" ;
    dzdoc:fullText "يتم إجراء التدقيق بطلب من مؤسسة الصحة ، ويتمثل هدفه في الحصول على تقدير مستقل حول تسيير ونوعية وكلفة الخدمات التي تقدمها المؤسسة بواسطة مؤشرات ومعايير ومراجع تتعلق بالإجراءات والممارسات العيادية الحسنة ونتائج مختلف المصالح والنشاطات التي تتشكل منها. وتنجز التدقيق المصالح المختصة للوزارة المكلفة بالصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_327> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_327_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_327_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_327_20180702_OpEnact_1819aad598> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "327" ;
    dzdoc:position 324 ;
    dzdoc:usesTerm dzterm:health_institution .

<https://legal.dz/resource/law/2018-07-02/18-11#art_329> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_329" ;
    dzdoc:fullText "تضمن الدولة تمويل القطاع العام للصحة طبقا للتشريع والتنظيم المعمول بهما بعنوان الوقاية والتكوين والبحث الطبي والتكفل الصحي بالمعوزين والأشخاص في وضع صعب."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_329> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_329_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_329_20180702_OpEnact_932199a296> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_329_obligation_0_a7364df7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 329" ;
    dzdoc:position 326 ;
    dzdoc:usesTerm dzterm:public_health_sector .

<https://legal.dz/resource/law/2018-07-02/18-11#art_33> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_1> ;
    dzdoc:eId "art_33" ;
    dzdoc:fullText "تخص البرامج المحلية لحماية الصحة بلدية أو عدة بلديات، وتهدف إلى التكفل الخاص بالاحتياجات الصحية المحددة كذات الأولوية بالنسبة لسكان هذه البلديات. تعد هذه البرامج ويتم تقييمها من طرف المصالح الخارجية للولاية المكلفة بالصحة، بالتعاون مع القطاعات المعنية، ويكون تنفيذها من اختصاص هياكل ومؤسسات الصحة والجماعات المحلية والمصالح التقنية المختصة في مجال الصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_33> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_33_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_33_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_33_20180702_OpEnact_d00a87bf8d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "33" ;
    dzdoc:position 32 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_330> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_330" ;
    dzdoc:fullText "تضمن هيئات الضمان الاجتماعي مساهمة بعنوان التغطية المالية لمصاريف العلاج المقدم للمؤمن لهم اجتماعيا وذوي حقوقهم من طرف المؤسسات العمومية للصحة على أساس تعاقدي مع الوزارة المكلفة بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_330> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_330_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_330_20180702_OpEnact_50b073901e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_330_obligation_0_b7a1a6b6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 330" ;
    dzdoc:position 327 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_332> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_332" ;
    dzdoc:fullText "تساهم المؤسسات الاقتصادية في تمويل الصحة في إطار أعمال مبرمجة بعنوان طب العمل وترقية الصحة، حسب كيفيات تحدد عن طريق التنظيم ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_332> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_332_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_332_20180702_OpEnact_29920b273e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 332" ;
    dzdoc:position 329 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_332_condition_0_69bdebf0> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_333> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_333" ;
    dzdoc:fullText "تشارك التأمينات الاقتصادية في تمويل الصحة بعنوان تعويض مصاريف التكفل الطبي، لا سيما بالأضرار الجسدية ومنتجات الصحة الأخرى. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_333> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_333_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_333_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_333_20180702_OpEnact_bad61af513> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 333" ;
    dzdoc:position 330 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_335> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_335" ;
    dzdoc:fullText "تحدد أعمال العلاجات ونشاطات الصحة ضمن هياكل ومؤسسات الصحة عن طريق مدونة الأعمال المهنية للصحة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_335> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_335_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_335_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_335_20180702_OpEnact_55abf42be9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 335" ;
    dzdoc:position 332 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_338> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:national_health_accounts ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_338" ;
    dzdoc:fullText "تنشر، سنويا، الموارد المعبأة لتمويل المنظومة الوطنية للصحة، وكذا النفقات المرتبطة بها في شكل حسابات تدعى \"الحسابات الوطنية للصحة\" ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_338> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_338_defocc_5ac66f9ec7fd> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_338_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_338_20180702_OpEnact_bf30513fa0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 338" ;
    dzdoc:position 335 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_339> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:medical_ethics ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_1> ;
    dzdoc:eId "art_339" ;
    dzdoc:fullText "تتمثل الأخلاقيات الطبية، بمفهوم هذا القانون، في قواعد الممارسات الحسنة التي يخضع لها مهنيو الصحة في ممارسة مهامهم، وتشمل قواعد الأدبيات والأخلاقيات العلمية والبيو- أخلاقيات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_339> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_339_defocc_3962291c2ce9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_339_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_339_20180702_OpEnact_b253c30d03> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "339" ;
    dzdoc:position 336 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_34> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:prevention ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2> ;
    dzdoc:eId "art_34" ;
    dzdoc:fullText "الوقاية هي كل الأعمال الرامية إلى : التقليص من أثر محددات الأمراض، و/أو تفادي حدوث أمراض، إيقاف انتشارها و/أو الحد من آثارها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_34> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_34_defocc_9d383bbbd592> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_34_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_34_20180702_OpEnact_7d592c46b7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "34" ;
    dzdoc:position 33 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_342> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_1> ;
    dzdoc:eId "art_342" ;
    dzdoc:fullText "ينشأ لدى الوزير المكلف بالصحة ، مجلس وطني لأخلاقيات علوم الصحة. وتحدد تشكيلته ومهامه وتنظيمه وسيره عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_342> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_342_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_342_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_342_20180702_OpEnact_3dd800b1f3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "342" ;
    dzdoc:position 339 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_345> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:الأدبيات_في_مجال_الصحة ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_345" ;
    dzdoc:fullText "الأدبيات في مجال الصحة هي مجمل المبادئ والقواعد التي تحكم مهن الصحة والعلاقات بين مهنيي الصحة فيما بينهم ومع المرضى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_345> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_345_defocc_3814524646d5> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_345_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_345_20180702_OpEnact_862cf7981f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 345" ;
    dzdoc:position 342 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_350> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_350" ;
    dzdoc:fullText "تكون قرارات المجالس الجهوية للأدبيات الطبية قابلة للطعن أمام المجالس الوطنية للأدبيات الطبية التابعة لها في أجل شهرين (2) ابتداء من تاريخ تبليغها. وتكون قرارات المجالس الوطنية للأدبيات الطبية قابلة للطعن أمام مجلس الدولة في أجل أربعة (4) أشهر، ابتداء من تاريخ تبليغها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_350> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_350_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_350_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_350_20180702_OpEnact_a2167f691b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 350" ;
    dzdoc:position 347 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_354> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:bioethics ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4> ;
    dzdoc:eId "art_354" ;
    dzdoc:fullText "البيو - أخلاقيات هي كل التدابير المرتبطة بالنشاطات المتعلقة بنزع الأعضاء وزرعها والأنسجة والخلايا والتبرع بالدم البشري ومشتقاته واستعمالهما والمساعدة الطبية على الإنجاب والبحث البيو- طبي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_354> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_354_defocc_c56dd6d7df0e> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_354_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_354_20180702_OpEnact_8d451c742e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 354" ;
    dzdoc:position 351 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_356> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_356" ;
    dzdoc:fullText "تنشأ وكالة وطنية لزرع الأعضاء تكلف بتنسيق وتطوير نشاطات نزع وزرع الأعضاء والأنسجة والخلايا البشرية وضمان قانونيتها وأمنها. تحدد مهام هذه الوكالة وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_356> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_356_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_356_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_356_20180702_OpEnact_9350689402> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 356" ;
    dzdoc:position 353 ;
    dzdoc:usesTerm dzterm:agency .

<https://legal.dz/resource/law/2018-07-02/18-11#art_367> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_367" ;
    dzdoc:fullText "لا يتقاضى الممارسون الذين يقومون بعمليات النزع والممارسون الذين يقومون بعمليات زرع الأعضاء والأنسجة والخلايا البشرية، أي أجر عن العمليات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_367> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_367_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_367_20180702_OpEnact_013f239fe9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_367_obligation_0_e8e10d16> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "367" ;
    dzdoc:position 364 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_383> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_383" ;
    dzdoc:fullText "تخضع الدراسات العيادية لرأي لجنة الأخلاقيات الطبية المذكورة أعلاه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_383> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_383_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_383_20180702_OpEnact_ba8d636613> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_383_obligation_0_aa49f375> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "383" ;
    dzdoc:position 380 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_382> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_382> ;
    dzdoc:usesTerm dzterm:clinical_studies,
        dzterm:ethics_committee .

<https://legal.dz/resource/law/2018-07-02/18-11#art_393> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_393" ;
    dzdoc:fullText "يتحمل المرقي بالنسبة للدراسات العيادية دون منفعة فردية مباشرة وفي كل الحالات، وإن انعدم الخطأ، تعويض الآثار المسببة للضرر بسبب الدراسة لصالح الشخص الخاضع لها ولذوي حقوقه ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_393> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_393_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_393_20180702_OpEnact_20f628f4b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_393_obligation_0_6f1e1531> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 393" ;
    dzdoc:position 390 ;
    dzdoc:usesTerm dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_399> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_399" ;
    dzdoc:fullText "يلزم المرقي بإعداد تقرير نهائي عن الدراسة يرسله إلى الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_399> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_399_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_399_20180702_OpEnact_a05338345d> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_399_obligation_0_52ed926a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 399" ;
    dzdoc:position 396 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_400> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_400" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 39 من هذا القانون المتعلقة بالأمراض ذات التصريح الإجباري بغرامة مالية تتراوح من 20.000 دج إلى 40.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_400> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_400_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_400_20180702_OpEnact_f683bd4f92> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_400_obligation_0_1b019716> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 400" ;
    dzdoc:position 397 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_39> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_39> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_407> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_407" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 79 من هذا القانون المتعلقة بالترويج لبدائل الرضاعة الطبيعية والإشهار لها، بغرامة من 500.000 دج إلى 1.000.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_407> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_407_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_407_20180702_OpEnact_9a86b49438> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_407_obligation_0_48c9165c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 407" ;
    dzdoc:position 404 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_79> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_79> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_408> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_408" ;
    dzdoc:fullText "يعاقب كل شخص أنتج أو تاجر في مواد غذائية غير صالحة للاستهلاك وتسبب في تسمم غذائي أو وفاة شخص أو عدة أشخاص، طبقا لأحكام المادتين 431 و 432 من قانون العقوبات، والمواد 71 و 72 و 73 من القانون رقم 09-03 المؤرخ في 25 فبراير سنة 2009 والمتعلق بحماية المستهلك وقمع الغش ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_408> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_408_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_408_20180702_OpEnact_3e3437694b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_408_obligation_0_63a52caa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 408" ;
    dzdoc:position 405 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_408_extref_6b26611a>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_408_extref_7a28176d>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_408_extref_7bc89705>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_408_extref_91f27634>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_408_extref_aa7edac4> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_409> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_409" ;
    dzdoc:fullText "يعاقب كل من يخالف الأحكام المتعلقة بإيقاف الحمل لغرض علاجي طبقا لأحكام المادة 304 من قانون العقوبات ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_409> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_409_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_409_20180702_OpEnact_ab7ee4ceee> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_409_obligation_0_3cc6fed5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 409" ;
    dzdoc:position 406 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_409_extref_f653d9a1> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_410> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_410" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 78 من هذا القانون، المتعلقة بإجبارية إجراء إيقاف الحمل لغرض علاجي في المؤسسات العمومية الاستشفائية بالحبس من ستة (6) أشهر إلى سنة (1) وبغرامة من 200.000 دج إلى 400.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_410> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_410_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_410_20180702_OpEnact_01b64a0f5f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_410_obligation_0_c3dbb151> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 410" ;
    dzdoc:position 407 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_78> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_78> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_411> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_411" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 143 من هذا القانون، المتعلقة ب التزام التكفل بالمريض المصاب باضطرابات عقلية ، طبقا لأحكام المادتين 314 و 316 من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_411> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_411_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_411_20180702_OpEnact_8efea2e07a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_411_obligation_0_ff18c9a1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 411" ;
    dzdoc:position 408 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_143> ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_411_extref_30aefdbe>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_411_extref_d32a07b8> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_143> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_412> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_412" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 161 من هذا القانون المتعلقة ب منع إخضاع المرضى الذين تم استشفاؤهم لأشغال غير موصوفة لهم في إطار العلاج الذي يخضعون له بالحبس من شهرين (2) إلى ستة (6) أشهر وبغرامة من 10.000 دج إلى 50.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_412> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_412_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_412_20180702_OpEnact_66e7af65e1> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_412_obligation_0_c0d12fa1> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 412" ;
    dzdoc:position 409 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_161> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_161> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_413> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_413" ;
    dzdoc:fullText "باستثناء الضرورة الطبية المبررة ، يعاقب طبقا لأحكام المواد 288 و 289 و 442 الفقرة (2) من قانون العقوبات، كل مهني الصحة ، عن كل تقصير أو خطأ مهني تم إثباته، يرتكبه خلال ممارسته مهامه أو بمناسبة القيام بها ويلحق ضررا بالسلامة البدنية لأحد الأشخاص أو بصحته أو يحدث له عجزا مستديما أو يعرض حياته للخطر أو يتسبب في وفاته."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_413> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_413_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_413_20180702_OpEnact_12b97fd43b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 413" ;
    dzdoc:position 410 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_413_extref_249de4b2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_413_extref_9253bcff>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_413_extref_cd32af9f> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_413_condition_0_67f60752> ;
    dzdoc:usesTerm dzterm:health_professional .

<https://legal.dz/resource/law/2018-07-02/18-11#art_414> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_414" ;
    dzdoc:fullText "يعاقب كل من ينشئ أو ينجز أو يفتح أو يستغل مؤسسة صحية دون الترخيص المنصوص عليه في المادتين 273 و 307 من هذا القانون ، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 1.000.000 دج إلى 2.000.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_414> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_414_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_414_20180702_OpEnact_29ea89addb> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 414" ;
    dzdoc:position 411 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_273>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_307> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_273>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_307> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_414_condition_0_e12d2793> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_417> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_417" ;
    dzdoc:fullText "عدم التقيد بالتزام السر الطبي والمهني ، يعرض صاحبه للعقوبات المنصوص عليها في أحكام المادة 301 من قانون العقوبات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_417> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_417_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_417_20180702_OpEnact_e375868ad5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_417_obligation_0_abc40f7f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 417" ;
    dzdoc:position 414 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_417_extref_3ee0d81d> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_419> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_419" ;
    dzdoc:fullText "يعاقب كل مهني الصحة الذي يخالف المنع المتعلق بالوصف الطبي أو تغييره المنصوص عليه في أحكام المادة 180 من هذا القانون بالحبس من ستة (6) أشهر إلى سنتين (2) وبغرامة من 50.000 دج إلى 100.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_419> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_419_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_419_20180702_OpEnact_fd3776bf3b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_419_obligation_0_e8b284d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 419" ;
    dzdoc:position 416 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_180> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_180> ;
    dzdoc:usesTerm dzterm:health_professional .

<https://legal.dz/resource/law/2018-07-02/18-11#art_42> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_2> ;
    dzdoc:eId "art_42" ;
    dzdoc:fullText "تخضع الوقاية من الأمراض ذات الانتشار الدولي ومكافحتها لأحكام اللوائح الصحية الدولية لمنظمة الصحة العالمية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_42> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_42_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_42_20180702_OpEnact_30681cf74c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_42_obligation_0_4a25315e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 42" ;
    dzdoc:position 41 ;
    dzdoc:usesTerm dzterm:international_spread_diseases .

<https://legal.dz/resource/law/2018-07-02/18-11#art_421> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_421" ;
    dzdoc:fullText "يعاقب كل من يخالف الأحكام المتعلقة ب الإعلام الخاص بالأعمال المهنية وتسعيرتها المحددة في التنظيم المعمول به بغرامة من 300.000 دج إلى 500.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_421> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_421_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_421_20180702_OpEnact_fed0572222> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_421_obligation_0_5e5b1350> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 421" ;
    dzdoc:position 418 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_422> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_422" ;
    dzdoc:fullText "يعاقب على كل نشاط إنتاج واستغلال واستيراد وتصدير وتوزيع المواد الصيدلانية من طرف مؤسسات غير معتمدة من المصالح المختصة ، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 5.000.000 دج إلى 10.000.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_422> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_422_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_422_20180702_OpEnact_fda91f7a6a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 422" ;
    dzdoc:position 419 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_422_condition_0_e4eb1a9b> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_427> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_427" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادتين 237 و 238 من هذا القانون، المتعلقة على التوالي، بالإشهار وبالإعلام العلمي حول المواد الصيدلانية بغرامة من 200.000 دج إلى 500.000 دج. و في حالة العود، تضاعف العقوبة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_427> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_427_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_427_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_427_20180702_OpEnact_3c36fd09af> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 427" ;
    dzdoc:position 424 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_237>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_238> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_237>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_238> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_435> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_435" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 374 من هذا القانون، المتعلقة بالتبرع والبيع وكل شكل من المعاملات بخصوص مواد الجسم البشري، بالحبس من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_435> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_435_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_435_20180702_OpEnact_65179455f6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_435_obligation_0_74e34cb4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 435" ;
    dzdoc:position 432 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_374> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_374> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_436> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_436" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 375 من هذا القانون، المتعلقة باستنساخ أجسام حية مماثلة وراثيا وانتقاء الجنس، بالحبس من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_436> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_436_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_436_20180702_OpEnact_15571da8f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_436_obligation_0_8df75d59> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 436" ;
    dzdoc:position 433 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_375> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_375> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_437> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_437" ;
    dzdoc:fullText "يعاقب كل من يستعمل الوضع رهن الملاحظة لشخص ما لغرض آخر غير مصلحته، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_437> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_437_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_437_20180702_OpEnact_e0f864ea3f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_437_obligation_0_25d53e72> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 437" ;
    dzdoc:position 434 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_438> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_438" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 381 من هذا القانون المتعلقة بالدراسات العيادية، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 5.000.000 دج إلى 10.000.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_438> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_438_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_438_20180702_OpEnact_9315d6829c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_438_obligation_0_67fd3d59> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 438" ;
    dzdoc:position 435 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_381> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_381> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_449> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_449" ;
    dzdoc:fullText "تلغى أحكام القانون رقم 85-05 المؤرخ في 26 جمادى الأولى عام 1405 الموافق 16 فبراير سنة 1985 والمتعلق بحماية الصحة ،وترقيتها، المعدل والمتمم، غير أن النصوص المتخذة لتطبيقه تبقى سارية المفعول إلى غاية صدور النصوص التنظيمية المنصوص عليها في هذا القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_449> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_449_para_0> ;
    dzdoc:hasStatus dzdoc:StatusRepealed ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_449_20180702_OpEnact_47996e1687> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 449" ;
    dzdoc:position 446 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_449_extref_6958f988> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_49> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_49" ;
    dzdoc:fullText "تهدف مكافحة الإدمان على التبغ إلى حماية صحة المواطنين والحفاظ عليها ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_49_right_0_e9a050f8> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_49> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_49_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_49_20180702_OpEnact_abcec36837> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "49" ;
    dzdoc:position 48 ;
    dzdoc:usesTerm dzterm:tobacco_addiction_control .

<https://legal.dz/resource/law/2018-07-02/18-11#art_54> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:tobacco_products ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_54" ;
    dzdoc:fullText "تعتبر موادا تبغية، المواد المخصصة للتدخين أو النشق أو الوضع على اللثة أو المضغ أو المص، بما في ذلك السيجارة الإلكترونية ما دامت تحتوي على التبغ ولو جزئيا ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_54> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_54_defocc_4fcc9a1deca4> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_54_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_54_20180702_OpEnact_f27ae70700> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "54" ;
    dzdoc:position 53 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_6> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_6" ;
    dzdoc:fullText "تهدف المنظومة الوطنية للصحة إلى التكفل باحتياجات المواطنين في مجال الصحة بصفة شاملة ومنسجمة ومستمرة. ويرتكز تنظيمها وسيرها على مبادئ الشمولية والمساواة في الحصول على العلاج والتضامن والعدل واستمرارية الخدمة العمومية والخدمات الصحية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_6_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_6_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_6_20180702_OpEnact_e279007bdc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 6" ;
    dzdoc:position 5 ;
    dzdoc:usesTerm dzterm:national_health_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_69> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_69" ;
    dzdoc:fullText "تضمن حماية صحة الأم والطفل بواسطة كل التدابير الطبية والنفسية والاجتماعية والتربوية والإدارية التي تهدف، لا سيما إلى ما يأتي : حماية صحة الأم قبل وأثناء وبعد الحمل، ضمان الظروف الصحية للطفل ونموه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_69> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_69_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_69_20180702_OpEnact_bb7503b01b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_69_obligation_0_a6ca27b3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 69" ;
    dzdoc:position 68 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_71> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_71" ;
    dzdoc:fullText "يشكل التنظيم العائلي أولوية لـ الصحة العمومية . ويساهم في الحفاظ على صحة الأم والطفل. وتعده هياكل ومؤسسات الصحة وتنفذه عبر كل التدابير والترتيبات الصحية والاجتماعية والتربوية وكذا الاتصال والتحسيس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_71> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_71_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_71_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_71_20180702_OpEnact_e86c6fe89a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 71" ;
    dzdoc:position 70 ;
    dzdoc:usesTerm dzterm:family_planning,
        dzterm:public_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_72> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_72" ;
    dzdoc:fullText "الفحص الطبي السابق للزواج إجباري . تحدد قائمة الفحوص والتحاليل عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_72> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_72_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_72_20180702_OpEnact_4c7d132a42> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_72_obligation_0_43683dfd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 72" ;
    dzdoc:position 71 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_75> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_75" ;
    dzdoc:fullText "تعد الوزارة المكلفة بالصحة برامج الكشف والتشخيص تخص المواليد حديثي الولادة، ويتم تنفيذها من طرف مؤسسات الصحة. تحدد قائمة الأمراض التي يجب كشفها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_75> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_75_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_75_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_75_20180702_OpEnact_c2f138198e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 75" ;
    dzdoc:position 74 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_82> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_82" ;
    dzdoc:fullText "تتولى الهياكل والمؤسسات المختصة المساعدة الطبية الاجتماعية الهادفة إلى الوقاية من التخلي عن الأطفال ، طبقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_82> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_82_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_82_20180702_OpEnact_95a9abe728> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_82_obligation_0_c2ae9436> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 82" ;
    dzdoc:position 81 ;
    dzdoc:usesTerm dzterm:structures_institutions .

<https://legal.dz/resource/law/2018-07-02/18-11#art_87> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_3> ;
    dzdoc:eId "art_87" ;
    dzdoc:fullText "تضمن هياكل ومؤسسات الصحة التكفل بالاحتياجات الصحية للأشخاص المسنين ، لا سيما أولئك المعوقين و/أو الذين هم في تبعية، بواسطة مستخدمين مؤهلين وكل وسيلة أخرى بما في ذلك العلاج والاستشفاء في المنزل."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_87> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_87_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_87_20180702_OpEnact_3ba5564572> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_87_obligation_0_53525150> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 87" ;
    dzdoc:position 86 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_91> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_4> ;
    dzdoc:eId "art_91" ;
    dzdoc:fullText "تتخذ الدولة التدابير القطاعية المشتركة الضرورية الهادفة إلى التكفل الصحي والاجتماعي بـ الأشخاص في وضع صعب ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_91> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_91_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_91_20180702_OpEnact_1f59d9e5ac> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_91_obligation_0_8ad4e4d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "91" ;
    dzdoc:position 90 ;
    dzdoc:usesTerm dzterm:persons_in_difficult_situation .

<https://legal.dz/resource/law/2018-07-02/18-11#art_92> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_4> ;
    dzdoc:eId "art_92" ;
    dzdoc:fullText "تضمن الدولة التكفل الطبي والنفسي وتوفر الوسائل الطبية للتخفيف من معاناة الأشخاص ضحايا العنف و/أو في وضعية نفسية صعبة قصد إعادة إدماجهم في المجتمع ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_92> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_92_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_92_20180702_OpEnact_9928f10afe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_92_obligation_0_af20480c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "92" ;
    dzdoc:position 91 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_95> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_5> ;
    dzdoc:eId "art_95" ;
    dzdoc:fullText "تهدف حماية الصحة وترقيتها المذكورتان في المادة 94 أعلاه، إلى حفظ صحة التلاميذ والطلبة والمتربصين وترقيتها، من خلال ما يأتي : مراقبة حالتهم الصحية ومتابعة التكفل بالأمراض التي تم الكشف عنها، مراقبة الأمراض ذات التصريح الإجباري والوقاية من الآفات الاجتماعية، نشاطات التربية من أجل الصحة، النشاطات العلاجية الجوارية مراقبة سلامة المحلات والملحقات التابعة لكل مؤسسة تعليم وتكوين، التلقيحات الإجبارية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_95> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_95_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_95_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_95_20180702_OpEnact_340bdfc056> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "95" ;
    dzdoc:position 94 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_94> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_94> ;
    dzdoc:usesTerm dzterm:health .

