<https://legal.dz/resource/law/2018-07-02/18-11#art_222_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_222> ;
    dzdoc:position 0 ;
    dzdoc:text "تحدد تعاريف إنتاج المواد الصيدلانية والمستلزمات الطبية وقواعد الممارسات الحسنة الصنع المواد الصيدلانية وتخزينها وتوزيعها وتقديمها واليقظة الصيدلانية واليقظة بخصوص العتاد وكذا تعريف وضعها في السوق، عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_224_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_224> ;
    dzdoc:position 0 ;
    dzdoc:text "الوكالة مؤسسة عمومية ذات تسيير خاص تتمتع بالشخصية المعنوية والاستقلال المالي، توضع تحت وصاية الوزير المكلف بالصحة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_225_obligation_0_d753cf43> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
