    dzdoc:versionOf <https://legal.dz/resource/law/2018-07-02/18-11#art_5> ;
    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_5> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "ترتكز المنظومة الوطنية للصحة على قطاع عمومي قوي."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_60_20180702_OpEnact_e000019c37> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
