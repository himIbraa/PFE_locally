    dzdoc:sourceEId "art_314" ;
    dzdoc:sourceElementType "condition" ;
    dzdoc:sourceTextSpan "السحب المؤقت أو النهائي لترخيص الاستغلال المنصوص عليه في المادة 307 أعلاه"@ar ;
    dzdoc:targetEId "art_307" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_314_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_314> ;
    dzdoc:position 0 ;
    dzdoc:text """يمكن السحب المؤقت أو النهائي لترخيص الاستغلال المنصوص عليه في المادة 307 أعلاه، عند:
              
              
              عدم احترام الشروط التنظيمية التقنية للتسيير،
              
              
              معاينة مخالفات القوانين والأنظمة في الهياكل والمؤسسات الخاصة للصحة،
              
              
              عدم ضمان أمن المرضى. عدم احترام الشروط التنظيمية التقنية للتسيير، معاينة مخالفات القوانين والأنظمة في الهياكل والمؤسسات الخاصة للصحة، عدم ضمان أمن المرضى."""@ar .

