        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_5>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_6>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_7>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_8>,
        <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_9> ;
    dzdoc:heading "المواد الصيدلانية والمستلزمات الطبية"@ar ;
    dzdoc:number "الخامس" ;
    dzdoc:position 4 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_141> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_141" ;
    dzdoc:fullText "يمكن في أي وقت تحويل وضع المريض في الملاحظة إلى استشفاء بفعل الغير بناء على اقتراح من طبيب الأمراض العقلية للمؤسسة وبعد موافقة أحد أعضاء أسرة المريض، أصل أو فرع مباشر أو ممثله الشرعي، يعبر عنها بطلب كتابي يدون في السجل المخصص لهذا الغرض. وتودع لدى مديرية المؤسسة نسخة من هذا الطلب تحمل توقيع وموافقة طبيب الأمراض العقلية للمؤسسة بغرض الاحتفاظ بها وتقديمها عند كل طلب من السلطات المختصة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_141_permission_0_4cb84067> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_141> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_141_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_141_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_141_20180702_OpEnact_2136f9439c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_141_obligation_0_064b7f96> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 141" ;
    dzdoc:position 139 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_141_condition_0_4cb84067> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_143> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_2_subsubsec_2> ;
    dzdoc:eId "art_143" ;
    dzdoc:fullText "يكون خروج المريض : إما بمبادرة من طبيب الأمراض العقلية للمؤسسة، وإما بطلب من المريض الراشد المؤهل مدنيا وإما بطلب من الشخص الذي كان سببا في الاستشفاء بفعل الغير، وإما بطلب من أحد الأصول أو الفروع المباشر الراشد للمريض أو زوج المريض أو أخيه أو أخته أو عمه أو عمته أو خاله أو خالته الراشدين أو الممثل الشرعي للمريض عديم الأهلية، وهم مسؤولون مدنيا عن المريض و يجب عليهم الالتزام بالتكفل به . يخضع كل طلب خروج للموافقة المسبقة لطبيب الأمراض العقلية و يجب أن يكون محررا كتابيا وموقعا من طرف الشخص الذي يقدمه . ويدون في سجل مخصص لهذا الغرض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_143> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_143_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_143_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_143_20180702_OpEnact_81baecc600> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_143_obligation_0_e5171078>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_143_obligation_1_f8f5a79a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 143" ;
    dzdoc:position 141 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_143_condition_0_cdbeea27> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_172> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_172" ;
    dzdoc:fullText "يجب على مهنيي الصحة المشاركة في المنظمة على مستوى هياكل ومؤسسات المناوبات الصحة العمومية والخاصة والصيدليات. يلزم مهنيو الصحة الذين يمارسون بصفة حرة، عند الضرورة، القيام بمناوبات على مستوى الهياكل العمومية للصحة. ويتقاضون أجرة على تأدية المناوبة وفقا للكيفيات التي تحدد عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_172> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_172_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_172_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_172_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_172_20180702_OpEnact_c541ba5cd5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_172_obligation_0_7c071532>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_172_obligation_1_de9d9fd5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 172" ;
    dzdoc:position 170 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_199> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_6> ;
    dzdoc:eId "art_199" ;
    dzdoc:fullText "في حالة استعمال العنف على شخص ما ، يتعين على كل طبيب إثبات الأضرار والجروح وإعداد شهادة وصفية . ويحدد نسب العجز والأضرار الأخرى طبيب متخصص في الطب الشرعي وفقا للتشريع والتنظيم المعمول بهما. ينبغي التصريح بكل جرح مشبوه، وجوبا، حسب الكيفيات المحددة في التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_199> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_199_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_199_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_199_20180702_OpEnact_0c1a899405> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_199_obligation_0_1d6b0409>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_199_obligation_1_8e15135c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "199" ;
    dzdoc:position 196 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_199_condition_0_3c059275> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_223> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:الوكالة_الوطنية_للمواد_الصيدلانية ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_4> ;
    dzdoc:eId "art_223" ;
    dzdoc:fullText "تنشأ وكالة وطنية للمواد الصيدلانية تدعى أدناه \" الوكالة \" ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_223> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_223_defocc_c2747e4a08a9> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_223_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_223_20180702_OpEnact_a1243fae34> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 223" ;
    dzdoc:position 220 ;
    dzdoc:usesTerm dzterm:الوكالة .

<https://legal.dz/resource/law/2018-07-02/18-11#art_233> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_5> ;
    dzdoc:eId "art_233" ;
    dzdoc:fullText "يمكن الوزير المكلف بالصحة ، وبعد رأي الوكالة الوطنية للمواد الصيدلانية ، أن يسلم ترخيصا مؤقتا لاستعمال أدوية غير مسجلة عندما توصف هذه الأدوية في إطار التكفل بأمراض خطيرة ولا يوجد علاج معادل لها على التراب الوطني ولديها منفعة علاجية مثبتة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_233_permission_0_1fc83e87> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_233_right_0_bb155a82> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_233> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_233_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_233_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_233_20180702_OpEnact_da49c7b541> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "233" ;
    dzdoc:position 230 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_233_condition_0_493fe339> ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:national_agency_pharmaceutical_products .

<https://legal.dz/resource/law/2018-07-02/18-11#art_263> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_12> ;
    dzdoc:eId "art_263" ;
    dzdoc:fullText "يمنع كل نشاط مربح يتعلق بالدم البشري أو البلازما أو مشتقاتهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_263> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_263_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_263_20180702_OpEnact_1131790917> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_263_obligation_0_e500cdb5> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_263_prohibition_0_5acd55ec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 263" ;
    dzdoc:position 260 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_344> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_2> ;
    dzdoc:eId "art_344" ;
    dzdoc:fullText "في حالة رفض علاجات طبية ، يمكن اشتراط تصريح كتابي من المريض أو ممثله الشرعي. غير أنه في حالات الاستعجال أو في حالة مرض خطير أو معد، أو عندما تكون حياة المريض مهددة بشكل خطير ، يجب على مهني الصحة أن يقدم العلاجات، وعند الاقتضاء، تجاوز الموافقة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_344_permission_0_0c6da7fe> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_344> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_344_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_344_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_344_20180702_OpEnact_c139b48960> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_344_obligation_0_c1197b38> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "344" ;
    dzdoc:position 341 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_344_condition_0_f2fa8429>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_344_condition_1_96cf2570> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_368> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_2> ;
    dzdoc:eId "art_368" ;
    dzdoc:fullText "يجب أن تكون عملية التبرع بالدم مسبوقة بمقابلة طبية مع المتبرع تراعى خلالها القواعد الطبية . يجب إعلام المتبرع في مجال التبرع بالدم قبل وأثناء عملية نزع الدم . توضح كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_368> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_368_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_368_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_368_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_368_20180702_OpEnact_4e0df3d5c7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_368_obligation_0_be4cdaec>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_368_obligation_1_403fc348> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 368" ;
    dzdoc:position 365 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_368> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_368> ;
    dzdoc:usesTerm dzterm:blood_donation .

<https://legal.dz/resource/law/2018-07-02/18-11#art_38> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_38" ;
    dzdoc:fullText "يخضع الأشخاص المصابون بأمراض منتقلة والأشخاص الذين يكونون على اتصال بهم، الذين قد يشكلون مصدرا للعدوى، لتدابير الوقاية والمكافحة المناسبة . تحدد قائمة الأمراض المنتقلة الخاضعة للتصريح الإجباري، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_38> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_38_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_38_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_38_20180702_OpEnact_6f8ea0b67a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_38_obligation_0_8183504d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "38" ;
    dzdoc:position 37 ;
    dzdoc:usesTerm dzterm:communicable_diseases .

<https://legal.dz/resource/law/2018-07-02/18-11#art_387> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_387" ;
    dzdoc:fullText "يجب إدراج موافقة الشخص المستعد للخضوع للدراسة العيادية ضمن بروتوكول الدراسات . وتطبق موافقة الشخص حصريا وفقط على الدراسة التي التمست من أجله. ويمكن سحبها في أي وقت دون تحمل أي مسؤولية ودون إلحاق أي ضرر بالتكفل العلاجي . لا يمكن لأي شخص إخضاع نفسه لعدة أبحاث بيوطبية في نفس الوقت."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_387_permission_0_4df4b666> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_387_right_0_d980c03f> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_387> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_387_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_387_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_387_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_387_20180702_OpEnact_b6075b212c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_387_obligation_0_2639540d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 387" ;
    dzdoc:position 384 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_39> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_39" ;
    dzdoc:fullText "يجب على كل ممارس طبي التصريح فورا للمصالح الصحية المعنية بكل حالة مشكوك فيها أو مؤكدة من الأمراض الواردة في قائمة الأمراض ذات التصريح الإجباري المذكورة في المادة 38 أعلاه ، تحت طائلة العقوبات المنصوص عليها في القانون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_39> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_39_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_39_20180702_OpEnact_af01bdb33c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_39_obligation_0_1dd56fcd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "39" ;
    dzdoc:position 38 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_38> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_38> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_53> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_53" ;
    dzdoc:fullText "زيادة على الإنذارات الصحية المنصوص عليها في المادة 52 أعلاه، يجب أن تتضمن جميع أشكال توضيب مواد التبغ والبطاقات الملصقة عليها، بيانات عن التركيبات السامة الأساسية وإفرازاتها . تحدد البيانات المنصوص عليها في الفقرة أعلاه، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_53> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_53_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_53_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_53_20180702_OpEnact_f1534e769f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_53_obligation_0_15640ed5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "53" ;
    dzdoc:position 52 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_52> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_52> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_55> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_55" ;
    dzdoc:fullText "يجب على منتجي ومستوردي مواد التبغ، تبليغ السلطات المختصة في هذا المجال، كل المعلومات المتعلقة بتركيبة مواد التبغ وإفرازاتها ، التي يجب عليها القيام بالتحقيقات الضرورية طبقا للمعايير والمقاييس المعمول بها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_55> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_55_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_55_20180702_OpEnact_5402f0dc0a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_55_obligation_0_5f4631de> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "55" ;
    dzdoc:position 54 .

