<https://legal.dz/resource/law/2018-07-02/18-11#version_art_370> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المساعدة الطبية على الإنجاب هي نشاط طبي يسمح بالإنجاب خارج المسار الطبيعي، في حالة العقم المؤكد طبيا. وتتمثل في ممارسات عيادية وبيولوجية وعلاجية تسمح بتنشيط عملية الإباضة والتلقيح بواسطة الأنابيب ونقل الأجنة والتخصيب الاصطناعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_370_20180702_OpEnact_7560668d8a> ;
    dzdoc:replacementText "المساعدة الطبية على الإنجاب هي نشاط طبي يسمح بالإنجاب خارج المسار الطبيعي، في حالة العقم المؤكد طبيا. وتتمثل في ممارسات عيادية وبيولوجية وعلاجية تسمح بتنشيط عملية الإباضة والتلقيح بواسطة الأنابيب ونقل الأجنة والتخصيب الاصطناعي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_370> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_370> ;
    dzdoc:targetDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
