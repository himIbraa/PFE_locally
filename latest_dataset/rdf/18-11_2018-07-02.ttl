<https://legal.dz/resource/law/2018-07-02/18-11#version_art_232> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يجوز للممارسين الطبيين أن يصفوا أو يستعملوا إلا الأدوية المسجلة والمواد الصيدلانية والمستلزمات الطبية المصادق عليها المستعملة في الطب البشري والواردة في المدونات الوطنية الخاصة بها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_232_20180702_OpEnact_930b48d0b4> ;
