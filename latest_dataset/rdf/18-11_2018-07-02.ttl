    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "89" ;
    dzdoc:position 88 ;
    dzdoc:usesTerm dzterm:persons_in_difficult_situation .

<https://legal.dz/resource/law/2018-07-02/18-11#art_97> a dzdoc:Article ;
