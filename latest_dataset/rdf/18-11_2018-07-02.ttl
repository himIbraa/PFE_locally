    dzdoc:eId "art_89" ;
    dzdoc:fullText "لـ الأشخاص في وضع صعب الحق في حماية صحية خاصة على عاتق الدولة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_89_right_0_8543c2cf> ;
