    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف أحكام المادة 371 من هذا القانون المتعلقة ب المساعدة الطبية على الإنجاب ، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_435_20180702_OpEnact_65179455f6> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
