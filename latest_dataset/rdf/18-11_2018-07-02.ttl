    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 361 من هذا القانون، المتعلقة بنزع الأعضاء والأنسجة والخلايا من الأشخاص القصر أو عديمي الأهلية، طبقا لأحكام المواد من 303 مكرر 16 إلى 303 مكرر 20 من قانون العقوبات."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_432_20180702_OpEnact_8ee8a1a19e> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
