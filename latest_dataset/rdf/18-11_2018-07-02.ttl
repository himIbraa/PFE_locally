<https://legal.dz/resource/law/2018-07-02/18-11#version_art_381> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تخضع الدراسات العيادية لترخيص الوزير المكلف بالصحة الذي يبت في أجل ثلاثة (3) أشهر، على أساس ملف طبي وتقني، وتصريح بشأن إنجاز الدراسات العيادية على الكائن البشري، يقدمها المرقي . يخضع كل تعديل لملف الدراسات العيادية ، بعد الحصول على الترخيص، لموافقة الوزير المكلف بالصحة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_381_20180702_OpEnact_e85eb511b4> ;
