<https://legal.dz/resource/law/2018-07-02/18-11#art_413_extref_cd32af9f> a dzdoc:ExternalReference ;
    rdfs:label "المواد 288"@ar ;
    dzdoc:frbrUri "/akn/dz/act/code/1966-06-08/66-156#art_288"^^xsd:anyURI ;
