    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_424> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف الأحكام المتعلقة بالنوكليدات الإشعاعية، بالحبس من ستة (6) أشهر إلى سنتين (2) وبغرامة من 200.000 دج إلى 500.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_425_20180702_OpEnact_b0b6d10561> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
