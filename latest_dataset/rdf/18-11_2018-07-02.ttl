<https://legal.dz/resource/law/2018-07-02/18-11#version_art_353> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يؤدي كل خطأ أو غلط طبي مثبت بعد خبرة ، من شأنه أن يقحم مسؤولية المؤسسة و/أو الممارس الطبي أو مهني الصحة، يرتكب خلال ممارسة مهامهم أو بمناسبتها والذي يمس السلامة الجسدية أو الصحية للمريض، ويسبب عجزا دائما ويعرض الحياة للخطر أو يتسبب في وفاة شخص ، إلى تطبيق العقوبات المنصوص عليها في التشريع والتنظيم المعمول بهما ."@ar ;
