dzterm:pharmaceutical_products a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المواد الصيدلانية"@ar,
        "تتضمن المواد الصيدلانية، في مفهوم هذا القانون، ما يأتي :"@ar,
        "مادة صيدلانية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_207_defocc_28091b4897c3> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_102> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_7> ;
    dzdoc:eId "art_102" ;
    dzdoc:fullText "تعد مصالح الصحة التابعة لإدارة الوسط العقابي تقريرا سنويا عن ظروف وحالة صحة المحبوسين داخل المؤسسات العقابية وترسله إلى الوزيرين المكلفين ، على التوالي، بالصحة والعدل ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_102> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_102_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_102_20180702_OpEnact_ccf5d8c13f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_102_obligation_0_92b35c14> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 102" ;
    dzdoc:position 101 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_107> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_107" ;
    dzdoc:fullText "تبدي المصالح التابعة لـ الوزارة المكلفة بالصحة رأيها بخصوص المقاييس البيئية ذات الأثر على صحة المواطنين. تتولى الجماعات المحلية ومصالح الوزارات المعنية، بالتنسيق مع مصالح الصحة ، نشاطات رصد ومراقبة احترام مقاييس ونوعية المياه والهواء الجوي والمواد الغذائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_107> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_107_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_107_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_107_20180702_OpEnact_d712d3944c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_107_obligation_0_f9a299c4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "107" ;
    dzdoc:position 106 ;
    dzdoc:usesTerm dzterm:minister_health .

<https://legal.dz/resource/law/2018-07-02/18-11#art_108> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_108" ;
    dzdoc:fullText "يجب أن يستوفي الماء المخصص للشرب والنظافة الجسدية والاستعمال المنزلي والسقي ومياه السباحة، المقاييس المحددة في التنظيم المعمول به ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_108> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_108_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_108_20180702_OpEnact_46e66fe783> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_108_obligation_0_1f9d06ac> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "108" ;
    dzdoc:position 107 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_115> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_115" ;
    dzdoc:fullText "يتعين على هياكل ومؤسسات الصحة وضع ترتيبات الحماية من الإشعاعات الأيونية طبقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_115> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_115_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_115_20180702_OpEnact_2b3c46d41c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_115_obligation_0_e7c34a7b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "115" ;
    dzdoc:position 114 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_120> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_5> ;
    dzdoc:eId "art_120" ;
    dzdoc:fullText "تتولى الدولة و الجماعات المحلية ومؤسسات التربية والتعليم العالي والتكوين المهني، التربية من أجل الصحة . وتهدف هذه التربية إلى المساهمة في توفير الراحة للمواطنين بتمكينهم من اكتساب المعارف الضرورية في مجال التربية الصحية، لا سيما منها : حفظ الصحة الفردية والجماعية، حماية البيئة، الوقاية من الأخطار الطبيعية، التغذية الصحية والمتوازنة، ترقية صحة الفم والأسنان، الوقاية من الأمراض والحوادث، الوقاية في مجال الصحة العقلية، الوقاية في مجال الصحة الإنجابية، لا سيما التربية الجنسية لدى الشباب، استهلاك الأدوية، مكافحة الممارسات الضارة بالصحة، ترقية ممارسة التربية البدنية والرياضية والرياضات."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_120> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_120_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_120_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_120_20180702_OpEnact_6921bcea91> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_120_obligation_0_a98ba56d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "120" ;
    dzdoc:position 118 ;
    dzdoc:usesTerm dzterm:health_education,
        dzterm:local_authorities,
        dzterm:state .

<https://legal.dz/resource/law/2018-07-02/18-11#art_126> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_1_subsec_1> ;
    dzdoc:eId "art_126" ;
    dzdoc:fullText "يتم التكفل بالمرضى المصابين باضطرابات عقلية أو نفسية ، لا سيما في أحد الهياكل الآتية : هياكل الصحة القاعدية بما في ذلك المراكز الوسيطة للصحة العقلية، مصالح طب الأمراض العقلية، ومصالح استعجالات طب الأمراض العقلية بالمؤسسات الاستشفائية، المؤسسات الاستشفائية المتخصصة في طب الأمراض العقلية، الهياكل التابعة للقطاعات الأخرى المعتمدة أو المرخص لها من طرف الوزير المكلف بالصحة . يحدد تنظيم هذه الهياكل وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_126> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_126_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_126_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_126_20180702_OpEnact_d6d188805f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_126_obligation_0_a6a2ead5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "126" ;
    dzdoc:position 124 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_133> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_133" ;
    dzdoc:fullText "تكلف اللجنة الولائية للصحة العقلية ، لا سيما بما يأتي : دراسة كل طلب صادر عن الوالي أو طبيب الأمراض العقلية للمؤسسة والفصل فيه بخصوص استشفاء مريض مصاب باضطرابات عقلية أو إبقائه بالمستشفى أو إخراجه، دراسة كل طلب يتقدم به المريض أو ممثله الشرعي أو كل شخص يتصرف لمصلحته والفصل فيه. تعد قرارات اللجنة الولائية للصحة العقلية نافذة بالنسبة للسلطات والإدارات المعنية. يحدد تنظيم اللجنة وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_133> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_133_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_133_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_133_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_133_20180702_OpEnact_9458a0f062> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 133" ;
    dzdoc:position 131 ;
    dzdoc:usesTerm dzterm:provincial_mental_health_committee .

<https://legal.dz/resource/law/2018-07-02/18-11#art_134> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_1_subsec_2> ;
    dzdoc:eId "art_134" ;
    dzdoc:fullText "يمكن قاضي الجهة القضائية المختصة التي تتبع لاختصاصها المؤسسة المستقبلة، أن يعين مقدما، طبقا للتشريع المعمول به للمريض المصاب باضطرابات عقلية الذي تم استشفاؤه دون موافقته، والذي لم يستفد من إجراء آخر للحماية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_134_permission_0_fd649fc7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_134> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_134_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_134_20180702_OpEnact_41a8aefff2> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 134" ;
    dzdoc:position 132 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_150> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_2> ;
    dzdoc:eId "art_150" ;
    dzdoc:fullText "يجب ألا تتجاوز مدة الوضع في الملاحظة الإجبارية خمسة عشر (15) يوما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_150> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_150_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_150_20180702_OpEnact_3f8fa3f9ed> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_150_obligation_0_a65906e3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "150" ;
    dzdoc:position 148 ;
    dzdoc:usesTerm dzterm:observation_obligatoire .

<https://legal.dz/resource/law/2018-07-02/18-11#art_157> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_4> ;
    dzdoc:eId "art_157" ;
    dzdoc:fullText "يمكن طبيب الأمراض العقلية المعين من طرف جهة قضائية مختصة في إطار خبرة، أن يطلب من أجل أداء مهمته، الوضع في الملاحظة أو استشفاء إجباريا قصد القيام بالملاحظة العيادية للشخص الذي كلف به."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_157_permission_0_96a364ae> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_157> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_157_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_157_20180702_OpEnact_856a38a597> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 157" ;
    dzdoc:position 155 ;
    dzdoc:usesTerm dzterm:psychiatrist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_158> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_4> ;
    dzdoc:eId "art_158" ;
    dzdoc:fullText "يمكن أن يتم الاستشفاء القضائي، حسب الحالة، في شكل حجز قضائي في مؤسسة طب الأمراض العقلية أو في شكل وضع قضائي في مؤسسة علاجية طبقا لأحكام المادتين 21 و 22 من قانون العقوبات."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_158_permission_0_bfb78bf2> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_158> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_158_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_158_20180702_OpEnact_5a66d8a56e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 158" ;
    dzdoc:position 156 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_158_extref_2c66a817>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_158_extref_69f3668b> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_162> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_3> ;
    dzdoc:eId "art_162" ;
    dzdoc:fullText "يمسك في كل مؤسسة تتوفر لديها وحدة أو مصلحة مغلقة لـ الاستشفاء الإجباري سجل مرقم ومؤشر عليه من رئيس المحكمة لمقر المؤسسة. وتتم مراقبة هذا السجل والتأشير عليه، كل ستة (6) أشهر، من طرف الوالي و النائب العام لدى المجلس القضائي."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_162> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_162_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_162_20180702_OpEnact_70f496e0a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_162_obligation_0_8a06e3ca>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_162_obligation_1_dd3c8033> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 162" ;
    dzdoc:position 160 ;
    dzdoc:usesTerm dzterm:compulsory_hospitalization,
        dzterm:prosecutor_general,
        dzterm:wali .

<https://legal.dz/resource/law/2018-07-02/18-11#art_163> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_3> ;
    dzdoc:eId "art_163" ;
    dzdoc:fullText "يمكن الوالي أو النائب العام لدى المجلس القضائي أن يطلب، عن طريق التسخير، في أي وقت، شهادة تثبت حالة المريض الخاضع لـ الاستشفاء الإجباري من طبيب الأمراض العقلية للمؤسسة."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_163_permission_0_30984f52> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_163> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_163_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_163_20180702_OpEnact_31d477f313> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 163" ;
    dzdoc:position 161 ;
    dzdoc:usesTerm dzterm:compulsory_hospitalization,
        dzterm:prosecutor_general,
        dzterm:psychiatrist,
        dzterm:wali .

<https://legal.dz/resource/law/2018-07-02/18-11#art_178> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_178" ;
    dzdoc:fullText "يتعين على مهنيي الصحة الامتثال لتسخيرات السلطة العمومية طبقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_178> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_178_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_178_20180702_OpEnact_8cd33cb724> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_178_obligation_0_fbf899e9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 178" ;
    dzdoc:position 175 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_18> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_2> ;
    dzdoc:eId "art_18" ;
    dzdoc:fullText "تسهر الدولة على ضمان العلاجات القاعدية أو الأولية والعلاجات الثانوية والعلاجات ذات المستوى العالي ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_18> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_18_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_18_20180702_OpEnact_7acdbc2ea5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_18_obligation_0_473e9989> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 18" ;
    dzdoc:position 17 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_181> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_181" ;
    dzdoc:fullText "يتعين على مهنيي الصحة : الاستعانة، فورا، بتدخل ممارس طبي عند وقوع أو احتمال وقوع مضاعفات أثناء ممارسة نشاطاتهم، عدم تعريض المريض لأخطار غير متكافئة مع الفائدة العلاجية المرجوة، تنفيذ كل الوسائل الموضوعة تحت تصرفهم من أجل ضمان حياة كريمة للمرضى."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_181> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_181_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_181_20180702_OpEnact_3e03a0cfe6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_181_obligation_0_902f95d7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 181" ;
    dzdoc:position 178 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_183> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_2> ;
    dzdoc:eId "art_183" ;
    dzdoc:fullText "يستفيد مهنيو الصحة لهياكل ومؤسسات الصحة ، أثناء ممارسة مهامهم، من الأمن وحماية الدولة من كل أشكال العنف طبقا للتشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_183_right_0_71510a68> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_183> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_183_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_183_20180702_OpEnact_1cb562e466> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 183" ;
    dzdoc:position 180 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_20> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_2> ;
    dzdoc:eId "art_20" ;
    dzdoc:fullText "تتولى الدولة حماية وترقية حق المواطنين في التربية في مجال الصحة ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_20_right_0_c16dce29> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_20> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_20_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_20_20180702_OpEnact_50744a38f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_20_obligation_0_5cde3d93> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 20" ;
    dzdoc:position 19 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_215> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:pharmacopoeia ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_2> ;
    dzdoc:eId "art_215" ;
    dzdoc:fullText "دستور الأدوية هو السجل الذي يضم الخصائص المطبقة على الأدوية ومكوناتها وعلى بعض المستلزمات الطبية وكذا مناهج التعرف عليها وتجريبها وتحليلها بغرض ضمان مراقبتها وتقييم نوعيتها. يتمم دستور الأدوية بـ السجل الوطني للأدوية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_215> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_215_defocc_e277f6a78e03> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_215_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_215_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_215_20180702_OpEnact_7dc2864779> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 215" ;
    dzdoc:position 212 ;
    dzdoc:usesTerm dzterm:national_drug_register,
        dzterm:pharmacopoeia .

<https://legal.dz/resource/law/2018-07-02/18-11#art_226> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_4> ;
    dzdoc:eId "art_226" ;
    dzdoc:fullText "تسجل الاعتمادات الضرورية لتأدية مهام الوكالة في ميزانية الدولة . تتأتى الموارد المالية للوكالة ، على الخصوص مما يأتي : الإعانات المسجلة في ميزانية الدولة، الإيرادات المرتبطة بنشاط الوكالة ، لاسيما الأتاوى المتأتية من تسجيل المواد الصيدلانية والمستلزمات الطبية ذات الاستعمال البشري والمصادقة عليها والإشهار لها، طبقا للتشريع والتنظيم المعمول بهما، مداخيل الخدمات المقدمة، الهبات والوصايا، كل إيرادات أخرى مرتبطة بنشاطها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_226> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_226_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_226_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_226_20180702_OpEnact_d13553b36a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_226_obligation_0_f6b66a79> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 226" ;
    dzdoc:position 223 ;
    dzdoc:usesTerm dzterm:الوكالة .

<https://legal.dz/resource/law/2018-07-02/18-11#art_227> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_4> ;
    dzdoc:eId "art_227" ;
    dzdoc:fullText "تمسك محاسبة الوكالة طبقا لأحكام النظام المحاسبي المالي المنصوص عليها في القانون رقم 07-11 المؤرخ في 15 ذي القعدة عام 1428 الموافق 25 نوفمبر سنة 2007 والمذكور أعلاه . تخضع الوكالة في مجال مراقبة النفقات، للمراقبة البعدية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_227> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_227_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_227_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_227_20180702_OpEnact_d874614213> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_227_obligation_0_77441953> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 227" ;
    dzdoc:position 224 ;
    dzdoc:referencesExternal <https://legal.dz/resource/law/2018-07-02/18-11#art_227_extref_682991f7> ;
    dzdoc:usesTerm dzterm:الوكالة .

<https://legal.dz/resource/law/2018-07-02/18-11#art_234> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_5> ;
    dzdoc:eId "art_234" ;
    dzdoc:fullText "تنشأ لدى الوكالة لجنة اقتصادية قطاعية مشتركة للأدوية تتمثل مهمتها الرئيسية في تحديد أسعار الأدوية عند تسجيلها. تفصل اللجنة، عند الحاجة في أسعار الأدوية، نهائيا، بعد دراسة ملف التعويض من طرف الجهاز المختص التابع للضمان الاجتماعي طبقا للتشريع والتنظيم المعمول بهما. تحدد مهام هذه اللجنة وتشكيلتها وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_234> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_234_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_234_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_234_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_234_20180702_OpEnact_6348ea7483> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "234" ;
    dzdoc:position 231 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_243> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_7> ;
    dzdoc:eId "art_243" ;
    dzdoc:fullText "تتولى الوكالة الوطنية للمواد الصيدلانية مراقبة الجودة والقيام بالخبرة واليقظة وإحصاء الآثار غير المرغوب فيها المترتبة على استعمال المواد الصيدلانية و المستلزمات الطبية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_243> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_243_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_243_20180702_OpEnact_27469c7c47> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_243_obligation_0_e1ab961e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 243" ;
    dzdoc:position 240 ;
    dzdoc:usesTerm dzterm:medical_devices,
        dzterm:national_pharmaceutical_agency,
        dzterm:pharmaceutical_products .

<https://legal.dz/resource/law/2018-07-02/18-11#art_254> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_11> ;
    dzdoc:eId "art_254" ;
    dzdoc:fullText "يمكن أن تختص بتنفيذ أعمال بيولوجية تتطلب تأهيلا خاصا أو اللجوء إلى مواد تشكل خطرا خاصا أو إلى تقنيات جد خاصة، مخابر تستجيب للشروط التقنية ومقاييس الصحة في هذا المجال."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_254_permission_0_18d3ddbf> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_254> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_254_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_254_20180702_OpEnact_6ec38fe24d> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 254" ;
    dzdoc:position 251 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_255> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_11> ;
    dzdoc:eId "art_255" ;
    dzdoc:fullText "يخضع إنشاء كل مخبر تحاليل طبية واستغلاله لترخيص من الوزير المكلف بالصحة . تحدد شروط وكيفيات إنشاء المخابر واستغلالها، وكذا أعمالها وأصناف المستخدمين المؤهلين للقيام بهذه الأعمال، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_255> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_255_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_255_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_255_20180702_OpEnact_24bb57254b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_255_obligation_0_13da0b0c> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 255" ;
    dzdoc:position 252 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_269> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_2> ;
    dzdoc:eId "art_269" ;
    dzdoc:fullText "تهدف الخريطة الصحية إلى ما يأتي : التنبو بالتطورات الضرورية من أجل تكييف عروض العلاج، التلبية القصوى لاحتياجات الصحة، تحديد تنظيم منظومة العلاج، تحديد شروط ربط مؤسسات الصحة بالشبكة، ضمان الحصول على العلاجات في كل نقطة من التراب الوطني وتحسينها."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_269> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_269_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_269_20180702_OpEnact_36a2505b1a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 269" ;
    dzdoc:position 266 ;
    dzdoc:usesTerm dzterm:health_map .

<https://legal.dz/resource/law/2018-07-02/18-11#art_272> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3> ;
    dzdoc:eId "art_272" ;
    dzdoc:fullText "يتم إنشاء مختلف هياكل ومؤسسات الصحة وكذا المؤسسات التي تساهم في الصحة وهيئات الدعم وفقا للاحتياجات الصحية للمواطنين وضرورات التنمية والمميزات الاجتماعية والاقتصادية لمختلف النواحي من التراب الوطني والمقاييس المحددة في إطار الخريطة الصحية ومخطط التنظيم الصحي. تحدد مهام مختلف هياكل ومؤسسات الصحة وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_272> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_272_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_272_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_272_20180702_OpEnact_4440e6bfd7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_272_obligation_0_20a79e44> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "272" ;
    dzdoc:position 269 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_28> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_3> ;
    dzdoc:eId "art_28" ;
    dzdoc:fullText "يحق لكل مريض وكذا لكل شخص مؤهل لتمثيله، إيداع طعن في حالة خرق حقوقه لدى لجنة الصلح والوساطة المنشأة على مستوى كل مصلحة خارجية حسب الكيفيات المحددة عن طريق التنظيم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_28_right_0_66b7c068> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_28> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_28_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_28_20180702_OpEnact_be2ed5ba53> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "28" ;
    dzdoc:position 27 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_280> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_280" ;
    dzdoc:fullText "تكون هياكل ومؤسسات الصحة في متناول جميع المواطنين . وتمارس مهامها ضمن احترام حقوق المرضى ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_280_right_0_429c0a2d> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_280> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_280_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_280_20180702_OpEnact_8300e04422> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_280_obligation_0_caf1db0f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 280" ;
    dzdoc:position 277 ;
    dzdoc:usesTerm dzterm:health_structures .

<https://legal.dz/resource/law/2018-07-02/18-11#art_289> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_289" ;
    dzdoc:fullText "يتعين على الهياكل والمؤسسات العمومية والخاصة للصحة و الصيدليات العمومية والخاصة ضمان خدمة المناوبة طبقا للكيفيات المحددة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_289> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_289_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_289_20180702_OpEnact_8a67bf04a8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_289_obligation_0_d9ea9d42> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "289" ;
    dzdoc:position 286 ;
    dzdoc:usesTerm dzterm:on_call_service,
        dzterm:public_private_health_structures,
        dzterm:public_private_pharmacies .

<https://legal.dz/resource/law/2018-07-02/18-11#art_290> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_290" ;
    dzdoc:fullText "يتعين على كل هيكل ومؤسسة تضمن خدمة عمومية صحية إعداد مشروع المؤسسة و مخطط مسعى الجودة اللذين يجب أن يندرجا ضمن الأهداف الوطنية أو الجهوية أو المحلية في مجال تنمية الصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_290> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_290_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_290_20180702_OpEnact_514cd474d3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_290_obligation_0_adb3f281> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "290" ;
    dzdoc:position 287 ;
    dzdoc:usesTerm dzterm:establishment_project,
        dzterm:quality_approach_plan .

<https://legal.dz/resource/law/2018-07-02/18-11#art_293> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_293" ;
    dzdoc:fullText "يتعين على الهياكل والمؤسسات العمومية والخاصة للصحة أيضا تبليغ المصالح الصحية المعنية بالمعلومات الضرورية بغرض التحقيقات الوبائية أو إعداد إحصائيات صحية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_293> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_293_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_293_20180702_OpEnact_0a79211d9e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_293_obligation_0_c60a19bc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "293" ;
    dzdoc:position 290 ;
    dzdoc:usesTerm dzterm:epidemiological_investigations,
        dzterm:health_statistics .

<https://legal.dz/resource/law/2018-07-02/18-11#art_296> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_2> ;
    dzdoc:eId "art_296" ;
    dzdoc:fullText "يتعين على الهياكل والمؤسسات العمومية والخاصة للصحة وكذا كل مهنيي الصحة الذين يمارسون بصفة حرة، اكتتاب تأمين يغطي مسؤوليتهم المدنية والمهنية تجاه مرضاهم وتجاه الغير ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_296> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_296_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_296_20180702_OpEnact_9e4edea0df> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_296_obligation_0_7409e822> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "296" ;
    dzdoc:position 293 ;
    dzdoc:usesTerm dzterm:health_professionals,
        dzterm:insurance .

<https://legal.dz/resource/law/2018-07-02/18-11#art_300> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_3> ;
    dzdoc:eId "art_300" ;
    dzdoc:fullText "تسجل سنويا الاعتمادات المالية الضرورية لتأدية مهام المؤسسة العمومية للصحة في ميزانية الدولة. تتأتى الموارد المالية للمؤسسة العمومية للصحة، على الخصوص مما يأتي : الإعانات المسجلة في ميزانية الدولة، مساهمات هيئات الضمان الاجتماعي طبقا للتشريع والتنظيم المعمول بهما، الإيرادات الناتجة عن كل النشاطات ذات الصلة بمهامها التي تقوم بها المؤسسة لفائدة الهيئات والهياكل العمومية والخاصة في إطار تعاقدي، الإيرادات الناتجة عن الخدمات العلاجية المقدمة للأشخاص الأجانب غير المتعاقدين في مجال الضمان الاجتماعي، تعويضات التأمينات الاقتصادية بعنوان الأضرار الجسدية، الهبات والوصايا، كل الإيرادات الأخرى المتعلقة بنشاطاتها الثانوية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_300> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_300_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_300_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_300_20180702_OpEnact_2d6a141674> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_300_obligation_0_57543bea> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 300" ;
    dzdoc:position 297 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_319> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_6> ;
    dzdoc:eId "art_319" ;
    dzdoc:fullText "يوضع نظام وطني للإعلام الصحي . يرتكز النظام الوطني للإعلام الصحي على كل تكنولوجيا حالية أو مستقبلية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_319> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_319_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_319_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_319_20180702_OpEnact_cd03323dec> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_319_obligation_0_fb274f48> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 319" ;
    dzdoc:position 316 ;
    dzdoc:usesTerm dzterm:national_health_information_system .

<https://legal.dz/resource/law/2018-07-02/18-11#art_337> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_4> ;
    dzdoc:eId "art_337" ;
    dzdoc:fullText "تسهر الدولة على التوازن المالي للقطاع العمومي للصحة ، قصد الاستجابة لحاجات المنظومة الوطنية للصحة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_337> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_337_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_337_20180702_OpEnact_cebaf658f8> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_337_obligation_0_47dc3683> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 337" ;
    dzdoc:position 334 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_347> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_347" ;
    dzdoc:fullText "تضطلع المجالس الوطنية والمجالس الجهوية للأدبيات الطبية، كل فيما يخصه، بالسلطة التأديبية والعقابية، وتبت في أي خرق لقواعد الأدبيات الطبية، وكذا في خروقات أحكام هذا القانون، في حدود اختصاصها. دون الإخلال بالمتابعات المدنية والجزائية، تعرض المخالفات للواجبات المحددة في هذا القانون وكذا قواعد الأدبيات الطبية، أصحابها لعقوبات تأديبية. تضبط كيفيات تنظيم وسير مختلف المجالس الوطنية والجهوية للأدبيات الطبية وكذا قواعد الأدبيات الطبية، في مدونات الأدبيات الطبية تحدد عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_347> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_347_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_347_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_347_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_347_20180702_OpEnact_358cb53168> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 347" ;
    dzdoc:position 344 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_348> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_348" ;
    dzdoc:fullText "يمكن أن تخطر مجالس الأدبيات الطبية المذكورة في المادة 346 الفقرة (2) أعلاه ، من الوزير المكلف بالصحة ، ورؤساء المؤسسات الصحية، والجمعيات ذات الطابع العلمي لمهنيي الصحة، ولا سيما منهم الأطباء وأطباء الأسنان والصيادلة، المؤسسة قانونا ومهنيي الصحة والمرتفقين والمرضى و أو ممثليهم الشرعيين."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_348_permission_0_14b9e33a> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_348> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_348_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_348_20180702_OpEnact_bdda772154> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 348" ;
    dzdoc:position 345 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_346> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_346> ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_349> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_349" ;
    dzdoc:fullText "تسهر المجالس الوطنية للأدبيات في مجال الصحة، على تنظيم الالتحاق بالمهن التابعة لها عن طريق مسك الجداول الخاصة بها. ويكون التسجيل في مجلس أخلاقيات المهنة إجباريا . ولا يخضع لإجبارية التسجيل في الجداول المذكورة أعلاه،مهنيو الصحة ذوو الجنسية الأجنبية الذين يمارسون في إطار اتفاقات واتفاقيات تعاون."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_349> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_349_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_349_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_349_20180702_OpEnact_da15d4379b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_349_obligation_0_fc4f9898> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 349" ;
    dzdoc:position 346 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_379> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_379" ;
    dzdoc:fullText "يجب إجراء الدراسات العيادية بالتطابق مع قواعد الممارسات الحسنة في هذا المجال في الهياكل المعتمدة والمرخص لها لهذا الغرض حسب الكيفيات المحددة من طرف الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_379> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_379_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_379_20180702_OpEnact_b1a5bc9e2c> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_379_obligation_0_af2b4fe4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "379" ;
    dzdoc:position 376 ;
    dzdoc:usesTerm dzterm:clinical_studies,
        dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_392> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_392" ;
    dzdoc:fullText "في حالة دراسة عيادية دون منفعة فردية مباشرة، يمكن المرقي أن يدفع للأشخاص المستعدين للخضوع لها تعويضا عن الصعوبات التي يتحملونها حسب شروط وكيفيات يحددها الوزير المكلف بالصحة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_392_permission_0_d5e01b3b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_392> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_392_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_392_20180702_OpEnact_d1fccf0292> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 392" ;
    dzdoc:position 389 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_394> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_394" ;
    dzdoc:fullText "يجب أن يصرح المرقي ل لوزير المكلف بالصحة بالأشخاص المستعدين للخضوع للدراسات العيادية دون منفعة فردية مباشرة، قبل تسجيلهم في السجل الوطني المخصص لهذا الغرض ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_394> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_394_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_394_20180702_OpEnact_48e2cab2c7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_394_obligation_0_818b91a3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 394" ;
    dzdoc:position 391 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:promoter .

<https://legal.dz/resource/law/2018-07-02/18-11#art_396> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_396" ;
    dzdoc:fullText "يجب أن يصرح الطبيب الباحث بكل حدث خطير من شأنه أن يحصل جراء بحث حول منتوج صيدلاني ل الوزير المكلف بالصحة ول لمرقي و لجنة الأخلاقيات الطبية للدراسات العيادية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_396> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_396_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_396_20180702_OpEnact_8c045b6d8f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_396_obligation_0_60ea5147> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 396" ;
    dzdoc:position 393 ;
    dzdoc:usesTerm dzterm:ethics_committee,
        dzterm:minister_health,
        dzterm:promoter,
        dzterm:researcher_doctor .

<https://legal.dz/resource/law/2018-07-02/18-11#art_398> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_398" ;
    dzdoc:fullText "لا يترتب على الدراسات العيادية باستثناء ما كان منها بدون منفعة فردية مباشرة أي مقابل مالي مباشر أو غير مباشر للأشخاص الخاضعين لها ما عدا تعويض المصاريف التي دفعها هؤلاء الأشخاص ."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_398_right_0_6d4c1d74> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_398> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_398_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_398_20180702_OpEnact_becc560f4a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 398" ;
    dzdoc:position 395 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_398_condition_0_4b815e6a> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_401> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_401" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المواد 52 و 53 و 55 من هذا القانون، المتعلقة بالإنذار العام و/أو الخاص الواجب وضعه على وسم مواد التبغ والبيانات المتعلقة بالمكونات السامة، بالحبس من ستة (6) أشهر إلى سنة (1) وبغرامة من 500.000 دج إلى 1.000.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_401> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_401_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_401_20180702_OpEnact_36a13ac403> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_401_obligation_0_69a77b8a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 401" ;
    dzdoc:position 398 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_52>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_53>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_55> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_52>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_53>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_55> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_405> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_405" ;
    dzdoc:fullText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 57 من هذا القانون، المتعلقة ببيع التبغ للقصر ، بغرامة من 200.000 دج إلى 400.000 دج . وفي حالة العود، تضاعف العقوبة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_405> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_405_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_405_20180702_OpEnact_259a48ea58> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_405_obligation_0_3c73c5d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 405" ;
    dzdoc:position 402 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_57> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_57> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_405_condition_0_496e33b9> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_41> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_1> ;
    dzdoc:eId "art_41" ;
    dzdoc:fullText "في حالة وجود خطر انتشار وباء و/أو في حالة حماية الأشخاص المعرضين لخطر ، تنظم السلطات الصحية حملات تلقيح وتتخذ كل تدبير ملائم لفائدة المواطنين أو الأشخاص المعنيين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_41> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_41_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_41_20180702_OpEnact_3578b8546e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_41_obligation_0_efb44dd8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "41" ;
    dzdoc:position 40 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_41_condition_0_0dbd2662> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_420> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_420" ;
    dzdoc:fullText "يعاقب كل مهني الصحة الذي يخالف أحكام المادتين 198 و 199 من هذا القانون، المتعلقة، على التوالي، ب إعلام المصالح المعنية و تحرير الشهادة الوصفية لحالات العنف ، بغرامة من 20.000 دج إلى 40.000 دج."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_420> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_420_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_420_20180702_OpEnact_7d67a21cbe> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_420_obligation_0_0382b21e>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_420_obligation_1_1bb7835e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 420" ;
    dzdoc:position 417 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_198>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_199> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_198>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_199> ;
    dzdoc:usesTerm dzterm:health_professional .

<https://legal.dz/resource/law/2018-07-02/18-11#art_434> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_434" ;
    dzdoc:fullText "يعاقب كل من يخالف أحكام المادة 371 من هذا القانون المتعلقة ب المساعدة الطبية على الإنجاب ، بالحبس من خمس (5) سنوات إلى عشر (10) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_434> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_434_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_434_20180702_OpEnact_1b2eb7fd16> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_434_obligation_0_a8a25046> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 434" ;
    dzdoc:position 431 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_371> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_371> ;
    dzdoc:usesTerm dzterm:assisted_reproduction .

<https://legal.dz/resource/law/2018-07-02/18-11#art_439> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_8> ;
    dzdoc:eId "art_439" ;
    dzdoc:fullText "يعاقب الطبيب الباحث الذي شرع في الدراسة العيادية دون الحصول على موافقة الشخص المدرج في بروتوكول البحث، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 100.000 دج إلى 500.000 دج ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_439> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_439_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_439_20180702_OpEnact_e183105a35> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_439_obligation_0_92eb72d9> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 439" ;
    dzdoc:position 436 ;
    dzdoc:usesTerm dzterm:doctor_researcher .

<https://legal.dz/resource/law/2018-07-02/18-11#art_444> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_444" ;
    dzdoc:fullText "يجب أن تحتفظ الهياكل والمؤسسات العمومية والخاصة للصحة بالملفات الطبية للمرضى المفتوحة قبل تأسيس الملف الطبي الوحيد ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_444> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_444_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_444_20180702_OpEnact_1f30b4ad8a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_444_obligation_0_679e0358> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 444" ;
    dzdoc:position 441 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_45> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_45" ;
    dzdoc:fullText "تضع الدولة مخططات وطنية مندمجة متعددة القطاعات لمكافحة عوامل خطر الأمراض غير المنتقلة والكشف عن هذه الأمراض والتكفل بها . يحدد الوزير المكلف بالصحة قائمة الأمراض غير المنتقلة التي تتطلب كشفا مجانيا."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_45> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_45_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_45_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_45_20180702_OpEnact_ffbb6fa6d4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_45_obligation_0_60dccd94> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 45" ;
    dzdoc:position 44 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:non_communicable_diseases .

<https://legal.dz/resource/law/2018-07-02/18-11#art_450> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_450" ;
    dzdoc:fullText "ينشر هذا القانون في الجريدة الرسمية للجمهورية الجزائرية الديمقراطية الشعبية. حرر بالجزائر في 18 شوال عام 1439 الموافق 2 يوليو سنة 2018. عبد العزيز بوتفليقة"@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_450> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_450_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_450_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_450_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_450_20180702_OpEnact_a5d2ab0597> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 450" ;
    dzdoc:position 447 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_48> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_3> ;
    dzdoc:eId "art_48" ;
    dzdoc:fullText "تنشأ لدى الوزير المكلف بالصحة لجنة وطنية متعددة القطاعات للوقاية من الأمراض غير المنتقلة ومكافحتها . تحدد مهام اللجنة وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_48> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_48_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_48_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_48_20180702_OpEnact_66d22a6bb5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_48_obligation_0_8ee71d91> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 48" ;
    dzdoc:position 47 ;
    dzdoc:usesTerm dzterm:minister_health,
        dzterm:non_communicable_diseases .

<https://legal.dz/resource/law/2018-07-02/18-11#art_50> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_50" ;
    dzdoc:fullText "تقوم مصالح الصحة ، بالتعاون مع القطاعات المعنية، بإعداد ووضع برامج الوقاية من الإدمان على التبغ ومكافحته ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_50> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_50_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_50_20180702_OpEnact_404324ff6e> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_50_obligation_0_cc01b4ae> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "50" ;
    dzdoc:position 49 ;
    dzdoc:usesTerm dzterm:health_services .

<https://legal.dz/resource/law/2018-07-02/18-11#art_58> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_1> ;
    dzdoc:eId "art_58" ;
    dzdoc:fullText "تضمن الهياكل الصحية، في مكافحة الإدمان على التبغ التحسيس والمساعدة على الإقلاع والمعالجة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_58> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_58_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_58_20180702_OpEnact_c1b9c67bb7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_58_obligation_0_523651a4> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "58" ;
    dzdoc:position 57 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_62> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_2> ;
    dzdoc:eId "art_62" ;
    dzdoc:fullText "تطور الدولة المصالح المناسبة للوقاية من السلوكات الإدمانية ومكافحة المخدرات والإدمان، وفقا للتشريع والتنظيم المعمول بهما. تحدد قائمة المواد الإدمانية والمحظورة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_62> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_62_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_62_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_62_20180702_OpEnact_ad5577eb32> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_62_obligation_0_0431b526> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 62" ;
    dzdoc:position 61 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_63> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_2> ;
    dzdoc:eId "art_63" ;
    dzdoc:fullText "تضع الدولة هياكل إزالة التسمم وإعادة التأهيل وإعادة الإدماج الاجتماعي، وتشجع على إنشائها وفقا للتشريع والتنظيم المعمول بهما."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_63> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_63_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_63_20180702_OpEnact_cddfefccdf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_63_obligation_0_a54df4fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 63" ;
    dzdoc:position 62 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_64> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_3> ;
    dzdoc:eId "art_64" ;
    dzdoc:fullText "تتولى الدولة ترقية أنماط استهلاك تشجع على تغذية صحية ومتوازنة لدى المواطنين ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_64> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_64_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_64_20180702_OpEnact_9f877f0cd6> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_64_obligation_0_2448716f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "64" ;
    dzdoc:position 63 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_65> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_3> ;
    dzdoc:eId "art_65" ;
    dzdoc:fullText "تسهر الدولة على وضع واحترام مقاييس في مجال التغذية ، عبر برامج التربية والإعلام والتحسيس والاتصال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_65> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_65_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_65_20180702_OpEnact_759b942ea9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_65_obligation_0_ddf9d38b> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "65" ;
    dzdoc:position 64 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_66> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2_subsec_4_subsubsec_3> ;
    dzdoc:eId "art_66" ;
    dzdoc:fullText "تتخذ الدولة، على كل المستويات، التدابير الضرورية التي تسمح بالوقاية من السمنة لدى المواطنين ، ولا سيما لدى الأطفال."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_66> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_66_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_66_20180702_OpEnact_a12cc760a3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_66_obligation_0_fa5d9e2f> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "66" ;
    dzdoc:position 65 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_7> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_1> ;
    dzdoc:eId "art_7" ;
    dzdoc:fullText "يضمن التخطيط الصحي ، في إطار التنمية الاقتصادية والاجتماعية والمخطط الوطني لتهيئة الإقليم، التوزيع المتناسق والعادل والعقلاني للموارد البشرية والمادية على أساس الاحتياجات الصحية بالنظر إلى التطور الديموغرافي والأنماط الوبائية. ويرتكز التخطيط الصحي على الخريطة الصحية و مخطط التنظيم الصحي المنصوص عليهما في المادتين 269 و 271 أدناه."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_7> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_7_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_7_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_7_20180702_OpEnact_ea78a9991a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_7_obligation_0_e923e428> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 7" ;
    dzdoc:position 6 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_269>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_271> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_269>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_271> ;
    dzdoc:usesTerm dzterm:health_map,
        dzterm:health_organization_plan .

<https://legal.dz/resource/law/2018-07-02/18-11#art_77> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:therapeutic_abortion ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_77" ;
    dzdoc:fullText "يهدف الإيقاف العلاجي للحمل إلى حماية صحة الأم عندما تكون حياتها أو توازنها النفسي والعقلي مهددين بخطر بسبب الحمل . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_77> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_77_defocc_4b69fd8cb509> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_77_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_77_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_77_20180702_OpEnact_89b4f34f67> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
