<https://legal.dz/resource/law/2018-07-02/18-11#version_art_73> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على مهنيي الصحة التصريح بالمرأة الحامل ، ويتم تسجيلها ابتداء من الثلاثي الثالث من الحمل، حسب اختيارها لدى عيادة ولادة عمومية أو خاصة. وتوفر الدولة الوسائل الملائمة لضمان المتابعة الدورية والإجبارية للحمل . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
