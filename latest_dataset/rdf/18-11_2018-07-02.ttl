<https://legal.dz/resource/law/2018-07-02/18-11#version_art_22> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يستفيد كل مريض، في إطار تسلسل العلاج، من خدمات المصالح المتخصصة للصحة بعد استشارة وتوجيه من الطبيب المرجعي ، باستثناء حالات الاستعجال والحالات الطبية ذات الحصول المباشر على العلاج التي يحددها الوزير المكلف بالصحة . الطبيب المرجعي هو الطبيب العام المعالج للمريض على مستوى الهيكل الصحي الجواري العمومي أو الخاص الأقرب من موطنه . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_22_20180702_OpEnact_087dcd7380> ;
    dzdoc:replacementText "يستفيد كل مريض، في إطار تسلسل العلاج، من خدمات المصالح المتخصصة للصحة بعد استشارة وتوجيه من الطبيب المرجعي ، باستثناء حالات الاستعجال والحالات الطبية ذات الحصول المباشر على العلاج التي يحددها الوزير المكلف بالصحة . الطبيب المرجعي هو الطبيب العام المعالج للمريض على مستوى الهيكل الصحي الجواري العمومي أو الخاص الأقرب من موطنه . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
