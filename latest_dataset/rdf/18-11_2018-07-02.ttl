<https://legal.dz/resource/law/2018-07-02/18-11#version_art_125> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يشمل التكفل بالمرضى المصابين باضطرابات عقلية أو نفسية ، أعمال الوقاية و التشخيص و العلاجات و إعادة التأهيل و إعادة الإدماج الاجتماعي . وتندرج مجمل هذه الأعمال ضمن المخطط العام لتنظيم المنظومة الصحية ، مع الأخذ في الحسبان، خصوصيات هذا المرض."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_125_20180702_OpEnact_117a3592b1> ;
    dzdoc:replacementText "يشمل التكفل بالمرضى المصابين باضطرابات عقلية أو نفسية ، أعمال الوقاية و التشخيص و العلاجات و إعادة التأهيل و إعادة الإدماج الاجتماعي . وتندرج مجمل هذه الأعمال ضمن المخطط العام لتنظيم المنظومة الصحية ، مع الأخذ في الحسبان، خصوصيات هذا المرض."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_125> ;
