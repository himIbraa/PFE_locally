    dzdoc:evidenceText "للمرضى المصابين باضطرابات عقلية، الذين تم استشفاؤهم أو أوليائهم أو ممثليهم الشرعيين، لا سيما الحق في : إعلامهم بحقوقهم ، إخطار اللجنة الولائية للصحة العقلية ، تلقي زيارات بعد موافقة الطبيب المعالج في المؤسسة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_131_20180702_OpEnact_c674560f10> ;
    dzdoc:replacementText "للمرضى المصابين باضطرابات عقلية، الذين تم استشفاؤهم أو أوليائهم أو ممثليهم الشرعيين، لا سيما الحق في : إعلامهم بحقوقهم ، إخطار اللجنة الولائية للصحة العقلية ، تلقي زيارات بعد موافقة الطبيب المعالج في المؤسسة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
