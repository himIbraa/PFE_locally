dzterm:health_professional a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مهني الصحة"@ar,
        "مهنيي الصحة"@ar,
        "يقصد بمهني الصحة في مفهوم هذا القانون، كل شخص ممارس وتابع لهيكل أو مؤسسة للصحة يقدم في نشاطه المهني خدمة صحية أو يساعد فيها أو يساهم في إنجازها."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_165_defocc_d99d7b00d2a8> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_140> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_2_subsubsec_1> ;
    dzdoc:eId "art_140" ;
    dzdoc:fullText "يمكن أن يقرر طبيب الأمراض العقلية للمؤسسة ، عند انقضاء أجل خمسة عشر (15) يوما : إما خروج المريض ، وإما تمديد فترة الوضع في الملاحظة لمدة أقصاها خمسة عشر (15) يوما. غير أن طبيب الأمراض العقلية للمؤسسة يمكنه أن يقرر خروج المريض قبل انقضاء أجل خمسة عشر (15) يوما إذا قدر أن حالة المريض تسمح بذلك ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_140_permission_0_86f0fb18> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_140> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_140_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_140_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_140_20180702_OpEnact_7580056746> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 140" ;
    dzdoc:position 138 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_140_condition_0_a181240a>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_140_condition_1_bcd1ed07> ;
    dzdoc:usesTerm dzterm:patient,
        dzterm:psychiatrist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_147> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_1> ;
    dzdoc:eId "art_147" ;
    dzdoc:fullText "يمكن طبيب الأمراض العقلية أن يحول الفحص الإجباري في طب الأمراض العقلية إلى الوضع في الملاحظة الإجبارية، عندما تقتضي ذلك حالة المريض ، و يجب أن يعلم بذلك السلطة المعنية المذكورة في المادة 145 أعلاه ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_147_permission_0_ea4f22a9> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_147> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_147_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_147_20180702_OpEnact_7b669f6ed9> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_147_obligation_0_307b0b79> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "147" ;
    dzdoc:position 145 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_145> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_145> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_147_condition_0_d09d35dd> ;
    dzdoc:usesTerm dzterm:compulsory_psychiatric_examination .

<https://legal.dz/resource/law/2018-07-02/18-11#art_164> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_3> ;
    dzdoc:eId "art_164" ;
    dzdoc:fullText "يجب أن يخبر مدير المؤسسة السلطات المعنية بكل خروج غير قانوني أو كل حادث استثنائي بخصوص مريض خاضع للملاحظة الإجبارية أو الاستشفاء الإجباري . تطبق أحكام الفقرة أعلاه على المرضى المصابين باضطرابات عقلية الخاضعين للأشكال الأخرى من الوضع في الملاحظة أو الذين تم استشفاؤهم ضمن الشروط المنصوص عليها في القوانين المعمول بها ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_164> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_164_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_164_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_164_20180702_OpEnact_e15c619cd0> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_164_obligation_0_05b4de74> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 164" ;
    dzdoc:position 162 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_164_condition_0_f16e9734> ;
    dzdoc:usesTerm dzterm:compulsory_hospitalization .

<https://legal.dz/resource/law/2018-07-02/18-11#art_188> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_3> ;
    dzdoc:eId "art_188" ;
    dzdoc:fullText "يمنع على كل مهني الصحة الذي منع من الممارسة، من تقديم فحوص أو تحرير وصفات أو تحضير أو تقديم أدوية لتطبيق علاج أو استعمال أي أسلوب علاجي تابع للطب أو طب الأسنان أو الصيدلة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_188> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_188_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_188_20180702_OpEnact_e0e6460a24> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_188_obligation_0_c959ee8c> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_188_prohibition_0_b30df830> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "188" ;
    dzdoc:position 185 ;
    dzdoc:usesTerm dzterm:health_professional .

<https://legal.dz/resource/law/2018-07-02/18-11#art_193> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_4> ;
    dzdoc:eId "art_193" ;
    dzdoc:fullText "يمكن الممارسين المفتشين عند ممارسة مهامهم، وبموافقة من السلطة التابعين لها، الاستعانة بخبرة مهنيي الصحة ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_193_permission_0_e8343cdc> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_193_right_0_9264cf05> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_193> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_193_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_193_20180702_OpEnact_234a975fe3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 193" ;
    dzdoc:position 190 ;
    dzdoc:usesTerm dzterm:practitioner_inspectors .

<https://legal.dz/resource/law/2018-07-02/18-11#art_198> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_6> ;
    dzdoc:eId "art_198" ;
    dzdoc:fullText "يتعين على مهنيي الصحة ، خلال ممارسة مهامهم، إعلام المصالح المعنية بحالات العنف التي اطلعوا عليها والتي تعرض لها، لا سيما النساء والأطفال والمراهقون القصر والأشخاص المسنون، وعديمو الأهلية والأشخاص مسلوبو الحرية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_198> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_198_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_198_20180702_OpEnact_f338478826> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_198_obligation_0_ec096178> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "198" ;
    dzdoc:position 195 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_208> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:medicine ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_2> ;
    dzdoc:eId "art_208" ;
    dzdoc:fullText "الدواء ، في مفهوم هذا القانون ، هو كل مادة أو تركيب يعرض على أنه يحتوي على خاصيات علاجية أو وقائية من الأمراض البشرية أو الحيوانية وكل المواد التي يمكن وصفها للإنسان أو للحيوان قصد القيام بتشخيص طبي أو استعادة وظائفه الفيزيولوجية أو تصحيحها وتعديلها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_208_permission_0_e0f93bcc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_208> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_208_defocc_38a1e719a7a3> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_208_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_208_20180702_OpEnact_960840df89> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "208" ;
    dzdoc:position 205 ;
    dzdoc:usesTerm dzterm:medicine .

<https://legal.dz/resource/law/2018-07-02/18-11#art_214> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:national_nomenclatures ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_2> ;
    dzdoc:eId "art_214" ;
    dzdoc:fullText "المدونات الوطنية للمواد الصيدلانية والمستلزمات الطبية المستعملة في الطب البشري هي المصنفات التي تضم كل المواد المسجلة أو المصادق عليها والتي يتم تحيينها بصفة منتظمة. مدونات المواد الصيدلانية ذات الاستعمال الاستشفائي و/أو الصيدلاني منبثقة من المدونة الوطنية للمواد الصيدلانية المنصوص عليها في الفقرة أعلاه . تحدد كيفيات إعداد هذه المدونات الوطنية وتحيينها، عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_214> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_214_defocc_256861b43a08> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_214_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_214_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_214_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_214_20180702_OpEnact_1d79cdb0e7> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_214_obligation_0_491c0a32> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 214" ;
    dzdoc:position 211 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_214> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_214> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_22> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:physician ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_1_sec_3> ;
    dzdoc:eId "art_22" ;
    dzdoc:fullText "يستفيد كل مريض، في إطار تسلسل العلاج، من خدمات المصالح المتخصصة للصحة بعد استشارة وتوجيه من الطبيب المرجعي ، باستثناء حالات الاستعجال والحالات الطبية ذات الحصول المباشر على العلاج التي يحددها الوزير المكلف بالصحة . الطبيب المرجعي هو الطبيب العام المعالج للمريض على مستوى الهيكل الصحي الجواري العمومي أو الخاص الأقرب من موطنه . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_22_right_0_406497bb> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_22> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_22_defocc_713c82f28b19> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_22_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_22_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_22_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_22_20180702_OpEnact_087dcd7380> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "22" ;
    dzdoc:position 21 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_22_condition_0_d05a4916> ;
    dzdoc:usesTerm dzterm:minister,
        dzterm:physician .

<https://legal.dz/resource/law/2018-07-02/18-11#art_232> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_5> ;
    dzdoc:eId "art_232" ;
    dzdoc:fullText "لا يجوز للممارسين الطبيين أن يصفوا أو يستعملوا إلا الأدوية المسجلة والمواد الصيدلانية والمستلزمات الطبية المصادق عليها المستعملة في الطب البشري والواردة في المدونات الوطنية الخاصة بها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_232_permission_0_c58c1888> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_232> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_232_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_232_20180702_OpEnact_930b48d0b4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_232_obligation_0_c58c1888> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_232_prohibition_0_c58c1888> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "232" ;
    dzdoc:position 229 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_245> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_8> ;
    dzdoc:eId "art_245" ;
    dzdoc:fullText "يخضع لمراقبة إدارية وتقنية وأمنية خاصة : إنتاج المواد والأدوية ذات الخصائص المخدرة و/أو المؤثرة عقليا، وصنعها وتوضيبها وتحويلها واستيرادها وتصديرها وعرضها وتوزيعها والتنازل عنها وتسليمها و اقتناؤها وحيازتها، استعمال النباتات أو أجزاء النباتات ذات الخصائص المخدرة و/أو المؤثرة عقليا. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_245> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_245_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_245_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_245_20180702_OpEnact_b419c09754> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_245_obligation_0_3efae0d6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 245" ;
    dzdoc:position 242 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_245> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_245> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_273> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3> ;
    dzdoc:eId "art_273" ;
    dzdoc:fullText "يخضع إنجاز وإنشاء وفتح واستغلال أي هيكل أو مؤسسة صحية أو ذات طابع صحي، وتوسيعها وتحويلها وتغيير تخصيصها وغلقها المؤقت أو النهائي، لترخيص من الوزير المكلف بالصحة ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_273> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_273_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_273_20180702_OpEnact_dd7ccf8333> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_273_obligation_0_80870c41> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "273" ;
    dzdoc:position 270 ;
    dzdoc:usesTerm dzterm:minister .

<https://legal.dz/resource/law/2018-07-02/18-11#art_341> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_1> ;
    dzdoc:eId "art_341" ;
    dzdoc:fullText "يمنع كل من لا يمارس مهنة الصحة بصفة قانونية أن يتلقى أتعابا أو جزءا منها أو فوائد مصدرها النشاط المهني من مهني الصحة الممارس بصفة حرة."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_341> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_341_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_341_20180702_OpEnact_964785f649> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_341_obligation_0_6ae3d0ca> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_341_prohibition_0_6ae3d0ca> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "341" ;
    dzdoc:position 338 ;
    dzdoc:usesTerm dzterm:health_professionals .

<https://legal.dz/resource/law/2018-07-02/18-11#art_365> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_365" ;
    dzdoc:fullText "يجب أن تمنح الأعضاء والأنسجة التي تم نزعها، فقط للمرضى المسجلين في قائمة الانتظار الوطنية التي تمسكها الوكالة الوطنية لزرع الأعضاء . يجب أن تحدد وتقيم بصفة منتظمة، قواعد منح الأعضاء والأنسجة المتأتية من المتبرعين المتوفين ضمن احترام مبدأ الإنصاف . تحدد هذه القواعد عن طريق التنظيم، بناء على اقتراح من الوكالة الوطنية لزرع الأعضاء ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_365> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_365_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_365_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_365_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_365_20180702_OpEnact_6a9707c64f> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_365_obligation_0_13433c2c>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_365_obligation_1_a97361e5> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "365" ;
    dzdoc:position 362 ;
    dzdoc:usesTerm dzterm:national_organ_transplant_agency .

<https://legal.dz/resource/law/2018-07-02/18-11#art_373> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_3> ;
    dzdoc:eId "art_373" ;
    dzdoc:fullText "يجب أن يتم تنفيذ المساعدة الطبية على نجاب مع مراعاة قواعد الممارسات الحسنة والأمن الصحي في هذا المجال المحددة عن طريق التنظيم. تخضع المؤسسات التي تمارس المساعدة الطبية على الإنجاب لمراقبة المصالح الصحية المختصة، ويتعين عليها إرسال تقرير سنوي عن نشاطاتها إلى السلطة الصحية المعنية."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_373> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_373_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_373_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_373_20180702_OpEnact_7f87cf1120> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_373_obligation_0_377dbb74>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_373_obligation_1_f1161336> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "373" ;
    dzdoc:position 370 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_73> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_1> ;
    dzdoc:eId "art_73" ;
    dzdoc:fullText "يجب على مهنيي الصحة التصريح بالمرأة الحامل ، ويتم تسجيلها ابتداء من الثلاثي الثالث من الحمل، حسب اختيارها لدى عيادة ولادة عمومية أو خاصة. وتوفر الدولة الوسائل الملائمة لضمان المتابعة الدورية والإجبارية للحمل . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_73> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_73_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_73_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_73_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_73_20180702_OpEnact_b1875ac52b> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_73_obligation_0_21698c80>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_73_obligation_1_50d909b8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 73" ;
    dzdoc:position 72 .

