    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_432> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يقوم بالإشهار للتبرع بالأعضاء أو الأنسجة أو الخلايا البشرية لفائدة شخص أو مؤسسة، بالحبس من ستة (6) أشهر إلى سنة (1) وبغرامة من 200.000 دج إلى 400.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_433_20180702_OpEnact_bf8a82999c> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_433> ;
