    dznorm:sourceArticle "art_171" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_0_919627f4_action_0aff5e6b3a> a dznorm:Action ;
    rdfs:label "تعويض مهني الصحة الذي يمارس"@ar ;
    dzdoc:confidenceScore 0.62 ;
    dzdoc:extractionMethod "lexical_action_pattern" ;
    dzdoc:sourceTextSpan "يمكن تعويض مهني الصحة الذي يمارس بصفة حرة، وفق الشروط المنصوص عليها في أحكام المادة 166 أعلاه، بسبب لا سيما التكوين أو العطلة."@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_171> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_1_4eb93694> a dznorm:Permission ;
    dzdoc:confidenceScore 0.72 ;
    dzdoc:extractionMethod "lexical_permission_cue" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_1_4eb93694_action_bcd864edda>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_1_4eb93694_action_f49e2abdfa> ;
    dzdoc:hasPeriod <https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_1_4eb93694_period_c434e42ed8>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_171_permission_1_4eb93694_period_e52e39498c> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_171> ;
    dznorm:position 1 ;
    dznorm:provisionText "ويمكن أيضا، تعويضه لسبب صحي، لمدة أقصاها سنة واحدة قابلة للتجديد مرة واحدة. كما يمكن استخلافه من أجل ضمان استمرارية الخدمة العمومية، عندما يكون في عهدة دائمة في مؤسسة وطنية أو في جماعة إقليمية خلال مدة العهدة. وفي هذه الحالة، يمارس مهني الصحة المستخلف مهنته تحت هويته القانونية، ويبقى مسؤولا عن نشاطاته. تنتهي مدة الاستخلاف بانتهاء العهدة (العهدات) المنصوص عليها في الفقرة أعلاه."@ar ;
    dznorm:sourceArticle "art_171" .

