<https://legal.dz/resource/law/2018-07-02/18-11#version_art_268> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تهدف شبكات العلاج إلى تحقيق تكفل أفضل بالمريض واستمرارية العلاج وكذا تقديم علاج جواري ذي جودة من أجل ضمان تسهيل الحصول على العلاج والعدالة في مجال الصحة . يمكن شبكات العلاج إشراك هياكل ومؤسسات الصحة العمومية والخاصة ومهنيي الصحة الآخرين وهيئات ذات طابع صحي أو اجتماعي ضمن الشروط المنصوص عليها في المادة 316 أدناه . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_268_20180702_OpEnact_bfab7c5ff8> ;
    dzdoc:replacementText "تهدف شبكات العلاج إلى تحقيق تكفل أفضل بالمريض واستمرارية العلاج وكذا تقديم علاج جواري ذي جودة من أجل ضمان تسهيل الحصول على العلاج والعدالة في مجال الصحة . يمكن شبكات العلاج إشراك هياكل ومؤسسات الصحة العمومية والخاصة ومهنيي الصحة الآخرين وهيئات ذات طابع صحي أو اجتماعي ضمن الشروط المنصوص عليها في المادة 316 أدناه . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_268> ;
