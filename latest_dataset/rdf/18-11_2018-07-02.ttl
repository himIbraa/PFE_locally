<https://legal.dz/resource/law/2018-07-02/18-11#version_art_352> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن أي شخص يمارس مهنة الصحة أن يقدم إلا العلاجات التي تحصل فيها على التكوين والخبرة الضروريين . ويجب عليه أن يمتنع عن كل عمل زائد أو غير ملائم حتى ولو كان بطلب من المريض أو من مهني في الصحة ."@ar ;
