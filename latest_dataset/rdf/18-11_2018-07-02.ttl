<https://legal.dz/resource/law/2018-07-02/18-11#version_art_198> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتعين على مهنيي الصحة ، خلال ممارسة مهامهم، إعلام المصالح المعنية بحالات العنف التي اطلعوا عليها والتي تعرض لها، لا سيما النساء والأطفال والمراهقون القصر والأشخاص المسنون، وعديمو الأهلية والأشخاص مسلوبو الحرية ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_198_20180702_OpEnact_f338478826> ;
