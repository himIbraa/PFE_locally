    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_304> ;
    dznorm:position 0 ;
    dznorm:provisionText "يتولى تدقيق حسابات المؤسسة العمومية للصحة والتصديق عليها محافظ حسابات يعينه الوزير المكلف بالمالية بالاشتراك مع الوزير المكلف بالصحة"@ar ;
    dznorm:sourceArticle "art_304" .

