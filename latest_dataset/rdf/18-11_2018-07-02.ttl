    dzdoc:text "تكون الدراسات العيادية موضوع بروتوكول يحرره ويوفره المرقي ويوقعه الطبيب الباحث، بعد إبداء موافقته بالتعبير عن قبوله للبروتوكول والتزامه باحترام شروط الإنجاز."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_385_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_385> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_386_condition_0_9100bb53> a dznorm:Condition ;
    dzdoc:hasAction <https://legal.dz/resource/law/2018-07-02/18-11#art_386_condition_0_9100bb53_action_45261f11c2> ;
    dznorm:conditionText "لا يمكن إجراء الدراسات العيادية إلا إذا عبر الأشخاص المستعدون للخضوع للدراسة العيادية، أو عند تعذر ذلك، ممثلوهم الشرعيون عن موافقتهم الحرة والصريحة والمستنيرة، كتابيا"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_386> ;
    dznorm:position 0 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_386_condition_0_9100bb53_action_45261f11c2> a dznorm:Action ;
