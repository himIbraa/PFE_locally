    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_166> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_166_condition_0_a6b99185>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_166_condition_1_655da6ea>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_166_condition_2_e8533214>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_166_condition_3_a9a0ad0f>,
