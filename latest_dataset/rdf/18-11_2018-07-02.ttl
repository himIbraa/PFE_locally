<https://legal.dz/resource/law/2018-07-02/18-11#version_art_98> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تهدف الصحة في وسط العمل ، لا سيما إلى ما يأتي : ترقية الراحة البدنية والعقلية والاجتماعية للعمال في كل المهن والحفاظ على أعلى درجة لها، الوقاية من كل ضرر يلحق بصحة العمال جراء ظروف عملهم، حماية العمال في شغلهم من الأخطار الناتجة عن وجود عوامل مضرة بصحتهم، وقاية العمال وحمايتهم من حوادث العمل والأمراض المهنية، تنصيب العمال في منصب عمل ملائم لقدراتهم الفيزيولوجية والنفسية وإبقاؤهم فيه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_98_20180702_OpEnact_1bb1b2e67c> ;
    dzdoc:replacementText "تهدف الصحة في وسط العمل ، لا سيما إلى ما يأتي : ترقية الراحة البدنية والعقلية والاجتماعية للعمال في كل المهن والحفاظ على أعلى درجة لها، الوقاية من كل ضرر يلحق بصحة العمال جراء ظروف عملهم، حماية العمال في شغلهم من الأخطار الناتجة عن وجود عوامل مضرة بصحتهم، وقاية العمال وحمايتهم من حوادث العمل والأمراض المهنية، تنصيب العمال في منصب عمل ملائم لقدراتهم الفيزيولوجية والنفسية وإبقاؤهم فيه."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_98> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
