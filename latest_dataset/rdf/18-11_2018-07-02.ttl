<https://legal.dz/resource/law/2018-07-02/18-11#version_art_208> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الدواء ، في مفهوم هذا القانون ، هو كل مادة أو تركيب يعرض على أنه يحتوي على خاصيات علاجية أو وقائية من الأمراض البشرية أو الحيوانية وكل المواد التي يمكن وصفها للإنسان أو للحيوان قصد القيام بتشخيص طبي أو استعادة وظائفه الفيزيولوجية أو تصحيحها وتعديلها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_208_20180702_OpEnact_960840df89> ;
    dzdoc:replacementText "الدواء ، في مفهوم هذا القانون ، هو كل مادة أو تركيب يعرض على أنه يحتوي على خاصيات علاجية أو وقائية من الأمراض البشرية أو الحيوانية وكل المواد التي يمكن وصفها للإنسان أو للحيوان قصد القيام بتشخيص طبي أو استعادة وظائفه الفيزيولوجية أو تصحيحها وتعديلها."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_208> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:targetArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_208> ;
