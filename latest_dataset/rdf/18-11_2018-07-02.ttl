<https://legal.dz/resource/law/2018-07-02/18-11#version_art_233> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن الوزير المكلف بالصحة ، وبعد رأي الوكالة الوطنية للمواد الصيدلانية ، أن يسلم ترخيصا مؤقتا لاستعمال أدوية غير مسجلة عندما توصف هذه الأدوية في إطار التكفل بأمراض خطيرة ولا يوجد علاج معادل لها على التراب الوطني ولديها منفعة علاجية مثبتة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_233_20180702_OpEnact_da49c7b541> ;
    dzdoc:replacementText "يمكن الوزير المكلف بالصحة ، وبعد رأي الوكالة الوطنية للمواد الصيدلانية ، أن يسلم ترخيصا مؤقتا لاستعمال أدوية غير مسجلة عندما توصف هذه الأدوية في إطار التكفل بأمراض خطيرة ولا يوجد علاج معادل لها على التراب الوطني ولديها منفعة علاجية مثبتة . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_233> ;
