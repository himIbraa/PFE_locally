<https://legal.dz/resource/law/2018-07-02/18-11#version_art_122> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تمارس نشاطات التربية من أجل الصحة على أساس برنامج يعده وينفذه ويقيمه الوزير المكلف بالصحة ، بالتنسيق مع القطاعات المعنية."@ar ;
