    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف المنع المنصوص عليه في أحكام المادة 375 من هذا القانون، المتعلقة باستنساخ أجسام حية مماثلة وراثيا وانتقاء الجنس، بالحبس من عشر (10) سنوات إلى عشرين (20) سنة وبغرامة من 1.000.000 دج إلى 2.000.000 دج ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_437_20180702_OpEnact_e0f864ea3f> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
    dzdoc:versionEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_437> ;
