<https://legal.dz/resource/law/2018-07-02/18-11#version_art_146> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب أن يقوم بالفحص الإجباري في طب الأمراض العقلية طبيب الأمراض العقلية لمؤسسة استشفائية . لا يمكن طبيب الأمراض العقلية للمؤسسة، بأي حال من الأحوال، أن يقوم بالفحص الإجباري في طب الأمراض العقلية لأحد أعضاء أسرته ، لا سيما الأصول أو الفروع المباشرين، الزوج أو الأخ أو الأخت أو العم أو الخال أو العمة أو الخالة أو الأقارب الحواشي. ولا يمكنه أن يقوم بالفحص الإجباري في طب الأمراض العقلية لأزواج الأشخاص المذكورين في الفقرة أعلاه ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_146_20180702_OpEnact_745aefac2c> ;
    dzdoc:replacementText "يجب أن يقوم بالفحص الإجباري في طب الأمراض العقلية طبيب الأمراض العقلية لمؤسسة استشفائية . لا يمكن طبيب الأمراض العقلية للمؤسسة، بأي حال من الأحوال، أن يقوم بالفحص الإجباري في طب الأمراض العقلية لأحد أعضاء أسرته ، لا سيما الأصول أو الفروع المباشرين، الزوج أو الأخ أو الأخت أو العم أو الخال أو العمة أو الخالة أو الأقارب الحواشي. ولا يمكنه أن يقوم بالفحص الإجباري في طب الأمراض العقلية لأزواج الأشخاص المذكورين في الفقرة أعلاه ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_146> ;
