    dzdoc:versionSourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_433> ;
    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يقوم بنزع أو زرع الأعضاء أو الأنسجة أو الخلايا البشرية أو يمارس نشاطات المساعدة الطبية على الإنجاب في مؤسسة غير مرخص لها، بالحبس من سنتين (2) إلى خمس (5) سنوات وبغرامة من 500.000 دج إلى 1.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_434_20180702_OpEnact_1b2eb7fd16> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
