<https://legal.dz/resource/law/2018-07-02/18-11#version_art_95> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تهدف حماية الصحة وترقيتها المذكورتان في المادة 94 أعلاه، إلى حفظ صحة التلاميذ والطلبة والمتربصين وترقيتها، من خلال ما يأتي : مراقبة حالتهم الصحية ومتابعة التكفل بالأمراض التي تم الكشف عنها، مراقبة الأمراض ذات التصريح الإجباري والوقاية من الآفات الاجتماعية، نشاطات التربية من أجل الصحة، النشاطات العلاجية الجوارية مراقبة سلامة المحلات والملحقات التابعة لكل مؤسسة تعليم وتكوين، التلقيحات الإجبارية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_95_20180702_OpEnact_340bdfc056> ;
    dzdoc:replacementText "تهدف حماية الصحة وترقيتها المذكورتان في المادة 94 أعلاه، إلى حفظ صحة التلاميذ والطلبة والمتربصين وترقيتها، من خلال ما يأتي : مراقبة حالتهم الصحية ومتابعة التكفل بالأمراض التي تم الكشف عنها، مراقبة الأمراض ذات التصريح الإجباري والوقاية من الآفات الاجتماعية، نشاطات التربية من أجل الصحة، النشاطات العلاجية الجوارية مراقبة سلامة المحلات والملحقات التابعة لكل مؤسسة تعليم وتكوين، التلقيحات الإجبارية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_95> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
