    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تكون قرارات المجالس الجهوية للأدبيات الطبية قابلة للطعن أمام المجالس الوطنية للأدبيات الطبية التابعة لها في أجل شهرين (2) ابتداء من تاريخ تبليغها. وتكون قرارات المجالس الوطنية للأدبيات الطبية قابلة للطعن أمام مجلس الدولة في أجل أربعة (4) أشهر، ابتداء من تاريخ تبليغها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
