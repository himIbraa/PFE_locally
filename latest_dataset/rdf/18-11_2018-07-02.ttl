<https://legal.dz/resource/law/2018-07-02/18-11#version_art_250> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن أن يساعد الصيدلي صيدلي مساعد أو عدة صيادلة مساعدين. ويمارس الصيدلي المساعد ، تحت مسؤوليته، نشاطاته الصيدلانية. تحدد شروط ممارسة مهنة الصيدلي و الصيدلي المساعد وكيفيات تنظيمها عن طريق التنظيم."@ar ;
