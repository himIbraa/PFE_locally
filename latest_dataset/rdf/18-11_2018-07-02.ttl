<https://legal.dz/resource/law/2018-07-02/18-11#version_art_124> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تسهر هياكل ومؤسسات الصحة المعنية على تواجد الأشخاص المؤهلين ، و يجب أن يتوفر لديها مخزون استعجالي من الدم والمواد الخاصة به ومن الأدوية والأدوات الخاصة بالاستعجالات الأولية وكل وسيلة ضرورية أخرى ، و يجب مراقبة هذا المخزون الاستعجالي وتجديده بصفة منتظمة . تحدد كيفيات تطبيق هذا الفصل عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_124_20180702_OpEnact_206f47332a> ;
    dzdoc:replacementText "تسهر هياكل ومؤسسات الصحة المعنية على تواجد الأشخاص المؤهلين ، و يجب أن يتوفر لديها مخزون استعجالي من الدم والمواد الخاصة به ومن الأدوية والأدوات الخاصة بالاستعجالات الأولية وكل وسيلة ضرورية أخرى ، و يجب مراقبة هذا المخزون الاستعجالي وتجديده بصفة منتظمة . تحدد كيفيات تطبيق هذا الفصل عن طريق التنظيم."@ar ;
