    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_274_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "يمكن أن تعد هياكل ذات طابع صحي وتسمى \"مراكز علاج\"، الهياكل المعتمدة من طرف الوزير المكلف بالصحة التي تتوفر، لا سيما على وسائل علاجية طبيعية أو عناصر حموية أو حقول وحل علاجي أو نباتات بحرية أو شروط مناخية مواتية للعلاج الشافي والوقائي."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_274_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_274> ;
    dzdoc:position 0 ;
    dzdoc:text "يمكن أن تعد هياكل ذات طابع صحي وتسمى \"مراكز علاج\"، الهياكل المعتمدة من طرف الوزير المكلف بالصحة التي تتوفر، لا سيما على وسائل علاجية طبيعية أو عناصر حموية أو حقول وحل علاجي أو نباتات بحرية أو شروط مناخية مواتية للعلاج الشافي والوقائي."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_275_defocc_7495613ab60d> a dzdoc:DefinitionOccurrence ;
