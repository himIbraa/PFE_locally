<https://legal.dz/resource/law/2018-07-02/18-11#version_art_270> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تحدد الخريطة الصحية مقاييس التغطية الصحية وتضبط الوسائل الواجب تعبئتها على المستوى الوطني والجهوي، مع الأخذ في الحسبان، لا سيما الحوض السكاني والخصائص الوبائية والصحية والجغرافية والديموغرافية والاجتماعية والاقتصادية، قصد ضمان توزيع عادل للعلاجات الصحية. تعد الخريطة الصحية وتقيم وتحين دوريا، وفق كيفيات تحدد عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_270_20180702_OpEnact_3d90ba573f> ;
    dzdoc:replacementText "تحدد الخريطة الصحية مقاييس التغطية الصحية وتضبط الوسائل الواجب تعبئتها على المستوى الوطني والجهوي، مع الأخذ في الحسبان، لا سيما الحوض السكاني والخصائص الوبائية والصحية والجغرافية والديموغرافية والاجتماعية والاقتصادية، قصد ضمان توزيع عادل للعلاجات الصحية. تعد الخريطة الصحية وتقيم وتحين دوريا، وفق كيفيات تحدد عن طريق التنظيم."@ar ;
