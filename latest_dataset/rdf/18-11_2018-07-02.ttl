<https://legal.dz/resource/law/2018-07-02/18-11#version_art_272> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم إنشاء مختلف هياكل ومؤسسات الصحة وكذا المؤسسات التي تساهم في الصحة وهيئات الدعم وفقا للاحتياجات الصحية للمواطنين وضرورات التنمية والمميزات الاجتماعية والاقتصادية لمختلف النواحي من التراب الوطني والمقاييس المحددة في إطار الخريطة الصحية ومخطط التنظيم الصحي. تحدد مهام مختلف هياكل ومؤسسات الصحة وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_272_20180702_OpEnact_4440e6bfd7> ;
    dzdoc:replacementText "يتم إنشاء مختلف هياكل ومؤسسات الصحة وكذا المؤسسات التي تساهم في الصحة وهيئات الدعم وفقا للاحتياجات الصحية للمواطنين وضرورات التنمية والمميزات الاجتماعية والاقتصادية لمختلف النواحي من التراب الوطني والمقاييس المحددة في إطار الخريطة الصحية ومخطط التنظيم الصحي. تحدد مهام مختلف هياكل ومؤسسات الصحة وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
