<https://legal.dz/resource/law/2018-07-02/18-11#version_art_207> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتضمن المواد الصيدلانية ، في مفهوم هذا القانون ، ما يأتي : الأدوية، المواد الكيميائية الخاصة بالصيدليات، المواد الجالينوسية، المواد الأولية ذات الاستعمال الصيدلاني، الأغذية الحميوية الموجهة لأغراض طبية خاصة، كل المواد الأخرى الضرورية للطب البشري."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_207_20180702_OpEnact_538a0f328f> ;
    dzdoc:replacementText "تتضمن المواد الصيدلانية ، في مفهوم هذا القانون ، ما يأتي : الأدوية، المواد الكيميائية الخاصة بالصيدليات، المواد الجالينوسية، المواد الأولية ذات الاستعمال الصيدلاني، الأغذية الحميوية الموجهة لأغراض طبية خاصة، كل المواد الأخرى الضرورية للطب البشري."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_207> ;
