<https://legal.dz/resource/law/2018-07-02/18-11#version_art_380> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن إجراء الدراسات العيادية على الكائن البشري إلا إذا : كانت مؤسسة على آخر ما توصل إليه البحث العيادي والمعارف العلمية وتجربة ما قبل عيادية كافية، كان معدل الفائدة بالنسبة للخطر المتوقع في صالح الشخص المعني بالدراسة، كانت منفذة تحت إدارة ومراقبة طبيب باحث يثبت خبرة مناسبة، تمت في ظروف بشرية ومادية وتقنية تتلاءم مع الدراسة العيادية وتتوافق ومقتضيات الصرامة العلمية وأمن الأشخاص الذين يخضعون للدراسة العيادية."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_380_20180702_OpEnact_98e7c727ef> ;
    dzdoc:replacementText "لا يمكن إجراء الدراسات العيادية على الكائن البشري إلا إذا : كانت مؤسسة على آخر ما توصل إليه البحث العيادي والمعارف العلمية وتجربة ما قبل عيادية كافية، كان معدل الفائدة بالنسبة للخطر المتوقع في صالح الشخص المعني بالدراسة، كانت منفذة تحت إدارة ومراقبة طبيب باحث يثبت خبرة مناسبة، تمت في ظروف بشرية ومادية وتقنية تتلاءم مع الدراسة العيادية وتتوافق ومقتضيات الصرامة العلمية وأمن الأشخاص الذين يخضعون للدراسة العيادية."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_380> ;
