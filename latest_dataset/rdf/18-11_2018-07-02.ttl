<https://legal.dz/resource/law/2018-07-02/18-11#art_283_defocc_decd3d0d4b47> a dzdoc:DefinitionOccurrence ;
    dzdoc:charEnd 134 ;
    dzdoc:charStart 0 ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:definesTerm dzterm:primary_care ;
    dzdoc:extractionMethod "akn_def_tag" ;
    dzdoc:occursInArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_283> ;
    dzdoc:occursInParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_283_para_0> ;
    dzdoc:paragraphPosition 0 ;
    dzdoc:snippet "العلاجات القاعدية أو الأولية هي كل خدمات الوقاية والترقية الصحية والعلاجات الأساسية وإعادة التأهيل التي تستجيب للحاجيات الصحية للأشخاص. وتمثل المستوى الأول لمسار العلاج في المنظومة الوطنية للصحة ويجب تقريبها، قدر الإمكان، من أماكن العيش والتعليم والتكوين والعمل."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_283_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_283> ;
    dzdoc:position 0 ;
    dzdoc:text "العلاجات القاعدية أو الأولية هي كل خدمات الوقاية والترقية الصحية والعلاجات الأساسية وإعادة التأهيل التي تستجيب للحاجيات الصحية للأشخاص. وتمثل المستوى الأول لمسار العلاج في المنظومة الوطنية للصحة ويجب تقريبها، قدر الإمكان، من أماكن العيش والتعليم والتكوين والعمل."@ar .

