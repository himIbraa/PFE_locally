<https://legal.dz/resource/law/2018-07-02/18-11#version_art_25> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة تشخيص أو احتمال مرض خطير ، يمكن أفراد أسرة المريض الحصول على المعلومات الضرورية التي تمكنهم من مساعدة هذا المريض ، ما لم يعترض على ذلك . لا يمنع السر الطبي من إعلام أسرة الشخص المتوفى طالما يسمح بمعرفة أسباب الوفاة من أجل الدفاع عن ذاكرة المتوفى أو المطالبة بحقوقه، ما لم يعبر الشخص قبل وفاته على خلاف ذلك."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_25_20180702_OpEnact_3413183d0e> ;
    dzdoc:replacementText "في حالة تشخيص أو احتمال مرض خطير ، يمكن أفراد أسرة المريض الحصول على المعلومات الضرورية التي تمكنهم من مساعدة هذا المريض ، ما لم يعترض على ذلك . لا يمنع السر الطبي من إعلام أسرة الشخص المتوفى طالما يسمح بمعرفة أسباب الوفاة من أجل الدفاع عن ذاكرة المتوفى أو المطالبة بحقوقه، ما لم يعبر الشخص قبل وفاته على خلاف ذلك."@ar ;
