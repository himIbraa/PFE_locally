dzorg:الجريدة_الرسمية a dzdoc:Organization ;
    rdfs:label "الجريدة الرسمية"@ar ;
    dzdoc:frbrUri "/ontology/organization/dz/joradp"^^xsd:anyURI .

<https://legal.dz/resource/law/2018-07-02/18-11#art_100_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_100> ;
    dzdoc:position 0 ;
    dzdoc:text "يتكفل بنشاطات طب العمل مستخدمو الصحة المجتمعون ضمن مصالح طب العمل، الذين يتولون مهام وقائية أساسا و علاجية بشكل ثانوي."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_100_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_100> ;
    dzdoc:position 1 ;
    dzdoc:text "تهدف النشاطات في مجال طب العمل، لا سيما إلى ما يأتي : الحفاظ على صحة العمال وقدرتهم على العمل وترقيتهما، تحسين ظروف ووسط العمل لضمان الأمن والصحة في العمل، اعتماد نظام تنظيم للعمل يهدف إلى ترقية مناخ اجتماعي ملائم وثقافة حفظ الصحة والأمن والصحة في العمل."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_101_obligation_0_480d2d57> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_101> ;
    dznorm:position 0 ;
    dznorm:provisionText "تضع الدولة برنامجا وطنيا للصحة في الوسط العقابي"@ar ;
    dznorm:sourceArticle "art_101" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_101_obligation_1_d88f486b> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_101> ;
    dznorm:position 1 ;
    dznorm:provisionText "تتولى مصالح الوزارة المكلفة بالصحة المختصة إقليميا، مراقبة ومتابعة نشاطات هياكل الصحة في الوسط العقابي"@ar ;
    dznorm:sourceArticle "art_101" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_101_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_101> ;
    dzdoc:position 0 ;
    dzdoc:text "تضع الدولة برنامجا وطنيا للصحة في الوسط العقابي يشمل النشاطات التي تسمح بوقاية صحة المحبوسين وحمايتها وترقيتها وحفظها والعلاج الاستعجالي والعلاج القاعدي والتكفل بالأمراض التي تم الكشف عنها، والوقاية من الأخطار الوبائية والمساعدة النفسية."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_101_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_101> ;
    dzdoc:position 1 ;
    dzdoc:text "ويتولى القيام بهذه النشاطات مستخدمو الصحة في مصالح الصحة للمؤسسات العقابية و/أو في الهياكل والمؤسسات العمومية للصحة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_101_para_2> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_101> ;
    dzdoc:position 2 ;
    dzdoc:text "تتولى مصالح الوزارة المكلفة بالصحة المختصة إقليميا، مراقبة ومتابعة نشاطات هياكل الصحة في الوسط العقابي."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_102_obligation_0_92b35c14> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2018-07-02/18-11#art_102_obligation_0_92b35c14_role_ab3a08083d> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_102> ;
    dznorm:position 0 ;
    dznorm:provisionText "تعد مصالح الصحة التابعة لإدارة الوسط العقابي تقريرا سنويا عن ظروف وحالة صحة المحبوسين داخل المؤسسات العقابية وترسله إلى الوزيرين المكلفين، على التوالي، بالصحة والعدل"@ar ;
    dznorm:sourceArticle "art_102" .

