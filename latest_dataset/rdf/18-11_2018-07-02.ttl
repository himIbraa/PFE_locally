<https://legal.dz/resource/law/2018-07-02/18-11#version_art_235> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الإعلام العلمي حول المواد الصيدلانية إجباري ، ويجب أن يكون واضحا وقابلا للتمحيص ومطابقا لأحدث معطيات البحث الطبي والعلمي عند توزيعه، وأن يذكر إجباريا التسمية المشتركة الدولية للمادة موضوع هذا الإعلام."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_235_20180702_OpEnact_be73fc26e1> ;
    dzdoc:replacementText "الإعلام العلمي حول المواد الصيدلانية إجباري ، ويجب أن يكون واضحا وقابلا للتمحيص ومطابقا لأحدث معطيات البحث الطبي والعلمي عند توزيعه، وأن يذكر إجباريا التسمية المشتركة الدولية للمادة موضوع هذا الإعلام."@ar ;
    dzdoc:resolutionStatus "resolved" ;
