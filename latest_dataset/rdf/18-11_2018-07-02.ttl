<https://legal.dz/resource/law/2018-07-02/18-11#version_art_366> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يمكن القيام بنزع أو زرع الأعضاء أو الأنسجة أو الخلايا البشرية إلا على مستوى المؤسسات الاستشفائية العمومية المرخص لها من طرف الوزير المكلف بالصحة ، بعد رأي الوكالة الوطنية لزرع الأعضاء . يجب أن تتوفر المؤسسات الاستشفائية على تنظيم طبي - تقني وتنسيق استشفائي، كي تحصل على ترخيص للقيام بعمليات نزع الأعضاء والأنسجة . تحدد شروط وكيفيات الترخيص عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_366_20180702_OpEnact_f077fb9ebe> ;
    dzdoc:replacementText "لا يمكن القيام بنزع أو زرع الأعضاء أو الأنسجة أو الخلايا البشرية إلا على مستوى المؤسسات الاستشفائية العمومية المرخص لها من طرف الوزير المكلف بالصحة ، بعد رأي الوكالة الوطنية لزرع الأعضاء . يجب أن تتوفر المؤسسات الاستشفائية على تنظيم طبي - تقني وتنسيق استشفائي، كي تحصل على ترخيص للقيام بعمليات نزع الأعضاء والأنسجة . تحدد شروط وكيفيات الترخيص عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_366> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
