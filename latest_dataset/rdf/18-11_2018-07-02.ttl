dzterm:promoter a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المرقي"@ar,
        "المرقي هو الشخص الطبيعي أو المعنوي الذي يبادر بالدراسة العيادية."@ar,
        "لمرقي"@ar,
        "مرق"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_384_defocc_5aa4c654c118> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_112> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_4> ;
    dzdoc:eId "art_112" ;
    dzdoc:fullText "تسهر هياكل ومؤسسات الصحة، بالتعاون مع المصالح المعنية، على مطابقة مقاييس حفظ الصحة ونوعية التغذية و احترامها في مؤسسات الإطعام لا سيما تلك المخصصة للجماعات. يتعين على الشركات والمؤسسات والقائمين بالخدمات في ميدان الاطعام، إجراء الفحوص الطبية الملائمة الدورية على عمالهم . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_112> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_112_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_112_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_112_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_112_20180702_OpEnact_5a80c710f4> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_112_obligation_0_27761759> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "112" ;
    dzdoc:position 111 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_112> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_112> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_123> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_6> ;
    dzdoc:eId "art_123" ;
    dzdoc:fullText "يتعين على هياكل ومؤسسات الصحة المعنية، في إطار التكفل الصحي عند الكوارث أو الحالات الاستثنائية، إعداد مخطط تدخل ونجدة خصوصي، وذلك بالتعاون مع سلطات المصالح المؤهلة . ويجب عليها مسك بطاقية محينة للأشخاص المختصين والوسائل الواجب تعبئتهما في حالة كارثة أو في حالة استثنائية . كما يتعين عليها القيام بشكل دوري تنظيم تمارين محاكاة بالتنسيق مع المصالح المؤهلة في إطار الوقاية وذلك من أجل التخفيف من آثار الكوارث أو الحالة الاستثنائية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_123> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_123_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_123_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_123_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_123_20180702_OpEnact_782b30d133> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_123_obligation_0_024e7244>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_123_obligation_1_ad148e0c>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_123_obligation_2_6376882a> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 123" ;
    dzdoc:position 121 ;
    dzdoc:usesTerm dzterm:health_structures .

<https://legal.dz/resource/law/2018-07-02/18-11#art_124> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_6> ;
    dzdoc:eId "art_124" ;
    dzdoc:fullText "تسهر هياكل ومؤسسات الصحة المعنية على تواجد الأشخاص المؤهلين ، و يجب أن يتوفر لديها مخزون استعجالي من الدم والمواد الخاصة به ومن الأدوية والأدوات الخاصة بالاستعجالات الأولية وكل وسيلة ضرورية أخرى ، و يجب مراقبة هذا المخزون الاستعجالي وتجديده بصفة منتظمة . تحدد كيفيات تطبيق هذا الفصل عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_124> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_124_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_124_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_124_20180702_OpEnact_206f47332a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_124_obligation_0_70952732>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_124_obligation_1_3976e29d>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_124_obligation_2_b60c9e8e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 124" ;
    dzdoc:position 122 ;
    dzdoc:usesTerm dzterm:health_structures .

<https://legal.dz/resource/law/2018-07-02/18-11#art_154> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_2_subsec_3_subsubsec_3> ;
    dzdoc:eId "art_154" ;
    dzdoc:fullText "يرسل طبيب المؤسسة للأمراض العقلية ، في إلى الوالي يفصل فيها الأسباب التي يراها ضرورية لاتخاذ حالة ضرورة الاستشفاء الإجباري ، شهادة طبية هذا التدبير. يتخذ قرار الاستشفاء الإجباري بموجب قرار من الوالي لمدة ستة (6) أشهر، على الأكثر، ويمكن أن يكون محل تجديد ضمن نفس الأشكال. في حالة الاحتجاج على طلب الاستشفاء الإجباري تخطر اللجنة الولائية للصحة العقلية ضمن الشروط المنصوص عليها في المادة 132 أعلاه. يبقي طبيب الأمراض العقلية ، بعد إعلامه بهذا الإخطار من طرف اللجنة المريض في الملاحظة الإجبارية في انتظار قرار اللجنة الولائية للصحة العقلية ."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_154> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_154_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_154_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_154_para_2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_154_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_154_20180702_OpEnact_be5c287e6a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_154_obligation_0_9643c859>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_154_obligation_1_67650b05> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "154" ;
    dzdoc:position 152 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_132> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_132> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_154_condition_0_99c3c36a> ;
    dzdoc:usesTerm dzterm:compulsory_hospitalization,
        dzterm:provincial_mental_health_committee,
        dzterm:psychiatrist,
        dzterm:wali .

<https://legal.dz/resource/law/2018-07-02/18-11#art_161> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_3_sec_3> ;
    dzdoc:eId "art_161" ;
    dzdoc:fullText "يمكن طبيب الأمراض العقلية للمؤسسة، دون سواه، أن يصف تحت مسؤوليته الكاملة، نشاطات التداوي بالعمل التي تسمح بإعادة الإدماج الاجتماعي للمريض. وتمنع، خلال الاستشفاء، كل أشغال أخرى مهما كان شكلها أو طبيعتها."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_161_permission_0_d5454c49> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_161> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_161_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_161_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_161_20180702_OpEnact_b76fc8c547> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_161_obligation_0_24fa0eec> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 161" ;
    dzdoc:position 159 ;
    dzdoc:usesTerm dzterm:psychiatrist .

<https://legal.dz/resource/law/2018-07-02/18-11#art_169> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_4_sec_2_subsec_1> ;
    dzdoc:eId "art_169" ;
    dzdoc:fullText "يمارس مهني الصحة مهنته بصفة شخصية. و يجب أن يلتزم بالسر الطبي و/أو المهني. عندما يتدخل المهنيون ضمن فريق للتكفل بمريض فإنه يجب توزيع المعلومات التي تحصل عليها أحد أعضاء الفريق على كل الأعضاء الآخرين وذلك في مصلحة المريض."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_169> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_169_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_169_20180702_OpEnact_5f26089bcd> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_169_obligation_0_3d2f56ba>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_169_obligation_1_9d8755fa> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 169" ;
    dzdoc:position 167 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_169_condition_0_f56a0027> ;
    dzdoc:usesTerm dzterm:health_professional .

<https://legal.dz/resource/law/2018-07-02/18-11#art_231> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_5_sec_5> ;
    dzdoc:eId "art_231" ;
    dzdoc:fullText "يلزم أعضاء لجان التسجيل والمصادقة والخبراء ومساعدوهم وكذا كل الأشخاص الذين يطلعون على ملفات التسجيل والمصادقة بالسر المهني، لاسيما فيما يخص تركيب المواد الخاضعة للخبرة وكذا معطياتها. لا يمكن الخبراء ومساعديهم إعطاء معلومات متعلقة بأعمالهم إلا للهيكل المؤهل للوكالة الوطنية للمواد الصيدلانية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_231_permission_0_c62464d0> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_231> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_231_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_231_20180702_OpEnact_82dc263941> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_231_obligation_0_a346ff5b>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_231_obligation_1_cd8a4290> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "231" ;
    dzdoc:position 228 ;
    dzdoc:usesTerm dzterm:national_agency_pharmaceutical_products .

<https://legal.dz/resource/law/2018-07-02/18-11#art_268> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_1> ;
    dzdoc:eId "art_268" ;
    dzdoc:fullText "تهدف شبكات العلاج إلى تحقيق تكفل أفضل بالمريض واستمرارية العلاج وكذا تقديم علاج جواري ذي جودة من أجل ضمان تسهيل الحصول على العلاج والعدالة في مجال الصحة . يمكن شبكات العلاج إشراك هياكل ومؤسسات الصحة العمومية والخاصة ومهنيي الصحة الآخرين وهيئات ذات طابع صحي أو اجتماعي ضمن الشروط المنصوص عليها في المادة 316 أدناه . تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_268_permission_0_cb151817> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_268_right_0_d49c4e39> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_268> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_268_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_268_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_268_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_268_20180702_OpEnact_bfab7c5ff8> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "268" ;
    dzdoc:position 265 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_316> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_316> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_268_condition_0_c66030b2> ;
    dzdoc:usesTerm dzterm:treatment_networks .

<https://legal.dz/resource/law/2018-07-02/18-11#art_281> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_281" ;
    dzdoc:fullText "تضمن هياكل ومؤسسات الصحة ، لفائدة كل المواطنين، تقديم علاجات أولية وثانوية وذات المستوى العالي وكذا الاستعجالات ، حسب مخطط تنظيمي محدد عن طريق التنظيم. كما يمكن هياكل ومؤسسات الصحة العمومية والخاصة أن تتولى تقديم : علاجات بالمنزل استشفاء بالمنزل، علاجات تلطيفية. تحدد كيفيات تطبيق أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_281_permission_0_e5e29f5b> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_281> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_281_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_281_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_281_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_281_20180702_OpEnact_72c21dc75a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_281_obligation_0_9ef854b0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 281" ;
    dzdoc:position 278 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_281> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_281> ;
    dzdoc:usesTerm dzterm:health_structures,
        dzterm:public_private_health_structures .

<https://legal.dz/resource/law/2018-07-02/18-11#art_282> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_1> ;
    dzdoc:eId "art_282" ;
    dzdoc:fullText "يمكن الهياكل والمؤسسات العمومية للصحة أن تضمن نشاطات التكوين لكل أسلاك مهنيي الصحة. ويمكن إنشاء مخابر بحث على مستواها في إطار برنامج البحث في مجال الصحة. كما يمكن أن تضمن الهياكل والمؤسسات الخاصة للصحة ، عند الاقتضاء ، نشاطات التكوين شبه الطبي، حسب كيفيات تحدد عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_282_permission_0_82a0cc0c>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_282_permission_1_76e186a3> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_282> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_282_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_282_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_282_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_282_20180702_OpEnact_33651644f6> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 282" ;
    dzdoc:position 279 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_282_condition_0_1b1645cd> ;
    dzdoc:usesTerm dzterm:private_health_structures,
        dzterm:public_health_structures .

<https://legal.dz/resource/law/2018-07-02/18-11#art_301> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_6_sec_3_subsec_3> ;
    dzdoc:eId "art_301" ;
    dzdoc:fullText "يتم تمويل نشاطات المؤسسات العمومية للصحة على أساس عقود أهداف ونجاعة تصادق عليها المصالح المختصة للوزارة المكلفة بالصحة. تحدد العقود المذكورة في الفقرة أعلاه ، التزامات الهياكل والمؤسسات العمومية للصحة وتنص على الوسائل الضرورية لإنجاز الأهداف المسطرة في المخطط الوطني للتنظيم الصحي. يتعين على كل هيكل ومؤسسة عمومية للصحة إعداد عقود ومشاريع مصالح في إطار مشروع المؤسسة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_301> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_301_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_301_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_301_para_2>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_301_para_3> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_301_20180702_OpEnact_cc65b33890> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_301_obligation_0_4c63d1e0> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 301" ;
    dzdoc:position 298 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_301> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_301> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_351> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_3> ;
    dzdoc:eId "art_351" ;
    dzdoc:fullText "يمكن الجهة القضائية المختصة أن تخطر المجالس الوطنية والمجالس الجهوية للأدبيات الطبية كلما تم رفع دعوى بشأن مسؤولية عضو من السلك الطبي. ويمكن هذه المجالس أن تتأسس كطرف مدني في القضايا المرتبطة بها. يمكن أن تنشأ عن طريق التنظيم، مجالس أدبيات تخص مهن الصحة الأخرى في إطار احترام أحكام هذا القانون المطبقة على المجالس الوطنية والمجالس الجهوية للأدبيات الطبية المذكورة أعلاه."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_351_permission_0_b6bc98fc>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_351_permission_1_e8ce6c34> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_351> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_351_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_351_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_351_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_351_20180702_OpEnact_e78b2c90ce> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 351" ;
    dzdoc:position 348 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_355> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_355" ;
    dzdoc:fullText "لا يجوز نزع الأعضاء والأنسجة والخلايا البشرية وزرعها إلا لأغراض علاجية أو تشخيصية و ضمن الشروط المنصوص عليها في هذا القانون ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_355_permission_0_154abddc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_355> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_355_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_355_20180702_OpEnact_a50d7f142a> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_355_obligation_0_ab96e302> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_355_prohibition_0_154abddc> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 355" ;
    dzdoc:position 352 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_355_condition_0_314b94ce> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_357> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_357" ;
    dzdoc:fullText "ينشأ ، كلما اقتضت الضرورة إلى ذلك، في المؤسسات المرخص لها بنزع الأنسجة والخلايا، بعد أخذ رأي الوكالة الوطنية لزرع الأعضاء ، هيكل يكلف بالحفاظ على الأنسجة ،والخلايا ، تحدد شروط وكيفيات انشائه وسيره عن طريق التنظيم. لا يجوز جمع أعضاء جسم الإنسان من متبرع حي لأغراض الحفظ ، دون موافقة المتبرع أو ممثله الشرعي ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_357_permission_0_efabb1e7> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_357> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_357_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_357_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_357_20180702_OpEnact_e2c0d8dae3> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_357_obligation_0_7997a98b> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_357_prohibition_0_efabb1e7> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 357" ;
    dzdoc:position 354 ;
    dzdoc:usesTerm dzterm:agency .

<https://legal.dz/resource/law/2018-07-02/18-11#art_359> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_1> ;
    dzdoc:eId "art_359" ;
    dzdoc:fullText "يمكن أن يتم نزع وزرع الأعضاء والخلايا البشرية من متبرعين أحياء لهم قرابة عائلية ومطابقة مع المتلقي ، بالامتثال الصارم للقواعد الطبية. يجب أن يضمن الهيكل الصحي الذي ينتمي له المتلقي التكفل بالفحوصات الطبية لكل من المتبرع والمتلقي، وكذلك المتابعة الطبية لهما ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_359_permission_0_fd797645> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_359_right_0_3610b6aa> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_359> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_359_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_359_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_359_20180702_OpEnact_b8a65ebbb5> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_359_obligation_0_b4f97793> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 359" ;
    dzdoc:position 356 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_36> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_2> ;
    dzdoc:eId "art_36" ;
    dzdoc:fullText "ترتكز برامج الوقاية في الصحة على شبكات رصد الأمراض المنتقلة وغير المنتقلة والإنذار عنها، قصد التمكن من الكشف المبكر عنها والتصدي السريع لها، وعلى سجلات الرصد بالنسبة للأمراض غير المنتقلة. تحدد شروط تنفيذ أحكام هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_36> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_36_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_36_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_36_20180702_OpEnact_ee1b16d339> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "36" ;
    dzdoc:position 35 ;
    dzdoc:references <https://legal.dz/resource/law/2018-07-02/18-11#art_36> ;
    dzdoc:referencesInternal <https://legal.dz/resource/law/2018-07-02/18-11#art_36> ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_36_condition_0_b6577a8d> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_369> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_2> ;
    dzdoc:eId "art_369" ;
    dzdoc:fullText "يجب أن لا يقل سن المتبرع بالدم عن ثماني عشرة (18) سنة وألا يتعدى خمسا وستين (65) سنة . غير أنه، يجوز نزع الدم في كل الأعمار لأسباب علاجية أو تشخيصية ."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_369_permission_0_300a6e01> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_369> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_369_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_369_20180702_OpEnact_34c978a4cf> ;
    dzdoc:imposesObligation <https://legal.dz/resource/law/2018-07-02/18-11#art_369_obligation_0_699b055e> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 369" ;
    dzdoc:position 366 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_369_condition_0_c9402f75> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_374> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_3> ;
    dzdoc:eId "art_374" ;
    dzdoc:fullText "يمنع التداول، لغاية البحث العلمي، التبرع والبيع وكل شكل آخر من المعاملة المتعلقة: بالحيوانات المنوية، بالبويضات، حتى بين الزوجات الضرات، بالأجنة الزائدة عن العدد المقرر أو لا، لأم بديلة أو امرأة أخرى كانت أختا أو أما أو بنتا، بالسيتوبلازم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_374> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_374_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_374_20180702_OpEnact_9b28c47d2a> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_374_prohibition_0_a5f6eb19> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "374" ;
    dzdoc:position 371 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_375> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_3> ;
    dzdoc:eId "art_375" ;
    dzdoc:fullText "يمنع كل استنساخ للأجسام الحية جينيا فيما يخص الكائن البشري وكل انتقاء المتماثلة للجنس."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_375> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_375_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_375_20180702_OpEnact_847e6c29db> ;
    dzdoc:imposesProhibition <https://legal.dz/resource/law/2018-07-02/18-11#art_375_prohibition_0_97f15ddd> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "375" ;
    dzdoc:position 372 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_377> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:biomedical_research ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_377" ;
    dzdoc:fullText "يتمثل البحث في مجال طب الأحياء في إجراء دراسات على الكائن البشري بغرض تطوير المعارف الوبائية والتشخيصية والبيولوجية والعلاجية وتحسين الممارسات الطبية. وتدعى هذه الدراسات في هذا القانون \" الدراسات العيادية \". يمكن أن تكون الدراسات العيادية ملاحظاتية أو تدخلية وتتعلق على الخصوص، بما يأتي : الدراسات العلاجية والتشخيصية والوقائية، دراسات التكافؤ الحيوي والتوفر الحيوي، الدراسات الوبائية والصيدلانية الوبائية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_377_permission_0_708be079> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_377> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_377_defocc_f02f7ad32cc6> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_377_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_377_para_1>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_377_para_2> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_377_20180702_OpEnact_9244578128> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "377" ;
    dzdoc:position 374 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_377_condition_0_5b1786f2> ;
    dzdoc:usesTerm dzterm:clinical_studies .

<https://legal.dz/resource/law/2018-07-02/18-11#art_380> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_7_sec_4_subsec_4> ;
    dzdoc:eId "art_380" ;
    dzdoc:fullText "لا يمكن إجراء الدراسات العيادية على الكائن البشري إلا إذا : كانت مؤسسة على آخر ما توصل إليه البحث العيادي والمعارف العلمية وتجربة ما قبل عيادية كافية، كان معدل الفائدة بالنسبة للخطر المتوقع في صالح الشخص المعني بالدراسة، كانت منفذة تحت إدارة ومراقبة طبيب باحث يثبت خبرة مناسبة، تمت في ظروف بشرية ومادية وتقنية تتلاءم مع الدراسة العيادية وتتوافق ومقتضيات الصرامة العلمية وأمن الأشخاص الذين يخضعون للدراسة العيادية."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_380_permission_0_dd94b4ba> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_380> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_380_para_0> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_380_20180702_OpEnact_98e7c727ef> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "380" ;
    dzdoc:position 377 ;
    dzdoc:specifiesCondition <https://legal.dz/resource/law/2018-07-02/18-11#art_380_condition_0_82e8eb55> ;
    dzdoc:usesTerm dzterm:clinical_studies .

<https://legal.dz/resource/law/2018-07-02/18-11#art_443> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_9> ;
    dzdoc:eId "art_443" ;
    dzdoc:fullText "يمكن المستخدمين في وضعية نشاط في المؤسسات العمومية للصحة التابعة للوزارة المكلفة بالصحة التي تم تعديل قانونها الأساسي الاحتفاظ بالقانون الأساسي المطبق عليهم إذا رغبوا في ذلك ، ابتداء من تاريخ دخول هذا القانون حيز التنفيذ. ويبقى المستخدمون الذين يمارسون عملهم في إطار اتفاقات واتفاقيات التعاون، خاضعين للأحكام الخاصة بهم."@ar ;
    dzdoc:grantsPermission <https://legal.dz/resource/law/2018-07-02/18-11#art_443_permission_0_4f77c537> ;
    dzdoc:grantsRight <https://legal.dz/resource/law/2018-07-02/18-11#art_443_right_0_123f07cc> ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_443> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_443_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_443_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_443_20180702_OpEnact_c808253bf3> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "المادة 443" ;
    dzdoc:position 440 .

<https://legal.dz/resource/law/2018-07-02/18-11#art_88> a dzdoc:Article ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:definesTerm dzterm:persons_in_difficult_situation ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#chp_2_sec_3_subsec_4> ;
    dzdoc:eId "art_88" ;
    dzdoc:fullText "يعتبر أشخاصا في وضع صعب ، لا سيما : الأشخاص ذوو الدخل الضعيف، لا سيما الأشخاص المعوقون أو الذين يعيشون في ظروف مادية واجتماعية و/أو نفسية هشة تهدد صحتهم العقلية والبدنية، الأشخاص ضحايا الكوارث أو أي حادث استثنائي آخر، الذين هم في وضعية مادية أو اجتماعية هشة، الأشخاص المستون أو الأطفال أو المراهقون الذين هم في خطر معنوي و/أو الموضوعون في المؤسسات التابعة لـ الوزارة المكلفة بالتضامن الوطني ، الأمهات والنساء اللائي هن في حالة نفسية واجتماعية صعبة. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_88> ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_88_defocc_0addf2b23618> ;
    dzdoc:hasParagraph <https://legal.dz/resource/law/2018-07-02/18-11#art_88_para_0>,
        <https://legal.dz/resource/law/2018-07-02/18-11#art_88_para_1> ;
    dzdoc:hasStatus dzdoc:StatusOriginal ;
    dzdoc:hasVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_88_20180702_OpEnact_14ac80bd25> ;
    dzdoc:introducedBy <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:introducedOn "2018-07-02"^^xsd:date ;
    dzdoc:number "88" ;
    dzdoc:position 87 ;
    dzdoc:usesTerm dzterm:ministry_solidarity .

<https://legal.dz/resource/law/2018-07-02/18-11#chp_5> a dzdoc:Chapter ;
    dzdoc:containedIn <https://legal.dz/resource/law/2018-07-02/18-11> ;
