<https://legal.dz/resource/law/2018-07-02/18-11#version_art_377> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتمثل البحث في مجال طب الأحياء في إجراء دراسات على الكائن البشري بغرض تطوير المعارف الوبائية والتشخيصية والبيولوجية والعلاجية وتحسين الممارسات الطبية. وتدعى هذه الدراسات في هذا القانون \" الدراسات العيادية \". يمكن أن تكون الدراسات العيادية ملاحظاتية أو تدخلية وتتعلق على الخصوص، بما يأتي : الدراسات العلاجية والتشخيصية والوقائية، دراسات التكافؤ الحيوي والتوفر الحيوي، الدراسات الوبائية والصيدلانية الوبائية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_377_20180702_OpEnact_9244578128> ;
    dzdoc:replacementText "يتمثل البحث في مجال طب الأحياء في إجراء دراسات على الكائن البشري بغرض تطوير المعارف الوبائية والتشخيصية والبيولوجية والعلاجية وتحسين الممارسات الطبية. وتدعى هذه الدراسات في هذا القانون \" الدراسات العيادية \". يمكن أن تكون الدراسات العيادية ملاحظاتية أو تدخلية وتتعلق على الخصوص، بما يأتي : الدراسات العلاجية والتشخيصية والوقائية، دراسات التكافؤ الحيوي والتوفر الحيوي، الدراسات الوبائية والصيدلانية الوبائية. تحدد كيفيات تطبيق هذه المادة عن طريق التنظيم."@ar ;
