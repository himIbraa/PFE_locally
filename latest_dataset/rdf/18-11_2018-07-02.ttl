<https://legal.dz/resource/law/2018-07-02/18-11#version_art_27> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على المرضى وكذا مرتفقي الصحة، الالتزام بالاحترام والسلوك اللائق تجاه مهنيي الصحة ، و لا يمكنهم، في كل الظروف اللجوء إلى العنف بأي شكل من الأشكال، أو ارتكاب أي فعل تخريب لأملاك هياكل ومؤسسات الصحة ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_27_20180702_OpEnact_11ca1c8297> ;
    dzdoc:replacementText "يجب على المرضى وكذا مرتفقي الصحة، الالتزام بالاحترام والسلوك اللائق تجاه مهنيي الصحة ، و لا يمكنهم، في كل الظروف اللجوء إلى العنف بأي شكل من الأشكال، أو ارتكاب أي فعل تخريب لأملاك هياكل ومؤسسات الصحة ."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_27> ;
