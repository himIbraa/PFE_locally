<https://legal.dz/resource/law/2018-07-02/18-11#version_art_219> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المؤسسات الصيدلانية هي مؤسسات إنتاج واستغلال واستيراد وتصدير وتوزيع بالجملة مواد صيدلانية ومستلزمات طبية موجهة للطب البشري. ويجب عليها أن تضمن وفرة هذه المواد وأن تتوفر على هيكل تتم فيه على الأقل، إحدى العمليات المذكورة في المادتين 221 و 222 من هذا القانون، وتستوفي الشروط الواردة المادة 218 أعلاه. تحدد كيفيات تطبيق هذه المادة، لا سيما شروط اعتماد المؤسسات الصيدلانية، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_219_20180702_OpEnact_a13d3166c5> ;
    dzdoc:replacementText "المؤسسات الصيدلانية هي مؤسسات إنتاج واستغلال واستيراد وتصدير وتوزيع بالجملة مواد صيدلانية ومستلزمات طبية موجهة للطب البشري. ويجب عليها أن تضمن وفرة هذه المواد وأن تتوفر على هيكل تتم فيه على الأقل، إحدى العمليات المذكورة في المادتين 221 و 222 من هذا القانون، وتستوفي الشروط الواردة المادة 218 أعلاه. تحدد كيفيات تطبيق هذه المادة، لا سيما شروط اعتماد المؤسسات الصيدلانية، عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_219> ;
