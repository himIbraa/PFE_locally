    dzdoc:position 0 ;
    dzdoc:text "تساهم المؤسسات الاقتصادية في تمويل الصحة في إطار أعمال مبرمجة بعنوان طب العمل وترقية الصحة، حسب كيفيات تحدد عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_333_para_0> a dzdoc:Paragraph ;
