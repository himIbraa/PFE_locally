<https://legal.dz/resource/law/2018-07-02/18-11#version_art_24> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لكل شخص الحق في احترام حياته الخاصة وسر المعلومات الطبية المتعلقة به ، باستثناء الحالات المنصوص عليها صراحة في القانون . ويشمل السر الطبي جميع المعلومات التي علم بها مهنيو الصحة. يمكن أن يرفع السر الطبي من طرف الجهة القضائية المختصة. كما يمكن رفعه بالنسبة للقصر أو عديمي الأهلية بطلب من الزوج أو الأب أو الأم أو الممثل الشرعي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_24_20180702_OpEnact_c782151a73> ;
