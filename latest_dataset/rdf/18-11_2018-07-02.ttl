<https://legal.dz/resource/law/2018-07-02/18-11#art_156_obligation_0_5302e354> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2018-07-02/18-11#art_156_obligation_0_5302e354_action_df24186952> ;
