    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_208> ;
    dznorm:position 0 ;
    dznorm:provisionText "الدواء، في مفهوم هذا القانون، هو كل مادة أو تركيب يعرض على أنه يحتوي على خاصيات علاجية أو وقائية من الأمراض البشرية أو الحيوانية وكل المواد التي يمكن وصفها للإنسان أو للحيوان قصد القيام بتشخيص طبي أو استعادة وظائفه الفيزيولوجية أو تصحيحها وتعديلها."@ar ;
    dznorm:sourceArticle "art_208" .

