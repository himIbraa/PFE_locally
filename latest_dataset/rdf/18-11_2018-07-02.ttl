dzterm:agency a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوكالة الوطنية لزرع الأعضاء"@ar,
        "وكالة وطنية لزرع الأعضاء"@ar .

dzterm:bioethics a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "البيو - أخلاقيات هي كل التدابير المرتبطة بالنشاطات المتعلقة بنزع الأعضاء وزرعها والأنسجة والخلايا والتبرع بالدم البشري ومشتقاته واستعمالهما والمساعدة الطبية على الإنجاب والبحث البيو- طبي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_354_defocc_c56dd6d7df0e> .

dzterm:biomedical_research a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يتمثل البحث في مجال طب الأحياء في إجراء دراسات على الكائن البشري بغرض تطوير المعارف الوبائية والتشخيصية والبيولوجية والعلاجية وتحسين الممارسات الطبية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_377_defocc_f02f7ad32cc6> .

dzterm:civil_service a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الخدمة المدنية"@ar .

dzterm:counterfeit_drug a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد بدواء مقلد"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_211_defocc_23319352aa31> .

dzterm:definitions a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يقصد، في مفهوم هذا القانون بما يأتي :"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_210_defocc_f41026cdceb7> .

dzterm:doctor a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الطبيب"@ar,
        "طبيب"@ar .

dzterm:health_institution a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مؤسسة الصحة"@ar .

dzterm:health_ministry a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوزارة المكلفة بالصحة"@ar,
        "وزارة الصحة"@ar .

dzterm:health_organization_plan a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مخطط التنظيم الصحي"@ar .

dzterm:health_professions a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مهن الصحة"@ar .

dzterm:health_protection a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "حماية الصحة وترقيتها"@ar .

dzterm:high_level_care a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العلاجات ذات المستوى العالي هي مجموع الخدمات التشخيصية والعلاجية عالية التخصص المقدمة في هياكل ومؤسسات الصحة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_285_defocc_ab252bb62226> .

dzterm:hospitalization a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "استشفاء"@ar,
        "الاستشفاء"@ar .

dzterm:hospitalization_third_party a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الاستشفاء بفعل الغير"@ar .

dzterm:illegal_practice_health a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يمارس بصفة غير شرعية مهنة الصحة كل من لا يستوفي شروط الممارسة المحددة في التشريع والتنظيم المعمول بهما"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_185_defocc_c107ee934c19> .

dzterm:illegal_practice_medicine a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يمارس بصفة غير شرعية الطب أو طب الأسنان أو الصيدلة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_186_defocc_0ba1358600a4> .

dzterm:international_spread_diseases a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأمراض ذات الانتشار الدولي"@ar .

dzterm:local_authorities a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الجماعات المحلية"@ar .

dzterm:medical_ethics a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تتمثل الأخلاقيات الطبية، بمفهوم هذا القانون، في قواعد الممارسات الحسنة التي يخضع لها مهنيو الصحة في ممارسة مهامهم، وتشمل قواعد الأدبيات والأخلاقيات العلمية والبيو- أخلاقيات."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_339_defocc_3962291c2ce9> .

dzterm:minister_of_health a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوزير المكلف بالصحة"@ar .

dzterm:ministry_solidarity a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوزارة المكلفة بالتضامن الوطني"@ar .

dzterm:national_health_accounts a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "\"الحسابات الوطنية للصحة\""@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_338_defocc_5ac66f9ec7fd> .

dzterm:national_nomenclatures a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المدونات الوطنية للمواد الصيدلانية والمستلزمات الطبية المستعملة في الطب البشري هي المصنفات التي تضم كل المواد المسجلة أو المصادق عليها والتي يتم تحيينها بصفة منتظمة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_214_defocc_256861b43a08> .

dzterm:national_organ_transplant_agency a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوكالة الوطنية لزرع الأعضاء"@ar .

dzterm:occupational_medicine a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "طب العمل"@ar .

dzterm:palliative_care a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الرعاية التلطيفية"@ar,
        "علاجات الرعاية التلطيفية"@ar .

dzterm:pharmaceutical_establishment a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤسسة الصيدلانية هي شركة منظمة وفق الأشكال القانونية المنصوص عليها في القانون التجاري، تخضع للاعتماد من المصالح المختصة للوزارة المكلفة بالصحة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_218_defocc_6c78c89c8a42> .

dzterm:pharmaceutical_establishments a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤسسات الصيدلانية هي مؤسسات إنتاج واستغلال واستيراد وتصدير وتوزيع بالجملة مواد صيدلانية ومستلزمات طبية موجهة للطب البشري."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_219_defocc_68aa3e582b22> .

dzterm:placement_observation a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوضع في الملاحظة"@ar .

dzterm:primary_care a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العلاجات القاعدية أو الأولية هي كل خدمات الوقاية والترقية الصحية والعلاجات الأساسية وإعادة التأهيل التي تستجيب للحاجيات الصحية للأشخاص"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_283_defocc_decd3d0d4b47> .

dzterm:public_health_institution a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المؤسسة العمومية للصحة هي مؤسسة عمومية ذات تسيير خاص وذات طابع صحي بالشخصية المعنوية والاستقلال المالي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_297_defocc_4506a13632b6> .

dzterm:public_health_structures a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الهياكل والمؤسسات العمومية للصحة"@ar .

dzterm:public_private_health_structures a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الهياكل والمؤسسات العمومية والخاصة للصحة"@ar,
        "هياكل ومؤسسات الصحة العمومية والخاصة"@ar .

dzterm:public_sector a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "القطاع العمومي"@ar,
        "القطاع العمومي للصحة"@ar,
        "القطاعين العمومي"@ar .

dzterm:rehabilitation_centers a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تعد هياكل ذات طابع صحي وتسمى \"مراكز إعادة التأهيل\" ، الهياكل المعتمدة من طرف الوزير المكلف بالصحة التي تضمن خدمات الفحص والعلاج الخاص بإعادة التأهيل الوظيفي البدني أو العقلي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_275_defocc_7495613ab60d> .

dzterm:secondary_care a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "العلاجات الثانوية هي مجمل الخدمات التشخيصية والعلاجية المتخصصة المقدمة في هياكل ومؤسسات الصحة"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_284_defocc_239c099dc2a9> .

dzterm:therapeutic_abortion a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يهدف الإيقاف العلاجي للحمل إلى حماية صحة الأم عندما تكون حياتها أو توازنها النفسي والعقلي مهددين بخطر بسبب الحمل"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_77_defocc_4b69fd8cb509> .

dzterm:tobacco_products a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تعتبر موادا تبغية، المواد المخصصة للتدخين أو النشق أو الوضع على اللثة أو المضغ أو المص، بما في ذلك السيجارة الإلكترونية ما دامت تحتوي على التبغ ولو جزئيا"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_54_defocc_4fcc9a1deca4> .

dzterm:treatment_centers a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "يمكن أن تعد هياكل ذات طابع صحي وتسمى \"مراكز علاج\"، الهياكل المعتمدة من طرف الوزير المكلف بالصحة التي تتوفر، لا سيما على وسائل علاجية طبيعية أو عناصر حموية أو حقول وحل علاجي أو نباتات بحرية أو شروط مناخية مواتية للعلاج الشافي والوقائي."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_274_defocc_cae5c909f9a0> .

dzterm:الأدبيات_في_مجال_الصحة a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الأدبيات في مجال الصحة هي مجمل المبادئ والقواعد التي تحكم مهن الصحة والعلاقات بين مهنيي الصحة فيما بينهم ومع المرضى."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_345_defocc_3814524646d5> .

dzterm:الوكالة_الوطنية_للمواد_الصيدلانية a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "تنشأ وكالة وطنية للمواد الصيدلانية تدعى أدناه \"الوكالة\""@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_223_defocc_c2747e4a08a9> .

dzterm:حماية_الصحة a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "حماية الصحة هي كل التدابير الصحية والاقتصادية والاجتماعية والتربوية والبيئية الرامية إلى الحد من الأخطار الصحية أو القضاء عليها، سواء كانت ذات أصل وراثي أو ناجمة عن التغذية أو عن سلوك الإنسان أو مرتبطة بالبيئة وذلك بغرض الحفاظ على صحة الشخص والجماعة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_29_defocc_ec1094cd57c0> .

