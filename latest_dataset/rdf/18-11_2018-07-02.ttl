dzterm:advertising a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الإشهار"@ar,
        "يتمثل الإشهار للمواد الصيدلانية الموجه لمهنيي الصحة في كل نشاط يتم بموجبه الترويج لوصف المواد الصيدلانية وتسليمها"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_237_defocc_8f4989c27d23> .

dzterm:blood_transfusion_activity a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "نشاط نقل الدم"@ar,
        "نشاط نقل الدم هو نشاط طبي يتمثل في :"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_259_defocc_811148f795d5> .

dzterm:border_health_control_service a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "المصلحة الصحية بالحدود"@ar,
        "مصلحة المراقبة الصحية بالحدود هي مصلحة طبية تمارس نشاطها بواسطة مراكز صحية متواجدة على مستوى نقاط الدخول الحدودية"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_43_defocc_0a9bf0a82a93> .

dzterm:compulsory_psychiatric_examination a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الفحص الإجباري في طب الأمراض العقلية"@ar .

dzterm:health a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصحة"@ar,
        "الصحة في وسط العمل"@ar .

dzterm:health_map a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الخريطة الصحية"@ar .

dzterm:hospital_pharmacy a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصيدلية الاستشفائية"@ar,
        "صيدلية استشفائية"@ar .

dzterm:medical_device a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "مستلزم طبي"@ar,
        "يقصد بمستلزم طبي في مفهوم هذا القانون، كل جهاز أو أداة أو تجهيز أو مادة أو منتوج، باستثناء المنتوجات ذات الأصل البشري، أو مادة أخرى مستعملة لوحدها أو بصفة مشتركة، بما في ذلك الملحقات والبرمجيات التي تدخل في سيره، وموجه للاستعمال لدى الإنسان لأغراض طبية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_212_defocc_880d2de0790d> .

dzterm:medical_practitioners a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الممارسون الطبيون المتخصصون"@ar,
        "الممارسين الطبيين"@ar,
        "الممارسين الطبيين المتخصصين"@ar .

dzterm:mental_health a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصحة العقلية"@ar,
        "الصحة العقلية هي حالة من الراحة يكون فيها الشخص قادرا على إثبات قدراته، وعلى التغلب على التوترات العادية للحياة وتأدية عمل منتج ومفيد والمساهمة في حياة جماعته."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_103_defocc_3c7646e46139> .

dzterm:pharmacy a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الصيدلة"@ar,
        "الصيدلية هي المؤسسة المخصصة لصرف المواد الصيدلانية والمستلزمات الطبية بالتجزئة وكذا تنفيذ مستحضرات وصفية وصيدلانية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_249_defocc_6265edbf451d> .

dzterm:physician a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الطبيب المرجعي"@ar,
        "الطبيب المرجعي هو الطبيب العام المعالج للمريض على مستوى الهيكل الصحي الجواري العمومي أو الخاص الأقرب من موطنه"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_22_defocc_713c82f28b19> .

dzterm:prevention a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الوقاية"@ar,
        "الوقاية هي كل الأعمال الرامية إلى :"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_34_defocc_9d383bbbd592> .

dzterm:private_health_structures a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "الهياكل والمؤسسات الخاصة للصحة"@ar,
        "الهياكل والمؤسسات الخاصة للصحة هي هياكل استكشاف و أو علاج واستشفاء فيما يتعلق بالصحة البشرية."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_305_defocc_2622e6afa940> .

dzterm:toxic_substances a skos:Concept,
