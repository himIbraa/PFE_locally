    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتكفل بنشاطات طب العمل مستخدمو الصحة المجتمعون ضمن مصالح طب العمل، الذين يتولون مهام وقائية أساسا و علاجية بشكل ثانوي. تهدف النشاطات في مجال طب العمل ، لا سيما إلى ما يأتي : الحفاظ على صحة العمال وقدرتهم على العمل وترقيتهما، تحسين ظروف ووسط العمل لضمان الأمن والصحة في العمل، اعتماد نظام تنظيم للعمل يهدف إلى ترقية مناخ اجتماعي ملائم وثقافة حفظ الصحة والأمن والصحة في العمل."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_100_20180702_OpEnact_2781a64676> ;
    dzdoc:replacementText "يتكفل بنشاطات طب العمل مستخدمو الصحة المجتمعون ضمن مصالح طب العمل، الذين يتولون مهام وقائية أساسا و علاجية بشكل ثانوي. تهدف النشاطات في مجال طب العمل ، لا سيما إلى ما يأتي : الحفاظ على صحة العمال وقدرتهم على العمل وترقيتهما، تحسين ظروف ووسط العمل لضمان الأمن والصحة في العمل، اعتماد نظام تنظيم للعمل يهدف إلى ترقية مناخ اجتماعي ملائم وثقافة حفظ الصحة والأمن والصحة في العمل."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_100> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
