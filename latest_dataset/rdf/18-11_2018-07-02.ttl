    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يعاقب الشخص المعنوي الذي يرتكب إحدى المخالفات المنصوص عليها في الباب الثامن أعلاه ، بما يأتي : 1- غرامة لا يمكن أن تقل عن خمسة (5) أضعاف الغرامة القصوى المنصوص عليها للشخص الطبيعي، 2- عقوبة واحدة أو أكثر من العقوبات التكميلية الآتية : حجز الوسائل والعتاد المستعمل في ارتكاب المخالفة. المنع من ممارسة نشاط الصحة لمدة لا تتجاوز خمس (5) سنوات، غلق المؤسسة أو إحدى ملحقاتها لمدة لا تتجاوز خمس (5) سنوات، حل الشخص المعنوي."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_441_20180702_OpEnact_6d93338de6> ;
    dzdoc:replacementText "يعاقب الشخص المعنوي الذي يرتكب إحدى المخالفات المنصوص عليها في الباب الثامن أعلاه ، بما يأتي : 1- غرامة لا يمكن أن تقل عن خمسة (5) أضعاف الغرامة القصوى المنصوص عليها للشخص الطبيعي، 2- عقوبة واحدة أو أكثر من العقوبات التكميلية الآتية : حجز الوسائل والعتاد المستعمل في ارتكاب المخالفة. المنع من ممارسة نشاط الصحة لمدة لا تتجاوز خمس (5) سنوات، غلق المؤسسة أو إحدى ملحقاتها لمدة لا تتجاوز خمس (5) سنوات، حل الشخص المعنوي."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_441> ;
