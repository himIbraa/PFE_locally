<https://legal.dz/resource/law/2018-07-02/18-11#version_art_126> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يتم التكفل بالمرضى المصابين باضطرابات عقلية أو نفسية ، لا سيما في أحد الهياكل الآتية : هياكل الصحة القاعدية بما في ذلك المراكز الوسيطة للصحة العقلية، مصالح طب الأمراض العقلية، ومصالح استعجالات طب الأمراض العقلية بالمؤسسات الاستشفائية، المؤسسات الاستشفائية المتخصصة في طب الأمراض العقلية، الهياكل التابعة للقطاعات الأخرى المعتمدة أو المرخص لها من طرف الوزير المكلف بالصحة . يحدد تنظيم هذه الهياكل وسيرها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_126_20180702_OpEnact_d6d188805f> ;
    dzdoc:replacementText "يتم التكفل بالمرضى المصابين باضطرابات عقلية أو نفسية ، لا سيما في أحد الهياكل الآتية : هياكل الصحة القاعدية بما في ذلك المراكز الوسيطة للصحة العقلية، مصالح طب الأمراض العقلية، ومصالح استعجالات طب الأمراض العقلية بالمؤسسات الاستشفائية، المؤسسات الاستشفائية المتخصصة في طب الأمراض العقلية، الهياكل التابعة للقطاعات الأخرى المعتمدة أو المرخص لها من طرف الوزير المكلف بالصحة . يحدد تنظيم هذه الهياكل وسيرها عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_126> ;
