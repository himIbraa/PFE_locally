<https://legal.dz/resource/law/2018-07-02/18-11#version_art_204> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "لا يتم الدفن إلا على أساس شهادة طبية لإثبات الوفاة يعدها طبيب حسب الكيفيات المحددة عن طريق التنظيم . تبين هذه الشهادة المحررة حسب نموذج تعده الإدارة المختصة، سبب أو أسباب الوفاة وعند الاقتضاء، المعلومات المفيدة لـ الصحة العمومية وفق شروط تضمن سريتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
