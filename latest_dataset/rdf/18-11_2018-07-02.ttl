<https://legal.dz/resource/law/2018-07-02/18-11#version_art_199> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "في حالة استعمال العنف على شخص ما ، يتعين على كل طبيب إثبات الأضرار والجروح وإعداد شهادة وصفية . ويحدد نسب العجز والأضرار الأخرى طبيب متخصص في الطب الشرعي وفقا للتشريع والتنظيم المعمول بهما. ينبغي التصريح بكل جرح مشبوه، وجوبا، حسب الكيفيات المحددة في التشريع والتنظيم المعمول بهما ."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
