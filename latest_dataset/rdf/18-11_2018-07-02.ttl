<https://legal.dz/resource/law/2018-07-02/18-11#art_108_obligation_0_1f9d06ac> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasAction <https://legal.dz/resource/law/2018-07-02/18-11#art_108_obligation_0_1f9d06ac_action_a23230470b> ;
