    dzdoc:versionText "يعاقب كل من يخالف أحكام المادة 78 من هذا القانون، المتعلقة بإجبارية إجراء إيقاف الحمل لغرض علاجي في المؤسسات العمومية الاستشفائية بالحبس من ستة (6) أشهر إلى سنة (1) وبغرامة من 200.000 دج إلى 400.000 دج ."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_411_20180702_OpEnact_8efea2e07a> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
