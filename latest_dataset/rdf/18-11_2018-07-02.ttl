<https://legal.dz/resource/law/2018-07-02/18-11#version_art_234> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ لدى الوكالة لجنة اقتصادية قطاعية مشتركة للأدوية تتمثل مهمتها الرئيسية في تحديد أسعار الأدوية عند تسجيلها. تفصل اللجنة، عند الحاجة في أسعار الأدوية، نهائيا، بعد دراسة ملف التعويض من طرف الجهاز المختص التابع للضمان الاجتماعي طبقا للتشريع والتنظيم المعمول بهما. تحدد مهام هذه اللجنة وتشكيلتها وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_234_20180702_OpEnact_6348ea7483> ;
    dzdoc:replacementText "تنشأ لدى الوكالة لجنة اقتصادية قطاعية مشتركة للأدوية تتمثل مهمتها الرئيسية في تحديد أسعار الأدوية عند تسجيلها. تفصل اللجنة، عند الحاجة في أسعار الأدوية، نهائيا، بعد دراسة ملف التعويض من طرف الجهاز المختص التابع للضمان الاجتماعي طبقا للتشريع والتنظيم المعمول بهما. تحدد مهام هذه اللجنة وتشكيلتها وتنظيمها وسيرها، عن طريق التنظيم."@ar ;
    dzdoc:resolutionStatus "resolved" ;
    dzdoc:sourceArticle <https://legal.dz/resource/law/2018-07-02/18-11#art_234> ;
    dzdoc:sourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
