<https://legal.dz/resource/law/2018-07-02/18-11#version_art_351> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يمكن الجهة القضائية المختصة أن تخطر المجالس الوطنية والمجالس الجهوية للأدبيات الطبية كلما تم رفع دعوى بشأن مسؤولية عضو من السلك الطبي. ويمكن هذه المجالس أن تتأسس كطرف مدني في القضايا المرتبطة بها. يمكن أن تنشأ عن طريق التنظيم، مجالس أدبيات تخص مهن الصحة الأخرى في إطار احترام أحكام هذا القانون المطبقة على المجالس الوطنية والمجالس الجهوية للأدبيات الطبية المذكورة أعلاه."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_351_20180702_OpEnact_e78b2c90ce> ;
    dzdoc:replacementText "يمكن الجهة القضائية المختصة أن تخطر المجالس الوطنية والمجالس الجهوية للأدبيات الطبية كلما تم رفع دعوى بشأن مسؤولية عضو من السلك الطبي. ويمكن هذه المجالس أن تتأسس كطرف مدني في القضايا المرتبطة بها. يمكن أن تنشأ عن طريق التنظيم، مجالس أدبيات تخص مهن الصحة الأخرى في إطار احترام أحكام هذا القانون المطبقة على المجالس الوطنية والمجالس الجهوية للأدبيات الطبية المذكورة أعلاه."@ar ;
