<https://legal.dz/resource/law/2018-07-02/18-11#version_art_172> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "يجب على مهنيي الصحة المشاركة في المنظمة على مستوى هياكل ومؤسسات المناوبات الصحة العمومية والخاصة والصيدليات. يلزم مهنيو الصحة الذين يمارسون بصفة حرة، عند الضرورة، القيام بمناوبات على مستوى الهياكل العمومية للصحة. ويتقاضون أجرة على تأدية المناوبة وفقا للكيفيات التي تحدد عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_172_20180702_OpEnact_c541ba5cd5> ;
    dzdoc:replacementText "يجب على مهنيي الصحة المشاركة في المنظمة على مستوى هياكل ومؤسسات المناوبات الصحة العمومية والخاصة والصيدليات. يلزم مهنيو الصحة الذين يمارسون بصفة حرة، عند الضرورة، القيام بمناوبات على مستوى الهياكل العمومية للصحة. ويتقاضون أجرة على تأدية المناوبة وفقا للكيفيات التي تحدد عن طريق التنظيم."@ar ;
