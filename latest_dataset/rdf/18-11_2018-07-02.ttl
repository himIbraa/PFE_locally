<https://legal.dz/resource/law/2018-07-02/18-11#version_art_103> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "الصحة العقلية هي حالة من الراحة يكون فيها الشخص قادرا على إثبات قدراته، وعلى التغلب على التوترات العادية للحياة وتأدية عمل منتج ومفيد والمساهمة في حياة جماعته. تتولى الدولة تطوير سياسات متعددة القطاعات لحماية الصحة العقلية وترقيتها."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_103_20180702_OpEnact_2e76748611> ;
