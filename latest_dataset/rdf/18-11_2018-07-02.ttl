    skos:prefLabel "المواد السامة"@ar,
        "تتضمن المواد السامة، في مفهوم هذا القانون، لا سيما :"@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_244_defocc_e0a93bc73e2b> .

