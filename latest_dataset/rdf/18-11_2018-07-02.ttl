    dzdoc:eId "art_61" ;
    dzdoc:fullText "يمنع بيع المشروبات الكحولية للقصر."@ar ;
    dzdoc:hasAmendmentEvent <https://legal.dz/resource/law/2018-07-02/18-11#version_art_61> ;
