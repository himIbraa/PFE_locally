<https://legal.dz/resource/law/2018-07-02/18-11#version_art_297> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "المؤسسة العمومية للصحة هي مؤسسة عمومية ذات تسيير خاص وذات طابع صحي بالشخصية المعنوية والاستقلال المالي. وتتمثل مهمتها في ضمان وتطوير وترقية كل نشاطات الصحة. كما يمكنها ضمان نشاطات التكوين والبحث في مجال الصحة. ويمكنها أن تطور كل النشاطات الثانوية ذات الصلة بمهامها، عن طريق اتفاقية. يحدد القانون الأساسي النموذجي للمؤسسة العمومية للصحة عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_297_20180702_OpEnact_92d82c5681> ;
    dzdoc:replacementText "المؤسسة العمومية للصحة هي مؤسسة عمومية ذات تسيير خاص وذات طابع صحي بالشخصية المعنوية والاستقلال المالي. وتتمثل مهمتها في ضمان وتطوير وترقية كل نشاطات الصحة. كما يمكنها ضمان نشاطات التكوين والبحث في مجال الصحة. ويمكنها أن تطور كل النشاطات الثانوية ذات الصلة بمهامها، عن طريق اتفاقية. يحدد القانون الأساسي النموذجي للمؤسسة العمومية للصحة عن طريق التنظيم."@ar ;
