<https://legal.dz/resource/law/2018-07-02/18-11#version_art_283> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "العلاجات القاعدية أو الأولية هي كل خدمات الوقاية والترقية الصحية والعلاجات الأساسية وإعادة التأهيل التي تستجيب للحاجيات الصحية للأشخاص . وتمثل المستوى الأول لمسار العلاج في المنظومة الوطنية للصحة ويجب تقريبها، قدر الإمكان، من أماكن العيش والتعليم والتكوين والعمل."@ar ;
