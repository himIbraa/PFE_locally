<https://legal.dz/resource/law/2018-07-02/18-11#version_art_372> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تتم الأعمال العيادية والبيولوجية العلاجية المتصلة بالمساعدة الطبية على الإنجاب من قبل ممارسين معتمدين لهذا الغرض في مؤسسات أو مراكز أو مخابر يرخص لها الوزير المكلف بالصحة بممارسة ذلك. تحدد الأعمال العيادية والبيولوجية العلاجية المتصلة بالمساعدة الطبية على الإنجاب وكذا كيفيات الترخيص لهذه المؤسسات والمراكز والمخابر، عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
    dzdoc:operationType dzdoc:OpEnact ;
    dzdoc:producesVersion <https://legal.dz/resource/law/2018-07-02/18-11#version_art_372_20180702_OpEnact_836b06f887> ;
    dzdoc:replacementText "تتم الأعمال العيادية والبيولوجية العلاجية المتصلة بالمساعدة الطبية على الإنجاب من قبل ممارسين معتمدين لهذا الغرض في مؤسسات أو مراكز أو مخابر يرخص لها الوزير المكلف بالصحة بممارسة ذلك. تحدد الأعمال العيادية والبيولوجية العلاجية المتصلة بالمساعدة الطبية على الإنجاب وكذا كيفيات الترخيص لهذه المؤسسات والمراكز والمخابر، عن طريق التنظيم."@ar ;
