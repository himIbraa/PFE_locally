    dzdoc:versionSourceDocument <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:versionText "يعاقب كل من يخالف أحكام المادة 258 من هذا القانون، المتعلقة بجمع وتقسيم وحفظ وتوزيع الدم ومواد الدم غير الثابتة، بغرامة من 1.000.000 دج إلى 2.000.000 دج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#version_art_429_20180702_OpEnact_007eddab60> a dzdoc:ArticleVersion ;
    dzdoc:datePrecision "exact" ;
    dzdoc:inForceFrom "2018-07-02"^^xsd:date ;
    dzdoc:validFromBasis "publication" ;
