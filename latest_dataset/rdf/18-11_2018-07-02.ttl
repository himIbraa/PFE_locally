dzterm:ethics_committee a skos:Concept,
        dzdoc:LegalTerm ;
    skos:prefLabel "لجنة الأخلاقيات الطبية"@ar,
        "لجنة الأخلاقيات الطبية للتجارب العيادية"@ar,
        "لجنة الأخلاقيات الطبية للدراسات العيادية"@ar,
        "لجنة الأخلاقيات الطبية للدراسات العيادية هي جهاز مستقل، تراقب نشاطاتها من طرف المصالح المختصة للوزارة المكلفة بالصحة."@ar ;
    dzdoc:hasDefinitionOccurrence <https://legal.dz/resource/law/2018-07-02/18-11#art_382_defocc_13e99180cc60> .

dzterm:public_health a skos:Concept,
        dzdoc:LegalTerm ;
