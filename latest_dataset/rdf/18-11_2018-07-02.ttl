<https://legal.dz/resource/law/2018-07-02/18-11#version_art_356> a dzdoc:AmendmentEvent,
        dzdoc:LifecycleAssertion ;
    dzdoc:assertsTarget <https://legal.dz/resource/law/2018-07-02/18-11> ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:datePrecision "exact" ;
    dzdoc:evidenceText "تنشأ وكالة وطنية لزرع الأعضاء تكلف بتنسيق وتطوير نشاطات نزع وزرع الأعضاء والأنسجة والخلايا البشرية وضمان قانونيتها وأمنها. تحدد مهام هذه الوكالة وتنظيمها وسيرها عن طريق التنظيم."@ar ;
    dzdoc:isAuthoritative true ;
    dzdoc:isContradictory false ;
