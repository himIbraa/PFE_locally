<https://legal.dz/resource/law/2018-07-02/18-11#art_264_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_264> ;
    dzdoc:position 0 ;
    dzdoc:text "تنشأ وكالة وطنية للدم تكلف بضمان خدمة عمومية في مجال متابعة وتنفيذ السياسة الوطنية للدم ومراقبة، وترقية التبرع بالدم، واحترام الممارسات الحسنة المتعلقة باستعمال الدم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_264_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_264> ;
    dzdoc:position 1 ;
    dzdoc:text "تحدد مهام هذه الوكالة وتنظيمها وسيرها، عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_265_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_265> ;
    dzdoc:position 0 ;
    dzdoc:text "يرتكز تنظيم المنظومة الوطنية للصحة، لا سيما على ما يأتي : الخريطة الصحية ومخطط التنظيم الصحي، المصالح الخارجية التابعة للقطاع المكلف بالصحة، خدمة عمومية للصحة تضمنها المؤسسات العمومية والمؤسسات الخاصة المكلفة بهذه المهمة، قطاع خاص للصحة، العمل القطاعي المشترك في تنفيذ السياسة الوطنية للصحة، التكامل بين القطاع العمومي والقطاع الخاص في مجال الخدمات الصحية، تكامل نشاطات الوقاية والعلاج وإعادة التأهيل في جانبها الطبي والاجتماعي، مساعي تشخيصية وعلاجية ترتكز على اتفاقات ذات فائدة طبية فعلية مقيمة ومحينة بانتظام، تنظيم وترقية التكوين والبحث في علوم الصحة، مساهمة الحركة الجمعوية والتعاضدية. شبكات العلاج."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_266_obligation_0_eaec5ce7> a dznorm:Obligation ;
    dzdoc:confidenceScore 1.0 ;
    dzdoc:extractionMethod "akn_obligation_tag" ;
    dzdoc:hasRole <https://legal.dz/resource/law/2018-07-02/18-11#art_266_obligation_0_eaec5ce7_role_a169724942> ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_266> ;
    dznorm:position 0 ;
    dznorm:provisionText "تتولى المنظومة الوطنية للصحة التكفل بالأحواض السكانية، عبر انتشار القطاع العمومي للصحة على كامل التراب الوطني"@ar ;
    dznorm:sourceArticle "art_266" .

<https://legal.dz/resource/law/2018-07-02/18-11#art_266_obligation_0_eaec5ce7_role_a169724942> a dznorm:Role ;
    rdfs:label "كامل التراب الوطني"@ar ;
    dzdoc:confidenceScore 0.66 ;
    dzdoc:extractionMethod "lexical_role_pattern" ;
    dzdoc:sourceTextSpan "تتولى المنظومة الوطنية للصحة التكفل بالأحواض السكانية، عبر انتشار القطاع العمومي للصحة على كامل التراب الوطني"@ar ;
    dznorm:expressedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_266> .

<https://legal.dz/resource/law/2018-07-02/18-11#art_266_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_266> ;
    dzdoc:position 0 ;
    dzdoc:text "تتولى المنظومة الوطنية للصحة التكفل بالأحواض السكانية، عبر انتشار القطاع العمومي للصحة على كامل التراب الوطني، مع الأخذ في الحسبان تسلسل العلاج وتكامل نشاطات المؤسسات المنظمة في شكل شبكة أو في أي شكل آخر من أشكال التعاون."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_266_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_266> ;
    dzdoc:position 1 ;
    dzdoc:text "وتكون مهيكلة حول مؤسسات وهياكل صحية عمومية وخاصة وكل مؤسسة أخرى تساهم في صحة الأشخاص."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_267_para_0> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_267> ;
    dzdoc:position 0 ;
    dzdoc:text "تتمثل مهام المصالح الخارجية التابعة للوزارة المكلفة بالصحة، على الخصوص، في توزيع الموارد وتنسيق برامج الصحة الوطنية والجهوية والمحلية ومتابعتها وتنفيذها. وتتخذ أيضا كل التدابير التي من شأنها تأطير النشاطات في مجال الصحة."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_267_para_1> a dzdoc:Paragraph ;
    dzdoc:directlyContainedIn <https://legal.dz/resource/law/2018-07-02/18-11#art_267> ;
    dzdoc:position 1 ;
    dzdoc:text "يحدد تنظيم المصالح الخارجية ومهامها وسيرها عن طريق التنظيم."@ar .

<https://legal.dz/resource/law/2018-07-02/18-11#art_268_condition_0_c66030b2> a dznorm:Condition ;
